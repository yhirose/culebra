# Drop bodies are user code that runs inside delicate runtime windows —
# the GC's finalize pass, a multimethod table mutation, its own cycle
# teardown, a release that has not yet de-registered its object. Each case
# here crashed or hung a lane before its guard existed (see the Phase 2-4
# commit and the dying-object one): re-entrant collect deferral,
# detach-before-release in the multifn replace/forget paths, the
# saturating self-pin in _culebra_call_drop_if_present, and the teardown
# stack the collector treats as roots. `GC.stat()` finds its roots from
# the reference counts, so every count below is exact on both lanes; each
# drop fires exactly once and nothing may crash.

# --- 1) A drop body fired at a release calls GC.stat() itself: the
# collect runs while the holder's release is still on the stack.
let ev1 = []
make_lam = fn () {
  let res = {id: 'lam', drop: fn () {
    GC.stat()
    ev1.push('lam')
  }}
  let g = fn () {
    res.id
  }
  g()
}
fn run_lam() {
  {
    let _l = make_lam()
  }
  nil
}
run_lam()
GC.stat()
assert_eq(ev1.size(), 1)

# --- 2) A drop body breaking its OWN cycle edge releases through itself:
# the in-drop pin must absorb any number of self-releases.
let ev2 = []
make_self = fn () {
  let cyc = {id: 'c', mut me: nil, drop: fn () {
    self.me = nil
    ev2.push('d')
  }}
  cyc.me = cyc
  let g = fn () {
    cyc.id
  }
  g()
}
fn run_self() {
  {
    let _x = make_self()
  }
  nil
}
run_self()
GC.stat()
assert_eq(ev2.size(), 1)

# --- 3) A displaced multimethod body's drop dispatches the very name
# being replaced: the table must already hold the replacement, never the
# freed body. 'a' and 'b' fire on the replace path, 'c' at the collection.
let ev3 = []
fn make_replace(tag) {
  mut use_res = nil
  let res = {id: tag, drop: fn () {
    ev3.push(use_res())
  }}
  fn helper() {
    res.id
  }
  use_res = helper
  nil
}
make_replace('a')
make_replace('b')
make_replace('c')
GC.stat()
# Count only — each push calls use_res(), which dispatches to the CURRENT
# body, so the pushed ids legitimately repeat; the point of this case is
# that the dispatch never reaches a freed body.
assert_eq(ev3.size(), 3)

# --- 4) A drop fired from a dying dispatcher's body-release re-declares
# the same `fn` site: it must find a clean table and a fresh dispatcher,
# not the dying one.
let ev4 = []
mut depth = 0
fn make_forget() {
  mut h = nil
  {
    let res = {id: 'r', drop: fn () {
      ev4.push('drop')
      if depth < 1 {
        depth = depth + 1
        make_forget()
      }
    }}
    fn helper() {
      res.id
    }
    h = helper
  }
  h = nil
  nil
}
make_forget()
GC.stat()
assert_eq(ev4.size(), 2)  # outer drop + one recursive make's drop

# --- 5) A drop fired by a plain release-to-zero (not the finalize pass)
# collects while its holder is mid-teardown: the array / capture cell has
# already reached zero and released part of what it holds. A holder still
# visible to that collect is swept under its own running release, and its
# stale edge to `keep5` discounts a live reference.
let ev5 = []
let keep5 = {x: [1, 2]}
fn run_array_holder() {
  let holder = [keep5, {id: 'a', drop: fn () {
    GC.stat()
    ev5.push('a')
  }}]
  nil
}
fn run_cell_holder() {
  let res = {id: 'c', drop: fn () {
    GC.stat()
    ev5.push('c')
  }}
  let g = fn () {
    res.id
  }
  g()
}
run_array_holder()
run_cell_holder()
GC.stat()
assert_eq(ev5, ['a', 'c'])
assert_eq(keep5.x, [1, 2])
