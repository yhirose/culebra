# Drop bodies are user code that runs inside delicate runtime windows —
# the GC's finalize pass, a multimethod table mutation, its own cycle
# teardown. Each case here crashed or hung one backend before its guard
# existed (see the Phase 2-4 commit): re-entrant collect deferral,
# detach-before-release in the multifn replace/forget paths, and the
# saturating self-pin in _culebra_call_drop_if_present. Observations are
# count-based: WHEN a drop fires differs by design between the backends'
# reclaim mechanisms (replace-time vs backstop), but each fires exactly
# once and nothing may crash.

fn churn(n) {
  mut acc = []
  mut i = 0
  while i < n {
    acc.push('x' + i.to_string())
    i = i + 1
  }
  acc.size()
}
# Adaptive: collect until the expected number of drops landed (or a
# generous cap — a genuinely missing drop still fails the assert that
# follows). A fixed iteration count flakes: a stale word can survive
# several collections.
# `arr` is the current case's own event array: a LATE backstop fire from a
# prior case (conservatively retained past its own settle) pushes into that
# prior case's array, never into a later case's observations.
fn gc_settle(arr, want) {
  mut i = 0
  while i < 20 && arr.size() < want {
    churn(8)
    GC.stat()
    i = i + 1
  }
}

# --- 1) A drop body fired by the finalize pass calls GC.stat() itself:
# the re-entrant collect must defer, not corrupt the in-flight dead set.
let ev1 = []
make_lam = fn () {
  let res = { id: 'lam', drop: fn () { GC.stat(); ev1.push('lam') } }
  let g = fn () { res.id }
  g()
}
fn run_lam() { { let _l = make_lam() }; nil }
run_lam()
gc_settle(ev1, 1)
assert_true(ev1.size() <= 1)      # conservative retention tolerance; the
                                  # crash-freedom of the re-entrant collect
                                  # is the point

# --- 2) A drop body breaking its OWN cycle edge releases through itself:
# the in-drop pin must absorb any number of self-releases.
let ev2 = []
make_self = fn () {
  let cyc = { id: 'c', mut me: nil, drop: fn () { this.me = nil; ev2.push('d') } }
  cyc.me = cyc
  let g = fn () { cyc.id }
  g()
}
fn run_self() { { let _x = make_self() }; nil }
run_self()
gc_settle(ev2, 1)
assert_true(ev2.size() <= 1)

# --- 3) A displaced multimethod body's drop dispatches the very name
# being replaced: the table must already hold the replacement, never the
# freed body. Firing points differ (the JIT fires displaced drops at the
# re-declaration, the interp parks them for the backstop), so only the
# settled total is asserted.
let ev3 = []
fn make_replace(tag) {
  mut use_res = nil
  let res = { id: tag, drop: fn () { ev3.push(use_res()) } }
  fn helper() { res.id }
  use_res = helper
  nil
}
make_replace('a')
make_replace('b')
make_replace('c')
gc_settle(ev3, 3)
# Same one-chain tolerance as test_drop_backstop.cul's multi-orphan case:
# conservative false retention can keep one chain alive for the whole run.
# Count only — each push calls use_res(), which dispatches to the CURRENT
# body, so the pushed ids legitimately repeat; the point of this case is
# that the dispatch never reaches a freed body.
# 'a' and 'b' fire on the replace path (refcount-driven, deterministic);
# only 'c' is collection-timed — hence the >= 2 floor holds everywhere.
assert_true(ev3.size() >= 2 && ev3.size() <= 3)

# --- 4) A drop fired from a dying dispatcher's body-release re-declares
# the same `fn` site: it must find a clean table and a fresh dispatcher,
# not the dying one.
let ev4 = []
mut depth = 0
fn make_forget() {
  mut h = nil
  {
    let res = { id: 'r', drop: fn () {
      ev4.push('drop')
      if depth < 1 { depth = depth + 1; make_forget() }
    } }
    fn helper() { res.id }
    h = helper
  }
  h = nil
  nil
}
make_forget()
gc_settle(ev4, 2)
assert_eq(ev4.size(), 2)   # outer drop + one recursive make's drop
                           # (both refcount-driven: deterministic)
