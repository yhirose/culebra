# Conformance: §11 (keyword arguments, ** splat), §19 (kwargs in
# multimethods), §7 (mixed-call evaluation order). See docs/language.md §25.
#
# Keyword arguments and `**` splat — dual-backend covered subset.
# The interp-only `tests/interp/test_kwargs.cul` pins runtime-catchable
# kwarg error shapes that the JIT detects at IR-emit time instead.
# Happy-path coverage (including dynamic **var splat and UFCS kwargs
# against a free function) runs on both backends from this file.

let f = fn (x, y = 10, z = 100) {
  x + y + z
}

# Positional only (defaults fill trailing)
assert_eq(f(1, 2, 3), 6)
assert_eq(f(1), 111)
assert_eq(f(1, 2), 103)

# Direct kwargs — including a middle gap (y skipped, z provided).
assert_eq(f(1, z: 5), 16)
assert_eq(f(1, y: 2, z: 3), 6)
assert_eq(f(z: 3, y: 2, x: 1), 6)

# Literal Object splat — flattened at compile time.
assert_eq(f(1, **{y: 7, z: 8}), 16)
assert_eq(f(1, **{y: 7}, z: 100), 108)
assert_eq(f(1, **{y: 2}, **{y: 5}), 106)  # multiple splats: later wins
assert_eq(f(**{x: 1}, **{y: 2}, z: 3), 6)

# Explicit kwarg always wins regardless of source order, including
# when an explicit comes BEFORE the splat with the same key.
assert_eq(f(1, z: 3, **{z: 999}), 14)
assert_eq(f(1, **{z: 999}, z: 3), 14)

# Shadowing a built-in global name with a user fn that takes kwargs:
# the JIT must route the kwargs call through the user fn, not bail to
# "this builtin doesn't accept kwargs" or to the built-in's positional
# fast path. (Positional-only shadowing of names like `range` is a
# pre-existing JIT limitation — JIT fast-paths intercept before name
# resolution. Kwargs calls bypass those fast paths and reach the
# user fn correctly.)
let to_long = fn (n, base = 10) {
  n * base
}
assert_eq(to_long(5, base: 2), 10)

# Indirect callee: captured closure carries the param metadata so the
# JIT runtime resolver finds it via cls->fn_ptr.
let make_adder = fn (base) {
  fn (x, mult = 1) {
    (x + base) * mult
  }
}
let add10 = make_adder(10)
assert_eq(add10(5), 15)
assert_eq(add10(5, mult: 2), 30)
assert_eq(add10(5, **{mult: 3}), 45)

# Dynamic `**variable` splat (not a literal Object): resolves at
# runtime via the helper's enumeration of the splat operand.
let dyn_opts = {mult: 4}
assert_eq(add10(5, **dyn_opts), 60)

# UFCS path with kwargs: `x.f(...)` becomes `f(x, ...)`.
let greet = fn (name, greeting = 'hi') {
  "{greeting}, {name}"
}
assert_eq('alice'.greet(), 'hi, alice')
assert_eq('alice'.greet(greeting: 'yo'), 'yo, alice')

# Object method with kwargs (including a middle-gap default).
let counter = fn (start) {
  {val: start, bump: fn (by = 1, mult = 1) {
    (self.val + by) * mult
  }}
}
let c = counter(10)
assert_eq(c.bump(), 11)
assert_eq(c.bump(by: 5), 15)
assert_eq(c.bump(mult: 2), 22)  # middle gap on by
assert_eq(c.bump(by: 5, mult: 3), 45)

# Default eval is per-call (Ruby flavor — not Python's def-time trap).
mut counter = 0
let inc = fn () {
  counter = counter + 1
  counter
}
let h = fn (x = inc()) {
  x
}
assert_eq(h(), 1)
assert_eq(h(), 2)
assert_eq(h(100), 100)  # explicit arg skips default eval
assert_eq(h(), 3)

# Earlier-param visibility in default eval.
let g = fn (a, b = a + 1) {
  a + b
}
assert_eq(g(10), 21)
assert_eq(g(10, b: 5), 15)

# __ARGS__ catches extra positional only; kwargs never contribute.
let varfn = fn (a) {
  __ARGS__
}
let extras = varfn(1, 2, 3)
assert_true(extras.size() == 2 && extras[0] == 2 && extras[1] == 3)

let g2 = fn (a, b = 0) {
  __ARGS__
}
let e2 = g2(1, b: 9)
assert_eq(e2.size(), 0)

# Keyword-only parameters: anything after `*` must be passed by name.
let kw1 = fn (x, *, y) {
  x + y
}
assert_eq(kw1(1, y: 2), 3)
assert_eq(kw1(1, **{y: 4}), 5)

let kw2 = fn (x, *, y = 100, z = 200) {
  x + y + z
}
assert_eq(kw2(1), 301)        # both kw-only defaults
assert_eq(kw2(1, y: 2), 203)  # z still defaults
assert_eq(kw2(1, z: 3), 104)  # middle gap on kw-only
assert_eq(kw2(1, z: 3, y: 2), 6)
assert_eq(kw2(1, **{y: 2, z: 3}), 6)

# UFCS + kw-only.
let greet_kw = fn (name, *, greeting = 'hi') {
  "{greeting}, {name}"
}
assert_eq('alice'.greet_kw(), 'hi, alice')
assert_eq('alice'.greet_kw(greeting: 'yo'), 'yo, alice')

# `**rest` catch-all: unconsumed kwargs are collected into an Object.
let rest1 = fn (**opts) {
  opts
}
let r = rest1(a: 1, b: 2)
assert_true(r.a == 1 && r.b == 2)
assert_eq(rest1().a, nil)  # empty rest is an empty Object

# Mixed: declared params take their share, rest catches the leftovers.
let mix = fn (x, **opts) {
  x + opts.a
}
assert_eq(mix(10, a: 5), 15)
assert_eq(mix(10, a: 5, b: 100), 15)  # b stays in opts, untouched

# Combined with `*` and defaults.
let full = fn (x, y = 10, *, z, **kw) {
  x + y + z + kw.bonus
}
assert_eq(full(1, z: 100, bonus: 7), 118)
assert_eq(full(1, 2, z: 100, bonus: 7), 110)

# Splat into a function with `**rest` — declared params bind first,
# the rest of the keys flow into the rest Object.
let dyn = {z: 50, bonus: 8, extra: 'x'}
assert_eq(full(1, **dyn), 69)  # 1+10+50+8 (extra captured in kw)

# A user-passed kwarg whose name matches the rest param itself is
# still treated as a name to put INTO the rest Object (the rest slot
# is filled with the constructed Object, not by name lookup).
let r2 = fn (**opts) {
  opts.opts
}
assert_eq(r2(opts: 5), 5)

# Dynamic callee with kw-only param: a positional past the `*`
# separator must be a TypeError even when the callee is captured into
# a variable (JIT runtime guard via param meta, mirroring the interp).
let kw_dyn_src = fn (x, *, y) {
  x + y
}
let kw_dyn_dst = kw_dyn_src
assert_eq(kw_dyn_dst(1, y: 2), 3)
let dyn_err = try {
  kw_dyn_dst(1, 2)
  nil
} catch e {
  e
}
assert_eq(dyn_err.kind, 'TypeError')
assert_true(dyn_err.message.contains('positional'))

# Dynamic `**var` splat: splat operand is a runtime Object rather
# than a literal. Both backends route through the runtime kwarg
# resolver.
let dyn_target = fn (a, b = 10, c = 100) {
  a + b + c
}
let opts = {b: 30, c: 300}
assert_eq(dyn_target(1, **opts), 331)
# Splat from a fn return — also dynamic.
let mkopts = fn () {
  {b: 40, c: 400}
}
assert_eq(dyn_target(1, **mkopts()), 441)

# UFCS + kwargs against a free function.
let fmt = fn (s, prefix = "[", suffix = "]") {
  "{prefix}{s}{suffix}"
}
assert_eq("hello".fmt(prefix: "<", suffix: ">"), "<hello>")

# Mixed positional / **splat / kwarg arguments must evaluate
# left-to-right in source order on both backends — the JIT used
# to evaluate positional first, then kwargs, then splats, which
# diverged from interp when any argument expression had side
# effects. After the fix, both honor the user-written order.
mut order_log = []
let trace = fn (label, v) {
  order_log.push(label)
  v
}
let order_target = fn (a, b, c) {
  a + b + c
}
assert_eq(
  order_target(trace("pos", 1), **trace("splat", {b: 2}), c: trace("kw", 3)),
  6,
)
assert_true(order_log.size() == 3 &&
  order_log[0] == 'pos' &&
  order_log[1] == 'splat' &&
  order_log[2] == 'kw')

# Error shapes. All raise catchable structured errors on both backends
# with identical kind + message text. The JIT used to detect several
# of these at IR-emit time (uncatchable); they now route through the
# same runtime throw helpers as interp so `try { ... } catch e { ... }`
# observes the same error consistently.
let err_f = fn (x, y = 10) {
  x + y
}

let e1 = try {
  err_f(1, zzz: 9)
  nil
} catch e {
  e
}
assert_true(e1.kind == 'TypeError' && e1.message.contains('zzz'))

let e2 = try {
  err_f(x: 1, x: 2)
  nil
} catch e {
  e
}
assert_true(e2.kind == 'TypeError' && e2.message.contains('duplicate'))

let e3 = try {
  err_f(1, x: 2)
  nil
} catch e {
  e
}
assert_true(e3.kind == 'TypeError' && e3.message.contains('both positionally'))

let e4 = try {
  err_f()
  nil
} catch e {
  e
}
assert_true(e4.kind == 'ArityError' && e4.message.contains("missing required"))

let e5 = try {
  err_f(1, **[1, 2])
  nil
} catch e {
  e
}
assert_true(e5.kind == 'TypeError' && e5.message.contains('splat operand'))

let e6 = try {
  err_f(x: 1, 2)
  nil
} catch e {
  e
}
assert_true(e6.kind == 'SyntaxError' &&
  e6.message.contains('positional argument follows'))

# Exact wording pin for the too-many-positionals TypeError (kw-only cap).
# All three paths — static call, dynamic callee (runtime param-meta guard),
# and a builtin with kw-only params — must render this byte-identical text;
# it is single-sourced in shared.h (too_many_positionals_message).
let kw_cap = fn (a, *, k = 1) {
  a + k
}
let e7 = try {
  kw_cap(1, 2)
  nil
} catch e {
  e
}
assert_true(e7.kind == 'TypeError' &&
  e7.message == 'takes 1 positional argument but 2 given')
let kw_cap_dyn = kw_cap
let e8 = try {
  kw_cap_dyn(1, 2)
  nil
} catch e {
  e
}
assert_true(e8.kind == 'TypeError' &&
  e8.message == 'takes 1 positional argument but 2 given')
let e9 = try {
  [3, 1].sort(1)
  nil
} catch e {
  e
}
assert_true(e9.kind == 'TypeError' &&
  e9.message == 'takes 0 positional arguments but 1 given')

# The argument-list shape errors (positional-after-keyword, duplicate keyword)
# are the same catchable error for every call kind, not just user functions: a
# shared validator runs before the callee-specific kwarg handling. These used
# to diverge — an ns-method reported the JIT's "unknown keyword argument" while
# the interp saw the shape error, and a constructor reported a dispatch error.
let e6_ns_pos = try {
  range(stop: 5, 1)
  nil
} catch e {
  e
}
assert_true(e6_ns_pos.kind == 'SyntaxError' &&
  e6_ns_pos.message.contains('positional argument follows'))

let e6_ns_dup = try {
  range(stop: 5, stop: 6)
  nil
} catch e {
  e
}
assert_true(e6_ns_dup.kind == 'TypeError' &&
  e6_ns_dup.message.contains('duplicate'))

class KwCtor {
  new(a, b) {}
}
let e6_ctor_dup = try {
  KwCtor(a: 1, a: 2)
  nil
} catch e {
  e
}
assert_true(e6_ctor_dup.kind == 'TypeError' &&
  e6_ctor_dup.message.contains('duplicate'))

# A bare global builtin that accepts no keyword arguments reports the same
# catchable TypeError on both backends (the JIT used to raise an uncatchable
# compile-time SyntaxError for a well-formed kwarg here).
let e6_builtin_kw = try {
  inspect(x: 1)
  nil
} catch e {
  e
}
assert_true(e6_builtin_kw.kind == 'TypeError' &&
  e6_builtin_kw.message.contains('does not accept keyword'))

let e7 = try {
  let bad = {1: 'a'}
  err_f(1, **bad)
  nil
} catch e {
  e
}
assert_true(e7.kind == 'TypeError' && e7.message.contains('splat key'))

# A `**` splat whose ONLY effect is the bad operand (no positional to dispatch
# on) must still report the splat type error, not a DispatchError — the JIT
# used to validate the splat only after picking an overload, so a non-Object
# operand with nothing else to match on surfaced as "no matching method".
# Validation now runs up front, before dispatch, on both backends.
fn one(a) {
  a
}
let s1 = try {
  one(**[1, 2])
  nil
} catch e {
  e
}
assert_true(s1.kind == 'TypeError' && s1.message.contains('splat operand'))
let s2 = try {
  one(**5)
  nil
} catch e {
  e
}
assert_true(s2.kind == 'TypeError' && s2.message.contains('splat operand'))
let s3 = try {
  let o = {}
  o[1] = 2
  one(**o)
  nil
} catch e {
  e
}
assert_true(s3.kind == 'TypeError' && s3.message.contains('splat key'))

# A duplicate / misplaced keyword reports at the offending argument's own
# position on both backends (the JIT used to point at the call site). The
# position itself is held symmetric by the interp==jit invariant; here we
# pin the kind + message.
fn pos2(a, b) {
  [a, b]
}
let p1 = try {
  pos2(a: 1, a: 2)
  nil
} catch e {
  e
}
assert_eq(p1.kind, 'TypeError')
assert_true(p1.message.contains('duplicate'))
let p2 = try {
  pos2(b: 1, 2)
  nil
} catch e {
  e
}
assert_eq(p2.kind, 'SyntaxError')
assert_true(p2.message.contains('positional argument follows'))

# --- `**rest` is never a required argument --------------------------------
# A call carrying no keyword content skips the resolver entirely; the callee
# still sees the rest variable, bound to an empty Object.
fn rest_only(**kw) {
  kw
}
assert_eq(rest_only(), {})
fn one_then_rest(a, **kw) {
  [a, kw]
}
assert_eq(one_then_rest(1), [1, {}])
class RestMethod {
  m(**kw) {
    kw
  }
}
assert_eq(RestMethod.new().m(), {})

# --- a `**rest` Object keeps the order its keys arrived in ----------------
# Splat entries in operand order, then the explicit keywords; a repeat
# overwrites in place. Objects are ordered, so every call shape — free
# function, method, static, bound value — must agree on that order.
let src = {'a': 1, 'b': 2, 'c': 7}
assert_eq(rest_only(**src).keys(), ['a', 'b', 'c'])
assert_eq(rest_only(**src, z: 0).keys(), ['a', 'b', 'c', 'z'])
assert_eq(rest_only(z: 0, **src).keys(), ['a', 'b', 'c', 'z'])
assert_eq(rest_only(**{'q': 1}, **src).keys(), ['q', 'a', 'b', 'c'])
assert_eq(rest_only(m: 1, n: 2, o: 3).keys(), ['m', 'n', 'o'])
assert_eq(rest_only(**src, b: 9), {'a': 1, 'b': 9, 'c': 7})
let rm = RestMethod.new()
let bound_m = rm.m
assert_eq(rm.m(**src).keys(), ['a', 'b', 'c'])
assert_eq(bound_m(**src).keys(), ['a', 'b', 'c'])
class RestStatic {
  static s(**kw) {
    kw
  }
}
assert_eq(RestStatic.s(**src).keys(), ['a', 'b', 'c'])
let via_value = rest_only
assert_eq(via_value(**src).keys(), ['a', 'b', 'c'])

IO.inspect('test_kwargs OK')
