# Reading assets out of a `Dir.embedded(...)` — the same Dir `srv.static`
# takes, without a server. Run from source it reads the live on-disk directory
# relative to the entry script; under an AOT build the same calls read a
# baked-in table, and the output has to match either way. (The contract every
# kind of Dir keeps is tests/test_dir.cul's.)

let d = Dir.embedded("embed_assets")
inspect(d.exists("app.js"))
inspect(d.exists("nope.css"))
inspect(d.read("app.js").trim())
inspect(d.read("index.html").contains("<h1>It works</h1>"))
inspect(d.files())

# Binary-safe: the bytes come back whole, baked or on disk.
inspect(d.read("index.html").size())
inspect(d.size("index.html"))

# A path out of the directory is not found rather than escaping it; the
# directory itself is there.
inspect(d.exists("../test_embed_read.cul"))
inspect(d.exists("/etc/hosts"))
inspect(d.exists(""))
inspect(d.is_dir("."))

# A missing file names it.
try {
  d.read("nope.css")
} catch e {
  inspect(e.kind + ": " + e.message)
}
try {
  d.read("../test_embed_read.cul")
} catch e {
  inspect(e.kind)
}

# Wrong / missing argument, at the same position on every backend.
try {
  d.read(42)
} catch e {
  inspect(e.kind + ": " + e.message)
}
try {
  d.exists()
} catch e {
  inspect(e.kind + ": " + e.message)
}

# Sendable: an isolate reads the same directory.
let (tx, rx) = Channel.new()
let h = Isolate.spawn(
  fn (tx, art) {
    tx.send(art.read("app.js").trim())
  },
  tx,
  d,
)
inspect("from isolate: " + rx.recv())
h.join()
