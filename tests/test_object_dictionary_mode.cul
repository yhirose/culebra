// Conformance: §10 (Objects). An Object doubles as the dictionary type, so
// it has to stay correct — and stay linear — when its keys come from data
// rather than from source.
//
// Past a property threshold, or once it loses a key, a plain object stops
// transitioning shapes and keeps a hash index of its own instead. Everything
// below has to behave the same on both sides of that flip, so each case
// spans it: the threshold is 64 and these objects hold 200 (the removal
// cases at the end flip by removing).

let n = 200

fn build(n) {
  mut o = {}
  for i in 0..n {
    o["key{i}"] = i
  }
  o
}

// --- reads -----------------------------------------------------------------

let o = build(n)
assert_eq(o.size(), n)
assert_eq(o["key0"], 0)          // before the flip
assert_eq(o["key63"], 63)        // the last shaped slot
assert_eq(o["key64"], 64)        // the first dictionary slot
assert_eq(o["key199"], 199)
assert_eq(o.get("key150", -1), 150)
assert_eq(o.get("absent", -1), -1)
assert_true(o.has("key120"))
assert_true(!o.has("absent"))

// A data key that collides with a dict builtin still shadows it, before and
// after the flip — the documented rule, unchanged here.
mut shadowed = build(n)
shadowed["get"] = 7
assert_eq(shadowed["get"], 7)

// --- insertion order -------------------------------------------------------

let ks = o.keys()
assert_eq(ks.size(), n)
assert_eq(ks[0], "key0")
assert_eq(ks[63], "key63")
assert_eq(ks[64], "key64")
assert_eq(ks[n - 1], "key199")

mut seen = 0
mut sum = 0
for k, v in o {
  seen += 1
  sum += v
}
assert_eq(seen, n)
assert_eq(sum, n * (n - 1) / 2)

// --- writes ----------------------------------------------------------------

mut w = build(n)
w["key100"] = 999
assert_eq(w["key100"], 999)
assert_eq(w.size(), n)           // an update is not an insert

w["key200"] = 200
assert_eq(w.size(), n + 1)
assert_eq(w["key200"], 200)
assert_eq(w.keys()[n], "key200")

// --- removal ---------------------------------------------------------------

mut r = build(n)
r.remove("key0")
assert_eq(r.size(), n - 1)
assert_true(!r.has("key0"))
// Every later key keeps its own value after the slots shift down.
assert_eq(r["key1"], 1)
assert_eq(r["key64"], 64)
assert_eq(r["key199"], 199)
r.remove("key199")
assert_eq(r.size(), n - 2)
assert_eq(r["key198"], 198)

// --- spread, JSON, and mixed keys -------------------------------------------

let copy = {...o}
assert_eq(copy.size(), n)
assert_eq(copy["key5"], 5)
assert_eq(copy.keys()[64], "key64")

assert_eq(JSON.parse(JSON.stringify(o)).size(), n)
assert_eq(JSON.parse(JSON.stringify(o))["key77"], 77)

// It shows every entry, as it does before the flip.
assert_eq(to_string(build(2)), '{mut key0: 0, mut key1: 1}')
let shown = to_string(build(65))
assert_true(shown.starts_with('{mut key0: 0, mut key1: 1, '))
assert_true(shown.ends_with(', mut key64: 64}'))

mut mixed = build(n)
mixed[42] = "long key"
assert_eq(mixed.size(), n + 1)
assert_eq(mixed[42], "long key")
assert_eq(mixed["key3"], 3)
// The non-String key keeps its place in the unified insertion order.
assert_eq(mixed.keys()[n], 42)

// --- a class instance never flips -------------------------------------------

// Instances reach their methods through a proto, which shares storage with
// the dictionary index, so they stay shaped however many fields they hold.
class Bag {
  new(n) {
    self.n = n
  }

  double() {
    self.n * 2
  }
}

mut b = Bag(21)
for i in 0..n {
  b["f{i}"] = i
}
assert_eq(b.double(), 42)        // the method still resolves
assert_eq(b["f199"], 199)
assert_eq(b.n, 21)

// --- a removal mints no layout ----------------------------------------------

// Layouts are interned for the life of the process, and the key set a
// removal leaves is one no other object shares, so an Object that loses a
// key becomes a dictionary instead: one whose keys churn (a cache, a memo
// table) used to intern a fresh chain of layouts on every removal.
mut cache = {}
for i in 0..21 {
  cache["c{i}"] = i
}
cache.remove("c0")  // a dictionary from here on, so the baseline sees no shaped insert
GC.stat()  // interns the layout of its own result
let churn_base = GC.stat().shapes
for i in 21..221 {
  cache["c{i}"] = i
  cache.remove("c{i - 20}")
}
assert_eq(GC.stat().shapes - churn_base, 0)
assert_eq(cache["c220"], 220)
assert_eq(cache.keys()[0], "c201")

// A copy that crosses a message is a dictionary where the sent one was, so
// receiving one mints no layout for its keys either.
let (dict_tx, dict_rx) = Channel.new(1)
let send_base = GC.stat().shapes
for i in 0..50 {
  dict_tx.send(cache)
  dict_rx.recv()
  cache["s{i}"] = i
  cache.remove(cache.keys()[0])
}
assert_eq(GC.stat().shapes - send_base, 0)

// --- a dictionary's keys are its own ------------------------------------------

// A dictionary holds each key as a String of its own, reclaimed with it. Keys
// that never repeat (ids, timestamps) used to be interned for the life of the
// process instead, one copy per distinct key, under a lock every isolate shared.
fn fresh_dict(n) {
  mut d = {}
  d['flip'] = 0
  d.remove('flip')  // a dictionary from here on
  for i in 0..n {
    d["fresh{i}"] = i
  }
  d
}

fn live_with_dict(n) {
  let d = fresh_dict(n)
  let live = GC.stat().live_objects
  assert_eq(d.keys()[n - 1], "fresh{n - 1}")
  live
}

GC.stat()
let keys_base = GC.stat().live_objects
assert_true(live_with_dict(100) - keys_base >= 100)  // the keys, alive with it
assert_true(GC.stat().live_objects - keys_base < 50)  // and gone with it

// --- keys from data make a bounded number of layouts ---------------------------

// A layout is kept for the life of the process, so the ones a key from data
// asks for are budgeted: 8,192 for the whole process. Past it, a plain Object
// that would need a layout no Object has had becomes a dictionary instead. So
// this section spends the budget first, whatever earlier code left of it.
let data_budget = 8192
GC.stat()
let budget_base = GC.stat().shapes
for i in 0..data_budget + 100 {
  mut one = {}
  one["spend{i}"] = i
}
assert_true(GC.stat().shapes - budget_base <= data_budget)

// Every way a key from data reaches an Object stops making layouts there,
// and the Object it builds still reads, lists and shows the same.
fn layouts_made(build) {
  let before = GC.stat().shapes
  build()
  GC.stat().shapes - before
}

assert_eq(layouts_made(fn () {
  for i in 0..50 {
    mut o = {}
    o["sub{i}"] = i
    o["sub{i}b"] = i + 1
    assert_eq(o["sub{i}"] + o["sub{i}b"], 2 * i + 1)
    assert_eq(o.keys(), ["sub{i}", "sub{i}b"])
  }
}), 0)

assert_eq(layouts_made(fn () {
  for i in 0..50 {
    let o = JSON.parse("\{\"json{i}\": {i}, \"json{i}b\": 1}")
    assert_eq(o["json{i}"], i)
    assert_eq(JSON.stringify(o), "\{\"json{i}\":{i},\"json{i}b\":1}")
  }
}), 0)

assert_eq(layouts_made(fn () {
  for i in 0..50 {
    let o = [("pair{i}", i)].iter().to_object()
    assert_eq(o["pair{i}"], i)
  }
}), 0)

assert_eq(layouts_made(fn () {
  for i in 0..50 {
    let g = ["g{i}a", "g{i}b"].group_by(|w| w)
    assert_eq(g.keys(), ["g{i}a", "g{i}b"])
  }
}), 0)

assert_eq(layouts_made(fn () {
  for i in 0..50 {
    mut o = {}
    o.get_or_put("put{i}", || []).push(i)
    assert_eq(o["put{i}"], [i])
  }
}), 0)

assert_eq(layouts_made(fn () {
  for i in 0..50 {
    let src = JSON.parse("\{\"spread{i}\": {i}}")
    let o = {...src}
    assert_eq(o["spread{i}"], i)
  }
}), 0)

// Each parser's own first call makes the few layouts it always uses.
TOML.parse("warm = 1")
Env.parse("WARM=1")
CSV.parse("warm\n1", header: true)
assert_eq(layouts_made(fn () {
  for i in 0..50 {
    assert_eq(TOML.parse("toml{i} = {i}")["toml{i}"], i)
    assert_eq(Env.parse("ENV{i}=v")["ENV{i}"], 'v')
    assert_eq(CSV.parse("csv{i}\n1", header: true)[0]["csv{i}"], '1')
  }
}), 0)

// A name the program spells is never limited: a literal's keys, quoted ones
// included, `o.name = v` and a class's fields still take their layouts once
// the budget is spent.
assert_eq(layouts_made(|| {after_budget_literal: 1}), 1)
assert_eq(layouts_made(|| {"after-budget-quoted": 1, n: 2}), 2)
assert_eq(layouts_made(fn () {
  mut o = {}
  o.after_budget_named = 2
}), 1)

class AfterBudget {
  new(@after_budget_field) {}
}
assert_eq(layouts_made(|| AfterBudget(7).after_budget_field), 1)
