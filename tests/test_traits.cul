// Conformance: trait / protocol (Phase 4 MVP).
// Structural conformance — any class with the required methods
// (matching arity) satisfies a trait. Default-impl methods declared
// inside the trait are inherited automatically.

// --- User trait: declaration + conformance via dispatch ---
trait Greeter {
  hello() -> String
}

class Bob {
  new(name) {
    self.name = name
  }
  hello() {
    "hi, {self.name}"
  }
}
class Mute {
  new() {}
}

fn greet(x: Greeter) -> String {
  x.hello()
}
assert_eq(greet(Bob.new("Alice")), "hi, Alice")

// Mute lacks hello() — Greeter param rejects the dispatch.
let e = try {
  greet(Mute.new())
  nil
} catch e {
  e
}
assert_eq(e.kind, "DispatchError")

// --- Default method dispatch ---
trait Counter {
  current() -> Long
  next() -> Long {
    self.current() + 1
  }
}

class Zero {
  new() {}
  current() {
    0
  }
}
class Five {
  new() {}
  current() {
    5
  }
  next() {
    99
  }  // override default
}
assert_eq(Zero.new().next(), 1)   // from default
assert_eq(Five.new().next(), 99)  // override wins

// --- Built-in: Stringer ---
class Tag {
  new(v) {
    self.v = v
  }
  to_s() {
    "<{self.v}>"
  }
}
fn show(x: Stringer) -> String {
  x.to_s()
}
assert_eq(show(Tag.new("ok")), "<ok>")

// --- Built-in: Eq with default neq ---
class Box {
  new(v) {
    self.v = v
  }
  eq(other) {
    self.v == other.v
  }
}
let a = Box.new(1)
let b = Box.new(1)
let c = Box.new(2)
assert_true(a.eq(b))
assert_true(a.neq(c))   // default
assert_false(a.neq(b))  // default

// --- Built-in: Comparable with full six-way default suite ---
class Pri {
  new(v) {
    self.v = v
  }
  cmp(other) {
    self.v - other.v
  }
}
let lo = Pri.new(1)
let hi = Pri.new(5)
assert_true(lo.lt(hi))
assert_true(lo.le(hi))
assert_true(lo.le(lo))
assert_true(hi.gt(lo))
assert_true(hi.ge(lo))
assert_true(hi.ge(hi))

// --- Trait param wins dispatch tie when no concrete overload ---
fn render(x: Stringer) -> String {
  "S:{x.to_s()}"
}
fn render(x: Pri) -> String {
  "P:{x.v}"
}  // concrete > trait

let p = Pri.new(7)
assert_eq(render(p), "P:7")  // concrete wins
let t = Tag.new("hi")
assert_eq(render(t), "S:<hi>")  // only trait path matches

// --- Built-in primitives satisfy the standard traits ---
// Stringer applies to every value; Eq to most; Comparable to the
// value primitives (Bool / Long / Float / String). Dispatch sees
// the conformance via the hard-coded table — primitives don't
// participate in the structural method-set walk.
fn stringify(x: Stringer) -> String {
  to_string(x)
}
assert_eq(stringify(42), "42")
assert_eq(stringify(3.14), "3.14")
assert_eq(stringify("hi"), "hi")
assert_eq(stringify([1, 2, 3]), "[1, 2, 3]")

fn comparable_only(x: Comparable) -> String {
  "ok"
}
assert_eq(comparable_only(1), "ok")
assert_eq(comparable_only("x"), "ok")
let e_cmp = try {
  comparable_only([1, 2])
  nil
} catch e {
  e
}
assert_eq(e_cmp.kind, "DispatchError")  // Array isn't Comparable here

// --- An inherited default outranks a same-named free function ---
// A default a class conforms to is one of that instance's methods, so it sits
// above UFCS in the resolution order — the receiver resolves the name itself.
trait Announcer {
  greet() -> String {
    "trait-default"
  }
  hail(sep) -> String {
    "trait-hail{sep}"
  }
}

class Plain {
  new() {}
}
class Loud {
  new() {}
  greet() {
    "own-method"
  }
}

fn greet(x) -> String {
  "free-function"
}
fn hail(x, sep) -> String {
  "free-hail"
}

assert_eq(Plain.new().greet(), "trait-default")
assert_eq(Loud.new().greet(), "own-method")  // a real method still wins
assert_eq(Plain.new().hail("?"), "trait-hail?")
assert_eq(Plain.new().hail(sep: "!"), "trait-hail!")  // same gate, kwargs arm
// A plain dict inherits nothing, so the free function keeps the name.
assert_eq({}.greet(), "free-function")
assert_eq({greet: fn () {
  "dict-slot"
}}.greet(), "dict-slot")

// --- A declaration registers when it runs, and replaces the earlier one ---
class Swappy {
  new() {}
  m() {
    0
  }
}

trait Swap {
  m() -> Long
  d() -> Long {
    1
  }
}
assert_eq(Swappy.new().d(), 1)

trait Swap {
  m() -> Long
  d() -> Long {
    2
  }
}
assert_eq(Swappy.new().d(), 2)

// Re-declared without the default: the earlier body is gone, not shadowed.
trait Swap {
  m() -> Long
}
assert_eq(Swappy.new().d, nil)

// A required method dropped by a re-declaration is really dropped.
trait Shrink {
  m() -> Long
  gone() -> Long
}

fn conforms(x: Shrink) -> String {
  "yes"
}
let missed = try {
  conforms(Swappy.new())
  nil
} catch e {
  e.kind
}
assert_eq(missed, "DispatchError")
trait Shrink {
  m() -> Long
}
assert_eq(conforms(Swappy.new()), "yes")

// An unreached declaration registers nothing.
if false {
  trait Unreached {
    m() -> Long
    zz() -> Long {
      7
    }
  }
}
assert_eq(Swappy.new().zz, nil)

// --- A default outranks the built-in fallbacks ---
// It is a method the class inherited, so it wins over the dict builtins
// (`size`) and the synthesized `parameters()`, exactly as a method the
// class declares itself does.
trait Ranked {
  m() -> Long
  size() -> Long {
    42
  }
  parameters() -> Long {
    43
  }
}
assert_eq(Swappy.new().size(), 42)
assert_eq(Swappy.new().parameters(), 43)

// --- A default's declared return type is checked ---
trait Strict {
  m() -> Long
  as_str() -> String {
    self.m()
  }
}
let bad_ret = try {
  Swappy.new().as_str()
  nil
} catch e {
  e.kind
}
assert_eq(bad_ret, "TypeError")

// --- A `__call__` default makes conforming instances callable ---
trait Applicable {
  m() -> Long
  __call__(a) -> Long {
    self.m() + a
  }
}
assert_eq(Swappy.new()(5), 5)

# A trait default is an inherited method, so it makes the receiver RESOLVE
# that name — which is what keeps a same-named free function from claiming
# the call. `drop` asks this question through its own gate, so it is the one
# that shows a gate reading only own/proto membership.
trait Closeable {
  drop() { 'trait drop' }
  tagged() { 'trait tagged' }
}
fn drop(x) { 'free drop' }
fn tagged(x) { 'free tagged' }
class Res {
  new(a) { self.a = a }
}
# The trait's `drop` resolves, so this is the drop intercept (which answers
# nil), not the free function.
assert_eq(Res.new(1).drop(), nil)
assert_eq(Res.new(1).tagged(), 'trait tagged')
# A receiver that conforms to nothing still hands both names over.
assert_eq((5).drop(), 'free drop')
assert_eq((5).tagged(), 'free tagged')

IO.inspect("test_traits OK")
