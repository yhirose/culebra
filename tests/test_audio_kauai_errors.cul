# Audio.Kauai's mistakes (section 9 of docs/kauai/language.md): each is found
# before anything plays, and says what is wrong and on which line. The line
# numbers count the lines of the song each case builds.

let lines = |xs| xs.join("\n")
let sec = |name, body| lines(['section ' + name + ' {', body, '}'])
let song = fn (head, sections) {
  lines([
    'band B {',
    '  voice M   pulse        plays melody            vol 10',
    '  voice Bs  triangle     plays roots in E2..D#3  vol 10',
    '  voice Ch  external Ep  plays chords from C4  poly  vol 40',
    '}',
    'song S {',
    '  tempo 100',
    '  band B',
    '  groove G',
    '  melody in C4..B4',
    head,
    '}',
    'groove G {',
    '  Bs 1 5',
    '  Ch x -',
    '}',
    sections,
  ])
}
# The section T, played as `head` says; its first bar is line 18.
let play = |head, body| song(head, sec("T", body))
let with_hits = fn (body) {
  lines([
    'band B {',
    '  voice M   pulse     plays melody            vol 10',
    '  voice Bs  triangle  plays roots in E2..D#3  vol 10',
    '  voice P   saw       plays part A            vol 10',
    '  drum Kick external Kick plays hits vol 80',
    '}',
    'song S {',
    '  tempo 100',
    '  band B',
    '  groove G',
    '  melody in C4..B4',
    '  T',
    '}',
    'groove G {',
    '  Bs 1 5 1 5',
    '}',
    sec("T", body),
  ])
}
# A section played twice, whose second bar (line 13) is `second`.
let twice = fn (second) {
  lines([
    'band B {',
    '  voice M pulse plays melody poly vol 10',
    '  voice P triangle plays part A vol 10',
    '}',
    'song S {',
    '  tempo 100',
    '  band B',
    '  melody in C4..B4',
    '  T x2',
    '}',
    sec("T", "  F  c1\n  " + second),
  ])
}
let error_of = fn (text) {
  try {
    Audio.Kauai.new(
      text,
      voices: {ep: |pitch, params| nil},
      drums: {kick: |params| nil},
    )
    nil
  } catch e {
    "{e.kind}: {e.message}"
  }
}
let fails = |text, message| assert_eq(error_of(text), "KauaiError: " + message)

# Notes, chords and ranges.
fails(
  play("  T", "melody in F#4..F5\n  C c1"),
  "line 18: a range starts on a natural note: F#4..F5",
)
fails(play("  T", "C c#b1"), "line 18: a note is sharp or flat, not both: c#b")
fails(play("  T", "C F G c1"), "line 18: 3 chords do not share 4 beats evenly")
fails(
  play("  T", "C / G7 c1"),
  "line 18: with slashes, a bar gives a chord or a / for each of its 4 beats",
)
fails(
  play("  T", "/ / / / c1"),
  "line 18: the first bar of a section or an ending names its chords",
)
fails(
  play("  T", "C7(10) c1"),
  "line 18: a tension is 9, b9, #9, 11, #11, 13 or b13, or a b5 or #5: 10 in C7(10)",
)
fails(
  play("  T", "C7(b11) c1"),
  "line 18: a tension is 9, b9, #9, 11, #11, 13 or b13, or a b5 or #5: b11 in C7(b11)",
)
fails(play("  T", "C7(9,9) c1"), "line 18: 9 is written twice in C7(9,9)")
fails(
  play("  T", "C7(5) c1"),
  "line 18: a fifth in parentheses is b5 or #5: 5 in C7(5)",
)
fails(play("  T", "C7(9 c1"), "line 18: unknown chord: C7(9")
fails(
  lines(['voicings {', '  m7 0 3 7 10', '}', play("  T", "C c1")]),
  "line 2: m7 is already a chord quality",
)
fails(twice("c2 ~ c2"), "line 13: a tie is written against its note: c2~ c")
fails(
  twice("~c2 r"),
  "line 13: an arpeggio rolls a chord, its ~ right before the <: ~<c e g>",
)
fails(
  twice('c2~ {d}c4 r'),
  "line 13: grace notes lead into a note, not a tied one",
)
fails(
  twice('{d}r2 r'),
  'line 13: grace notes lead into a note, not a rest: {d}r2',
)
fails(twice('.{d}c2 r'), 'line 13: grace notes come before the marks: {d}.c8')

# Marks, slurs, ties and dynamics, some only found at the end of the song.
fails(
  play("  T", "C c2~ .c2"),
  "line 18: a note held by a tie is not struck, and takes no marks",
)
fails(
  play("  T", "C c2~ @c2"),
  "line 18: a note held by a tie is not struck, and takes no marks",
)
fails(
  play("  T", "C c2. .r4"),
  "line 18: a rest takes no playing marks but a fermata: .r4",
)
fails(play("  T", "C c4 d e f)"), "line 18: a ) with no ( open")
fails(
  play("  T", "C (c4 (d e) f)"),
  "line 18: a slur is open already; close it with ) first",
)
fails(
  play("  T", "C (c4 d e f\ng1"),
  "line 18: the melody: a slur the song never closes",
)
fails(
  play("  T", "C c1~"),
  "line 18: the melody: a tie at the end of the song, with no note to tie to",
)
fails(
  play("  T", "C \\cresc c1"),
  "line 18: the melody: a cresc that nothing ends",
)

# Meter, tempo, grooves, pickups and repeats.
fails(
  play("  T", "meter 3/5\nC c2."),
  "line 18: a meter's beat is a note value: 3/5",
)
fails(
  play("  T", "C c1").replace("tempo 100", "tempo 3=60"),
  "line 7: 3 is not a note value (1 2 4 8 16 32)",
)
fails(
  play(
    "  T",
    "C c1",
  ).replace("  Bs 1 5\n  Ch x -", "  Bs 1 - - - - - - - - - - - - - -"),
  "line 14: a bar of 15 steps makes each one no note value (plain, dotted or triplet): count the steps",
)
for room in ["room 40", "room 0%", "room 120%", "room", "room 40% 50%"] {
  fails(play("  {room}\n  T", "C c1"), "line 11: a room is how much of its echo is heard: room 40%")
}
fails(
  play("  T\n  loop", "pickup g a\nC c1"),
  "line 19: the song loops, so its last bar has to rest where the pickup plays",
)
fails(
  play("  T", "%\nC c1"),
  "line 18: % repeats the bar before it in its section or ending",
)
fails(
  play("  T", "C c1\n%%"),
  "line 19: %% repeats the two bars before it in its section or ending",
)
fails(
  play("  T", "C c1\n%\n  2nd: d1"),
  "line 20: a % bar plays as the bar it repeats; write the bar out to change it",
)
fails(
  play("  T", "C c1\nmeter 3/4\n%"),
  "line 20: the bar is 4.0 beats long, want 3",
)
fails(
  play("  T", "C c1").replace("  voice Ch  external Ep  plays chords from C4  poly", "  voice Ch  external Ep  plays chords from C4"),
  "line 15: Ch plays x, the whole chord, under the bar at line 18, and is not poly",
)
for opt in ["env 1 2 3", "gap 2", "duty 1/4"] {
  fails(
    play("  T", "C c1").replace("poly  vol 40", "poly  vol 40  {opt}"),
    "line 4: an external voice plays its sound through: no env, gap or duty",
  )
}
# An external sound the program does not supply is the program's ValueError,
# on the line of the voice or drum that plays it, with the names it does.
let unsupplied = |what| "ValueError: Audio.Kauai: " + what
assert_eq(
  error_of(play("  T", "C c1").replace("external Ep", "external Organ")),
  unsupplied("line 4: voice Ch plays `external Organ`, and voices: has no `organ` (it has ep)"),
)
assert_eq(
  error_of(with_hits("C c1\n  hits: x1").replace("external Kick", "external Snare")),
  unsupplied("line 5: drum Kick plays `external Snare`, and drums: has no `snare` (it has kick)"),
)
assert_eq(
  try { Audio.Kauai.new(play("  T", "C c1")); nil } catch e { "{e.kind}: {e.message}" },
  unsupplied("line 4: voice Ch plays `external Ep`, and voices: has no `ep` (it has none)"),
)
# A vol is the tones' 0 to 100, an external voice's and drum's too: a
# percentage is none.
fails(play("  T", "C c1").replace("poly  vol 40", "poly  vol 40%"), "line 4: a voice's vol is 0 to 100, as Audio.tone's: vol 20")
fails(play("  T", "C c1").replace("roots in E2..D#3  vol 10", "roots in E2..D#3  vol 10%"), "line 3: a voice's vol is 0 to 100, as Audio.tone's: vol 20")
fails(
  with_hits("C c1").replace("plays hits vol 80", "plays hits vol 80%"),
  "line 5: a drum's vol is 0 to 100, as Audio.tone's: vol 20",
)
# A parameter is a word and a number, on a voice and in a score alike.
for bad in ["bright=", "Bright=1", "bright=x", "=1", "bright=1.", "bright=.5"] {
  fails(
    play("  T", "C c1").replace("external Ep", "external Ep {bad}"),
    "line 4: a parameter is a word and a number, bright=0.8: {bad}",
  )
  fails(play("  T", "C \\{bad} c1"), "line 18: a parameter is a word and a number, bright=0.8: {bad}")
}

# Later times, hits and the song's lines.
fails(
  play("  T x2", "C c1\n2nd:"),
  "line 19: `2nd:` gives the bar's chords, its notes, or both",
)
fails(twice("C c1\n  2x: e1"), "line 14: the 2nd time is written 2nd, not 2x")
fails(
  twice("C c1\n  3rd: e1"),
  "line 14: T plays 2 times, so this time never comes",
)
fails(twice("C c1\n  A 2nd: e1"), "line 14: the time comes first: `2nd A:`")
fails(
  twice(lines(['C c1', '  part A {', '    2nd: e1', '    .', '    g1', '  }'])),
  "line 15: in a part block, a `2nd:` line comes under the line it changes",
)
fails(
  with_hits("C c1\n  hits: c2 r"),
  "line 19: hits are x (strike) and r (rest), with a value, the marks . ! - ^ and a jazz articulation: c2",
)
fails(
  with_hits("C c1\n  hits: (x4 x) r2"),
  "line 19: hits are x (strike) and r (rest), with a value, the marks . ! - ^ and a jazz articulation: (",
)
fails(
  with_hits("C c1\n  hits: \\p x1"),
  "line 19: hits are x (strike) and r (rest), with a value, the marks . ! - ^ and a jazz articulation: \\p",
)
fails(with_hits("C c1\n  hits: \\fall r2 x2"), "line 19: \\fall marks a note, not a rest")
fails(
  with_hits("C c1\n  hits: x2"),
  "line 19: the hits are 2.0 beats long, want 4",
)
fails(
  with_hits("C c1\n  hits: x1\n  hits: x1"),
  "line 20: hits: is written twice under one bar",
)
fails(
  with_hits("C c1").replace("plays part A", "plays hits"),
  "line 4: only a drum plays hits",
)
fails(play("  T in D in E", "C c1"), "line 11: `in` is said once a line")

# The jazz bends mark the note after them, once each.
fails(play("  T", "C  c2 \\doit r2"), "line 18: \\doit marks a note, not a rest")
fails(play("  T", "C  c2~ \\fall c2"), "line 18: a note held by a tie is not struck, and takes no marks")
fails(play("  T", "C  c2 \\fall \\fall d2"), "line 18: \\fall is written once for its note")
fails(play("  T", "C  c1 \\fall"), "line 18: \\fall with no note after it in its bar")
# A choke group is an external drum's, and one name.
fails(
  with_hits("C c1").replace("drum Kick external Kick plays hits vol 80", "drum Kick external Kick vol 80 choke A B"),
  "line 5: a choke group is one name: choke Hats",
)
fails(
  with_hits("C c1").replace("drum Kick external Kick plays hits vol 80", "drum Kick noise 120 len 1 vol 20 choke Hats"),
  "line 5: a noise drum sounds one at a time already; choke groups external drums",
)

# What is written is read, or it is an error: never left unread, never put in
# place of what is written before it, never written for nothing.
# A word a line does not take, or past the line's form.
let base = play("  T", "C c1")
fails(base.replace("pulse        plays melody", "pulse loud   plays melody"), "line 2: a voice takes no `loud`")
fails(base.replace("external Ep  plays chords", "external Ep warm plays chords"), "line 4: a voice takes no `warm`")
fails(base.replace("poly  vol 40", "poly x vol 40"), "line 4: a voice takes no `x`")
fails(
  base.replace("pulse        plays melody", "pulse bright=1 plays melody"),
  "line 2: a voice on a tone channel plays as written and takes no parameter: bright=1 is an external instrument's",
)
fails(with_hits("C c1").replace("external Kick plays hits", "external Kick big plays hits"), "line 5: a drum takes no `big`")
fails(
  with_hits("C c1").replace("drum Kick external Kick plays hits vol 80", "drum Kick noise 120 tone=1 len 1 vol 20"),
  "line 5: a noise drum plays as written and takes no parameter: tone=1 is an external instrument's",
)
fails(base.replace("  voice Ch", "  M echoes M soon late 1/8 level 50%\n  voice Ch"), "line 4: an echo takes no `soon`")
fails(play("  T now", "C c1"), "line 11: a line that plays a section takes no `now`")
fails(play("  T ending 1 2", "C c1"), "line 11: ending takes a word: ending ...")
fails(play("  T x0", "C c1"), "line 11: `xN` plays it N times, N a count: x2")
fails(play("  loop now\n  T", "C c1"), "line 11: `loop` stands alone")
fails(play("  key Bbx\n  T", "C c1"), "line 11: a key is a pitch name, with m for minor: Eb, F#m; not Bbx")
fails(play("  T", "melody up C4..B4\n  C c1"), "line 18: `melody in LO..HI`")
fails(base.replace("section T \{", "section T now \{"), "line 17: a section is `section NAME \{`, or `section NAME key K \{`")
fails(play("  T ending 1", "C c1\n  ending 1 again \{\n    C c1\n  }"), "line 19: an ending is `ending N \{`, or `ending N as written \{`")
fails(base + "\nvoicings \{\n  wide 0 M3\n}", "line 21: a voicing's intervals are semitones over the root: M3")
# Written twice.
fails(play("  tempo 90\n  T", "C c1"), "line 11: the song's tempo is written twice")
fails(base.replace("  Bs 1 5\n", "  Bs 1 5\n  Bs 5 1\n"), "line 15: row Bs is written twice")
fails(play("  T ending 1", "C c1\n  ending 1 \{\n    C c1\n  }\n  ending 1 \{\n    C c1\n  }"), "line 22: ending 1 is written twice")
fails(play("  T", "pickup c4\n  pickup d4\n  C c1"), "line 19: a pickup is written twice")
fails(with_hits("C c1").replace("drum Kick external", "drum P external"), "line 5: P names a voice already, and a drum may not share it")
fails(
  base.replace("poly  vol 40", "poly  vol 40\n  Ch echoes M late 1/8 level 50%\n  Ch echoes M late 1/4 level 50%"),
  "line 6: an echo for Ch is written twice",
)
# Written for nothing.
fails(base.replace("  Ch x -", "  Ch x -\n  M 1 1"), "line 16: M plays neither roots nor chords, so it has no groove row to play")
fails(base.replace("  Ch x -", "  Ch x 0"), "line 15: Ch plays `0` under the bar at line 18: a chord row is places 1 2 3 ..., x, - and .")
fails(play("  T", "C c1\n    Fill: c1"), "line 19: no voice of B plays part Fill: give one `plays part Fill`")
fails(play("  part Fil in C4..B4\n  T", "C c1"), "line 11: a range for part Fil, which the song never writes")
fails(play("  T ending 2", "C c1"), "line 11: T has no endings, so no ending 2")
# A tie in the hits or a part is a melody's: it holds into the line's next
# bar, and only into a note.
fails(with_hits("C c1\n  hits: x4~ r4 x2"), "line 19: a tie into a rest")
fails(with_hits("C c1\n  hits: x1~"), "line 19: the hits: a tie at the end of the song, with no note to tie to")
fails(with_hits("C c1\n  hits: x1~\n  C c1"), "line 19: a tie holds the hits on into a bar that has none")
fails(with_hits("C c1\n  hits: x2~ !x2"), "line 19: a note held by a tie is not struck, and takes no marks")
fails(with_hits("C c1\n  A: c1~\n  C c1"), "line 19: a tie holds part A on into a bar that has none")
fails(base.replace("  Bs 1 5\n", "  Bs 1 ~\n"), "line 18: not a degree: ~")
fails(twice("C c1\n  2nd: d1\n  2nd: e1"), "line 15: `2nd:` under one bar is written twice")
fails(twice("C c1\n    2nd A: d1\n    2nd A: e1"), "line 15: `2nd A:` under one bar is written twice")
fails(play("  T", "part Fill in C4..B4\n  C c1"), "line 18: a range for part Fill, which section T never writes")
