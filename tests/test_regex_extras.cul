// Regex extras: Regex.escape / replace_all(fn) / find_iter (lazy).
// See docs/regex_stdlib_api.md, docs/stdlib.md §12.

// --- Regex.escape: quote metacharacters so a string matches literally ---
assert_eq(Regex.escape("a.b(c)"), `a\.b\(c\)`)
assert_eq(Regex.escape("1+1=2"), `1\+1=2`)        // '=' is not a metachar
// escaped string matches the literal text, not as a regex
assert_true(Regex.compile(Regex.escape("a.b")).test("a.b"))
assert_false(Regex.compile(Regex.escape("a.b")).test("axb"))
// building a literal-in-larger-pattern
let word = "C++"
assert_true(Regex.compile(`\b` + Regex.escape(word)).test("use C++ here"))

// --- replace_all with a function argument ---
let d = Regex.compile('\d+')
assert_eq(d.replace_all("a1 b22 c333", fn (m) { "<{m.value}>" }),
          "a<1> b<22> c<333>")
// the callback sees the whole Match (groups, offsets)
assert_eq(Regex.compile('(\w)(\w)').replace_all("ab cd", fn (m) {
            m.groups[2].value + m.groups[1].value
          }), "ba dc")
// String repl still uses the $-template fast path
assert_eq(d.replace_all("x9y", "#"), "x#y")

// --- find_iter: lazy iterator over matches ---
let s = "a1 b22 c333"
let mut vals = []
for m in d.find_iter(s) { vals.push(m.value) }
assert_eq(vals.size(), 3)
assert_eq(vals[0], "1")
assert_eq(vals[2], "333")
// offsets are absolute (into the original subject)
let second = d.find_iter("ab 42 cd 7").take(1).collect()  // first match only
assert_eq(second[0].value, "42")
assert_eq(second[0].start, 3)

// find_iter agrees with find_all (incl. count) on the same pattern
assert_eq(d.find_iter(s).collect().size(), d.find_all(s).size())

// early exit: take just the first 2 of many
assert_eq(d.find_iter("1 2 3 4 5").take(2).collect().size(), 2)

// empty-match pattern must still terminate and agree with find_all
let b = Regex.compile('\b')
assert_eq(b.find_iter("hi yo").collect().size(), b.find_all("hi yo").size())

// grapheme-aware: '.' consumes one grapheme cluster (🇯🇵 = 8 bytes)
let g = Regex.compile('.')
let gs = g.find_iter("🇯🇵x").collect()
assert_eq(gs[0].end, 8)
assert_eq(gs[1].value, "x")

// --- find_all_str / count: lean bulk APIs (no Match objects) ---
let w = Regex.compile('\w+')
assert_eq(w.find_all_str("a1 b22 c333"), ["a1", "b22", "c333"])
assert_eq(w.find_all_str("nope-here").size(), 2)   // "nope", "here"
assert_eq(w.count("a1 b22 c333"), 3)
assert_eq(Regex.compile('\d+').count("a1 b22 c333"), 3)
assert_eq(Regex.compile('x').count("yyy"), 0)
// find_all_str agrees with find_all's values
let s2 = "the 7 cats 99 dogs"
assert_eq(Regex.compile('\d+').find_all_str(s2), ["7", "99"])

// --- find_all_index: flat byte spans [s0, e0, s1, e1, ...] ---
let dd = Regex.compile('\d+')
assert_eq(dd.find_all_index("a1 b22"), [1, 2, 4, 6])   // "1"@[1,2), "22"@[4,6)
assert_eq(dd.find_all_index("none"), [])
// spans agree with the Match start/end from find_all
let ix = dd.find_all_index(s2)
let ms = dd.find_all(s2)
assert_eq(ix[0], ms[0].start)
assert_eq(ix[1], ms[0].end)
assert_eq(ix.size(), ms.size() * 2)

puts("test_regex_extras: ok")
