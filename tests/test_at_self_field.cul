# Conformance: `@name` is `self.name`. The grammar builds the nodes `self.name`
# builds and a later pass reads the head as `self`, so every shape below has to
# behave exactly as its `self.` spelling does, on every engine.
#
# Run: ./build/culebra tests/test_at_self_field.cul
#      ./build/culebra --jit tests/test_at_self_field.cul

class Counter {
  n = 10
  new(@step) {
    @items = []
    @total = 0
  }

  # a read, a compound write, a plain write, an index write
  bump() {
    @total += @step
    @items.push(@total)
    @items[0] = @items[0] + 0
    @n = @n - 1
    @total
  }

  # a method call, a chain, `?.`, an expression statement
  size() {
    @items.size()
  }
  doubled() {
    @items
      .map(|x| x * 2)
      .filter(|x| x > 0)
  }
  total_or_nil() {
    @missing?.size()
  }
  twice() {
    @bump()
    @bump()
  }

  # a getter, a `static`, a closure, a nested lambda and an interpolation
  get last() {
    @items[@items.size() - 1]
  }
  later() {
    f = fn () {
      @total * 2
    }
    f
  }
  show() {
    "{@total}/{@items.size()}"
  }
  each_total() {
    @items.map(|x| x + @step)
  }

  # a parallel assignment whose targets are `@` places
  swap() {
    (@a, @b) = (1, 2)
    (@a, @b) = (@b, @a)
    (@a, @b)
  }

  # postfix modifiers and a ternary
  clamp_total() {
    @total = 0 if @total > 100
    @total > 5 ? @total : -1
  }

  # a generator, and a method that holds `@` across a yield
  gen() {
    for x in @items {
      yield x + @step
    }
  }
}

c = Counter(3)
assert_eq(c.bump(), 3)
assert_eq(c.bump(), 6)
assert_eq(c.size(), 2)
assert_eq(c.doubled(), [6, 12])
assert_eq(c.total_or_nil(), nil)
assert_eq(c.twice(), 12)
assert_eq(c.last, 12)
assert_eq(c.later()(), 24)
assert_eq(c.show(), "12/4")
assert_eq(c.each_total(), [6, 9, 12, 15])
assert_eq(c.n, 6)
assert_eq(c.swap(), (2, 1))
assert_eq(c.clamp_total(), 12)
assert_eq(c.gen().collect(), [6, 9, 12, 15])

# the two spellings are interchangeable on one instance
class Mixed {
  new() {
    self.a = 1
    @b = 2
  }
  sum() {
    @a + self.b
  }
}
assert_eq(Mixed().sum(), 3)

# `@` binds like `self.`: it is a receiver, so a binary operator follows it
class Calc {
  new(@x, @y) {}
  ops() {
    (@x + @y, @x - @y, @x * @y, @x ** 2, -@x, !(@x == @y))
  }
}
assert_eq(Calc(6, 2).ops(), (8, 4, 12, 36, -6, true))

# an effect handler and a generator written with `@` in the body
class Logger {
  new() {
    @lines = []
  }
  run() {
    handle {
      perform note("a")
      perform note("b")
    } with note(msg, resume) {
      @lines.push(msg)
      resume(nil)
    }
    @lines
  }
}
effect fn note(msg)
assert_eq(Logger().run(), ['a', 'b'])

# a nested handle, and a `defer`, reach the instance through `@` too
class Nested {
  new() {
    @out = []
    @n = 5
  }
  run() {
    handle {
      handle {
        perform note("in")
        @out.push("body")
      } with note(msg, resume) {
        @out.push(msg)
        resume(nil)
      }
    } with note(msg, resume) {
      @out.push("outer")
      resume(nil)
    }
    @out
  }
  guarded() {
    defer {
      @n = 0
    }
    @n + 1
  }
}
nested = Nested()
assert_eq(nested.run(), ['in', 'body'])
assert_eq(nested.guarded(), 6)
assert_eq(nested.n, 0)

# `@` outside a method is the same NameError `self` is
assert_eq(try {
  fn () {
    @x
  }()
} catch e {
  e.kind
}, 'NameError')

# an `@` that is not a field read stays what it was: a matrix product (with
# and without a space, as an operator and as `@=`), and a decorator
class M {
  new(@v) {}
  __matmul__(o) {
    M(@v * o.v)
  }
}
assert_eq((M(3) @M(4)).v, 12)
assert_eq((M(3) @ M(4)).v, 12)
mut acc = M(2)
acc @= M(5)
assert_eq(acc.v, 10)

fn tag(f) {
  f
}
@tag
fn decorated() {
  1
}
assert_eq(decorated(), 1)
