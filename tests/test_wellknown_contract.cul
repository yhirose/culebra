# Conformance: well-known property contract (drop/iter/has_next/next).
# See docs/language.md §Auto-drop and §Iteration protocol. The bind-time
# contract — a Function bound to one of the names takes no arguments — must
# hold on every write surface, with the immutable gate checked first. A value
# that is not a Function is data that happens to use the name: section (8).
# The difftest corpus (dimension `wkprop|`) pins backend symmetry; this
# file pins the contract itself with expected values.

# --- (1) dynamic and literal subscript keys ---
let r1 = try {
  mut o = {mut x: 1}
  let k = "drop"
  o[k] = fn (a) {
    a
  }
  nil
} catch e {
  e
}
assert_eq(r1.kind, 'DropContractError')
assert_eq(
  r1.message,
  "type error: 'drop' must be a Function taking no arguments.",
)

let r1b = try {
  mut o = {mut x: 1}
  o["iter"] = fn (a) {
    a
  }
  nil
} catch e {
  e
}
assert_eq(r1b.kind, 'DropContractError')

# a conforming function through a dynamic key is accepted
mut o1 = {mut x: 1}
let k1 = "dro" + "p"
o1[k1] = fn () {
  nil
}
assert_eq(o1.x, 1)

# --- (2) native builders route through the same chokepoint: what they
#     build is data, so the names bind like any key ---
assert_eq(JSON.parse('{"drop": 42}').drop, 42)
assert_eq(JSON.parse('{"has_next": true}').has_next, true)
assert_eq(JSON.parse('{"x": 7}').x, 7)

# --- (3) check order: immutable gate wins over the contract ---
let r3 = try {
  let o = {drop: fn () {
    nil
  }}
  o.drop = 42
  nil
} catch e {
  e
}
assert_eq(r3.kind, 'ImmutableError')

# a mutable well-known slot: the contract still rejects a bad overwrite,
# and the old value stays in place (failed check must not clobber it)
mut log3 = []
mut o3 = {mut drop: fn () {
  log3.push("old")
}}
let r3b = try {
  o3.drop = fn (a) {
    a
  }
  nil
} catch e {
  e
}
assert_eq(r3b.kind, 'DropContractError')
o3 = nil
assert_eq(log3, ["old"])

# --- (4) class declarations enforce the contract on proto methods ---
let r4 = try {
  class B4a {
    new() {
      self.x = 1
    }
    drop(a) {
      a
    }
  }
  nil
} catch e {
  e
}
assert_eq(r4.kind, 'DropContractError')
let r4b = try {
  class B4b {
    next(n) {
      n
    }
  }
  nil
} catch e {
  e
}
assert_eq(r4b.kind, 'DropContractError')
# an overload set can't satisfy the 0-arg contract either
let r4c = try {
  class B4c {
    drop() {
      nil
    }
    drop(a) {
      a
    }
  }
  nil
} catch e {
  e
}
assert_eq(r4c.kind, 'DropContractError')
# ctor own-slot binds stay checked
let r4d = try {
  class B4d {
    new() {
      self.drop = fn (a) {
        a
      }
    }
  }
  B4d.new()
  nil
} catch e {
  e
}
assert_eq(r4d.kind, 'DropContractError')

# a legit 0-arg drop method still runs at scope exit
mut log4 = []
class OK4 {
  new() {
    self.x = 1
  }
  drop() {
    log4.push("dropped")
  }
}
fn scope4() {
  let v = OK4.new()
  nil
}
scope4()
assert_eq(log4, ["dropped"])

# --- (5) statics are a namespace: no contract, no drop protocol ---
class S5 {
  new() {
    self.x = 1
  }
  static drop(a) {
    a + 1
  }
}
assert_eq(S5.drop(1), 2)

# a 0-arg static drop is never auto-called (not an instance destructor)
mut log5 = []
fn scope5() {
  class T5 {
    new() {
      self.x = 1
    }
    static drop() {
      log5.push("static")
    }
  }
  let v = T5.new()
  nil
}
scope5()
assert_eq(log5, [])

# ...and is called like any other static: `C.drop()` is a member call, not the
# at-most-once guard, which belongs to instances
class U5 {
  static drop() {
    log5.push('static')
    'from static drop'
  }
  drop() {
    log5.push('instance')
  }
}
assert_eq(U5.drop(), 'from static drop')
assert_eq(U5.drop(), 'from static drop')
let u5 = U5()
assert_eq(u5.drop(), nil)
assert_eq(u5.drop(), nil)
assert_eq(log5, ['static', 'static', 'instance'])

# a free `drop` in scope does not claim the class's own
fn static_over_free() {
  let drop = fn (x) {
    'free drop'
  }
  U5.drop()
}
assert_eq(static_over_free(), 'from static drop')

# a class object, an enum or a namespace without one answers as for any
# missing member
class V5 {
  drop() {
    log5.push('never')
  }
}
enum W5 {
  A,
  B,
}
assert_eq(
  try {
    V5.drop()
  } catch e {
    e.kind
  },
  try {
    V5.no_such_member()
  } catch e {
    e.kind
  },
)
assert_eq(
  try {
    W5.drop()
  } catch e {
    e.kind
  },
  try {
    W5.no_such_member()
  } catch e {
    e.kind
  },
)
assert_eq(try {
  Math.drop()
} catch e {
  e.kind
}, 'AttributeError')

# what is no part of either still answers nil
assert_eq(5.drop(), nil)
assert_eq({a: 1}.drop(), nil)

# --- (6) channel transfer: the receiver copy keeps the drop protocol ---
# (captures are deep-copied on send, so observe the drops via a channel)
let (ntx6, nrx6) = Channel.new(2)
fn roundtrip6() {
  let (tx, rx) = Channel.new(1)
  tx.send({x: 1, drop: fn () {
    ntx6.send("dropped")
  }})
  let o = rx.recv()
  assert_eq(o.x, 1)
  nil  # sender's copy and the received copy both drop by here
}
roundtrip6()
assert_eq(nrx6.recv(), "dropped")
assert_eq(nrx6.recv(), "dropped")

# --- (7) trait defaults enforce the contract at declaration time ---
# A default impl reaches every conforming instance without passing
# `initialize`, so it is checked where it is declared.
let r7 = try {
  trait T7a {
    tag() -> Long
    next(x) {
      x
    }
  }
  nil
} catch e {
  e
}
assert_eq(r7.kind, 'DropContractError')
assert_eq(
  r7.message,
  "type error: 'next' must be a Function taking no arguments.",
)

# a rest param is a param: this mirrors the interp's `params->empty()`
let r7b = try {
  trait T7b {
    tag() -> Long
    drop(*args) {
      1
    }
  }
  nil
} catch e {
  e
}
assert_eq(r7b.kind, 'DropContractError')
let r7c = try {
  trait T7c {
    tag() -> Long
    iter(**kw) {
      1
    }
  }
  nil
} catch e {
  e
}
assert_eq(r7c.kind, 'DropContractError')

# a 0-arg default on a well-known name stays legal and still dispatches
trait Counter7 {
  current() -> Long
  next() {
    self.current() + 1
  }
}
class Z7 {
  new() {}
  current() {
    41
  }
}
assert_eq(Z7.new().next(), 42)

# a body-less declaration states a requirement; it binds no value
let r7d = try {
  trait Req7 {
    next(x)
  }
  'ok'
} catch e {
  e.kind
}
assert_eq(r7d, 'ok')

# --- (8) a value that is not a Function is data, whatever its key ---
# Parsed text decides its own keys: `{"next": "<url>"}` is what a paginated
# API answers with. Such an Object is not a protocol member of anything.
let page = JSON.parse('{"drop": 1, "iter": 2, "has_next": 3, "next": "/page/2"}')
assert_eq(page.next, '/page/2')
assert_eq(page.keys(), ['drop', 'iter', 'has_next', 'next'])
# a `for` walks it by its keys, like any Object — the `iter` key is not an
# iterator constructor
mut seen8 = []
for k, v in page {
  seen8.push(k)
}
assert_eq(seen8, ['drop', 'iter', 'has_next', 'next'])
# copying it key by key, and spreading it, bind the same names again
let copy8 = {}
for k, v in page {
  copy8[k] = v
}
assert_eq(copy8, page)
assert_eq({...page}, page)
# nothing fires when it goes away, and nothing is there to call
{
  let gone = {drop: 'not a function'}
}
assert_eq(try {
  page.next()
} catch e {
  e.kind
}, 'TypeError')
# the literal and the assignment forms agree with the parsed one
assert_eq({next: 1}.next, 1)
mut o8 = {mut drop: 1}
o8.drop = 2
assert_eq(o8.drop, 2)
# data first, a real drop later: the Function is the member
mut log8 = []
{
  let late = {mut drop: 'data'}
  late.drop = fn () {
    log8.push('dropped')
  }
}
assert_eq(log8, ['dropped'])

IO.inspect('test_wellknown_contract OK')
