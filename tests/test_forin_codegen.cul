# Codegen-backend regression guard for the for-in iterator lowering.
#
# An earlier bug inserted an i8 tag into the i64 tag field of a %Value
# when building the iter receiver for the object / range / Iterator
# for-in paths. SDAG-O0 aborted legalizing the malformed aggregate
# ("Do not know how to promote this operator's operand"), and FastISel
# read the undefined upper bits as a garbage tag ("got ?"). O2 hid both.
# This file exercises every for-in form so the gate can diff interp vs
# --jit / --jit -O0 / --jit-faststart and catch a reintroduction on any
# codegen backend.

# Array element loop.
for x in [1, 2, 3] {
  inspect(x)
}

# Array via explicit .iter() (Iterator-object path).
for x in [10, 20].iter() {
  inspect(x)
}

# Object key/value loop (object_iter path).
for k, v in {a: 1, b: 2} {
  inspect(k)
  inspect(v)
}

# Range literal (counter fast path) and range object.
for i in 0..3 {
  inspect(i)
}
let r = 0..3
for i in r {
  inspect(i)
}

# Range value via explicit .iter(): must yield the start..end sequence, not
# the Range object's (key, value) pairs. (0..n).iter() is what the generator
# for-in desugar emits; a broken dispatch walked the object fields / crashed.
for i in (0..3).iter() {
  inspect(i)
}
for i in (1..=3).iter() {
  inspect(i)
}

# String grapheme loop (StringView path).
for c in "hi" {
  inspect(c)
}

# User-defined generator (yield) driving the protocol loop.
fn count_to(n) {
  mut i = 0
  while i < n {
    yield i
    i = i + 1
  }
}
for x in count_to(3) {
  inspect(x)
}

# Generator whose yield lives inside a for-in over a range literal. The
# transform desugars this to `(0..n).iter()`, and the range bound `n` (a
# param) must be rewritten to `self.n` across the `..` operator.
fn range_gen(n) {
  for i in 0..n {
    yield i * 10
  }
}
for x in range_gen(3) {
  inspect(x)
}

# Nested for-in over an object inside an array loop.
for row in [{k: 1}, {k: 2}] {
  for key, val in row {
    inspect(key)
    inspect(val)
  }
}
