# @decorator: prefix syntax that wraps a fn / class declaration with
# one or more callables. Stacked decorators apply bottom-up — the one
# closest to the `fn` / `class` runs first, the topmost runs last.

# --- 1. Simple fn decorator ---
let tag = fn(f) { fn() { "[{f()}]" } }

@tag
fn greet() { "hello" }

assert(greet() == "[hello]")

# --- 2. Stacked decorators (bottom-up application) ---
let bracket = fn(f) { fn() { "[{f()}]" } }
let star    = fn(f) { fn() { "*{f()}*" } }

@bracket
@star
fn name() { "x" }

# bracket(star(name))() → "[" + star(name)() + "]" → "[*x*]"
assert(name() == "[*x*]")

# --- 3. Decorator factory (@deco(arg) form) ---
let prefix = fn(p) {
  fn(f) { fn() { "{p}:{f()}" } }
}

@prefix("LOG")
fn shout() { "boom" }

assert(shout() == "LOG:boom")

# --- 4. Decorator receives the original Value ---
let identity = fn(f) { f }

@identity
fn doubled(n) { n * 2 }

assert(doubled(5) == 10)
assert(doubled(7) == 14)

# --- 5. Decorator that adds parameters via wrapper ---
let with_default = fn(f) {
  fn(x = 10) { f(x) }
}

@with_default
fn square(n) { n * n }

assert(square() == 100)
assert(square(3) == 9)

# --- 6. Class decorator: returns the (possibly modified) class ---
let mark = fn(cls) {
  cls.marked = true
  cls
}

@mark
class Point {
  new(x, y) { this.x = x; this.y = y }
}

assert(Point.marked == true)
let p = Point.new(3, 4)
assert(p.x == 3 && p.y == 4)

# --- 7. Multiple-arg decorator factory ---
let combine = fn(a, b) {
  fn(f) { fn() { a + f() + b } }
}

@combine(1, 100)
fn middle() { 10 }

assert(middle() == 111)
