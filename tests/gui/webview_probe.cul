# Webview event-loop probe for CI: park in the event loop, quit from another
# thread, come back and tear down. This is the shape Desktop.run depends on.
#
# Not under tests/*.cul on purpose — the gate sweeps that glob and this opens a
# real window. One window per process, like Desktop.run: multiple windows in
# one process is not a supported shape (see examples/webview/README.md), so the
# pending-quit case lives in its own file rather than a second phase here.
#
# Failures propagate; the caller classifies. A machine with no display is a
# legitimate outcome, a hang or a crash is not.

let w = Webview.Window.new()
w.set_title("ci probe (run + quit)")
w.set_size(320, 240)
w.set_html("<h1>run</h1>")
let h = Isolate.spawn(fn () {
  Time.sleep(2.0)
  Webview.Window.quit()
})
w.run()
h.join()
w.drop()
println("WEBVIEW_PROBE_OK")
