// Conformance: stdlib §Proc. See docs/stdlib.md and docs/language.md.
//
// Proc namespace — synchronous external command execution.
// Tests run on interp, JIT, and AOT via `just test`; identical stdout.
// Commands are restricted to tools present on every CI host
// (echo/true/false/cat/env/seq/pwd/sh).

// --- Success round-trip: stdout captured, exit 0, no signal ---
let r = Proc.run(["echo", "hi"])
assert_true(r.ok)
assert_eq(r.code, 0)
assert_eq(r.stdout, "hi\n")
assert_eq(r.stdout.trim(), "hi")
assert_eq(r.stderr, "")
assert_eq(r.signal, nil)

// --- Exit codes: `true` succeeds, `false` is a normal ok:false result ---
assert_true(Proc.run(["true"]).ok)
let f = Proc.run(["false"])
assert_eq(f.ok, false)
assert_eq(f.code, 1)
assert_eq(f.signal, nil)

// --- stdin is fed to the child and then closed ---
let c = Proc.run(["cat"], stdin: "abc\ndef\n")
assert_eq(c.stdout, "abc\ndef\n")
assert_true(c.ok)

// --- env merges onto the parent: MYVAR added, PATH still resolves `env` ---
let e = Proc.run(["env"], env: {MYVAR: "xyz"})
assert_true(e.stdout.contains("MYVAR=xyz"))
assert_true(e.stdout.contains("PATH="))

// --- cwd changes the child's working directory ---
let tmpdir_env = Sys.env("TMPDIR")
let tmp_root   = if tmpdir_env != "" { tmpdir_env } else { "/tmp" }
let workdir    = FS.join(tmp_root, "culebra_proc_test")
if FS.exists(workdir) { FS.remove(workdir) }
FS.mkdir(workdir)
let pw = Proc.run(["pwd"], cwd: workdir)
// pwd may resolve symlinks (/var -> /private/var), so match the basename.
assert_true(pw.stdout.trim().contains("culebra_proc_test"))
FS.remove(workdir)

// --- Large output: 10000 lines must not deadlock on a full pipe buffer ---
let big = Proc.run(["seq", "1", "10000"])
assert_true(big.ok)
assert_eq(big.stdout.split("\n").size(), 10001)  // trailing newline -> empty tail

// --- Signal death is reported distinctly from an exit code ---
let sig = Proc.run(["sh", "-c", "kill -TERM $$"])
assert_eq(sig.ok, false)
assert_eq(sig.signal, "SIGTERM")
assert_eq(sig.code, -1)

// --- check: true throws ProcessError on a non-zero exit ---
let chk = try { Proc.run(["false"], check: true); "no-error" } catch e { e.kind }
assert_eq(chk, "ProcessError")
// ...and returns normally (no throw) when the command succeeds.
assert_true(Proc.run(["true"], check: true).ok)

// --- Spawn failure (nonexistent executable) throws ProcessError ---
let nx = try { Proc.run(["culebra_no_such_cmd_xyzzy"]); "no-error" } catch e { e.kind }
assert_eq(nx, "ProcessError")

// --- Argument validation ---
let te = try { Proc.run([1, 2]); "no-error" } catch e { e.kind }
assert_eq(te, "TypeError")
let ve = try { Proc.run([]); "no-error" } catch e { e.kind }
assert_eq(ve, "ValueError")

// --- Proc.all: parallel, results in input order, error nil on success ---
let rs = Proc.all([["echo", "a"], ["echo", "b"], ["echo", "c"]])
assert_eq(rs.size(), 3)
assert_eq(rs[0].stdout.trim(), "a")
assert_eq(rs[1].stdout.trim(), "b")
assert_eq(rs[2].stdout.trim(), "c")
assert_true(rs[0].ok)
assert_eq(rs[0].error, nil)

// --- allSettled: a non-zero exit and a spawn failure don't abort the rest ---
let mix = Proc.all([["true"], ["false"], ["culebra_no_such_cmd_xyzzy"]])
assert_eq(mix.size(), 3)
assert_true(mix[0].ok)
assert_eq(mix[1].ok, false)
assert_eq(mix[1].code, 1)
assert_eq(mix[1].error, nil)         // ran, just exited non-zero
assert_eq(mix[2].ok, false)
assert_true(mix[2].error != nil)     // failed to spawn

// --- limit caps concurrency; all commands still complete ---
let lim = Proc.all([["echo", "1"], ["echo", "2"], ["echo", "3"], ["echo", "4"]], limit: 2)
assert_eq(lim.size(), 4)

// --- Large output across several children must not deadlock (CLOEXEC) ---
let big = Proc.all([["seq", "1", "5000"], ["seq", "1", "5000"], ["seq", "1", "5000"]])
assert_eq(big[0].stdout.split("\n").size(), 5001)
assert_eq(big[2].stdout.split("\n").size(), 5001)

// --- Empty list: all -> [], race -> ValueError ---
assert_eq(Proc.all([]).size(), 0)
let re = try { Proc.race([]); "no-error" } catch e { e.kind }
assert_eq(re, "ValueError")

// --- Proc.race: fastest wins, the rest are killed (does not block on sleep) ---
let win = Proc.race([["sleep", "5"], ["echo", "fast"]])
assert_eq(win.stdout.trim(), "fast")
assert_true(win.ok)

// --- Type errors on malformed command lists ---
let ne = try { Proc.all([["echo"], "notarray"]); "no-error" } catch e { e.kind }
assert_eq(ne, "TypeError")

// --- timeout: a slow command is killed and flagged timed_out ---
let slow = Proc.run(["sleep", "5"], timeout: 200)
assert_eq(slow.ok, false)
assert_true(slow.timed_out)
assert_true(slow.signal != nil)       // killed by SIGTERM/SIGKILL

// A command that finishes within the timeout is unaffected.
let quick = Proc.run(["echo", "hi"], timeout: 5000)
assert_true(quick.ok)
assert_eq(quick.timed_out, false)
assert_eq(quick.stdout.trim(), "hi")

// timeout + check: true throws ProcessError.
let ce = try { Proc.run(["sleep", "5"], timeout: 100, check: true); "no-error" }
         catch e { e.kind }
assert_eq(ce, "ProcessError")

// timeout applies per command in Proc.all.
let tos = Proc.all([["sleep", "5"], ["echo", "ok"]], timeout: 200)
assert_true(tos[0].timed_out)
assert_eq(tos[0].ok, false)
assert_eq(tos[1].timed_out, false)
assert_eq(tos[1].stdout.trim(), "ok")

// timed_out is false on every non-timeout result (uniform shape).
assert_eq(Proc.run(["echo", "x"]).timed_out, false)

// --- fail_fast: first failure throws ProcessError, the rest are killed ---
let ff = try {
  Proc.all([["sleep", "5"], ["false"], ["sleep", "5"]], fail_fast: true)
  "no-error"
} catch e { e.kind }
assert_eq(ff, "ProcessError")

// fail_fast with all successes returns the result array (no throw).
let allok = Proc.all([["echo", "a"], ["echo", "b"]], fail_fast: true)
assert_eq(allok.size(), 2)
assert_eq(allok[1].stdout.trim(), "b")

// fail_fast off (default) is allSettled — a failure does not throw.
let settled = Proc.all([["true"], ["false"]])
assert_eq(settled.size(), 2)
assert_eq(settled[1].ok, false)

// A spawn failure also triggers fail_fast.
let ffspawn = try {
  Proc.all([["culebra_no_such_cmd_xyzzy"], ["sleep", "5"]], fail_fast: true)
  "no-error"
} catch e { e.kind }
assert_eq(ffspawn, "ProcessError")

// --- retries: a persistently failing command keeps the last failure ---
let rex = Proc.all([["false"]], retries: 2)
assert_eq(rex[0].ok, false)
assert_eq(rex[0].code, 1)

// A succeeding command needs no retry and is unaffected.
let rok = Proc.all([["echo", "hi"]], retries: 3)
assert_true(rok[0].ok)
assert_eq(rok[0].stdout.trim(), "hi")

// retries + fail_fast: fail_fast only fires after retries are exhausted.
let rff = try { Proc.all([["false"]], retries: 1, fail_fast: true); "no-error" }
          catch e { e.kind }
assert_eq(rff, "ProcessError")

// --- Proc.spawn: a live handle with wait/poll/kill ---
let sp = Proc.spawn(["echo", "spawned"])
let sr = sp.wait()
assert_true(sr.ok)
assert_eq(sr.stdout.trim(), "spawned")
// wait() is idempotent — the second call returns the same cached result.
assert_eq(sp.wait().stdout.trim(), "spawned")

// poll() is nil while running, the result Object once finished.
let slow = Proc.spawn(["sleep", "2"])
assert_eq(slow.poll(), nil)
assert_true(slow.wait().ok)
assert_true(slow.poll().ok)        // cached after wait

// kill() stops a running child; wait() then reports the signal death.
let doomed = Proc.spawn(["sleep", "5"])
doomed.kill()
let dr = doomed.wait()
assert_eq(dr.ok, false)
assert_true(dr.signal != nil)

// stdin is fed at spawn time.
let pipe = Proc.spawn(["cat"], stdin: "fed\n")
assert_eq(pipe.wait().stdout, "fed\n")

// A spawn failure throws (like Proc.run).
let se = try { Proc.spawn(["culebra_no_such_cmd_xyzzy"]); "no-error" }
         catch e { e.kind }
assert_eq(se, "ProcessError")

// Handles dropped without wait() are reaped by GC (no leak / no hang).
fn spawn_and_drop() { Proc.spawn(["true"]) }
for i in range(10) { spawn_and_drop() }

IO.inspect("test_proc OK")
