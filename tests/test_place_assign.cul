// Parallel assignment whose targets are index / property chains:
// `(p[i], p[j]) = (p[j], p[i])`. Each target is assigned exactly as the
// single-target form would, so this file mostly pins that equivalence.

// --- swap, the motivating case
mut p = [10, 20, 30]
mut i = 0
mut j = 2
(p[i], p[j]) = (p[j], p[i])
assert_eq(p, [30, 20, 10])

// --- chained targets (grid transpose step)
mut m = [[1, 2], [3, 4]]
(m[0][1], m[1][0]) = (m[1][0], m[0][1])
assert_eq(m, [[1, 3], [2, 4]])

// --- property targets (double buffering)
mut o = { mut front: "a", mut back: "b" }
(o.front, o.back) = (o.back, o.front)
assert_eq(o.front, "b")
assert_eq(o.back, "a")

// --- plain names and chains may be mixed; a plain name follows `x = v`
// (reassign what is visible, else declare)
mut q = [1, 2]
mut z = 0
(z, q[0]) = (9, 8)
assert_eq(z, 9)
assert_eq(q, [8, 2])
(fresh, q[1]) = (7, 6)
assert_eq(fresh, 7)
assert_eq(q, [8, 6])

// --- `_` discards, and is not readable afterwards (as with `_ = v`)
mut s = [1, 2]
(s[0], _) = (5, 99)
assert_eq(s, [5, 2])
assert_eq(try { _ ; "read" } catch e { e.kind }, "NameError")

// --- the RHS may be any indexed sequence, Array or Tuple
mut r = [0, 0]
(r[0], r[1]) = [4, 5]
assert_eq(r, [4, 5])

// --- one-target form, mirroring the `(a,)` tuple pattern
mut one = [0]
(one[0],) = (3,)
assert_eq(one, [3])

// --- the whole RHS is the expression's value
mut t = [0, 0]
assert_eq(((t[0], t[1]) = (1, 2)), (1, 2))

// --- elements are snapshotted before any write, so a target may alias the RHS
mut sp = [1, 2]
(sp[1], sp[0]) = sp
assert_eq(sp, [2, 1])

// --- arity / type mismatch is a ValueError that writes NOTHING
mut u = [1, 2]
assert_eq(try { (u[0], u[1]) = (1, 2, 3); "no error" } catch e { e.kind },
          "ValueError")
assert_eq(u, [1, 2])
assert_eq(try { (u[0], u[1]) = 5; "no error" } catch e { e.kind }, "ValueError")
assert_eq(u, [1, 2])

// --- immutability follows the single-target rules exactly: an immutable
// property rejects the write, while an immutable *binding* holding a mutable
// container does not (`let xs = [...]; xs[0] = v` is allowed).
let imm = { a: 1 }
mut ok = 0
assert_eq(try { (imm.a, ok) = (9, 9); "no error" } catch e { e.kind },
          "ImmutableError")
let fixed = [1, 2]
(fixed[0], ok) = (42, 1)
assert_eq(fixed, [42, 2])

// (a call target -- `(f(), x) = t` -- is rejected before evaluation, so it is
// covered by lint_test.sh rather than here)

// --- heap elements: each target takes its own reference, so the temporary
// sequence being released must not free them (a JIT use-after-free).
mut hp = [[1], [2]]
(hp[0], hp[1]) = (hp[1], hp[0])
hp[0].push(9)
hp[1].push(8)
assert_eq(hp, [[2, 9], [1, 8]])

// --- a throw partway through leaves the earlier writes and releases the
// elements not yet stored
mut a2 = [0, 0]
let boom = fn () { throw "boom" }
assert_eq(try { (a2[0], a2[boom()]) = ([7], [8]); "no error" }
          catch e { e.to_string() }, "boom")
assert_eq(a2[0], [7])
assert_eq(a2[1], 0)

// --- a class may route its subscripts through __setindex__
class Box {
  new() { self.slots = { mut x: 0, mut y: 0 } }
  __setindex__(k, v) { self.slots[k] = v }
  __index__(k) { self.slots[k] }
}
mut b = Box()
(b["x"], b["y"]) = (11, 22)
assert_eq(b["x"], 11)
assert_eq(b["y"], 22)

// --- a closure can capture a name a place assignment declared (it is a real
// local of the enclosing scope, promotable to a cell)
mut arr = [0]
(cap, arr[0]) = ([5], 1)
let read = || cap.size()
cap.push(6)
assert_eq(read(), 2)

// --- all-plain-name tuples keep taking the destructure path unchanged
mut d1 = 1
mut d2 = 2
(d1, d2) = (d2, d1)
assert_eq(d1, 2)
assert_eq(d2, 1)

IO.inspect("test_place_assign OK")
