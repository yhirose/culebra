// Conformance: string escape sequences \xHH (raw byte) and \uXXXX /
// \UXXXXXXXX (Unicode codepoint). Interpolated strings ("..." / """...""")
// only; raw strings ('...' / backtick) pass bytes through verbatim. Runs on
// interp / JIT / AOT via `just test`; identical stdout.

// --- \xHH: raw byte, exactly two hex digits, 0x00–0xFF ---
// 0x41 = 'A'. size() counts bytes.
assert_eq("\x41", "A")
assert_eq("\x41\x42\x43", "ABC")
// A byte that is NOT valid UTF-8 on its own (lone 0xFF) — still one byte.
assert_eq("\xff".size(), 1)
// Hex is case-insensitive.
assert_eq("\x4a", "\x4A")
// Embedded NUL: a String is a Go-style byte string, so \x00 / \u0000 are
// ordinary bytes counted by size() — not terminators. interp / JIT / AOT
// all carry the length explicitly, so the NUL neither truncates nor drops.
assert_eq("\x00".size(), 1)
assert_eq("a\x00b".size(), 3)
assert_eq("\u0000".size(), 1)
assert_eq("a\x00b", "a" + "\x00" + "b")  // round-trips through concat

// --- \uXXXX: exactly 4 hex digits, BMP scalar value, UTF-8 encoded ---
assert_eq("\u0041", "A")       // BMP ASCII
assert_eq("\u03B1", "α")      // Greek alpha, U+03B1 (2 bytes UTF-8)
assert_eq("\u03b1".size(), 2)  // lowercase hex, 2 UTF-8 bytes

// --- \UXXXXXXXX: exactly 8 hex digits, full scalar range ---
assert_eq("\U0001F600", "😀")  // astral plane (emoji, U+1F600, 4 bytes)
assert_eq("\U0001F600".size(), 4)

// --- mixed with interpolation and other escapes ---
let name = "α"
assert_eq("hi \u03B1={name}\n", "hi α=α\n")

// --- triple-quoted strings honor the same escapes ---
assert_eq("""x\u0041y""", "xAy")
assert_eq("""b\xffe""".size(), 3)

// --- raw strings do NOT interpret escapes ---
assert_eq('\x41'.size(), 4)    // backslash, x, 4, 1 — verbatim
assert_eq('\u0041'.size(), 6)  // backslash, u, 0, 0, 4, 1 — verbatim

// Error paths (codepoint > U+10FFFF, surrogate range, malformed \x / \u / \U)
// are rejected at parse time, so they can't be caught with try/catch in
// a single module. They're covered by tests/embedding/utf8_invalid_smoke
// / a parse-failure check instead.

IO.inspect("test_string_escape OK")
