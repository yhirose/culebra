// The Audio namespace. The test harness keeps the device closed
// (CULEBRA_AUDIO=off), so every lane answers as a machine with no audio
// device: nothing plays and every handle still behaves. What reaches a device
// branches on Audio.available(), so a direct run on a machine with one passes
// too.
let live = Audio.available()

// Fixtures. A self-made 0.2 s sine MP3 (MPEG 2.5 mono: its 0xff 0xe3 frame
// sync is the header the format sniff must accept beyond the common 0xff 0xfb)
// and a 4-sample PCM WAV with a hand-assembled header.
let MP3 = Encoding.hex.decode("ffe318c4000d38be802158000127fffffffffeb0c30c30c30a7a7a7a7cfbb74d09" +
  "664116b1d52e799526b59a4a5d3808b865c753777e5f6f3cf3b180000002be1e1e" +
  "5b2cbdfe9918ffe318c4060e00b2800195c00039a31d552f06813030b8e00f84e8" +
  "03478588685bc01fdd640286880b81c0f71890315804d6e656fc46655765378779" +
  "20690afffe976ef0301682f8ffe318c4090f80ca2c019738000353b61a6030cf81" +
  "e88180d01bb81946931081837a0f4c0c1010e400c7fe99f00c0bf06c201df02bf0" +
  "4ffffd1eaf5fffffecfd9f92ffa531fc9f37ffe318c4060df0da8c019580003591" +
  "c38a0381206c1b680d004b80040c037e3c0028ee2fc800184c6006310a7e01f90a" +
  "c689b837e1cf1c26270dbca3b0a84e48eb115ff1d44b86a4ffe318c4090ee14a18" +
  "0195a8000480ffe0638348186862108480c4c85ff03202041ca40141309b858863" +
  "7ffcc49d21c91b14568ffff9929231241402ffe498ba4c414d45332e3130")
let WAV = Encoding.hex.decode("524946462800000057415645666d7420100000000100010040" +
  "1f0000401f000001000800646174610400000080c8803c")

// tone: WASM-4's APU and its constants.
assert_eq([Audio.PULSE, Audio.PULSE2, Audio.TRIANGLE, Audio.NOISE, Audio.SAWTOOTH], [0, 1, 2, 3, 4])
assert_eq([Audio.DUTY_EIGHTH, Audio.DUTY_QUARTER, Audio.DUTY_HALF, Audio.DUTY_THREE_QUARTER], [0, 1, 2, 3])
Audio.tone(440, 8)
Audio.tone(700, 0, 10, Audio.PULSE, 870, 10, 5, 3, 20, Audio.DUTY_QUARTER)
Audio.tone(170, 20, vol: 100, wave: Audio.NOISE, end_freq: 40, decay: 40)

// Sound: WAV, MP3 or Ogg bytes, one voice per handle.
let snd = Audio.Sound.new(WAV)
snd.volume(0.3)
snd.pitch(1.5)
snd.pan(-1)
snd.play()
snd.play()                       // restarts the voice
assert_eq(snd.playing(), live && snd.playing())
snd.stop()
assert_eq(snd.playing(), false)
Audio.Sound.new(MP3).play()      // Music's formats work too
assert_throws("ValueError", fn () {
  Audio.Sound.new("not audio")
})
assert_throws("ValueError", fn () {
  Audio.Sound.new("")
})
assert_throws("DispatchError", fn () {
  Audio.Sound.new(42)            // neither bytes nor samples
})

// A Sound from samples the program made, at 44100 a second unless told; a
// sample past -1..1 is held there and NaN is silence.
Audio.Sound.new([0.0, 0.5, -0.5, 2, -3, Math.nan]).play()
Audio.Sound.new(iota(400).map(|i| Math.sin(i * 0.1)), rate: 8000).play()
Audio.Sound.new([]).play()       // nothing to hear, and a handle all the same
assert_throws("TypeError", fn () {
  Audio.Sound.new([0.0, "loud"])
})
assert_throws("ValueError", fn () {
  Audio.Sound.new([0.0], rate: 0)
})
assert_throws("ValueError", fn () {
  Audio.Sound.new([0.0], rate: 2147483648)
})
assert_throws("TypeError", fn () {
  snd.volume("loud")
})

// Music: MP3 or Ogg bytes, a handle per track, fed by the runtime.
let bgm = Audio.Music.new(MP3)
let sting = Audio.Music.new(MP3, loop: false)  // two tracks at once
bgm.volume(0.5)
bgm.pitch(1)
bgm.pan(0.25)
bgm.play()
sting.play()
bgm.seek(0.05)
bgm.seek(1)                      // Long seconds too
bgm.pause()
assert_eq(bgm.playing(), false)
bgm.resume()
assert_eq(bgm.playing(), live)
bgm.stop()                       // rewinds; the handle stays usable
assert_eq(bgm.playing(), false)
bgm.play()
bgm.stop()
assert_throws("ValueError", fn () {
  Audio.Music.new(WAV)           // a WAV is a Sound, not a Music
})
assert_throws("ValueError", fn () {
  Audio.Music.new("")
})
assert_throws("TypeError", fn () {
  Audio.Music.new(MP3, loop: 1)
})

// Stream: PCM the script synthesises. The block counts the same with or
// without a device; only what reaches one branches on ready().
let st = Audio.PCM.new(44100, 1, 1024)
assert_eq(st.ready(), live)
assert_eq(st.needed(), live ? 1024 : 0)
assert_eq(st.latency(), 2.0 * 1024 / 44100)
// Samples carry polygon's Long|Float contract, and raise the same way.
assert_eq(st.push([0, 0.5, -1, 0.25]), 4)
assert_throws("TypeError", fn () {
  st.push([0.5, nil])
})
// submit() hands over whatever is pending, not only a full block.
assert_eq(st.submit(), live ? 4 : 0)
st.volume(0.5)
st.pitch(1)
st.pan(0)
st.play()
assert_eq(st.playing(), live)
st.pause()
st.resume()
st.stop()
assert_eq(st.playing(), false)
assert_throws("TypeError", fn () {
  Audio.PCM.new("44100", 1, 1024)
})
assert_throws("TypeError", fn () {
  st.push(0.5)
})
// More than the buffer holds: taken up to capacity, the caller keeps the rest.
assert_eq(Audio.PCM.new(44100, 1, 4).push(iota(10).map(|i| to_float(i) / 10.0)), 4)
// Stereo: interleaved L,R, and the answer counts frames, not values.
let stereo = Audio.PCM.new(44100, 2, 8)
assert_eq(stereo.push([0.1, 0.1, 0.2, 0.2, 0.3, 0.3]), 3)
assert_eq(stereo.push([0.4, 0.4, 0.5]), 1)  // a trailing half frame is not taken
// Each handle is its own stream: filling one leaves another empty.
assert_eq(Audio.PCM.new(44100, 2, 8).push(iota(16).map(|_| 0.0)), 8)

// Capture: the microphone. The suite has no device, so a Capture is a handle
// whose reads find nothing; what reaches a device branches on ready().
assert_eq(type_of(Audio.capture_available()), "Bool")
let mic = Audio.Capture.new()
assert_eq(mic.running(), false)
assert_eq(mic.waiting(), 0)
assert_eq(mic.read(0), [])
if !mic.ready() {
  mic.start()
  assert_eq(mic.running(), false)
  assert_eq(mic.read(), [])
  assert_eq(mic.read(64), [])
}
mic.start()
mic.stop()
assert_eq(mic.running(), false)
assert_eq(Audio.Capture.new(16000, 2).read(), [])
// Its arguments follow PCM's rules, and raise the same way.
let too_fast = try {
  Audio.Capture.new(1 << 40)
} catch e {
  e
}
assert_eq((too_fast.kind, too_fast.message.contains("Audio.Capture: rate")), ("ValueError", true))
assert_throws("TypeError", fn () {
  Audio.Capture.new("44100")
})
assert_throws("TypeError", fn () {
  mic.read("all")
})

// A part's samples against the same computation written out here: the same
// but for the last bits of rounding, where a machine that fuses a multiply
// and an add into one step (clang on arm64) rounds once and the script twice.
fn assert_samples(got, want) {
  assert_eq(got.size(), want.size())
  for i in 0..got.size() {
    assert_close(got[i], want[i], 1e-9)
  }
}

// resonate: a bank of two-pole resonators, natively, the same samples as the
// same filters written out here; Longs are samples too.
fn rings(samples, modes, dry, rate) {
  let gs = modes.map(fn (m) {
    let r = Math.exp(-Math.pi * m.width / rate)
    let w = 2.0 * Math.pi * m.freq / rate
    {a1: 2.0 * r * Math.cos(w), a2: -r * r, b0: (1.0 - r) * 2.0 * Math.sin(w) * m.gain}
  })
  mut y1 = repeat(gs.size(), 0.0)
  mut y2 = repeat(gs.size(), 0.0)
  samples.map(fn (x) {
    mut out = dry * x
    for k in 0..gs.size() {
      let y = gs[k].b0 * x + gs[k].a1 * y1[k] + gs[k].a2 * y2[k]
      y2[k] = y1[k]
      y1[k] = y
      out += y
    }
    out
  })
}
let struck = [1, 0.5, -0.25, ...repeat(200, 0.0), 0.75, ...repeat(100, 0.0)]
let two = [{freq: 440.0, width: 20.0, gain: 1.0}, {freq: 1250, width: 90, gain: 0.3}]
assert_samples(Audio.resonate(struck, two), rings(struck, two, 0.0, 44100.0))
assert_samples(Audio.resonate(struck, two, dry: 0.4, rate: 22050), rings(struck, two, 0.4, 22050.0))
assert_eq(Audio.resonate(struck, [], dry: 0.5), struck.map(|x| 0.5 * x))
assert_eq(Audio.resonate([], two), [])
for (modes, message) in [
  ([{freq: 0.0, width: 20.0, gain: 1.0}], "a mode's freq is above 0 and below half the rate"),
  ([{freq: 22050.0, width: 20.0, gain: 1.0}], "a mode's freq is above 0 and below half the rate"),
  ([{freq: 440.0, width: 0.0, gain: 1.0}], "a mode's width is above 0"),
] {
  let e = try {
    Audio.resonate(struck, modes)
  } catch e {
    e
  }
  assert_eq((e.kind, e.message), ("ValueError", "Audio.resonate: " + message))
}
for modes in [[440.0], [{freq: 440.0, width: 20.0}], [{freq: "440", width: 20.0, gain: 1.0}]] {
  let e = try {
    Audio.resonate(struck, modes)
  } catch e {
    e
  }
  assert_eq((e.kind, e.message), ("TypeError", "Audio.resonate: a mode is \{freq, width, gain}, each a number"))
}
assert_throws("ValueError", fn () {
  Audio.resonate(struck, two, rate: 0)
})
assert_throws("TypeError", fn () {
  Audio.resonate([0.5, "loud"], two)
})

// pluck: a Karplus-Strong string, natively, the same samples as the same
// string written out here. A change of tuning keeps what the string holds,
// and a strike is added into it from its sample on.
fn plucked(seconds, tunings, strikes, rate) {
  let loops = tunings.map(fn (t) {
    let period = rate / t.freq
    let whole = Math.floor(period - 0.6)
    let frac = period - 0.5 - whole
    {len: whole, c: (1.0 - frac) / (1.0 + frac), loss: 10.0 ** (-3.0 / (t.ring * t.freq))}
  })
  let from = tunings.map(|t| Math.round(t.at * rate))
  let total = Math.round(seconds * rate)
  mut kick = repeat(total, 0.0)
  for s in strikes {
    let start = Math.round(s.at * rate)
    for i in 0..s.samples.size() {
      kick[start + i] += s.samples[i] if start + i < total
    }
  }
  let size = loops.map(|lp| lp.len).max() + 1
  let pole = 0.995 ** (44100.0 / rate)
  mut buf = repeat(size, 0.0)
  mut w = 0
  mut at = 0
  mut prev = 0.0
  mut ap_in = 0.0
  mut ap_out = 0.0
  mut dc_in = 0.0
  mut dc_out = 0.0
  iota(total).map(fn (i) {
    while at + 1 < loops.size() && i >= from[at + 1] {
      at += 1
    }
    let lp = loops[at]
    let read = buf[(w - lp.len + size) % size]
    let v = 0.5 * (read + prev) * lp.loss
    prev = read
    let ap = lp.c * v + ap_in - lp.c * ap_out
    ap_in = v
    ap_out = ap
    buf[w] = ap + kick[i]
    w = (w + 1) % size
    dc_out = read - dc_in + pole * dc_out
    dc_in = read
    dc_out
  })
}
let shape = [0.0, 0.25, 0.5, 0.25, 0, -0.25, -0.5, -0.25]
let tunings = [{at: 0, freq: 196.0, ring: 2.0}, {at: 0.05, freq: 220.0, ring: 2.0}, {at: 0.08, freq: 220, ring: 0.1}]
let strikes = [{at: 0.0, samples: shape}, {at: 0.05, samples: shape.map(|x| 0.3 * x)}, {at: 0.0999, samples: shape}]
assert_samples(Audio.pluck(0.1, tunings, strikes), plucked(0.1, tunings, strikes, 44100.0))
assert_samples(Audio.pluck(0.1, tunings, strikes, rate: 22050), plucked(0.1, tunings, strikes, 22050.0))
assert_eq(Audio.pluck(0.01, [{at: 0, freq: 440.0, ring: 1.0}]), repeat(441, 0.0))
assert_eq(Audio.pluck(0, tunings, strikes), [])
for (bad, message) in [
  ([], "a string has a tuning"),
  ([{at: 0, freq: 22050.0, ring: 1.0}], "a tuning's freq is above 0 and below half the rate"),
  ([{at: 0, freq: 440.0, ring: 0}], "a tuning's ring is above 0"),
  ([{at: -1, freq: 440.0, ring: 1.0}], "a tuning's at is 0 or more"),
  ([{at: 0.5, freq: 440.0, ring: 1.0}, {at: 0.2, freq: 440.0, ring: 1.0}], "the tunings come in the order they play"),
] {
  let e = try {
    Audio.pluck(1.0, bad)
  } catch e {
    e
  }
  assert_eq((e.kind, e.message), ("ValueError", "Audio.pluck: " + message))
}
for (bad_tunings, bad_strikes, message) in [
  ([440.0], [], "a tuning is \{at, freq, ring}, each a number"),
  ([{at: 0, freq: 440.0}], [], "a tuning is \{at, freq, ring}, each a number"),
  (tunings, [shape], "a strike is \{at, samples}, its samples numbers"),
  (tunings, [{at: 0, samples: [0.5, "loud"]}], "a strike is \{at, samples}, its samples numbers"),
] {
  let e = try {
    Audio.pluck(1.0, bad_tunings, bad_strikes)
  } catch e {
    e
  }
  assert_eq((e.kind, e.message), ("TypeError", "Audio.pluck: " + message))
}

// partials: a harmonic tone whose controls move in straight lines between
// their points, natively, the same samples as the same tone written out
// here; the noise is the same from the same seed.
fn moving(points, rest) {
  mut i = 0
  fn (t) {
    return rest if points.empty()
    while i + 1 < points.size() && points[i + 1][0] <= t {
      i += 1
    }
    let (t0, v0) = points[i]
    return v0 if t <= t0 || i + 1 == points.size()
    let (t1, v1) = points[i + 1]
    t1 > t0 ? v0 + (v1 - v0) * (t - t0) / (t1 - t0) : v1
  }
}
fn toned(seconds, freq, spectrum, gain, noise, rate) {
  let f_at = moving(freq, 0.0)
  let g_at = moving(gain, 1.0)
  let steady = moving(noise == nil ? [] : noise.steady, 0.0)
  let pulsed = moving(noise == nil ? [] : noise.pulsed, 0.0)
  let widest = spectrum.map(|(_, a)| a.size()).max()
  let fast_k = noise == nil ? 0.0 : 1.0 - Math.exp(-2.0 * Math.pi * noise.high / rate)
  let slow_k = noise == nil ? 0.0 : 1.0 - Math.exp(-2.0 * Math.pi * noise.low / rate)
  mut x = noise == nil ? 0 : noise.seed
  mut fast = 0.0
  mut slow = 0.0
  mut phase = 0.0
  mut j = 0
  iota(Math.round(seconds * rate)).map(fn (i) {
    let t = i.to_float() / rate
    let f = f_at(t)
    phase += 2.0 * Math.pi * f / rate
    while j + 1 < spectrum.size() && spectrum[j + 1][0] <= t {
      j += 1
    }
    let k1 = j + 1 < spectrum.size() && t > spectrum[j][0] ? j + 1 : j
    let (at0, a0s) = spectrum[j]
    let (at1, a1s) = spectrum[k1]
    let mix = k1 == j || at1 <= at0 ? 0.0 : (t - at0) / (at1 - at0)
    let amps = iota(widest).map(fn (k) {
      let a0 = k < a0s.size() ? a0s[k] : 0.0
      let a1 = k < a1s.size() ? a1s[k] : 0.0
      a0 + (a1 - a0) * mix
    })
    let s1 = Math.sin(phase)
    let c2 = 2.0 * Math.cos(phase)
    let top = Math.min(widest, Math.floor(rate * 0.45 / f))
    mut prev = 0.0
    mut cur = s1
    mut sum = top > 0 ? amps[0] * s1 : 0.0
    for k in 1..top {
      let next = c2 * cur - prev
      prev = cur
      cur = next
      sum += amps[k] * cur
    }
    mut v = g_at(t) * sum
    if noise != nil {
      x = (x * 1103515245 + 12345) % 2147483648
      let w = x / 1073741824.0 - 1.0
      fast += fast_k * (w - fast)
      slow += slow_k * (w - slow)
      v += (fast - slow) * (steady(t) + pulsed(t) * (0.5 + 0.5 * s1))
    }
    v
  })
}
let glide = [(0.0, 220.0), (0.01, 330.0), (0.01, 9000.0)]
let colours = [(0.0, [1.0, 0.5]), (0.005, [0.8, 0.3, 0.2, 0.1])]
let swell = [(0.0, 0.0), (0.002, 1.0), (0.015, 0.5)]
let breath = {low: 300.0, high: 2500.0, seed: 7, steady: [(0.0, 0.1), (0.01, 0.0)], pulsed: [(0.0, 0.05)]}
assert_samples(Audio.partials(0.02, glide, colours), toned(0.02, glide, colours, [], nil, 44100.0))
assert_samples(
  Audio.partials(0.02, glide, colours, gain: swell, noise: breath),
  toned(0.02, glide, colours, swell, breath, 44100.0),
)
assert_samples(
  Audio.partials(0.02, glide, colours, gain: swell, noise: breath, rate: 22050),
  toned(0.02, glide, colours, swell, breath, 22050.0),
)
assert_eq(Audio.partials(0, glide, colours), [])
for (bad_freq, bad_spectrum, bad_noise, message) in [
  ([], colours, nil, "a tone has a freq"),
  ([(0.0, 0.0)], colours, nil, "a freq is above 0"),
  (glide, [], nil, "a tone has a spectrum"),
  ([(0.01, 220.0), (0.0, 330.0)], colours, nil, "an envelope's times are 0 or more, in the order they come"),
  (glide, [(0.005, [1.0]), (0.0, [1.0])], nil, "an envelope's times are 0 or more, in the order they come"),
  (glide, colours, {low: 2500.0, high: 300.0}, "the noise's low and high are above 0, in order, and below half the rate"),
  (glide, colours, {low: 300.0, high: 2500.0, seed: 0.5}, "the noise's seed is a whole number from 0 below 2^31"),
] {
  let e = try {
    Audio.partials(0.01, bad_freq, bad_spectrum, noise: bad_noise)
  } catch e {
    e
  }
  assert_eq((e.kind, e.message), ("ValueError", "Audio.partials: " + message))
}
for (bad_freq, bad_spectrum, bad_noise, message) in [
  ([220.0], colours, nil, "an envelope is a list of (at, value), each a number"),
  ([(0.0, "A")], colours, nil, "an envelope is a list of (at, value), each a number"),
  (glide, [(0.0, 1.0)], nil, "a spectrum is a list of (at, amps), amps a list of numbers"),
  (glide, colours, "loud", "the noise is \{low, high, seed, steady, pulsed}"),
] {
  let e = try {
    Audio.partials(0.01, bad_freq, bad_spectrum, noise: bad_noise)
  } catch e {
    e
  }
  assert_eq((e.kind, e.message), ("TypeError", "Audio.partials: " + message))
}

// Closed like the C++ namespaces: an unknown member raises.
assert_throws("AttributeError", fn () {
  Audio.typo
})

print("audio ok\n")
