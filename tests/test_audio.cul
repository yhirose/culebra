// The Audio namespace. The test harness keeps the device closed
// (CULEBRA_AUDIO=off), so every lane answers as a machine with no audio
// device: nothing plays and every handle still behaves. What reaches a device
// branches on Audio.available(), so a direct run on a machine with one passes
// too.
let live = Audio.available()

// Fixtures. A self-made 0.2 s sine MP3 (MPEG 2.5 mono: its 0xff 0xe3 frame
// sync is the header the format sniff must accept beyond the common 0xff 0xfb)
// and a 4-sample PCM WAV with a hand-assembled header.
let MP3 = Encoding.hex.decode("ffe318c4000d38be802158000127fffffffffeb0c30c30c30a7a7a7a7cfbb74d09" +
  "664116b1d52e799526b59a4a5d3808b865c753777e5f6f3cf3b180000002be1e1e" +
  "5b2cbdfe9918ffe318c4060e00b2800195c00039a31d552f06813030b8e00f84e8" +
  "03478588685bc01fdd640286880b81c0f71890315804d6e656fc46655765378779" +
  "20690afffe976ef0301682f8ffe318c4090f80ca2c019738000353b61a6030cf81" +
  "e88180d01bb81946931081837a0f4c0c1010e400c7fe99f00c0bf06c201df02bf0" +
  "4ffffd1eaf5fffffecfd9f92ffa531fc9f37ffe318c4060df0da8c019580003591" +
  "c38a0381206c1b680d004b80040c037e3c0028ee2fc800184c6006310a7e01f90a" +
  "c689b837e1cf1c26270dbca3b0a84e48eb115ff1d44b86a4ffe318c4090ee14a18" +
  "0195a8000480ffe0638348186862108480c4c85ff03202041ca40141309b858863" +
  "7ffcc49d21c91b14568ffff9929231241402ffe498ba4c414d45332e3130")
let WAV = Encoding.hex.decode("524946462800000057415645666d7420100000000100010040" +
  "1f0000401f000001000800646174610400000080c8803c")

// latency: the device's period, asked for before it opens. available() above
// opened it if there is one, so a period is too late to ask for; with none,
// it is asked for and nil is the period.
if live {
  assert_true(Audio.latency() > 0.0)
  assert_throws("ValueError", || Audio.latency(0.003),
    message: "Audio.latency: the device is open already; ask before the first sound")
} else {
  assert_eq(Audio.latency(), nil)
  assert_eq(Audio.latency(0.003), nil)
}
for bad in [0, -0.01, 0.6] {
  assert_throws("ValueError", || Audio.latency(bad),
    message: "Audio.latency: a period is above 0 and at most 0.5 seconds, not {bad}")
}

// tone: WASM-4's APU and its constants.
assert_eq([Audio.PULSE, Audio.PULSE2, Audio.TRIANGLE, Audio.NOISE, Audio.SAWTOOTH], [0, 1, 2, 3, 4])
assert_eq([Audio.DUTY_EIGHTH, Audio.DUTY_QUARTER, Audio.DUTY_HALF, Audio.DUTY_THREE_QUARTER], [0, 1, 2, 3])
Audio.tone(440, 8)
Audio.tone(700, 0, 10, Audio.PULSE, 870, 10, 5, 3, 20, Audio.DUTY_QUARTER)
Audio.tone(170, 20, vol: 100, wave: Audio.NOISE, end_freq: 40, decay: 40)

// Sound: WAV, MP3 or Ogg bytes, one voice per handle.
let snd = Audio.Sound.new(WAV)
snd.volume(0.3)
snd.pitch(1.5)
snd.pan(-1)
snd.play()
snd.play()                       // restarts the voice
assert_eq(snd.playing(), live && snd.playing())
snd.stop()
assert_eq(snd.playing(), false)
Audio.Sound.new(MP3).play()      // Music's formats work too
assert_throws("ValueError", fn () {
  Audio.Sound.new("not audio")
})
assert_throws("ValueError", fn () {
  Audio.Sound.new("")
})
assert_throws("DispatchError", fn () {
  Audio.Sound.new(42)            // neither bytes nor samples
})

// A Sound from samples the program made, at 44100 a second unless told; a
// sample past -1..1 is held there and NaN is silence.
Audio.Sound.new([0.0, 0.5, -0.5, 2, -3, Math.nan]).play()
Audio.Sound.new(iota(400).map(|i| Math.sin(i * 0.1)), rate: 8000).play()
Audio.Sound.new([]).play()       // nothing to hear, and a handle all the same
assert_throws("TypeError", fn () {
  Audio.Sound.new([0.0, "loud"])
})
assert_throws("ValueError", fn () {
  Audio.Sound.new([0.0], rate: 0)
})
assert_throws("ValueError", fn () {
  Audio.Sound.new([0.0], rate: 2147483648)
})

// How loud a sound is, as a song weighs an instrument against its tones: the
// loudest 400 ms, K-weighted, in LUFS (ITU-R BS.1770's momentary loudness);
// nil for silence. A full-scale 997 Hz sine reads -3.01, as BS.1770 sets it.
let sine = |amp, secs, rate| iota(Math.round(secs * rate)).map(|i| amp * Math.sin(2.0 * Math.pi * 997.0 * i / rate))
let near = |a, b| Math.abs(a - b) < 0.05
assert_true(near(Audio.loudness(sine(1.0, 1.0, 48000), 48000), -3.01))
assert_true(near(Audio.loudness(sine(0.5, 1.0, 44100)), -9.03))
// A sound shorter than 400 ms is heard over 400 ms: a tenth of a second of it
// a quarter of the power of the same 400 ms.
assert_true(near(Audio.loudness(sine(1.0, 0.1, 44100)) - Audio.loudness(sine(1.0, 0.4, 44100)), -6.02))
assert_eq(Audio.loudness(repeat(4410, 0.0)), nil)
assert_eq(Audio.loudness([]), nil)
// Over their whole length, BS.1770's integrated loudness: the mean power of
// the 400 ms blocks, leaving out those under -70 LUFS and then those 10 LU
// under the mean of the rest. A steady tone reads as its loudest 400 ms.
assert_true(near(Audio.integrated_loudness(sine(1.0, 1.0, 48000), 48000), -3.01))
let loud = sine(1.0, 1.0, 44100)
let silence = |secs| repeat(Math.round(secs * 44100), 0.0)
// A second 6 dB down after it is within 10 LU and counts: the whole is the
// mean of a power and its quarter.
let to_db = |r| 10.0 * Math.log(r) / Math.log(10.0)
assert_true(near(Audio.integrated_loudness(loud + sine(0.5, 1.0, 44100)) - Audio.loudness(loud), to_db(0.625)))
// 20 dB down is under the gate, and left out as silence is.
assert_true(near(Audio.integrated_loudness(loud + sine(0.1, 1.0, 44100)), Audio.integrated_loudness(loud + silence(1.0))))
// Silence is left out however long it is, and a sound all under -70 LUFS is
// silence.
assert_eq(Audio.integrated_loudness(loud + silence(1.0)), Audio.integrated_loudness(loud + silence(3.0)))
assert_eq(Audio.integrated_loudness(sine(0.0001, 1.0, 44100)), nil)
// A sound shorter than 400 ms is one block, heard over 400 ms.
assert_eq(Audio.integrated_loudness(sine(1.0, 0.1, 44100)), Audio.loudness(sine(1.0, 0.1, 44100)))
assert_eq(Audio.integrated_loudness([]), nil)
assert_throws("ValueError", fn () {
  Audio.integrated_loudness([0.5], 0)
})
// A tone at vol 100 on a pulse at a half's duty: a fifth of full scale, a
// second of it; what a song weighs an external sound against.
let square = iota(44100).map(|i| (i * 440.0 / 44100.0) % 1.0 < 0.5 ? 0.2 : -0.2)
assert_true(near(_Audio.tone_loudness(440), _Audio.loudness(square, 44100)))
assert_throws("ValueError", fn () {
  _Audio.tone_loudness(0)
})
// A Sound keeps how loud it is, made from samples or from WAV bytes (16-bit
// here, quantized as a file is); compressed audio is not decoded before it
// plays, so its loudness is not known.
let tone = sine(0.5, 0.5, 44100)
// A PCM WAV file around `pcm`, its frames `bits` deep.
let wav_of = fn (pcm, channels, rate, bits) {
  let align = channels * bits / 8
  "RIFF" + String.pack("u32", [36 + pcm.size()]) + "WAVEfmt " + String.pack("u32", [16]) +
    String.pack("u16", [1, channels]) + String.pack("u32", [rate, rate * align]) +
    String.pack("u16", [align, bits]) + "data" + String.pack("u32", [pcm.size()]) + pcm
}
let pcm16 = String.pack("i16", tone.map(|v| Math.round(v * 32767)))
let wav16 = wav_of(pcm16, 1, 44100, 16)
assert_eq(_Audio.sound_loudness(Audio.Sound.new(tone)._id), _Audio.loudness(tone, 44100))
assert_true(near(_Audio.sound_loudness(Audio.Sound.new(wav16)._id), _Audio.loudness(tone, 44100)))
assert_true(_Audio.sound_loudness(Audio.Sound.new(WAV)._id) != nil)
assert_eq(_Audio.sound_loudness(Audio.Sound.new(MP3)._id), nil)
assert_eq(_Audio.sound_loudness(Audio.Sound.new([])._id), nil)
// A Sound gives back the bytes it was made from: those it was given, or the
// 16-bit WAV of its samples, which make the same sound again.
assert_eq(Audio.Sound.new(WAV).data(), WAV)
assert_eq(Audio.Sound.new(MP3).data(), MP3)
assert_eq(Audio.Sound.new(tone).data(), wav16)
assert_true(near(_Audio.sound_loudness(Audio.Sound.new(Audio.Sound.new(tone).data())._id), _Audio.loudness(tone, 44100)))
assert_eq(Audio.Sound.new([0.25, -0.25], rate: 8000).data().slice(24, 28).to_string(), String.pack("u32", [8000]))
assert_eq(Audio.Sound.new([]).data().size(), 44)
assert_throws("TypeError", fn () {
  snd.volume("loud")
})

// Music: MP3 or Ogg bytes, a handle per track, fed by the runtime.
let bgm = Audio.Music.new(MP3)
let sting = Audio.Music.new(MP3, loop: false)  // two tracks at once
bgm.volume(0.5)
bgm.pitch(1)
bgm.pan(0.25)
bgm.play()
sting.play()
bgm.seek(0.05)
bgm.seek(1)                      // Long seconds too
bgm.pause()
assert_eq(bgm.playing(), false)
bgm.resume()
assert_eq(bgm.playing(), live)
bgm.stop()                       // rewinds; the handle stays usable
assert_eq(bgm.playing(), false)
bgm.play()
bgm.stop()
assert_throws("ValueError", fn () {
  Audio.Music.new(WAV)           // a WAV is a Sound, not a Music
})
assert_throws("ValueError", fn () {
  Audio.Music.new("")
})
assert_throws("TypeError", fn () {
  Audio.Music.new(MP3, loop: 1)
})

// Stream: PCM the script synthesises. The block counts the same with or
// without a device; only what reaches one branches on ready().
let st = Audio.PCM.new(44100, 1, 1024)
assert_eq(st.ready(), live)
assert_eq(st.needed(), live ? 1024 : 0)
assert_eq(st.latency(), 2.0 * 1024 / 44100)
// Samples carry polygon's Long|Float contract, and raise the same way.
assert_eq(st.push([0, 0.5, -1, 0.25]), 4)
assert_throws("TypeError", fn () {
  st.push([0.5, nil])
})
// submit() hands over whatever is pending, not only a full block.
assert_eq(st.submit(), live ? 4 : 0)
st.volume(0.5)
st.pitch(1)
st.pan(0)
st.play()
assert_eq(st.playing(), live)
st.pause()
st.resume()
st.stop()
assert_eq(st.playing(), false)
assert_throws("TypeError", fn () {
  Audio.PCM.new("44100", 1, 1024)
})
assert_throws("TypeError", fn () {
  st.push(0.5)
})
// More than the buffer holds: taken up to capacity, the caller keeps the rest.
assert_eq(Audio.PCM.new(44100, 1, 4).push(iota(10).map(|i| to_float(i) / 10.0)), 4)
// Stereo: interleaved L,R, and the answer counts frames, not values.
let stereo = Audio.PCM.new(44100, 2, 8)
assert_eq(stereo.push([0.1, 0.1, 0.2, 0.2, 0.3, 0.3]), 3)
assert_eq(stereo.push([0.4, 0.4, 0.5]), 1)  // a trailing half frame is not taken
// Each handle is its own stream: filling one leaves another empty.
assert_eq(Audio.PCM.new(44100, 2, 8).push(iota(16).map(|_| 0.0)), 8)

// Capture: the microphone. The suite has no device, so a Capture is a handle
// whose reads find nothing; what reaches a device branches on ready().
assert_eq(type_of(Audio.capture_available()), "Bool")
let mic = Audio.Capture.new()
assert_eq(mic.running(), false)
assert_eq(mic.waiting(), 0)
assert_eq(mic.read(0), [])
if !mic.ready() {
  mic.start()
  assert_eq(mic.running(), false)
  assert_eq(mic.read(), [])
  assert_eq(mic.read(64), [])
}
mic.start()
mic.stop()
assert_eq(mic.running(), false)
assert_eq(Audio.Capture.new(16000, 2).read(), [])
// Its arguments follow PCM's rules, and raise the same way.
let too_fast = try {
  Audio.Capture.new(1 << 40)
} catch e {
  e
}
assert_eq((too_fast.kind, too_fast.message.contains("Audio.Capture: rate")), ("ValueError", true))
assert_throws("TypeError", fn () {
  Audio.Capture.new("44100")
})
assert_throws("TypeError", fn () {
  mic.read("all")
})

// A part's samples against the same computation written out here: the same
// but for the last bits of rounding, where a machine that fuses a multiply
// and an add into one step (clang on arm64) rounds once and the script twice.
fn assert_samples(got, want) {
  assert_eq(got.size(), want.size())
  for i in 0..got.size() {
    assert_close(got[i], want[i], 1e-9)
  }
}

// A recording read as it is: its rate, and each channel's samples at the
// depth it was made in. A Sound's 16-bit WAV gives its samples back; a
// 24-bit one keeps what 16 bits cannot; a stereo one its two channels apart.
let read = Audio.decode(Audio.Sound.new([0.0, 0.25, -0.5], rate: 22050).data())
assert_eq(read.rate, 22050)
assert_eq(read.channels, [[0.0, 0.25, -0.5]])
let pcm24 = String.pack("u8", [4194304, 1, -8388608].flat_map(|v| [v & 255, (v >> 8) & 255, (v >> 16) & 255]))
assert_eq(Audio.decode(wav_of(pcm24, 1, 48000, 24)).channels, [[0.5, 1.0 / 8388608, -1.0]])
let both_sides = Audio.decode(wav_of(String.pack("i16", [16384, -8192, -16384, 0]), 2, 8000, 16))
assert_eq(both_sides, {rate: 8000, channels: [[0.5, -0.5], [-0.25, 0.0]]})
let mp3 = Audio.decode(MP3)
assert_eq((mp3.rate, mp3.channels.size(), mp3.channels[0].size()), (8000, 1, 2880))
assert_true(mp3.channels[0].all(|v| Math.abs(v) <= 1.0))
assert_throws("ValueError", fn () {
  Audio.decode("not audio")
})
assert_throws("ValueError", fn () {
  Audio.decode(wav16.slice(0, 12).to_string())
})

// A spectrum, a frame of `size` from every `hop`-th sample: |X_k| of the
// frame through a periodic Hann window, as numpy's rfft gives it. A constant
// is bins 0 and 1 (size/2 and size/4); a sine on a bin peaks there at a
// quarter of the size times its amplitude.
let at_rate = |freq, n, rate| iota(n).map(|i| 0.5 * Math.sin(2.0 * Math.pi * freq * i / rate))
assert_samples(Audio.spectrum(repeat(8, 1.0), size: 8, hop: 8)[0], [4.0, 2.0, 0.0, 0.0, 0.0])
let frames = Audio.spectrum(at_rate(8.0, 400, 64), size: 64, hop: 32)
assert_eq((frames.size(), frames[0].size()), (13, 33))
assert_eq(frames[0].index_of(frames[0].max()), 8)
assert_close(frames[0][8], 8.0, 1e-9)
assert_eq(Audio.spectrum([]), [])
assert_eq(Audio.spectrum([1.0]).size(), 1)
assert_throws("ValueError", fn () {
  Audio.spectrum([1.0], size: 48)
})
assert_throws("ValueError", fn () {
  Audio.spectrum([1.0], hop: 0)
})

// Samples at another rate: ceil(n * to / from) of them, a tone kept to within
// 1e-5, one above the new rate's half gone; the same at the same rate.
let to44 = Audio.resample(at_rate(1000.0, 2400, 48000), 48000, 44100)
assert_eq(to44.size(), 2205)
let kept = at_rate(1000.0, 2205, 44100)
assert_true(iota(200, 2005).all(|i| Math.abs(to44[i] - kept[i]) < 1e-5))
let folded = Audio.resample(at_rate(30000.0, 4800, 96000), 96000, 44100)
assert_true(iota(200, folded.size() - 200).all(|i| Math.abs(folded[i]) < 1e-5))
assert_eq(Audio.resample([0.1, 0.2, 0.3], 8000, 16000).size(), 6)
assert_eq(Audio.resample([0.1, 0.2], 44100, 44100), [0.1, 0.2])
assert_eq(Audio.resample([], 8000, 16000), [])
assert_throws("ValueError", fn () {
  Audio.resample([0.1], 0, 44100)
})

// Closed like the C++ namespaces: an unknown member raises.
assert_throws("AttributeError", fn () {
  Audio.typo
})

print("audio ok\n")
