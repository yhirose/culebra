# A defer that throws while its scope unwinds replaces the exception in
# flight, and the unwind goes on from that scope outward with the
# replacement: the scope's bindings still drop and the enclosing scopes'
# defers still run, in order — the exit a defer throwing on the normal path
# always gave. The frame used to be abandoned on the spot:
# its bindings never dropped, and its remaining defers ran late, after the
# caller's catch body.

mut log = []
fn res(name) {
  {drop: fn () {
    log.push("drop {name}")
  }}
}
fn taken() {
  let out = log
  log = []
  out
}

# --- the rest of the frame: the normal path is the reference
fn on_normal_path() {
  defer {
    log.push('outer defer')
  }
  let a = res('outer')
  {
    let b = res('inner')
    defer {
      throw 'replacement'
    }
  }
}
fn on_unwind_path() {
  defer {
    log.push('outer defer')
  }
  let a = res('outer')
  {
    let b = res('inner')
    defer {
      throw 'replacement'
    }
    throw 'original'
  }
}
fn caller(f) {
  defer {
    log.push('caller defer')
  }
  try {
    f()
  } catch e {
    log.push("caught {e}")
  }
  log.push('after try')
}
caller(on_normal_path)
let reference = taken()
assert_eq(
  reference,
  [
    'drop inner',
    'outer defer',
    'drop outer',
    'caught replacement',
    'after try',
    'caller defer',
  ],
)
caller(on_unwind_path)
assert_eq(taken(), reference)

# --- a throwing defer abandons the rest of its OWN scope's defers, on
#     either path; the enclosing scope's are not its own
fn same_scope(throws) {
  defer {
    log.push('enclosing scope')
  }
  {
    defer {
      log.push('abandoned')
    }
    defer {
      throw 'replacement'
    }
    defer {
      log.push('ran first')
    }
    if throws {
      throw 'original'
    }
  }
}
for throws in [false, true] {
  assert_eq(try {
    same_scope(throws)
  } catch e {
    e
  }, 'replacement')
  assert_eq(taken(), ['ran first', 'enclosing scope'])
}

# --- an enclosing scope's throwing defer replaces the replacement
fn twice() {
  defer {
    throw 'second'
  }
  {
    defer {
      throw 'first'
    }
    throw 'original'
  }
}
assert_eq(try {
  twice()
} catch e {
  e
}, 'second')

# --- an enclosing try of the same frame catches the replacement...
fn enclosing_try() {
  try {
    {
      defer {
        throw 'replacement'
      }
      throw 'original'
    }
  } catch e {
    "caught {e}"
  }
}
assert_eq(enclosing_try(), 'caught replacement')

# ...but a try body's OWN defers run outside its catch's reach, as they do
# when the body ends normally (test_defer.cul): the next try out gets it
fn own_body(throws) {
  try {
    try {
      defer {
        throw 'replacement'
      }
      if throws {
        throw 'original'
      }
    } catch e {
      "inner caught {e}"
    }
  } catch e {
    "outer caught {e}"
  }
}
assert_eq(own_body(false), 'outer caught replacement')
assert_eq(own_body(true), 'outer caught replacement')

# --- a trap replacing a throw, and a throw replacing a trap
fn trap_replaces() {
  defer {
    1 / 0
  }
  throw 'original'
}
assert_eq(try {
  trap_replaces()
} catch e {
  e.kind
}, 'ZeroDivisionError')
fn throw_replaces_trap() {
  defer {
    throw 'replacement'
  }
  1 / 0
}
assert_eq(try {
  throw_replaces_trap()
} catch e {
  e
}, 'replacement')

# --- nothing of the abandoned throw, or of the frame, is stranded
fn held(work) {
  let v = {tag: 'payload'}
  let base = GC.refcount(v)
  mut k = 0
  while k < 10 {
    work(v)
    k += 1
  }
  GC.refcount(v) - base
}
fn param_payload(v) {
  defer {
    throw 'replacement'
  }
  throw v
}
fn local_binding(v) {
  let alias = v
  {
    let inner = v
    defer {
      throw 'replacement'
    }
    throw 'original'
  }
}
assert_eq(held(fn (v) {
  try {
    param_payload(v)
  } catch _ {
    nil
  }
}), 0)
assert_eq(held(fn (v) {
  try {
    local_binding(v)
  } catch _ {
    nil
  }
}), 0)

inspect('defer throw replaces: ok')
