// Conformance: the POSIX filesystem model under FS — the part of stdlib §3
// Windows does not provide. See docs/stdlib.md §FS.
// Tests run on vm, JIT, and AOT via `just test`; identical stdout.
//
// Split out of test_fs.cul, which Windows now passes in full. Two things
// live here: permission bits (Windows keeps one read-only attribute, so a
// mode does not round-trip) and numeric uid/gid ownership (Windows has none —
// FS.stat omits both fields there and FS.chown raises).
// tools/checks/windows_known_failures.txt lists this file for those reasons; what
// both platforms *do* agree on stayed in test_fs.cul.

let tmp_root = FS.mkdtemp("culebra_fs_posix_test_")
let bogus = "/definitely/not/a/real/path/xyzzy"
let cf = FS.join(tmp_root, "f.txt")
FS.write(cf, "hello")

// chmod sets permission bits; stat.mode reads them back (round-trip).
FS.chmod(cf, 0o644)
assert_eq(FS.stat(cf).mode, 0o644)
FS.chmod(cf, 0o600)
assert_eq(FS.stat(cf).mode, 0o600)
FS.chmod(cf, 0o755)
assert_eq(FS.stat(cf).mode, 0o755)

// stat exposes uid/gid; chown to the file's own owner/group is allowed for a
// non-root process (so this is root-independent) and leaves them unchanged.
let own = FS.stat(cf)
assert_true(own.uid >= 0)
assert_true(own.gid >= 0)
FS.chown(cf, own.uid, own.gid)  // numeric owner + group
assert_eq(FS.stat(cf).uid, own.uid)
FS.chown(cf, group: own.gid)  // group only; owner left unchanged
assert_eq(FS.stat(cf).uid, own.uid)
// chown errors: missing path -> IOError; unknown name -> IOError; a non
// String/Long/Nil owner -> TypeError. (All identical across backends.)
assert_eq(try {
  FS.chown(bogus, 0)
  "ok"
} catch e {
  e.kind
}, "IOError")
assert_eq(try {
  FS.chown(cf, owner: "no_such_user_zzz")
  "ok"
} catch e {
  e.kind
}, "IOError")
assert_eq(try {
  FS.chown(cf, owner: true)
  "ok"
} catch e {
  e.kind
}, "TypeError")
// A StringView (e.g. a slice) is a name, not a type error: it reaches name
// resolution -> unknown-user IOError, identically on both backends.
assert_eq(try {
  FS.chown(cf, owner: "no_such_user_zzz"[0..5])
  "ok"
} catch e {
  e.kind
}, "IOError")

// FS.walk lists a directory it may not read but does not enter it, and walks
// on past it — it used to stop there and return what it had so far. Walked
// from a directory whose entries sort around the locked one, so the siblings
// after it in either readdir order are checked. (Skipped when the process can
// read a mode-000 directory anyway, as root can.)
let wroot = FS.join(tmp_root, "walk")
for d in ["a", "m/locked/inner", "z"] {
  FS.mkdir(FS.join(wroot, d))
}
FS.write(FS.join(wroot, "a", "f"), "1")
FS.write(FS.join(wroot, "z", "g"), "1")
let locked = FS.join(wroot, "m", "locked")
FS.chmod(locked, 0o000)
let privileged = try {
  FS.walk(locked)
  true
} catch e {
  false
}
let walked = FS.walk(wroot).map(|p| p.replace(wroot, "")).sorted()
FS.chmod(locked, 0o755)
if !privileged {
  assert_eq(walked, ["/a", "/a/f", "/m", "/m/locked", "/z", "/z/g"])
}

// symlink / readlink / is_symlink live in test_fs_symlink.cul — they work on
// Windows (given the privilege it asks for), unlike everything above.

FS.remove(tmp_root, recursive: true)

IO.inspect("test_fs_posix OK")
