# Conformance: an unboxed `@value` chain answers exactly what the boxed form
# answers. Every case here is written so that BOTH compile paths are exercised
# somewhere in the file — the inlined one when the whole chain qualifies, the
# ordinary boxed one when any part of it does not — and the two must agree.
#
# The chain only stays unboxed while every step is a declared-field read or a
# splice-able same-class method, ending on a scalar. Anything else compiles
# the way it always did, which is why the negative cases below matter as much
# as the positive ones: they are what pins the decision to "decline", rather
# than to some half-inlined state.
#
# Run: ./build/culebra tests/test_value_inline.cul
#      ./build/culebra --jit tests/test_value_inline.cul

@value
class V2 {
  x: Float
  y: Float

  new(x: Float, y: Float) {
    self.x = x
    self.y = y
  }

  add(o) {
    V2.new(self.x + o.x, self.y + o.y)
  }

  scale(k) {
    V2.new(self.x * k, self.y * k)
  }

  len() {
    Math.sqrt(self.x * self.x + self.y * self.y)
  }
}

test_field_read_off_a_construction = fn () {
  assert_eq(V2.new(3.0, 4.0).x, 3.0)
  assert_eq(V2.new(3.0, 4.0).y, 4.0)
}
test_field_read_off_a_construction()

test_scalar_tailed_method = fn () {
  assert_eq(V2.new(3.0, 4.0).len(), 5.0)
  assert_eq(V2.new(0.0, 0.0).len(), 0.0)
}
test_scalar_tailed_method()

test_run_returning_method_then_field = fn () {
  assert_eq(V2.new(1.0, 2.0).scale(3.0).x, 3.0)
  assert_eq(V2.new(1.0, 2.0).scale(3.0).y, 6.0)
  # chained: each step hands the next a run, the last hands back a scalar
  assert_eq(V2.new(1.0, 2.0).scale(2.0).scale(3.0).y, 12.0)
  assert_eq(V2.new(1.0, 2.0).scale(2.0).len(), V2.new(2.0, 4.0).len())
}
test_run_returning_method_then_field()

test_boxed_argument_still_works = fn () {
  # The argument is itself a construction whose chain ends holding a run, so
  # it declines and arrives boxed. The inlined body reads it the ordinary way.
  let other = V2.new(10.0, 20.0)
  assert_eq(V2.new(1.0, 2.0).add(other).x, 11.0)
  assert_eq(V2.new(1.0, 2.0).add(other).y, 22.0)
}
test_boxed_argument_still_works()

test_boxed_form_is_untouched = fn () {
  # A construction bound to a name is a run with nowhere to go, so it builds
  # the ordinary instance — and everything about that instance still holds.
  let v = V2.new(3.0, 4.0)
  assert_eq(v.x, 3.0)
  assert_eq(v.len(), 5.0)
  assert_eq(v.scale(2.0).x, 6.0)
  assert_eq(v, V2.new(3.0, 4.0))
  assert_eq(v.keys(), ['class', 'x', 'y'])
  assert_throws('ImmutableError', fn () {
    v.x = 9.0
  })
}
test_boxed_form_is_untouched()

# A typed constructor parameter checks at the argument, inlined or not.
test_typed_param_still_checks = fn () {
  assert_throws('TypeError', fn () {
    V2.new('nope', 1.0).x
  })
  assert_throws('TypeError', fn () {
    V2.new(1.0, 'nope').len()
  })
}
test_typed_param_still_checks()

# --- the shapes that must NOT inline, and must still be right ---------------

@value
class Seeded {
  n: Long = 7

  new(n: Long) {
    self.n = n
  }
}

test_field_initializer_declines = fn () {
  # An initializer routes construction through the field-init thunk, so the
  # class is not laid out flat — the ordinary path answers.
  assert_eq(Seeded.new(3).n, 3)
  assert_eq(Seeded.new(3), Seeded.new(3))
}
test_field_initializer_declines()

@value
class Inner {
  a: Long

  new(a: Long) {
    self.a = a
  }
}

@value
class Nested {
  inner: Inner
  k: Long

  new(inner: Inner, k: Long) {
    self.inner = inner
    self.k = k
  }
}

test_nested_value_field_declines = fn () {
  # A nested `@value` field is a legal value field but not a flat one, so the
  # class keeps the boxed layout.
  let n = Nested.new(Inner.new(5), 6)
  assert_eq(n.k, 6)
  assert_eq(n.inner.a, 5)
  assert_eq(Nested.new(Inner.new(5), 6).k, 6)
}
test_nested_value_field_declines()

@value
class Looping {
  n: Long

  new(n: Long) {
    self.n = n
  }

  # A loop needs a chunk's jump machinery, so this member declines while its
  # straight-line sibling below still inlines.
  sum_to() {
    let mut acc = 0
    for i in 0..self.n {
      acc += i
    }
    acc
  }

  twice() {
    self.n * 2
  }
}

test_loop_member_declines_sibling_still_inlines = fn () {
  assert_eq(Looping.new(4).sum_to(), 6)
  assert_eq(Looping.new(4).twice(), 8)
}
test_loop_member_declines_sibling_still_inlines()

test_shadowed_global_declines = fn () {
  # `len()` reaches the stdlib `Math`. A caller that binds its own `Math`
  # must not have the body silently resolve to it — the splice is refused,
  # and the boxed call reaches the real one.
  let Math = 'not the namespace'
  assert_eq(V2.new(3.0, 4.0).len(), 5.0)
  assert_eq(Math, 'not the namespace')
}
test_shadowed_global_declines()

# ---- consumer-classified escapes: a run must never reach a consumer that
# ---- expects a tagged Value, so these shapes decline and the boxed path
# ---- answers (each was found live doing something else first).
# ---- Every `v = v + …` below is written as a reassignment on purpose —
# ---- it exercises the write arm, which compiles separately from the
# ---- compound one (`+=` has its own test); lint flags the shape, do not
# ---- fold it.

@value
class E2 {
  x: Float
  y: Float

  new(x: Float, y: Float) {
    self.x = x
    self.y = y
  }

  len() {
    Math.sqrt(self.x * self.x + self.y * self.y)
  }

  __add__(o) {
    E2.new(self.x + o.x, self.y + o.y)
  }

  __sub__(o) {
    E2.new(self.x - o.x, self.y - o.y)
  }

  __mul__(k) {
    E2.new(self.x * k, self.y * k)
  }

  __neg__() {
    E2.new(-self.x, -self.y)
  }

  addp(o) {
    self + o
  }

  flip() {
    -self
  }

  chained(o) {
    (self + o).len()
  }
}

test_body_fold_escapes_stay_boxed = fn () {
  # `self + o` / `-self` inside a body has no consumer for the run it would
  # produce (a member's out slot is a run only for a `C.new(...)` tail), so
  # each of these members declines whole and the boxed path answers.
  assert_eq(E2.new(1.0, 2.0).addp(E2.new(3.0, 4.0)), E2.new(4.0, 6.0))
  assert_eq(E2.new(1.0, 2.0).flip(), E2.new(-1.0, -2.0))
  assert_eq(E2.new(3.0, 4.0).chained(E2.new(0.0, 0.0)), 5.0)
}
test_body_fold_escapes_stay_boxed()

test_local_fold_escapes_stay_boxed = fn () {
  # The same rule at a whole-scope local: a fold whose result escapes to an
  # argument, an array element, or a bare negation declines the binding
  # entirely — no partial state, the ordinary instance everywhere.
  let mut v = E2.new(1.0, 2.0)
  v = v + E2.new(0.5, 0.5)
  assert_eq(v + E2.new(1.0, 1.0), E2.new(2.5, 3.5))
  let arr = [v + E2.new(0.0, 0.0)]
  assert_eq(arr[0].x, 1.5)
  assert_eq(-v, E2.new(-1.5, -2.5))
}
test_local_fold_escapes_stay_boxed()

@value
class ScalarAdd {
  x: Float
  y: Float

  new(x: Float, y: Float) {
    self.x = x
    self.y = y
  }

  __add__(o) {
    self.x + o.x
  }
}

test_scalar_dunder_declines = fn () {
  # A dunder that does not end in its own construction cannot promise a
  # run, so nothing splices through it; the boxed answers hold everywhere,
  # including the TypeError a field read on its Float result raises.
  let mut v = ScalarAdd.new(1.0, 2.0)
  v = v + ScalarAdd.new(3.0, 4.0)
  assert_eq(v, 4.0)
  assert_throws('TypeError', fn () {
    (ScalarAdd.new(1.0, 2.0) + ScalarAdd.new(3.0, 4.0)).x
  })
}
test_scalar_dunder_declines()

# ---- binding-level unboxing: the shapes that stay unboxed for a whole
# ---- scope, and the ones that decline it. (A later write to a plain `let`
# ---- is rejected before anything runs, so it cannot appear in this file;
# ---- the decline path keeps that rejection byte-identical by compiling
# ---- nothing differently.)

test_mut_local_reassign_stays_unboxed = fn () {
  let mut v = E2.new(3.0, 0.0)
  for i in 0..5 {
    v = v + E2.new(0.25, -4.9)
  }
  assert_eq(v.x, 4.25)
  assert_eq(v.y, -24.5)
  assert_eq((v + E2.new(0.75, 0.5)).len(), Math.sqrt(25.0 + 576.0))
}
test_mut_local_reassign_stays_unboxed()

test_plain_let_stays_unboxed = fn () {
  let g = E2.new(0.5, -9.8)
  assert_eq(g.x, 0.5)
  assert_eq(g.len(), Math.sqrt(0.25 + 96.04))
  let d = E2.new(3.0, 4.0) + E2.new(0.5, 0.5)
  assert_eq(d.x, 3.5)
  assert_eq(d.y, 4.5)
  let n = -E2.new(1.0, -2.0)
  assert_eq(n.x, -1.0)
  assert_eq(n.y, 2.0)
}
test_plain_let_stays_unboxed()

test_compound_assign_splices = fn () {
  let mut a = E2.new(10.0, 20.0)
  a += E2.new(1.0, 2.0)
  a -= E2.new(0.5, 0.5)
  a *= 2.0
  assert_eq(a.x, 21.0)
  assert_eq(a.y, 43.0)
  # The binding on its own RHS would arrive as a raw run for `o`: declines.
  let mut b = E2.new(1.0, 1.0)
  b += b
  assert_eq(b.x, 2.0)
  assert_eq(b.y, 2.0)
}
test_compound_assign_splices()

test_captured_or_retyped_declines = fn () {
  let mut v = E2.new(1.0, 2.0)
  v = v + E2.new(1.0, 1.0)
  let f = fn () {
    v.x
  }
  assert_eq(f(), 2.0)
  let mut w = E2.new(1.0, 2.0)
  w = w + E2.new(0.0, 0.0)
  w = 'not a point'
  assert_eq(w, 'not a point')
}
test_captured_or_retyped_declines()

inspect('value-inline OK')
