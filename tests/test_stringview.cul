// StringView + StringLike trait + zero-copy String API.

// --- .view() and .to_string() ---
let s = 'hello'
let v = s.view()
assert_eq(type_of(v), 'StringView')
assert_eq(v, 'hello')
assert_eq(v.to_string(), 'hello')
assert_eq(type_of(v.to_string()), 'String')

// View of an existing view reuses the shared source.
let v2 = v.view()
assert_eq(type_of(v2), 'StringView')
assert_eq(v2, 'hello')

// --- slice returns StringView, source kept alive across temps ---
assert_eq(type_of('hello'.slice(1, 4)), 'StringView')
assert_eq('hello'.slice(1, 4), 'ell')
assert_eq('hello'.slice(-3, -1), 'll')
assert_eq('hello'.slice(2, 10), 'llo')

// Even from a discarded temp, the shared source keeps the view valid.
let a = 'hello world'.slice(6, 11)
assert_eq(a, 'world')
let b = a.slice(0, 3)
assert_eq(b, 'wor')

// --- split returns Array<StringView> ---
let parts = 'a,b,c,d'.split(',')
assert_eq(type_of(parts), 'Array')
assert_eq(parts.size(), 4)
assert_eq(parts[0], 'a')
assert_eq(parts[3], 'd')
assert_eq(type_of(parts[0]), 'StringView')

// Empty separator returns the whole string.
let whole = 'abc'.split('')
assert_eq(whole.size(), 1)
assert_eq(whole[0], 'abc')

// StringLike sep — accepts both String and StringView.
assert_eq('a,b'.split(','.view())[0], 'a')

// --- split_iter is lazy + composable ---
let three = 'a,b,c,d,e,f'.split_iter(',').take(3).collect()
assert_eq(three.size(), 3)
assert_eq(three[0], 'a')
assert_eq(three[2], 'c')

let upper = 'a,b,c'.split_iter(',').map(fn (s) { s.upper() }).collect()
assert_eq(upper[0], 'A')
assert_eq(upper[2], 'C')

// --- StringLike acceptance for receivers + args ---
assert_eq(v.upper(), 'HELLO')
assert_eq(v.lower(), 'hello')
assert_eq('  x  '.view().trim(), 'x')
assert_true(v.contains('ll'))
assert_true(v.starts_with('he'))
assert_true(v.ends_with('lo'))
assert_eq(v.size(), 5)
assert_true(v.contains('ell'.view()))
assert_true(v.starts_with('he'.view()))
assert_true(v.ends_with('lo'.view()))

// --- StringLike trait ---
trait Sized {
  size() -> Long
}
fn n_bytes(x: StringLike) -> Long { x.size() }
assert_eq(n_bytes('hello'), 5)
assert_eq(n_bytes('hello'.view()), 5)
assert_eq(n_bytes('hello'.slice(0, 3)), 3)

// --- Cross-flavor equality + hashing ---
assert_eq('hello', 'hello'.view())
assert_eq('hello'.view(), 'hello')

// --- for-in iterates StringView ---
let chars = []
for c in 'abc'.view() { chars.push(c) }
assert_eq(chars.size(), 3)
assert_eq(chars[0], 'a')

// Split + join round-trips without quoting StringView elements.
assert_eq('a,b,c'.split(',').join('-'), 'a-b-c')

// Match patterns: String literal matches StringView subject.
fn classify(s: StringLike) -> Long {
  match s { 'hi' => 1, _ => 0 }
}
assert_eq(classify('hi'), 1)
assert_eq(classify('hi'.view()), 1)
assert_eq(classify('bye'), 0)

// __str__ may return either flavor.
class Tag {
  new(label) { this.label = label }
  __str__() { this.label.view() }
}
assert_eq(to_string(Tag.new('demo')), 'demo')

// match TYPED_IDENT accepts StringView and StringLike trait.
fn kind(x) {
  match x {
    s: StringView => 'view',
    s: String => 'string',
    _ => 'other',
  }
}
assert_eq(kind('hi'), 'string')
assert_eq(kind('hi'.view()), 'view')
assert_eq(kind(42), 'other')

fn is_stringlike(x) {
  match x { s: StringLike => true, _ => false }
}
assert_true(is_stringlike('a'))
assert_true(is_stringlike('a'.view()))
assert_false(is_stringlike(1))

// iter() walks UTF-8 scalars. interp yields StringView, JIT yields
// Long codepoints — use .code_points() for backend-uniform Long, or
// for-in which is byte-uniform.
assert_eq('abc'.code_points().count(), 3)
