// Constant strings in constant positions: object-literal keys and match
// patterns accept `"..."` / `'...'` / backtick literals (when they carry no
// interpolation). Interpolating `"...{x}..."` in either position is a
// pre-execution SyntaxError (checked by lint, verified out-of-band).

// --- object literal keys (all string lanes; mixed with identifier keys) ---
let o = {"User-Agent": "Mozilla", 'x': 1, `b-c`: 2, a: 3}
assert_eq(o["User-Agent"], "Mozilla")
assert_eq(o["x"], 1)
assert_eq(o["b-c"], 2)
assert_eq(o.a, 3)                       // identifier key still dot-accessible
assert_eq(o["a"], 3)

// double-quote key decodes escapes (interpolated lane), single-quote is raw
let e = {"a\tb": 9, 'c\td': 8}
assert_eq(e["a\tb"], 9)                 // "\t" → real tab on both sides
assert_eq(e['c\td'], 8)                 // raw backslash-t on both sides

// non-string literal keys still work (unchanged by this feature)
let n = {1: "one", 2: "two"}
assert_eq(n[1], "one")
assert_eq(n[2], "two")
assert_eq({true: "yes"}[true], "yes")

// --- match patterns ---
fn classify(s) {
  match s {
    "north" | "south" => "vertical",     // OR of "..." patterns
    "east" => "horizontal",
    'raw-lane' => "raw",                  // single-quote pattern
    "" => "empty",                        // empty constant
    "tab\tsep" => "escaped",              // escape-decoded constant
    _ => "other"
  }
}
assert_eq(classify("north"), "vertical")
assert_eq(classify("south"), "vertical")
assert_eq(classify("east"), "horizontal")
assert_eq(classify("raw-lane"), "raw")
assert_eq(classify(""), "empty")
assert_eq(classify("tab\tsep"), "escaped")
assert_eq(classify("zzz"), "other")

IO.inspect("test_const_string_positions OK")
