# Shared.new — variable-length IMMUTABLE data shared by reference across
# isolates (C4; the read-only lane next to SharedBuffer's fixed-layout
# read+write lane and the channel's copy lane). The value is frozen once
# (what a channel can send, less functions and handles), lives outside the
# GC, and every isolate reads the same tree through a view handle: leaves
# materialize on access, containers come back as sub-views, nothing is
# copied per worker.

# --- leaves materialize on access ---
let cfg = Shared.new({lr: 0.5, steps: 100, name: 'adam', on: true, pad: nil})
assert_eq(cfg.lr, 0.5)
assert_eq(cfg.steps, 100)
assert_eq(cfg.name, 'adam')
assert_eq(cfg.on, true)
assert_eq(cfg.pad, nil)
assert_eq(cfg['lr'], 0.5)  # index and property reads are the same view

# --- containers come back as sub-views (still shared, no copy) ---
let model = Shared.new({
  dims: [4, 8, 2],
  vocab: {hello: 1, world: 2},
  pair: (3, 'x'),
})
assert_eq(model.dims[1], 8)
assert_eq(model.dims.size(), 3)
let v = model.vocab
assert_eq(v['hello'], 1)
assert_eq(v.size(), 2)
assert_eq(v.has('world'), true)
assert_eq(v.has('nope'), false)
assert_eq(model.pair[1], 'x')

# --- keys / values / iteration mirror the local collection protocols ---
assert_eq(model.vocab.keys().sorted_by(|k| k), ['hello', 'world'])
mut total = 0
for k, n in model.vocab {
  total = total + n
}
assert_eq(total, 3)
mut dsum = 0
for d in model.dims {
  dsum = dsum + d
}
assert_eq(dsum, 14)

# keys() and values() hand each element to the Array once: a Tuple key and a
# container value are still themselves however often they are listed.
mut by_pair = {}
by_pair['s'] = {n: 1}
by_pair[(1, 2)] = [10, 20]
let pairs = Shared.new(by_pair)
for _ in 0..3 {
  assert_eq(pairs.keys(), ['s', (1, 2)])
  let vals = pairs.values()
  assert_eq(vals[0].n, 1)
  assert_eq(vals[1].size(), 2)
}

# --- copy() = deep materialization into the local heap (escape hatch) ---
let local = model.vocab.copy()
local['new'] = 9  # the copy is an ordinary mutable Object
assert_eq(local['new'], 9)
assert_eq(model.vocab.has('new'), false)  # the shared tree is untouched

# --- immutability: every write surface throws, the tree never changes ---
mut kind = nil
try {
  cfg.lr = 1.0
} catch e {
  kind = e.kind
}
assert_eq(kind, 'ImmutableError')
kind = nil
try {
  model.dims[0] = 99
} catch e {
  kind = e.kind
}
assert_eq(kind, 'ImmutableError')
kind = nil
try {
  model.vocab['hello'] = 0
} catch e {
  kind = e.kind
}
assert_eq(kind, 'ImmutableError')
assert_eq(cfg.lr, 0.5)
assert_eq(model.dims[0], 4)

# --- data only: a value carrying a Function is rejected at freeze ---
kind = nil
try {
  Shared.new({f: fn () {
    1
  }})
} catch e {
  kind = e.kind
}
assert_eq(kind, 'SendError')

# --- the existing Sendable rejections carry over (cycle) ---
let cyc = [1]
cyc.push(cyc)
kind = nil
try {
  Shared.new(cyc)
} catch e {
  kind = e.kind
}
assert_eq(kind, 'SendError')

# --- a refused freeze says what stopped it: in the words a send would use
# when the value cannot be sent at all, wherever in it that part is, and in
# Shared's own when it can. ---
fn shared_refusal(make) {
  try {
    Shared.new(make())
    'frozen'
  } catch e {
    "{e.kind}: {e.message}"
  }
}
let refused_fn = 'SendError: Shared.new: functions cannot be shared (Shared values are data only)'
let refused_cycle = 'SendError: Shared.new: a cyclic value cannot be sent'
let refused_inner = Shared.new([1])
assert_eq(shared_refusal(fn () { [1, |x| x] }), refused_fn)
assert_eq(shared_refusal(fn () { |x| x }), refused_fn)
assert_eq(shared_refusal(fn () { [println] }),
  'SendError: Shared.new: a native/builtin function is not Sendable')
assert_eq(shared_refusal(fn () { [[cyc]] }), refused_cycle)
assert_eq(shared_refusal(fn () { [refused_inner] }),
  'SendError: Shared.new: handles cannot be nested in a Shared value')
assert_eq(shared_refusal(fn () { [|x| x, cyc] }), refused_cycle)
assert_eq(shared_refusal(fn () { [cyc, |x| x] }), refused_cycle)
assert_eq(shared_refusal(fn () { [|x| x, println] }),
  'SendError: Shared.new: a native/builtin function is not Sendable')
refused_inner.drop()
assert_eq(shared_refusal(fn () { [refused_inner] }),
  'ClosedError: Shared.new: Shared value has been dropped')
mut refused_deep = [1]
for _ in 0..1500 {
  refused_deep = [refused_deep]
}
assert_eq(shared_refusal(fn () { refused_deep }),
  'ValueError: Shared.new: nesting too deep (limit 1000)')
cyc.pop()

# --- drop: explicit, idempotent; reads after drop fail cleanly ---
let dying = Shared.new({k: 1})
assert_eq(dying.k, 1)
dying.drop()
dying.drop()  # second drop is a no-op
kind = nil
try {
  dying.k
} catch e {
  kind = e.kind
}
assert_eq(kind, 'ClosedError')

# A sub-view holds the tree on its own, so it outlives the view it came from.
let parent = Shared.new({xs: [7, 8, 9]})
let outlives = parent.xs
parent.drop()
assert_eq(outlives[2], 9)

# A read that runs the program's own code may have its view dropped under it:
# the tree stays until the read is over, and the view is closed after it.
class SharedDropper {
  new(v) {
    self.v = v
  }
  __eq__(other) {
    self.v.drop()
    false
  }
}
let doomed = Shared.new([1, 'x', [4]])
assert_eq(doomed.contains(SharedDropper(doomed)), false)
assert_throws('ClosedError', fn () { doomed.size() })

# Two views of one node are the same view to `==`; of two nodes, they are not,
# whatever the nodes hold.
let twice = Shared.new([[1, 2], [1, 2]])
assert_eq(twice.iter().next() == twice.iter().next(), true)
assert_eq(twice[0] == twice[1], false)

# --- cross-isolate: the same tree is READ by workers, not copied ---
let dict = Shared.new({hello: 1, world: 2, big: [10, 20, 30]})
let w = Isolate.spawn(fn () {
  dict['hello'] + dict.big[2]  # closure capture ships the reference
})
assert_eq(w.join(), 31)

# a sub-view crosses too
let big = dict.big
let w2 = Isolate.spawn(fn () {
  big[0] + big.size()
})
assert_eq(w2.join(), 13)

# Parallel workers all read the same shared value
let squares = Parallel.map([0, 1, 2], fn (i) {
  dict.big[i] * dict.big[i]
})
assert_eq(squares, [100, 400, 900])

# through a channel
let (tx, rx) = Channel.new(1)
tx.send(dict)
let got = rx.recv()
assert_eq(got['world'], 2)

# --- the handle survives as long as any isolate still holds it ---
let keep = Shared.new({n: 7})
let w3 = Isolate.spawn(fn () {
  keep.n
})
assert_eq(w3.join(), 7)
assert_eq(keep.n, 7)

# --- has() misses its argument before it inspects the node ---
# The reader takes `key` as a required parameter, so the arity is what fails
# first — on an Array view (which has no keys at all) and on a dropped one.
let arr_view = Shared.new([1, 2])
assert_throws('ArityError', fn () {
  arr_view.has()
})
let gone = Shared.new({a: 1})
gone.drop()
assert_throws('ArityError', fn () {
  gone.has()
})

# --- iter() hands back the iterator an Array's own iter() is ---
# The position and the node it walks are the iterator's own business; the
# object carries the protocol's methods and no implementation detail.
let it = arr_view.iter()
assert_eq(it.keys(), [1].iter().keys())
assert_eq(it.has_next(), true)
assert_eq(it.next(), 1)
assert_eq(it.next(), 2)
assert_eq(it.has_next(), false)
assert_eq(it.next(), nil)
# An iterator is its own `iter()`, so a `for` takes one as it takes the view.
mut via_iter = []
for x in Shared.new([4, 5, 6]).iter() {
  via_iter.push(x)
}
assert_eq(via_iter, [4, 5, 6])
assert_eq(Shared.new([7]).iter().iter().next(), 7)

# An Object view yields (key, value) pairs, and a container value comes back
# as a sub-view the pair owns — the pair must outlive this step.
let nested = Shared.new({xs: [1, 2, 3]})
let pair = nested.iter().next()
assert_eq(pair[0], 'xs')
assert_eq(pair[1].size(), 3)
mut seen = []
for (k, v) in Shared.new({a: [1, 2], b: [3]}) {
  seen.push("{k}={v.size()}")
}
assert_eq(seen, ['a=2', 'b=1'])

# --- `for` walks a view by position, as it walks the value it froze ---
let walked_src = [[1, 2], [3], [], [4, 5, 6]]
let walked = Shared.new(walked_src)
mut flat_view = []
for row in walked {
  for x in row {
    flat_view.push(x)
  }
}
assert_eq(flat_view, [1, 2, 3, 4, 5, 6])
mut picked = []
for row in walked {
  if row.size() == 1 {
    continue
  }
  if row.size() == 3 {
    break
  }
  picked.push(row.size())
}
assert_eq(picked, [2, 0])
mut members = []
for x in Shared.new([3, 1, 2].to_set()) {
  members.push(x)
}
assert_eq(members, [3, 1, 2])
mut of_tuple = []
for x in Shared.new((7, [8])) {
  of_tuple.push(to_string(x))
}
assert_eq(of_tuple, ['7', '[8]'])
mut whole_pairs = []
for p in Shared.new({a: 1}) {
  whole_pairs.push(p)
}
assert_eq(whole_pairs, [('a', 1)])
for _ in Shared.new([]) {
  assert_eq('walked', 'nothing')
}
# A row the loop handed over is a view of its own: it outlives the step.
mut kept_rows = []
for row in walked {
  kept_rows.push(row)
}
assert_eq(kept_rows.map(|r| r.size()), [2, 1, 0, 3])
# The walk holds the tree on its own: dropping the view part-way does not end
# it. A view dropped before the loop is refused where the loop opens.
let dropped_midway = Shared.new([1, 2, 3])
mut after_drop = []
for x in dropped_midway {
  after_drop.push(x)
  dropped_midway.drop()
}
assert_eq(after_drop, [1, 2, 3])
assert_throws('ClosedError', fn () {
  for x in dropped_midway {
    assert_eq('walked', 'nothing')
  }
})
# A walk suspended in a generator keeps its place, and one abandoned there
# gives the tree back with the generator.
fn shared_rows_gen(view) {
  for row in view {
    for x in row {
      yield x
    }
  }
}
let suspended = shared_rows_gen(walked)
assert_eq(suspended.next(), 1)
assert_eq(suspended.next(), 2)
assert_eq(suspended.next(), 3)
assert_eq(shared_rows_gen(walked).collect(), [1, 2, 3, 4, 5, 6])
# Several isolates walk one tree at once, each through views of its own, and
# a view one of them hands back still reads once that isolate is gone.
let walkers = [0, 1, 2, 3].map(|i| Isolate.spawn(fn () {
  mut n = 0
  mut last = nil
  for round in 0..50 {
    for row in walked {
      for x in row {
        n += x
      }
      last = row
    }
  }
  (n, last)
}))
for h in walkers {
  let (n, last) = h.join()
  assert_eq(n, 1050)
  assert_eq(last.copy(), [4, 5, 6])
}

# A key that isn't there is a KeyError, not a nil.
assert_throws('KeyError', fn () { cfg['zz'] })

# A frozen Object can carry non-String keys, and they compare by their own
# kind rather than by string form.
mut mixed = {}
mixed[1] = 'one'
mixed[true] = 'yes'
let sv = Shared.new(mixed)
assert_eq(sv[1], 'one')
assert_eq(sv[true], 'yes')
assert_throws('KeyError', fn () { sv[9] })

# A view finds a key the way the Object it froze does: any key a freeze admits
# (nil and a Tuple included, a Tuple by its elements), and never across types.
mut keyed = {}
keyed[nil] = 'none'
keyed[(1, 'a')] = 'pair'
keyed[((1, 2), 3.5)] = 'nested'
keyed[1] = 'long'
keyed[2.0] = 'float'
keyed['s'] = 'str'
let kv = Shared.new(keyed)
assert_eq(kv[nil], 'none')
assert_eq(kv[(1, 'a')], 'pair')
assert_eq(kv[((1, 2), 3.5)], 'nested')
assert_eq(kv[1], 'long')
assert_eq(kv[2.0], 'float')
assert_eq(kv['s'], 'str')
assert_eq([kv.has(nil), kv.has((1, 'a')), kv.has(1), kv.has('s')],
  [true, true, true, true])
assert_eq([kv.has((1, 'b')), kv.has(1.0), kv.has(2), kv.has(false),
  kv.has('t'), kv.has((1,))], [false, false, false, false, false, false])
assert_throws('KeyError', fn () { kv[(1, 'b')] })
assert_throws('KeyError', fn () { kv[1.0] })
# A substring is the String it spells, inside a Tuple too.
assert_eq(kv[(1, 'xa'[1..2])], 'pair')
assert_eq(kv.has('xs'[1..2]), true)
# A key nested past the depth a key's own hash stops at is refused the same way.
mut deep_key = (1,)
for _ in 0..5000 {
  deep_key = (deep_key,)
}
assert_throws('ValueError', fn () { kv.has(deep_key) })
assert_throws('ValueError', fn () { ({a: 1}).has(deep_key) })
# ...and one that cannot be a key at all is the TypeError it is for an Object.
assert_throws('TypeError', fn () { kv[[1]] })
assert_throws('TypeError', fn () { kv.has((1, [2])) })
# A key of any other kind a freeze admits is found as the value it is.
enum SharedSuit {
  Hearts,
  Spades,
}
mut by_suit = {}
by_suit[SharedSuit.Hearts] = 'h'
by_suit[(SharedSuit.Spades, 1)] = 's1'
let suits = Shared.new(by_suit)
assert_eq(suits[SharedSuit.Hearts], 'h')
assert_eq(suits[(SharedSuit.Spades, 1)], 's1')
assert_eq([suits.has(SharedSuit.Spades), suits.has((SharedSuit.Spades, 2))],
  [false, false])

# --- a value taken out of the tree alone is whole ---
# The tree writes a class out once, with the first value of it, and the later
# ones refer back. Whatever reads one of those alone still finds its class.
enum SharedCard {
  Card(Long),
  Joker,
}
class SharedPoint {
  new(.x) {}
}
let cards = [SharedCard.Card(1), SharedCard.Card(2), SharedPoint(1), SharedPoint(2)]
let card_view = Shared.new(cards)
assert_eq(card_view[1].copy(), SharedCard.Card(2))
assert_eq(to_string(card_view[3]), to_string(SharedPoint(2)))
assert_eq(card_view.index_of(SharedCard.Card(2)), cards.index_of(SharedCard.Card(2)))
assert_eq(card_view.index_of(SharedPoint(2)), cards.index_of(SharedPoint(2)))
assert_eq(card_view.contains(SharedCard.Joker), false)
mut by_card = {}
by_card[SharedCard.Card(1)] = 'one'
by_card[SharedCard.Card(2)] = 'two'
let card_keys = Shared.new(by_card)
assert_eq(card_keys[SharedCard.Card(2)], 'two')
assert_eq(card_keys.has(SharedCard.Card(3)), false)
assert_eq(card_keys.keys(), [SharedCard.Card(1), SharedCard.Card(2)])
let card_set = Shared.new([SharedCard.Card(1), SharedCard.Card(2)].to_set())
assert_eq([card_set.contains(SharedCard.Card(2)), card_set.contains(SharedCard.Card(3))],
  [true, false])
mut seen_cards = []
for card in card_view {
  seen_cards.push(to_string(card))
}
assert_eq(seen_cards, cards.map(|c| to_string(c)))

# --- get / contains / index_of answer as the collection's own do ---
# Each is asked of the view and of the value it froze, and the two agree: a
# Set's member is found as a key is, an Array's element by `==`.
let asked_obj = {a: 1, b: nil}
asked_obj[(1, 2)] = 't'
let asked_arr = [3, 1, 2.0, 'x', [1, 2], nil]
let asked_set = [1, 'x', (2, 3), SharedSuit.Hearts].to_set()
let asked_tup = (3, 'x', [1])
let (view_obj, view_arr, view_set, view_tup) = (Shared.new(asked_obj),
  Shared.new(asked_arr), Shared.new(asked_set), Shared.new(asked_tup))
for key in ['a', 'b', 'zz', (1, 2), (1, 3), nil] {
  assert_eq(view_obj.get(key, 'no'), asked_obj.get(key, 'no'))
}
assert_eq(view_obj.get('zz', view_obj).a, 1)  # the fallback is handed back as it is
for i in [0, 4, -1, -6, 6, -7] {
  # A container comes back as a view of it, as `view[i]` does: compare shown.
  assert_eq(to_string(view_arr.get(i, 'no')), to_string(asked_arr.get(i, 'no')))
}
for x in [1, 2, 2.0, 'x', 'y', [1, 2], [1], nil, 9] {
  assert_eq(view_arr.contains(x), asked_arr.contains(x))
  assert_eq(view_arr.index_of(x), asked_arr.index_of(x))
  assert_eq(view_tup.contains(x), asked_tup.contains(x))
}
assert_eq(view_arr.index_of('zx'[1..2]), 3)  # a substring is the String it spells
for x in [1, 1.0, 'x', 'y', (2, 3), (2, 4), SharedSuit.Hearts, SharedSuit.Spades] {
  assert_eq(view_set.contains(x), asked_set.contains(x))
}
# What the collection refuses, the view refuses in the same words.
let said = fn (f) {
  try {
    f()
    'no error'
  } catch e {
    "{e.kind}: {e.message}"
  }
}
assert_eq(said(|| view_set.contains([1])), said(|| asked_set.contains([1])))
assert_eq(said(|| view_set.contains()), said(|| asked_set.contains()))
assert_eq(said(|| view_arr.index_of()), said(|| asked_arr.index_of()))
assert_eq(said(|| view_obj.get('a')), said(|| asked_obj.get('a')))
assert_eq(said(|| view_obj.get([1], 0)), said(|| asked_obj.get([1], 0)))
assert_eq(said(|| view_arr.get('x', 0)), said(|| asked_arr.get('x', 0)))
assert_eq(said(|| view_set.contains(1, 2)), said(|| asked_set.contains(1, 2)))
assert_eq(said(|| view_obj.get('a', 1, 2)), said(|| asked_obj.get('a', 1, 2)))
assert_eq(said(|| view_arr.index_of(1, 2, 3)), said(|| asked_arr.index_of(1, 2, 3)))
assert_eq(said(|| view_obj.has('a', 2)), said(|| asked_obj.has('a', 2)))
assert_eq(said(|| view_obj.keys(1)), said(|| asked_obj.keys(1)))
# A question for another kind of collection says which kinds it is for.
assert_throws('TypeError', fn () { view_obj.contains('a') })
assert_throws('TypeError', fn () { view_tup.index_of(3) })
assert_throws('TypeError', fn () { view_tup.get(0, nil) })
# `map` and `filter` are the Array's own, over what a walk of the view yields:
# a container element reaches the callback as a view, and a kept one stays one.
let table_src = [[1, 2], [3], [4, 5, 6]]
let table = Shared.new(table_src)
assert_eq(table.map(|row| row.size()), table_src.map(|row| row.size()))
assert_eq(view_arr.map(|x| type_of(x)), ['Long', 'Long', 'Float', 'String', 'Object', 'Nil'])
assert_eq(Shared.new([3, 1, 2]).map(|x| x * 2), [6, 2, 4])
assert_eq(Shared.new([3, 1, 2]).filter(|x| x > 1), [3, 2])
assert_eq(Shared.new([]).map(|x| x), [])
let wide_rows = table.filter(|row| row.size() > 1)
assert_eq(wide_rows.map(|row| row.copy()), [[1, 2], [4, 5, 6]])
assert_eq(wide_rows[1].contains(5), true)
assert_eq(table.map(|row| row.filter(|x| x % 2 == 0)), [[2], [], [4, 6]])
assert_eq(said(|| view_arr.map(3)), said(|| asked_arr.map(3)))
assert_eq(said(|| view_arr.map(|| 1)), said(|| asked_arr.map(|| 1)))
assert_eq(said(|| view_arr.map()), said(|| asked_arr.map()))
assert_eq(said(|| view_arr.filter(|a, b| true)), said(|| asked_arr.filter(|a, b| true)))
assert_eq(said(|| view_arr.filter(1, 2)), said(|| asked_arr.filter(1, 2)))
# ...and at its own argument, not where the Array's call before it was.
let refused_line = fn (f) {
  try {
    f()
    nil
  } catch e {
    e.line
  }
}
let on_array = refused_line(|| asked_arr.map(3))
let on_view = refused_line(|| view_arr.map(3))
assert_eq(on_view, on_array + 1)
assert_throws('TypeError', fn () { view_set.map(|x| x) })
assert_throws('TypeError', fn () { view_obj.filter(|x| true) })
# What the callback throws leaves the view as it was.
assert_throws('ValueError', fn () {
  table.map(fn (row) {
    throw {kind: 'ValueError', message: 'stop'}
  })
})
assert_eq(table.map(|row| row[0]), [1, 3, 4])
# A callback may drop the view it is being called for: the answer is whole,
# and the view is closed after it.
let self_dropping = Shared.new([[1], [2], [3]])
assert_eq(self_dropping.map(fn (row) {
  self_dropping.drop()
  row[0]
}), [1, 2, 3])
assert_throws('ClosedError', fn () { self_dropping.size() })
# Everything else a sequence answers, the view's iterator answers, one element
# at a time and with no copy of the whole.
assert_eq(view_arr.iter().filter(|x| type_of(x) == 'Long').map(|x| x * 2).collect(),
  [6, 2])
assert_eq(Shared.new([3, 1, 2]).iter().sum(), 6)

# An Array view takes a Long and says so; the interpreter's key.to_long()
# does not truncate a Float or accept a String either.
let bad_key = try { arr_view['x']; nil } catch e { e }
assert_eq(bad_key.message, 'type error: expected Long, got String')
assert_throws('IndexError', fn () { arr_view[99] })

# A view's shape is never an Object's: a write site an Object with the
# view's own slot names warmed still refuses the view.
let sv_target = Shared.new({a: 1})
fn poke(o) {
  o.__sharedval_hold__ = 0
}
let sv_impostor = {__sharedval_node__: 0, mut __sharedval_hold__: 1}
for _ in 0..3 {
  poke(sv_impostor)
}
assert_throws('ImmutableError', fn () {
  poke(sv_target)
})
assert_eq(sv_target.a, 1)

# --- a view read as a whole value is the value it froze ---
# Printing one, JSON.stringify and a spread read what copy() hands back. The
# view's own slots are its bookkeeping, and none of them shows.
let whole = Shared.new({a: 1, b: [1, (2, 3)], c: {d: 'x'}})
assert_eq(to_string(whole), "\{a: 1, b: [1, (2, 3)], c: \{d: 'x'}}")
assert_eq(to_string(whole.b), '[1, (2, 3)]')
assert_eq("{whole.c}", "\{d: 'x'}")
assert_eq(JSON.stringify(whole), '{"a":1,"b":[1,[2,3]],"c":{"d":"x"}}')
assert_eq(JSON.stringify({ok: true, data: whole.c}),
  '{"ok":true,"data":{"d":"x"}}')
let spread = {...whole, e: 5}
assert_eq(spread.keys(), ['a', 'b', 'c', 'e'])
spread.b.push(9)  # what was spread is the program's own, all the way down
assert_eq(whole.b.size(), 2)
assert_eq([...whole.b, 0], [1, (2, 3), 0])
# The view is still open once every copy of it is gone, and a child it has
# handed out changes nothing about how it reads.
assert_eq(whole.a, 1)
assert_eq({...whole}.keys(), ['a', 'b', 'c'])
# A name that is no method of the view is a key of the tree.
let named = Shared.new({_dropped: 7, size: 3})
assert_eq(named._dropped, 7)
assert_eq(named.__sharedval_node__, nil)
assert_eq(named['size'], 3)
# ...and a pattern, which asks whether a key is there, asks the tree as well.
let {_dropped: was_dropped, size: named_size} = named
assert_eq(was_dropped, 7)
assert_eq(type_of(named_size), 'Function')  # `size` is the view's own method
assert_eq(match named {
  {__sharedval_node__} => 'a marker',
  {_dropped} => _dropped,
  _ => 'none',
}, 7)
# A dropped view shows that it is one; reading it as a value is a read.
let shown = Shared.new({a: 1})
shown.drop()
assert_eq(to_string(shown), '[dropped Shared value]')
assert_throws('ClosedError', fn () { {...shown} })
assert_throws('ClosedError', fn () { JSON.stringify(shown) })
# A handle onto storage of another kind has no entries to spread.
@packable
class SharedSlotRec {
  n: Int32 = 0
}
let slots = SharedBuffer.new(1, SharedSlotRec)
assert_throws('TypeError', fn () { {...slots} })
assert_eq(slots[0].n, 0)
# A keyword splat reads entries the same way, so it refuses a handle too: a
# view is splatted as the value it froze by spreading it first.
fn shared_kw(**opts) {
  opts.keys()
}
assert_throws('TypeError', fn () { shared_kw(**whole) })
assert_throws('TypeError', fn () { shared_kw(**slots) })
assert_eq(shared_kw(**{...whole}), ['a', 'b', 'c'])
assert_eq([whole.a, slots[0].n], [1, 0])
# TOML writes a view as JSON does.
assert_eq(TOML.stringify(Shared.new({name: 'x', db: {port: 1}})),
  TOML.stringify({name: 'x', db: {port: 1}}))
assert_eq(TOML.stringify({cfg: whole.c}), TOML.stringify({cfg: {d: 'x'}}))

# --- an Object keeps its entry order when it is sent or frozen ---
mut ordered = {}
ordered[(1, 2)] = 'a'
ordered['s'] = 'b'
ordered[7] = 'c'
ordered['t'] = 'd'
ordered[3] = 'e'
let in_order = [(1, 2), 's', 7, 't', 3]
let sent = ordered
assert_eq(sent.keys(), in_order)
assert_eq(Shared.new(sent).keys(), in_order)
assert_eq(Shared.new(sent).copy().keys(), in_order)
let (otx, orx) = Channel.new(1)
otx.send(sent)
assert_eq(orx.recv().keys(), in_order)
assert_eq(Isolate.spawn(fn () {
  sent.keys()
}).join(), in_order)
# A key and its value of one class arrive together.
mut same_class = {}
same_class[SharedSuit.Hearts] = SharedSuit.Hearts
otx.send(same_class)
assert_eq(orx.recv()[SharedSuit.Hearts], SharedSuit.Hearts)

# --- Objects with the same keys share what says so, and each stays itself ---
# Many records of one key sequence, one of another order, one with a key
# more: each reads, lists and copies as the Object it froze.
mut shaped_src = iota(50).map(|i| {id: i, name: "n{i}", tags: [i, i + 1]})
shaped_src.push({name: 'swapped', id: -1, tags: []})
shaped_src.push({id: -2, name: 'wider', tags: [], extra: {id: 7}})
shaped_src.push({})
let shaped = Shared.new(shaped_src)
for i in 0..shaped_src.size() {
  assert_eq(shaped[i].keys(), shaped_src[i].keys())
  assert_eq(shaped[i].copy(), shaped_src[i])
  assert_eq(shaped[i].get('id', 'none'), shaped_src[i].get('id', 'none'))
  assert_eq(shaped[i].has('extra'), shaped_src[i].has('extra'))
}
assert_eq(shaped[51].extra.id, 7)
assert_eq(shaped[52].size(), 0)
mut shaped_names = []
for rec in shaped {
  for (k, v) in rec {
    shaped_names.push(v) if k == 'name'
  }
}
assert_eq(shaped_names, shaped_src.filter(|r| r.has('name')).map(|r| r.name))

# A key's mutability is the Object's own, whatever another of the same keys
# has: a copy takes a write where the Object it froze did.
mut frozen_loose = {}
frozen_loose.a = 1
frozen_loose.b = 2
let frozen_fixed = {a: 1, b: 2}
let frozen_mixed = Shared.new([frozen_loose, frozen_fixed, frozen_loose])
mut frozen_loose_back = frozen_mixed[0].copy()
frozen_loose_back.a = 10
assert_eq(frozen_loose_back, {a: 10, b: 2})
mut frozen_fixed_back = frozen_mixed[1].copy()
assert_throws('ImmutableError', fn () {
  frozen_fixed_back.a = 10
})
mut frozen_fixed_plain = frozen_fixed
assert_throws('ImmutableError', fn () {
  frozen_fixed_plain.a = 10
})

# A dictionary's worth of keys, of every plain kind, each found and none other.
mut frozen_wide = {}
for i in 0..300 {
  frozen_wide["k{i}"] = i
  frozen_wide[i] = -i
  frozen_wide[(i, "t{i}")] = [i]
  frozen_wide[i + 0.5] = 'f'
}
frozen_wide[nil] = 'nil'
frozen_wide[true] = 'yes'
let frozen_wide_view = Shared.new(frozen_wide)
assert_eq(frozen_wide_view.size(), frozen_wide.size())
for i in 0..300 {
  assert_eq(frozen_wide_view["k{i}"], i)
  assert_eq(frozen_wide_view[i], -i)
  assert_eq(frozen_wide_view[(i, "t{i}")][0], i)
  assert_eq(frozen_wide_view[i + 0.5], 'f')
  assert_eq(frozen_wide_view.has("k{i + 300}"), false)
  assert_eq(frozen_wide_view.has(i + 300), false)
  assert_eq(frozen_wide_view.has((i, "t{i + 1}")), false)
  assert_eq(frozen_wide_view.has(i + 0.25), false)
}
assert_eq([frozen_wide_view[nil], frozen_wide_view[true], frozen_wide_view.has(false), frozen_wide_view.has(1.0)],
  ['nil', 'yes', false, false])
assert_eq(frozen_wide_view.keys(), frozen_wide.keys())
assert_eq(frozen_wide_view.copy(), frozen_wide)

# A Set of as many, and one of Tuples.
let frozen_wide_set = Shared.new(frozen_wide.keys().to_set())
for k in frozen_wide.keys() {
  assert_eq(frozen_wide_set.contains(k), true)
}
assert_eq([frozen_wide_set.contains('k300'), frozen_wide_set.contains((0, 't1')), frozen_wide_set.contains(300)],
  [false, false, false])
assert_eq(frozen_wide_set.size(), frozen_wide.size())

# Strings: empty, long, repeated as key and as value, with bytes of every width.
let frozen_texts = ['', 'a', 'id', 'id', 'é', '日本語', 'k' + 'k', "a\0b"]
let frozen_text_view = Shared.new({id: frozen_texts, texts: 'id', '': ''})
for i in 0..frozen_texts.size() {
  assert_eq(frozen_text_view.id[i], frozen_texts[i])
  assert_eq(frozen_text_view.id[i].size(), frozen_texts[i].size())
}
assert_eq([frozen_text_view.texts, frozen_text_view[''], frozen_text_view.id.index_of('日本語')], ['id', '', 5])

# Empty containers at every level, and a root that is no container.
let frozen_hollow = Shared.new([[], {}, (1,), [].to_set(), [[], [[]]]])
assert_eq([frozen_hollow[0].size(), frozen_hollow[1].size(), frozen_hollow[2].size(), frozen_hollow[3].size()],
  [0, 0, 1, 0])
assert_eq(frozen_hollow.copy(), [[], {}, (1,), [].to_set(), [[], [[]]]])
assert_eq(frozen_hollow[4][1][0].size(), 0)
for leaf in [5, 2.5, 'text', nil, true] {
  let frozen_leaf_view = Shared.new(leaf)
  assert_eq(frozen_leaf_view.copy(), leaf)
  assert_eq(frozen_leaf_view.size(), 0)
  mut frozen_walked = 0
  for _ in frozen_leaf_view {
    frozen_walked += 1
  }
  assert_eq(frozen_walked, 0)
  assert_throws('TypeError', fn () { frozen_leaf_view[0] })
  assert_throws('TypeError', fn () { frozen_leaf_view.keys() })
}

IO.inspect('test_shared OK')
