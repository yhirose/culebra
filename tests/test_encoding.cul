// Encoding namespace: HTML entity codec. Grouped as a nested sub-namespace
// (`Encoding.html.*`) — the first builtin namespace with sub-objects, so this
// also exercises nested bare-resolve on the JIT/AOT slow path.

// --- escape: the five HTML-unsafe characters ---
assert_eq(Encoding.html.escape("a & b"), "a &amp; b")
assert_eq(Encoding.html.escape("<p>"), "&lt;p&gt;")
assert_eq(Encoding.html.escape("\"quoted\""), "&quot;quoted&quot;")
assert_eq(Encoding.html.escape("it's"), "it&#39;s")
assert_eq(Encoding.html.escape("plain text"), "plain text")
// `&` is escaped first, so existing entities double-escape (round-trip safe).
assert_eq(Encoding.html.escape("&amp;"), "&amp;amp;")

// --- unescape: named references ---
assert_eq(Encoding.html.unescape("Tom &amp; Jerry"), "Tom & Jerry")
assert_eq(Encoding.html.unescape("&lt;p&gt;"), "<p>")
assert_eq(Encoding.html.unescape("&quot;hi&quot;"), "\"hi\"")
assert_eq(Encoding.html.unescape("it&#39;s &apos;ok&apos;"), "it's 'ok'")
assert_eq(Encoding.html.unescape("a&mdash;b&hellip;c"), "a—b…c")
assert_eq(Encoding.html.unescape("caf&eacute;"), "café")

// --- unescape: numeric references (decimal + hex, any case) ---
assert_eq(Encoding.html.unescape("&#65;&#66;&#67;"), "ABC")
assert_eq(Encoding.html.unescape("&#x41;&#X42;"), "AB")
assert_eq(Encoding.html.unescape("&#12354;&#x3042;"), "ああ")  // Japanese あ
assert_eq(Encoding.html.unescape("&#128512;"), "😀")           // astral plane

// --- unescape: leniency — anything not a well-formed ref is left verbatim ---
assert_eq(Encoding.html.unescape("a & b"), "a & b")
assert_eq(Encoding.html.unescape("&unknownent;"), "&unknownent;")
assert_eq(Encoding.html.unescape("&amp without semi"), "&amp without semi")
assert_eq(Encoding.html.unescape("&#bad;"), "&#bad;")
assert_eq(Encoding.html.unescape("&#x;"), "&#x;")
assert_eq(Encoding.html.unescape(""), "")

// --- round trip: escape then unescape restores the original ---
let original = "5 < 10 && \"x\" > 'y' & z"
assert_eq(Encoding.html.unescape(Encoding.html.escape(original)), original)

// --- first-class value: bound sub-namespace (slow-path conformance) ---
let h = Encoding.html
assert_eq(h.unescape("&nbsp;").size(), 2)  // U+00A0 is 2 UTF-8 bytes
assert_eq(h.escape("<&>"), "&lt;&amp;&gt;")

// --- the whole Encoding namespace is addressable as a value ---
let enc = Encoding
assert_eq(enc.html.unescape("&copy;"), "©")

// --- base64 (RFC 4648, standard alphabet + `=` padding) ---
assert_eq(Encoding.base64.encode("user:pass"), "dXNlcjpwYXNz")
assert_eq(Encoding.base64.encode(""), "")
assert_eq(Encoding.base64.encode("a"), "YQ==")    // 1 byte → 2 pad
assert_eq(Encoding.base64.encode("ab"), "YWI=")   // 2 bytes → 1 pad
assert_eq(Encoding.base64.encode("abc"), "YWJj")  // 3 bytes → no pad
assert_eq(Encoding.base64.decode("dXNlcjpwYXNz"), "user:pass")
assert_eq(Encoding.base64.decode("YQ=="), "a")
assert_eq(Encoding.base64.decode(""), "")
// round trip, binary-safe (multi-byte UTF-8 survives)
let bin = "hello, 世界! \n\t"
assert_eq(Encoding.base64.decode(Encoding.base64.encode(bin)), bin)
// whitespace in encoded input is tolerated (wrapped base64)
assert_eq(Encoding.base64.decode("dXNlcjpw\nYXNz"), "user:pass")
// invalid characters → ValueError
let b64bad = try {
  Encoding.base64.decode("!!!!")
  nil
} catch e {
  e.kind
}
assert_eq(b64bad, "ValueError")
// bound sub-namespace as a value
let b = Encoding.base64
assert_eq(b.decode(b.encode("xyz")), "xyz")

// --- hex (lower-case, two digits per byte) ---
assert_eq(Encoding.hex.encode("abc"), "616263")
assert_eq(Encoding.hex.encode(""), "")
assert_eq(Encoding.hex.encode("\x00\xff"), "00ff")  // full byte range
assert_eq(Encoding.hex.decode("616263"), "abc")
assert_eq(Encoding.hex.decode("00FF"), "\x00\xff")  // upper-case digits ok
assert_eq(Encoding.hex.decode(""), "")
// round trip, binary-safe (multi-byte UTF-8 survives)
assert_eq(Encoding.hex.decode(Encoding.hex.encode(bin)), bin)
// odd length → ValueError
let hexodd = try {
  Encoding.hex.decode("abc")
  nil
} catch e {
  e.kind
}
assert_eq(hexodd, "ValueError")
// non-hex character → ValueError
let hexbad = try {
  Encoding.hex.decode("zz")
  nil
} catch e {
  e.kind
}
assert_eq(hexbad, "ValueError")

// --- url (RFC 3986 percent-encoding; unreserved A-Za-z0-9-_.~ kept) ---
assert_eq(Encoding.url.encode("a b"), "a%20b")  // space → %20, not +
assert_eq(Encoding.url.encode("a+b=c&d"), "a%2Bb%3Dc%26d")
assert_eq(Encoding.url.encode("foo-_.~"), "foo-_.~")  // unreserved untouched
assert_eq(Encoding.url.encode("café"), "caf%C3%A9")  // UTF-8 bytes percent-encoded
assert_eq(Encoding.url.decode("a%20b"), "a b")
assert_eq(Encoding.url.decode("caf%C3%A9"), "café")
assert_eq(Encoding.url.decode("%6a%6B"), "jk")  // either hex case
// lenient: a malformed `%` and a literal `+` are left verbatim (round-trips)
assert_eq(Encoding.url.decode("100%"), "100%")
assert_eq(Encoding.url.decode("%zz"), "%zz")
assert_eq(Encoding.url.decode("a+b"), "a+b")
// round trip
let q = "name=José Pérez & co. (50%)"
assert_eq(Encoding.url.decode(Encoding.url.encode(q)), q)

// --- utf16 (a byte-order mark picks the order, big-endian without one) ---
let u16 = Encoding.utf16.encode("héllo")
assert_eq(Encoding.hex.encode(u16), "006800e9006c006c006f")
assert_eq(Encoding.utf16.decode(u16), "héllo")
// a code point past the BMP is a surrogate pair
assert_eq(Encoding.hex.encode(Encoding.utf16.encode("😀")), "d83dde00")
assert_eq(Encoding.utf16.decode(Encoding.hex.decode("d83dde00")), "😀")
// the mark: written only when asked for, read either way, dropped
assert_eq(
  Encoding.hex.encode(Encoding.utf16.encode("a", bom: true)),
  "feff0061",
)
assert_eq(Encoding.utf16.decode(Encoding.hex.decode("feff0061")), "a")
assert_eq(Encoding.utf16.decode(Encoding.hex.decode("fffe6100e900")), "aé")
assert_eq(Encoding.utf16.decode(Encoding.hex.decode("fffe3dd800de")), "😀")
assert_eq(Encoding.utf16.decode(""), "")
assert_eq(Encoding.utf16.encode(""), "")
// round trip through every plane the test text touches
let text = "日本語 and ASCII, an é, a 😀, a 𝄞"
assert_eq(Encoding.utf16.decode(Encoding.utf16.encode(text)), text)
assert_eq(Encoding.utf16.decode(Encoding.utf16.encode(text, bom: true)), text)
// what is wrong, and where
fn u16err(thunk) {
  try {
    thunk()
    "NO ERROR"
  } catch e {
    "{e.kind}: {e.message}"
  }
}
assert_eq(
  u16err(|| Encoding.utf16.decode("abc")),
  "ValueError: Encoding.utf16.decode: odd length (3 bytes)",
)
assert_eq(
  u16err(|| Encoding.utf16.decode(Encoding.hex.decode("0061d83d0062"))),
  "ValueError: Encoding.utf16.decode: a surrogate without its pair at byte 2",
)
assert_eq(
  u16err(|| Encoding.utf16.decode(Encoding.hex.decode("00610062dc00"))),
  "ValueError: Encoding.utf16.decode: a surrogate without its pair at byte 4",
)
assert_eq(
  u16err(|| Encoding.utf16.decode(Encoding.hex.decode("d83d"))),
  "ValueError: Encoding.utf16.decode: a surrogate without its pair at byte 0",
)
assert_eq(
  u16err(|| Encoding.utf16.encode(String.from_bytes([97, 255]))),
  "ValueError: Encoding.utf16.encode: not UTF-8 at byte 1",
)

inspect("test_encoding ok")
