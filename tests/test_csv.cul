// CSV namespace: parse / stringify (RFC 4180-ish). The logic is shared
// between the interp and the JIT slow-path adapters via csv.h, so this also
// exercises bare-resolve + as-value dispatch on the JIT/AOT slow path.

// --- basic parse: rows of String fields ---
let rows = CSV.parse("a,b,c\n1,2,3")
assert_eq(rows.size(), 2)
assert_eq(rows[0], ["a", "b", "c"])
assert_eq(rows[1], ["1", "2", "3"])

// --- round trip ---
assert_eq(CSV.stringify(CSV.parse("a,b,c\n1,2,3")), "a,b,c\n1,2,3")

// --- quoting: comma / quote / newline inside a field ---
let q = CSV.parse("\"a,b\",\"he said \"\"hi\"\"\",\"x\ny\"")
assert_eq(q[0][0], "a,b")
assert_eq(q[0][1], "he said \"hi\"")
assert_eq(q[0][2], "x\ny")
// re-serialize quotes the same fields back
assert_eq(CSV.stringify(q), "\"a,b\",\"he said \"\"hi\"\"\",\"x\ny\"")

// --- empty fields and empty input ---
assert_eq(CSV.parse("a,,c")[0], ["a", "", "c"])
assert_eq(CSV.parse("").size(), 0)
// trailing newline does not add an empty final row
assert_eq(CSV.parse("a\n").size(), 1)

// --- CRLF line endings ---
let cr = CSV.parse("a,b\r\nc,d")
assert_eq(cr.size(), 2)
assert_eq(cr[1], ["c", "d"])

// --- stringify coerces non-string scalars via to_string ---
assert_eq(CSV.stringify([[1, 2], [3, 4]]), "1,2\n3,4")
assert_eq(CSV.stringify([["x", true, 1.5]]), "x,true,1.5")
// a field needing quotes is quoted
assert_eq(CSV.stringify([["a,b", "c"]]), "\"a,b\",c")

// --- binary-safe: embedded NUL is an ordinary field byte (parse + stringify) ---
let b = CSV.parse("a\x00b,c")
assert_eq(b[0][0].size(), 3)
assert_eq(CSV.stringify([["a\x00b", "c"]]), "a\x00b,c")
assert_eq(CSV.stringify([["a\x00b", "c"]]).size(), 5)

// --- custom delimiter (TSV) via the `delimiter:` option (kwarg or positional) ---
let tsv = CSV.parse("a\tb\tc\n1\t2\t3", delimiter: "\t")
assert_eq(tsv[0], ["a", "b", "c"])
assert_eq(tsv[1], ["1", "2", "3"])
assert_eq(
  CSV.stringify([["a", "b"], ["c", "d"]], delimiter: "\t"),
  "a\tb\nc\td",
)
// positional form works too (delimiter is not keyword-only)
assert_eq(CSV.parse("x;y", ";")[0], ["x", "y"])
// a field containing the chosen delimiter gets quoted; comma is plain in TSV
assert_eq(CSV.stringify([["a\tb", "c,d"]], delimiter: "\t"), "\"a\tb\"\tc,d")
// round trip with a custom delimiter
assert_eq(
  CSV.parse(CSV.stringify([["p", "q"]], delimiter: ";"), delimiter: ";")[0],
  ["p", "q"],
)

// --- errors: non-String to parse, non-Array to stringify, non-Array row ---
assert_throws("TypeError", fn () {
  CSV.parse(42)
})
assert_throws("TypeError", fn () {
  CSV.stringify("nope")
})
assert_throws("TypeError", fn () {
  CSV.stringify([1, 2])
})

// --- first-class value + higher-order (slow-path conformance) ---
let p = CSV.parse
assert_eq(p("x,y")[0], ["x", "y"])
// (CSV.parse now has an optional `delimiter` param, so wrap it for map —
// the callback-arity check wants an exact 1-parameter function.)
let docs = ["a,b", "c,d"]
let parsed = docs.map(fn (d) {
  CSV.parse(d)
})
assert_eq(parsed[0][0], ["a", "b"])
assert_eq(parsed[1][0], ["c", "d"])

// --- header: true → Array of Objects keyed by the first row ---
let hdata = "name,age\nalice,30\nbob,25"
let hrows = CSV.parse(hdata, header: true)
assert_eq(hrows.size(), 2)
assert_eq(hrows[0]["name"], "alice")
assert_eq(hrows[0]["age"], "30")  // String without types:
assert_eq(hrows[1]["name"], "bob")
// a header with no data rows yields an empty Array; empty input too
assert_eq(CSV.parse("name,age", header: true), [])
assert_eq(CSV.parse("", header: true), [])

// --- types: coerce named columns; others stay String ---
let tdata = "name,age,score,active\nalice,30,95.5,true\nbob,25,88,false"
let trows = CSV.parse(
  tdata,
  header: true,
  types: {age: "Long", score: "Float", active: "Bool"},
)
assert_eq(trows[0]["age"], 30)
assert_eq(trows[0]["score"], 95.5)
assert_eq(trows[0]["active"], true)
assert_eq(trows[0]["name"], "alice")  // unlisted → String
assert_eq(trows[1]["active"], false)
assert_eq(trows[0]["age"] + 1, 31)  // genuinely a Long

// declared String preserves leading zeros (no number inference)
let z = CSV.parse(
  "id,zip\n7,01234",
  header: true,
  types: {id: "Long", zip: "String"},
)
assert_eq(z[0]["zip"], "01234")
assert_eq(z[0]["id"], 7)

// --- error paths (identical kind + message across interp/JIT/AOT) ---
let e1 = try {
  CSV.parse(tdata, types: {age: "Long"})
  nil
} catch e {
  e
}
assert_eq(e1.kind, "TypeError")
assert_eq(e1.message, "CSV.parse: types requires header: true")

let e2 = try {
  CSV.parse(tdata, header: true, types: {age: "Lnog"})
  nil
} catch e {
  e
}
assert_eq(e2.kind, "ValueError")
assert_eq(
  e2.message,
  "CSV.parse: unknown type 'Lnog' for column 'age' (valid: String, Long, Float, Bool)",
)

let e3 = try {
  CSV.parse(tdata, header: true, types: {nope: "Long"})
  nil
} catch e {
  e
}
assert_eq(e3.kind, "ValueError")
assert_eq(e3.message, "CSV.parse: types references unknown column 'nope'")

let e4 = try {
  CSV.parse("x\nhello", header: true, types: {x: "Long"})
  nil
} catch e {
  e
}
assert_eq(e4.kind, "ValueError")
assert_eq(
  e4.message,
  "CSV.parse: row 2, column 'x': expected Long, got 'hello'",
)

let e5 = try {
  CSV.parse("a,a\n1,2", header: true)
  nil
} catch e {
  e
}
assert_eq(e5.kind, "ValueError")
assert_eq(e5.message, "CSV.parse: duplicate header column 'a'")

let e6 = try {
  CSV.parse("a,b\n1", header: true)
  nil
} catch e {
  e
}
assert_eq(e6.kind, "ValueError")
assert_eq(e6.message, "CSV.parse: row 2 has 1 fields, but the header has 2")

// types: must be an Object of String
let e7 = try {
  CSV.parse(tdata, header: true, types: "nope")
  nil
} catch e {
  e
}
assert_eq(e7.kind, "TypeError")
assert_eq(e7.message, "CSV.parse: types must be an Object of String")

// header: is a typed Bool param — a non-Bool is the binder's typed-param error
// (interp/JIT must agree on the exact wording, kwarg form included)
let e8 = try {
  CSV.parse(tdata, header: 5)
  nil
} catch e {
  e
}
assert_eq(e8.kind, "TypeError")
assert_eq(e8.message, "type error: parameter 'header' expects Bool")

inspect("csv tests passed")
