# Internal runtime errors are surfaced to user `try/catch` as
# structured Error Objects: `{kind, message, line, col}`.
# Each case here pins the expected `kind` for one of the throw sites
# converted in shared.h / interpreter.h / tensor.h / stdlib_interp.h.

let expect = fn (label: String, kind: String, e) {
  if e.kind == kind {
    puts("  PASS [{label}] {kind}")
  } else {
    puts("  FAIL [{label}] expected {kind} got {e.kind}: {e.message}")
  }
}

puts("== runtime error catch tests ==")

# --- TypeError ---
let r1 = try { let _ = 'a' < 1; nil } catch e { e }
expect('compare String<Long', 'TypeError', r1)

let r2 = try { let _ = 1 + 'b'; nil } catch e { e }
expect("arith Long+String", 'TypeError', r2)

# --- ZeroDivisionError ---
let r3 = try { let _ = 1 / 0; nil } catch e { e }
expect('1/0 Long', 'ZeroDivisionError', r3)

let r4 = try { let _ = 1.0 / 0.0; nil } catch e { e }
expect('1.0/0.0 Float', 'ZeroDivisionError', r4)

let r5 = try { let _ = 1 % 0; nil } catch e { e }
expect('1%0', 'ZeroDivisionError', r5)

# Note: NameError ("undefined variable") and ShadowError are detected
# at compile time on both backends — the whole module is rejected
# before any `try` block runs, so user code cannot catch them.

# --- IndexError ---
let r7 = try { let a = [1, 2, 3]; let _ = a[10]; nil } catch e { e }
expect('arr[10]', 'IndexError', r7)

# --- DropContractError ---
let r9 = try { let _ = { drop: 42 }; nil } catch e { e }
expect('drop=42', 'DropContractError', r9)

let r10 = try { let _ = { drop: fn (x) { x } }; nil } catch e { e }
expect('drop with arg', 'DropContractError', r10)

# Note: ImmutableError on plain variables is interp-only — JIT does not
# track per-variable mutability. ImmutableError on object properties
# fires on both backends (covered by `o.b += 1` cases nearby).

# Subscript-set on an immutable shape slot raises ImmutableError —
# verifies the K unification surfaces the mut check on both backends.
let r11b = try {
  let o = {x: 1}
  o['x'] = 2
  nil
} catch e { e }
expect("obj['x']= on immutable", 'ImmutableError', r11b)

# Compound subscript-set on a missing key raises KeyError on both
# backends (interp's `obj.has(key)` precondition + JIT's object_get_any
# throw match up).
let r11c = try {
  mut o = {mut a: 1}
  o['missing'] += 1
  nil
} catch e { e }
expect("obj['k']+= on missing", 'KeyError', r11c)

# Compound subscript-set on an immutable shape slot raises
# ImmutableError — the write back via object_set_any honors mut.
let r11d = try {
  let o = {x: 1}
  o['x'] += 1
  nil
} catch e { e }
expect("obj['x']+= on immutable", 'ImmutableError', r11d)

# Subscript-set on an immutable Tuple-keyed sidecar slot also raises
# ImmutableError — exercises the throw path of object_set_any that
# now also releases the caller's +1 to the key.
let r11e = try {
  let m = {(1, 2): 10}
  m[(1, 2)] = 20
  nil
} catch e { e }
expect("obj[(1,2)]= on immutable", 'ImmutableError', r11e)

# --- ValueError ---
let r12 = try { let _ = [].min(); nil } catch e { e }
expect('empty Array.min', 'ValueError', r12)

# JSON.parse errors carry the JSON-internal line:col (1-based, within
# the parsed string — not the caller's source line). The structured
# Error exposes the position via e.line / e.col.
let r_json = try { JSON.parse('{"a": ,}'); nil } catch e { e }
expect('JSON.parse bad value', 'ValueError', r_json)
if r_json.line != 1 || r_json.col != 7 {
  puts("  FAIL [JSON.parse line:col] expected 1:7 got {r_json.line}:{r_json.col}")
} else {
  puts('  PASS [JSON.parse line:col] 1:7')
}

# JSON.stringify(lines: true) requires Array/Tuple/Set
let r_json2 = try { JSON.stringify({a: 1}, lines: true); nil } catch e { e }
expect('lines on Object', 'TypeError', r_json2)

# lines + indent is incompatible
let r_json3 = try {
  JSON.stringify([1, 2], lines: true, indent: 2)
  nil
} catch e { e }
expect('lines+indent', 'TypeError', r_json3)

# Note: `o.b += 1` on a missing property yields different kinds across
# backends — interp explicitly checks `obj.has(name)` and throws
# AttributeError, JIT reads `o.b` as nil and then raises TypeError on
# `nil + 1`. Both are catchable; the kind differs.

# --- AssertionError ---
let r14 = try { assert(false); nil } catch e { e }
expect('assert false', 'AssertionError', r14)

# --- Runtime helpers (throwing stdlib functions) ---
# Verify the JIT sweep that routes runtime-helper calls through the
# landingpad: Math.pow with a negative exp, to_long on bad input,
# Random.int with hi <= lo all surface to user catch as TypeError.
let r_pow = try { Math.pow(2, -1); nil } catch e { e }
expect('Math.pow(2, -1)', 'TypeError', r_pow)

let r_tolong = try { to_long('not a number'); nil } catch e { e }
expect('to_long bad input', 'TypeError', r_tolong)

let r_rand = try { Random.int(5, 1); nil } catch e { e }
expect('Random.int hi<=lo', 'TypeError', r_rand)

# --- structure introspection: fields are usable ---
puts("== field introspection ==")
let e_ = try { let _ = 1 / 0; nil } catch e { e }
assert(e_.kind == 'ZeroDivisionError')
assert(e_.message != '')
assert(e_.line > 0)   # location is attached by eval() wrapper
assert(e_.col > 0)
puts('  PASS fields populated')

# --- user `throw expr` is unaffected ---
let r15 = try { throw 'plain string'; nil } catch e { e }
assert(type_of(r15) == 'String' && r15 == 'plain string')
puts('  PASS user throw untouched')

# --- catch can re-throw the structured error ---
let r16 = try {
  try { let _ = 1 / 0; nil } catch e { throw e }
} catch outer {
  outer.kind
}
assert(r16 == 'ZeroDivisionError')
puts('  PASS rethrow preserves kind')

puts('test_runtime_errors: OK')
