# A HOF callback that mutates the receiver walks the *live* array: the size
# is re-read every step, so the walk ends where the array ends. This is the
# same rule `for x in a` already followed, now shared by every array HOF on
# every backend.
#
# The interp used to range-for over the live std::vector, which is undefined
# behaviour once the callback mutates it: `pop` left the walk reading
# destroyed slots (it looked like a full run over the original elements) and
# `push` reallocated the backing store out from under the iterators, which
# surfaced as corrupted values. The JIT's inlined loops read the size once
# and threw IndexError instead, while its runtime-helper path already
# re-read. Four paths, three behaviours — now one.
#
# Run with:  ./build/culebra tests/test_hof_receiver_mutation.cul
#            ./build/culebra --jit tests/test_hof_receiver_mutation.cul

# --- shrinking: the walk stops at the live end -----------------------------
# [1,2,3,4] popping one per step: i=0 sees 1 (size 4), i=1 sees 2 (size 3),
# then i=2 is past the size-2 array, so the walk ends.
fn seen_forin() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  for x in a {
    seen.push(x)
    a.pop()
  }
  seen
}
assert_eq(seen_forin(), [1, 2])

fn seen_for_each() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  a.for_each(fn (x) {
    seen.push(x)
    a.pop()
  })
  seen
}
assert_eq(seen_for_each(), [1, 2])

fn seen_map() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  a.map(fn (x) {
    seen.push(x)
    a.pop()
    x
  })
  seen
}
assert_eq(seen_map(), [1, 2])

fn seen_filter() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  a.filter(fn (x) {
    seen.push(x)
    a.pop()
    true
  })
  seen
}
assert_eq(seen_filter(), [1, 2])

fn seen_reduce() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  a.reduce(0, fn (acc, x) {
    seen.push(x)
    a.pop()
    acc
  })
  seen
}
assert_eq(seen_reduce(), [1, 2])

fn seen_find() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  a.find(fn (x) {
    seen.push(x)
    a.pop()
    false
  })
  seen
}
assert_eq(seen_find(), [1, 2])

fn seen_any() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  a.any(fn (x) {
    seen.push(x)
    a.pop()
    false
  })
  seen
}
assert_eq(seen_any(), [1, 2])

fn seen_all() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  a.all(fn (x) {
    seen.push(x)
    a.pop()
    true
  })
  seen
}
assert_eq(seen_all(), [1, 2])

fn seen_flat_map() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  a.flat_map(fn (x) {
    seen.push(x)
    a.pop()
    [x]
  })
  seen
}
assert_eq(seen_flat_map(), [1, 2])

# The reduce case from the original report: the accumulator sees the values
# popped during the walk, and the walk itself still ends at the live end.
fn reduce_result() {
  mut a = [1, 2, 3, 4]
  a.reduce([0, 0], |acc, x| [acc[0] + a.pop(), acc[1]])
}
assert_eq(reduce_result(), [7, 0])

# --- the callback is bound to a variable (runtime-helper path) -------------
fn seen_for_each_bound() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  let cb = fn (x) {
    seen.push(x)
    a.pop()
  }
  a.for_each(cb)
  seen
}
assert_eq(seen_for_each_bound(), [1, 2])

fn seen_reduce_bound() {
  mut a = [1, 2, 3, 4]
  mut seen = []
  let cb = fn (acc, x) {
    seen.push(x)
    a.pop()
    acc
  }
  a.reduce(0, cb)
  seen
}
assert_eq(seen_reduce_bound(), [1, 2])

# --- growing: the walk follows the array as it grows -----------------------
# Reallocation during the walk used to corrupt the interp's values.
fn grow_for_each() {
  mut a = [1, 2]
  mut seen = []
  mut n = 0
  a.for_each(fn (x) {
    seen.push(x)
    n = n + 1
    a.push(100 + n) if n < 20
  })
  [n, seen.size(), a.size()]
}
assert_eq(grow_for_each(), [21, 21, 21])

fn grow_forin() {
  mut a = [1, 2]
  mut n = 0
  for x in a {
    n = n + 1
    a.push(100 + n) if n < 20
  }
  [n, a.size()]
}
assert_eq(grow_forin(), [21, 21])

# --- untouched receivers behave exactly as before --------------------------
assert_eq([1, 2, 3].map(|x| x * 2), [2, 4, 6])
assert_eq([1, 2, 3].filter(|x| x > 1), [2, 3])
assert_eq([1, 2, 3].reduce(0, |a, x| a + x), 6)
assert_eq([1, 2, 3].find(|x| x == 2), 2)
assert_eq([1, 2, 3].any(|x| x == 3), true)
assert_eq([1, 2, 3].all(|x| x > 0), true)
assert_eq([1, 2].flat_map(|x| [x, x]), [1, 1, 2, 2])

# Tuples are immutable and the Set walk uses a private copy, so re-reading
# the size cannot change what they visit.
mut tseen = []
for x in (1, 2, 3) {
  tseen.push(x)
}
assert_eq(tseen, [1, 2, 3])

mut sseen = []
for x in {1, 2, 3} {
  sseen.push(x)
}
assert_eq(sseen.size(), 3)
