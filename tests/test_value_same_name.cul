# Two `@value` classes may share a name: one at the top level and one in a
# function, or one of the program's and one of the stdlib's. Each is laid out
# as its own declaration says, whichever was compiled last. (`Name.new(...)`
# throughout, not `Name(...)`: it is the spelling that is laid out in slots.)

import vsn_dep from './test_import_helpers/value_same_name_dep.cul'

@value
class VsnPoint {
  new(.x: Float) {}
  __add__(o) {
    VsnPoint.new(self.x + o.x)
  }
}

fn vsn_local_point() {
  @value
  class VsnPoint {
    new(.x: Float, .y: Float) {}
  }
  VsnPoint.new(7.0, 8.0).y
}

# --- 1) the fields: an instance of the outer class, built in slots and then
#        boxed, has the outer class's fields and no others
fn vsn_sum(sink) {
  let mut at = VsnPoint.new(1.0)
  at += VsnPoint.new(2.0)
  sink.push(at)
  at.x
}
let vsn_sink = []
assert_eq([vsn_local_point(), vsn_sum(vsn_sink)], [8.0, 3.0])
assert_eq(to_string(vsn_sink[0]), 'VsnPoint {x: 3.0}')

# --- 2) the field types: the outer `n` is a Float where the local one is a
#        Long, and each construction is checked against its own
#        (the constructors store by hand: an annotated field parameter is
#        checked as a parameter, and the field's own check is what is held)
@value
class VsnTyped {
  n: Float
  new(n) {
    self.n = n
  }
}

fn vsn_local_typed() {
  @value
  class VsnTyped {
    n: Long
    new(n) {
      self.n = n
    }
  }
  VsnTyped.new(7).n
}

fn vsn_outer_typed() {
  VsnTyped.new(1.5).n
}
assert_eq([vsn_local_typed(), vsn_outer_typed()], [7, 1.5])

# --- 3) the stdlib's: a function's own `Vector2` is its own, and `Vector2`
#        anywhere else is still the stdlib's
fn vsn_own_vector() {
  @value
  class Vector2 {
    new(.x: Float, .y: Float) {}
    length() {
      99.0
    }
  }
  Vector2.new(3.0, 4.0).length()
}

fn vsn_stdlib_vector() {
  Vector2.new(3.0, 4.0).length()
}
assert_eq([vsn_own_vector(), vsn_stdlib_vector()], [99.0, 5.0])

# --- 4) and across modules: an imported module's top-level `Vector2` is that
#        module's
assert_eq([vsn_dep.own_length(), vsn_stdlib_vector()], [99.0, 5.0])
