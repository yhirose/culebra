# sort_by / sorted_by take a keyword-only `reverse:` for a stable
# descending sort (Python's `sorted(reverse=True)`).

assert_eq([3, 1, 2].sorted_by(|x| x), [1, 2, 3])
assert_eq([3, 1, 2].sorted_by(|x| x, reverse: true), [3, 2, 1])
assert_eq([3, 1, 2].sorted_by(|x| x, reverse: false), [1, 2, 3])
assert_eq(["bb", "a", "ccc"].sorted_by(|s| s.size(), reverse: true),
          ["ccc", "bb", "a"])

# Stable: equal keys keep their original order even when reversed.
assert_eq([(1, "a"), (1, "b"), (0, "c")].sorted_by(|t| t[0], reverse: true),
          [(1, "a"), (1, "b"), (0, "c")])

# sort_by mutates in place; reverse: works there too.
mut a = [3, 1, 2]
a.sort_by(|x| x, reverse: true)
assert_eq(a, [3, 2, 1])

# An unknown keyword still raises (with the positional callback present).
mut k = nil
try { [1, 2].sorted_by(|x| x, bad: 1) } catch e { k = e.kind }
assert_eq(k, "TypeError")

# A plain builtin method still rejects any keyword.
mut k2 = nil
try { "abc".upper(x: 1) } catch e { k2 = e.kind }
assert_eq(k2, "TypeError")

IO.inspect("test_sorted_by_reverse OK")
