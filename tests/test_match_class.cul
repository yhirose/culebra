# Conformance: §13 (type patterns). See docs/language.md §25.
#
# `match v { x: ClassName => ... }` — type-pattern arms against
# user-defined classes. Works on both interp and JIT.

class Dog {
  new(name) {
    self.name = name
  }
}
class Cat {
  new(name) {
    self.name = name
  }
}
class Bird {
  new(name) {
    self.name = name
  }
}

let describe = fn (animal) {
  match animal {
    d: Dog => "dog: {d.name}",
    c: Cat => "cat: {c.name}",
    b: Bird => "bird: {b.name}",
    _ => "unknown",
  }
}

assert_eq(describe(Dog.new("Rex")), "dog: Rex")
assert_eq(describe(Cat.new("Mia")), "cat: Mia")
assert_eq(describe(Bird.new("Tweety")), "bird: Tweety")
assert_eq(describe("not an animal"), "unknown")
assert_eq(describe(42), "unknown")
assert_eq(describe(nil), "unknown")

# Type pattern + plain Object — Object matches even when class tag absent
let o = {x: 1}
let r = match o {
  obj: Object => "obj",
  _ => "?",
}
assert_eq(r, "obj")

# Type pattern with the same class name on a non-Object value falls through
let r2 = match 42 {
  x: Dog => "is dog",
  _ => "fallback",
}
assert_eq(r2, "fallback")

# Nested: array pattern with TYPED_IDENT inside
let pair_classify = fn (v) {
  match v {
    [x: Dog, _] => "first is dog: {x.name}",
    _ => "no",
  }
}
assert_eq(pair_classify([Dog.new("Buddy"), 99]), "first is dog: Buddy")
assert_eq(pair_classify([99, 100]), "no")
