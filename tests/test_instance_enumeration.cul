# Conformance: §10 (class sugar). See docs/language.md §25.
#
# A class instance is an ordinary Object carrying a `class:` String
# property plus its fields — methods live on the shared class meta and are
# NOT part of the instance. Every enumeration face must agree on that set:
# keys / size / to_string / for-in / spread / JSON.
#
# These are VALUE assertions on purpose. The interp-vs-JIT difftest only
# proves the two agree, so it would pass with both backends broken the
# same way.

fn test_keys_excludes_methods() {
  class P {
    new() { self.a = 1 }
    m() { 2 }
  }
  let p = P()
  assert_eq(p.keys(), ['class', 'a'])
  assert_eq(p.size(), 2)
  assert_eq(p.empty(), false)
}

fn test_keys_no_fields() {
  class Q {
    m() { 3 }
  }
  let q = Q()
  assert_eq(q.keys(), ['class'])
  assert_eq(q.size(), 1)
}

fn test_to_string_hoists_class_and_hides_methods() {
  class P {
    new() { self.a = 1 }
    m() { 2 }
  }
  assert_eq(P().to_string(), 'P {mut a: 1}')

  class Q {
    m() { 3 }
  }
  assert_eq(Q().to_string(), 'Q {}')
}

fn test_for_in_yields_class_and_fields() {
  class P {
    new() { self.a = 1; self.b = 2 }
    m() { 0 }
  }
  mut acc = []
  for k, v in P() { acc.push([k, v]) }
  assert_eq(acc, [['class', 'P'], ['a', 1], ['b', 2]])
}

fn test_spread_copies_class_and_fields_only() {
  class P {
    new() { self.a = 1 }
    m() { 2 }
  }
  let d = {...P()}
  assert_eq(d.keys(), ['class', 'a'])
  assert_eq(d.class, 'P')
  assert_eq(d.a, 1)
}

fn test_json_stringify_serializes_instance() {
  class P {
    new() { self.a = 1 }
    m() { 2 }
  }
  assert_eq(JSON.stringify(P()), '{"class":"P","a":1}')
}

fn test_methods_still_reachable() {
  class P {
    new() { self.a = 1 }
    m() { self.a + 1 }
    __str__() { 'custom' }
  }
  let p = P()
  assert_eq(p.m(), 2)
  # `has` resolves a class method (own slot, then the class meta) but not
  # a dict builtin.
  assert_true(p.has('m'))
  assert_true(p.has('a'))
  assert_true(!p.has('size'))
  # A method is not a data entry: `get`/subscript stay own-only.
  assert_eq(p.get('m', 'none'), 'none')
  assert_eq(p['class'], 'P')
  # `__str__` also lives on the meta and still wins over the formatter.
  assert_eq(p.to_string(), 'custom')
}

fn test_own_field_shadows_method() {
  class P {
    m() { 'method' }
  }
  mut p = P()
  p.m = 'field'
  assert_eq(p.m, 'field')
  assert_eq(p.keys(), ['class', 'm'])
  assert_eq(p.size(), 2)
}

fn test_instances_share_one_meta() {
  class P {
    new(a) { self.a = a }
    m() { self.a * 2 }
  }
  let x = P(1)
  let y = P(2)
  assert_eq(x.m(), 2)
  assert_eq(y.m(), 4)
  # Distinct fields, identical shape.
  assert_eq(x.keys(), y.keys())
  assert_true(x != y)
  assert_true(P(1) == P(1))
}

fn test_operator_and_call_specials_live_on_the_meta() {
  class V {
    new(n) { self.n = n }
    __add__(o) { V(self.n + o.n) }
    __call__(k) { self.n * k }
  }
  let a = V(1)
  let b = V(2)
  assert_eq((a + b).n, 3)
  assert_eq(a(10), 10)
  assert_eq((a + b).keys(), ['class', 'n'])
}

fn test_drop_runs_from_the_meta() {
  mut log = []
  fn run() {
    class R {
      new(t) { self.t = t }
      close() { log.push('close:' + self.t) }
      drop() { self.close() }
    }
    let r = R('a')
    assert_eq(r.keys(), ['class', 't'])
  }
  run()
  assert_eq(log, ['close:a'])
}

test_keys_excludes_methods()
test_keys_no_fields()
test_to_string_hoists_class_and_hides_methods()
test_for_in_yields_class_and_fields()
test_spread_copies_class_and_fields_only()
test_json_stringify_serializes_instance()
test_methods_still_reachable()
test_own_field_shadows_method()
test_instances_share_one_meta()
test_operator_and_call_specials_live_on_the_meta()
test_drop_runs_from_the_meta()

inspect('instance-enumeration OK')
