# Conformance: §17 (iterator protocol), §18. See docs/language.md §25.
#
# unzip, flatten, scan, distinct, tap, step_by, chunk_by, the
# unbounded-source laziness contract (second half), and chain/zip
# driving their receiver through the iterator protocol. Split from
# test_iter_combinators.cul (see that file's header for why).
#
# Run with:  ./build/culebra tests/test_iter_combinators_stream.cul
#            ./build/culebra --jit tests/test_iter_combinators_stream.cul

# --- unzip: the inverse of zip's {first, second} pairs ---------------------
# Duck-typed: a 2-element Tuple or an Object with first/second (what zip
# yields) are both accepted, so it inverts either pair convention.
assert_eq([(1, 'a'), (2, 'b'), (3, 'c')].unzip(), ([1, 2, 3], ['a', 'b', 'c']))
assert_eq([(1, 'a'), (2, 'b')].iter().unzip(), ([1, 2], ['a', 'b']))
assert_eq([].unzip(), ([], []))
assert_eq([].iter().unzip(), ([], []))
mut xs = nil
mut ys = nil
(xs, ys) = [1, 2, 3].iter().zip([10, 20, 30]).unzip()
assert_eq(xs, [1, 2, 3])
assert_eq(ys, [10, 20, 30])
# enumerate() yields (index, value) tuples — the same pair shape as a
# hand-written 2-tuple — so unzip inverts it too.
assert_eq(['p', 'q'].iter().enumerate().unzip(), ([0, 1], ['p', 'q']))
# Heterogeneous halves keep each element's own type.
assert_eq(
  [(1, 'x'), (true, 'y'), (1.5, 'z')].unzip(),
  ([1, true, 1.5], ['x', 'y', 'z']),
)
# An Object pair with extra keys still works — only first/second matter.
assert_eq([{first: 1, second: 2, extra: 3}].unzip(), ([1], [2]))
try {
  [1, 2, 3].unzip()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
  assert_eq(
    e.message,
    'type error: unzip expects (a, b) tuples or {first, second} objects',
  )
}
try {
  [(1, 2, 3)].unzip()  # wrong Tuple arity
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}
try {
  [{first: 1}].iter().unzip()  # Object missing `second`
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# --- flatten: one level of nesting removed ---------------------------------
assert_eq([[1, 2], [3], [], [4, 5]].iter().flatten().collect(), [1, 2, 3, 4, 5])
assert_eq([[[1]], [[2]]].iter().flatten().collect(), [[1], [2]])  # one level only
assert_eq([].iter().flatten().collect(), [])
# Any iterable inner works, including String and Set (same coercion flat_map uses)
assert_eq(['ab', 'cd'].iter().flatten().collect(), ['a', 'b', 'c', 'd'])
mut s1 = {1, 2}
assert_eq([s1, s1].iter().flatten().collect(), [1, 2, 1, 2])
assert_eq(['ab'].iter().flat_map(|s| s).collect(), ['a', 'b'])
try {
  [1, 2].iter().flatten().collect()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# --- scan: running fold, one output per input ------------------------------
assert_eq([1, 2, 3, 4].iter().scan(0, |a, x| a + x).collect(), [1, 3, 6, 10])
assert_eq([1, 2, 3].iter().scan(1, |a, x| a * x).collect(), [1, 2, 6])
assert_eq(['a', 'b'].iter().scan('', |a, x| a + x).collect(), ['a', 'ab'])
assert_eq([].iter().scan(0, |a, x| a + x).collect(), [])  # init is not yielded
try {
  [1].iter().scan(0, |x| x).collect()
  assert_true(false)
} catch e {
  assert_eq(e.message, "type error: scan expects a 2-parameter function")
}

# --- distinct: first occurrence wins ---------------------------------------
assert_eq([1, 2, 2, 3, 1, 2].iter().distinct().collect(), [1, 2, 3])
assert_eq(['b', 'a', 'b'].iter().distinct().collect(), ['b', 'a'])
assert_eq([].iter().distinct().collect(), [])
# Same key identity as to_set / Object keys: these three stay distinct.
assert_eq([1, 1.0, true].iter().distinct().collect().size(), 3)
try {
  [[1], [1]].iter().distinct().collect()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# --- tap: side effect, element passes through unchanged ---------------------
mut tapped = []
assert_eq([1, 2, 3].iter().tap(fn (x) {
  tapped.push(x)
}).map(|x| x * 10).collect(), [10, 20, 30])
assert_eq(tapped, [1, 2, 3])
# Lazy: only the pulled elements run the callback.
mut probed = []
assert_eq(range(100).tap(fn (x) {
  probed.push(x)
}).take(3).collect(), [0, 1, 2])
assert_eq(probed, [0, 1, 2])

# --- step_by: first element, then every n-th --------------------------------
assert_eq(range(10).step_by(3).collect(), [0, 3, 6, 9])
assert_eq([10, 20, 30, 40, 50].iter().step_by(2).collect(), [10, 30, 50])
assert_eq([1, 2, 3].iter().step_by(1).collect(), [1, 2, 3])
assert_eq([1, 2].iter().step_by(9).collect(), [1])  # first still yielded
assert_eq([].iter().step_by(2).collect(), [])
try {
  [1].iter().step_by(0).collect()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}

# --- chunk_by: ADJACENT elements only --------------------------------------
# A key that reappears after a different one starts a NEW run -- this is what
# separates it from group_by, which buckets by key regardless of position.
assert_eq(
  [1, 1, 2, 2, 2, 1].iter().chunk_by(|x| x).collect(),
  [[1, 1], [2, 2, 2], [1]],
)
assert_eq([1, 1, 2, 2, 2, 1].group_by(|x| x)[1], [1, 1, 1])  # contrast
assert_eq([1, 2, 3].iter().chunk_by(|x| x).collect(), [[1], [2], [3]])
assert_eq([1, 1, 1].iter().chunk_by(|x| x).collect(), [[1, 1, 1]])
assert_eq([].iter().chunk_by(|x| x).collect(), [])
assert_eq(
  ['aa', 'ab', 'bc'].iter().chunk_by(|s| s[0..1]).collect(),
  [['aa', 'ab'], ['bc']],
)

# --- all six stream an unbounded source ------------------------------------
fn naturals2() {
  mut n = 0
  {
    has_next: fn () {
      true
    },
    next: fn () {
      n = n + 1
      n - 1
    },
  }
}
assert_eq(naturals2().scan(0, |a, x| a + x).take(5).collect(), [0, 1, 3, 6, 10])
assert_eq(naturals2().step_by(4).take(3).collect(), [0, 4, 8])
assert_eq(naturals2().map(|x| x % 3).distinct().take(3).collect(), [0, 1, 2])
assert_eq(
  naturals2().chunk_by(|x| x / 3).take(2).collect(),
  [[0, 1, 2], [3, 4, 5]],
)
assert_eq(naturals2().map(|x| [x]).flatten().take(3).collect(), [0, 1, 2])

# --- chain/zip drive their RECEIVER through the protocol -------------------
# The name only resolves on an iterator-shaped Object, so the receiver already
# IS an iterator: asking it for an `iter()` instead walks something else
# entirely when it defines both. The ARGUMENT is still coerced, which is what
# lets `chain([1, 2])` take a raw Array.
class BothWays {
  n: Long
  new() { self.n = 0 }
  iter() { [7, 8].iter() }
  has_next() { self.n < 2 }
  next() { self.n = self.n + 1; self.n }
}
assert_eq(BothWays.new().chain([9]).collect(), [1, 2, 9])
assert_eq(BothWays.new().take(2).collect(), [1, 2])
assert_eq(BothWays.new().zip([9, 9]).count(), 2)
assert_eq([1].iter().chain(BothWays.new()).collect(), [1, 7, 8])

# An Object with no `iter` of its own is walked by the dict builtin — (key,
# value) pairs — rather than rejected as non-iterable.
class Counter {
  n: Long
  new() { self.n = 0 }
  has_next() { self.n < 2 }
  next() { self.n = self.n + 1; self.n }
}
assert_eq(
  [1].iter().chain(Counter.new()).collect(),
  [1, ('class', 'Counter'), ('n', 0)],
)
assert_eq(
  [Counter.new()].iter().flatten().collect(),
  [('class', 'Counter'), ('n', 0)],
)
assert_eq([1].iter().chain({'a': 1}).collect(), [1, ('a', 1)])
