// Conformance: built-in Hashable trait.
// `Hashable { hash() -> Long }` — primitives conform via the
// hard-coded table; user classes via structural conformance
// (`fn hash()` + `fn eq(other)` for Object key use).

// --- Built-in: every hashable primitive satisfies Hashable ---
// Use the global `hash(v)` builtin — primitives don't carry callable
// methods, so the trait body goes through the free function (same
// pattern as `to_string` for Stringer).
fn h(x: Hashable) -> Long {
  hash(x)
}

// Primitives produce a stable hash (same input -> same value).
assert_eq(h(42), h(42))
assert_eq(h("abc"), h("abc"))
assert_eq(h(3.14), h(3.14))
assert_eq(h(true), h(true))
assert_eq(h(nil), h(nil))
assert_eq(h((1, 2)), h((1, 2)))

// Cross-flavor: String / StringView with same bytes hash equally.
let s = "hello"
let v = s.view()
assert_eq(h(s), h(v))

// Numeric collapse: 1 / 1.0 / true share a hash bucket (Python dict).
assert_eq(h(1), h(1.0))
assert_eq(h(true), h(1))

// --- Unhashable primitives: rejected as Hashable param ---
let e_arr = try {
  h([1, 2, 3])
  nil
} catch e {
  e
}
assert_eq(e_arr.kind, "DispatchError")
let e_obj = try {
  h({a: 1})
  nil
} catch e {
  e
}
assert_eq(e_obj.kind, "DispatchError")

// --- User class: structural conformance via hash() + eq() ---
class Point {
  new(x, y) {
    self.x = x
    self.y = y
  }
  hash() {
    self.x * 31 + self.y
  }
  eq(other) {
    self.x == other.x && self.y == other.y
  }
}

let p = Point.new(1, 2)
assert_eq(h(p), 33)

// User Hashable + Eq class works as Object key.
mut bag = {}
mut bag[Point.new(1, 2)] = "a"
mut bag[Point.new(3, 4)] = "b"
assert_eq(bag[Point.new(1, 2)], "a")
assert_eq(bag[Point.new(3, 4)], "b")
assert_eq(bag.size(), 2)

// Same-content keys collide (single entry retained).
mut single = {}
mut single[Point.new(5, 6)] = "first"
single[Point.new(5, 6)] = "second"
assert_eq(single.size(), 1)
assert_eq(single[Point.new(5, 6)], "second")

// Set with user class.
mut s2 = Set(Point.new(1, 1), Point.new(2, 2))
s2.add(Point.new(1, 1))  // duplicate -> no growth
s2.add(Point.new(3, 3))
assert_eq(s2.size(), 3)

// --- User class without hash() ---
class Naked {
  new(v) {
    self.v = v
  }
}

// Rejected as Hashable param.
let e_naked = try {
  h(Naked.new(0))
  nil
} catch e {
  e
}
assert_eq(e_naked.kind, "DispatchError")

// Rejected as Object key.
mut bag2 = {}
let e_key = try {
  bag2[Naked.new(0)] = 1
  nil
} catch e {
  e
}
assert_eq(e_key.kind, "TypeError")

// NaN is one key, where `==` says it equals nothing: a key has to be itself
// to be found again. Whatever its sign bit, and inside a Tuple too.
let nan = Math.nan
let nan2 = -nan
assert_eq(nan == nan, false)
assert_eq(h(nan), h(nan2))
mut by_nan = {}
by_nan[nan] = 1
by_nan[nan2] = 2
by_nan[(nan, 1)] = "a"
by_nan[(nan2, 1)] = "b"
assert_eq(by_nan.size(), 2)
assert_eq(by_nan[nan], 2)
assert_eq(by_nan[(nan, 1)], "b")
assert_true(by_nan.has(nan))
assert_eq(by_nan.get(nan, 0), 2)
by_nan.remove(nan)
assert_eq(by_nan.size(), 1)
assert_eq([nan, nan2, 1.0].to_set().size(), 2)
assert_true([nan].to_set().contains(nan2))
assert_true([nan].to_set() == [nan2].to_set())
assert_eq([nan, 1.0, nan2].iter().distinct().count(), 2)
mut frozen_src = {}
frozen_src[nan] = "s"
assert_eq(Shared.new(frozen_src)[nan2], "s")
// An Array asks `==`, so it does not find one.
assert_eq([nan].contains(nan), false)
// A derived `eq` matches fields as keys, so two instances holding NaN are one
// key, while `==` compares the fields by `==`.
@derive(Eq, Hash)
class Reading {
  new(.value) {}
}
mut readings = {}
readings[Reading(nan)] = 1
readings[Reading(nan2)] = 2
assert_eq(readings.size(), 1)
assert_eq(Reading(nan) == Reading(nan2), false)
// 0.0 and -0.0 are one key as well, and they are `==`.
mut zeros = {}
zeros[0.0] = "a"
zeros[-0.0] = "b"
assert_eq(zeros.size(), 1)

// (Cross-flavor Object key unification: String and StringView still
// land in different slots due to the dual Shape/sidecar Object storage.
// See `docs/language.md` / project memory `string-stringview` for the
// recommended `.to_string()` materialization.)

IO.inspect("test_hashable OK")
