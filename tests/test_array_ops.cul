// Array concatenation and position-addressed mutation: `a + b`, `extend`,
// `insert`, `remove_at` (§8, §18.2). Concatenation is shallow like `slice`;
// `insert`/`remove_at` take the same negative indices as a subscript and
// raise the same IndexError.

// --- `a + b`: a new Array, operands untouched ---
let a = [1, 2]
let b = [3, 4]
assert_eq(a + b, [1, 2, 3, 4])
assert_eq(a, [1, 2])
assert_eq(b, [3, 4])
assert_eq([] + [], [])
assert_eq([] + a, [1, 2])
assert_eq(a + [], [1, 2])
assert_eq(a + a, [1, 2, 1, 2])
assert_eq(a + b + a, [1, 2, 3, 4, 1, 2])
assert_eq((a + b).size(), 4)

// Same result as the spread form.
assert_eq(a + b, [...a, ...b])

// `+=` rebinds; it does not mutate the left operand in place.
mut c = [1]
let alias = c
c += [2, 3]
assert_eq(c, [1, 2, 3])
assert_eq(alias, [1])

// The copy is shallow: elements are shared with both operands.
let boxed = [{mut v: 1}]
let joined = boxed + []
joined[0].v = 9
assert_eq(boxed[0].v, 9)

// The result is an ordinary Array (growable, sliceable).
mut grown = [1, 2] + [3]
grown.push(4)
assert_eq(grown, [1, 2, 3, 4])
assert_eq(([1, 2] + [3, 4])[1..3], [2, 3])

// Only two Arrays concatenate; other operands are a TypeError, as with
// String + Long.
assert_throws("TypeError", fn () {
  [1] + "s"
})
assert_throws("TypeError", fn () {
  [1] + (2, 3)
})
assert_throws("TypeError", fn () {
  [1] + [2].to_set()
})
assert_throws("TypeError", fn () {
  "s" + [1]
})
assert_throws("TypeError", fn () {
  [1] + 2
})

// --- `extend`: append every element, in place ---
mut extended = [1, 2]
assert_eq(extended.extend([3, 4]), nil)
assert_eq(extended, [1, 2, 3, 4])
extended.extend([])
assert_eq(extended, [1, 2, 3, 4])

mut empty = []
empty.extend([1])
assert_eq(empty, [1])

// The receiver may be the argument: the source length is read once.
mut selfext = [1, 2]
selfext.extend(selfext)
assert_eq(selfext, [1, 2, 1, 2])

// `extend` takes an Array; use spread for Tuple / Set sources.
assert_throws("TypeError", fn () {
  [1].extend((2, 3))
})
assert_throws("TypeError", fn () {
  [1].extend([2].to_set())
})
assert_throws("TypeError", fn () {
  [1].extend(2)
})

// --- `insert`: push addressed by position ---
mut inserted = [1, 2, 3]
assert_eq(inserted.insert(0, 0), nil)
assert_eq(inserted, [0, 1, 2, 3])
inserted.insert(2, 9)
assert_eq(inserted, [0, 1, 9, 2, 3])

// `size` is the append slot.
mut at_end = [1, 2]
at_end.insert(at_end.size(), 3)
assert_eq(at_end, [1, 2, 3])
mut into_empty = []
into_empty.insert(0, 1)
assert_eq(into_empty, [1])

// Negative positions count from the end, like `a[-1]`.
mut from_end = [1, 2, 3]
from_end.insert(-1, 9)
assert_eq(from_end, [1, 2, 9, 3])
from_end.insert(-4, 0)
assert_eq(from_end, [0, 1, 2, 9, 3])

assert_throws("IndexError", fn () {
  [1, 2].insert(3, 0)
})
assert_throws("IndexError", fn () {
  [1, 2].insert(-3, 0)
})
assert_throws("IndexError", fn () {
  [].insert(1, 0)
})
assert_throws("IndexError", fn () {
  [].insert(-1, 0)
})
assert_throws("TypeError", fn () {
  [1].insert("x", 0)
})

// --- `remove_at`: pop addressed by position ---
mut drained = [10, 20, 30]
assert_eq(drained.remove_at(1), 20)
assert_eq(drained, [10, 30])
assert_eq(drained.remove_at(-1), 30)
assert_eq(drained, [10])
assert_eq(drained.remove_at(0), 10)
assert_eq(drained, [])

// Unlike `insert`, `size` is out of range — it must address a live element.
assert_throws("IndexError", fn () {
  [1, 2].remove_at(2)
})
assert_throws("IndexError", fn () {
  [1, 2].remove_at(-3)
})
assert_throws("IndexError", fn () {
  [].remove_at(0)
})
assert_throws("TypeError", fn () {
  [1].remove_at("x")
})

// The removed element outlives the Array it came from.
mut owner = [{mut v: 1}, {mut v: 2}]
let taken = owner.remove_at(0)
taken.v = 7
assert_eq(taken.v, 7)
assert_eq(owner.size(), 1)
assert_eq(owner[0].v, 2)
