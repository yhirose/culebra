// `??=` nil-coalescing assignment: `a ??= b` assigns `b` to `a` only
// when `a` currently reads as nil, and short-circuits `b` otherwise.
// MVP: simple variable targets only.

mut a = nil
a ??= 5
assert_eq(a, 5)
a ??= 9  // a is non-nil -> unchanged
assert_eq(a, 5)

// Short-circuit: the RHS is not evaluated when the target is non-nil.
mut calls = 0
fn bump() {
  calls = calls + 1
  99
}

mut b = 7
b ??= bump()
assert_eq(b, 7)
assert_eq(calls, 0)  // bump() was not called

mut c = nil
c ??= bump()
assert_eq(c, 99)
assert_eq(calls, 1)  // bump() called exactly once

// Works with any value type.
mut s = nil
s ??= "hi"
assert_eq(s, "hi")

IO.inspect("test_nil_coalesce_assign OK")
