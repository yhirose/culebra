// `??=` nil-coalescing assignment: `a ??= b` assigns `b` to `a` only
// when `a` currently reads as nil, and short-circuits `b` otherwise.
// MVP: simple variable targets only.

mut a = nil
a ??= 5
assert_eq(a, 5)
a ??= 9  // a is non-nil -> unchanged
assert_eq(a, 5)

// Short-circuit: the RHS is not evaluated when the target is non-nil.
mut calls = 0
fn bump() {
  calls = calls + 1
  99
}

mut b = 7
b ??= bump()
assert_eq(b, 7)
assert_eq(calls, 0)  // bump() was not called

mut c = nil
c ??= bump()
assert_eq(c, 99)
assert_eq(calls, 1)  // bump() called exactly once

// Works with any value type.
mut s = nil
s ??= "hi"
assert_eq(s, "hi")

// Compound and `??=` index assignment inside a loop must not grow the frame
// per iteration: the read-back out-params belong in the function's entry
// block. Twenty-four sites × 25k rounds is ~5 MB of stack if any one of them
// leaks a frame slot per pass — the JIT used to segfault on this shape.
fn hot_index_writes() {
  mut a = [0, nil]
  mut i = 0
  while i < 25000 {
    a[0] += 1
    a[0] += 1
    a[0] += 1
    a[0] += 1
    a[0] += 1
    a[0] += 1
    a[0] += 1
    a[0] += 1
    a[1] ??= 5
    a[1] = nil
    a[1] ??= 5
    a[1] = nil
    a[1] ??= 5
    a[1] = nil
    a[1] ??= 5
    a[1] = nil
    i = i + 1
  }
  a[0]
}
assert_eq(hot_index_writes(), 200000)

IO.inspect("test_nil_coalesce_assign OK")
