// Destructuring loop variables: `for [a, b] in …`, `for (a, b) in …`,
// `for {k, v} in …`. The pattern must match the element's shape.

// Array pattern over a list of pairs.
mut sums = []
for [a, b] in [[1, 2], [3, 4], [5, 6]] {
  sums.push(a + b)
}
assert_eq(sums, [3, 7, 11])

// Tuple pattern over a list of tuples.
mut prod = 1
for (a, b) in [(2, 3), (4, 5)] {
  prod = prod * a * b
}
assert_eq(prod, 2 * 3 * 4 * 5)

// Bare-comma target + tuple yield from `enumerate()` (`(index, value)`),
// called directly on the Array.
mut pairs = []
for i, v in ["a", "b", "c"].enumerate() {
  pairs.push((i, v))
}
assert_eq(pairs, [(0, "a"), (1, "b"), (2, "c")])

// Same via the explicit iterator, with a parenthesized tuple pattern.
mut pairs2 = []
for (i, v) in ["a", "b", "c"].iter().enumerate() {
  pairs2.push((i, v))
}
assert_eq(pairs2, [(0, "a"), (1, "b"), (2, "c")])

// Nested pattern.
mut firsts = []
for (k, (v1, v2)) in [("x", (1, 2)), ("y", (3, 4))] {
  firsts.push(v1)
}
assert_eq(firsts, [1, 3])

// Plain identifier still works.
mut total = 0
for n in [10, 20, 30] {
  total = total + n
}
assert_eq(total, 60)

// Sink in a pattern.
mut keys = []
for (k, _) in [("a", 1), ("b", 2)] {
  keys.push(k)
}
assert_eq(keys, ["a", "b"])

// Enum-constructor pattern binding a heap payload, looped twice over the same
// source. The bound leaf takes a +1 on a value object_get only borrows; without
// that retain the slot double-frees the payload once the enum object is
// released — deterministic under the for-in per-iteration release (JIT abort).
enum ForDestrBox {
  Wrap(Array),
}
let boxed = [(ForDestrBox.Wrap([1, 2]), "a"), (ForDestrBox.Wrap([3, 4]), "b")]
mut sizes_a = []
for (Wrap(arr), tag) in boxed {
  sizes_a.push((tag, arr.size()))
}
for (Wrap(arr), tag) in boxed {
  sizes_a.push((tag, arr.size()))
}
assert_eq(sizes_a, [("a", 2), ("b", 2), ("a", 2), ("b", 2)])

// Object full `key: name` pattern with a heap value, same double-loop — the
// object-pattern sibling of the ctor case (both recurse on a borrowed value).
let recs = [{items: [1, 2]}, {items: [3]}]
mut sizes_o = []
for {items: xs} in recs {
  sizes_o.push(xs.size())
}
for {items: xs} in recs {
  sizes_o.push(xs.size())
}
assert_eq(sizes_o, [2, 1, 2, 1])

// A closure in the body captures the pattern's leaves. The analyzer registers
// every leaf as visible in the body subtree (a single-identifier binding was
// the only shape it used to collect), so each pass's names are the ones the
// closure made in that pass sees.
mut fs = []
for (k, v) in [("a", 1), ("b", 2)] {
  fs.push(fn () { k + to_string(v) })
}
mut fs_out = []
for f in fs { fs_out.push(f()) }
assert_eq(fs_out, ["a1", "b2"])

mut gs = []
for [h, ...t] in [[1, 2, 3], [4]] {
  gs.push(fn () { (h, t.size()) })
}
mut gs_out = []
for g in gs { gs_out.push(g()) }
assert_eq(gs_out, [(1, 2), (4, 0)])

mut hs = []
for k, v in {p: 1, q: 2} {
  hs.push(fn () { k + to_string(v) })
}
mut hs_out = []
for h in hs { hs_out.push(h()) }
assert_eq(hs_out, ["p1", "q2"])

IO.inspect("test_for_destructure OK")
