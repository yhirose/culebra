// Destructuring loop variables: `for [a, b] in …`, `for (a, b) in …`,
// `for {k, v} in …`. The pattern must match the element's shape.

// Array pattern over a list of pairs.
mut sums = []
for [a, b] in [[1, 2], [3, 4], [5, 6]] {
  sums.push(a + b)
}
assert_eq(sums, [3, 7, 11])

// Tuple pattern over a list of tuples.
mut prod = 1
for (a, b) in [(2, 3), (4, 5)] {
  prod = prod * a * b
}
assert_eq(prod, 2 * 3 * 4 * 5)

// Bare-comma target + tuple yield from `enumerate()` (`(index, value)`),
// called directly on the Array.
mut pairs = []
for i, v in ["a", "b", "c"].enumerate() {
  pairs.push((i, v))
}
assert_eq(pairs, [(0, "a"), (1, "b"), (2, "c")])

// Same via the explicit iterator, with a parenthesized tuple pattern.
mut pairs2 = []
for (i, v) in ["a", "b", "c"].iter().enumerate() {
  pairs2.push((i, v))
}
assert_eq(pairs2, [(0, "a"), (1, "b"), (2, "c")])

// Nested pattern.
mut firsts = []
for (k, (v1, v2)) in [("x", (1, 2)), ("y", (3, 4))] {
  firsts.push(v1)
}
assert_eq(firsts, [1, 3])

// Plain identifier still works.
mut total = 0
for n in [10, 20, 30] { total = total + n }
assert_eq(total, 60)

// Sink in a pattern.
mut keys = []
for (k, _) in [("a", 1), ("b", 2)] { keys.push(k) }
assert_eq(keys, ["a", "b"])

IO.puts("test_for_destructure OK")
