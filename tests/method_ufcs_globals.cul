# UFCS over the unary global builtins: `x.f()` == `f(x)`. These must work as
# methods on every receiver type and produce identical results under interp
# and JIT (the JIT once lacked hash/to_float here and rejected non-String
# to_long). The interp-vs-JIT diff in `just test` guards the symmetry.

# to_string on each primitive
inspect((42).to_string())
inspect((3.5).to_string())
inspect(true.to_string())
inspect("hi".to_string())
inspect([1, 2].to_string())

# type_of via UFCS
inspect((42).type_of())
inspect("hi".type_of())
inspect([1].type_of())

# to_long is polymorphic: Long / Float / String all convert
inspect((42).to_long())
inspect((3.9).to_long())
inspect("123".to_long())

# to_float is polymorphic too
inspect((7).to_float())
inspect("2.5".to_float())

# hash works on hashable primitives and returns a Long; equal values hash equal
inspect((42).hash() == (42).hash())
inspect("hi".hash() == "hi".hash())
inspect((1).hash() == (2).hash())
