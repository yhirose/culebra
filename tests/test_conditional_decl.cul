// A declaration inside an expression that may be skipped: an operand a
// short-circuit skips, the rest of a chain after a `?.`, a later test of an
// `if` or a `cond`. None of these is a scope of its own (an arm is:
// tests/test_if_arm_scope.cul), so the name belongs to the scope around the
// statement, and whether it was declared is a fact of the run: a read the
// skipped declaration never bound is a NameError, on every backend.

// --- A declaration in an operand a short-circuit skips, or after a `?.`:
// a closure built after it captures a cell that exists either way, and a
// read the skipped declaration never bound is a NameError. ---
fn cd_short_circuit(c) {
  c && (let h = [1, 2])
  let g = || h
  g()
}
assert_eq(cd_short_circuit(true), [1, 2])
assert_throws("NameError", fn () { cd_short_circuit(false) })

fn cd_coalesce(x) {
  x ?? (let n = [4])
  let g = || n
  g()
}
assert_eq(cd_coalesce(nil), [4])
assert_throws("NameError", fn () { cd_coalesce(1) })

fn cd_safe_call(o) {
  o?.push((let k = [3]))
  let g = || k
  g()
}
assert_eq(cd_safe_call([]), [3])
assert_throws("NameError", fn () { cd_safe_call(nil) })

// A skipped declaration of a name this scope already binds leaves that
// binding as it was: its value, and its mutability.
fn cd_skipped_redeclare(c) {
  let h = 1
  c && (let h = 2)
  h
}
assert_eq([cd_skipped_redeclare(true), cd_skipped_redeclare(false)], [2, 1])
fn cd_skipped_mut(c) {
  let h = 1
  c && (mut h = 2)
  h = 3
  h
}
assert_eq(cd_skipped_mut(true), 3)
assert_throws("ImmutableError", fn () { cd_skipped_mut(false) })

// Until a declaration has run, a compound write steps the binding the name
// still means and writes it back there, and so does a destructuring leaf:
// each is a write, as `=` is.
fn cd_skipped_writes(c) {
  mut h = 1
  let seen = []
  {
    c && (mut h = 10)
    h += 1
    (h, _) = (h * 2, 0)
    seen.push(h)
  }
  seen.push(h)
  seen
}
assert_eq([cd_skipped_writes(false), cd_skipped_writes(true)], [[4, 4], [22, 1]])

// A stdlib global it shadows is what the name means then: a read is the
// global, and a write refuses, as one to any stdlib global does.
fn cd_skipped_builtin(c) {
  c && (mut type_of = |x| "mine")
  let read = type_of(1)
  let wrote = try { type_of = |x| "other"; "wrote" } catch e { e.kind }
  [read, wrote]
}
assert_eq(cd_skipped_builtin(false), ["Long", "ImmutableError"])
assert_eq(cd_skipped_builtin(true), ["mine", "wrote"])

// A skipped declaration does not settle a cell a closure above holds.
fn cd_skipped_forward(c) {
  let g = || h
  c && (let h = [2])
  let r = h
  let h = [1]
  [r, g()]
}
assert_eq(cd_skipped_forward(true), [[2], [1]])
assert_throws("NameError", fn () { cd_skipped_forward(false) })

// A `while` condition and a `match` subject run outside their bodies.
fn cd_while_cond(c) {
  while c && ((let h = [1]) != nil) { break }
  let g = || h
  g()
}
assert_eq(cd_while_cond(true), [1])
assert_throws("NameError", fn () { cd_while_cond(false) })
fn cd_match_subject(c) {
  match c && (let h = [1]) { _ => 0 }
  let g = || h
  g()
}
assert_eq(cd_match_subject(true), [1])
assert_throws("NameError", fn () { cd_match_subject(false) })

// A later test of an `if` / `cond` declares around the construct: its arm
// reads the name, and so does the code after when the test ran.
fn cd_later_test(a) {
  if a { 0 } else if (let m = [5]) != nil { m.push(6) }
  let g = || m
  g()
}
assert_eq(cd_later_test(false), [5, 6])
assert_throws("NameError", fn () { cd_later_test(true) })
fn cd_cond_test(a) {
  cond {
    a => 0,
    (let m = [7]) != nil => m.push(8),
  }
  m
}
assert_eq(cd_cond_test(false), [7, 8])
assert_throws("NameError", fn () { cd_cond_test(true) })

// Two skippable declarations of one name with their own mutability: a later
// write is checked against the one that ran.
fn cd_mixed_mut(a) {
  a && (mut m = 1)
  !a && (let m = 2)
  m = 5
  m
}
assert_eq(cd_mixed_mut(true), 5)
assert_throws("ImmutableError", fn () { cd_mixed_mut(false) })
// The same where the name shadows a binding around it.
fn cd_shadowing_mixed_mut(a) {
  mut m = 1
  {
    !a && (let m = 2)
    a && (mut m = 3)
    m = 5
  }
  m
}
assert_eq(cd_shadowing_mixed_mut(true), 1)
assert_throws("ImmutableError", fn () { cd_shadowing_mixed_mut(false) })

// A destructuring declaration that ran decides the `mut` as `let x = v` does.
fn cd_pattern_mut(c) {
  c && (mut (p, q) = (1, 2))
  try { p = 5; [p, q] } catch e { e.kind }
}
assert_eq([cd_pattern_mut(true), cd_pattern_mut(false)], [[5, 2], "NameError"])

// A module variable it shadows is what the name means until it runs, for a
// read and for every write.
mut cd_top = 1
fn cd_module(c) {
  c && (mut cd_top = 10)
  let r = cd_top
  cd_top = 5
  cd_top += 1
  [r, cd_top]
}
assert_eq([cd_module(false), cd_top], [[1, 6], 6])
assert_eq([cd_module(true), cd_top], [[10, 6], 6])

// One declared after the function too, and the declaration that runs is the
// function's own, not the module's.
fn cd_late(c) {
  c && (mut cd_late_v = 10)
  cd_late_v
}
mut cd_late_v = 2
assert_eq([cd_late(true), cd_late_v, cd_late(false), cd_late_v], [10, 2, 2, 2])

// A closure made ahead of the declaration holds the function's variable, so
// it reads the NameError until the declaration runs.
mut cd_held = 1
fn cd_closure(c) {
  let h = || cd_held
  c && (mut cd_held = 10)
  try { h() } catch e { e.kind }
}
assert_eq([cd_closure(true), cd_closure(false)], [10, "NameError"])

// What it shadows is what the name means where it is written: a declaration
// further down the function is not visible there yet.
mut cd_ahead = 1
fn cd_down(c) {
  mut out = 0
  {
    c && (mut cd_ahead = 10)
    out = cd_ahead
  }
  let cd_ahead = 5
  [out, cd_ahead]
}
assert_eq([cd_down(false), cd_down(true)], [[1, 5], [10, 5]])

// A parameter or a loop variable it shadows is what the name means until it
// runs, while a closure made ahead holds the function's own variable.
fn cd_param(c, g) {
  let h = || g
  c && (mut g = 2)
  [g, try { h() } catch e { e.kind }]
}
assert_eq([cd_param(true, 1), cd_param(false, 1)], [[2, 2], [1, "NameError"]])
fn cd_loop(c) {
  mut out = []
  for g in [1] {
    let h = || g
    c && (mut g = 2)
    out.push(g)
  }
  out
}
assert_eq([cd_loop(true), cd_loop(false)], [[2], [1]])

// So is one a `while` condition makes, which runs ahead of its body.
mut cd_cond = 1
fn cd_while(c) {
  let h = || cd_cond
  mut i = 0
  while i < 1 && c && ((mut cd_cond = 10) != nil) { i += 1 }
  [cd_cond, try { h() } catch e { e.kind }]
}
assert_eq([cd_while(true), cd_while(false)], [[10, 10], [1, "NameError"]])

// In a loop the name is undeclared again on every pass.
assert_throws("NameError", fn () {
  fn cd_loop_rearm() {
    for i in range(3) {
      i == 0 && (let p = 100)
      if i == 0 {
        assert_eq(p, 100)
      } else {
        p
      }
    }
  }
  cd_loop_rearm()
})

// An arm's declaration is the arm's own: the closure above reads the
// function's `h`, which the later declaration fills.
fn cd_arm_forward(c) {
  let g = || h
  if c { let h = [2] }
  let h = [1]
  g()
}
assert_eq([cd_arm_forward(true), cd_arm_forward(false)], [[1], [1]])

// A `for` iterable is evaluated on the level around the loop: what it
// declares outlives the loop, and one it may skip means what the name meant
// above it until it runs.
fn cd_for_decl() {
  for _ in [(mut w = 10)] {}
  mut s = 0
  for i in 0..(mut n = 3) {
    s += i
  }
  [w, n, s]
}
assert_eq(cd_for_decl(), [10, 3, 3])
mut cd_it = 1
fn cd_for_skip(c) {
  for _ in [c && ((mut cd_it = 10) != nil)] {}
  cd_it
}
assert_eq([cd_for_skip(false), cd_for_skip(true)], [1, 10])
fn cd_range_skip(c) {
  mut s = 0
  for _ in 0..((c && ((mut cd_it = 2) != nil)) ? 2 : 1) {
    s += 1
  }
  [s, cd_it]
}
assert_eq([cd_range_skip(false), cd_range_skip(true)], [[1, 1], [2, 2]])
// `yield from` evaluates its source the same way.
fn cd_yield_from() {
  yield from (let src = [1, 2])
  yield src.size()
}
assert_eq(cd_yield_from().collect(), [1, 2, 2])

// So does a guard, in its arm: a declaration it skips leaves the name what it
// was around the match.
let cd_gz = "outer"
fn cd_guard(c) {
  match 1 {
    _ if c || ((let cd_gz = "guard") != nil) => cd_gz
  }
}
assert_eq([cd_guard(false), cd_guard(true)], ["guard", "outer"])
