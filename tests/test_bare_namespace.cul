// Conformance: each stdlib namespace must be addressable as a first-class
// value. `let m = NS; m.method(...)` (slow path, via _jit_ns_method_trampoline
// on JIT/AOT) must return the same observable behavior as `NS.method(...)`
// (fast path, via compile_ns_call). See stdlib_jit.h::kNsMethods.

// --- IO (standard streams + console) ---
let io = IO
io.inspect("IO bare resolve")

// --- Math ---
let math = Math
assert_eq(math.abs(-5), 5)
assert_eq(math.abs(-3.5), 3.5)
assert_eq(math.sqrt(16.0), 4.0)
assert_eq(math.floor(3.7), 3)
assert_eq(math.ceil(3.2), 4)
assert_eq(math.round(3.5), 4)
assert_eq(math.pow(2, 10), 1024)
assert_eq(math.sign(-7), -1)
assert_eq(math.sign(7), 1)
assert_eq(math.sign(0), 0)
assert_eq(math.clamp(15, 0, 10), 10)
assert_eq(math.clamp(-5, 0, 10), 0)
assert_eq(math.wrap(-3, 320), 317)
assert_eq(math.wrap(320, 320), 0)
assert_eq(math.min(3, 1, 4, 1, 5), 1)
assert_eq(math.max(3, 1, 4, 1, 5), 5)
assert_true(math.pi > 3.14 && math.pi < 3.15)
assert_true(math.e > 2.71 && math.e < 2.72)

// --- FS ---
let fs = FS
assert_eq(fs.basename("/tmp/foo.txt"), "foo.txt")
assert_eq(fs.dirname("/tmp/foo.txt"), "/tmp")
assert_eq(fs.extension("/tmp/foo.txt"), ".txt")
assert_eq(fs.stem("/tmp/foo.txt"), "foo")
assert_eq(fs.join("a", "b", "c.txt"), "a{FS.sep()}b{FS.sep()}c.txt")
assert_eq(fs.exists("tests/test_bare_namespace.cul"), true)
// Whole-file read/write moved from IO to FS; exercise via bare value too.
let bare_tmp = FS.join(FS.temp_dir(), "cul_bare_fs.txt")
fs.write(bare_tmp, "bare")
assert_eq(fs.read(bare_tmp), "bare")
fs.remove(bare_tmp)

// --- Random ---
let r = Random
r.seed(42)
let n = r.int(0, 100)
assert_true(n >= 0 && n < 100)
let f = r.uniform(0.0, 1.0)
assert_true(f >= 0.0 && f <= 1.0)
let a = [1, 2, 3, 4, 5]
r.shuffle(a)
assert_eq(a.size(), 5)  // shuffle in place — size unchanged

// --- Sys ---
let s = Sys
assert_ge(s.time(), 0.0)
assert_eq(type_of(s.argv), "Array")  // s.argv is a slot, not a method

// --- JSON ---
let j = JSON
assert_eq(j.stringify({a: 1}), '{"a":1}')
assert_eq(j.parse('{"x":42}').x, 42)

// --- Encoding (nested sub-namespace: Encoding.html.*) ---
let enc = Encoding
assert_eq(enc.html.unescape("a &amp; b"), "a & b")
assert_eq(enc.html.escape("<x>"), "&lt;x&gt;")
let eh = Encoding.html  // bind the sub-namespace directly
assert_eq(eh.unescape("&#65;&#x42;"), "AB")

// --- Hash (bound namespace + bound method, slow-path resolve) ---
let h = Hash
assert_eq(
  h.sha256("abc"),
  "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
)
assert_eq(h.md5("abc"), "900150983cd24fb0d6963f7d28e17f72")
let hm = Hash.hmac_sha256
assert_eq(
  hm("Jefe", "what do ya want for nothing?"),
  "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
)

// --- Tensor ---
let t = Tensor
let z = t.zeros(2, 3)
let zs = z.shape()
assert_true(zs.size() == 2 && zs[0] == 2 && zs[1] == 3)
let o = t.ones(3)
let os = o.shape()
assert_true(os.size() == 1 && os[0] == 3)
let arr = t.from([1.0, 2.0, 3.0])
let as = arr.shape()
assert_true(as.size() == 1 && as[0] == 3)

// --- keys() order ---
// `keys()` reports insertion order, and each namespace is built from a
// separate table per backend, so the two registration orders have to agree.
// Pinning the lists here catches a row landing in the wrong place.
assert_eq(
  Math.keys(),
  [
    "abs",
    "min",
    "max",
    "pow",
    "sign",
    "clamp",
    "wrap",
    "log",
    "exp",
    "sqrt",
    "sin",
    "cos",
    "tan",
    "asin",
    "acos",
    "atan",
    "atan2",
    "floor",
    "ceil",
    "round",
    "pi",
    "e",
    "inf",
    "nan",
  ],
)
assert_eq(
  Sys.keys(),
  [
    "argv",
    "executable",
    "script",
    "exit",
    "env",
    "getcwd",
    "chdir",
    "set_env",
    "data_dir",
    "time",
  ],
)
assert_eq(
  Tensor.keys(),
  [
    "zeros",
    "ones",
    "randn",
    "eval",
    "from_csv",
    "from",
    "concat",
    "no_grad",
    "use_cpu",
    "use_gpu",
    "use_auto",
    "gpu_available",
    "device",
  ],
)
// Sub-namespaces come out in first-appearance order, not hash order.
assert_eq(Encoding.keys(), ["html", "base64", "hex", "url"])

"OK".inspect()
