// The receiver a native namespace method is handed gets released.
//
// The method ABI passes `self` at +1 and the callee consumes it — a compiled
// closure at its frame epilogue, a wrapped handle method through
// JitMethodSelf. An ns method takes its receiver as a positional instead, so
// its trampoline never reads `self`; it still has to release it.
//
// Without that, every call reached as a two-step member chain — a wrapped
// class's `Ns.Class.new(...)`, a wrapped static — adds a reference to the
// class object that nothing ever drops. It leaks against an object pinned
// for the life of the isolate, so it frees no memory late and shows up in no
// object count: GC.stat() counts objects, and an inflated count creates
// none. GC.refcount is what can see it.

let mod_base = GC.refcount(CodeGen.Module)
for _ in range(200) {
  CodeGen.Module.new()
}
assert_eq(GC.refcount(CodeGen.Module), mod_base)

// A wrapped static, the other shape that reaches the trampoline with a
// receiver.
let img_base = GC.refcount(Scene.Image)
for _ in range(200) {
  Scene.Image.new(2, 2)
}
assert_eq(GC.refcount(Scene.Image), img_base)

// The throwing paths hand the receiver over the same way, and unwinding it
// twice would free the namespace object out from under the program. Arity,
// argument type and keyword rejection each end in a throw — asserted, so
// that a path which stops throwing stops counting as coverage.
let rs_base = GC.refcount(CodeGen.Resolver)
for _ in range(50) {
  assert_throws('ArityError', fn () {
    Scene.Image.new(2)
  })
  assert_throws('TypeError', fn () {
    Scene.Image.new('a', 'b')
  })
  assert_throws('TypeError', fn () {
    Scene.Image.new(w: 2, h: 2)
  })
  assert_throws('ArityError', fn () {
    CodeGen.Resolver.new(1)
  })
}
assert_eq(GC.refcount(Scene.Image), img_base)
assert_eq(GC.refcount(CodeGen.Resolver), rs_base)
// Still usable — an over-release would have freed it by now.
assert_eq(Scene.Image.new(2, 2).width(), 2.0)

// A value that carries no reference count has none to report — Strings are
// traced rather than counted, and the rest are immediates.
for v in [42, 1.5, true, nil, 'hi'] {
  assert_eq(GC.refcount(v), nil)
}

// Reading it is a delta tool: an alias that goes out of scope leaves none.
let obj = {a: 1}
let obj_base = GC.refcount(obj)
for _ in range(100) {
  let alias = obj
}
assert_eq(GC.refcount(obj), obj_base)

inspect("test_ns_receiver_rc ok")
