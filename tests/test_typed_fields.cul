# A declared field's type is a contract the write checks (docs/language.md
# §10). The annotation was documentation before; it now decides what the
# field may hold, in the same words `let x: Float = 3` has always used, and
# through every write surface: a literal name, a computed key, a method's
# own `self.x`, and the constructor's prologue.
#
# Run: ./build/culebra tests/test_typed_fields.cul
#      ./build/culebra --jit tests/test_typed_fields.cul

class Fields {
  f: Float
  n: Long
  b: Bool
  s: String
  untyped = nil
  new() {
  }
}

# --- the declared zero is what the type says, and it satisfies the type ---

let v = Fields()
assert_eq(v.f, 0.0)
assert_eq(v.n, 0)
assert_eq(v.b, false)
assert_eq(v.s, '')
assert_eq(v.untyped, nil)

v.f = 2.5
v.n = 7
v.b = true
assert_eq(v.f, 2.5)
assert_eq(v.n, 7)
assert_eq(v.b, true)

# --- a write that does not satisfy the declaration is a TypeError ---

assert_throws('TypeError', fn () {
  v.f = 'not a float'
})
assert_throws('TypeError', fn () {
  v.f = 3
})
assert_throws('TypeError', fn () {
  v.f = nil
})
assert_throws('TypeError', fn () {
  v.n = 1.5
})
assert_throws('TypeError', fn () {
  v.b = 1
})

# the value the field already held survives a rejected write
assert_eq(v.f, 2.5)
assert_eq(v.n, 7)
assert_eq(v.b, true)

# --- an initializer does not exempt the field from its own declaration ---
#
# A field with an initializer is stored by its own instruction rather than
# the shared layout op, and the declared type has to reach the slot either
# way, or the write check would have a hole the read side still trusts.

class Preset {
  f: Float = 1.5
  n: Long = 7
  b: Bool = true
  untyped = 'anything'
  new() {
  }
}

let pre = Preset()
assert_eq(pre.f, 1.5)
assert_eq(pre.n, 7)
assert_eq(pre.b, true)

assert_throws('TypeError', fn () {
  pre.f = 'no'
})
assert_throws('TypeError', fn () {
  pre.n = 1.5
})
assert_throws('TypeError', fn () {
  pre.b = 1
})
assert_eq(pre.f, 1.5)

# and the initializer itself is checked, as any other write is
class BadPreset {
  f: Float = 'not a float'
  new() {
  }
}

assert_throws('TypeError', fn () {
  BadPreset()
})

# an initializer still cannot see the field it defines, nor the ones below
class Order {
  a: Long = 1
  b: Long = 2

  new() {
  }
}

assert_eq(Order().a, 1)
assert_eq(Order().b, 2)

# --- an unannotated field takes anything, as it always has ---

v.untyped = 'a string'
assert_eq(v.untyped, 'a string')
v.untyped = 42
assert_eq(v.untyped, 42)

# a field the constructor adds carries no declaration either
class Grows {
  new() {
    self.added = 1
  }
}

let g = Grows()
g.added = 'now a string'
assert_eq(g.added, 'now a string')

# --- every write surface answers the same ---

class Writes {
  f: Float
  new() {
  }
  set_via_self(x) {
    self.f = x
  }
}

let w = Writes()
w.set_via_self(1.5)
assert_eq(w.f, 1.5)
assert_throws('TypeError', fn () {
  w.set_via_self('no')
})

# a computed key reaches the same check
assert_throws('TypeError', fn () {
  w['f'] = 'no'
})
w['f'] = 3.5
assert_eq(w.f, 3.5)

# --- the message names the field and the type it wants ---

mut msg = ''
try {
  w.f = 'no'
} catch e {
  msg = e.message
}
assert_eq(msg, "type error: field 'f' expects Float")

# --- a @value class's fields are declared, so they are checked too ---

@value
class Vec {
  x: Float
  y: Float
  new(x, y) {
    self.x = x
    self.y = y
  }
}

let p = Vec(1.0, 2.0)
assert_eq(p.x, 1.0)
assert_throws('TypeError', fn () {
  Vec('a', 2.0)
})
assert_throws('TypeError', fn () {
  Vec(1, 2.0)
})


# --- the read side: what a declared type lets a reader assume ---
#
# A parameter's class annotation is checked on entry, so inside the function
# the field's declared type is settled and the read needs no tag question.
# What the checks below pin is that the assumption cannot be turned into a
# wrong answer: a receiver that wears the class's name without having gone
# through the write check is refused at the read, in the write check's own
# words, on both lanes.

class Read {
  f: Float
  n: Long
  b: Bool
  s: String
  new(f) {
    self.f = f
  }
}

fn read_f(r: Read) {
  r.f
}

fn read_n(r: Read) {
  r.n
}

fn read_b(r: Read) {
  r.b
}

fn read_s(r: Read) {
  r.s
}

let r = Read(1.5)
assert_eq(read_f(r), 1.5)
assert_eq(read_n(r), 0)
assert_eq(read_b(r), false)
assert_eq(read_s(r), '')

# arithmetic over a declared field is the same arithmetic
fn scaled(r: Read) {
  r.f * 2.0 + r.f
}

assert_eq(scaled(r), 4.5)

# an object wearing the class's name is not an instance of it: its property
# never met the write check, so the read refuses rather than reading the
# payload as the declared kind
let forged = {class: 'Read', f: 'not a float'}
assert_throws('TypeError', fn () {
  read_f(forged)
})

# a spread copy of a real instance is the same shape of forgery
let copy = {...r, f: 'not a float'}
assert_throws('TypeError', fn () {
  read_f(copy)
})

# a declared field cannot be removed: a field that can vanish is no contract
assert_throws('ImmutableError', fn () {
  r.remove('f')
})
assert_eq(read_f(r), 1.5)

# a `mut` binding's annotation is checked once and not again (§14), so it
# promises nothing about what its reads will find — the same answer whether
# the name is a local or a parameter
class Other {
  f: String
  new(f) {
    self.f = f
  }
}

fn rebound_param(mut r: Read) {
  r = Other('a string')
  r.f
}

fn rebound_local() {
  mut r: Read = Read(1.5)
  r = Other('a string')
  r.f
}

assert_eq(rebound_param(r), 'a string')
assert_eq(rebound_local(), 'a string')

# an optional or union annotation names no single class, so nothing is
# assumed and the read behaves as it always has
fn read_opt(r: Read?) {
  r?.f
}

assert_eq(read_opt(r), 1.5)
assert_eq(read_opt(nil), nil)

let forged2 = {class: 'Read', f: 'still a string'}
assert_eq(read_opt(forged2), 'still a string')


# --- a member's own `self.x` carries the same promise ---
#
# The receiver is not proven to be an instance of the class (a method value
# can be moved onto a foreign object), so the read verifies the tag the
# declaration promised, exactly as it does through a parameter.

class Own {
  f: Float
  new(f) {
    self.f = f
  }
  doubled() {
    self.f * 2.0
  }
  sum(n) {
    mut acc = 0.0
    for _ in 0..n {
      acc += self.f
    }
    acc
  }
}

let own = Own(1.5)
assert_eq(own.doubled(), 3.0)
assert_eq(own.sum(4), 6.0)

# a method value read off an instance stays bound to it, so moving one onto
# another object does not give the body a foreign `self`
let borrowed = {class: 'Own', f: 'not a float', doubled: own.doubled}
assert_eq(borrowed.doubled(), 3.0)


# --- a class-typed field carries the class to the next step ---
#
# `self.engine.rpm` and `let e = self.engine; e.rpm` are the same question
# asked twice: the first step's declared type names a class, and that class
# says what `rpm` is.

class Engine {
  rpm: Float
  gear: Long
  new() {
  }
}

class Vehicle {
  engine: Engine
  speed: Float
  new() {
    self.engine = Engine()
  }
  chained() {
    self.engine.rpm + self.speed
  }
  through_local() {
    let e = self.engine
    e.rpm + e.gear
  }
}

let v = Vehicle()
assert_eq(v.chained(), 0.0)
assert_eq(v.through_local(), 0.0)

v.engine.rpm = 12.5
v.speed = 2.5
assert_eq(v.chained(), 15.0)

# the same contract at the far end of the chain
assert_throws('TypeError', fn () {
  v.engine.rpm = 'no'
})


# --- a local's own annotation carries the same promise ---
#
# `let a: Vec = <anything>` is checked at the declaration (§14), so the name
# means an instance of that class from here on. This is the one route that
# reaches an array element, which carries no type of its own.

class Pt {
  x: Float
  y: Float
  new(x, y) {
    self.x = x
    self.y = y
  }
}

let pts = [Pt(1.0, 2.0), Pt(3.0, 4.0)]

fn sum_first(list) {
  let a: Pt = list[0]
  a.x + a.y
}

assert_eq(sum_first(pts), 3.0)

# the declaration's own check refuses anything else, so the reads below it
# never meet a value the annotation did not promise
assert_throws('TypeError', fn () {
  let bad: Pt = 42
  bad.x
})

# an object wearing the class's name passes the declaration check (it names
# the class) but its property never met the write check, so the read refuses
assert_throws('TypeError', fn () {
  let forged: Pt = {class: 'Pt', x: 'no', y: 0.0}
  forged.x
})

println('typed fields OK')
