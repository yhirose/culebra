# A declared field's type is a contract the write checks (docs/language.md
# §10), in the same words `let x: Float = 3` has always used, and through
# every write surface: a literal name, a computed key, a method's own
# `self.x`, and the constructor's prologue. A scalar — `Float`, `Long`,
# `Bool` — is decided by the value's tag; any other annotation by the rule a
# parameter's is, nil passing as the field's zero. `String` alone stays
# unchecked: it picks the field's zero value and nothing more.
#
# Run: ./build/culebra tests/test_typed_fields.cul
#      ./build/culebra --jit tests/test_typed_fields.cul

import tf_dep from './test_import_helpers/typed_fields_dep.cul'

class Fields {
  f: Float
  n: Long
  b: Bool
  s: String
  untyped = nil
  new() {
  }
}

# --- the declared zero is what the type says, and it satisfies the type ---

let v = Fields()
assert_eq(v.f, 0.0)
assert_eq(v.n, 0)
assert_eq(v.b, false)
assert_eq(v.s, '')
assert_eq(v.untyped, nil)

v.f = 2.5
v.n = 7
v.b = true
assert_eq(v.f, 2.5)
assert_eq(v.n, 7)
assert_eq(v.b, true)

# --- a write that does not satisfy the declaration is a TypeError ---

assert_throws('TypeError', fn () {
  v.f = 'not a float'
})
assert_throws('TypeError', fn () {
  v.f = 3
})
assert_throws('TypeError', fn () {
  v.f = nil
})
assert_throws('TypeError', fn () {
  v.n = 1.5
})
assert_throws('TypeError', fn () {
  v.b = 1
})

# the value the field already held survives a rejected write
assert_eq(v.f, 2.5)
assert_eq(v.n, 7)
assert_eq(v.b, true)

# §21's fixed-width spellings each stand for one of the three scalars, on an
# ordinary class as on a packable one: its zero, and its check
class Widths {
  i: Int32
  u: UInt16
  b: Byte
  f: Float32
  new() {}
}

let widths = Widths()
assert_eq([widths.i, widths.u, widths.b].map(type_of), ['Long', 'Long', 'Long'])
assert_eq(type_of(widths.f), 'Float')
assert_throws('TypeError', fn () {
  widths.u = 1.5
})
assert_throws('TypeError', fn () {
  widths.f = 1
})

# --- an initializer does not exempt the field from its own declaration ---
#
# A field with an initializer is stored by its own instruction rather than
# the shared layout op, and the declared type has to reach the slot either
# way, or the write check would have a hole the read side still trusts.

class Preset {
  f: Float = 1.5
  n: Long = 7
  b: Bool = true
  untyped = 'anything'
  new() {
  }
}

let pre = Preset()
assert_eq(pre.f, 1.5)
assert_eq(pre.n, 7)
assert_eq(pre.b, true)

assert_throws('TypeError', fn () {
  pre.f = 'no'
})
assert_throws('TypeError', fn () {
  pre.n = 1.5
})
assert_throws('TypeError', fn () {
  pre.b = 1
})
assert_eq(pre.f, 1.5)

# and the initializer itself is checked, as any other write is
class BadPreset {
  f: Float = 'not a float'
  new() {
  }
}

assert_throws('TypeError', fn () {
  BadPreset()
})

# an initializer still cannot see the field it defines, nor the ones below
class Order {
  a: Long = 1
  b: Long = 2

  new() {
  }
}

assert_eq(Order().a, 1)
assert_eq(Order().b, 2)

# --- `String` picks the zero value and checks nothing ---
#
# It names a type the annotation vocabulary knows, and the field starts as
# `''`, but it is unchecked, because `StringView` is a second spelling of
# the same thing and `slice` / `split` / `lines` / `for` over a string all
# produce it.

assert_eq(v.s, '')
v.s = 42
assert_eq(v.s, 42)
v.s = 'hello world'.slice(0, 5)
assert_eq(v.s, 'hello')
assert_eq(type_of(v.s), 'StringView')
v.s = 'plain'
assert_eq(v.s, 'plain')

# --- any other annotation is checked as a parameter's is ---
#
# A class, an enum, a union, an optional, `Array`: the write is refused
# unless the value satisfies the annotation, in the message every field
# check words. Its zero is nil, and nil always passes, so a field's `Car`
# admits nil as `Car?` would.

class Optional {
  n: Long?

  new() {
  }
}

let opt = Optional()
opt.n = 5
assert_eq(opt.n, 5)
opt.n = nil
assert_eq(opt.n, nil)
let refused_opt = try {
  opt.n = 'not a Long'
} catch e {
  [e.message, e.line]
}
assert_eq(refused_opt, ["type error: field 'n' expects Long?", 173])
assert_eq(opt.n, nil)

class Car {
  speed: Float
  new(.speed) {}
}

class Bike {
  speed: Long
  new(.speed) {}
}

class Garage {
  car: Car
  kinds: Array
  either: Car | Long
  new() {}
}

let garage = Garage()
assert_eq([garage.car, garage.kinds, garage.either], [nil, nil, nil])
garage.car = Car(1.5)
garage.kinds = ['a']
garage.either = 3
garage.either = Car(2.5)
assert_eq([garage.car.speed, garage.kinds, garage.either.speed],
          [1.5, ['a'], 2.5])
let refused_writes = [
  try { garage.car = Bike(3) } catch e { e.message },
  try { garage['car'] = 'text' } catch e { e.message },
  try { garage.kinds = {} } catch e { e.message },
  try { garage.either = 'text' } catch e { e.message },
]
assert_eq(refused_writes, [
  "type error: field 'car' expects Car",
  "type error: field 'car' expects Car",
  "type error: field 'kinds' expects Array",
  "type error: field 'either' expects Car | Long",
])
garage.car = nil
assert_eq(garage.car, nil)

# a fixed-width spelling inside one stands for its scalar, as it does alone,
# and an annotation that admits anything checks nothing (and can go)
class Spelled {
  a: Int32?
  b: Byte | Nil
  w: Any?
  new() {}
}

let spelled = Spelled()
spelled.a = 3
spelled.b = 7
spelled.w = 'anything'
assert_eq([spelled.a, spelled.b, spelled.w], [3, 7, 'anything'])
assert_eq(try { spelled.a = 1.5 } catch e { e.message },
          "type error: field 'a' expects Long?")
spelled.remove('w')
assert_eq(spelled.keys(), ['a', 'b'])

# a @packable class's field of a record type is its byte layout's: a write
# to an ordinary instance is not checked, so the field promises a reader
# nothing and a read through a local agrees with the chained one
@packable
class PPoint {
  x: Float32
  y: Float32
}

class Fake {
  x: Long
  new(.x) {}
}

@packable
class PLine {
  id: Int32
  start: PPoint
  via_local() {
    let p = self.start
    p.x
  }
  via_chain() {
    self.start.x
  }
}

let pline = PLine()
pline.start = Fake(3)
assert_eq([pline.via_local(), pline.via_chain()], [3, 3])

# a scalar is named by its whole spelling: a class whose name only starts
# like one is a class like any other, so its field starts as nil, takes an
# instance, and a reader follows it to the class
class Interval {
  lo: Float
  new(.lo) {}
}

class UIntPair {
  a: Long
  new(.a) {}
}

class Span {
  iv: Interval
  pair: UIntPair
  new() {}
}

let span = Span()
assert_eq([span.iv, span.pair], [nil, nil])
span.iv = Interval(1.5)
span.pair = UIntPair(2)
assert_eq([span.iv.lo, span.pair.a], [1.5, 2])

fn span_lo(s: Span) {
  s.iv.lo
}

assert_eq(span_lo(span), 1.5)

# removing one of them rebuilds the shape, and the survivors keep the types
# they were declared with — otherwise a `remove` anywhere on an instance
# would turn the write check off for the whole object
class Mixed {
  keep: Float
  gone: String
  new() {
    self.extra = 1
  }
}

let m = Mixed()
m.remove('gone')
assert_throws('TypeError', fn () {
  m.keep = 'no'
})
m.remove('extra')
assert_throws('TypeError', fn () {
  m.keep = 'no'
})
m.keep = 2.5
assert_eq(m.keep, 2.5)

# --- an unannotated field takes anything, as it always has ---

v.untyped = 'a string'
assert_eq(v.untyped, 'a string')
v.untyped = 42
assert_eq(v.untyped, 42)

# a field the constructor adds carries no declaration either
class Grows {
  new() {
    self.added = 1
  }
}

let g = Grows()
g.added = 'now a string'
assert_eq(g.added, 'now a string')

# --- every write surface answers the same ---

class Writes {
  f: Float
  new() {
  }
  set_via_self(x) {
    self.f = x
  }
}

let w = Writes()
w.set_via_self(1.5)
assert_eq(w.f, 1.5)
assert_throws('TypeError', fn () {
  w.set_via_self('no')
})

# a computed key reaches the same check
assert_throws('TypeError', fn () {
  w['f'] = 'no'
})
w['f'] = 3.5
assert_eq(w.f, 3.5)

# --- the message names the field and the type it wants ---

mut msg = ''
try {
  w.f = 'no'
} catch e {
  msg = e.message
}
assert_eq(msg, "type error: field 'f' expects Float")

# --- a @value class's fields are declared, so they are checked too ---

@value
class Vec {
  x: Float
  y: Float
  new(x, y) {
    self.x = x
    self.y = y
  }
}

let p = Vec(1.0, 2.0)
assert_eq(p.x, 1.0)
assert_throws('TypeError', fn () {
  Vec('a', 2.0)
})
assert_throws('TypeError', fn () {
  Vec(1, 2.0)
})


# --- the read side: what a declared type lets a reader assume ---
#
# A parameter's class annotation is checked on entry, so inside the function
# the field's declared type is settled and the read needs no tag question.
# What the checks below pin is that nothing reaches the read that did not go
# through the write check. The entry check used to be satisfiable by any
# object carrying the class's name, which is why the read verified the tag a
# second time; now the name comes from the class's meta and nothing else can
# claim it, so the forgery is refused where it is passed, on both lanes.

class Read {
  f: Float
  n: Long
  b: Bool
  s: String
  new(f) {
    self.f = f
  }
}

fn read_f(r: Read) {
  r.f
}

fn read_n(r: Read) {
  r.n
}

fn read_b(r: Read) {
  r.b
}

fn read_s(r: Read) {
  r.s
}

let r = Read(1.5)
assert_eq(read_f(r), 1.5)
assert_eq(read_n(r), 0)
assert_eq(read_b(r), false)
assert_eq(read_s(r), '')

# arithmetic over a declared field is the same arithmetic
fn scaled(r: Read) {
  r.f * 2.0 + r.f
}

assert_eq(scaled(r), 4.5)

# an object wearing the class's name is not an instance of it, so it never
# binds the parameter: the call finds no overload it fits
let forged = {class: 'Read', f: 'not a float'}
assert_throws('DispatchError', fn () {
  read_f(forged)
})

# a spread copy of a real instance is the same shape of forgery — a plain
# Object, whatever fields it copied
let copy = {...r, f: 'not a float'}
assert_throws('DispatchError', fn () {
  read_f(copy)
})

# a checked field cannot be removed: a field that can vanish is no contract.
# One declared `String`, or nothing at all, carries no promise, so it can go.
assert_throws('ImmutableError', fn () {
  r.remove('f')
})
assert_eq(read_f(r), 1.5)
assert_throws('ImmutableError', fn () {
  garage.remove('car')
})

# a `mut` binding's annotation is checked once and not again (§14), so it
# promises nothing about what its reads will find — the same answer whether
# the name is a local or a parameter
class Other {
  f: String
  new(f) {
    self.f = f
  }
}

fn rebound_param(mut r: Read) {
  r = Other('a string')
  r.f
}

fn rebound_local() {
  mut r: Read = Read(1.5)
  r = Other('a string')
  r.f
}

assert_eq(rebound_param(r), 'a string')
assert_eq(rebound_local(), 'a string')

# an optional or union annotation names no single class, so nothing is
# assumed and the read behaves as it always has
fn read_opt(r: Read?) {
  r?.f
}

assert_eq(read_opt(r), 1.5)
assert_eq(read_opt(nil), nil)

# `Read?` is no looser about what a Read is: nil or an instance, nothing
# that merely names one
let forged2 = {class: 'Read', f: 'still a string'}
assert_throws('DispatchError', fn () {
  read_opt(forged2)
})


# --- a member's own `self.x` carries the same promise ---
#
# The receiver is not proven to be an instance of the class (a method value
# can be moved onto a foreign object), so the read verifies the tag the
# declaration promised, exactly as it does through a parameter.

class Own {
  f: Float
  new(f) {
    self.f = f
  }
  doubled() {
    self.f * 2.0
  }
  sum(n) {
    mut acc = 0.0
    for _ in 0..n {
      acc += self.f
    }
    acc
  }
}

let own = Own(1.5)
assert_eq(own.doubled(), 3.0)
assert_eq(own.sum(4), 6.0)

# a method value read off an instance stays bound to it, so moving one onto
# another object does not give the body a foreign `self`
let borrowed = {class: 'Own', f: 'not a float', doubled: own.doubled}
assert_eq(borrowed.doubled(), 3.0)


# --- a class-typed field carries the class to the next step ---
#
# `self.engine.rpm` and `let e = self.engine; e.rpm` are the same question
# asked twice: the first step's declared type names a class, and that class
# says what `rpm` is.

class Engine {
  rpm: Float
  gear: Long
  new() {
  }
}

class Vehicle {
  engine: Engine
  speed: Float
  new() {
    self.engine = Engine()
  }
  chained() {
    self.engine.rpm + self.speed
  }
  through_local() {
    let e = self.engine
    e.rpm + e.gear
  }
}

let v = Vehicle()
assert_eq(v.chained(), 0.0)
assert_eq(v.through_local(), 0.0)

v.engine.rpm = 12.5
v.speed = 2.5
assert_eq(v.chained(), 15.0)

# the same contract at the far end of the chain
assert_throws('TypeError', fn () {
  v.engine.rpm = 'no'
})

# and the near end is checked too, so what the second step reads is what
# the first step's class says: a vehicle given something else is refused
# where it is given, not where a reader would have trusted it
let swapped = try {
  v.engine = Bike(3)
} catch e {
  e.message
}
assert_eq(swapped, "type error: field 'engine' expects Engine")
assert_eq(v.through_local(), 12.5)


# --- a local's own annotation carries the same promise ---
#
# `let a: Vec = <anything>` is checked at the declaration (§14), so the name
# means an instance of that class from here on. This is the one route that
# reaches an array element, which carries no type of its own.

class Pt {
  x: Float
  y: Float
  new(x, y) {
    self.x = x
    self.y = y
  }
}

let pts = [Pt(1.0, 2.0), Pt(3.0, 4.0)]

fn sum_first(list) {
  let a: Pt = list[0]
  a.x + a.y
}

assert_eq(sum_first(pts), 3.0)

# the declaration's own check refuses anything else, so the reads below it
# never meet a value the annotation did not promise
assert_throws('TypeError', fn () {
  let bad: Pt = 42
  bad.x
})

# an object wearing the class's name is not an instance of it, so the
# declaration's own check refuses it
assert_throws('TypeError', fn () {
  let forged: Pt = {class: 'Pt', x: 'no', y: 0.0}
  forged.x
})

# --- a compound step reads the field the way a plain read does ---

class Counter {
  n: Long
  f: Float
  new() {
  }
  tick(k) {
    for _ in 0..k {
      self.n += 1
      self.f += 0.5
    }
  }
}

let ctr = Counter()
ctr.tick(4)
assert_eq(ctr.n, 4)
assert_eq(ctr.f, 2.0)

fn nudge(p: Pt) {
  p.x += 1.0
  p.x
}

assert_eq(nudge(Pt(1.0, 2.0)), 2.0)

# the forgery the plain read refuses, refused at the compound read too
let r_forged_step = try {
  let forged: Pt = {class: 'Pt', x: 'no', y: 0.0}
  forged.x += 1.0
  nil
} catch e {
  e
}
let r_forged_read = try {
  let forged: Pt = {class: 'Pt', x: 'no', y: 0.0}
  forged.x
} catch e {
  e
}
assert_eq(r_forged_step.kind, 'TypeError')
assert_eq(r_forged_step.message, r_forged_read.message)

# --- a write site that has already succeeded still checks the next one ---

let warm = Fields()
let set_n = fn (x) {
  warm.n = x
}
for k in 0..3 {
  set_n(k)
}
assert_eq(warm.n, 2)
assert_throws('TypeError', fn () {
  set_n(1.5)
})
assert_eq(warm.n, 2)
# a field checked by its annotation's name, the same
let set_car = fn (c) {
  garage.car = c
}
for k in 0..3 {
  set_car(Car(to_float(k)))
}
let late = try {
  set_car(Bike(1))
} catch e {
  e.message
}
assert_eq([late, garage.car.speed],
          ["type error: field 'car' expects Car", 2.0])
let frozen = {n: 1}
let set_frozen = fn (o) {
  o.n = 2
}
for _ in 0..3 {
  assert_throws('ImmutableError', fn () {
    set_frozen(frozen)
  })
}
assert_eq(frozen.n, 1)

# --- a name two classes carry settles only what they agree on ---
#
# An annotation is checked by the class's name, so an instance of any class
# of that name passes it. A name the program gives to more than one class
# therefore settles only the fields all of them declare with the same type,
# and a class's own members read `self` by their own declaration, whatever
# else carries the name.

class Twice {
  n: Float
  new(n) {
    self.n = n
  }
}

fn twice_inner(k) {
  class Twice {
    n: Long
    new(n) {
      self.n = n
    }
    own() {
      self.n
    }
  }
  Twice(k)
}

fn read_twice(t: Twice) {
  t.n
}

fn twice_local(x) {
  let t: Twice = x
  t.n
}

class TwiceBox {
  held: Twice
  new(held) {
    self.held = held
  }
  inner() {
    let t = self.held
    t.n
  }
}

# an instance of either passes the check, and each reads as what it is:
# through a parameter, a local's annotation, and a class-typed field
assert_eq(read_twice(Twice(1.5)), 1.5)
assert_eq(read_twice(twice_inner(7)), 7)
assert_eq(twice_local(Twice(2.5)), 2.5)
assert_eq(twice_local(twice_inner(8)), 8)
assert_eq(TwiceBox(Twice(3.5)).inner(), 3.5)
assert_eq(TwiceBox(twice_inner(9)).inner(), 9)
assert_eq(twice_inner(7).own(), 7)

# each still checks its own writes
assert_throws('TypeError', fn () {
  Twice('no')
})
assert_throws('TypeError', fn () {
  twice_inner(1.5)
})

# a third class of the name that declares no type is not held to another's
fn twice_untyped() {
  class Twice {
    new(n) {
      self.n = n
    }
    own() {
      self.n
    }
  }
  Twice('text').own()
}

assert_eq(twice_untyped(), 'text')

# nor is a class named as one of the stdlib's read by the stdlib's
# declaration (a function's own, so that no other file's `Vector2` is this)
fn own_vector2() {
  class Vector2 {
    new(x) {
      self.x = x
    }
  }
  fn first(v: Vector2) {
    v.x
  }
  [first(Vector2('text')), first(Vector2(3))]
}

assert_eq(own_vector2(), ['text', 3])

# and across modules: an imported module's own `Vector2` does not decide how
# the stdlib's is read here, nor the stdlib's how that module reads its own
fn stdlib_x(v: Vector2) {
  v.x
}

assert_eq(stdlib_x(Vector2(1.5, 2.5)), 1.5)
assert_eq(stdlib_x(tf_dep.cell()), 3)
assert_eq(tf_dep.cell_x(tf_dep.cell()), 3)
assert_eq(tf_dep.cell_x(Vector2(1.5, 2.5)), 1.5)

# a class is not all that carries a name: an annotation also admits a class
# of the stdlib's that is not a value, an enum, a variant, and whatever
# conforms to a trait
trait CarriedShape {
  area()
}

enum CarriedKind {
  CarriedDot(String),
  CarriedLine(String),
}

fn carried_own() {
  class StateMachine {
    context: Long
    new(n) {
      self.context = n
    }
  }
  class CarriedShape {
    w: Float
    new(w) {
      self.w = w
    }
  }
  class CarriedKind {
    _0: Long
    new(n) {
      self._0 = n
    }
  }
  class CarriedDot {
    _0: Long
    new(n) {
      self._0 = n
    }
  }
  [StateMachine(7), CarriedShape(1.5), CarriedKind(4), CarriedDot(5)]
}

class CarriedLabel {
  new(w) {
    self.w = w
  }
  area() {
    0
  }
}

fn carried_context(m: StateMachine) {
  m.context
}

fn carried_width(s: CarriedShape) {
  s.w
}

fn carried_payload(k: CarriedKind) {
  k._0
}

fn carried_dot(d: CarriedDot) {
  d._0
}

let carried = carried_own()
let carried_machine = StateMachine.new(
  {
    off: {initial: true, on: {flip: {target: 'on'}}},
    on: {on: {flip: {target: 'off'}}},
  },
  context: 'door',
)
assert_eq(carried_context(carried[0]), 7)
assert_eq(carried_context(carried_machine), 'door')
assert_eq(carried_width(carried[1]), 1.5)
assert_eq(carried_width(CarriedLabel('wide')), 'wide')
assert_eq(carried_payload(carried[2]), 4)
assert_eq(carried_payload(CarriedKind.CarriedLine('l')), 'l')
assert_eq(carried_dot(carried[3]), 5)
assert_eq(carried_dot(CarriedKind.CarriedDot('d')), 'd')

# nor is a built-in type's name a class's alone: a range is a `Range`
fn carried_builtin() {
  class Range {
    start: Float
    new(start) {
      self.start = start
    }
  }
  fn first(r: Range) {
    r.start
  }
  [first(Range(1.5)), first(2..5)]
}

assert_eq(carried_builtin(), [1.5, 2])

# but a primitive type's name is that type's alone: a program's own class of
# the name passes no annotation of it, as a field typed with it refuses one,
# so the tag a typed parameter settles on is the value's own
fn primitive_thrown(f) {
  try {
    f()
  } catch e {
    e.message
  }
}

fn primitive_long() {
  class Long {
    new(.v) {}
  }
  fn add_one(x: Long) {
    x + 1
  }
  fn made() -> Long {
    Long(2.5)
  }
  [add_one(2), primitive_thrown(|| add_one(Long(2.5))),
   primitive_thrown(made), primitive_thrown(fn () { let y: Long = Long(2.5) })]
}

fn primitive_set() {
  class Set {
    new(.n) {}
  }
  fn first(s: Set) {
    s.n
  }
  primitive_thrown(|| first(Set(3)))
}

# `Function` takes a callable instance, and still no class of the name
fn primitive_function() {
  class Function {
    new(.v) {}
  }
  class Doubler {
    __call__(x) {
      x * 2
    }
  }
  fn take(f: Function) {
    f(21)
  }
  [take(Doubler()), primitive_thrown(|| take(Function(1)))]
}

assert_eq(primitive_long(), [3, 'no matching method for `add_one`',
                             'type error: return value expects Long',
                             'type error: assignment expects Long'])
assert_eq(primitive_set(), 'no matching method for `first`')
assert_eq(primitive_function(), [42, "type error: parameter 'f' expects Function"])

# a library function's typed parameter is read the same way
fn primitive_array() {
  class Array {
    new(.n) {}
  }
  primitive_thrown(|| Random.shuffle(Array(1)))
}

assert_eq(primitive_array(), "type error: parameter 'a' expects Array")

# a variant of the name is no such value either, and a multimethod picks by
# what the value is; a constructor pattern still names the variant, and a trait
# of the name still lends its defaults
trait Tuple {
  builtin_items()
  builtin_count() {
    self.builtin_items().size()
  }
}

fn primitive_variants() {
  enum Json {
    Long(Long),
    String(String),
    Object(Object),
  }
  fn describe(v) {
    match v {
      Object(o) => 'object',
      Long(n) => "long {n}",
      String(s) => "str {s}",
      _ => 'other',
    }
  }
  fn pick(x: Long) {
    'long'
  }
  fn pick(x: Json) {
    'json'
  }
  fn pick(x: Object) {
    'object'
  }
  class Bag {
    builtin_items() {
      [1, 2, 3]
    }
  }
  [describe(Json.Long(3)), describe(Json.String('a')), describe({_0: 1}),
   pick(3), pick(Json.Long(3)), pick(Json.Object({})), Bag().builtin_count()]
}

assert_eq(primitive_variants(),
          ['long 3', 'str a', 'other', 'long', 'json', 'json', 3])

# what lends a trait's defaults is conforming to it, not carrying its name
trait BuiltinLender {
  builtin_need()
  builtin_lent() {
    'lent'
  }
}

fn named_like_a_trait() {
  enum BuiltinLender {
    Dot,
  }
  primitive_thrown(|| BuiltinLender.Dot.builtin_lent())
}

assert_eq(named_like_a_trait(),
          "type error: expected Function, got Nil ('builtin_lent' is not a method of Dot)")

# a field annotated with the class's own type parameter names no class,
# whatever else is called that
class CarriedItem {
  price: Float
  new(price) {
    self.price = price
  }
}

class CarriedSlot<CarriedItem> {
  held: CarriedItem
  new(held) {
    self.held = held
  }
  price() {
    let h = self.held
    h.price
  }
}

class CarriedCoupon {
  new(price) {
    self.price = price
  }
}

assert_eq(CarriedSlot(CarriedItem(1.5)).price(), 1.5)
assert_eq(CarriedSlot(CarriedCoupon('free')).price(), 'free')

println('typed fields OK')
