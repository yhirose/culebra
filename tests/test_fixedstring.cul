// FixedString<N>: a fixed-capacity inline UTF-8 string field on a @packable
// record — `[len:i32][byte × N]`, read/written as a whole String (a VARCHAR(N)).

@packable
class Row {
  id: Int32
  name: FixedString<16>
}

buf = SharedBuffer.new(3, Row)

// Whole-value write + read, alongside a scalar field.
buf[0].id = 7
buf[0].name = "alice"
assert_eq(buf[0].id, 7)
assert_eq(buf[0].name, "alice")

// Zero value is the empty string (ftruncate/zero-init).
assert_eq(buf[1].name, "")

// Overwrite shrinks/grows within capacity; the stored len bounds the read.
buf[0].name = "bob"
assert_eq(buf[0].name, "bob")
assert_eq(buf[0].name.size(), 3)

// The read is a real String — all String methods work on it.
buf[2].name = "Carol"
assert_eq(buf[2].name.upper(), "CAROL")
assert_eq(buf[2].name[0..1], "C")

// Capacity is bytes; exactly N fits, N+1 raises CapacityError.
buf[0].name = "0123456789abcdef"          // 16 bytes, fits
assert_eq(buf[0].name, "0123456789abcdef")
try {
  buf[0].name = "0123456789abcdefg"       // 17 bytes
  assert_eq("no throw", "should have thrown")
} catch e {
  assert_eq(e.kind, "CapacityError")
}

// Wrong type is a TypeError.
try {
  buf[1].name = 42
  assert_eq("no throw", "should have thrown")
} catch e {
  assert_eq(e.kind, "TypeError")
}

// Records are independent; writing one does not disturb another.
buf[0].name = "x"
buf[1].name = "y"
buf[2].name = "z"
assert_eq(buf[0].name, "x")
assert_eq(buf[1].name, "y")
assert_eq(buf[2].name, "z")

// Cross-isolate share: a child isolate writes FixedString fields into the
// shared backing bytes (zero copy), the parent reads them back.
shared = SharedBuffer.new(2, Row)
worker = Isolate.spawn(fn() {
  shared[0].name = "from_child"
  shared[1].name = "second"
})
worker.join()
assert_eq(shared[0].name, "from_child")
assert_eq(shared[1].name, "second")

IO.puts("test_fixedstring OK")
