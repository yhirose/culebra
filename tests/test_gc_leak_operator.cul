// Leak repro [A] — overloaded-operator dispatch leaks both operands (JIT).
// Task #1 / _culebra_invoke_method1. EXPECTED RED on --jit until the GC
// rewrite (Task #5); clean on interp. Do not delete — green is the rewrite's job.
fn measure(work) {
  work()
  let base = GC.stat().live_objects
  mut i = 0
  while i < 30 {
    work()
    i = i + 1
  }
  GC.stat().live_objects - base
}
class Num {
  new(d) {
    self.data = d
  }
  __add__(o) {
    Num.new(self.data + o.data)
  }
}
assert_lt(measure(fn () {
  mut acc = Num.new(0)
  mut k = 0
  while k < 200 {
    acc = acc + Num.new(k)
    k = k + 1
  }
  acc.data
}), 200)
inspect("gc leak [operator]: no leak")
