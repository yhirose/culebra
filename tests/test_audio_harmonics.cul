// Audio.harmonics: a sound's harmonics along its pitch, and what is left
// without them, on tones whose harmonics are known.
let rate = 44100
let REED = [0.3, 0.45, 0.25, 0.2, 0.15, 0.1, 0.08, 0.05]
let db = |a, b| 20.0 * Math.log(a / b) / Math.log(10.0)
// How far under the power of `xs` the power of `rest` is, in dB.
let under = |rest, xs| 10.0 * Math.log(rest.map(|v| v * v).sum() / xs.map(|v| v * v).sum()) / Math.log(10.0)

// A tone `seconds` long at freq(t) (a point every 5 ms), its harmonics
// `amps`, and its pitch every 10 ms as Audio.pitch would answer it.
fn tone(seconds, freq, amps, r = rate) {
  let points = iota(Math.round(seconds / 0.005) + 1).map(|i| (i * 0.005, freq(i * 0.005)))
  Audio.partials(seconds, points, [(0.0, amps)], rate: r)
}
let track = |seconds, freq| iota(Math.ceil(seconds * 100)).map(|t| freq(t * 0.01))

// A row for each pitch given, `count` amplitudes (40 if not named) as
// Audio.partials takes them: a steady tone's within a hundredth of a dB from
// its second frame on (the first reads half a window of silence before the
// samples), and what is left without them 65 dB under the tone to its end
// (the last frame's harmonics hold past its middle).
let steady = tone(1.0, |_| 440.0, REED)
let held = Audio.harmonics(steady, track(1.0, |_| 440.0), count: 8)
assert_eq((held.harmonics.size(), held.rest.size()), (100, 44100))
assert_true(held.harmonics.all(|row| row.size() == 8))
assert_true(iota(1, 100).all(|t| iota(8).all(|k| Math.abs(db(held.harmonics[t][k], REED[k])) < 0.01)))
assert_true(under(held.rest.slice(441, 44100), steady.slice(441, 44100)) < -65.0)
assert_eq(Audio.harmonics(steady, [440.0]).harmonics[0].size(), 40)

// Harmonics past 0.45 of the rate are 0.0, the row still `count` long.
let high = Audio.harmonics(tone(0.5, |_| 3000.0, REED), track(0.5, |_| 3000.0), count: 10)
assert_true(high.harmonics.all(|row| row.size() == 10 && row.slice(6, 10).all(|a| a == 0.0)))
assert_true(iota(1, 50).all(|t| Math.abs(db(high.harmonics[t][5], REED[5])) < 0.01))

// A vibrato of 30 cents: across each frame the pitch moves to its
// neighbours', so the harmonics read within 0.05 dB and leave 60 dB under
// the tone in the rest (held across the frame, 0.2 dB and 30 dB, as loud
// as a saxophone's breath). The last frame, with no neighbour after it,
// holds its pitch.
let wave = |t| 880.0 * 2.0 ** (0.3 / 12.0 * Math.sin(2.0 * Math.pi * 5.5 * t))
let vibrato = tone(1.0, wave, REED)
let moving = Audio.harmonics(vibrato, track(1.0, wave), count: 8)
assert_true(iota(1, 99).all(|t| iota(8).all(|k| Math.abs(db(moving.harmonics[t][k], REED[k])) < 0.05)))
assert_true(under(moving.rest.slice(441, 43218), vibrato.slice(441, 43218)) < -50.0)

// A frame without a pitch has none; the rest is the samples themselves
// where no pitched frame reaches. Frame t is about t * 10 ms: one about a
// tone's start reads about half its harmonics (6 dB down, within 0.7), its
// window of 20 ms half silent.
let late = [...repeat(22050, 0.0), ...tone(0.5, |_| 440.0, REED)]
let after = Audio.harmonics(late, iota(100).map(|t| t < 50 ? nil : 440.0), count: 8)
assert_true(iota(50).all(|t| after.harmonics[t] == nil))
assert_eq(after.rest.slice(0, 21610), late.slice(0, 21610))
assert_true(iota(8).all(|k| Math.abs(db(after.harmonics[50][k], REED[k]) + 6.0) < 0.7))
assert_true(iota(51, 100).all(|t| iota(8).all(|k| Math.abs(db(after.harmonics[t][k], REED[k])) < 0.01)))

// The rate is the samples'.
let at48 = Audio.harmonics(tone(0.5, |_| 330.0, REED, r: 48000), track(0.5, |_| 330.0), count: 8, rate: 48000)
assert_true(iota(8).all(|k| Math.abs(db(at48.harmonics[25][k], REED[k])) < 0.05))

assert_eq(Audio.harmonics([], []), {harmonics: [], rest: []})
assert_throws("TypeError", fn () {
  Audio.harmonics([0.0], ["440"])
})
for (f0, count, r) in [([19.9], 40, rate), ([22050.0], 40, rate), ([nil], 0, rate), ([nil], 65537, rate), ([nil], 40, 0)] {
  assert_throws("ValueError", fn () {
    Audio.harmonics([0.0], f0, count, r)
  })
}

print("audio harmonics ok\n")
