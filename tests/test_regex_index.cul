// Indexing a Regex match: `m[i]` / `m["name"]` read the captures, while the
// dot reads the match's own record (value, start, groups).

let m = Regex.compile('(\d+)-(\d+)').find("12-34")

// Positional groups: m[0] is the whole match, m[1..] each group, as Strings.
assert_eq([m[0], m[1], m[2]], ["12-34", "12", "34"])

// A negative index wraps, as an Array's does.
assert_eq([m[-1], m[-2]], ["34", "12"])

// Out of range is nil, not an error, so it composes with ??.
assert_eq(m[9], nil)
assert_eq(m[9] ?? "none", "none")

// The dot still reads the record.
assert_eq(m.value, "12-34")
assert_eq(m.start, 0)
assert_eq(m.groups[1].start, 0)

// Named groups: m["name"]
let d = Regex.compile('(?<y>\d{4})-(?<mo>\d{2})').find("2026-06")
assert_eq([d["y"], d["mo"]], ["2026", "06"])
assert_eq(d["nope"], nil)
// `[]` reads only captures, never a property.
assert_eq(d["value"], nil)

// An optional group that did not take part is nil.
let o = Regex.compile('(a)(b)?').find("a")
assert_eq(o[1], "a")
assert_eq(o[2], nil)
