# LLM against a stand-in for the Messages API: an Http.server in an Isolate
# that answers by `model`, so each case is one request away, and that sends a
# streamed request the same message as events. No network, no key.

# --- the stand-in -------------------------------------------------------------

fn text(t) {
  {type: "text", text: t}
}

fn call(name, input) {
  {type: "tool_use", id: "toolu_1", name: name, input: input}
}

fn message(content, stop) {
  {id: "msg_1", type: "message", role: "assistant", model: "stand-in",
   content: content, stop_reason: stop, stop_sequence: nil,
   usage: {input_tokens: 3, output_tokens: 5}}
}

fn halves(s) {
  let cut = s.size() / 2
  [to_string(s.slice(0, cut)), to_string(s.slice(cut, s.size()))]
}

fn frame(kind, data) {
  "event: {kind}\ndata: {JSON.stringify(data)}\n\n"
}

fn delta(i, d) {
  frame("content_block_delta", {type: "content_block_delta", index: i, delta: d})
}

# A message as the stream says it: every text and argument in two pieces, and
# a thinking block's signature in a delta of its own.
fn events_of(msg) {
  mut out = [frame("message_start", {type: "message_start",
    message: {...msg, content: [], stop_reason: nil,
              usage: {input_tokens: 3, output_tokens: 1}}})]
  for i, b in msg.content.enumerate() {
    let t = b.type
    let start = cond {
      t == "text" => {type: "text", text: ""},
      t == "thinking" => {type: "thinking", thinking: "", signature: ""},
      t == "tool_use" => {...b, input: {}},
      _ => b,
    }
    out.push(frame("content_block_start",
      {type: "content_block_start", index: i, content_block: start}))
    if t == "text" {
      for piece in halves(b.text) {
        out.push(delta(i, {type: "text_delta", text: piece}))
      }
      for c in b.get("citations", []) {
        out.push(delta(i, {type: "citations_delta", citation: c}))
      }
    } else if t == "thinking" {
      for piece in halves(b.thinking) {
        out.push(delta(i, {type: "thinking_delta", thinking: piece}))
      }
      out.push(delta(i, {type: "signature_delta", signature: b.signature}))
    } else if t == "tool_use" {
      for piece in halves(JSON.stringify(b.input)) {
        out.push(delta(i, {type: "input_json_delta", partial_json: piece}))
      }
    }
    out.push(frame("content_block_stop", {type: "content_block_stop", index: i}))
  }
  out.push(frame("message_delta", {type: "message_delta",
    delta: {stop_reason: msg.stop_reason, stop_sequence: nil},
    usage: {output_tokens: 5}}))
  out.push(frame("message_stop", {type: "message_stop"}))
  out
}

fn tool_results(m) {
  type_of(m.content) == "Array"
    ? m.content.filter(|b| b.get("type", "") == "tool_result")
    : []
}

# What each model answers. A tool model calls the first tool it was handed,
# and once a result comes back says what the result was.
fn reply(body, headers) {
  let m = body.model
  let last = body.messages[body.messages.size() - 1]
  let results = tool_results(last)
  let first_tool = body.has("tools") ? body.tools[0].name : "none"
  cond {
    m == "echo" => message([text(JSON.stringify({
      system: body.get("system", nil), max_tokens: body.max_tokens,
      turns: body.messages.size(), key: headers["x-api-key"],
      version: headers["anthropic-version"], beta: headers.get("anthropic-beta", nil),
      tools: body.get("tools", []).map(|t| t.name)}))], "end_turn"),
    m == "story" => message([text("once upon a time")], "end_turn"),
    # The request body as it came, to see what was sent.
    m == "record" => message([text(JSON.stringify(body))], "end_turn"),
    m == "cited" => message([{type: "text", text: "the sky is blue",
      citations: [{type: "char_location", cited_text: "sky", document_index: 0,
                   start_char_index: 0, end_char_index: 3}]}], "end_turn"),
    (m == "tool" || m == "unknown") && !results.empty() => {
      let r = results[0]
      message([text("done: {r.content}" + (r.get("is_error", false) ? " (error)" : ""))],
              "end_turn")
    },
    m == "tool" => message([text("checking "), call(first_tool, {city: "Tokyo"})], "tool_use"),
    m == "unknown" => message([call("nope", {})], "tool_use"),
    m == "loop" => message([call(first_tool, {city: "Tokyo"})], "tool_use"),
    m == "cut" => message([call(first_tool, {city: "To"})], "max_tokens"),
    m == "long" => message([text("half an ans")], "max_tokens"),
    m == "refuse" => {...message([], "refusal"),
      stop_details: {type: "refusal", category: "cyber", explanation: "not this"}},
    m == "think" && body.messages.size() == 1 =>
      message([{type: "thinking", thinking: "let me see", signature: "sig-1"},
               text("first")], "end_turn"),
    m == "think" => {
      let kept = body.messages[1].content[0]
      message([text(kept == {type: "thinking", thinking: "let me see",
                             signature: "sig-1"} ? "kept" : "lost")], "end_turn")
    },
    _ => message([text("model {m}")], "end_turn"),
  }
}

let (tx, rx) = Channel.new(1)
let iso = Isolate.spawn(fn () {
  let srv = Http.server()
  srv.post("/v1/messages", fn (req) {
    let body = JSON.parse(req.body)
    let m = body.model
    if m == "busy" {
      return {status: 529, content_type: "application/json",
              body: '{"type":"error","error":{"type":"overloaded_error","message":"busy"}}'}
    }
    if m == "gateway" {
      return {status: 502, content_type: "text/html", body: "<h1>bad gateway</h1>"}
    }
    let msg = reply(body, req.headers)
    # `nostream` answers whole even when asked to stream, as a server that
    # ignores the flag does.
    if body.get("stream", false) && m != "nostream" {
      return {content_type: "text/event-stream", stream: fn (sink) {
        for f in events_of(msg) {
          sink.write(f)
        }
      }}
    }
    {content_type: "application/json", body: JSON.stringify(msg)}
  })
  tx.send(srv.bind(0))
  tx.drop()
  srv.serve()
})
tx.drop()
let BASE = "http://127.0.0.1:{rx.recv()}"

let PROVIDER = LLM.anthropic(api_key: "test-key", base_url: BASE)

fn opts(model) {
  {provider: PROVIDER, model: model}
}

# What a call raised, as "Kind: message".
fn failure(thunk) {
  try {
    thunk()
    "no error"
  } catch e {
    "{e.kind}: {e.message}"
  }
}

# --- one question ---------------------------------------------------------------

# The request carries the model, the default max_tokens, the key and the
# version header; system goes in a field of its own.
assert_eq(LLM.ask("hi", **opts("echo")),
  '{"system":null,"max_tokens":16000,"turns":1,"key":"test-key","version":"2023-06-01","beta":null,"tools":[]}')
assert_eq(JSON.parse(LLM.ask("hi", system: "be brief", max_tokens: 100, **opts("echo"))).system,
          "be brief")

# Streamed, the answer arrives in pieces and adds up to the same text.
let pieces = []
let streamed = LLM.ask("hi", on_text: |t| pieces.push(t), **opts("story"))
assert_eq(streamed, "once upon a time")
assert_eq(pieces, ["once upo", "n a time"])

# A server that answers whole when asked to stream: the whole answer, heard once.
let whole = []
assert_eq(LLM.ask("hi", on_text: |t| whole.push(t), **opts("nostream")), "model nostream")
assert_eq(whole, ["model nostream"])

# Cut off at max_tokens, the text is still the answer; `last` says why.
let long = LLM.chat(**opts("long"))
assert_eq(long.ask("go"), "half an ans")
assert_eq(long.last.stop, "length")

# --- tools ------------------------------------------------------------------------

mut asked = []
fn weather(city: String, days: Long = 1) {
  asked.push(city)
  "{city}: sunny"
}
let weather_tool = LLM.tool(weather, "the weather in a city", city: "a city name")

# The model asks, the tool runs with the arguments as keywords, the result goes
# back, and the answer is the last turn's text. Every turn is in the history.
for on_text in [nil, |t| nil] {
  asked = []
  let c = LLM.chat(tools: [weather_tool], **opts("tool"))
  assert_eq(c.ask("weather?", on_text: on_text), "done: Tokyo: sunny")
  assert_eq(asked, ["Tokyo"])
  assert_eq(c.messages.map(|m| m.role), ["user", "assistant", "tool", "assistant"])
  assert_eq(c.messages[1].content[1], {type: "tool_call", id: "toolu_1", name: "weather",
                                        args: {city: "Tokyo"}})
  assert_eq(c.messages[2], {role: "tool", content: [{type: "tool_result", id: "toolu_1",
                                                      content: "Tokyo: sunny", is_error: false}]})
  assert_eq(c.last.stop, "end")
}

# The tools go out by name, description and schema.
assert_eq(JSON.parse(LLM.chat(tools: [weather_tool], **opts("echo")).ask("hi")).tools,
          ["weather"])

# What a tool throws goes back to the model as an error it can act on.
fn broken(city: String) {
  __raise("ValueError", "no data for {city}")
}
let broken_chat = LLM.chat(tools: [LLM.tool(broken, "fails")], **opts("tool"))
assert_eq(broken_chat.ask("weather?"), "done: ValueError: no data for Tokyo (error)")

# A tool the model names that does not exist is answered the same way.
let unknown = LLM.chat(tools: [weather_tool], **opts("unknown"))
assert_eq(unknown.ask("weather?"), "done: no tool named 'nope' (error)")

# --- failures leave the conversation as it was ------------------------------------

asked = []
let cut = LLM.chat(tools: [weather_tool], **opts("cut"))
assert_eq(failure(|| cut.ask("weather?")),
          "LLMError: LLM: a tool call was cut off at max_tokens")
assert_eq(asked, [])
assert_eq(cut.messages, [])

let loop = LLM.chat(tools: [weather_tool], max_turns: 2, **opts("loop"))
assert_eq(failure(|| loop.ask("weather?")), "LLMError: LLM: no answer within max_turns (2)")
assert_eq(loop.messages, [])

assert_eq(failure(|| LLM.ask("hi", **opts("refuse"))),
          "LLMError: LLM: the model declined to answer: not this")
assert_eq(failure(|| LLM.ask("hi", **opts("busy"))),
          "LLMError: LLM: 529 overloaded_error: busy")
assert_eq(failure(|| LLM.ask("hi", on_text: |t| nil, **opts("busy"))),
          "LLMError: LLM: 529 overloaded_error: busy")
assert_eq(failure(|| LLM.ask("hi", **opts("gateway"))),
          "LLMError: LLM: 502 <h1>bad gateway</h1>")

# A failed ask after a good one keeps the good one.
let mixed = LLM.chat(**opts("story"))
mixed.ask("first")
mixed.model = "busy"
assert_throws("LLMError", || mixed.ask("second"))
assert_eq(mixed.messages.size(), 2)

# An LLMError is caught by its kind.
assert_eq(try { LLM.ask("hi", **opts("busy")) } catch LLMError { "caught" }, "caught")

# --- thinking goes back as it came -------------------------------------------------

for on_text in [nil, |t| nil] {
  let thinker = LLM.chat(**opts("think"))
  assert_eq(thinker.ask("one", on_text: on_text), "first")
  assert_eq(thinker.ask("two", on_text: on_text), "kept")
}

# --- the request as it is ----------------------------------------------------------

let raw = LLM.request({model: "story", max_tokens: 10,
                       messages: [{role: "user", content: "hi"}]},
                      provider: PROVIDER)
assert_eq([raw.id, raw.content[0].text], ["msg_1", "once upon a time"])

# A header a body cannot carry, such as a beta's, rides along.
let with_beta = LLM.request({model: "echo", max_tokens: 10,
                             messages: [{role: "user", content: "hi"}]},
                            provider: PROVIDER, headers: {"anthropic-beta": "some-beta-2026-01-01"})
assert_eq(JSON.parse(with_beta.content[0].text).beta, "some-beta-2026-01-01")

# --- LLM.turn with the Messages API as a provider ----------------------------------------

# In a function of its own: the same lines flat took a fifth more --jit compile
# than this file's flat ones, since a flat script is one JIT function.
fn an_cases() {
  let an_p = LLM.anthropic(api_key: "test-key", base_url: BASE)
  assert_eq([an_p.name, an_p.capabilities, an_p.default_model],
            ["anthropic", {tools: true, extra: true}, nil])

  fn an_user(t) {
    {role: "user", content: t}
  }
  fn an_say(t) {
    {role: "assistant", content: [{type: "text", text: t}]}
  }
  fn an_call(id, args) {
    {type: "tool_call", id: id, name: "weather", args: args}
  }
  fn an_result(id, content, is_error = false) {
    {role: "tool", content: [{type: "tool_result", id: id, content: content, is_error: is_error}]}
  }
  fn an_kept(block, kind, text) {
    {type: kind, text: text, format: "anthropic", opaque: block}
  }

  # The body sent for histories of every shape, as the old path recorded it (the
  # stand-in answers "record" with the body it was sent).
  let AN_BODIES = {
    plain: '{"model":"record","max_tokens":16000,"messages":[{"role":"user","content":"hi"},{"role":"assistant","content":[{"type":"text","text":"hello"}]},{"role":"user","content":"next"}]}',
    system: '{"model":"record","max_tokens":16000,"messages":[{"role":"user","content":"hi"},{"role":"assistant","content":[{"type":"text","text":"hello"}]},{"role":"user","content":"next"}],"system":"be brief"}',
    thinking: '{"model":"record","max_tokens":16000,"messages":[{"role":"user","content":"one"},{"role":"assistant","content":[{"type":"thinking","thinking":"let me see","signature":"sig-1"},{"type":"text","text":"first"}]},{"role":"user","content":"next"}]}',
    redacted_thinking: '{"model":"record","max_tokens":16000,"messages":[{"role":"user","content":"one"},{"role":"assistant","content":[{"type":"redacted_thinking","data":"opaque-bytes"},{"type":"text","text":"first"}]},{"role":"user","content":"next"}]}',
    citations: '{"model":"record","max_tokens":16000,"messages":[{"role":"user","content":"one"},{"role":"assistant","content":[{"type":"text","text":"the sky is blue","citations":[{"type":"char_location","cited_text":"sky","document_index":0,"start_char_index":0,"end_char_index":3}]}]},{"role":"user","content":"next"}]}',
    tool_use_result: '{"model":"record","max_tokens":16000,"messages":[{"role":"user","content":"weather?"},{"role":"assistant","content":[{"type":"text","text":"checking "},{"type":"tool_use","id":"toolu_1","name":"weather","input":{"city":"Tokyo"}}]},{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_1","content":"Tokyo: sunny","is_error":false}]},{"role":"assistant","content":[{"type":"text","text":"sunny"}]},{"role":"user","content":"next"}],"tools":[{"name":"weather","description":"the weather in a city","input_schema":{"type":"object","properties":{"city":{"type":"string","description":"a city name"},"days":{"type":"integer"}},"required":["city"]}}]}',
    parallel_tools: '{"model":"record","max_tokens":16000,"messages":[{"role":"user","content":"two cities?"},{"role":"assistant","content":[{"type":"tool_use","id":"toolu_1","name":"weather","input":{"city":"Tokyo"}},{"type":"tool_use","id":"toolu_2","name":"weather","input":{"city":"Osaka"}}]},{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_1","content":"Tokyo: sunny","is_error":false},{"type":"tool_result","tool_use_id":"toolu_2","content":"no data","is_error":true}]},{"role":"assistant","content":[{"type":"text","text":"done"}]},{"role":"user","content":"next"}],"tools":[{"name":"weather","description":"the weather in a city","input_schema":{"type":"object","properties":{"city":{"type":"string","description":"a city name"},"days":{"type":"integer"}},"required":["city"]}}]}',
    server_tool: '{"model":"record","max_tokens":16000,"messages":[{"role":"user","content":"search"},{"role":"assistant","content":[{"type":"server_tool_use","id":"srvtoolu_1","name":"web_search","input":{"query":"culebra"}},{"type":"web_search_tool_result","tool_use_id":"srvtoolu_1","content":[{"type":"web_search_result","url":"https://example.com","title":"t","encrypted_content":"enc"}]},{"type":"text","text":"found"}]},{"role":"user","content":"next"}]}',
  }
  fn an_sent(history, **opts) {
    LLM.turn(an_p, model: "record", messages: history + [an_user("next")], **opts).text
  }
  assert_eq(an_sent([an_user("hi"), an_say("hello")]), AN_BODIES.plain)
  assert_eq(an_sent([an_user("hi"), an_say("hello")], system: "be brief"), AN_BODIES.system)
  assert_eq(an_sent([an_user("one"), {role: "assistant", content: [
    an_kept({type: "thinking", thinking: "let me see", signature: "sig-1"}, "reasoning", "let me see"),
    {type: "text", text: "first"}]}]), AN_BODIES.thinking)
  assert_eq(an_sent([an_user("one"), {role: "assistant", content: [
    an_kept({type: "redacted_thinking", data: "opaque-bytes"}, "reasoning", ""),
    {type: "text", text: "first"}]}]), AN_BODIES.redacted_thinking)
  assert_eq(an_sent([an_user("one"), {role: "assistant", content: [
    an_kept({type: "text", text: "the sky is blue",
             citations: [{type: "char_location", cited_text: "sky", document_index: 0,
                          start_char_index: 0, end_char_index: 3}]}, "text", "the sky is blue")]}]),
    AN_BODIES.citations)
  assert_eq(an_sent([an_user("weather?"),
    {role: "assistant", content: [{type: "text", text: "checking "}, an_call("toolu_1", {city: "Tokyo"})]},
    an_result("toolu_1", "Tokyo: sunny"), an_say("sunny")], tools: [weather_tool]),
    AN_BODIES.tool_use_result)
  # Results in a tool message each are one user message of results.
  assert_eq(an_sent([an_user("two cities?"),
    {role: "assistant", content: [an_call("toolu_1", {city: "Tokyo"}), an_call("toolu_2", {city: "Osaka"})]},
    an_result("toolu_1", "Tokyo: sunny"), an_result("toolu_2", "no data", true), an_say("done")],
    tools: [weather_tool]), AN_BODIES.parallel_tools)
  assert_eq(an_sent([an_user("search"), {role: "assistant", content: [
    {type: "other", format: "anthropic", opaque: {type: "server_tool_use", id: "srvtoolu_1",
      name: "web_search", input: {query: "culebra"}}},
    {type: "other", format: "anthropic", opaque: {type: "web_search_tool_result",
      tool_use_id: "srvtoolu_1", content: [{type: "web_search_result", url: "https://example.com",
      title: "t", encrypted_content: "enc"}]}},
    {type: "text", text: "found"}]}]), AN_BODIES.server_tool)

  # What the API is asked beyond the history.
  let an_options = JSON.parse(an_sent([an_user("hi")], max_tokens: 50, stop: ["x"], temperature: 0.5,
    extra: {thinking: {type: "enabled", budget_tokens: 1024}}))
  assert_eq([an_options.max_tokens, an_options.stop_sequences, an_options.temperature, an_options.thinking],
            [50, ["x"], 0.5, {type: "enabled", budget_tokens: 1024}])
  let an_echo = JSON.parse(LLM.turn(an_p, model: "echo", messages: [an_user("hi")],
                                    system: "be brief", tools: [weather_tool]).text)
  assert_eq([an_echo.key, an_echo.version, an_echo.max_tokens, an_echo.system, an_echo.tools],
            ["test-key", "2023-06-01", 16000, "be brief", ["weather"]])
  # A leading system message is the same as system:.
  assert_eq(JSON.parse(LLM.turn(an_p, model: "echo",
            messages: [{role: "system", content: "be brief"}, an_user("hi")]).text).system, "be brief")

  # One step: the text, why it stopped and what it cost; streamed it is the same
  # reply, with the text in pieces on the way.
  let an_plain = LLM.turn(an_p, model: "story", messages: [an_user("hi")])
  assert_eq([an_plain.text, an_plain.stop, an_plain.usage, an_plain.tool_calls, an_plain.reasoning],
            ["once upon a time", "end", {input_tokens: 3, output_tokens: 5}, [], ""])
  assert_eq(an_plain.message, an_say("once upon a time"))
  assert_eq(an_plain.raw.id, "msg_1")
  let an_pieces = []
  let an_streamed = LLM.turn(an_p, model: "story", messages: [an_user("hi")],
                             on_text: |t| an_pieces.push(t))
  assert_eq(an_pieces, ["once upo", "n a time"])
  assert_eq(an_streamed, an_plain)
  # A server that answers whole when asked to stream: the reply is the same.
  let an_whole = []
  let an_nostream = LLM.turn(an_p, model: "nostream", messages: [an_user("hi")],
                             on_text: |t| an_whole.push(t))
  assert_eq([an_nostream.text, an_whole], ["model nostream", ["model nostream"]])

  # A call, its result and the answer: the loop is the program's.
  for on_text in [nil, |t| nil] {
    let history = [an_user("weather?")]
    let first = LLM.turn(an_p, model: "tool", messages: history, tools: [weather_tool], on_text: on_text)
    assert_eq([first.text, first.stop, first.tool_calls],
              ["checking ", "tool_calls", [{id: "toolu_1", name: "weather", args: {city: "Tokyo"}}]])
    history.push(first.message)
    history.push(an_result("toolu_1", "Tokyo: sunny"))
    let second = LLM.turn(an_p, model: "tool", messages: history, tools: [weather_tool], on_text: on_text)
    assert_eq([second.text, second.stop], ["done: Tokyo: sunny", "end"])
  }

  # A call cut off at max_tokens and a refusal are replies, whose stop says so.
  let an_cut = LLM.turn(an_p, model: "cut", messages: [an_user("hi")], tools: [weather_tool])
  assert_eq([an_cut.stop, an_cut.tool_calls], ["length", [{id: "toolu_1", name: "weather", args: {city: "To"}}]])
  let an_refused = LLM.turn(an_p, model: "refuse", messages: [an_user("hi")])
  assert_eq([an_refused.stop, an_refused.text, an_refused.message.content], ["refusal", "", []])

  # Thinking goes back as it came, and so does a quotation, streamed or not.
  for on_text in [nil, |t| nil] {
    let history = [an_user("one")]
    let first = LLM.turn(an_p, model: "think", messages: history, on_text: on_text)
    assert_eq([first.text, first.reasoning], ["first", "let me see"])
    history.push(first.message)
    history.push(an_user("two"))
    assert_eq(LLM.turn(an_p, model: "think", messages: history, on_text: on_text).text, "kept")

    let quoted = [an_user("one")]
    let cited = LLM.turn(an_p, model: "cited", messages: quoted, on_text: on_text)
    assert_eq(cited.text, "the sky is blue")
    quoted.push(cited.message)
    assert_eq(an_sent(quoted), AN_BODIES.citations)
  }

  # What the API refuses is an LLMError, and what the call lacks is refused first.
  assert_eq(failure(|| LLM.turn(an_p, model: "busy", messages: [an_user("hi")])),
            "LLMError: LLM: 529 overloaded_error: busy")
  assert_eq(failure(|| LLM.turn(an_p, model: "busy", messages: [an_user("hi")], on_text: |t| nil)),
            "LLMError: LLM: 529 overloaded_error: busy")
  assert_eq(failure(|| LLM.turn(an_p, model: "gateway", messages: [an_user("hi")])),
            "LLMError: LLM: 502 <h1>bad gateway</h1>")
  assert_eq(failure(|| LLM.turn(an_p, messages: [an_user("hi")])),
            "LLMError: LLM: model: is required for anthropic")
  assert_eq(failure(|| LLM.anthropic(api_key: "")),
            "LLMError: LLM: no API key: set ANTHROPIC_API_KEY or pass api_key:")
  assert_eq(failure(|| LLM.anthropic(api_key: 3)),
            "TypeError: type error: parameter 'api_key' expects String | Nil")
  assert_eq(failure(|| LLM.anthropic(api_key: "k", timeout: "9")),
            "TypeError: type error: parameter 'timeout' expects Long")

  # A chat keeps what the provider asked to have back, a quotation here, whether
  # the answer was streamed or not.
  for on_text in [nil, |t| nil] {
    let quoting = LLM.chat(**opts("cited"))
    assert_eq(quoting.ask("one", on_text: on_text), "the sky is blue")
    quoting.model = "record"
    let sent = JSON.parse(quoting.ask("next", on_text: on_text))
    assert_eq(sent.messages[1].content[0], JSON.parse(AN_BODIES.citations).messages[1].content[0])
  }

  # The history is the program's to change between asks.
  let edited = LLM.chat(**opts("record"))
  edited.messages = [an_user("a"), an_say("b")]
  assert_eq(JSON.parse(edited.ask("c")).messages.size(), 3)
  assert_eq(edited.messages.size(), 4)
}
an_cases()

iso.drop()
