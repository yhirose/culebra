# Ownership accounting of the for-in iterator protocol: the dispose call gets
# its own `self` +1 and the iterable's ref is released by the loop scope, so
# drop/dispose fire at the same points as the interpreter for BOTH a
# self-returning iterator (a generator: iterable == iterator) and a distinct
# iterator. The JIT used to pair two defects here (an orphaned iterable ref
# and a double-consumed dispose `self`) that cancelled only for generators.

# Distinct iterator: the iterator's drop fires at loop exit (after dispose),
# the iterable's drop at its scope exit.
fn mk_distinct() {
  {v: 1, iter: fn () {
      {mut i: 0, has_next: fn () {
          self.i < 3
        }, next: fn () {
          self.i = self.i + 1
          self.i
        }, dispose: fn () {
          inspect("distinct: disposed")
        }, drop: fn () {
          inspect("distinct: iter dropped")
        }}
    }, drop: fn () {
      inspect("distinct: iterable dropped")
    }}
}

fn run_distinct() {
  let g = mk_distinct()
  for x in g {
    break if x > 1
  }
  inspect("distinct: after loop")
}
run_distinct()
inspect("distinct: after run")

# Fresh iterable (no binding): its drop fires at the loop's own scope exit.
fn run_fresh() {
  for x in mk_distinct() {
    break if x > 1
  }
  inspect("fresh: after loop")
}
run_fresh()
inspect("fresh: after run")

# Self-returning iterator: still usable after the loop, drop at scope exit.
fn mk_self() {
  {mut i: 0, iter: fn () {
      self
    }, has_next: fn () {
      self.i < 3
    }, next: fn () {
      self.i = self.i + 1
      self.i
    }, dispose: fn () {
      inspect("self: disposed")
    }, drop: fn () {
      inspect("self: dropped")
    }}
}

fn run_self() {
  let g = mk_self()
  for x in g {
    break if x > 1
  }
  inspect("self: after loop")
  inspect("self: usable " + g.has_next().to_string())
}
run_self()
inspect("self: after run")

# Generator with a body defer standing in for dispose observability.
fn gen() {
  defer {
    inspect("gen: disposed")
  }
  yield 1
  yield 2
  yield 3
}

fn run_gen() {
  for x in gen() {
    break if x > 1
  }
  inspect("gen: after loop")
}
run_gen()
inspect("gen: after run")
