# Audio.Kauai: songs in the Kauai language (docs/kauai/language.md). The test
# harness keeps the device closed (CULEBRA_AUDIO=off), so nothing sounds; a
# song still reads, checks and times its notes, and keeps its own time while
# it "plays".

let lines = |xs| xs.join("\n")
# Seconds to the millisecond, so that times compare as written.
let ms = |x| Math.round(x * 1000) / 1000.0
let notes = fn (song, by) {
  song.events().filter(|e| e.by == by).map(|e| (ms(e.at), ms(e.len), e.pitch, ms(e.vol)))
}

let DUO = lines([
  'band Duo {',
  '  voice Tune  pulse     plays melody            vol 20  gap 2',
  '  voice Bass  triangle  plays roots in E2..D#3  vol 30',
  '  drum Kick   noise 120  len 1  vol 20',
  '}',
  'groove Walk {',
  '  Bass  1 - 5 -',
  '  Kick  x... ....',
  '}',
])
let song_of = fn (body) {
  lines([DUO, 'song First {', '  tempo 120', '  band Duo', '  groove Walk', '  melody in C5..B5', ...body, '}'])
}

# Notes, their marks and the band's dynamics: a quarter is half a second at
# tempo 120, a staccato keeps its time, and an accent after \f is a level
# above f, as the bass and the drums after \f are at f.
let first = Audio.Kauai.new(lines([
  song_of(['  Verse', '  mark End']),
  'section Verse {',
  "  C     e4 .g \\f !c'2",
  '}',
]))
assert_eq(notes(first, "Tune"), [(0.0, 0.5, 76, 20.0), (0.5, 0.5, 79, 20.0), (1.0, 1.0, 84, 27.059)])
assert_eq(notes(first, "Bass"), [(0.0, 1.0, 48, 30.0), (1.0, 1.0, 55, 35.294)])
assert_eq(notes(first, "Kick"), [(0.0, 0.017, nil, 20.0)])
assert_eq(first.length(), 2.0)

# Playing keeps the song's own time, device or not; stop() ends it.
assert_eq(first.playing(), false)
assert_eq(first.reached("End"), false)
first.play()
assert_eq(first.playing(), true)
assert_eq(first.reached("End"), false)
first.volume(0.5)
first.volume(1)
first.stop()
assert_eq(first.playing(), false)
assert_throws("ValueError", fn () {
  first.reached("Nowhere")
})
assert_throws("TypeError", fn () {
  first.volume("loud")
})

# A tempo change, a fermata and swing all move the notes in time.
let timed = fn (bar) {
  notes(Audio.Kauai.new(lines([song_of(['  Verse']), 'section Verse {', "  C  {bar}", '}'])), "Tune")
    .map(|n| n[0])
}
assert_eq(timed('c4 d \tempo 60 e f'), [0.0, 0.5, 1.0, 2.0])
assert_eq(timed('c4 @d e f'), [0.0, 0.5, 1.5, 2.0])
let swung = Audio.Kauai.new(lines([
  song_of(['  swing 8', '  Verse']),
  'section Verse {',
  '  C  c8 d e f g a b c',
  '}',
]))
assert_eq(notes(swung, "Tune").map(|n| n[0]), [0.0, 0.333, 0.5, 0.833, 1.0, 1.333, 1.5, 1.833])

# A song that loops plays the pickup it starts with again over its end.
let looped = Audio.Kauai.new(lines([
  song_of(['  loop', '  Verse']),
  'section Verse {',
  '  pickup g8',
  '  C  c4 d e r',
  '}',
]))
assert_eq(notes(looped, "Tune").map(|n| (n[0], n[2])), [(0.0, 79), (0.25, 72), (0.75, 74), (1.25, 76), (2.0, 79)])
assert_eq(looped.length(), 2.25)
looped.play()
assert_eq(looped.playing(), true)
looped.stop()

# Hits: the band strikes the rhythm in place of its groove, the bass on the
# chord's bass note, the drums that play hits with it and the others resting;
# a bar of rests is a break. A part plays instead of its voice's groove row.
let BAND = lines([
  'band Combo {',
  '  voice Lead  pulse     plays melody            vol 20',
  '  voice Echo  pulse2                            vol 10',
  '  voice Bass  triangle  plays roots in E2..D#3  plays part Fill  vol 30',
  '  Echo echoes Lead  late 1/8  level 50%',
  '  drum Kick   noise 120   len 1  vol 20  plays hits',
  '  drum Hat    noise 3000  len 1  vol 5',
  '}',
  'groove Beat {',
  '  Bass  1 - - -',
  '  Kick  x...',
  '  Hat   .x.x',
  '}',
])
let combo = Audio.Kauai.new(lines([
  BAND,
  'song Combo {', '  tempo 120', '  band Combo', '  groove Beat', '  melody in C5..B5', '  Kime with echo', '}',
  'section Kime {',
  '  F     c1',
  '    hits:  !x4 r x2',
  '  G     r1',
  '    hits:  r1',
  '  C     r1',
  '    Fill:  c4 d e f',
  '}',
]))
assert_eq(notes(combo, "Bass"), [(0.0, 0.5, 41, 35.294), (1.0, 1.0, 41, 30.0), (4.0, 0.5, 72, 30.0), (4.5, 0.5, 74, 30.0), (5.0, 0.5, 76, 30.0), (5.5, 0.5, 77, 30.0)])
assert_eq(notes(combo, "Kick").map(|n| n[0]), [0.0, 1.0, 4.0])
assert_eq(notes(combo, "Hat").map(|n| n[0]), [4.5, 5.5])
assert_eq(notes(combo, "Echo"), [(0.25, 2.0, 72, 5.0)])

# Mistakes are found before anything plays, and name their line.
let error_of = fn (text) {
  try {
    Audio.Kauai.new(text)
    nil
  } catch e {
    (e.kind, e.message)
  }
}
assert_eq(error_of(lines([song_of(['  Verse']), 'section Verse {', '  C  c4 d e', '}'])),
  ("KauaiError", "line 18: the bar is 3.0 beats long, want 4"))
assert_eq(error_of(lines([song_of(['  Verse']), 'section Verse {', '  Cdim9  c1', '}'])),
  ("KauaiError", "line 18: unknown chord: Cdim9"))
assert_eq(error_of(lines(["use 'band.kau'", song_of(['  Verse'])])),
  ("KauaiError", "line 1: a song given as text uses no files: use 'band.kau'"))
assert_eq(error_of(song_of(['  Chorus'])), ("KauaiError", "line 15: no section Chorus"))
let band_error = |line| error_of(lines(['band B {', line, '}', 'song S {', '  tempo 100', '  band B', '}']))
assert_eq(band_error('  voice V pulse plays melody'), ("KauaiError", "line 2: a voice needs its vol: vol 20"))
assert_eq(band_error('  voice V noise plays melody vol 10'),
  ("KauaiError", "line 2: a voice plays on pulse, pulse2, triangle or saw, or an external instrument; not noise"))
assert_eq(error_of(lines(['band B {', '  voice V pulse plays melody vol 10', '  voice W pulse vol 10', '}'])),
  ("KauaiError", "line 3: W and V both play on pulse"))
assert_eq(error_of(lines([DUO, 'song S {', '  tempo 100', '  band Duo', '  melody in C5..B5', '  V with echo', '}', 'section V {', '  C  c1', '}'])),
  ("KauaiError", "line 14: `with echo` needs a voice that echoes the melody"))
assert_throws("TypeError", fn () {
  Audio.Kauai.new(42)
})

# `about` says what the song is, each item's text to the end of its line; a
# `//` starts a comment at the start of a line or after a space, and a `#` is
# a sharp.
let about = Audio.Kauai.new(lines([
  'about {',
  '  title     Etude Op. 10 #3  // not the title',
  '  composer  Frédéric Chopin',
  '  year      1832',
  '  source    https://example.org/etude',
  '}',
  '// a line of comment',
  song_of(['  Verse  // once']),
  'section Verse {',
  '  C  c#1',
  '}',
]))
assert_eq(about.about(), {
  title: 'Etude Op. 10 #3',
  composer: 'Frédéric Chopin',
  year: 1832,
  source: 'https://example.org/etude',
})
assert_eq(notes(about, "Tune"), [(0.0, 2.0, 73, 20.0)])
assert_eq(first.about(), {})
let about_error = |items| error_of(lines(['about {', ...items, '}', song_of(['  Verse']), 'section Verse {', '  C  c1', '}']))
assert_eq(about_error(['  tempo 100']), ("KauaiError",
  "line 2: about says title, composer, lyricist, arranger, year, source, license, note, not tempo"))
assert_eq(about_error(['  title A', '  title B']), ("KauaiError", "line 3: about says title once"))
assert_eq(about_error(['  note']), ("KauaiError", "line 2: note needs its text: note ..."))
assert_eq(about_error(['  year 1890s']), ("KauaiError", "line 2: a year is a number: 1890s"))
assert_eq(error_of(lines(['about {', '}', 'about {', '}', song_of(['  Verse'])])),
  ("KauaiError", "line 3: a file says about once"))

# A song file and the files it uses, here from a Dir of its own. Any object
# with exists(name) and read(name) does as well (the last check below).
let files = {
  "songs/band.kau": DUO,
  "songs/first.kau": lines([
    "use 'band.kau'",
    'song First {', '  tempo 120', '  band Duo', '  groove Walk', '  melody in C5..B5', '  Verse', '}',
    'section Verse {', '  C  c1', '}',
  ]),
  "songs/second.kau": lines(["use 'first.kau'"]),
  "songs/about.kau": lines(['about {', '  title Band', '}']),
  "songs/third.kau": lines(["use 'about.kau'"]),
}
let dir = Dir.memory(files)
assert_eq(notes(Audio.Kauai.load("songs/first.kau", dir: dir), "Tune"), [(0.0, 2.0, 72, 20.0)])
let readable = {exists: |name| files.has(name), read: |name| files[name]}
assert_eq(notes(Audio.Kauai.load("songs/first.kau", dir: readable), "Tune"), [(0.0, 2.0, 72, 20.0)])
assert_throws("IOError", fn () {
  Audio.Kauai.load("songs/none.kau", dir: dir)
})
let used_song = try {
  Audio.Kauai.load("songs/second.kau", dir: dir)
  nil
} catch e {
  e.message
}
assert_eq(used_song, "songs/first.kau:2: a file that is used holds no song")
let used_about = try {
  Audio.Kauai.load("songs/third.kau", dir: dir)
  nil
} catch e {
  e.message
}
assert_eq(used_about, "songs/about.kau:1: a file that is used holds no about")

# An external voice's sounds come from the program: one per pitch, built by
# prepare() a call at a time, or by play() all at once.
let WAV = Encoding.hex.decode("524946462800000057415645666d7420100000000100010040" +
  "1f0000401f000001000800646174610400000080c8803c")
let EXTERNAL = lines([
  'band Keys {',
  '  voice Piano  external Ep bright=0.8  plays melody  poly  vol 40',
  '  drum Ride    external Ride           vol 50',
  '}',
  'groove Time {',
  '  Ride  x.x.',
  '}',
  'song Solo {', '  tempo 60', '  band Keys', '  groove Time', '  melody in C4..B4', '  Solo', '}',
  'section Solo {', '  C  <c e g>2 c', '}',
])
mut asked = []
let external = Audio.Kauai.new(EXTERNAL, voices: {
  ep: fn (pitch, params) {
    asked.push((pitch, params.bright))
    Audio.Sound.new(WAV)
  },
}, drums: {ride: |params| Audio.Sound.new(WAV)})
assert_eq(notes(external, "Piano"), [(0.0, 2.0, 60, 40.0), (0.0, 2.0, 64, 40.0), (0.0, 2.0, 67, 40.0), (2.0, 2.0, 60, 40.0)])
assert_eq(notes(external, "Ride").map(|n| (n[0], n[3])), [(0.0, 50.0), (2.0, 50.0)])
assert_eq(external.prepare(), 3)
external.play()
assert_eq(asked.map(|a| a[0]).sorted(), [60, 64, 67])
assert_eq(asked[0][1], 0.8)
external.stop()
assert_throws("ValueError", fn () {
  Audio.Kauai.new(EXTERNAL, drums: {ride: |params| Audio.Sound.new(WAV)})
})
let not_a_sound = Audio.Kauai.new(EXTERNAL, voices: {ep: |pitch, params| 1}, drums: {ride: |params| 1})
assert_throws("TypeError", fn () {
  not_a_sound.prepare()
})

# An instrument plays a phrase at a time: the notes a slur joins, or a note
# alone. It hears what it names of each, and a sound is made for each phrase
# it hears differently; a dynamic it hears is its own to sound, so the notes'
# vol leaves it out. It is asked for one more, which it is weighed by: a note
# at the middle of the voice's pitches, a second long at mf (the drum's hit
# at mf is one the song plays already).
let PLAYED = lines([
  'band Strings {',
  '  voice Fiddle  external Fiddle  plays melody  vol 50',
  '  drum Snare    external Snare   vol 40',
  '}',
  'groove Time {',
  '  Snare  x..x',
  '}',
  'song Bow {', '  tempo 60', '  band Strings', '  groove Time', '  melody in C4..B4', '  Bow', '}',
  'section Bow {', '  C  (c4 d) .e \f e', '}',
])
let said = |n| n.keys().map(|k| "{k} {n[k]}").join(", ")
let phrase_said = |notes| notes.map(said).join(" / ")
mut heard = []
mut struck = []
let played = Audio.Kauai.new(PLAYED, voices: {
  fiddle: {
    phrase: fn (notes, params) {
      heard.push(notes)
      Audio.Sound.new(WAV)
    },
    hears: ["len", "level"],
  },
}, drums: {
  snare: {
    hit: fn (n, params) {
      struck.push(n)
      Audio.Sound.new(WAV)
    },
    hears: ["level"],
  },
})
assert_eq(notes(played, "Fiddle").map(|n| n[3]), [50.0, 50.0, 50.0, 50.0])
assert_eq(notes(played, "Snare").map(|n| n[3]), [40.0, 40.0])
assert_eq(played.prepare(), 5)
played.play()
assert_eq(heard.map(phrase_said).sorted(), [
  'pitch 60, at 0.0, len 1.0, level 1.0, level_end 1.0 / pitch 62, at 1.0, len 1.0, level 1.0, level_end 1.0',
  'pitch 64, at 0.0, len 0.5, level 1.0, level_end 1.0',
  'pitch 64, at 0.0, len 1.0, level 1.0, level_end 1.0',
  'pitch 64, at 0.0, len 1.0, level 1.18, level_end 1.18',
])
assert_eq(struck.map(said).sorted(), ['level 1.0', 'level 1.18'])
played.stop()

# Hearing nothing, an instrument still hears where each note of a phrase
# starts, and the notes' vol keeps the dynamic.
mut plain = []
let unheard = Audio.Kauai.new(PLAYED, voices: {
  fiddle: {
    phrase: fn (notes, params) {
      plain.push(notes)
      Audio.Sound.new(WAV)
    },
    hears: [],
  },
}, drums: {snare: |params| Audio.Sound.new(WAV)})
assert_eq(notes(unheard, "Fiddle").map(|n| n[3]), [50.0, 50.0, 50.0, 58.824])
assert_eq(unheard.prepare(), 2)
unheard.play()
assert_eq(plain.map(phrase_said).sorted(), ['pitch 60, at 0.0 / pitch 62, at 1.0', 'pitch 64, at 0.0'])
unheard.stop()

# An external voice or drum plays at its vol on the tones' scale: weighed by
# its note at the middle of its pitches (a drum by its hit), it is played as
# loud as a pulse at a half's duty at vol 100 and that pitch would be. A sound
# that is that pulse keeps its level (a weight of 1), one twice as loud is
# played at half, and silence, whose loudness is not known, keeps its own.
# Half a second of it: a steady wave is as loud over any 400 ms.
let pulse_at = fn (pitch, amp) {
  let f = 440.0 * 2.0 ** ((pitch - 69) / 12.0)
  iota(22050).map(|i| (i * f / 44100.0) % 1.0 < 0.5 ? amp : -amp)
}
let weight_of = fn (amp) {
  let song = Audio.Kauai.new(lines([
    'band Solo {', '  voice Lead  external Square  plays melody  vol 50', '  drum Tick  external Tick  vol 50', '}',
    'groove Time {', '  Tick  x...', '}',
    'song Weigh {', '  tempo 60', '  band Solo', '  groove Time', '  melody in C4..B4', '  Weigh', '}',
    'section Weigh {', "  C  c4 e g c'", '}',
  ]), voices: {square: |pitch, params| Audio.Sound.new(pulse_at(pitch, amp))}, drums: {tick: |params| Audio.Sound.new(pulse_at(69, amp))})
  song.play()
  song.stop()
  song._weights
}
let close = |a, b| Math.abs(a - b) < 0.01
assert_true(close(weight_of(0.2).Lead, 1.0) && close(weight_of(0.2).Tick, 1.0))
assert_true(close(weight_of(0.4).Lead, 0.5) && close(weight_of(0.4).Tick, 0.5))
assert_eq(weight_of(0.0), {Lead: 1.0, Tick: 1.0})

# A slur from one chord to the next is one phrase of all their tones.
mut chords = []
let chorded = Audio.Kauai.new(lines([
  'band Keys {',
  '  voice Organ  external Organ  plays melody  vol 50  poly',
  '}',
  'song Hold {', '  tempo 60', '  band Keys', '  melody in C4..B4', '  Hold', '}',
  'section Hold {', '  C  (<c e>4 <d f>) g2', '}',
]), voices: {
  organ: {
    phrase: fn (notes, params) {
      chords.push(notes)
      Audio.Sound.new(WAV)
    },
    hears: ["len"],
  },
})
chorded.play()
assert_eq(chords.map(phrase_said).sorted(), [
  'pitch 60, at 0.0, len 1.0 / pitch 64, at 0.0, len 1.0 / pitch 62, at 1.0, len 1.0 / pitch 65, at 1.0, len 1.0',
  'pitch 64, at 0.0, len 1.0',
  'pitch 67, at 0.0, len 2.0',
])
chorded.stop()

# A phrase is what the slur is written around: a grace note under it is in
# it, and a rest under it ends the phrase so far. (The note alone at the
# middle of the pitches is the one the instrument is weighed by.)
let phrased = fn (bar) {
  mut got = []
  let song = Audio.Kauai.new(lines([
    'band Solo {',
    '  voice Reed  external Reed  plays melody  vol 50',
    '}',
    'song Breath {', '  tempo 60', '  band Solo', '  melody in C4..B4', '  Breath', '}',
    'section Breath {', "  C  {bar}", '}',
  ]), voices: {
    reed: {
      phrase: fn (notes, params) {
        got.push(notes)
        Audio.Sound.new(WAV)
      },
      hears: [],
    },
  })
  song.play()
  song.stop()
  got.map(|notes| notes.map(|n| "{n.pitch}").join(" ")).sorted()
}
assert_eq(phrased('(c4 {e}d e f)'), ['60 64 62 64 65', '64'])
assert_eq(phrased('(c4 d r e)'), ['60 62', '62', '64'])

# Notes struck together are a phrase too, a chord in a part or in a groove,
# its tones in order from the lowest.
mut struck_together = []
let keyed = Audio.Kauai.new(lines([
  'band Keys {',
  '  voice Organ  external Organ  plays melody  vol 50  poly',
  '  voice Comp   external Organ  plays chords from C3  vol 50  poly',
  '}',
  'groove Stab {', '  Comp  x . . .', '}',
  'song Hold {', '  tempo 60', '  band Keys', '  groove Stab', '  melody in C4..B4', '  Hold', '}',
  'section Hold {', '  C  <e c>4 <d f> g2', '}',
]), voices: {
  organ: {
    phrase: fn (notes, params) {
      struck_together.push(notes.map(|n| "{n.pitch}@{n.at}").join(" "))
      Audio.Sound.new(WAV)
    },
    hears: [],
  },
})
keyed.play()
keyed.stop()
# Each voice is weighed on its own: Comp by 55, Organ by 64.
assert_eq(struck_together.sorted(), ['48@0.0 52@0.0 55@0.0 60@0.0', '55@0.0', '60@0.0 64@0.0', '62@0.0 65@0.0', '64@0.0', '67@0.0'])

# What an instrument hears of a phrase: the marks written on each note, the
# jazz bends among them, the dynamic where the note ends, and when its voice
# plays next; a drum hears when it, or its choke group, hits next.
mut told = []
mut hit_told = []
let marked = Audio.Kauai.new(lines([
  'band Combo {',
  '  voice Horn   external Horn   plays melody  vol 50',
  '  drum Open    external Hat    vol 40  choke Hats',
  '  drum Closed  external Hat    vol 40  choke Hats',
  '  drum Ride    external Ride   vol 40',
  '}',
  'groove Time {',
  '  Open    x . . .',
  '  Closed  . . x .',
  '  Ride    x x . .',
  '}',
  'song Blow {', '  tempo 60', '  band Combo', '  groove Time', '  melody in C4..B4', '  Blow', '}',
  'section Blow {', '  C  \p \cresc \scoop c2 \f .!d4 \fall e', '}',
]), voices: {
  horn: {
    phrase: fn (notes, params) {
      told.push(notes.map(said).join(" / "))
      Audio.Sound.new(WAV)
    },
    hears: ["level", "marks", "next"],
  },
}, drums: {
  hat: {
    hit: fn (n, params) {
      hit_told.push(said(n))
      Audio.Sound.new(WAV)
    },
    hears: ["next"],
  },
  ride: {
    hit: fn (n, params) {
      hit_told.push("ride " + said(n))
      Audio.Sound.new(WAV)
    },
    hears: ["next"],
  },
})
marked.play()
marked.stop()
assert_eq(told.sorted(), [
  "pitch 60, at 0.0, level 0.65, level_end 1.18, marks ['scoop'], next 2.0",
  "pitch 62, at 0.0, level 1.0, level_end 1.0, marks [], next nil",
  "pitch 62, at 0.0, level 1.35, level_end 1.18, marks ['staccato', 'accent'], next 1.0",
  "pitch 64, at 0.0, level 1.18, level_end 1.18, marks ['fall'], next nil",
])
# One hat's hit at mf with nothing after it is the one it is weighed by.
assert_eq(hit_told.sorted(), ['next 2.0', 'next nil', 'next nil', 'ride next 1.0', 'ride next nil'])

# The band's hits carry their marks as written notes do: a staccato hit is
# let go at half its length, a marcato at three quarters, an accent strikes
# a level louder, and an instrument that hears marks is told them, a jazz
# articulation among them; a drum that plays hits is told them too.
mut plucked = []
mut crashed = []
let kime = Audio.Kauai.new(lines([
  'band Duo {',
  '  voice Lead  pulse  plays melody  vol 20',
  '  voice Bass  external Pluck  plays roots in E2..D#3  vol 50',
  '  drum Crash  external Crash  vol 50  plays hits',
  '}',
  'groove Walk {', '  Bass  1 1 1 1', '}',
  'song Kime {', '  tempo 60', '  band Duo', '  groove Walk', '  melody in C4..B4', '  Kime', '}',
  'section Kime {', '  C  r1', '    hits:  .x4 -x4 ^x4 \fall !x4', '}',
]), voices: {
  pluck: {
    phrase: fn (notes, params) {
      plucked.push(notes.map(said).join(" / "))
      Audio.Sound.new(WAV)
    },
    hears: ["len", "marks"],
  },
}, drums: {
  crash: {
    hit: fn (n, params) {
      crashed.push(said(n))
      Audio.Sound.new(WAV)
    },
    hears: ["level", "marks"],
  },
})
kime.play()
kime.stop()

# Each note's line through the phrase, from the lowest: a rolled chord's
# tones start apart and keep their lines, and a note a tie holds keeps its
# own while the struck ones take the rest.
mut lined = []
let rolled = Audio.Kauai.new(lines([
  'band Solo {', '  voice Harp  external Harp  plays melody  poly  vol 50', '}',
  'song Roll {', '  tempo 60', '  band Solo', '  melody in C4..B4', '  Roll', '}',
  'section Roll {', '  C  ~<c~ e g>2 <c d f>2', '}',
]), voices: {
  harp: {
    phrase: fn (notes, params) {
      lined.push(notes.map(said).join(" / "))
      Audio.Sound.new(WAV)
    },
    hears: ["line"],
  },
})
rolled.play()
rolled.stop()
assert_eq(lined.sorted(), [
  "pitch 60, at 0.0, line 0 / pitch 64, at 0.062, line 1 / pitch 67, at 0.125, line 2",
  "pitch 62, at 0.0, line 1 / pitch 65, at 0.0, line 2",
  "pitch 64, at 0.0, line 0",
])

# A parameter a line sets, `\bright=1.3`, holds for that line's notes from
# the next one until it is set again, over the band's own: a function is
# asked for each pitch at each setting it plays it at, and an instrument is
# given them as they stand at a phrase's first note, and at each note when it
# hears them. A bar line's are the melody's, and a part's line sets its own.
# Each voice is weighed at the band's own (Lead at 64 with bright=0.8, Alto
# at 62 with breath=0.2).
let settings = |p| p.keys().sorted().map(|k| "{k}={p[k]}").join(" ")
mut keyed = []
let set = Audio.Kauai.new(lines([
  'band Duo {',
  '  voice Lead  external Ep bright=0.8     plays melody     vol 50',
  '  voice Alto  external Reed breath=0.2  plays part Alto  vol 50',
  '}',
  'song Set {', '  tempo 60', '  band Duo', '  melody in C4..B4', '  Set', '}',
  'section Set {',
  '  C  c4 \bright=1.3 e g \bright=0.5 c',
  '    Alto:  (c4 \breath=0.4 d) e2',
  '  C  c4 e \bright=1.3 g c',
  '    Alto:  c1',
  '}',
]), voices: {
  ep: fn (pitch, params) {
    keyed.push("{pitch} {settings(params)}")
    Audio.Sound.new(WAV)
  },
  reed: {
    phrase: fn (notes, params) {
      keyed.push("{notes.map(|n| "{n.pitch} {settings(n.params)}").join(" / ")} | {settings(params)}")
      Audio.Sound.new(WAV)
    },
    hears: ["params"],
  },
})
set.play()
set.stop()
assert_eq(keyed.sorted(), [
  "60 breath=0.2 / 62 breath=0.4 | breath=0.2",
  "60 breath=0.4 | breath=0.4",
  "60 bright=0.5",
  "60 bright=0.8",
  "60 bright=1.3",
  "62 breath=0.2 | breath=0.2",
  "64 breath=0.4 | breath=0.4",
  "64 bright=0.5",
  "64 bright=0.8",
  "64 bright=1.3",
  "67 bright=1.3",
])
assert_eq(plucked.sorted(), [
  "pitch 48, at 0.0, len 0.5, marks ['staccato']",
  "pitch 48, at 0.0, len 0.75, marks ['marcato']",
  "pitch 48, at 0.0, len 1.0, marks ['accent', 'fall']",
  "pitch 48, at 0.0, len 1.0, marks ['tenuto']",
  "pitch 48, at 0.0, len 1.0, marks []",
])
# Each is weighed by its note or hit at mf with no marks.
assert_eq(crashed.sorted(), [
  "level 1.0, marks ['staccato']",
  "level 1.0, marks ['tenuto']",
  "level 1.0, marks []",
  "level 1.18, marks ['accent', 'fall']",
  "level 1.18, marks ['marcato']",
])

# A `melody in` or `part NAME in` line holds for the bars after it, as a
# `meter` line does: the bars before it, and the pickup, keep the range they
# were written in; a repeat sign plays the bar it repeats as written, and an
# ending starts in the range its section's body ends in.
let ranged = Audio.Kauai.new(lines([
  'band Pair {',
  '  voice Lead  pulse     plays melody  vol 20',
  '  voice Alto  triangle  plays part A  vol 20',
  '}',
  'song Range {', '  tempo 60', '  band Pair', '  melody in C4..B4', '  Range ending 1', '  Range ending 2', '}',
  'section Range {',
  '  pickup  g4',
  '  C  c1',
  '    A:  e1',
  '  melody in C5..B5',
  '  part A in C3..B3',
  '  C  c1',
  '    A:  e1',
  '  melody in C6..B6',
  '  %',
  '  ending 1 {',
  '    C  c2 r',
  '      A:  e1',
  '  }',
  '  ending 2 {',
  '    melody in C4..B4',
  '    C  c1',
  '  }',
  '}',
]))
let pitches_of = |who| ranged.events().filter(|e| e.by == who).map(|e| e.pitch)
assert_eq(pitches_of("Lead"), [67, 60, 72, 72, 84, 67, 60, 72, 72, 60])
assert_eq(pitches_of("Alto"), [64, 52, 52, 52, 64, 52, 52])


let refused = fn (voices, drums) {
  try {
    Audio.Kauai.new(PLAYED, voices: voices, drums: drums)
    nil
  } catch e: ValueError {
    e.message
  }
}
let snare = {snare: |params| Audio.Sound.new(WAV)}
let fiddle = {fiddle: |pitch, params| Audio.Sound.new(WAV)}
assert_eq(
  refused({fiddle: {phrase: |notes, params| nil, hears: ["slur"]}}, snare),
  "Audio.Kauai: voices: `fiddle` hears slur; it can hear len, level, line, marks, next, params",
)
assert_eq(
  refused(fiddle, {snare: {hit: |n, params| nil, hears: ["len"]}}),
  "Audio.Kauai: drums: `snare` hears len; it can hear level, marks, next",
)
assert_eq(
  refused({fiddle: {note: |n, params| nil, hears: ["len"]}}, snare),
  "Audio.Kauai: voices: `fiddle` is a function or an object whose `phrase` is one",
)
assert_eq(
  refused(fiddle, {snare: {phrase: |notes, params| nil}}),
  "Audio.Kauai: drums: `snare` is a function or an object whose `hit` is one",
)

print("audio kauai ok\n")
