# A `let name = fn …` the statement list declares once is bound to that
# literal for good, so the compiler names the code every call to it reaches
# (Chunk::call_targets). Nothing about the call becomes static except the
# code: the closure, its captures, and every check and error the callee
# raises stay exactly where they were.

let plus = fn (a, b) {
  a + b
}
assert_eq(plus(1, 2), 3)

# Immediately invoked: the literal is its own callee.
assert_eq((fn (x) { x * 2 })(21), 42)

# The recursion handle, and the literal's own name, are the running frame.
let count_down = fn (n) {
  n > 0 ? fn(n - 1) : 'floor'
}
assert_eq(count_down(3), 'floor')

let by_name = fn (n) {
  n > 0 ? by_name(n - 1) : 'floor'
}
assert_eq(by_name(3), 'floor')

# --- A captured name a later declaration replaces ---
# The second `let` writes the cell the first one owns, so the closure built
# between them reads the new function — what it calls is not settled by
# where it was written.
let which = fn () { 'first' }
let ask = fn () { which() }
assert_eq(ask(), 'first')
let which = fn () { 'second' }
assert_eq(ask(), 'second')

# The same through a `fn` declaration, which binds a dispatcher rather than
# the literal's own closure.
let kind = fn (v) { 'literal' }
let ask_kind = fn (v) { kind(v) }
assert_eq(ask_kind(1), 'literal')
fn kind(v: Long) {
  'declared'
}
assert_eq(ask_kind(1), 'declared')

# A shadow in a nested scope is a binding of its own, not a rewrite.
let outer = fn () { 'outer' }
let shadowing = fn () {
  let outer = fn () { 'inner' }
  outer()
}
assert_eq(shadowing(), 'inner')
assert_eq(outer(), 'outer')

# --- The callee's own errors ---
# Arity, reported against the callee's parameter names at the call.
let short_call = try {
  plus(1)
  nil
} catch e {
  e
}
assert_eq(short_call.kind, 'ArityError')
assert_true(short_call.message.contains('b'))

# A keyword-only parameter cannot be filled positionally. The guard runs
# ahead of the callee's frame, so its parameters never bind.
let kw_only = fn (x, *, y) {
  x + y
}
assert_eq(kw_only(1, y: 2), 3)
let too_many = try {
  kw_only(1, 2)
  nil
} catch e {
  e
}
assert_eq(too_many.kind, 'TypeError')
assert_true(too_many.message.contains('positional'))

# A `mut` binding is a run-time question, so nothing is resolved through it.
mut swap = fn () { 'a' }
assert_eq(swap(), 'a')
swap = fn () { 'b' }
assert_eq(swap(), 'b')

# --- `fn name`: the code is static, the closure comes from the dispatcher ---
# A `fn name` the statement list declares once holds a dispatcher over one
# untyped overload, and nothing can ever append to its table. So a call whose
# argument count that overload accepts reaches the named chunk through the
# dispatcher's monomorphic body (Binding::mono_chunk); every other shape stays
# a run-time question and keeps its DispatchError.

fn joined(a, b) {
  "{a}/{b}"
}
assert_eq(joined(1, 2), '1/2')

let short = try {
  joined(1)
  nil
} catch e {
  e
}
assert_eq(short.kind, 'DispatchError')
assert_eq(short.message, 'no matching method for `joined`')

let long = try {
  joined(1, 2, 3)
  nil
} catch e {
  e
}
assert_eq(long.kind, 'DispatchError')

# Two declarations of a name: the table holds both, so neither call is named
# and both arities dispatch.
fn arity(a) {
  'one'
}
fn arity(a, b) {
  'two'
}
assert_eq(arity(1), 'one')
assert_eq(arity(1, 2), 'two')

# An annotation makes dispatch a real question even with one overload.
fn only_long(n: Long) {
  n * 2
}
assert_eq(only_long(21), 42)
assert_eq(try {
  only_long('x')
} catch e {
  e.kind
}, 'DispatchError')

# The window a lone overload accepts: a defaulted tail widens it, a variadic
# opens it, and a keyword-only slot is never filled positionally.
fn tail(a, b = 10) {
  a + b
}
assert_eq(tail(1), 11)
assert_eq(tail(1, 2), 3)

fn rest(*args) {
  args.size()
}
assert_eq(rest(), 0)
assert_eq(rest(1, 2, 3), 3)

fn keyword(a, *, k = 5) {
  a * k
}
assert_eq(keyword(2), 10)
assert_eq(keyword(2, k: 3), 6)
assert_eq(try {
  keyword(2, 3)
} catch e {
  e.kind
}, 'DispatchError')

# Recursion goes through the same handle: the name inside the body reads the
# dispatcher this body was registered into.
fn fib(n) {
  n < 2 ? n : fib(n - 1) + fib(n - 2)
}
assert_eq(fib(12), 144)

fn ping(n) {
  n == 0 ? 'ping' : pong(n - 1)
}
fn pong(n) {
  n == 0 ? 'pong' : ping(n - 1)
}
assert_eq(ping(5), 'pong')

# A nested declaration is its own dispatcher, not an overload of the outer one.
fn wraps(n) {
  fn inner_only(x) {
    x * 100
  }
  inner_only(n)
}
fn inner_only(x) {
  x * 2
}
assert_eq(wraps(3), 300)
assert_eq(inner_only(3), 6)

# Read as a value, captured by a closure, and handed to a higher-order call.
fn bump(x) {
  x + 1
}
let through = fn (n) {
  bump(n)
}
assert_eq(through(41), 42)
let held = bump
assert_eq(held(9), 10)
assert_eq([1, 2, 3].map(bump), [2, 3, 4])

# A `let name = fn` and a `fn name` over the same cell: the dispatcher
# replaces the literal, and the calls before it are not the calls after.
let either = fn (v) {
  "let:{v}"
}
assert_eq(either(1), 'let:1')
fn either(v) {
  "fn:{v}"
}
assert_eq(either(2), 'fn:2')

# Hoisted, so a call ahead of the declaration is the NameError it always was.
assert_eq(try {
  not_yet(1)
} catch e {
  e.kind
}, 'NameError')
fn not_yet(x) {
  x
}
assert_eq(not_yet(1), 1)

IO.inspect('test_static_callee OK')
