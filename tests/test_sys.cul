// Conformance: stdlib §Sys. See docs/stdlib.md.
//
// Sys namespace — process introspection and cwd/env control.
// Tests run on interp, JIT, and AOT via `just test`; identical stdout.

// --- argv / executable / time (pre-existing) ---
// argv is an Array; executable is a non-empty absolute path.
assert_true(Sys.argv.size() >= 0)
assert_true(Sys.executable != "")
// Monotonic clock: two reads are non-decreasing.
let t0 = Sys.time()
assert_true(Sys.time() >= t0)

// --- set_env / env round-trip ---
assert_eq(Sys.env("CULEBRA_SYS_TEST_UNSET"), "")
Sys.set_env("CULEBRA_SYS_TEST_VAR", "hello")
assert_eq(Sys.env("CULEBRA_SYS_TEST_VAR"), "hello")
// Overwrite.
Sys.set_env("CULEBRA_SYS_TEST_VAR", "world")
assert_eq(Sys.env("CULEBRA_SYS_TEST_VAR"), "world")

// --- getcwd / chdir ---
// getcwd returns a non-empty absolute path.
let orig = Sys.getcwd()
assert_true(orig != "")
assert_true(FS.is_abs(orig))

// chdir into a fresh tmp dir, confirm getcwd reflects it, then restore.
// current_path resolves symlinks (e.g. macOS /tmp -> /private/tmp), so
// compare against FS.realpath of the same dir.
let tmpdir_env = Sys.env("TMPDIR")
let tmp_root = if tmpdir_env != "" { tmpdir_env } else { "/tmp" }
let dir = FS.join(tmp_root, "culebra_sys_test")
if FS.exists(dir) { FS.remove(dir, recursive: true) }
FS.mkdir(dir)

Sys.chdir(dir)
assert_eq(Sys.getcwd(), FS.realpath(dir))

Sys.chdir(orig)
assert_eq(Sys.getcwd(), orig)

FS.remove(dir, recursive: true)

// --- Error path: chdir to a non-existent dir throws IOError ---
let err = try { Sys.chdir("/definitely/not/a/real/path/xyzzy"); "no-error" } catch e { e.kind }
assert_eq(err, "IOError")

// --- Bare-resolve (slow path): namespace as a first-class value ---
let m = Sys
m.set_env("CULEBRA_SYS_BARE", "ok")
assert_eq(m.env("CULEBRA_SYS_BARE"), "ok")
assert_true(m.getcwd() != "")

IO.inspect("test_sys OK")
