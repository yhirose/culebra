// Conformance: stdlib §Sys. See docs/stdlib.md.
//
// Sys namespace — process introspection and cwd/env control.
// Tests run on interp, JIT, and AOT via `just test`; identical stdout.

// --- argv / executable / time (pre-existing) ---
// argv is an Array; executable is a non-empty absolute path.
assert_eq(type_of(Sys.argv), 'Array')
assert_true(Sys.argv.all(|a| type_of(a) == 'String'))
assert_true(Sys.executable != "")
// Monotonic clock: two reads are non-decreasing.
let t0 = Sys.time()
assert_true(Sys.time() >= t0)

// --- set_env / env round-trip ---
assert_eq(Sys.env("CULEBRA_SYS_TEST_UNSET"), "")
Sys.set_env("CULEBRA_SYS_TEST_VAR", "hello")
assert_eq(Sys.env("CULEBRA_SYS_TEST_VAR"), "hello")
// Overwrite.
Sys.set_env("CULEBRA_SYS_TEST_VAR", "world")
assert_eq(Sys.env("CULEBRA_SYS_TEST_VAR"), "world")

// --- env fallback ---
// A set variable ignores the fallback; an unset one returns it verbatim,
// whatever its type.
assert_eq(Sys.env("CULEBRA_SYS_TEST_VAR", "fb"), "world")
assert_eq(Sys.env("CULEBRA_SYS_TEST_UNSET", "fb"), "fb")
assert_eq(Sys.env("CULEBRA_SYS_TEST_UNSET", 8080), 8080)
assert_eq(Sys.env("CULEBRA_SYS_TEST_UNSET", nil), nil)
assert_eq(Sys.env("CULEBRA_SYS_TEST_UNSET", [1, 2]), [1, 2])
assert_eq(Sys.env("CULEBRA_SYS_TEST_UNSET", fallback: "kw"), "kw")

// That is what tells "unset" apart from "set to the empty string" — the
// one-argument form folds both to "".
Sys.set_env("CULEBRA_SYS_TEST_EMPTY", "")
assert_eq(Sys.env("CULEBRA_SYS_TEST_EMPTY", nil), "")
assert_eq(Sys.env("CULEBRA_SYS_TEST_EMPTY"), Sys.env("CULEBRA_SYS_TEST_UNSET"))

// Arity and the declared type of `name` hold on both the direct and the
// as-value call paths — including a positional `name` alongside `fallback:`,
// where the JIT has a dedicated compile path (see compile_ns_call's "Sys"
// case) precisely so this stays type-checked like every other positional.
assert_throws("ArityError", || Sys.env())
assert_throws("ArityError", || Sys.env("A", "b", "c"))
assert_throws("TypeError", || Sys.env(42))
assert_throws("TypeError", || Sys.env(42, fallback: "fb"))
let env_fn = Sys.env
assert_eq(env_fn("CULEBRA_SYS_TEST_UNSET", "via-value"), "via-value")
assert_throws("TypeError", || env_fn(42))

// --- getcwd / chdir ---
// getcwd returns a non-empty absolute path.
let orig = Sys.getcwd()
assert_true(orig != "")
assert_true(FS.is_abs(orig))

// chdir into a fresh tmp dir, confirm getcwd reflects it, then restore.
// current_path resolves symlinks (e.g. macOS /tmp -> /private/tmp), so
// compare against FS.realpath of the same dir.
// This run's own directory: a fixed name collides with a concurrent suite.
let dir = FS.mkdtemp("culebra_sys_test_")

Sys.chdir(dir)
assert_eq(Sys.getcwd(), FS.realpath(dir))

Sys.chdir(orig)
assert_eq(Sys.getcwd(), orig)

FS.remove(dir, recursive: true)

// --- Error path: chdir to a non-existent dir throws IOError ---
let err = try {
  Sys.chdir("/definitely/not/a/real/path/xyzzy")
  "no-error"
} catch e {
  e.kind
}
assert_eq(err, "IOError")

// --- data_dir ---
// An absolute path under the platform's per-user data directory, ending in
// the app name. The directory itself is not created.
let dd = Sys.data_dir("culebra_sys_test_app")
assert_true(FS.is_abs(dd))
assert_eq(FS.basename(dd), "culebra_sys_test_app")
assert_true(!FS.exists(dd))
// Two calls agree, and the app name is the only part that varies.
assert_eq(Sys.data_dir("culebra_sys_test_app"), dd)
assert_eq(FS.dirname(Sys.data_dir("other_app")), FS.dirname(dd))

// `app` must be a single path segment: nothing that could escape the base.
assert_throws("ValueError", || Sys.data_dir(""))
assert_throws("ValueError", || Sys.data_dir("a/b"))
// `:` too: on Windows a drive letter replaces the base instead of extending it.
assert_throws("ValueError", || Sys.data_dir("D:evil"))
assert_throws("ValueError", || Sys.data_dir("../escape"))
assert_throws("ValueError", || Sys.data_dir("."))
assert_throws("ValueError", || Sys.data_dir(".."))
assert_throws("TypeError", || Sys.data_dir(42))

// --- Bare-resolve (slow path): namespace as a first-class value ---
let m = Sys
m.set_env("CULEBRA_SYS_BARE", "ok")
assert_eq(m.env("CULEBRA_SYS_BARE"), "ok")
assert_true(m.getcwd() != "")
assert_eq(m.data_dir("culebra_sys_test_app"), dd)

IO.inspect("test_sys OK")
