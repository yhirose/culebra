# CodeGen.Module -- a script-visible builder over cpp-vmlib's Core-IR and its
# register-bytecode compiler/executor (vendor/cpp-vmlib). IR nodes are plain
# Long values (coreir::NodeId), not handles: wrap.h can only marshal scalars
# and other wrapped handles, never an array, so a Block's statements, a
# Call's arguments and a capture map's entries all go through the small
# generic list-staging helpers (list_new/list_push,
# capture_map_new/capture_map_push) rather than being passed directly.
#
# This exercises the builder API directly, by hand, without a front end --
# examples/pl0/pl0_codegen.cul is the front end that actually uses this to
# build something worth running.

fn stmt_block(m, stmts) {
  let list = m.list_new()
  for s in stmts { m.list_push(list, s) }
  m.block(stmts_list: list, line: 1, col: 1)
}

fn print_stmt(m, value) {
  let args = m.list_new()
  m.list_push(args, value)
  m.intrinsic(name: 'print', args_list: args, line: 1, col: 1)
}

# --- Arithmetic, via print's captured stdout. ---
{
  let m = CodeGen.Module.new()
  let forty = m.literal(v: 40, line: 1, col: 1)
  let two = m.literal(v: 2, line: 1, col: 1)
  let sum = m.binary(op: 'add', lhs: forty, rhs: two, line: 1, col: 1)
  let body = stmt_block(m, [print_stmt(m, sum)])
  m.add_func(name: 'main', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body: body)
  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "42\n")
}

# --- A local variable: assign then read. ---
{
  let m = CodeGen.Module.new()
  let ten = m.literal(v: 10, line: 1, col: 1)
  let assign = m.assign(kind: 'local', index: 0, value: ten, line: 1, col: 1)
  let x = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  let doubled = m.binary(op: 'mul', lhs: x, rhs: m.literal(v: 2, line: 1, col: 1),
                         line: 1, col: 1)
  let body = stmt_block(m, [assign, print_stmt(m, doubled)])
  m.add_func(name: 'main', num_locals: 1, num_captures: 0, num_cells: 0, num_params: 0, body: body)
  m.set_local_name(func: 0, index: 0, name: 'x')
  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "20\n")
}

# --- Control flow: a while loop counting down. ---
{
  let m = CodeGen.Module.new()
  let zero = m.literal(v: 0, line: 1, col: 1)
  let one = m.literal(v: 1, line: 1, col: 1)
  let init = m.assign(kind: 'local', index: 0, value: m.literal(v: 3, line: 1, col: 1),
                      line: 1, col: 1)
  let x = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  let cond = m.binary(op: 'gt', lhs: x, rhs: zero, line: 1, col: 1)
  let dec = m.assign(kind: 'local', index: 0,
                     value: m.binary(op: 'sub', lhs: x, rhs: one, line: 1, col: 1),
                     line: 1, col: 1)
  let body_stmts = stmt_block(m, [print_stmt(m, x), dec])
  let loop = m.make_while(cond: cond, body: body_stmts, line: 1, col: 1)
  let body = stmt_block(m, [init, loop])
  m.add_func(name: 'main', num_locals: 1, num_captures: 0, num_cells: 0, num_params: 0, body: body)
  m.set_local_name(func: 0, index: 0, name: 'x')
  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "3\n2\n1\n")
}

# --- A capture forwarded through a self-recursive call unchanged -- the
# exact shape examples/pl0/README.md documents for fib.pas. `countdown`
# doesn't own `n`; it captures main's, and each recursive call forwards
# `countdown`'s own capture[0] straight through (a per-call-site forwarding
# table, not a per-function one -- see cpp-vmlib's README for why that
# distinction is what makes self-recursion work at all).
{
  let m = CodeGen.Module.new()

  # main: n = 3; CALL countdown  (forwards cell[0] as countdown's capture[0] --
  # a variable a nested call captures has to live in a cell, not a local:
  # verify() rejects a closure that captures a local, since the local would
  # die with this frame while the closure it's captured into may not)
  let main_cmap = m.capture_map_new()
  m.capture_map_push(main_cmap, kind: 'cell', index: 0)
  let main_call = m.call(func: 1, cmap: m.add_capture_map(main_cmap), line: 1, col: 1)
  let init = m.assign(kind: 'cell', index: 0, value: m.literal(v: 3, line: 1, col: 1),
                      line: 1, col: 1)
  m.add_func(name: 'main', num_locals: 0, num_captures: 0, num_cells: 1, num_params: 0, body:
             stmt_block(m, [init, main_call]))

  # countdown: capture[0] is n. if n <= 0 {} else { print(n); n -= 1; CALL countdown }
  let n = m.var_ref(kind: 'capture', index: 0, line: 1, col: 1)
  let base_cond = m.binary(op: 'le', lhs: n, rhs: m.literal(v: 0, line: 1, col: 1),
                           line: 1, col: 1)
  let dec = m.assign(kind: 'capture', index: 0,
                     value: m.binary(op: 'sub', lhs: n, rhs: m.literal(v: 1, line: 1, col: 1),
                                     line: 1, col: 1),
                     line: 1, col: 1)
  let self_cmap = m.capture_map_new()
  m.capture_map_push(self_cmap, kind: 'capture', index: 0)
  let rec_call = m.call(func: 1, cmap: m.add_capture_map(self_cmap), line: 1, col: 1)
  let else_body = stmt_block(m, [print_stmt(m, n), dec, rec_call])
  let countdown_body = m.make_if_else(cond: base_cond, then_branch: m.block(stmts_list: m.list_new(), line: 1, col: 1),
                                      else_branch: else_body, line: 1, col: 1)
  m.add_func(name: 'countdown', num_locals: 0, num_captures: 1, num_cells: 0, num_params: 0,
             body: stmt_block(m, [countdown_body]))
  m.set_capture_name(func: 1, index: 0, name: 'n')

  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "3\n2\n1\n")
}

# --- Errors: verify() rejects a malformed module before run() ever starts.
# A dangling body node id (nothing was ever built at index 9999) is the
# simplest way to construct a module that fails structurally.
{
  let m = CodeGen.Module.new()
  m.add_func(name: 'main', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body: 9999)
  mut kind = nil
  try {
    m.verify()
  } catch e {
    kind = e.kind
  }
  assert_eq(kind, 'IrError')
}

# --- Runtime errors: divide by zero and an uninitialized read both surface
# as IrError with the failing operation's own position, not the caller's. ---
{
  let m = CodeGen.Module.new()
  let one = m.literal(v: 1, line: 5, col: 1)
  let zero = m.literal(v: 0, line: 5, col: 7)
  let div = m.binary(op: 'div', lhs: one, rhs: zero, line: 5, col: 3)
  let body = stmt_block(m, [print_stmt(m, div)])
  m.add_func(name: 'main', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body: body)
  m.verify()
  mut caught = nil
  try {
    m.run()
  } catch e {
    caught = e
  }
  assert_eq(caught.kind, 'IrError')
  assert_eq(caught.message, 'divide by zero')
  assert_eq(caught.line, 5)
  assert_eq(caught.col, 7)
}

{
  let m = CodeGen.Module.new()
  let x = m.var_ref(kind: 'local', index: 0, line: 8, col: 4)
  let body = stmt_block(m, [print_stmt(m, x)])
  m.add_func(name: 'main', num_locals: 1, num_captures: 0, num_cells: 0, num_params: 0, body: body)
  m.set_local_name(func: 0, index: 0, name: 'x')
  m.verify()
  mut caught = nil
  try {
    m.run()
  } catch e {
    caught = e
  }
  assert_eq(caught.kind, 'IrError')
  assert_eq(caught.message, "uninitialized variable 'x'")
}

# --- A runaway self-call fails cleanly instead of overflowing the stack. ---
{
  let m = CodeGen.Module.new()
  let cmap = m.add_capture_map(m.capture_map_new())
  let loop_call = m.call(func: 1, cmap: cmap, line: 2, col: 3)
  m.add_func(name: 'main', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body:
             m.call(func: 1, cmap: cmap, line: 1, col: 1))
  m.add_func(name: 'loop', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body: loop_call)
  m.verify()
  mut caught = nil
  try {
    m.run()
  } catch e {
    caught = e
  }
  assert_eq(caught.kind, 'IrError')
  assert_eq(caught.message, 'recursion limit exceeded')
}

# --- The exception-phase surface: scalars, tostr, containers, scopes,
# --- non-local exits, throw/try, defer. One case per mechanism.

fn tostr_node(m, v) {
  let args = m.list_new()
  m.list_push(args, v)
  m.intrinsic(name: 'tostr', args_list: args, line: 1, col: 1)
}

# Scalar literals and tostr (to_display's formatting: whole doubles print
# bare -- "4", not culebra's "4.0"; a front end that wants culebra's rule
# post-processes).
{
  let m = CodeGen.Module.new()
  let hello = m.str_literal(s: 'hi ', line: 1, col: 1)
  let cat = m.binary(op: 'add', lhs: hello, rhs: tostr_node(m, m.literal(v: 42, line: 1, col: 1)), line: 1, col: 1)
  let ta = m.list_new()
  m.list_push(ta, m.double_literal(v: 1.5, line: 1, col: 1))
  let type_node = m.intrinsic(name: 'typeof', args_list: ta, line: 1, col: 1)
  let tb = m.list_new()
  m.list_push(tb, m.double_literal(v: -2.9, line: 1, col: 1))
  let toint_node = m.intrinsic(name: 'toint', args_list: tb, line: 1, col: 1)
  let tc = m.list_new()
  m.list_push(tc, m.double_literal(v: 5.5, line: 1, col: 1))
  m.list_push(tc, m.literal(v: 2, line: 1, col: 1))
  let fmod_node = m.intrinsic(name: 'fmod', args_list: tc, line: 1, col: 1)
  let byte_node = m.index(recv: m.str_literal(s: 'abc', line: 1, col: 1),
                          key: m.literal(v: 1, line: 1, col: 1),
                          line: 1, col: 1)
  let td = m.list_new()
  m.list_push(td, m.str_literal(s: 'no newline->', line: 1, col: 1))
  let raw_node = m.intrinsic(name: 'printraw', args_list: td, line: 1, col: 1)
  let body = stmt_block(m, [
    print_stmt(m, cat),
    print_stmt(m, tostr_node(m, m.double_literal(v: 4.0, line: 1, col: 1))),
    print_stmt(m, m.bool_literal(v: true, line: 1, col: 1)),
    print_stmt(m, m.nil_literal(line: 1, col: 1)),
    print_stmt(m, type_node),
    print_stmt(m, toint_node),
    print_stmt(m, fmod_node),
    raw_node,
    print_stmt(m, byte_node),
  ])
  m.add_func(name: 'main', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body: body)
  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "hi 42\n4\ntrue\nnil\ndouble\n-2\n1.5\nno newline->b\n")
}

# Bitwise operators, masked shifts included.
{
  let m = CodeGen.Module.new()
  fn lit(m, v) { m.literal(v: v, line: 1, col: 1) }
  fn bop(m, op, l, r) { m.binary(op: op, lhs: l, rhs: r, line: 1, col: 1) }
  let body = stmt_block(m, [
    print_stmt(m, bop(m, 'bitand', lit(m, 6), lit(m, 3))),
    print_stmt(m, bop(m, 'bitor', lit(m, 6), lit(m, 3))),
    print_stmt(m, bop(m, 'bitxor', lit(m, 6), lit(m, 3))),
    print_stmt(m, m.unary(op: 'bitnot', operand: lit(m, 7), line: 1, col: 1)),
    print_stmt(m, bop(m, 'shl', lit(m, 1), lit(m, 64))),
    print_stmt(m, bop(m, 'shr', lit(m, -5), lit(m, 1))),
  ])
  m.add_func(name: 'main', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body: body)
  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "2\n7\n5\n-8\n1\n-3\n")
}

# Containers: array and object literals, index, set_index, len.
{
  let m = CodeGen.Module.new()
  fn lit(m, v) { m.literal(v: v, line: 1, col: 1) }
  fn strl(m, v) { m.str_literal(s: v, line: 1, col: 1) }
  let items = m.list_new()
  m.list_push(items, lit(m, 10))
  m.list_push(items, lit(m, 20))
  let arr = m.array_lit(items_list: items, line: 1, col: 1)
  let store_arr = m.assign(kind: 'local', index: 0, value: arr, line: 1, col: 1)
  let put = m.set_index(recv: m.var_ref(kind: 'local', index: 0, line: 1, col: 1),
                        key: lit(m, 1), value: lit(m, 99), line: 1, col: 1)
  let len_args = m.list_new()
  m.list_push(len_args, m.var_ref(kind: 'local', index: 0, line: 1, col: 1))
  let kvs = m.list_new()
  m.list_push(kvs, strl(m, 'k'))
  m.list_push(kvs, lit(m, 7))
  let obj = m.object_lit(kv_list: kvs, line: 1, col: 1)
  let body = stmt_block(m, [
    store_arr,
    put,
    print_stmt(m, m.index(recv: m.var_ref(kind: 'local', index: 0, line: 1, col: 1), key: lit(m, 1), line: 1, col: 1)),
    print_stmt(m, m.intrinsic(name: 'len', args_list: len_args, line: 1, col: 1)),
    print_stmt(m, m.index(recv: obj, key: strl(m, 'k'), line: 1, col: 1)),
  ])
  m.add_func(name: 'main', num_locals: 1, num_captures: 0, num_cells: 0, num_params: 0, body: body)
  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "99\n2\n7\n")
}

# Scope + defer + break: the defer fires when the loop-body scope exits
# sideways, then the loop is left.
{
  let m = CodeGen.Module.new()
  let cmap = m.add_capture_map(m.capture_map_new())
  let dbody = print_stmt(m, m.str_literal(s: 'deferred', line: 2, col: 1))
  let inner = stmt_block(m, [
    m.make_defer(value: m.make_closure(func: 1, cmap: cmap, line: 2, col: 1), line: 2, col: 1),
    m.make_break(line: 3, col: 1),
  ])
  let loop = m.make_while(cond: m.bool_literal(v: true, line: 1, col: 1),
                          body: m.scope(first_local: 0, end_local: 0, body: inner, line: 1, col: 1),
                          line: 1, col: 1)
  let body = stmt_block(m, [loop, print_stmt(m, m.str_literal(s: 'after', line: 4, col: 1))])
  m.add_func(name: 'main', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body: body)
  m.add_func(name: 'dfn', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body: dbody)
  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "deferred\nafter\n")
}

# throw / try_catch: a handler resumes execution; a VM trap is catchable and
# carries {message, line, col}.
{
  let m = CodeGen.Module.new()
  fn strl(m, v) { m.str_literal(s: v, line: 1, col: 1) }
  let thr = m.make_throw(value: strl(m, 'boom'), line: 1, col: 1)
  let handler = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  let caught = m.make_try(caught_local: 0, body: thr, handler: handler, line: 1, col: 1)
  let trap = m.binary(op: 'div', lhs: m.literal(v: 1, line: 5, col: 1), rhs: m.literal(v: 0, line: 5, col: 9), line: 5, col: 1)
  let trap_handler = m.index(recv: m.var_ref(kind: 'local', index: 0, line: 6, col: 1), key: strl(m, 'message'), line: 6, col: 1)
  let caught2 = m.make_try(caught_local: 0, body: trap, handler: trap_handler, line: 5, col: 1)
  let body = stmt_block(m, [
    print_stmt(m, caught),
    print_stmt(m, caught2),
    print_stmt(m, strl(m, 'alive')),
  ])
  m.add_func(name: 'main', num_locals: 1, num_captures: 0, num_cells: 0, num_params: 0, body: body)
  m.set_local_name(func: 0, index: 0, name: 'e')
  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "boom\ndivide by zero\nalive\n")
}

# cell_fresh: each loop entry gets its own box; the closure built before
# the refresh keeps the old one.
{
  let m = CodeGen.Module.new()
  let c = m.capture_map_new()
  m.capture_map_push(c, kind: 'cell', index: 0)
  let cmap = m.add_capture_map(c)
  # funcs[1]: () -> captured x
  let stmts = m.list_new()
  m.list_push(stmts, m.assign(kind: 'cell', index: 0, value: m.literal(v: 1, line: 1, col: 1), line: 1, col: 1))
  m.list_push(stmts, m.assign(kind: 'local', index: 0, value: m.make_closure(func: 1, cmap: cmap, line: 2, col: 1), line: 2, col: 1))
  m.list_push(stmts, m.cell_fresh(cell: 0, line: 3, col: 1))
  m.list_push(stmts, m.assign(kind: 'cell', index: 0, value: m.literal(v: 2, line: 3, col: 2), line: 3, col: 2))
  let call_args = m.list_new()
  let read_old = m.call_value(callee: m.var_ref(kind: 'local', index: 0, line: 4, col: 1), args_list: call_args, line: 4, col: 1)
  m.list_push(stmts, print_stmt(m, read_old))
  m.add_func(name: 'main', num_locals: 1, num_captures: 0, num_cells: 1, num_params: 0,
             body: m.block(stmts_list: stmts, line: 1, col: 1))
  m.add_func(name: 'get', num_locals: 0, num_captures: 1, num_cells: 0, num_params: 0,
             body: m.var_ref(kind: 'capture', index: 0, line: 1, col: 1))
  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "1\n")
}

# return: the value comes back, the rest of the body does not run.
{
  let m = CodeGen.Module.new()
  let cmap = m.add_capture_map(m.capture_map_new())
  let ret = m.make_return(value: m.literal(v: 42, line: 2, col: 3), line: 2, col: 3)
  let fbody = stmt_block(m, [ret, print_stmt(m, m.literal(v: 7, line: 3, col: 3))])
  let call = m.call(func: 1, cmap: cmap, line: 1, col: 1)
  m.add_func(name: 'main', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body: print_stmt(m, call))
  m.add_func(name: 'f', num_locals: 0, num_captures: 0, num_cells: 0, num_params: 0, body: fbody)
  m.verify()
  assert_eq(IO.capture(fn () { m.run() }), "42\n")
}

println('test_codegen OK')
