# Conformance: item 5 of the `@value` V-1 plan, "reboxing at boundaries"
# (spec §15.8, `project_value_type_spec` memory). A run this mechanism
# proved can stay unboxed for its whole scope may still reach a consumer
# nothing here taught to read a run — an ordinary call's argument, a
# container-literal element, a container store. At exactly those
# occurrences, `Op::ValueBox` reboxes the run into an ordinary, frozen
# instance instead of forcing the WHOLE binding boxed for declining once.
#
# Scope note: the instance is built by its class object, read where the run
# is. A run only exists where a construction named the class, so the name's
# binding is in scope there — the declaration's own, or the capture a nested
# function already holds for it, to any depth of nesting
# (`test_cross_chunk_materializes` below covers one and two levels down).
#
# Run: ./build/culebra tests/test_value_materialize.cul
#      ./build/culebra --jit tests/test_value_materialize.cul

@value
class V2 {
  x: Float
  y: Float

  new(x: Float, y: Float) {
    self.x = x
    self.y = y
  }

  __add__(o) {
    V2.new(self.x + o.x, self.y + o.y)
  }

  swap() {
    V2.new(self.y, self.x)
  }
}

fn takes_untyped(v) {
  v
}

# --- ordinary call argument (any callee, not only println) ---

mut v = V2.new(1.0, 2.0)
assert_eq(takes_untyped(v).x, 1.0)
assert_eq(takes_untyped(v).y, 2.0)
# the binding keeps running after being materialized at that call site —
# materialize_run is a snapshot read, not a consuming one.
v = v + V2.new(1.0, 1.0)
assert_eq(v.x, 2.0)
assert_eq(v.y, 3.0)
assert_eq(takes_untyped(v).x, 2.0)

# --- container-literal elements: array / tuple / set / object ---

let arr = [v, V2.new(9.0, 9.0)]
assert_eq(arr[0].x, 2.0)
assert_eq(arr[1].x, 9.0)

let tup = (v, 1)
assert_eq(tup[0].y, 3.0)

let s = [v].to_set()
assert_eq(s.size(), 1)

let obj_long = {a: v}
assert_eq(obj_long['a'].x, 2.0)
let obj_short = {v}
assert_eq(obj_short['v'].x, 2.0)

# --- container store via index / property assignment ---

mut store = []
store.push(nil)
store[0] = v
assert_eq(store[0].y, 3.0)

class Box {
  val: Object
}
let b = Box.new()
b.val = v
assert_eq(b.val.x, 2.0)

# --- structural identity: a materialized run equals a freshly boxed twin ---

assert_eq(takes_untyped(v), V2.new(v.x, v.y))
assert_eq(takes_untyped(v).keys(), ['x', 'y'])

# --- no leak across many materialize-and-discard iterations ---

# Measured mid-loop, not bracketing it from outside: `culebra test`'s own
# session/REPL machinery allocates a one-time object right around a bare
# top-level statement (reproduced with a plain, non-`@value` class too —
# not this feature's leak), so the only sound comparison is two points
# already inside the steady state.
# Both readings land in locals before a matcher is named: the first call of
# one materializes it, and the callee is evaluated before the arguments.
# A bound, not equality — the readings drift by a couple of objects with
# where a collection falls (equality failed ~17% of optimized `--jit`
# runs), while a per-iteration leak would show up 490 times over.
mut live_at_10 = -1
for i in 0..500 {
  takes_untyped(v)
  if i == 9 { live_at_10 = GC.stat().live_objects }
}
let live_at_500 = GC.stat().live_objects
assert_le(live_at_500 - live_at_10, 4)

# --- a locally-declared class materializes too: its binding is a local of
# the chunk that holds the run ---

test_local_class_boundary = fn () {
  @value
  class Local {
    a: Long

    new(a: Long) {
      self.a = a
    }
  }
  mut lv = Local.new(1)
  lv = Local.new(lv.a + 1)
  assert_eq(takes_untyped(lv).a, 2)
  let held = [lv]
  assert_eq(held[0].a, 2)
}
test_local_class_boundary()

# --- cross-chunk: a boundary occurrence of a class declared in an OUTER
# frame materializes too, one level down and two — pinned on the bytecode
# (--vm-dump), not just the output, per this feature's own §14 lesson that
# a decline and a correct splice can print the same thing ---

test_cross_chunk_materializes = fn () {
  mut w = V2.new(5.0, 6.0)
  assert_eq(takes_untyped(w).x, 5.0)
  let held = [w]
  assert_eq(held[0].y, 6.0)
}
test_cross_chunk_materializes()

test_cross_chunk_materializes_two_levels = fn () {
  fn inner() {
    mut z = V2.new(7.0, 8.0)
    assert_eq(takes_untyped(z).x, 7.0)
    let held = [z]
    assert_eq(held[0].y, 8.0)
  }
  inner()
}
test_cross_chunk_materializes_two_levels()

# --- a reboxed run is an instance of its class, built by the class object
# like one `new` made: a member that names its own class reads it off its
# receiver, so every such member (every operator) has to find it there ---

test_reboxed_run_knows_its_class = fn () {
  let v = V2.new(1.0, 2.0)
  let w = takes_untyped(v)
  assert_eq(w.swap().x, 2.0)
  assert_eq((w + w).y, 4.0)
  assert_eq(class_of(w), V2)
  assert_eq(class_of(w), class_of([V2.new(0.0, 0.0)][0]))
  # a chunk below the declaration reads the class through its capture
  let inner = fn () {
    let c = V2.new(5.0, 6.0)
    takes_untyped(c).swap().x
  }
  assert_eq(inner(), 6.0)
}
test_reboxed_run_knows_its_class()

# --- a stdlib module's class has no binding to read: its run is reboxed by
# the class the namespace of its name holds ---

test_stdlib_class_materializes = fn () {
  mut p = Vector2.new(1.0, 2.0)
  p = p + Vector2.new(0.5, 0.5)
  let boxed = takes_untyped(p)
  assert_eq(boxed, Vector2.new(1.5, 2.5))
  assert_eq(class_of(boxed), Vector2)
  assert_eq((boxed + boxed).x, 3.0)
}
test_stdlib_class_materializes()

# --- an assignment read for its value: a declaration or a write that ends
# a body hands the caller the instance, not the first slot of the run ---

test_tail_assignment_is_an_instance = fn () {
  let decl = fn () {
    let a = V2.new(1.0, 0.25)
    let b = V2.new(2.0, 3.0)
  }
  assert_eq(decl(), V2.new(2.0, 3.0))
  let write = fn () {
    mut a = V2.new(1.0, 0.25)
    let b = V2.new(7.0, 8.0)
    a = V2.new(2.0, 3.0)
  }
  assert_eq(write(), V2.new(2.0, 3.0))
  let step = fn () {
    mut a = V2.new(1.0, 0.25)
    let b = V2.new(7.0, 8.0)
    a += b
  }
  assert_eq(step(), V2.new(8.0, 8.25))
  let arm = fn (first) {
    let u = V2.new(7.0, 8.0)
    if first {
      let a = V2.new(1.0, 2.0)
      let b = V2.new(3.0, 4.0)
    } else {
      mut a = V2.new(5.0, 6.0)
      a = a + u
    }
  }
  assert_eq(arm(true), V2.new(3.0, 4.0))
  assert_eq(arm(false), V2.new(12.0, 14.0))
  # an `if` written as a statement: nobody reads its arms' values, and the
  # binding a write ends one with goes on as a run (resolve_shape_test.sh
  # holds that no instance is built there)
  let stepped = fn () {
    mut a = V2.new(0.0, 0.0)
    for i in 0..3 {
      if i > 0 {
        a = a + V2.new(1.0, 2.0)
      } else {
        a += V2.new(0.5, 0.5)
      }
    }
    [a.x, a.y]
  }
  assert_eq(stepped(), [2.5, 4.5])
}
test_tail_assignment_is_an_instance()

inspect('value-materialize OK')
