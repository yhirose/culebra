# Conformance: §17 (iterator protocol), §18. See docs/language.md §25.
#
# The lazy combinator families: skip_while / contains / first / last /
# nth / position, numeric aggregates, min_by / max_by, to_set /
# group_by / partition, flatten / scan / distinct / tap / step_by /
# chunk_by, and the unbounded-source laziness contract. Split from
# test_iter.cul (see test_iter_terminal.cul for why).
#
# Run with:  ./build/culebra tests/test_iter_combinators.cul
#            ./build/culebra --jit tests/test_iter_combinators.cul

# --- skip_while: the complement of take_while ------------------------------
# Drops the leading run, then forwards everything (predicate not consulted
# again, so a later element that matches is still emitted).
assert_eq([1, 2, 3, 8, 2, 1].iter().skip_while(|x| x < 5).collect(), [8, 2, 1])
assert_eq(range(10).skip_while(|x| x < 7).collect(), [7, 8, 9])
assert_eq([1, 2, 3].iter().skip_while(|x| x < 99).collect(), [])        # all skipped
assert_eq([9, 1, 2].iter().skip_while(|x| x < 5).collect(), [9, 1, 2])  # none
assert_eq([].iter().skip_while(|x| true).collect(), [])
# take_while / skip_while split the same stream in two
mut src = [1, 2, 3, 8, 2]
mut head = src.iter().take_while(|x| x < 5).collect()
mut tail = src.iter().skip_while(|x| x < 5).collect()
assert_eq([...head, ...tail], src)

# --- contains: short-circuiting membership on a lazy receiver ---------------
assert_true([1, 2, 3].iter().contains(2))
assert_true(![1, 2, 3].iter().contains(9))
assert_true([1, 2, 3].iter().map(|x| x * 2).contains(6))
assert_true(![].iter().contains(1))
assert_true([[1, 2], [3]].iter().contains([1, 2]))  # structural equality
assert_true(['a', 'b'].iter().contains('b'))
# the eager receivers still route to their own arms
assert_true([1, 2, 3].contains(2))
assert_true('hello'.contains('ell'))
assert_true({1, 2}.contains(2))

# --- first / last / nth: nil when the iterator runs out --------------------
assert_eq([5, 6, 7].iter().first(), 5)
assert_eq([5, 6, 7].iter().last(), 7)
assert_eq([].iter().first(), nil)
assert_eq([].iter().last(), nil)
assert_eq([10, 20, 30, 40].iter().nth(0), 10)
assert_eq([10, 20, 30, 40].iter().nth(2), 30)
assert_eq([10, 20].iter().nth(5), nil)
try {
  [1].iter().nth(-1)
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}

# --- position: index of the first match, nil when none ---------------------
assert_eq([1, 5, 12, 3].iter().position(|v| v > 10), 2)
assert_eq([1, 2, 3].iter().position(|v| v == 1), 0)
assert_eq([1, 2].iter().position(|v| v > 10), nil)
assert_eq([].iter().position(|v| true), nil)

# --- laziness: none of these may drain an unbounded source -----------------
fn naturals() {
  mut n = 0
  {has_next: fn () {
      true
    }, next: fn () {
      n = n + 1
      n - 1
    }}
}
assert_eq(naturals().skip_while(|x| x < 3).first(), 3)
assert_eq(naturals().position(|x| x == 4), 4)
assert_true(naturals().contains(2))
assert_eq(naturals().nth(6), 6)
# only as many pulls as the answer needs
mut pulls = 0
assert_eq(range(1000000).map(fn (x) {
      pulls = pulls + 1
      x
    }).nth(3), 3)
assert_eq(pulls, 4)

# --- numeric aggregates accept Float -------------------------------------
# Long in, Long out: an all-Long input must not drift to Float.
assert_eq([1, 2, 3].sum(), 6)
assert_eq([1, 2, 3].product(), 6)
assert_eq([1, 2, 3].iter().sum(), 6)
assert_eq([1, 2, 3].iter().product(), 6)
# One Float promotes the whole fold.
assert_eq([1, 2.5].sum(), 3.5)
assert_eq([2, 2.5].product(), 5.0)
assert_eq([1, 2.5].iter().sum(), 3.5)
assert_eq(range(5).map(|x| x * 1.5).sum(), 15.0)
# min/max return the winning ELEMENT, so its own type survives.
assert_eq([1, 2.5].min(), 1)
assert_eq([1, 2.5].max(), 2.5)
assert_eq([2.5, 3].max(), 3)
assert_eq([1.5, 2.5].iter().min(), 1.5)
# Ties keep the earlier element (2.0 and 2 compare equal).
assert_eq([2.0, 2].min(), 2.0)
assert_eq([2, 2.0].min(), 2)
# Empty folds keep their Long identity; empty min/max still throw.
assert_eq([].sum(), 0)
assert_eq([].product(), 1)
assert_eq([].iter().sum(), 0)
try {
  [].min()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}
try {
  [].iter().max()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}
# A non-numeric element names both accepted types.
try {
  [1, 'x'].iter().sum()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
  assert_true(e.message.contains("Long or Float"))
}

# --- min_by / max_by -----------------------------------------------------
# The key orders, the element comes back. Both receiver kinds.
mut people = [{name: 'a', age: 30}, {name: 'b', age: 20}, {name: 'c', age: 25}]
assert_eq(people.min_by(|p| p.age).name, 'b')
assert_eq(people.max_by(|p| p.age).name, 'a')
assert_eq(people.iter().min_by(|p| p.age).name, 'b')
assert_eq(people.iter().max_by(|p| p.age).name, 'a')
assert_eq(['aa', 'b', 'ccc'].max_by(|s| s.size()), 'ccc')
assert_eq(['aa', 'b', 'ccc'].iter().min_by(|s| s.size()), 'b')
# Float keys are fine, and an inverted key inverts the winner.
assert_eq([1, 2, 3].min_by(|x| 0 - x * 1.5), 3)
assert_eq([1, 2, 3].max_by(|x| -x), 1)
# Ties keep the earlier element.
assert_eq([{k: 1, t: 'first'}, {k: 1, t: 'second'}].min_by(|o| o.k).t, 'first')
assert_eq([{k: 1, t: 'first'}, {k: 1, t: 'second'}].max_by(|o| o.k).t, 'first')
# The key is computed exactly once per element.
mut keycalls = 0
assert_eq([5, 3, 9, 1].min_by(fn (x) {
    keycalls = keycalls + 1
    x
  }), 1)
assert_eq(keycalls, 4)
# Empty throws, like min/max.
try {
  [].min_by(|x| x)
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}
try {
  [].iter().max_by(|x| x)
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}
# A non-numeric key reports like the unkeyed forms.
try {
  [1, 2].min_by(|x| 'k')
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# --- to_set / group_by / partition ---------------------------------------
# to_set is the only way to build a Set from a collection (set literals are
# the only other spelling), so it serves Array receivers as well.
assert_eq([1, 2, 2, 3, 1].to_set(), {1, 2, 3})
assert_eq([1, 2, 2, 3, 1].iter().to_set(), {1, 2, 3})
assert_eq([].to_set().size(), 0)
assert_eq([].iter().to_set().size(), 0)
assert_eq(range(5).map(|x| x % 2).to_set(), {0, 1})
assert_eq([(1, 2), (1, 2), (3, 4)].to_set(), {(1, 2), (3, 4)})
# First-seen order is kept. Member identity follows Object-key identity,
# which distinguishes types rather than numeric value, so these stay three.
assert_eq(['b', 'a', 'b'].to_set().to_array(), ['b', 'a'])
assert_eq([1, 1.0, true].to_set().size(), 3)
assert_eq([1, 1.0, true].to_set(), {1, 1.0, true})
# An unhashable element reports like any other unhashable key.
try {
  [[1]].to_set()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}
try {
  [[1]].iter().to_set()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# to_object is to_set's Object twin: the way back from (key, value) pairs,
# so a lookup table is an expression (a `let`) instead of a `mut` + loop.
assert_eq([('a', 1), ('b', 2)].to_object(), {a: 1, b: 2})
assert_eq([('a', 1), ('b', 2)].iter().to_object(), {a: 1, b: 2})
assert_eq([].to_object().size(), 0)
assert_eq([].iter().to_object().size(), 0)
# It inverts Object.iter(), so the pair round-trips and a value remap is a chain.
mut src = {a: 1, b: 2, c: 3}
assert_eq(src.iter().to_object(), src)
assert_eq(
  src.iter().map(|(k, v)| (k, v * 10)).to_object(),
  {a: 10, b: 20, c: 30},
)
assert_eq(['x', 'y'].enumerate().map(|(i, n)| (n, i)).to_object(), {x: 0, y: 1})
# A repeated key overwrites in place: last value, first-seen position.
assert_eq([('a', 1), ('b', 2), ('a', 9)].to_object(), {a: 9, b: 2})
assert_eq([('a', 1), ('b', 2), ('a', 9)].to_object().keys(), ['a', 'b'])
# Non-String keys work, exactly as `o[k] = v` does.
assert_eq([(1, 'x'), (2, 'y')].to_object()[1], 'x')
assert_eq([(1, 'x'), ('s', 'y'), (true, 'z')].to_object().size(), 3)
# Entries are mutable, like a normal runtime-inserted dict entry (`o[k] = v`).
mut built = [('a', 1)].to_object()
built.a = 2
assert_eq(built.a, 2)
# An element that is not a 2-tuple, and an unhashable key, both report here.
try {
  [1, 2].to_object()
  assert_true(false)
} catch e {
  assert_eq(e.message, "type error: to_object expects (key, value) tuples")
}
try {
  [('a', 1, 2)].iter().to_object()
  assert_true(false)
} catch e {
  assert_eq(e.message, "type error: to_object expects (key, value) tuples")
}
try {
  [([1], 'v')].to_object()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# group_by buckets into Arrays under f(x), in first-seen key order.
mut staff = [{n: 'a', d: 'eng'}, {n: 'b', d: 'ops'}, {n: 'c', d: 'eng'}]
assert_eq(staff.group_by(|p| p.d).eng.size(), 2)
assert_eq(staff.iter().group_by(|p| p.d).ops.size(), 1)
assert_eq([1, 2, 3, 4, 5].group_by(|x| x % 2)[1], [1, 3, 5])
assert_eq([1, 2, 3, 4, 5].iter().group_by(|x| x % 2)[0], [2, 4])
assert_eq(['aa', 'b', 'cc'].group_by(|s| s.size())[2], ['aa', 'cc'])
assert_eq([].group_by(|x| x).keys().size(), 0)
try {
  [1].group_by(|x| [x])
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# partition splits in one pass and returns a Tuple, so it destructures.
assert_eq([1, 2, 3, 4, 5].partition(|x| x % 2 == 0), ([2, 4], [1, 3, 5]))
assert_eq([1, 2, 3, 4, 5].iter().partition(|x| x % 2 == 0), ([2, 4], [1, 3, 5]))
mut evens = nil
mut odds = nil
(evens, odds) = [1, 2, 3, 4].partition(|x| x % 2 == 0)
assert_eq(evens, [2, 4])
assert_eq(odds, [1, 3])
# Order is preserved in both halves, and an all-or-nothing predicate is fine.
assert_eq([1, 2, 3].partition(|x| true), ([1, 2, 3], []))
assert_eq([1, 2, 3].partition(|x| false), ([], [1, 2, 3]))
assert_eq([].iter().partition(|x| true), ([], []))

# --- unzip: the inverse of zip's {first, second} pairs ---------------------
# Duck-typed: a 2-element Tuple or an Object with first/second (what zip
# yields) are both accepted, so it inverts either pair convention.
assert_eq([(1, 'a'), (2, 'b'), (3, 'c')].unzip(), ([1, 2, 3], ['a', 'b', 'c']))
assert_eq([(1, 'a'), (2, 'b')].iter().unzip(), ([1, 2], ['a', 'b']))
assert_eq([].unzip(), ([], []))
assert_eq([].iter().unzip(), ([], []))
mut xs = nil
mut ys = nil
(xs, ys) = [1, 2, 3].iter().zip([10, 20, 30]).unzip()
assert_eq(xs, [1, 2, 3])
assert_eq(ys, [10, 20, 30])
# enumerate() yields (index, value) tuples — the same pair shape as a
# hand-written 2-tuple — so unzip inverts it too.
assert_eq(['p', 'q'].iter().enumerate().unzip(), ([0, 1], ['p', 'q']))
# Heterogeneous halves keep each element's own type.
assert_eq(
  [(1, 'x'), (true, 'y'), (1.5, 'z')].unzip(),
  ([1, true, 1.5], ['x', 'y', 'z']),
)
# An Object pair with extra keys still works — only first/second matter.
assert_eq([{first: 1, second: 2, extra: 3}].unzip(), ([1], [2]))
try {
  [1, 2, 3].unzip()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
  assert_eq(
    e.message,
    'type error: unzip expects (a, b) tuples or {first, second} objects',
  )
}
try {
  [(1, 2, 3)].unzip()  # wrong Tuple arity
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}
try {
  [{first: 1}].iter().unzip()  # Object missing `second`
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# --- flatten: one level of nesting removed ---------------------------------
assert_eq([[1, 2], [3], [], [4, 5]].iter().flatten().collect(), [1, 2, 3, 4, 5])
assert_eq([[[1]], [[2]]].iter().flatten().collect(), [[1], [2]])  # one level only
assert_eq([].iter().flatten().collect(), [])
# Any iterable inner works, including String and Set (same coercion flat_map uses)
assert_eq(['ab', 'cd'].iter().flatten().collect(), ['a', 'b', 'c', 'd'])
mut s1 = {1, 2}
assert_eq([s1, s1].iter().flatten().collect(), [1, 2, 1, 2])
assert_eq(['ab'].iter().flat_map(|s| s).collect(), ['a', 'b'])
try {
  [1, 2].iter().flatten().collect()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# --- scan: running fold, one output per input ------------------------------
assert_eq([1, 2, 3, 4].iter().scan(0, |a, x| a + x).collect(), [1, 3, 6, 10])
assert_eq([1, 2, 3].iter().scan(1, |a, x| a * x).collect(), [1, 2, 6])
assert_eq(['a', 'b'].iter().scan('', |a, x| a + x).collect(), ['a', 'ab'])
assert_eq([].iter().scan(0, |a, x| a + x).collect(), [])  # init is not yielded
try {
  [1].iter().scan(0, |x| x).collect()
  assert_true(false)
} catch e {
  assert_eq(e.message, "type error: scan expects a 2-parameter function")
}

# --- distinct: first occurrence wins ---------------------------------------
assert_eq([1, 2, 2, 3, 1, 2].iter().distinct().collect(), [1, 2, 3])
assert_eq(['b', 'a', 'b'].iter().distinct().collect(), ['b', 'a'])
assert_eq([].iter().distinct().collect(), [])
# Same key identity as to_set / Object keys: these three stay distinct.
assert_eq([1, 1.0, true].iter().distinct().collect().size(), 3)
try {
  [[1], [1]].iter().distinct().collect()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# --- tap: side effect, element passes through unchanged ---------------------
mut tapped = []
assert_eq([1, 2, 3].iter().tap(fn (x) {
      tapped.push(x)
    }).map(|x| x * 10).collect(), [10, 20, 30])
assert_eq(tapped, [1, 2, 3])
# Lazy: only the pulled elements run the callback.
mut probed = []
assert_eq(range(100).tap(fn (x) {
      probed.push(x)
    }).take(3).collect(), [0, 1, 2])
assert_eq(probed, [0, 1, 2])

# --- step_by: first element, then every n-th --------------------------------
assert_eq(range(10).step_by(3).collect(), [0, 3, 6, 9])
assert_eq([10, 20, 30, 40, 50].iter().step_by(2).collect(), [10, 30, 50])
assert_eq([1, 2, 3].iter().step_by(1).collect(), [1, 2, 3])
assert_eq([1, 2].iter().step_by(9).collect(), [1])  # first still yielded
assert_eq([].iter().step_by(2).collect(), [])
try {
  [1].iter().step_by(0).collect()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}

# --- chunk_by: ADJACENT elements only --------------------------------------
# A key that reappears after a different one starts a NEW run -- this is what
# separates it from group_by, which buckets by key regardless of position.
assert_eq(
  [1, 1, 2, 2, 2, 1].iter().chunk_by(|x| x).collect(),
  [[1, 1], [2, 2, 2], [1]],
)
assert_eq([1, 1, 2, 2, 2, 1].group_by(|x| x)[1], [1, 1, 1])  # contrast
assert_eq([1, 2, 3].iter().chunk_by(|x| x).collect(), [[1], [2], [3]])
assert_eq([1, 1, 1].iter().chunk_by(|x| x).collect(), [[1, 1, 1]])
assert_eq([].iter().chunk_by(|x| x).collect(), [])
assert_eq(
  ['aa', 'ab', 'bc'].iter().chunk_by(|s| s[0..1]).collect(),
  [['aa', 'ab'], ['bc']],
)

# --- all six stream an unbounded source ------------------------------------
fn naturals2() {
  mut n = 0
  {has_next: fn () {
      true
    }, next: fn () {
      n = n + 1
      n - 1
    }}
}
assert_eq(naturals2().scan(0, |a, x| a + x).take(5).collect(), [0, 1, 3, 6, 10])
assert_eq(naturals2().step_by(4).take(3).collect(), [0, 4, 8])
assert_eq(naturals2().map(|x| x % 3).distinct().take(3).collect(), [0, 1, 2])
assert_eq(
  naturals2().chunk_by(|x| x / 3).take(2).collect(),
  [[0, 1, 2], [3, 4, 5]],
)
assert_eq(naturals2().map(|x| [x]).flatten().take(3).collect(), [0, 1, 2])
