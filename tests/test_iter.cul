# Conformance: §12 (for ... in), §17 (iterator protocol, String methods),
# §18 (range, iota). See docs/language.md §25.
#
# For-in / iterator protocol regression tests.
#
# Exercised on both the tree interpreter and the JIT. Direct for-in
# over Array/Object/String is tested in test_core.cul (test_for_in); this
# file focuses on the user-level iterator protocol and the lazy
# iterator methods.
#
# Run with:  ./build/culebra tests/test_iter.cul
#            ./build/culebra --jit tests/test_iter.cul

# Array iteration
mut sum = 0
for x in [1, 2, 3, 4] { sum = sum + x }
assert_eq(sum, 10)

# Object iteration yields (key, value) pairs in insertion order
mut keys = []
mut vals = []
for k, v in {b: 2, a: 1, c: 3} { keys.push(k); vals.push(v) }
assert_eq(keys, ['b', 'a', 'c'])
assert_eq(vals, [2, 1, 3])

# break exits inner loop only
mut hit = 0
for i in [1, 2, 3] {
  for j in [10, 20, 30] {
    if j == 20 { break }
    hit = hit + 1
  }
}
assert_eq(hit, 3)

# continue skips
mut evens = 0
for x in [1, 2, 3, 4, 5, 6] {
  if x % 2 == 1 { continue }
  evens = evens + 1
}
assert_eq(evens, 3)

# User-defined iterator (new Iterator/Iterable protocol)
once = fn (v) {
  mut emitted = false
  {
    iter: fn () { self },
    has_next: fn () { !emitted },
    next: fn () { emitted = true; v }
  }
}
mut seen = []
for x in once(42) { seen.push(x) }
assert_true(seen.size() == 1 && seen[0] == 42)

# Empty iteration
mut touched = false
for _ in [] { touched = true }
assert_false(touched)

# Iteration over iota (factory-returned Array)
mut total = 0
for i in iota(5) { total = total + i }
assert_eq(total, 10)

# --- Phase 2: String iteration (UTF-8 scalar walk) ---
mut count = 0
for c in 'hello' { count = count + 1 }
assert_eq(count, 5)

# Non-ASCII: 'café' is 5 UTF-8 bytes but 4 scalars
mut scalars = 0
for c in 'café' { scalars = scalars + 1 }
assert_eq(scalars, 4)

# Scalars are yielded as 1-char Strings, not Longs
mut parts = []
for c in 'ab' { parts.push(c) }
assert_eq(parts.size(), 2)
assert_true(parts[0] == 'a' && parts[1] == 'b')

# --- String.code_points() — Iterator<Long> over Unicode scalars ---
cps = 'café'.code_points().collect()
assert_eq(cps.size(), 4)
assert_true(cps[0] == 99 && cps[1] == 97 && cps[2] == 102 && cps[3] == 233)

# Numeric ops are natural on code points (range / classification)
upper = 'Hello World'.code_points()
  .filter(fn (cp) { cp >= 65 && cp <= 90 })
  .count()
assert_eq(upper, 2)

# Empty and ASCII-only
assert_eq(''.code_points().count(), 0)
assert_eq('hello'.code_points().count(), 5)

# --- String.graphemes() — Iterator<String> over Extended Grapheme Clusters ---
gs = 'a👨‍👩‍👧b'.graphemes().collect()
assert_eq(gs.size(), 3)
assert_eq(gs[0], 'a')
assert_eq(gs[1], '👨‍👩‍👧')
assert_eq(gs[2], 'b')

# No combining marks → each scalar is its own grapheme
assert_eq('café'.graphemes().count(), 4)
# Scalar count depends on exact source bytes (ZWJ separators included);
# grapheme count is the API-level guarantee.
assert_eq('a👨‍👩‍👧b'.code_points().count(), 7)
assert_eq('a👨‍👩‍👧b'.graphemes().count(), 3)
assert_eq(''.graphemes().count(), 0)

# --- String.bytes() — Iterator<Long> over raw UTF-8 bytes (no decoding) ---
bs = 'café'.bytes().collect()
assert_eq(bs.size(), 5)  # 'é' is 2 bytes; code_points() above sees 4 scalars
assert_true(bs[0] == 99 && bs[1] == 97 && bs[2] == 102 && bs[3] == 195 && bs[4] == 169)
assert_eq(''.bytes().count(), 0)
assert_eq('hello'.bytes().count(), 5)
# ASCII: bytes() and code_points() agree
assert_eq('hello'.bytes().collect(), 'hello'.code_points().collect())

# --- String.from_code_point(cp) — inverse of code_points()/\u{...} ---
assert_eq(String.from_code_point(97), 'a')
assert_eq(String.from_code_point(233), 'é')
# Round-trips through code_points()
assert_eq(String.from_code_point('é'.code_points().collect()[0]), 'é')
assert_throws("ValueError", fn () { String.from_code_point(0x110000) })   # above max scalar
assert_throws("ValueError", fn () { String.from_code_point(0xD800) })     # surrogate range
assert_throws("TypeError", fn () { String.from_code_point('a') })        # not a Long

# --- String.from_code_points(cps) — plural inverse of code_points() ---
assert_eq(String.from_code_points([99, 97, 102, 233]), 'café')
assert_eq(String.from_code_points([]), '')
# Round-trips through code_points() for any String
assert_eq(String.from_code_points('café'.code_points().collect()), 'café')
assert_eq(String.from_code_points('a👨‍👩‍👧b'.code_points().collect()), 'a👨‍👩‍👧b')
# Agrees with the singular form
assert_eq(String.from_code_points([233]), String.from_code_point(233))
assert_throws("ValueError", fn () { String.from_code_points([0x110000]) })
assert_throws("ValueError", fn () { String.from_code_points([0xD800]) })
assert_throws("TypeError", fn () { String.from_code_points(['a']) })

# --- String.from_bytes(bytes) — inverse of bytes() (no UTF-8 validation) ---
assert_eq(String.from_bytes([99, 97, 102, 195, 169]), 'café')
assert_eq(String.from_bytes([]), '')
# Round-trips through bytes() for any String, including multi-byte scalars
assert_eq(String.from_bytes('café'.bytes().collect()), 'café')
assert_eq(String.from_bytes('a👨‍👩‍👧b'.bytes().collect()), 'a👨‍👩‍👧b')
# Invalid UTF-8 byte still builds — culebra Strings tolerate invalid UTF-8
assert_eq(String.from_bytes([0xFF]).bytes().collect(), [0xFF])
assert_throws("ValueError", fn () { String.from_bytes([256]) })   # above byte range
assert_throws("ValueError", fn () { String.from_bytes([-1]) })    # below byte range
assert_throws("TypeError", fn () { String.from_bytes(['a']) })    # not a Long

# --- Phase 2: range (lazy integer iterator) ---
mut sum = 0
for i in range(5) { sum = sum + i }
assert_eq(sum, 10)

# Empty range
mut touched = false
for _ in range(5, 2) { touched = true }
assert_false(touched)

# Large bounds with early break — must not OOM/hang
mut n = 0
for i in range(1000000) {
  n = i
  if i >= 3 { break }
}
assert_eq(n, 3)

# start, end form
mut coll = []
for i in range(3, 7) { coll.push(i) }
assert_eq(coll.size(), 4)
assert_true(coll[0] == 3 && coll[3] == 6)

# step: kwarg — keyword-only.
let evens = range(0, 10, step: 2).collect()
assert_eq(evens.size(), 5)
assert_true(evens[0] == 0 && evens[4] == 8)

let ones = range(10, step: 1).collect()
assert_true(ones.size() == 10 && ones[9] == 9)

let triples = range(10, step: 3).collect()
assert_true(triples.size() == 4 && triples[3] == 9)

# Negative step counts down (exclusive end).
let down = range(5, 0, step: -1).collect()
assert_eq(down.size(), 5)
assert_true(down[0] == 5 && down[4] == 1)

# step: 0 raises ValueError.
let err = try { range(10, step: 0).collect() } catch e { e }
assert_true(err.kind == 'ValueError' && err.message.contains('step'))

# --- Phase 3: non-terminal Iterator methods ---

# map
r1 = [1, 2, 3].iter().map(fn (x) { x * 10 }).collect()
assert_eq(r1.size(), 3)
assert_true(r1[0] == 10 && r1[2] == 30)

# filter
r2 = range(10).filter(fn (x) { x % 3 == 0 }).collect()
assert_eq(r2.size(), 4)
assert_true(r2[0] == 0 && r2[3] == 9)

# take — lazy: never touches the 1M elements beyond index 3
r3 = range(1000000).take(3).collect()
assert_eq(r3.size(), 3)
assert_true(r3[0] == 0 && r3[2] == 2)

# skip
r4 = range(10).skip(7).collect()
assert_eq(r4.size(), 3)
assert_true(r4[0] == 7 && r4[2] == 9)

# take_while
r5 = range(20).take_while(fn (x) { x < 5 }).collect()
assert_eq(r5.size(), 5)
assert_true(r5[0] == 0 && r5[4] == 4)

# chunks: last group may be shorter
assert_eq([1, 2, 3, 4, 5].iter().chunks(2).collect(), [[1, 2], [3, 4], [5]])
assert_eq(range(6).chunks(3).collect(), [[0, 1, 2], [3, 4, 5]])
assert_eq([].iter().chunks(2).collect(), [])
try {
  [1].iter().chunks(0).collect()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}

# windows: sliding, full windows only
assert_eq([1, 2, 3, 4, 5].iter().windows(3).collect(),
         [[1, 2, 3], [2, 3, 4], [3, 4, 5]])
assert_eq([1, 2].iter().windows(3).collect(), [])
try {
  [1].iter().windows(-1).collect()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}

# chain
r6 = [1, 2].iter().chain([3, 4]).collect()
assert_eq(r6.size(), 4)
assert_true(r6[0] == 1 && r6[3] == 4)

# zip: stops at shorter side
r7 = [1, 2, 3, 4].iter().zip([10, 20]).collect()
assert_eq(r7.size(), 2)
assert_true(r7[0].first == 1 && r7[0].second == 10)
assert_true(r7[1].first == 2 && r7[1].second == 20)

# enumerate yields (index, value) tuples
r8 = ['a', 'b'].iter().enumerate().collect()
assert_eq(r8, [(0, 'a'), (1, 'b')])

# flat_map
r9 = [[1, 2], [], [3]].iter().flat_map(fn (xs) { xs }).collect()
assert_eq(r9.size(), 3)
assert_true(r9[0] == 1 && r9[1] == 2 && r9[2] == 3)

# --- Phase 3: terminal Iterator methods ---

# for_each
mut acc = 0
[1, 2, 3].iter().for_each(fn (x) { acc = acc + x })
assert_eq(acc, 6)

# reduce
s = range(1, 6).reduce(0, fn (a, x) { a + x })
assert_eq(s, 15)

s2 = [].iter().reduce(42, fn (a, x) { a + x })
assert_eq(s2, 42)   # empty → init

# find
f = range(100).find(fn (x) { x > 10 && x % 3 == 0 })
assert_eq(f, 12)

f2 = [1, 2, 3].iter().find(fn (x) { x > 99 })
assert_eq(f2, nil)

# any / all
assert_eq([1, 2, 3].iter().any(fn (x) { x > 2 }), true)
assert_eq([1, 2, 3].iter().any(fn (x) { x > 99 }), false)
assert_eq([1, 2, 3].iter().all(fn (x) { x > 0 }), true)
assert_eq([1, 2, 3].iter().all(fn (x) { x > 1 }), false)
assert_eq([].iter().all(fn (x) { x > 0 }), true)   # vacuous truth

# count
assert_eq(range(100).filter(fn (x) { x % 7 == 0 }).count(), 15)
assert_eq([].iter().count(), 0)

# sum / product — identity on empty (0 / 1), same shape as math folds
assert_eq(range(1, 11).sum(), 55)
assert_eq([].iter().sum(), 0)
assert_eq(range(1, 6).product(), 120)
assert_eq([].iter().product(), 1)
assert_eq(range(100).filter(fn (x) { x % 3 == 0 }).sum(), 1683)

# min / max — empty input throws (tested via type_of check on a helper
# that would only produce a value on success)
assert_eq([5, 2, 8, 1, 9, 3].iter().min(), 1)
assert_eq([5, 2, 8, 1, 9, 3].iter().max(), 9)
assert_eq(range(-5, 5).min(), -5)
assert_eq(range(-5, 5).max(), 4)

# Chain of chains: lazy + terminal
head = range(1000000)
  .filter(fn (x) { x % 2 == 0 })
  .map(fn (x) { x * x })
  .take(4)
  .collect()
assert_eq(head.size(), 4)
assert_true(head[0] == 0 && head[1] == 4 && head[2] == 16 && head[3] == 36)

# Eager Array methods still win when the receiver is an Array
# (not an iterator). Array.map returns Array, not Iterator.
m = [1, 2, 3].map(fn (x) { x + 1 })
assert_eq(type_of(m), 'Array')
assert_true(m[0] == 2 && m[2] == 4)

# --- Edge cases --------------------------------------------------------

# collect() on a user-defined iterator that yields zero values
empty_iter = fn () {
  { iter: fn () { self }, has_next: fn () { false }, next: fn () { nil } }
}
assert_eq(empty_iter().collect().size(), 0)
assert_eq(empty_iter().count(), 0)
assert_eq(empty_iter().map(fn (x) { x }).collect().size(), 0)

# chain with mismatched / empty sides
c1 = [1, 2].iter().chain([]).collect()
assert_true(c1.size() == 2 && c1[0] == 1 && c1[1] == 2)
c2 = [].iter().chain([3, 4]).collect()
assert_true(c2.size() == 2 && c2[0] == 3 && c2[1] == 4)
c3 = [].iter().chain([]).collect()
assert_eq(c3.size(), 0)

# zip with mismatched / empty sides — result length is min(len(a), len(b))
z1 = [1, 2, 3].iter().zip([]).collect()
assert_eq(z1.size(), 0)
z2 = [].iter().zip([1, 2, 3]).collect()
assert_eq(z2.size(), 0)

# zip against a lazy iter: the longer side must not be consumed past
# the shorter side's length.
mut visited = 0
counted = range(1000000).map(fn (x) { visited = visited + 1; x })
z3 = [10, 20, 30].iter().zip(counted).collect()
assert_eq(z3.size(), 3)
# map pulls one element per zip step on the short side; the long side
# should have been touched exactly 3 times.
assert_eq(visited, 3)

# take_while stays stopped after the first rejection — a subsequent
# element that matches the predicate must NOT be emitted.
tw = [1, 2, 3, 0, 4, 5].iter().take_while(fn (x) { x > 0 }).collect()
assert_eq(tw.size(), 3)
assert_true(tw[0] == 1 && tw[1] == 2 && tw[2] == 3)

# enumerate on empty
assert_eq([].iter().enumerate().collect().size(), 0)

# flat_map with empty outer
assert_eq([].iter().flat_map(fn (x) { [x] }).collect().size(), 0)

# flat_map where some inner iterables are empty
fm = [[], [1], [], [2, 3], []].iter()
  .flat_map(fn (xs) { xs })
  .collect()
assert_eq(fm.size(), 3)
assert_true(fm[0] == 1 && fm[1] == 2 && fm[2] == 3)

# flat_map with range callbacks (non-Array iterable)
fm2 = [1, 2, 3].iter()
  .flat_map(fn (n) { range(n) })
  .collect()
assert_eq(fm2.size(), 6)
# range(1) + range(2) + range(3) = [0] + [0,1] + [0,1,2]
assert_true(fm2[0] == 0 && fm2[1] == 0 && fm2[2] == 1
    && fm2[3] == 0 && fm2[4] == 1 && fm2[5] == 2)

# Manually driving a user-defined iterator: has_next() drops to false
# after the single value is consumed; calling next() past the end is
# undefined (user-defined behavior) so we only assert the protocol.
drained = fn () {
  mut emitted = false
  {
    iter: fn () { self },
    has_next: fn () { !emitted },
    next: fn () { emitted = true; 7 }
  }
}
it = drained()
assert_eq(it.has_next(), true)
assert_eq(it.next(), 7)
assert_eq(it.has_next(), false)

# Nested for-in: outer binding must remain accessible after the inner
# loop ends. This also pins down that for-in binding scope stays within
# its own loop body and does not leak into enclosing scopes.
outer_seen = []
inner_seen = []
for x in [1, 2] {
  outer_seen.push(x)
  for y in [10, 20] { inner_seen.push(y) }
  outer_seen.push(x)   # `x` still bound here, inner loop did not rebind it
}
assert_eq(outer_seen.size(), 4)
assert_true(outer_seen[0] == 1 && outer_seen[1] == 1
    && outer_seen[2] == 2 && outer_seen[3] == 2)
assert_eq(inner_seen.size(), 4)
assert_true(inner_seen[0] == 10 && inner_seen[1] == 20
    && inner_seen[2] == 10 && inner_seen[3] == 20)

# --- User iterators compose with the lazy combinator chain ---
# A user `iter()` returning a `{has_next, next}` object gains the same lazy
# methods as a built-in iterator (map/filter/take/.../collect), driven via
# its has_next()/next().
class Countdown {
  new(n) { self.n = n }
  iter() {
    let mut i = self.n
    { has_next: fn() { i > 0 }, next: fn() { i = i - 1; i + 1 } }
  }
}
assert_eq(Countdown.new(5).iter().filter(|x| x % 2 == 0).collect(), [4, 2])
assert_eq(Countdown.new(5).iter().map(|x| x * 10).collect(), [50, 40, 30, 20, 10])
assert_eq(Countdown.new(5).iter().take(2).collect(), [5, 4])
assert_eq(Countdown.new(4).iter().map(|x| x + 1).filter(|x| x > 2).collect(), [5, 4, 3])

# Generators expose the same chain.
fn nums() { yield 1; yield 2; yield 3; yield 4 }
assert_eq(nums().filter(|x| x % 2 == 0).collect(), [2, 4])
assert_eq(nums().map(|x| x * 10).take(2).collect(), [10, 20])

# Lazy short-circuit must cross the user-iterator boundary: take(2) over an
# infinite source drives the user next() only twice (it must not exhaust it).
mut calls = 0
class Naturals {
  new() {}
  iter() {
    { has_next: fn() { true }, next: fn() { calls = calls + 1; calls } }
  }
}
assert_eq(Naturals.new().iter().map(|x| x * 2).take(2).collect(), [2, 4])
assert_true(calls <= 3)

# A terminal iterator method (collect/count/sum) reached by name on a
# non-iterator — e.g. a builtin namespace as `GC.collect()` — must raise a
# clean TypeError, not crash (regression: it segfaulted the JIT when it
# drove a null has_next/next closure).
mut threw = false
try { GC.collect() } catch e { threw = true }
assert_true(threw)

# --- Iterator protocol contract (language.md §18.5) ---
# `iter` / `has_next` / `next` are well-known properties: binding one to
# anything but a 0-arg Function is rejected where it is bound. That is what
# keeps every protocol call site safe — a `has_next` holding a Long used to
# be cast to a closure and called (JIT/AOT segfault), and a 1-arg `has_next`
# was invoked with nothing bound, which looped forever on the interpreter.
assert_throws("DropContractError", fn () { let o = { has_next: 1 }; o })
assert_throws("DropContractError", fn () { let o = { has_next: fn (a) { a } }; o })
assert_throws("DropContractError", fn () { let o = { next: 1 }; o })
assert_throws("DropContractError", fn () { let o = { iter: 1 }; o })
# Only the protocol names are reserved; a lookalike field is still data.
assert_eq({ has_next_at: 1 }.has_next_at, 1)

# Opening an iterator validates the protocol, so every backend reports the
# same error: `iter()` must return an Object carrying the pair.
mut perr = nil
try {
  let bad = { iter: fn () { 42 } }
  for x in bad { }
} catch e { perr = e }
assert_eq(perr.kind, "TypeError")
assert_eq(perr.message, "type error: iter() did not return an Object")

perr = nil
try {
  let bad = { iter: fn () { let it = { a: 1 }; it } }
  for x in bad { }
} catch e { perr = e }
assert_eq(perr.kind, "TypeError")
assert_eq(perr.message, "type error: iterator missing has_next()/next()")

# The same error surfaces from a lazy chain — at the terminal that drives it,
# since building the chain pulls nothing.
perr = nil
let half = { next: fn () { 1 }, iter: fn () { self } }
let half_chain = half.map(|x| x)
try { half_chain.take(2).collect() } catch e { perr = e }
assert_eq(perr.kind, "TypeError")
assert_eq(perr.message, "type error: iterator missing has_next()/next()")

# Terminal join on a lazy iterator — no intermediate .collect() needed.
# Mirrors Array.join (str_display of each element, joined by sep).
assert_eq(nums().map(|x| x * 10).join(","), "10,20,30,40")
assert_eq(nums().filter(|x| x % 2 == 0).join("-"), "2-4")
assert_eq(range(0, 0).map(|x| x).join(","), "")          # empty iterator
assert_eq(range(1, 4).join(""), "123")                   # range is lazy
# Array.join still works (eager receiver, same dispatch site)
assert_eq([1, 2, 3].map(|x| x + 1).join(" "), "2 3 4")

# --- skip_while: the complement of take_while ------------------------------
# Drops the leading run, then forwards everything (predicate not consulted
# again, so a later element that matches is still emitted).
assert_eq([1, 2, 3, 8, 2, 1].iter().skip_while(|x| x < 5).collect(), [8, 2, 1])
assert_eq(range(10).skip_while(|x| x < 7).collect(), [7, 8, 9])
assert_eq([1, 2, 3].iter().skip_while(|x| x < 99).collect(), [])   # all skipped
assert_eq([9, 1, 2].iter().skip_while(|x| x < 5).collect(), [9, 1, 2])  # none
assert_eq([].iter().skip_while(|x| true).collect(), [])
# take_while / skip_while split the same stream in two
mut src = [1, 2, 3, 8, 2]
mut head = src.iter().take_while(|x| x < 5).collect()
mut tail = src.iter().skip_while(|x| x < 5).collect()
assert_eq([...head, ...tail], src)

# --- contains: short-circuiting membership on a lazy receiver ---------------
assert_true([1, 2, 3].iter().contains(2))
assert_true(![1, 2, 3].iter().contains(9))
assert_true([1, 2, 3].iter().map(|x| x * 2).contains(6))
assert_true(![].iter().contains(1))
assert_true([[1, 2], [3]].iter().contains([1, 2]))    # structural equality
assert_true(['a', 'b'].iter().contains('b'))
# the eager receivers still route to their own arms
assert_true([1, 2, 3].contains(2))
assert_true('hello'.contains('ell'))
assert_true({1, 2}.contains(2))

# --- first / last / nth: nil when the iterator runs out --------------------
assert_eq([5, 6, 7].iter().first(), 5)
assert_eq([5, 6, 7].iter().last(), 7)
assert_eq([].iter().first(), nil)
assert_eq([].iter().last(), nil)
assert_eq([10, 20, 30, 40].iter().nth(0), 10)
assert_eq([10, 20, 30, 40].iter().nth(2), 30)
assert_eq([10, 20].iter().nth(5), nil)
try {
  [1].iter().nth(-1)
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}

# --- position: index of the first match, nil when none ---------------------
assert_eq([1, 5, 12, 3].iter().position(|v| v > 10), 2)
assert_eq([1, 2, 3].iter().position(|v| v == 1), 0)
assert_eq([1, 2].iter().position(|v| v > 10), nil)
assert_eq([].iter().position(|v| true), nil)

# --- laziness: none of these may drain an unbounded source -----------------
fn naturals() {
  mut n = 0
  { has_next: fn () { true }, next: fn () { n = n + 1; n - 1 } }
}
assert_eq(naturals().skip_while(|x| x < 3).first(), 3)
assert_eq(naturals().position(|x| x == 4), 4)
assert_true(naturals().contains(2))
assert_eq(naturals().nth(6), 6)
# only as many pulls as the answer needs
mut pulls = 0
assert_eq(range(1000000).map(fn (x) { pulls = pulls + 1; x }).nth(3), 3)
assert_eq(pulls, 4)

# --- numeric aggregates accept Float -------------------------------------
# Long in, Long out: an all-Long input must not drift to Float.
assert_eq([1, 2, 3].sum(), 6)
assert_eq([1, 2, 3].product(), 6)
assert_eq([1, 2, 3].iter().sum(), 6)
assert_eq([1, 2, 3].iter().product(), 6)
# One Float promotes the whole fold.
assert_eq([1, 2.5].sum(), 3.5)
assert_eq([2, 2.5].product(), 5.0)
assert_eq([1, 2.5].iter().sum(), 3.5)
assert_eq(range(5).map(|x| x * 1.5).sum(), 15.0)
# min/max return the winning ELEMENT, so its own type survives.
assert_eq([1, 2.5].min(), 1)
assert_eq([1, 2.5].max(), 2.5)
assert_eq([2.5, 3].max(), 3)
assert_eq([1.5, 2.5].iter().min(), 1.5)
# Ties keep the earlier element (2.0 and 2 compare equal).
assert_eq([2.0, 2].min(), 2.0)
assert_eq([2, 2.0].min(), 2)
# Empty folds keep their Long identity; empty min/max still throw.
assert_eq([].sum(), 0)
assert_eq([].product(), 1)
assert_eq([].iter().sum(), 0)
try { [].min(); assert_true(false) } catch e { assert_eq(e.kind, "ValueError") }
try { [].iter().max(); assert_true(false) } catch e { assert_eq(e.kind, "ValueError") }
# A non-numeric element names both accepted types.
try {
  [1, 'x'].iter().sum()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
  assert_true(e.message.contains("Long or Float"))
}

# --- min_by / max_by -----------------------------------------------------
# The key orders, the element comes back. Both receiver kinds.
mut people = [{name: 'a', age: 30}, {name: 'b', age: 20}, {name: 'c', age: 25}]
assert_eq(people.min_by(|p| p.age).name, 'b')
assert_eq(people.max_by(|p| p.age).name, 'a')
assert_eq(people.iter().min_by(|p| p.age).name, 'b')
assert_eq(people.iter().max_by(|p| p.age).name, 'a')
assert_eq(['aa', 'b', 'ccc'].max_by(|s| s.size()), 'ccc')
assert_eq(['aa', 'b', 'ccc'].iter().min_by(|s| s.size()), 'b')
# Float keys are fine, and an inverted key inverts the winner.
assert_eq([1, 2, 3].min_by(|x| 0 - x * 1.5), 3)
assert_eq([1, 2, 3].max_by(|x| -x), 1)
# Ties keep the earlier element.
assert_eq([{k: 1, t: 'first'}, {k: 1, t: 'second'}].min_by(|o| o.k).t, 'first')
assert_eq([{k: 1, t: 'first'}, {k: 1, t: 'second'}].max_by(|o| o.k).t, 'first')
# The key is computed exactly once per element.
mut keycalls = 0
assert_eq([5, 3, 9, 1].min_by(fn (x) { keycalls = keycalls + 1; x }), 1)
assert_eq(keycalls, 4)
# Empty throws, like min/max.
try { [].min_by(|x| x); assert_true(false) } catch e { assert_eq(e.kind, "ValueError") }
try { [].iter().max_by(|x| x); assert_true(false) } catch e { assert_eq(e.kind, "ValueError") }
# A non-numeric key reports like the unkeyed forms.
try { [1, 2].min_by(|x| 'k'); assert_true(false) } catch e { assert_eq(e.kind, "TypeError") }

# --- to_set / group_by / partition ---------------------------------------
# to_set is the only way to build a Set from a collection (set literals are
# the only other spelling), so it serves Array receivers as well.
assert_eq([1, 2, 2, 3, 1].to_set(), {1, 2, 3})
assert_eq([1, 2, 2, 3, 1].iter().to_set(), {1, 2, 3})
assert_eq([].to_set().size(), 0)
assert_eq([].iter().to_set().size(), 0)
assert_eq(range(5).map(|x| x % 2).to_set(), {0, 1})
assert_eq([(1, 2), (1, 2), (3, 4)].to_set(), {(1, 2), (3, 4)})
# First-seen order is kept. Member identity follows Object-key identity,
# which distinguishes types rather than numeric value, so these stay three.
assert_eq(['b', 'a', 'b'].to_set().to_array(), ['b', 'a'])
assert_eq([1, 1.0, true].to_set().size(), 3)
assert_eq([1, 1.0, true].to_set(), {1, 1.0, true})
# An unhashable element reports like any other unhashable key.
try { [[1]].to_set(); assert_true(false) } catch e { assert_eq(e.kind, "TypeError") }
try { [[1]].iter().to_set(); assert_true(false) } catch e { assert_eq(e.kind, "TypeError") }

# group_by buckets into Arrays under f(x), in first-seen key order.
mut staff = [{n: 'a', d: 'eng'}, {n: 'b', d: 'ops'}, {n: 'c', d: 'eng'}]
assert_eq(staff.group_by(|p| p.d).eng.size(), 2)
assert_eq(staff.iter().group_by(|p| p.d).ops.size(), 1)
assert_eq([1, 2, 3, 4, 5].group_by(|x| x % 2)[1], [1, 3, 5])
assert_eq([1, 2, 3, 4, 5].iter().group_by(|x| x % 2)[0], [2, 4])
assert_eq(['aa', 'b', 'cc'].group_by(|s| s.size())[2], ['aa', 'cc'])
assert_eq([].group_by(|x| x).keys().size(), 0)
try { [1].group_by(|x| [x]); assert_true(false) } catch e { assert_eq(e.kind, "TypeError") }

# partition splits in one pass and returns a Tuple, so it destructures.
assert_eq([1, 2, 3, 4, 5].partition(|x| x % 2 == 0), ([2, 4], [1, 3, 5]))
assert_eq([1, 2, 3, 4, 5].iter().partition(|x| x % 2 == 0), ([2, 4], [1, 3, 5]))
mut evens = nil
mut odds = nil
(evens, odds) = [1, 2, 3, 4].partition(|x| x % 2 == 0)
assert_eq(evens, [2, 4])
assert_eq(odds, [1, 3])
# Order is preserved in both halves, and an all-or-nothing predicate is fine.
assert_eq([1, 2, 3].partition(|x| true), ([1, 2, 3], []))
assert_eq([1, 2, 3].partition(|x| false), ([], [1, 2, 3]))
assert_eq([].iter().partition(|x| true), ([], []))

# --- flatten: one level of nesting removed ---------------------------------
assert_eq([[1, 2], [3], [], [4, 5]].iter().flatten().collect(), [1, 2, 3, 4, 5])
assert_eq([[[1]], [[2]]].iter().flatten().collect(), [[1], [2]])   # one level only
assert_eq([].iter().flatten().collect(), [])
# Any iterable inner works, including String and Set (same coercion flat_map uses)
assert_eq(['ab', 'cd'].iter().flatten().collect(), ['a', 'b', 'c', 'd'])
mut s1 = {1, 2}
assert_eq([s1, s1].iter().flatten().collect(), [1, 2, 1, 2])
assert_eq(['ab'].iter().flat_map(|s| s).collect(), ['a', 'b'])
try { [1, 2].iter().flatten().collect(); assert_true(false) }
catch e { assert_eq(e.kind, "TypeError") }

# --- scan: running fold, one output per input ------------------------------
assert_eq([1, 2, 3, 4].iter().scan(0, |a, x| a + x).collect(), [1, 3, 6, 10])
assert_eq([1, 2, 3].iter().scan(1, |a, x| a * x).collect(), [1, 2, 6])
assert_eq(['a', 'b'].iter().scan('', |a, x| a + x).collect(), ['a', 'ab'])
assert_eq([].iter().scan(0, |a, x| a + x).collect(), [])   # init is not yielded
try { [1].iter().scan(0, |x| x).collect(); assert_true(false) }
catch e { assert_eq(e.message, "type error: scan expects a 2-parameter function") }

# --- distinct: first occurrence wins ---------------------------------------
assert_eq([1, 2, 2, 3, 1, 2].iter().distinct().collect(), [1, 2, 3])
assert_eq(['b', 'a', 'b'].iter().distinct().collect(), ['b', 'a'])
assert_eq([].iter().distinct().collect(), [])
# Same key identity as to_set / Object keys: these three stay distinct.
assert_eq([1, 1.0, true].iter().distinct().collect().size(), 3)
try { [[1], [1]].iter().distinct().collect(); assert_true(false) }
catch e { assert_eq(e.kind, "TypeError") }

# --- tap: side effect, element passes through unchanged ---------------------
mut tapped = []
assert_eq([1, 2, 3].iter().tap(fn (x) { tapped.push(x) }).map(|x| x * 10).collect(),
          [10, 20, 30])
assert_eq(tapped, [1, 2, 3])
# Lazy: only the pulled elements run the callback.
mut probed = []
assert_eq(range(100).tap(fn (x) { probed.push(x) }).take(3).collect(), [0, 1, 2])
assert_eq(probed, [0, 1, 2])

# --- step_by: first element, then every n-th --------------------------------
assert_eq(range(10).step_by(3).collect(), [0, 3, 6, 9])
assert_eq([10, 20, 30, 40, 50].iter().step_by(2).collect(), [10, 30, 50])
assert_eq([1, 2, 3].iter().step_by(1).collect(), [1, 2, 3])
assert_eq([1, 2].iter().step_by(9).collect(), [1])       # first still yielded
assert_eq([].iter().step_by(2).collect(), [])
try { [1].iter().step_by(0).collect(); assert_true(false) }
catch e { assert_eq(e.kind, "ValueError") }

# --- chunk_by: ADJACENT elements only --------------------------------------
# A key that reappears after a different one starts a NEW run -- this is what
# separates it from group_by, which buckets by key regardless of position.
assert_eq([1, 1, 2, 2, 2, 1].iter().chunk_by(|x| x).collect(),
          [[1, 1], [2, 2, 2], [1]])
assert_eq([1, 1, 2, 2, 2, 1].group_by(|x| x)[1], [1, 1, 1])   # contrast
assert_eq([1, 2, 3].iter().chunk_by(|x| x).collect(), [[1], [2], [3]])
assert_eq([1, 1, 1].iter().chunk_by(|x| x).collect(), [[1, 1, 1]])
assert_eq([].iter().chunk_by(|x| x).collect(), [])
assert_eq(['aa', 'ab', 'bc'].iter().chunk_by(|s| s[0..1]).collect(),
          [['aa', 'ab'], ['bc']])

# --- all six stream an unbounded source ------------------------------------
fn naturals2() {
  mut n = 0
  { has_next: fn () { true }, next: fn () { n = n + 1; n - 1 } }
}
assert_eq(naturals2().scan(0, |a, x| a + x).take(5).collect(), [0, 1, 3, 6, 10])
assert_eq(naturals2().step_by(4).take(3).collect(), [0, 4, 8])
assert_eq(naturals2().map(|x| x % 3).distinct().take(3).collect(), [0, 1, 2])
assert_eq(naturals2().chunk_by(|x| x / 3).take(2).collect(), [[0, 1, 2], [3, 4, 5]])
assert_eq(naturals2().map(|x| [x]).flatten().take(3).collect(), [0, 1, 2])
