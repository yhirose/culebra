# A declared field's type is a contract the write checks (docs/language.md
# §10); this file is what a reader may then assume. The write side is in
# test_typed_fields.cul.
#
# Run: ./build/culebra tests/test_typed_fields_read.cul
#      ./build/culebra --jit tests/test_typed_fields_read.cul

// The write side's fixtures this side also reads: a class-typed field that
// cannot be removed, and a class that is not the one a field declares.
class Car {
  speed: Float
  new(@speed) {}
}

class Bike {
  speed: Long
  new(@speed) {}
}

class Garage {
  car: Car
  new() {}
}

let garage = Garage()

# --- the read side: what a declared type lets a reader assume ---
#
# A parameter's class annotation is checked on entry, so inside the function
# the field's declared type is settled and the read needs no tag question.
# What the checks below pin is that nothing reaches the read that did not go
# through the write check. The entry check used to be satisfiable by any
# object carrying the class's name, which is why the read verified the tag a
# second time; now the name comes from the class's meta and nothing else can
# claim it, so the forgery is refused where it is passed, on both lanes.

class Read {
  f: Float
  n: Long
  b: Bool
  s: String
  new(f) {
    self.f = f
  }
}

fn read_f(r: Read) {
  r.f
}

fn read_n(r: Read) {
  r.n
}

fn read_b(r: Read) {
  r.b
}

fn read_s(r: Read) {
  r.s
}

let r = Read(1.5)
assert_eq(read_f(r), 1.5)
assert_eq(read_n(r), 0)
assert_eq(read_b(r), false)
assert_eq(read_s(r), '')

# arithmetic over a declared field is the same arithmetic
fn scaled(r: Read) {
  r.f * 2.0 + r.f
}

assert_eq(scaled(r), 4.5)

# an object wearing the class's name is not an instance of it, so it never
# binds the parameter: the call finds no overload it fits
let forged = {class: 'Read', f: 'not a float'}
assert_throws('DispatchError', fn () {
  read_f(forged)
})

# a spread copy of a real instance is the same shape of forgery — a plain
# Object, whatever fields it copied
let copy = {...r, f: 'not a float'}
assert_throws('DispatchError', fn () {
  read_f(copy)
})

# a checked field cannot be removed: a field that can vanish is no contract.
# One declared `String`, or nothing at all, carries no promise, so it can go.
assert_throws('ImmutableError', fn () {
  r.remove('f')
})
assert_eq(read_f(r), 1.5)
assert_throws('ImmutableError', fn () {
  garage.remove('car')
})

# a `mut` binding's annotation is checked once and not again (§14), so it
# promises nothing about what its reads will find — the same answer whether
# the name is a local or a parameter
class Other {
  f: String
  new(f) {
    self.f = f
  }
}

fn rebound_param(mut r: Read) {
  r = Other('a string')
  r.f
}

fn rebound_local() {
  mut r: Read = Read(1.5)
  r = Other('a string')
  r.f
}

assert_eq(rebound_param(r), 'a string')
assert_eq(rebound_local(), 'a string')

# an optional or union annotation names no single class, so nothing is
# assumed and the read behaves as it always has
fn read_opt(r: Read?) {
  r?.f
}

assert_eq(read_opt(r), 1.5)
assert_eq(read_opt(nil), nil)

# `Read?` is no looser about what a Read is: nil or an instance, nothing
# that merely names one
let forged2 = {class: 'Read', f: 'still a string'}
assert_throws('DispatchError', fn () {
  read_opt(forged2)
})


# --- a member's own `self.x` carries the same promise ---
#
# The receiver is not proven to be an instance of the class (a method value
# can be moved onto a foreign object), so the read verifies the tag the
# declaration promised, exactly as it does through a parameter.

class Own {
  f: Float
  new(f) {
    self.f = f
  }
  doubled() {
    self.f * 2.0
  }
  sum(n) {
    mut acc = 0.0
    for _ in 0..n {
      acc += self.f
    }
    acc
  }
}

let own = Own(1.5)
assert_eq(own.doubled(), 3.0)
assert_eq(own.sum(4), 6.0)

# a method value read off an instance stays bound to it, so moving one onto
# another object does not give the body a foreign `self`
let borrowed = {class: 'Own', f: 'not a float', doubled: own.doubled}
assert_eq(borrowed.doubled(), 3.0)


# --- a class-typed field carries the class to the next step ---
#
# `self.engine.rpm` and `let e = self.engine; e.rpm` are the same question
# asked twice: the first step's declared type names a class, and that class
# says what `rpm` is.

class Engine {
  rpm: Float
  gear: Long
  new() {
  }
}

class Vehicle {
  engine: Engine
  speed: Float
  new() {
    self.engine = Engine()
  }
  chained() {
    self.engine.rpm + self.speed
  }
  through_local() {
    let e = self.engine
    e.rpm + e.gear
  }
}

let v = Vehicle()
assert_eq(v.chained(), 0.0)
assert_eq(v.through_local(), 0.0)

v.engine.rpm = 12.5
v.speed = 2.5
assert_eq(v.chained(), 15.0)

# the same contract at the far end of the chain
assert_throws('TypeError', fn () {
  v.engine.rpm = 'no'
})

# and the near end is checked too, so what the second step reads is what
# the first step's class says: a vehicle given something else is refused
# where it is given, not where a reader would have trusted it
let swapped = try {
  v.engine = Bike(3)
} catch e {
  e.message
}
assert_eq(swapped, "type error: field 'engine' expects Engine")
assert_eq(v.through_local(), 12.5)


# --- a local's own annotation carries the same promise ---
#
# `let a: Vec = <anything>` is checked at the declaration (§14), so the name
# means an instance of that class from here on. This is the one route that
# reaches an array element, which carries no type of its own.

class Pt {
  x: Float
  y: Float
  new(x, y) {
    self.x = x
    self.y = y
  }
}

let pts = [Pt(1.0, 2.0), Pt(3.0, 4.0)]

fn sum_first(list) {
  let a: Pt = list[0]
  a.x + a.y
}

assert_eq(sum_first(pts), 3.0)

# the declaration's own check refuses anything else, so the reads below it
# never meet a value the annotation did not promise
assert_throws('TypeError', fn () {
  let bad: Pt = 42
  bad.x
})

# an object wearing the class's name is not an instance of it, so the
# declaration's own check refuses it
assert_throws('TypeError', fn () {
  let forged: Pt = {class: 'Pt', x: 'no', y: 0.0}
  forged.x
})

# --- a compound step reads the field the way a plain read does ---

class Counter {
  n: Long
  f: Float
  new() {
  }
  tick(k) {
    for _ in 0..k {
      self.n += 1
      self.f += 0.5
    }
  }
}

let ctr = Counter()
ctr.tick(4)
assert_eq(ctr.n, 4)
assert_eq(ctr.f, 2.0)

fn nudge(p: Pt) {
  p.x += 1.0
  p.x
}

assert_eq(nudge(Pt(1.0, 2.0)), 2.0)

# the forgery the plain read refuses, refused at the compound read too
let r_forged_step = try {
  let forged: Pt = {class: 'Pt', x: 'no', y: 0.0}
  forged.x += 1.0
  nil
} catch e {
  e
}
let r_forged_read = try {
  let forged: Pt = {class: 'Pt', x: 'no', y: 0.0}
  forged.x
} catch e {
  e
}
assert_eq(r_forged_step.kind, 'TypeError')
assert_eq(r_forged_step.message, r_forged_read.message)

