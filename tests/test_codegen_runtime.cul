# CodeGen.Module builder, by hand, without a front end (see test_codegen.cul):
# the Runtime a compiled program runs in (live_objects, max_call_depth,
# entry_frame_drops, handles), the vocabulary the second wave added, and
# labeled break.


import cg from './test_import_helpers/codegen_builders.cul'
let {stmt_block, print_stmt, add_main, call_intr} = cg

# --- Runtime: live_objects()/heap_bytes() see a reference cycle a plain
# run() leaves behind, and collect() (only) frees it. Run outside any
# make_try, so the JSON-args()-count style check below distinguishes the
# runtime's OWN collect() from the in-program 'collect' intrinsic. ---
{
  let m = CodeGen.Module.new()
  let obj = m.object_lit(kv: m.list_new(), line: 1, col: 1)
  let key = m.str_literal(s: 'self', line: 1, col: 1)
  let loc = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  let assign = m.assign(kind: 'local', index: 0, value: obj, line: 1, col: 1)
  let cycle = m.set_index(recv: loc, key: key, value: loc, line: 1, col: 1)
  let body = stmt_block(m, [assign, cycle])
  add_main(m, body, 1)
  m.verify()

  let p = m.compile()
  let rt = CodeGen.Runtime.new()
  p.run(rt: rt)
  assert_true(rt.live_objects() > 0)
  assert_true(rt.heap_bytes() > 0)
  assert_true(rt.collect() > 0)
  assert_eq(rt.live_objects(), 0)

  # Running outside a program's own execution never fires a drop hook:
  # collect() called with nothing left to free just answers 0, quietly.
  assert_eq(rt.collect(), 0)
}

# --- A Runtime that still holds objects from another compiled program
# refuses to run a second one -- ClosureObj::func is an index into ITS
# OWN Program's chunk table, so reusing the heap across two different
# programs without collecting first would read the wrong program's
# chunks the moment a leftover closure is ever invoked. Collecting first
# makes reuse safe again. ---
{
  fn make_cycle_module() {
    let m = CodeGen.Module.new()
    let obj = m.object_lit(kv: m.list_new(), line: 1, col: 1)
    let key = m.str_literal(s: 'self', line: 1, col: 1)
    let loc = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
    let assign = m.assign(kind: 'local', index: 0, value: obj, line: 1, col: 1)
    let cycle = m.set_index(recv: loc, key: key, value: loc, line: 1, col: 1)
    let body = stmt_block(m, [assign, cycle])
    add_main(m, body, 1)
    m.verify()
    m
  }
  let pa = make_cycle_module().compile()
  let pb = make_cycle_module().compile()
  let rt = CodeGen.Runtime.new()

  pa.run(rt: rt)
  assert_true(rt.live_objects() > 0)

  let guard = try {
    pb.run(rt: rt)
  } catch e {
    e
  }
  assert_eq(
    "{guard.kind}: {guard.message}",
    'IrError: runtime still holds objects from another program',
  )

  rt.collect()
  pb.run(rt: rt)                      # safe now that the heap is empty
  assert_true(rt.live_objects() > 0)  # pb ran, and left its own cycle behind
}

# --- max_call_depth is a real, per-run override: the same program that
# runs fine by default fails at a small explicit depth. Confirms the
# optional argument actually reaches RunOptions, not just parses. ---
{
  fn make_self_call_module() {
    let m = CodeGen.Module.new()
    let cmap = m.add_capture_map(m.capture_map_new())
    let call = m.call(func: 0, cmap: cmap, line: 1, col: 1)
    add_main(m, call)
    m.verify()
    m
  }
  let p = make_self_call_module().compile()
  let deep = try {
    p.run(rt: nil, max_call_depth: 5)
  } catch e {
    e
  }
  assert_eq("{deep.kind}: {deep.message}", 'IrError: recursion limit exceeded')
}

# --- entry_frame_drops is inherited from the Module at compile() time,
# not a run() argument: flipping it before compile() changes what the
# compiled Program does, same as it changes what m.run() does. ---
{
  fn make_drop_module(m) {
    let obj = m.object_lit(kv: m.list_new(), line: 1, col: 1)
    let dropfn_body = print_stmt(
      m,
      m.str_literal(s: 'dropped', line: 1, col: 1),
    )
    let cmap = m.add_capture_map(m.capture_map_new())
    let dropfn = m.make_closure(func: 1, cmap: cmap, line: 1, col: 1)
    # dropset answers the object, so one expression builds and arms it.
    let armed = call_intr(m, 'dropset', [obj, dropfn])
    let body = m.assign(kind: 'local', index: 0, value: armed, line: 1, col: 1)
    add_main(m, body, 1)
    m.add_func(
      name: 'ondrop',
      num_locals: 1,
      num_captures: 0,
      num_cells: 0,
      num_params: 1,
      body: dropfn_body,
    )
    m.verify()
  }

  let m_on = CodeGen.Module.new()
  make_drop_module(m_on)
  assert_eq(IO.capture(fn () {
    m_on.compile().run(rt: nil)
  }), "dropped\n")

  let m_off = CodeGen.Module.new()
  make_drop_module(m_off)
  m_off.set_entry_frame_drops(on: false)
  assert_eq(IO.capture(fn () {
    m_off.compile().run(rt: nil)
  }), "")
}

# --- Program/Runtime are wrap.h handles like any other: drop() is
# idempotent, and use-after-drop is ClosedError, not a crash. ---
{
  let m = CodeGen.Module.new()
  add_main(m, m.nil_literal(line: 1, col: 1))
  m.verify()
  let p = m.compile()
  let rt = CodeGen.Runtime.new()
  p.drop()
  assert_throws('ClosedError', || p.run(rt: rt))

  rt.drop()
  assert_throws('ClosedError', || rt.live_objects())
}

# --- The vocabulary the second wave added reaches scripts through the same
# generic intrinsic() the older ones do -- no new builder method, because
# none of these is a node shape of its own. Each family is actually RUN
# here, not just named: a typo in any of these names is an unknown-intrinsic
# error, so a green run is the proof the name resolves. ---

# Map: a keyed container whose keys are whole values, read and written with
# the same index/set_index an object takes.
{
  let m = CodeGen.Module.new()
  let map = call_intr(m, 'mapnew', [])
  let body = stmt_block(
    m,
    [
      m.assign(kind: 'local', index: 0, value: map, line: 1, col: 1),
      m.set_index(
        recv: m.var_ref(kind: 'local', index: 0, line: 1, col: 1),
        key: m.literal(v: 7, line: 1, col: 1),
        value: m.str_literal(s: 'seven', line: 1, col: 1),
        line: 1,
        col: 1,
      ),
      print_stmt(
        m,
        m.index(
          recv: m.var_ref(kind: 'local', index: 0, line: 1, col: 1),
          key: m.literal(v: 7, line: 1, col: 1),
          line: 1,
          col: 1,
        ),
      ),
      print_stmt(
        m,
        call_intr(
          m,
          'len',
          [m.var_ref(kind: 'local', index: 0, line: 1, col: 1)],
        ),
      ),
    ],
  )
  add_main(m, body, 1)
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "seven\n1\n")
}

# Slices and bytes.
{
  let m = CodeGen.Module.new()
  let hello = m.str_literal(s: 'hello', line: 1, col: 1)
  let body = stmt_block(
    m,
    [
      print_stmt(
        m,
        call_intr(
          m,
          'strslice',
          [
            hello,
            m.literal(v: 1, line: 1, col: 1),
            m.literal(v: 4, line: 1, col: 1),
          ],
        ),
      ),
      print_stmt(
        m,
        call_intr(m, 'strbyte', [hello, m.literal(v: 0, line: 1, col: 1)]),
      ),
      print_stmt(
        m,
        call_intr(m, 'strfrombyte', [m.literal(v: 65, line: 1, col: 1)]),
      ),
    ],
  )
  add_main(m, body)
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "ell\n104\nA\n")
}
{
  # arrayslice copies -- writing the slice leaves the source alone.
  let m = CodeGen.Module.new()
  let items = m.list_new()
  for v in [10, 20, 30] {
    m.list_push(items, m.literal(v: v, line: 1, col: 1))
  }
  let body = stmt_block(
    m,
    [
      m.assign(
        kind: 'local',
        index: 0,
        value: m.array_lit(items: items, line: 1, col: 1),
        line: 1,
        col: 1,
      ),
      m.assign(
        kind: 'local',
        index: 1,
        value: call_intr(m, 'arrayslice',
                              [m.var_ref(kind: 'local', index: 0, line: 1, col: 1),
                               m.literal(v: 0, line: 1, col: 1),
                               m.literal(v: 2, line: 1, col: 1)]),
        line: 1,
        col: 1,
      ),
      m.set_index(
        recv: m.var_ref(kind: 'local', index: 1, line: 1, col: 1),
        key: m.literal(v: 0, line: 1, col: 1),
        value: m.literal(v: 99, line: 1, col: 1),
        line: 1,
        col: 1,
      ),
      print_stmt(
        m,
        call_intr(
          m,
          'len',
          [m.var_ref(kind: 'local', index: 1, line: 1, col: 1)],
        ),
      ),
      print_stmt(
        m,
        m.index(
          recv: m.var_ref(kind: 'local', index: 0, line: 1, col: 1),
          key: m.literal(v: 0, line: 1, col: 1),
          line: 1,
          col: 1,
        ),
      ),
    ],
  )
  add_main(m, body, 2)
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "2\n10\n")
}

# Coroutines: an ordinary function driven by the six intrinsics. The yield
# sits one call deep, which is the whole difference from a generator -- it
# parks the call stack, not one frame.
{
  let m = CodeGen.Module.new()
  let empty = m.add_capture_map(m.capture_map_new())

  # inner() yields 1 then 2; outer() calls it, so the yields sit a frame
  # deeper than the coroutine.
  let inner_body = stmt_block(
    m,
    [
      call_intr(m, 'coroyield', [m.literal(v: 1, line: 1, col: 1)]),
      call_intr(m, 'coroyield', [m.literal(v: 2, line: 1, col: 1)]),
    ],
  )
  let outer_body = stmt_block(
    m,
    [
      m.call(func: 1, cmap: empty, line: 1, col: 1),
      m.str_literal(s: 'done', line: 1, col: 1),
    ],
  )

  let co = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  fn resumed(mm, co) {
    call_intr(mm, 'cororesume', [co, mm.nil_literal(line: 1, col: 1)])
  }
  let main_body = stmt_block(m, [
    m.assign(kind: 'local', index: 0,
             value: call_intr(m, 'corocreate',
                              [m.make_closure(func: 2, cmap: empty, line: 1, col: 1)]),
             line: 1, col: 1),
    print_stmt(m, call_intr(m, 'corostatus', [co])),
    print_stmt(m, m.index(recv: resumed(m, co),
                          key: m.str_literal(s: 'value', line: 1, col: 1),
                          line: 1, col: 1)),
    print_stmt(m, call_intr(m, 'corostatus', [co])),
    print_stmt(m, m.index(recv: resumed(m, co),
                          key: m.str_literal(s: 'value', line: 1, col: 1),
                          line: 1, col: 1)),
    print_stmt(m, m.index(recv: resumed(m, co),
                          key: m.str_literal(s: 'done', line: 1, col: 1),
                          line: 1, col: 1)),
    print_stmt(m, call_intr(m, 'corostatus', [co])),
    # corocurrent at the top is nil -- nothing is running us.
    print_stmt(m, call_intr(m, 'typeof', [call_intr(m, 'corocurrent', [])])),
  ])
  # funcs[0] is the entry point, so main goes in first: inner lands at 1 and
  # outer at 2, which is what the nodes above already name.
  add_main(m, main_body, 1)
  m.add_func(
    name: 'inner',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: inner_body,
  )
  # The first resume calls it as f(sent), so it takes the one parameter.
  m.add_func(
    name: 'outer',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 1,
    body: outer_body,
  )
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "start\n1\nsuspended\n2\ntrue\ndone\nnil\n")
}
{
  # enqueue takes a coroutine as readily as a closure -- which is what makes
  # the job queue a scheduler. The queue is drained after the entry function
  # returns, so 'queued' prints before the job's own output.
  let m = CodeGen.Module.new()
  let empty = m.add_capture_map(m.capture_map_new())
  let job_body = print_stmt(m, m.str_literal(s: 'ran', line: 1, col: 1))
  let co = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  add_main(m, stmt_block(m, [
             m.assign(kind: 'local', index: 0,
                      value: call_intr(m, 'corocreate',
                                       [m.make_closure(func: 1, cmap: empty,
                                                       line: 1, col: 1)]),
                      line: 1, col: 1),
             call_intr(m, 'enqueue', [co]),
             print_stmt(m, m.str_literal(s: 'queued', line: 1, col: 1)),
           ]), 1)
  m.add_func(
    name: 'job',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 1,
    body: job_body,
  )
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "queued\nran\n")
}
{
  # A scheduled coroutine that parks with nothing left to wake it is the
  # scheduler's own safety net, not a hang -- Go's "all goroutines are
  # asleep". The queue running dry while it is still suspended is the check.
  let m = CodeGen.Module.new()
  let empty = m.add_capture_map(m.capture_map_new())
  let job_body = call_intr(m, 'coroyield', [m.nil_literal(line: 1, col: 1)])
  add_main(m, stmt_block(m, [
             m.assign(kind: 'local', index: 0,
                      value: call_intr(m, 'corocreate',
                                       [m.make_closure(func: 1, cmap: empty,
                                                       line: 1, col: 1)]),
                      line: 1, col: 1),
             call_intr(m, 'enqueue',
                       [m.var_ref(kind: 'local', index: 0, line: 1, col: 1)]),
           ]), 1)
  m.add_func(
    name: 'job',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 1,
    body: job_body,
  )
  m.verify()
  let err = try {
    m.run()
  } catch e {
    e
  }
  assert_eq(err.kind, 'IrError')
  assert_true(err.message.contains('deadlock'))
}
{
  # coroclose ends a suspended coroutine early: the rest of its body never
  # runs, and its status settles at done.
  let m = CodeGen.Module.new()
  let empty = m.add_capture_map(m.capture_map_new())
  let body = stmt_block(
    m,
    [
      print_stmt(m, m.str_literal(s: 'ran', line: 1, col: 1)),
      call_intr(m, 'coroyield', [m.nil_literal(line: 1, col: 1)]),
      print_stmt(m, m.str_literal(s: 'unreachable', line: 1, col: 1)),
    ],
  )
  let co = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  add_main(m, stmt_block(m, [
             m.assign(kind: 'local', index: 0,
                      value: call_intr(m, 'corocreate',
                                       [m.make_closure(func: 1, cmap: empty,
                                                       line: 1, col: 1)]),
                      line: 1, col: 1),
             call_intr(m, 'cororesume', [co, m.nil_literal(line: 1, col: 1)]),
             call_intr(m, 'coroclose', [co]),
             print_stmt(m, call_intr(m, 'corostatus', [co])),
           ]), 1)
  m.add_func(
    name: 'job',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 1,
    body: body,
  )
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "ran\ndone\n")
}

# --- A break may name the loop it leaves. Two nested loops: depth 0 leaves
# the inner one, depth 1 leaves the outer one from inside the inner. ---
fn counting_loops(m, depth) {
  # i = 0; while i < 3 { i = i + 1; j = 0; while j < 3 { j = j + 1; break^depth }
  #                      print(i) }
  # print('after')
  let i = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  let j = m.var_ref(kind: 'local', index: 1, line: 1, col: 1)
  fn lt3(mm, v) {
    mm.binary(
      op: 'lt',
      lhs: v,
      rhs: mm.literal(v: 3, line: 1, col: 1),
      line: 1,
      col: 1,
    )
  }
  fn bump(mm, slot, v) {
    mm.assign(
      kind: 'local',
      index: slot,
      value: mm.binary(op: 'add', lhs: v, rhs: mm.literal(v: 1, line: 1, col: 1),
                               line: 1, col: 1),
      line: 1,
      col: 1,
    )
  }
  let inner = m.make_while(
    cond: lt3(m, j),
    body: stmt_block(m, [bump(m, 1, j), m.make_break(line: 1, col: 1, depth: depth)]),
    line: 1,
    col: 1,
  )
  let outer = m.make_while(
    cond: lt3(m, i),
    body: stmt_block(m, [bump(m, 0, i),
                         m.assign(kind: 'local', index: 1,
                                  value: m.literal(v: 0, line: 1, col: 1), line: 1, col: 1),
                         inner,
                         print_stmt(m, i)]),
    line: 1,
    col: 1,
  )
  add_main(m, stmt_block(m, [
             m.assign(kind: 'local', index: 0, value: m.literal(v: 0, line: 1, col: 1),
                      line: 1, col: 1),
             outer,
             print_stmt(m, m.str_literal(s: 'after', line: 1, col: 1)),
           ]), 2)
  m.verify()
  m
}
{
  # depth 0: only the inner loop ends, so the outer one runs all three times.
  assert_eq(IO.capture(fn () {
    counting_loops(CodeGen.Module.new(), 0).run()
  }), "1\n2\n3\nafter\n")
}
{
  # depth 1: the first pass through the inner loop leaves the OUTER one, so
  # the print after the inner loop never runs at all.
  assert_eq(IO.capture(fn () {
    counting_loops(CodeGen.Module.new(), 1).run()
  }), "after\n")
}
{
  # Read back, and refused when it names a loop that is not open.
  let m = CodeGen.Module.new()
  let brk = m.make_break(line: 1, col: 1, depth: 2)
  let cont = m.make_continue(line: 1, col: 1)
  assert_eq(m.break_depth(node: brk), 2)
  assert_eq(m.continue_depth(node: cont), 0)  # the default
  assert_throws('IrError', || m.break_depth(node: cont))

  add_main(m, m.make_while(cond: m.bool_literal(v: true, line: 1, col: 1),
                              body: brk, line: 1, col: 1))
  let err = try {
    m.verify()
  } catch e {
    e
  }
  assert_eq(
    "{err.kind}: {err.message}",
    'IrError: Break names a loop that is not open',
  )
}

println('test_codegen OK')
