# Function type annotations `fn(T) -> U`.
# MVP: params/return are documentation; a value matches if it is callable
# (a closure or a class instance with `__call__`).

# --- param annotated with a function type accepts a closure ---
fn apply(f: fn(Long) -> Long, x: Long) -> Long {
  f(x)
}
assert_eq(apply(|n| n * 2, 21), 42)

# --- multi-param function type ---
fn combine(f: fn(Long, Long) -> Long, a: Long, b: Long) -> Long {
  f(a, b)
}
assert_eq(combine(|a, b| a + b, 10, 32), 42)

# --- zero-arg function type ---
fn call_it(f: fn() -> String) -> String {
  f()
}
assert_eq(call_it(|| "hi"), "hi")

# --- a non-callable is rejected at the type check ---
fn needs_fn(f: fn(Long) -> Long) -> Long {
  f(1)
}
assert_throws('DispatchError', fn () {
  needs_fn(99)
})

# --- callable class instance (`__call__`) satisfies a function type ---
class Doubler {
  new() {}
  __call__(n) {
    n * 2
  }
}
assert_eq(apply(Doubler.new(), 21), 42)

# --- return-typed function value passes through ---
fn make_adder(n: Long) -> fn(Long) -> Long {
  |x| x + n
}
let add5 = make_adder(5)
assert_eq(add5(37), 42)

# --- optional return `fn(A) -> B?` still requires a function (not nil) ---
fn run_opt(f: fn(Long) -> Long?) -> Long {
  let r = f(0)
  r ?? -1
}
assert_eq(run_opt(|n| nil), -1)
assert_eq(run_opt(|n| n + 42), 42)
assert_throws('DispatchError', fn () {
  run_opt(nil)
})

# --- union with a function type: `fn(...) -> X | Long` ---
fn flex(v: fn(Long) -> Long | Long) -> Long {
  match v {
    x: Long => x,
    _ => v(0),
  }
}
assert_eq(flex(7), 7)
assert_eq(flex(|n| n + 100), 100)
