// Hex / octal / binary integer literals + bitwise operators
// (`|` `&` `^` `<<` `>>`) and `~`.

// --- Radix literals ---
assert_eq(0xFF, 255)
assert_eq(0x10, 16)
assert_eq(0xff, 255)  // lowercase hex
assert_eq(0o17, 15)
assert_eq(0o755, 493)
assert_eq(0b1010, 10)
assert_eq(0b0, 0)
assert_eq(255, 0xFF)  // decimal still parses
assert_eq(0.5, 0.5)   // float literal unaffected

// --- AND / XOR / OR ---
assert_eq(0b1100 & 0b1010, 0b1000)
assert_eq(12 & 10, 8)
assert_eq(0b1100 ^ 0b1010, 0b0110)
assert_eq(12 ^ 10, 6)
assert_eq(0b1010 | 0b0101, 0b1111)
assert_eq(5 | 2, 7)
assert_eq(1 | 4 | 16, 21)  // chained

// --- Shifts ---
assert_eq(1 << 4, 16)
assert_eq(256 >> 2, 64)
assert_eq(0b1 << 3, 8)

// --- Complement ---
assert_eq(~0, -1)
assert_eq(~5, -6)
assert_eq(5 & ~1, 4)  // clear the low bit

// --- Precedence: comparison < | < ^ < & < shift < additive ---
assert_eq(1 & 2 == 0, true)     // (1 & 2) == 0
assert_eq(2 & 3 ^ 1, 3)         // (2 & 3) ^ 1
assert_eq(1 << 2 + 1, 8)        // 1 << (2 + 1)
assert_eq(1 + 1 << 2, 8)        // (1 + 1) << 2
assert_eq(1 | 2 ^ 1, 3)         // 1 | (2 ^ 1)
assert_eq(6 & 3 | 8, 10)        // (6 & 3) | 8
assert_eq(1 | 2 == 3, true)     // (1 | 2) == 3
assert_eq(false || true, true)  // `||` is still logical-or, not bit-or

// --- Flag bits via | ---
let READ = 0b100
let WRITE = 0b010
let EXEC = 0b001
assert_eq(READ | WRITE | EXEC, 0b111)
assert_eq(0o644, 420)  // chmod-style octal

// --- bit-or coexists with the `|...|` lambda delimiter ---
let body_or = |x| x | 1  // bit-or in a lambda body
assert_eq(body_or(4), 5)
let with_default = |a, b, c = 8| a + b + c  // default doesn't eat the close `|`
assert_eq(with_default(1, 2), 11)
let paren_default = |x = (2 | 1)| x  // top-level `|` in a default needs parens
assert_eq(paren_default(), 3)

// --- Non-Long operand is a type error ---
let e = try {
  1.5 & 2
  nil
} catch er {
  er.kind
}
assert_eq(e, "TypeError")

// Message is the standard type-mismatch form, and a step's operands both
// evaluate (for their effects) before the Long check — the lhs is reported
// first when both sides are bad.
mut effects = []
fn traced(v) { effects = effects + [v]; v }
let em = try { 1.5 | traced(2) } catch er { er.message }
assert_eq(em, "type error: expected Long, got Float")
assert_eq(effects, [2])  // rhs ran before the check
let em2 = try { 1 & traced("x") } catch er { er.message }
assert_eq(em2, "type error: expected Long, got String")
let em3 = try { ~1.5 } catch er { er.message }
assert_eq(em3, "type error: expected Long, got Float")

// --- Compound assignment: `&=` `|=` `^=` `<<=` `>>=` ---
mut b = 0b1100
b &= 0b1010
assert_eq(b, 0b1000)
b |= 0b0101
assert_eq(b, 0b1101)
b ^= 0b0011
assert_eq(b, 0b1110)
b <<= 4
assert_eq(b, 0b11100000)
b >>= 2
assert_eq(b, 0b111000)
mut neg = -16
neg >>= 2  // arithmetic, like `>>`
assert_eq(neg, -4)
mut wide = 1
wide <<= 65  // count masked to the low 6 bits, like `<<`
assert_eq(wide, 2)

// Index, property and `self` targets.
mut regs = [1, 2, 3]
regs[1] |= 0x10
assert_eq(regs, [1, 18, 3])
mut st = {mut flags: 1}
st.flags <<= 3
assert_eq(st.flags, 8)
class Status {
  new() { self.bits = 0 }
  set(m) { self.bits |= m }
  clear(m) { self.bits &= ~m }
}
let status = Status()
status.set(0b101)
status.clear(0b001)
assert_eq(status.bits, 0b100)

// A captured variable, stepped from inside a closure.
mut mask = 1
let widen = fn () { mask <<= 1 }
widen()
widen()
assert_eq(mask, 4)

// RHS first, then the read — the same order as `+=`.
mut ord = 1
ord |= (fn () { ord = 4; 2 })()
assert_eq(ord, 6)

// `<=`, `>=` and a nested generic's `>>` still parse as before.
assert_eq(b <= 1, false)
assert_eq(b >= 1, true)
let nested: Array<Array<Long>> = [[1]]
assert_eq(nested, [[1]])

// Same errors as the spelled-out `x = x | y`.
let ce = try { mut s = "a"; s |= 1; nil } catch er { er.message }
assert_eq(ce, "type error: expected Long, got String")
let ce2 = try { mut f = 1; f <<= 1.5; nil } catch er { er.message }
assert_eq(ce2, "type error: expected Long, got Float")
let ce3 = try { let k = 1; k ^= 2; nil } catch er { er.kind }
assert_eq(ce3, "ImmutableError")

IO.inspect("test_bitwise OK")
