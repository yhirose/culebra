# The shapes a physics step is written in keep a flat `@value` run unboxed
# (docs/internals/vm.md §5.3.2, §5.3.3):
#
# - a `let` or a write built from another local of the same list that is
#   itself still being decided (`let w2 = w + g`, `acc = acc + w2 @ w`),
# - `/`, `%` and `@`, which splice their dunders as `+`, `-` and `*` do,
# - an operator whose left operand is itself one (`p * 0.5 + v * dt`),
#
# and a typed field's class is followed down a chain (`s.pos.x` reads as
# `let p = s.pos; p.x` does).
#
# Each case is checked against the same arithmetic on plain Floats, or
# against what the boxed path answers. tests/resolve_shape_test.sh holds the
# bytecode side.
#
# Run: ./build/culebra tests/test_value_steps.cul
#      ./build/culebra --jit tests/test_value_steps.cul

@value
class V2 {
  x: Float
  y: Float

  new(@x, @y) {}

  __add__(o) {
    V2(self.x + o.x, self.y + o.y)
  }

  __mul__(k) {
    V2(self.x * k, self.y * k)
  }

  __div__(k) {
    V2(self.x / k, self.y / k)
  }

  __mod__(k) {
    V2(self.x % k, self.y % k)
  }

  __matmul__(o) {
    V2(self.x * o.x, self.y * o.y)
  }
}

# --- a `let` from another local of the same list ---

fn chained(n) {
  let w = V2(1.0, 2.0)
  let w2 = w + V2(w.y, 0.5)
  mut acc = V2(0.0, 0.0)
  for _ in 0..n {
    acc = acc + w2 / 4.0 @ w % 3.0
  }
  (acc.x, acc.y)
}
fn chained_floats(n) {
  let (wx, wy) = (1.0, 2.0)
  let (vx, vy) = (wx + wy, wy + 0.5)
  mut (ax, ay) = (0.0, 0.0)
  for _ in 0..n {
    ax = ax + vx / 4.0 * wx % 3.0
    ay = ay + vy / 4.0 * wy % 3.0
  }
  (ax, ay)
}
assert_eq(chained(3), chained_floats(3))

# --- a write whose RHS starts at another local of the same list ---

fn written(n) {
  let w = V2(0.5, 0.25)
  mut v = V2(0.0, 0.0)
  for _ in 0..n {
    v = w + v * 0.5
  }
  (v.x, v.y)
}
assert_eq(written(3), (0.875, 0.4375))

# --- an operator whose left operand is itself an operator ---

fn damped(n) {
  mut p = V2(1.0, 2.0)
  let v = V2(0.5, 0.25)
  for _ in 0..n {
    p = p * 0.5 + v * 0.1
  }
  (p / 2.0 + v).x
}
fn damped_floats(n) {
  mut (px, py) = (1.0, 2.0)
  for _ in 0..n {
    px = px * 0.5 + 0.5 * 0.1
    py = py * 0.5 + 0.25 * 0.1
  }
  px / 2.0 + 0.5
}
assert_eq(damped(4), damped_floats(4))

# --- the second local falls with the first: still right, boxed ---

# `w` read bare by a comparison stays boxed, and `w2`, built from it, falls
# with it when its own declaration is asked again.
fn falls() {
  let w = V2(1.0, 2.0)
  let w2 = w + V2(1.0, 1.0)
  (w == nil ? 0.0 : w.x) + w2.y
}
assert_eq(falls(), 4.0)

# --- a typed field's class, followed down a chain ---

class S {
  pos: V2
  new() {}
}
fn read_chain(s: S) {
  s.pos.x + s.pos.y
}
fn read_let(s: S) {
  let p = s.pos
  p.x + p.y
}
let s = S()
let nil_chain = try {
  read_chain(s)
} catch e {
  e.message
}
let nil_let = try {
  read_let(s)
} catch e {
  e.message
}
assert_eq(nil_chain, nil_let)
s.pos = V2(1.5, 2.5)
assert_eq(read_chain(s), 4.0)
assert_eq(read_let(s), 4.0)

# --- a number on the left: `k * v` is `v`'s reflected dunder ---

# `__rmul__` answers rather than `__mul__` (they differ here, so the wrong
# one shows), `__rsub__` answers `k - v`, and with no reflected dunder `+`
# and `*` fall back to `v`'s own, as the boxed dispatch does. `k` is a
# literal, a `let` of one, arithmetic of those, or a parameter annotated as
# a number.
@value
class R {
  x: Float
  new(@x) {}
  __add__(o) { R(self.x + o.x) }
  __mul__(k) { R(self.x * k) }
  __rmul__(k) { R(self.x * k + 1.0) }
  __rsub__(k) { R(k - self.x) }
}
@value
class C {
  x: Float
  new(@x) {}
  __add__(o) { C(self.x + o.x) }
  __mul__(k) { C(self.x * k) }
}
fn reflected(n, h: Float) {
  let dt = 0.5
  let half = dt * 0.5
  mut p = R(0.0)
  let v = R(2.0)
  for _ in 0..n {
    p = p + dt * v + 2 * v + half * v + h * v + (1.0 - v)
  }
  p.x
}
assert_eq(reflected(2, 0.25),
          2.0 * ((2.0 * 0.5 + 1.0) + (2.0 * 2.0 + 1.0) + (2.0 * 0.25 + 1.0) +
                 (2.0 * 0.25 + 1.0) + (1.0 - 2.0)))
fn commuted(n) {
  let dt = 0.5
  mut p = C(1.0)
  let v = C(2.0)
  for _ in 0..n {
    p = p + dt * v + 2.0 * v * 3.0
  }
  p.x
}
assert_eq(commuted(2), 1.0 + 2.0 * (1.0 + 12.0))
# With no `__rsub__`, `k - v` is the built-in operation's TypeError,
# reached through the boxed dispatch.
fn unreflected() {
  let v = C(2.0)
  1.0 - v
}
assert_throws('TypeError', unreflected)
# A `mut` number is not one the compiler can count on: still right, boxed.
fn rebound(n) {
  mut k = 0.5
  mut p = R(0.0)
  let v = R(2.0)
  for _ in 0..n {
    p = p + k * v
    k = 1.0
  }
  p.x
}
assert_eq(rebound(2), (2.0 * 0.5 + 1.0) + (2.0 * 1.0 + 1.0))
# A parameter type error in the reflected dunder reports at the operator
# expression, spliced or not (the boxed one is four lines below).
@value
class T {
  x: Float
  new(@x) {}
  __rmul__(k: Float) { T(self.x * k) }
}
fn spliced_t() {
  let v = T(1.0)
  let w = 2 * v
  w.x
}
fn boxed_t(v) {
  let w = 2 * v
  w.x
}
let at = fn (f) {
  try {
    f()
    nil
  } catch e {
    (e.message, e.line, e.col)
  }
}
let (sm, sl, sc) = at(spliced_t)
let (bm, bl, bc) = at(|| boxed_t(T(1.0)))
assert_eq((sm, sl + 4, sc), (bm, bl, bc))

# --- a `let` in a loop body that consumes a run of the enclosing list ---

fn nested_let(n) {
  mut p = V2(1.0, 0.0)
  let v = V2(0.0, 1.0)
  for _ in 0..n {
    let d = v * 0.5
    p = p + d
  }
  (p.x, p.y)
}
assert_eq(nested_let(3), (1.0, 1.5))
# A nested name that also means another binding the walk reaches (`d`
# after the loop, `e` in two sibling bodies): still right.
fn nested_names(n) {
  mut p = V2(1.0, 0.0)
  let v = V2(0.0, 1.0)
  for _ in 0..n {
    let d = v * 0.5
    p = p + d
  }
  for _ in 0..n {
    let e = v * 0.25
    p = p + e
  }
  if n > 0 {
    let e = v * 2.0
    p = p + e
  }
  let d = 10.0
  (p.x + d, p.y)
}
assert_eq(nested_names(2), (11.0, 1.0 + 0.5 + 2.0))
