# Conformance: §17 (iterator protocol). See docs/language.md §25.
#
# Object iter fail-fast on structural mutation.
#
# Matches Python dict semantics: rewriting existing keys mid-iter is
# allowed (size unchanged), adding or removing keys raises
# RuntimeError. Covers both the explicit `.iter()` form and the
# `for k in obj` sugar; exercised on both backends.

# 1. Value updates on existing keys are allowed.
mut a = {mut x: 1, mut y: 2, mut z: 3}
for k in a.iter() {
  a[k] = 99
}
assert(a.x == 99)
assert(a.y == 99)
assert(a.z == 99)

# 2. Adding a key mid-iter raises.
mut b = {x: 1}
mut add_raised = false
try {
  for k in b.iter() {
    b["new_key"] = 2
  }
} catch e {
  add_raised = true
  assert(e.kind == "RuntimeError")
}
assert(add_raised)

# 3. Removing a key mid-iter raises.
mut c = {x: 1, y: 2}
mut del_raised = false
try {
  for k in c.iter() {
    c.remove("y")
  }
} catch e {
  del_raised = true
  assert(e.kind == "RuntimeError")
}
assert(del_raised)

# 4. The `for k in obj` sugar enforces the same protocol.
mut d = {a: 1, b: 2}
mut sugar_raised = false
try {
  for k in d {
    d["c"] = 3
  }
} catch e {
  sugar_raised = true
  assert(e.kind == "RuntimeError")
}
assert(sugar_raised)

# 5. Mutating a *different* Object mid-iter is fine.
let src = {a: 1, b: 2}
mut dst = {}
for k in src.iter() {
  dst[k] = src[k]
}
assert(dst.a == 1)
assert(dst.b == 2)
