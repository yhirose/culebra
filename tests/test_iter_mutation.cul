# Conformance: §17 (iterator protocol). See docs/language.md §25.
#
# Object iteration is snapshot-tolerant: the keys are snapshotted at loop
# start, so mutating the object in the loop body is safe — entries ADDED
# during the loop are not visited, entries REMOVED are skipped, and each
# value is read live. No structural-mutation guard (unlike Python's
# fail-fast). Object iteration yields (key, value) pairs; covers the
# explicit `.iter()` form and the `for k, v in obj` sugar, on both backends.

# 1. Values are read live at each step: updating a not-yet-visited key's
#    value during the loop is observed when that key's turn comes.
mut a = {mut x: 1, mut y: 2}
mut a_vals = []
for k, v in a.iter() {
  if k == "x" {
    a["y"] = 99
  }  # change y's value while visiting x
  a_vals.push(v)
}
assert_eq(a_vals, [1, 99])  # x = 1 (own value), then y read live = 99

# 2. Adding a key mid-iter does not raise; the new key is not visited.
mut b = {x: 1}
mut b_seen = []
for k, v in b.iter() {
  b["new_key"] = 2
  b_seen.push(k)
}
assert_eq(b_seen, ["x"])       # only the snapshot key
assert_true(b.has("new_key"))  # but the add did take effect

# 3. Removing a not-yet-visited key mid-iter skips it (no raise).
mut c = {x: 1, y: 2, z: 3}
mut c_seen = []
for k, v in c.iter() {
  c.remove("z") if k == "x"
  c_seen.push(k)
}
assert_eq(c_seen, ["x", "y"])  # z removed before its turn → skipped

# 4. The `for k, v in obj` sugar has the same tolerance (a fresh key per
#    step so each add creates a new slot).
mut d = {a: 1, b: 2}
mut d_seen = []
for k, v in d {
  d[k + "2"] = v
  d_seen.push(k)
}
assert_eq(d_seen, ["a", "b"])  # a2 / b2 added but not visited

# 5. The setdefault-style pattern: add derived entries while iterating.
mut books = {"創": ("創世記", "章"), "詩": ("詩編", "編")}
for reading, unit in books.values() {
  books[reading] = (reading, unit) if !books.has(reading)
}
assert_eq(books.size(), 4)
assert_true(books.has("創世記") && books.has("詩編"))

# 6. Mutating a *different* Object mid-iter is fine.
let src = {a: 1, b: 2}
mut dst = {}
for k, v in src.iter() {
  dst[k] = v
}
assert_eq(dst.a, 1)
assert_eq(dst.b, 2)
