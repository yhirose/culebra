// Hash namespace: SHA-256/SHA-1/SHA-512/MD5 + HMAC, all self-hosted in hash.h
// and shared between the interp and the JIT slow-path adapters. Each function
// returns the lowercase hex digest. Also exercises bare-resolve + as-value
// dispatch on the JIT/AOT slow path.

// --- SHA-256 (NIST/RFC vectors) ---
assert_eq(Hash.sha256(""),
          "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
assert_eq(Hash.sha256("abc"),
          "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

// --- SHA-1 ---
assert_eq(Hash.sha1(""), "da39a3ee5e6b4b0d3255bfef95601890afd80709")
assert_eq(Hash.sha1("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d")

// --- SHA-512 ---
assert_eq(Hash.sha512(""),
  "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce" +
  "47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
assert_eq(Hash.sha512("abc"),
  "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a" +
  "2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")

// --- MD5 ---
assert_eq(Hash.md5(""), "d41d8cd98f00b204e9800998ecf8427e")
assert_eq(Hash.md5("abc"), "900150983cd24fb0d6963f7d28e17f72")

// rep(s, n): repeat a string n times (no `*` string operator in culebra).
let rep = fn (s, n) {
  let parts = []
  for _ in 0..n { parts.push(s) }
  parts.join("")
}

// --- multi-block input (1000 bytes spans several compression blocks) ---
let a1000 = rep("a", 1000)
assert_eq(Hash.sha256(a1000),
          "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3")
assert_eq(Hash.sha1(a1000), "291e9a6c66994949b57ba5e650361e98fc36b1ba")
assert_eq(Hash.sha512(a1000),
  "67ba5535a46e3f86dbfbed8cbbaf0125c76ed549ff8b0b9e03e0c88cf90fa634" +
  "fa7b12b47d77b694de488ace8d9a65967dc96df599727d3292a8d9d447709c97")
assert_eq(Hash.md5(a1000), "cabe45dcc9ae5b66ba86600cca6b8ba8")

// --- block-boundary lengths: where the 0x80 pad byte forces an extra block
// (len % 64 in 56..63 for SHA-256/SHA-1/MD5; len % 128 in 112..127 for
// SHA-512). 64/128 are exact block multiples. ---
assert_eq(Hash.sha256(rep("a", 55)),
          "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318")
assert_eq(Hash.sha256(rep("a", 56)),
          "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a")
assert_eq(Hash.sha256(rep("a", 63)),
          "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34")
assert_eq(Hash.sha256(rep("a", 64)),
          "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb")
assert_eq(Hash.md5(rep("a", 56)), "3b0c8ac703f828b04c6c197006d17218")
assert_eq(Hash.md5(rep("a", 64)), "014842d480b571495a4a0363793f7367")
assert_eq(Hash.sha512(rep("a", 111)),
  "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef8681819692176" +
  "0b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2")
assert_eq(Hash.sha512(rep("a", 112)),
  "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32" +
  "bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca")
assert_eq(Hash.sha512(rep("a", 128)),
  "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a24" +
  "3667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321")

// --- binary-safe: embedded NUL must not truncate the input ---
let b = "a\x00b"
assert_eq(b.size(), 3)
assert_eq(Hash.sha256(b),
          "59b271ae1bbcb1d31d41929817f4b16fb439eb4f31520b5ad1d5ce98920a7138")

// --- HMAC (RFC 4231 TC2: key="Jefe", msg="what do ya want for nothing?") ---
let k = "Jefe"
let m = "what do ya want for nothing?"
assert_eq(Hash.hmac_sha256(k, m),
          "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
assert_eq(Hash.hmac_sha1(k, m), "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
assert_eq(Hash.hmac_sha512(k, m),
  "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea250554" +
  "9758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")

// --- HMAC is binary-safe in the message (embedded NUL is part of the data) ---
assert_eq(Hash.hmac_sha256("key", "a\x00b"),
          "29c5f0eea2d0a51b661193b3a56191192b2861f543ea0499a7f9725f7e7062fc")

// --- HMAC with a key longer than the block size (key gets hashed first) ---
let longkey = rep("k", 200)
assert_eq(Hash.hmac_sha256(longkey, "msg").size(), 64)  // valid 32-byte digest

// --- digest hex lengths ---
assert_eq(Hash.sha256("x").size(), 64)
assert_eq(Hash.sha1("x").size(), 40)
assert_eq(Hash.sha512("x").size(), 128)
assert_eq(Hash.md5("x").size(), 32)

// --- a non-String argument raises TypeError (declared param type) ---
assert_throws("TypeError", fn () { Hash.sha256(42) })
assert_throws("TypeError", fn () { Hash.hmac_sha256(1, "m") })
assert_throws("TypeError", fn () { Hash.hmac_sha256("k", [1, 2]) })

// --- first-class value: bound namespace method (slow-path conformance) ---
let f = Hash.sha256
assert_eq(f("abc"),
          "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

// --- higher-order: passed as a callback ---
let inputs = ["a", "b", "c"]
let digs = inputs.map(Hash.md5)
assert_eq(digs[0], "0cc175b9c0f1b6a831c399e269772661")
assert_eq(digs.size(), 3)

inspect("hash tests passed")
