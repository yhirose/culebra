// _Canvas: the value-neutral framebuffer primitives (canvas.h). The Canvas
// preamble (colours, Sprite, font, run loop) is exercised via its own surface;
// here we pin the raw pixel ops so interp and JIT agree byte for byte. present
// / input / tone are host-driven (headless returns nothing), so they are
// smoke-called for symmetry, not asserted.

// A packed RGBA colour: r | g<<8 | b<<16 | a<<24 — the byte order putImageData
// consumes. Built with arithmetic so the test needs nothing from the preamble.
fn rgba(r, g, b, a) {
  r + g * 256 + b * 65536 + a * 16777216
}
let RED = rgba(255, 0, 0, 255)
let GREEN = rgba(0, 255, 0, 255)
let BLUE = rgba(0, 0, 255, 255)
let WHITE = rgba(255, 255, 255, 255)
let BLACK = rgba(0, 0, 0, 255)

// --- framebuffer: init / clear / set_pixel / get_pixel / bounds ---
_Canvas.init(4, 4)
assert_eq(_Canvas.width(), 4)
assert_eq(_Canvas.height(), 4)

_Canvas.clear(RED)
assert_eq(_Canvas.get_pixel(0, 0), RED)
assert_eq(_Canvas.get_pixel(3, 3), RED)

_Canvas.set_pixel(1, 1, GREEN)
assert_eq(_Canvas.get_pixel(1, 1), GREEN)
assert_eq(_Canvas.get_pixel(0, 0), RED)  // neighbours untouched

// Off-buffer writes are dropped and reads return 0 (transparent).
_Canvas.set_pixel(-1, 0, GREEN)
_Canvas.set_pixel(9, 9, GREEN)
assert_eq(_Canvas.get_pixel(9, 9), 0)
assert_eq(_Canvas.get_pixel(-1, -1), 0)

// --- rect: filled, clipped ---
_Canvas.clear(RED)
_Canvas.rect(1, 1, 2, 2, BLUE, 1)
assert_eq(_Canvas.get_pixel(1, 1), BLUE)
assert_eq(_Canvas.get_pixel(2, 2), BLUE)
assert_eq(_Canvas.get_pixel(0, 0), RED)  // outside the rect
assert_eq(_Canvas.get_pixel(3, 3), RED)
_Canvas.rect(3, 3, 5, 5, GREEN, 1)  // spills past the edge, clipped
assert_eq(_Canvas.get_pixel(3, 3), GREEN)

let CLEAR = rgba(0, 0, 0, 0)

// --- Float geometry: rounds toward -inf, one rule for all three backends ---
_Canvas.clear(RED)
_Canvas.rect(1.7, 1.2, 2.9, 2.9, BLUE, 1)  // -> rect(1, 1, 2, 2)
assert_eq(_Canvas.get_pixel(1, 1), BLUE)
assert_eq(_Canvas.get_pixel(2, 2), BLUE)
assert_eq(_Canvas.get_pixel(3, 3), RED)
assert_eq(_Canvas.get_pixel(1.9, 1.9), BLUE)  // readback rounds the same way
// A negative float floors off-buffer instead of snapping onto column 0.
_Canvas.clear(RED)
_Canvas.set_pixel(-0.5, 0.0, BLUE)
assert_eq(_Canvas.get_pixel(0, 0), RED)
// Non-finite and out-of-range values saturate rather than trap.
_Canvas.set_pixel(1e30, 0, BLUE)
_Canvas.set_pixel(-Math.inf, 0, BLUE)
assert_eq(_Canvas.get_pixel(0, 0), RED)
_Canvas.set_pixel(Math.nan, 0, BLUE)  // NaN -> 0
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
// Colours, flags and handles are still Long-only.
assert_eq(try {
  _Canvas.rect(0, 0, 1, 1, 1.5, 1)
} catch e {
  e.message
}, "type error: parameter 'rgba' expects Long")
assert_eq(try {
  _Canvas.rect("x", 0, 1, 1, 1, 1)
} catch e {
  e.message
}, "type error: parameter 'x' expects Long|Float")

// --- triangle / polygon: even-odd scanline fill ---
// Renders the framebuffer as one string per row so a whole shape asserts at once.
fn dump() {
  mut rows = []
  mut y = 0
  while y < _Canvas.height() {
    mut s = ""
    mut x = 0
    while x < _Canvas.width() {
      let p = _Canvas.get_pixel(x, y)
      s = s + if p == RED {
        "."
      } else if p == BLUE {
        "#"
      } else if p == GREEN {
        "o"
      } else if p == WHITE {
        "w"
      } else {
        " "
      }
      x = x + 1
    }
    rows.push(s)
    y = y + 1
  }
  rows.join("/")
}

_Canvas.init(8, 6)
_Canvas.clear(CLEAR)
_Canvas.triangle(0, 0, 8, 0, 0, 6, BLUE, 1)
assert_eq(dump(), "########/######  /#####   /####    /##      /#       ")
// Floats floor like every other coordinate — same shape.
_Canvas.clear(CLEAR)
_Canvas.triangle(0.5, 0.9, 8.2, 0.4, 0.7, 6.8, BLUE, 1)
assert_eq(dump(), "########/######  /#####   /####    /##      /#       ")
// Zero-area input draws nothing.
_Canvas.clear(RED)
_Canvas.triangle(0, 0, 4, 0, 8, 0, BLUE, 1)  // collinear
_Canvas.triangle(2, 2, 2, 2, 2, 2, BLUE, 1)  // a point
assert_eq(dump(), "......../......../......../......../......../........")
// The seam property, stated as an identity: a rectangle cut along its diagonal
// into two triangles must rasterize back to exactly the rectangle — no gap
// along the shared edge, and no pixel claimed twice.
_Canvas.clear(CLEAR)
_Canvas.triangle(1, 1, 7, 1, 1, 5, BLUE, 1)
_Canvas.triangle(7, 1, 7, 5, 1, 5, BLUE, 1)
let halves = dump()
_Canvas.clear(CLEAR)
_Canvas.rect(1, 1, 6, 4, BLUE, 1)
assert_eq(halves, dump())

// polygon: flat x0, y0, x1, y1, ... with the outline closing itself.
_Canvas.clear(CLEAR)
_Canvas.polygon([3, 1, 5, 1, 7, 5, 1, 5], BLUE, 1)
assert_eq(dump(), "        /   ##   /  ###   /  ####  / #####  /        ")
// Float vertices floor the same way.
_Canvas.clear(CLEAR)
_Canvas.polygon([3.5, 1.2, 5.9, 1.7, 7.4, 5.5, 1.8, 5.1], BLUE, 1)
assert_eq(dump(), "        /   ##   /  ###   /  ####  / #####  /        ")
// Polygons sharing an edge tile with no seam and no double-drawn row.
_Canvas.clear(CLEAR)
_Canvas.polygon([2, 0, 6, 0, 7, 3, 1, 3], BLUE, 1)
_Canvas.polygon([1, 3, 7, 3, 8, 6, 0, 6], GREEN, 1)
assert_eq(dump(), "  ####  / #####  / #####  / oooooo /ooooooo /ooooooo ")
// Clipped on all four sides.
_Canvas.clear(CLEAR)
_Canvas.polygon([-6, -2, 2, -2, 12, 8, 4, 8], BLUE, 1)
assert_eq(dump(), "####    /#####   /######  /####### /########/ #######")
// Concave outlines fill by the even-odd rule.
_Canvas.clear(CLEAR)
_Canvas.polygon([0, 0, 8, 0, 8, 6, 6, 6, 6, 2, 2, 2, 2, 6, 0, 6], BLUE, 1)
assert_eq(dump(), "########/########/##    ##/##    ##/##    ##/##    ##")
// Fewer than 3 vertices draws nothing; a trailing half-pair is ignored.
_Canvas.clear(RED)
_Canvas.polygon([], BLUE, 1)
_Canvas.polygon([1, 1], BLUE, 1)
_Canvas.polygon([1, 1, 5, 5], BLUE, 1)
_Canvas.polygon([1, 1, 5, 1, 5], BLUE, 1)  // 2 vertices + a stray x
assert_eq(dump(), "......../......../......../......../......../........")
// Vertices carry the same Long|Float contract the scalar arguments do.
assert_eq(try {
  _Canvas.polygon([1, 1, "x", 1, 5, 5], BLUE, 1)
} catch e {
  e.message
}, "type error: parameter 'points' expects an Array of Long|Float")
assert_eq(try {
  _Canvas.polygon(5, BLUE, 1)
} catch e {
  e.message
}, "type error: parameter 'points' expects Array")
assert_eq(try {
  _Canvas.polygon([1, 1, 5, 1, 5, 5], 1.5, 1)
} catch e {
  e.message
}, "type error: parameter 'rgba' expects Long")
assert_eq(try {
  _Canvas.triangle(0, 0, 1, 1, 2, 2, 1.5, 1)
} catch e {
  e.message
}, "type error: parameter 'rgba' expects Long")

// --- line / ellipse primitives ---
// line carries the same Long|Float coordinate contract; both endpoints are
// pixels, and both argument orders draw the same pixels.
_Canvas.init(6, 6)
_Canvas.clear(0)
_Canvas.line(0, 0, 5, 5, BLUE)
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
assert_eq(_Canvas.get_pixel(5, 5), BLUE)
_Canvas.line(5, 5, 0, 0, RED)
assert_eq(_Canvas.get_pixel(2, 2), RED)  // reverse overdrew every pixel
mut leftover = 0
for y in 0..6 {
  for x in 0..6 {
    leftover = leftover + 1 if _Canvas.get_pixel(x, y) == BLUE
  }
}
assert_eq(leftover, 0)
_Canvas.clear(0)
_Canvas.line(0.9, 2.1, 4.2, 2.8, BLUE)  // Floats floor like other coords
assert_eq(_Canvas.get_pixel(0, 2), BLUE)
assert_eq(try {
  _Canvas.line(0, 0, "x", 1, 1)
} catch e {
  e.message
}, "type error: parameter 'x2' expects Long|Float")
assert_eq(try {
  _Canvas.line(0, 0, 1, 1, 1.5)
} catch e {
  e.message
}, "type error: parameter 'rgba' expects Long")

// ellipse: centre-and-radii, fill and outline; negative radius draws nothing.
_Canvas.init(7, 7)
_Canvas.clear(0)
_Canvas.ellipse(3, 3, 3, 3, BLUE, 1)
assert_eq(_Canvas.get_pixel(0, 3), BLUE)  // (cx - r, cy)
assert_eq(_Canvas.get_pixel(3, 0), BLUE)  // (cx, cy - r)
assert_eq(_Canvas.get_pixel(0, 0), 0)     // the corner stays outside
_Canvas.clear(0)
_Canvas.ellipse(3, 3, 3, 3, BLUE, 0)
assert_eq(_Canvas.get_pixel(0, 3), BLUE)
assert_eq(_Canvas.get_pixel(3, 3), 0)  // interior untouched
_Canvas.ellipse(3, 3, -1, 2, RED, 1)
assert_eq(_Canvas.get_pixel(3, 3), 0)  // negative radius: nothing
assert_eq(try {
  _Canvas.ellipse(0, 0, "r", 1, 1, 1)
} catch e {
  e.message
}, "type error: parameter 'rx' expects Long|Float")
assert_eq(try {
  _Canvas.ellipse(0, 0, 1, 1, 1.5, 1)
} catch e {
  e.message
}, "type error: parameter 'rgba' expects Long")

_Canvas.init(4, 4)

// --- sprite: load + blit, with transparency and flips ---
// A 2x2 sprite: top row RED, bottom-left BLUE, bottom-right transparent.
let spr = _Canvas.sprite_load([RED, RED, BLUE, CLEAR], 2, 2)

_Canvas.init(4, 4)
_Canvas.clear(GREEN)
_Canvas.blit(spr, 0, 0, 0, 0, 2, 2, 0)  // no flags
assert_eq(_Canvas.get_pixel(0, 0), RED)
assert_eq(_Canvas.get_pixel(1, 0), RED)
assert_eq(_Canvas.get_pixel(0, 1), BLUE)
assert_eq(_Canvas.get_pixel(1, 1), GREEN)  // transparent pixel showed through

// flip Y: bottom row of the sprite lands on the top row of the destination.
_Canvas.clear(GREEN)
_Canvas.blit(spr, 0, 0, 0, 0, 2, 2, 2)  // flag 2 = flip Y
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
assert_eq(_Canvas.get_pixel(1, 0), GREEN)  // transparent, moved to top-right
assert_eq(_Canvas.get_pixel(0, 1), RED)

// An out-of-range handle blits nothing (no crash).
_Canvas.clear(GREEN)
_Canvas.blit(999, 0, 0, 0, 0, 2, 2, 0)
assert_eq(_Canvas.get_pixel(0, 0), GREEN)

// --- blit_scaled: resample, flip, box-average, alpha ---
// A 2x2 checker: blue, green / green, blue.
let chk = _Canvas.sprite_load([BLUE, GREEN, GREEN, BLUE], 2, 2)
_Canvas.init(4, 4)
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(chk, 0, 0, 4, 4, 0, 0, 2, 2, 0, 255)  // 2x, nearest
assert_eq(dump(), "##oo/##oo/oo##/oo##")
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(chk, 0, 0, 4, 4, 0, 0, 2, 2, 1, 255)  // flip X
assert_eq(dump(), "oo##/oo##/##oo/##oo")
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(chk, 0, 0, 4, 4, 0, 0, 2, 2, 2, 255)  // flip Y
assert_eq(dump(), "oo##/oo##/##oo/##oo")
// Clipped on all four sides.
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(chk, -2, -2, 8, 8, 0, 0, 2, 2, 0, 255)
assert_eq(dump(), "##oo/##oo/oo##/oo##")
// A degenerate destination or source rectangle is a no-op.
_Canvas.clear(RED)
_Canvas.blit_scaled(chk, 0, 0, 0, 4, 0, 0, 2, 2, 0, 255)
_Canvas.blit_scaled(chk, 0, 0, 4, -1, 0, 0, 2, 2, 0, 255)
_Canvas.blit_scaled(chk, 0, 0, 4, 4, 0, 0, 0, 2, 0, 255)
_Canvas.blit_scaled(999, 0, 0, 4, 4, 0, 0, 2, 2, 0, 255)
assert_eq(dump(), "..../..../..../....")

// A ratio that doesn't divide. Destination column u samples source column
// floor(u * sw / dw), which the blit carries forward incrementally instead of
// dividing per pixel, so a 7 -> 5 shrink pins that it floors the same way.
let ramp = _Canvas.sprite_load(
  [
    rgba(0, 0, 0, 255),
    rgba(10, 0, 0, 255),
    rgba(20, 0, 0, 255),
    rgba(30, 0, 0, 255),
    rgba(40, 0, 0, 255),
    rgba(50, 0, 0, 255),
    rgba(60, 0, 0, 255),
  ],
  7,
  1,
)
let ramp_row = fn (w) {
  mut out = []
  for x in 0..w {
    out.push(_Canvas.get_pixel(x, 0) % 256 / 10)
  }
  out
}
_Canvas.init(5, 1)
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(ramp, 0, 0, 5, 1, 0, 0, 7, 1, 0, 255)
assert_eq(ramp_row(5), [0, 1, 2, 4, 5])
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(ramp, 0, 0, 5, 1, 0, 0, 7, 1, 1, 255)  // flip X
assert_eq(ramp_row(5), [5, 4, 2, 1, 0])
// Clipped on the left, so the walk starts part way along the destination.
_Canvas.init(3, 1)
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(ramp, -2, 0, 5, 1, 0, 0, 7, 1, 0, 255)
assert_eq(ramp_row(3), [2, 4, 5])
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(ramp, -2, 0, 5, 1, 0, 0, 7, 1, 1, 255)  // flip X, clipped
assert_eq(ramp_row(3), [2, 1, 0])
// A source rectangle reaching past the sprite draws only the rows that exist.
let two_rows = _Canvas.sprite_load([BLUE, BLUE, GREEN, GREEN], 2, 2)
_Canvas.init(2, 4)
_Canvas.clear(RED)
_Canvas.blit_scaled(two_rows, 0, 0, 2, 4, 0, 0, 2, 4, 0, 255)
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
assert_eq(_Canvas.get_pixel(0, 1), GREEN)
assert_eq(_Canvas.get_pixel(0, 2), RED)  // source row 2 is off the sprite
assert_eq(_Canvas.get_pixel(0, 3), RED)

// alpha: 0 draws nothing, 255 is the plain blit, and in between each channel
// is (src*a + dst*(255-a) + 127) / 255.
_Canvas.init(2, 1)
_Canvas.clear(RED)
_Canvas.blit_scaled(chk, 0, 0, 2, 1, 0, 0, 2, 1, 0, 0)
assert_eq(_Canvas.get_pixel(0, 0), RED)
_Canvas.blit_scaled(chk, 0, 0, 2, 1, 0, 0, 2, 1, 0, 255)
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
_Canvas.clear(RED)
_Canvas.blit_scaled(chk, 0, 0, 2, 1, 0, 0, 2, 1, 0, 128)
assert_eq(_Canvas.get_pixel(0, 0), rgba(127, 0, 128, 255))

// Box averaging (flag 8) only when shrinking. A 4x1 half-blue half-green strip:
let strip = _Canvas.sprite_load([BLUE, BLUE, GREEN, GREEN], 4, 1)
_Canvas.init(2, 1)
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(strip, 0, 0, 2, 1, 0, 0, 4, 1, 8, 255)
assert_eq(_Canvas.get_pixel(0, 0), BLUE)  // each box is one pure colour
assert_eq(_Canvas.get_pixel(1, 0), GREEN)
_Canvas.init(1, 1)
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(strip, 0, 0, 1, 1, 0, 0, 4, 1, 8, 255)
assert_eq(_Canvas.get_pixel(0, 0), rgba(0, 127, 127, 255))  // whole strip averaged
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(strip, 0, 0, 1, 1, 0, 0, 4, 1, 0, 255)  // nearest instead
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
// Shrinking in both axes at once: a 5x5 down to 2x2 splits the source into
// boxes of columns 0..1 / 2..4 and rows 0..1 / 2..4, so a source laid out in
// exactly those blocks survives the average unchanged.
mut blocks = []
for y in 0..5 {
  for x in 0..5 {
    blocks.push(if y < 2 {
      if x < 2 {
        RED
      } else {
        GREEN
      }
    } else {
      if x < 2 {
        BLUE
      } else {
        WHITE
      }
    })
  }
}
let quad = _Canvas.sprite_load(blocks, 5, 5)
_Canvas.init(2, 2)
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(quad, 0, 0, 2, 2, 0, 0, 5, 5, 8, 255)
assert_eq(dump(), ".o/#w")  // RED GREEN / BLUE WHITE
// Averaging a 2-D box that isn't uniform, and the same box composited at
// alpha=128 over red — sampling then blending, each integer-only.
_Canvas.init(1, 1)
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(chk, 0, 0, 1, 1, 0, 0, 2, 2, 8, 255)
assert_eq(_Canvas.get_pixel(0, 0), rgba(0, 127, 127, 255))
_Canvas.clear(RED)
_Canvas.blit_scaled(chk, 0, 0, 1, 1, 0, 0, 2, 2, 8, 128)
assert_eq(_Canvas.get_pixel(0, 0), rgba(127, 64, 64, 255))

// A transparent source pixel never joins the average, and a wholly transparent
// box leaves the destination alone.
let edge = _Canvas.sprite_load([CLEAR, BLUE, BLUE, BLUE], 4, 1)
_Canvas.clear(RED)
_Canvas.blit_scaled(edge, 0, 0, 1, 1, 0, 0, 4, 1, 8, 255)
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
let hole = _Canvas.sprite_load([CLEAR, CLEAR, CLEAR, CLEAR], 4, 1)
_Canvas.clear(RED)
_Canvas.blit_scaled(hole, 0, 0, 1, 1, 0, 0, 4, 1, 8, 255)
assert_eq(_Canvas.get_pixel(0, 0), RED)

assert_eq(try {
  _Canvas.blit_scaled(chk, 0, 0, 1, 1, 0, 0, 1, 1, 0, "x")
} catch e {
  e.message
}, "type error: parameter 'alpha' expects Long")

// --- font_load / glyph: an 8x8 bitmap cell, one call per character ---
// Two glyphs: index 0 is a solid block, index 1 a single top-left pixel.
// A ZERO bit is lit, so 0x00 is solid and 0x7f lights only the leftmost pixel.
let font = _Canvas.font_load([
  0,
  0,
  0,
  0,
  0,
  0,
  0,
  0,
  127,
  255,
  255,
  255,
  255,
  255,
  255,
  255,
])
_Canvas.init(10, 8)
_Canvas.clear(CLEAR)
_Canvas.glyph(font, 0, 0, 0, BLUE, 1)
_Canvas.glyph(font, 1, 8, 0, GREEN, 1)
assert_eq(
  dump(),
  "########o /########  /########  /########  /" +
    "########  /########  /########  /########  ",
)
// Clipped at every edge, and the coordinates take Floats like the rest.
_Canvas.clear(CLEAR)
_Canvas.glyph(font, 0, -6, -6, BLUE, 1)
_Canvas.glyph(font, 0, 8.9, 6.9, BLUE, 1)
assert_eq(
  dump(),
  "##        /##        /          /          /" +
    "          /          /        ##/        ##",
)
// An unknown handle, a negative index and an index past the table all draw
// nothing rather than reading out of bounds.
_Canvas.clear(RED)
_Canvas.glyph(999, 0, 0, 0, BLUE, 1)
_Canvas.glyph(font, -1, 0, 0, BLUE, 1)
_Canvas.glyph(font, 2, 0, 0, BLUE, 1)
_Canvas.glyph(_Canvas.font_load([]), 0, 0, 0, BLUE, 1)
// Indices where `index * 8` wraps a 64-bit product: a bound computed from that
// product would let them through and read off the front of the table.
_Canvas.glyph(font, 2305843009213693951, 0, 0, BLUE, 1)
_Canvas.glyph(font, 2305843009213693952, 0, 0, BLUE, 1)
_Canvas.glyph(font, 9223372036854775807, 0, 0, BLUE, 1)
assert_eq(_Canvas.get_pixel(0, 0), RED)

_Canvas.init(4, 4)

// --- ttf_load / ttf_glyph / ttf_advance / ttf_ascent: outline rasterization ---
// A wholly original, minimal TTF (project-authored, public domain -- no
// licensing question the way a real-world font would raise): 1000 units/em,
// ascent 800 / descent -200, four mapped codepoints -- 'A' a solid square
// filling 0..700 (no antialiasing, for an exact coverage-count check), 'B' a
// right triangle 0..700 (a genuine antialiased diagonal edge, for the
// coverage/alpha composite check), space with advance-only metrics, and
// U+3042 (multi-byte in UTF-8) mapped to a small diamond, exercised by the
// preamble's Font tests in test_canvas_module.cul.
let TTF_TEST_FONT = ""

let font = _Canvas.ttf_load(Encoding.hex.decode(TTF_TEST_FONT))

// Metrics: 1000 units/em, ascent 800, 'A'/'B' advance 800, space advance 400
// -- at size 10 that's scale 0.01, so whole-pixel results with no rounding
// ambiguity.
assert_eq(_Canvas.ttf_ascent(font, 10), 8)
assert_eq(_Canvas.ttf_advance(font, 65, 10), 8)  // 'A'
assert_eq(_Canvas.ttf_advance(font, 32, 10), 4)  // space

// 'A' is a solid square with no antialiased edge at this scale: coverage is
// either full or absent, never partial.
_Canvas.init(20, 20)
_Canvas.clear(CLEAR)
_Canvas.ttf_glyph(font, 65, 2, 10, WHITE, 10)  // (x, y) is the baseline
mut opaque = 0
mut any = 0
for y in 0..20 {
  for x in 0..20 {
    let a = (_Canvas.get_pixel(x, y) >> 24) & 0xff
    if a > 0 {
      any = any + 1
    }
    if a == 255 {
      opaque = opaque + 1
    }
  }
}
assert_eq(any, 49)     // a clean 7x7 block
assert_eq(opaque, 49)  // -- fully opaque throughout, no partial-coverage rim

// 'B' is a right triangle: its hypotenuse gives a genuine antialiased edge.
// The exact composited values are hand-verified against blend_over's rule
// ((cov*a+127)/255): drawing rgba(10, 20, 30, 200) over transparent puts
// (0, 1) at coverage-scaled alpha 100 -- (10*100+127)/255 = 4,
// (20*100+127)/255 = 8, (30*100+127)/255 = 12 -- and (0, 2) sits fully
// inside the triangle at the base colour's own alpha, 200.
_Canvas.init(10, 10)
_Canvas.clear(CLEAR)
_Canvas.ttf_glyph(font, 66, 0, 8, rgba(10, 20, 30, 200), 10)  // 'B', baseline y=8
assert_eq(_Canvas.get_pixel(0, 1), rgba(4, 8, 12, 100))
assert_eq(_Canvas.get_pixel(0, 2), rgba(8, 16, 24, 200))
// Drawing the same edge over an opaque background composites through
// blend_over's Porter-Duff alpha rule (a + da*(1-a)/255) rather than eroding
// it: the result stays fully opaque.
_Canvas.clear(RED)
_Canvas.ttf_glyph(font, 66, 0, 8, rgba(10, 20, 30, 200), 10)
assert_eq(_Canvas.get_pixel(0, 1), rgba(159, 8, 12, 255))

// --- ttf_*: unknown handle, freed handle, non-positive size, alpha 0, an
// unmapped codepoint -- every one a no-op / 0, never a crash or a read past
// what the font actually has.
_Canvas.init(4, 4)
_Canvas.clear(CLEAR)
_Canvas.ttf_glyph(999, 65, 0, 0, WHITE, 10)  // unknown handle
assert_eq(_Canvas.get_pixel(0, 0), 0)
assert_eq(_Canvas.ttf_advance(999, 65, 10), 0)
assert_eq(_Canvas.ttf_ascent(999, 10), 0)
assert_eq(_Canvas.ttf_advance(font, 65, 0), 0)   // size 0
assert_eq(_Canvas.ttf_advance(font, 65, -5), 0)  // negative size
assert_eq(_Canvas.ttf_ascent(font, 0), 0)
_Canvas.ttf_glyph(font, 65, 0, 0, WHITE, 0)  // non-positive size draws nothing
assert_eq(_Canvas.get_pixel(0, 0), 0)
_Canvas.ttf_glyph(font, 65, 0, 0, rgba(255, 255, 255, 0), 10)  // alpha 0
assert_eq(_Canvas.get_pixel(0, 0), 0)
// A codepoint outside the font's cmap falls back to stb_truetype's own
// .notdef glyph rather than being skipped (no crash either way) -- this
// fixture's .notdef happens to carry no outline, so nothing is drawn here; a
// real font with a visible .notdef "tofu box" would draw that box instead.
_Canvas.ttf_glyph(font, 128512, 0, 0, WHITE, 10)  // U+1F600, unmapped
assert_eq(_Canvas.get_pixel(0, 0), 0)

// A huge size clamps rather than rasterizing (and allocating) unboundedly.
assert_eq(_Canvas.ttf_advance(font, 65, 999999999), 1638)  // 800 * (2048/1000)

// --- ttf_glyph_screen: the same glyph, into the screen layer ---
// Headless has no display, so screen_scale() is 1.0 and the screen layer is
// the framebuffer's size. That is what makes this checkable here: at scale 1
// a screen glyph is rasterized at the same size and placed at the same
// coordinates as a framebuffer one, so the two buffers must come out
// byte-identical -- across interp, JIT and AOT alike. The scaling itself
// (a real window's integer upscale, the Playground's pane width) has no
// headless equivalent and is verified by eye.
assert_eq(_Canvas.screen_scale(), 1.0)
_Canvas.init(20, 20)
assert_eq(_Canvas.screen_width(), _Canvas.width())
assert_eq(_Canvas.screen_height(), _Canvas.height())

_Canvas.clear(CLEAR)  // both buffers start transparent, so the blends match
_Canvas.ttf_glyph(font, 65, 2, 10, WHITE, 10)
_Canvas.ttf_glyph_screen(font, 65, 2, 10, WHITE, 10)
mut screen_lit = 0
mut screen_differs = 0
for y in 0..20 {
  for x in 0..20 {
    let fb = _Canvas.get_pixel(x, y)
    screen_lit = screen_lit + 1 if fb != 0
    screen_differs = screen_differs + 1 if _Canvas.get_screen_pixel(x, y) != fb
  }
}
assert_eq(screen_lit, 49)      // the same 7x7 block ttf_glyph draws
assert_eq(screen_differs, 0)   // and the screen layer holds exactly it

// A screen draw inside draw_to still goes to the screen, not the sprite: the
// layer sits on top of the presented frame, and a sprite is never presented.
let off = _Canvas.sprite_blank(20, 20, CLEAR)
let prev = _Canvas.target(off)
_Canvas.ttf_glyph_screen(font, 66, 0, 8, WHITE, 10)
_Canvas.target(prev)
assert_eq(_Canvas.get_screen_pixel(0, 7), WHITE)  // 'B' landed on the screen
_Canvas.sprite_free(off)

// An unknown handle draws nothing and reports no advance, like ttf_glyph.
assert_eq(_Canvas.ttf_glyph_screen(999, 65, 0, 0, WHITE, 10), 0)
// The advance is the LOGICAL one, so a caller's pen and text_width() agree
// with the ttf_glyph path whatever the scale is.
assert_eq(_Canvas.ttf_glyph_screen(font, 65, 0, 0, WHITE, 10),
          _Canvas.ttf_advance(font, 65, 10))

// present() clears the screen layer and leaves the framebuffer alone: screen
// text is redrawn every frame, framebuffer drawing accumulates. Assertions on
// screen pixels must come BEFORE any present() for that reason.
_Canvas.present()
mut after_present = 0
mut fb_after_present = 0
for y in 0..20 {
  for x in 0..20 {
    after_present = after_present + 1 if _Canvas.get_screen_pixel(x, y) != 0
    fb_after_present = fb_after_present + 1 if _Canvas.get_pixel(x, y) != 0
  }
}
assert_eq(after_present, 0)
assert_eq(fb_after_present, 49)

_Canvas.ttf_free(font)
assert_eq(_Canvas.ttf_advance(font, 65, 10), 0)  // a freed handle is unknown
_Canvas.ttf_free(font)                           // a second free is a no-op

// Anything stb_truetype can't parse raises the one shared ValueError.
assert_eq(try {
  _Canvas.ttf_load("not a font")
} catch e {
  e.kind + "|" + e.message
}, "ValueError|not a valid TTF/OTF font")
assert_eq(try {
  _Canvas.ttf_load("")
} catch e {
  e.message
}, "not a valid TTF/OTF font")
assert_eq(try {
  _Canvas.ttf_load(5)
} catch e {
  e.message
}, "type error: parameter 'data' expects String")

// --- sprite_from_png: decode, and read the size back from the decode ---
// Hand-built fixtures (see the PNG spec's colour types), hex so the bytes
// survive as source. Every one is 2 pixels wide: red, green / blue, transparent
// where the format can express transparency.
let PNG_RGBA = "89504e470d0a1a0a0000000d494844520000000200000002080600000072b60d240000001349444154789c63f8cfc0f01f0c8134886000003fd205fbcb17a6ce0000000049454e44ae426082"
let PNG_RGB = "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000001249444154789c63f8cfc0c000c20cff8100001fee05fb0bd9688b0000000049454e44ae426082"
let PNG_GREY = "89504e470d0a1a0a0000000d4948445200000002000000010800000000d14920560000000b49444154789c6360f80f000102010042bebc680000000049454e44ae426082"
let PNG_GREYA = "89504e470d0a1a0a0000000d49484452000000020000000108040000005e2bb7010000000d49444154789c63f8ffbf81010007fe027f72dd80350000000049454e44ae426082"
let PNG_PAL = "89504e470d0a1a0a0000000d49484452000000020000000208030000004568fd160000000c504c5445ff000000ff000000ff0909095c717e860000000474524e53ffffff00402aa9f40000000e49444154789c6360606460620600001100079ea22a120000000049454e44ae426082"
let PNG_I16 = "89504e470d0a1a0a0000000d4948445200000002000000011006000000a4b2a3c90000001149444154789c63f8ff9f010840240403003fd107f968446ef10000000049454e44ae426082"

// Decode `hex`, blit the whole image at the origin and read the pixels back.
fn png_pixels(hex) {
  let id = _Canvas.sprite_from_png(Encoding.hex.decode(hex))
  let w = _Canvas.sprite_width(id)
  let h = _Canvas.sprite_height(id)
  _Canvas.init(w, h)
  _Canvas.clear(0)
  _Canvas.blit(id, 0, 0, 0, 0, w, h, 0)
  mut px = []
  for y in 0..h {
    for x in 0..w {
      px.push(_Canvas.get_pixel(x, y))
    }
  }
  px
}

// Every colour type lands on the same packed-RGBA layout the framebuffer uses.
assert_eq(png_pixels(PNG_RGBA), [RED, GREEN, BLUE, CLEAR])
assert_eq(png_pixels(PNG_RGB), [RED, GREEN, BLUE, WHITE])  // no alpha = opaque
assert_eq(png_pixels(PNG_GREY), [BLACK, WHITE])
assert_eq(png_pixels(PNG_GREYA), [WHITE, CLEAR])
assert_eq(png_pixels(PNG_PAL), [RED, GREEN, BLUE, CLEAR])  // palette + tRNS
assert_eq(png_pixels(PNG_I16), [RED, GREEN])               // 16 bpc, narrowed

// Anything that isn't a decodable PNG raises the one shared ValueError.
let truncated = "89504e470d0a1a0a0000000d4948445200000002"
assert_eq(try {
  _Canvas.sprite_from_png(Encoding.hex.decode(truncated))
} catch e {
  e.kind + "|" + e.message
}, "ValueError|not a valid PNG image")
assert_eq(try {
  _Canvas.sprite_from_png("")
} catch e {
  e.message
}, "not a valid PNG image")
assert_eq(try {
  _Canvas.sprite_from_png(5)
} catch e {
  e.message
}, "type error: parameter 'data' expects String")
// An unknown handle has no dimensions (rather than reading out of bounds).
assert_eq(_Canvas.sprite_width(-1), 0)
assert_eq(_Canvas.sprite_height(9999), 0)

// --- sprite_to_png: the inverse, byte-exact through a decode round trip ---
// Encode each decoded fixture back out and decode again: the pixels must be
// the ones the framebuffer holds, whatever colour type came in (everything
// encodes as 8-bit truecolour + alpha).
fn reencoded_pixels(hex) {
  let id = _Canvas.sprite_from_png(Encoding.hex.decode(hex))
  png_pixels(Encoding.hex.encode(_Canvas.sprite_to_png(id)))
}
assert_eq(reencoded_pixels(PNG_RGBA), [RED, GREEN, BLUE, CLEAR])
assert_eq(reencoded_pixels(PNG_RGB), [RED, GREEN, BLUE, WHITE])
assert_eq(reencoded_pixels(PNG_GREY), [BLACK, WHITE])
assert_eq(reencoded_pixels(PNG_PAL), [RED, GREEN, BLUE, CLEAR])

// The output is a real PNG: signature, then IHDR's big-endian w/h. A String is
// a byte string, so the embedded NULs are bytes like any other.
let encoded = _Canvas.sprite_to_png(_Canvas.sprite_from_png(Encoding.hex.decode(PNG_RGBA)))
assert_eq(
  encoded.bytes().collect().slice(0, 8),
  [137, 80, 78, 71, 13, 10, 26, 10],
)
assert_eq(encoded.bytes().collect().slice(12, 16), [73, 72, 68, 82])  // "IHDR"
assert_eq(encoded.bytes().collect().slice(16, 24), [0, 0, 0, 2, 0, 0, 0, 2])
assert_true(encoded.size() > 24)

// id 0 encodes the CURRENT draw target, which is what Canvas.to_png() passes.
_Canvas.init(3, 2)
_Canvas.clear(RED)
assert_eq(
  png_pixels(Encoding.hex.encode(_Canvas.sprite_to_png(0))),
  [RED, RED, RED, RED, RED, RED],
)

// A stale handle raises rather than reading freed pixels; an empty target has
// nothing to encode.
assert_eq(try {
  _Canvas.sprite_to_png(9999)
} catch e {
  e.kind + "|" + e.message
}, "ValueError|not a live sprite handle")
_Canvas.init(0, 0)
assert_eq(try {
  _Canvas.sprite_to_png(0)
} catch e {
  e.message
}, "image has no pixels")
_Canvas.init(4, 4)

// --- sprite_free: a retired handle stays dead when its slot is reused ---
// Freeing recycles the slot, so the next registration can land on it. The
// generation is what keeps the two apart: the retired handle must resolve to
// nothing rather than to whichever sprite moved in.
let doomed = _Canvas.sprite_load([RED, RED, RED, RED], 2, 2)
assert_eq(_Canvas.sprite_width(doomed), 2)
_Canvas.sprite_free(doomed)
assert_eq(_Canvas.sprite_width(doomed), 0)
let heir = _Canvas.sprite_load([BLUE, BLUE, BLUE, BLUE, BLUE, BLUE], 3, 2)
assert_eq(_Canvas.sprite_width(heir), 3)
assert_eq(_Canvas.sprite_width(doomed), 0)  // not the heir's 3
assert_eq(doomed == heir, false)
// Drawing with a retired handle is a no-op, the way an unknown one is.
_Canvas.clear(CLEAR)
_Canvas.blit(doomed, 0, 0, 0, 0, 2, 2, 0)
assert_eq(_Canvas.get_pixel(0, 0), CLEAR)

// 0 names the framebuffer, so it is never a sprite handle — not even as the
// first registration of the process.
assert_eq(_Canvas.sprite_width(0), 0)
assert_eq(_Canvas.sprite_height(0), 0)

// Freeing an unknown, already-freed or zero handle is a no-op, not an error.
_Canvas.sprite_free(doomed)
_Canvas.sprite_free(0)
_Canvas.sprite_free(123456789)

// Freeing the sprite being drawn into is refused — it would leave the target
// dangling.
assert_eq(_Canvas.target(heir) >= 0, true)
assert_eq(try {
  _Canvas.sprite_free(heir)
} catch e {
  e.kind + "|" + e.message
}, "ValueError|cannot free the sprite currently drawn to")
_Canvas.target(0)

// Churn create/free: slots are recycled, but no two handles collide and every
// retired one stays dead.
mut retired = []
for _ in 0..64 {
  let tmp = _Canvas.sprite_load([GREEN], 1, 1)
  retired.push(tmp)
  _Canvas.sprite_free(tmp)
}
assert_true(retired.all(|h| _Canvas.sprite_width(h) == 0))
assert_eq(retired.to_set().size(), 64)

_Canvas.init(4, 4)

// --- host-driven prims: headless returns 0 / no-ops (called for symmetry) ---
assert_eq(_Canvas.buttons(), 0)
assert_eq(_Canvas.mouse_x(), 0)
assert_eq(_Canvas.mouse_y(), 0)
assert_eq(_Canvas.mouse_buttons(), 0)
// tone(start_freq, end_freq, attack, decay, sustain, release, vol, peak,
// channel, duty) — 10 Longs; headless is a no-op but the arity/types must match.
_Canvas.tone(700, 870, 10, 5, 0, 3, 10, 20, 0, 1)
_Canvas.present()
_Canvas.title("some window")
// False in a headless build, and in a window build too: every `just` recipe
// exports CULEBRA_CANVAS_HEADLESS, which is what makes the two identical.
assert_eq(_Canvas.windowed(), false)

print("canvas ok\n")
