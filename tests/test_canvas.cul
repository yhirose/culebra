// _Canvas: the value-neutral framebuffer primitives (canvas.h). The Canvas
// preamble (colours, Sprite, font, run loop) is exercised via its own surface;
// here we pin the raw pixel ops so interp and JIT agree byte for byte. present
// / input / tone are host-driven (headless returns nothing), so they are
// smoke-called for symmetry, not asserted.

// A packed RGBA colour: r | g<<8 | b<<16 | a<<24 — the byte order putImageData
// consumes. Built with arithmetic so the test needs nothing from the preamble.
fn rgba(r, g, b, a) { r + g * 256 + b * 65536 + a * 16777216 }
let RED = rgba(255, 0, 0, 255)
let GREEN = rgba(0, 255, 0, 255)
let BLUE = rgba(0, 0, 255, 255)

// --- framebuffer: init / clear / set_pixel / get_pixel / bounds ---
_Canvas.init(4, 4)
assert_eq(_Canvas.width(), 4)
assert_eq(_Canvas.height(), 4)

_Canvas.clear(RED)
assert_eq(_Canvas.get_pixel(0, 0), RED)
assert_eq(_Canvas.get_pixel(3, 3), RED)

_Canvas.set_pixel(1, 1, GREEN)
assert_eq(_Canvas.get_pixel(1, 1), GREEN)
assert_eq(_Canvas.get_pixel(0, 0), RED)      // neighbours untouched

// Off-buffer writes are dropped and reads return 0 (transparent).
_Canvas.set_pixel(-1, 0, GREEN)
_Canvas.set_pixel(9, 9, GREEN)
assert_eq(_Canvas.get_pixel(9, 9), 0)
assert_eq(_Canvas.get_pixel(-1, -1), 0)

// --- rect: filled, clipped ---
_Canvas.clear(RED)
_Canvas.rect(1, 1, 2, 2, BLUE)
assert_eq(_Canvas.get_pixel(1, 1), BLUE)
assert_eq(_Canvas.get_pixel(2, 2), BLUE)
assert_eq(_Canvas.get_pixel(0, 0), RED)      // outside the rect
assert_eq(_Canvas.get_pixel(3, 3), RED)
_Canvas.rect(3, 3, 5, 5, GREEN)              // spills past the edge, clipped
assert_eq(_Canvas.get_pixel(3, 3), GREEN)

let CLEAR = rgba(0, 0, 0, 0)

// --- Float geometry: rounds toward -inf, one rule for all three backends ---
_Canvas.clear(RED)
_Canvas.rect(1.7, 1.2, 2.9, 2.9, BLUE)       // -> rect(1, 1, 2, 2)
assert_eq(_Canvas.get_pixel(1, 1), BLUE)
assert_eq(_Canvas.get_pixel(2, 2), BLUE)
assert_eq(_Canvas.get_pixel(3, 3), RED)
assert_eq(_Canvas.get_pixel(1.9, 1.9), BLUE) // readback rounds the same way
// A negative float floors off-buffer instead of snapping onto column 0.
_Canvas.clear(RED)
_Canvas.set_pixel(-0.5, 0.0, BLUE)
assert_eq(_Canvas.get_pixel(0, 0), RED)
// Non-finite and out-of-range values saturate rather than trap.
_Canvas.set_pixel(1e30, 0, BLUE)
_Canvas.set_pixel(-Math.inf, 0, BLUE)
assert_eq(_Canvas.get_pixel(0, 0), RED)
_Canvas.set_pixel(Math.nan, 0, BLUE)         // NaN -> 0
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
// Colours, flags and handles are still Long-only.
assert_eq(try { _Canvas.rect(0, 0, 1, 1, 1.5) } catch e { e.message },
          "type error: parameter 'rgba' expects Long")
assert_eq(try { _Canvas.rect("x", 0, 1, 1, 1) } catch e { e.message },
          "type error: parameter 'x' expects Long|Float")

// --- trapezoid: horizontal top and bottom edges, rows [y_top, y_bot) ---
// Renders the framebuffer as one string per row so a whole shape asserts at once.
fn dump() {
  mut rows = []
  mut y = 0
  while y < _Canvas.height() {
    mut s = ""
    mut x = 0
    while x < _Canvas.width() {
      let p = _Canvas.get_pixel(x, y)
      s = s + (if p == RED { "." } else if p == BLUE { "#" }
               else if p == GREEN { "o" } else { " " })
      x = x + 1
    }
    rows.push(s)
    y = y + 1
  }
  rows.join("/")
}

_Canvas.init(8, 6)
_Canvas.clear(RED)
_Canvas.trapezoid(1, 3, 5, 5, 1, 7, BLUE)
assert_eq(dump(), "......../...##.../..###.../..####../.#####../........")
// Floats floor like every other coordinate — same shape.
_Canvas.clear(RED)
_Canvas.trapezoid(1.9, 3.5, 5.5, 5.5, 1.2, 7.7, BLUE)
assert_eq(dump(), "......../...##.../..###.../..####../.#####../........")
// Non-positive height draws nothing, as with a rect.
_Canvas.clear(RED)
_Canvas.trapezoid(3, 0, 8, 3, 0, 8, BLUE)
_Canvas.trapezoid(4, 0, 8, 2, 0, 8, BLUE)
assert_eq(dump(), "......../......../......../......../......../........")
// Trapezoids sharing an edge tile with no seam and no double-drawn row.
_Canvas.clear(CLEAR)
_Canvas.trapezoid(0, 2, 6, 3, 1, 7, BLUE)
_Canvas.trapezoid(3, 1, 7, 6, 0, 8, GREEN)
assert_eq(dump(), "  ####  / #####  / #####  / oooooo /ooooooo /ooooooo ")
// Clipped on all four sides; edges crossing x = 0 keep their slope.
_Canvas.clear(RED)
_Canvas.trapezoid(-2, -6, 2, 8, 4, 12, BLUE)
assert_eq(dump(), "####..../#####.../######../#######./########/.#######")

_Canvas.init(4, 4)

// --- sprite: load + blit, with transparency and flips ---
// A 2x2 sprite: top row RED, bottom-left BLUE, bottom-right transparent.
let spr = _Canvas.sprite_load([RED, RED, BLUE, CLEAR], 2, 2)

_Canvas.init(4, 4)
_Canvas.clear(GREEN)
_Canvas.blit(spr, 0, 0, 0, 0, 2, 2, 0)       // no flags
assert_eq(_Canvas.get_pixel(0, 0), RED)
assert_eq(_Canvas.get_pixel(1, 0), RED)
assert_eq(_Canvas.get_pixel(0, 1), BLUE)
assert_eq(_Canvas.get_pixel(1, 1), GREEN)    // transparent pixel showed through

// flip Y: bottom row of the sprite lands on the top row of the destination.
_Canvas.clear(GREEN)
_Canvas.blit(spr, 0, 0, 0, 0, 2, 2, 2)       // flag 2 = flip Y
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
assert_eq(_Canvas.get_pixel(1, 0), GREEN)    // transparent, moved to top-right
assert_eq(_Canvas.get_pixel(0, 1), RED)

// An out-of-range handle blits nothing (no crash).
_Canvas.clear(GREEN)
_Canvas.blit(999, 0, 0, 0, 0, 2, 2, 0)
assert_eq(_Canvas.get_pixel(0, 0), GREEN)

// --- blit_scaled: resample, flip, box-average, alpha ---
// A 2x2 checker: blue, green / green, blue.
let chk = _Canvas.sprite_load([BLUE, GREEN, GREEN, BLUE], 2, 2)
_Canvas.init(4, 4)
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(chk, 0, 0, 4, 4, 0, 0, 2, 2, 0, 255)     // 2x, nearest
assert_eq(dump(), "##oo/##oo/oo##/oo##")
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(chk, 0, 0, 4, 4, 0, 0, 2, 2, 1, 255)     // flip X
assert_eq(dump(), "oo##/oo##/##oo/##oo")
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(chk, 0, 0, 4, 4, 0, 0, 2, 2, 2, 255)     // flip Y
assert_eq(dump(), "oo##/oo##/##oo/##oo")
// Clipped on all four sides.
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(chk, -2, -2, 8, 8, 0, 0, 2, 2, 0, 255)
assert_eq(dump(), "##oo/##oo/oo##/oo##")
// A degenerate destination or source rectangle is a no-op.
_Canvas.clear(RED)
_Canvas.blit_scaled(chk, 0, 0, 0, 4, 0, 0, 2, 2, 0, 255)
_Canvas.blit_scaled(chk, 0, 0, 4, -1, 0, 0, 2, 2, 0, 255)
_Canvas.blit_scaled(chk, 0, 0, 4, 4, 0, 0, 0, 2, 0, 255)
_Canvas.blit_scaled(999, 0, 0, 4, 4, 0, 0, 2, 2, 0, 255)
assert_eq(dump(), "..../..../..../....")

// alpha: 0 draws nothing, 255 is the plain blit, and in between each channel
// is (src*a + dst*(255-a) + 127) / 255.
_Canvas.init(2, 1)
_Canvas.clear(RED)
_Canvas.blit_scaled(chk, 0, 0, 2, 1, 0, 0, 2, 1, 0, 0)
assert_eq(_Canvas.get_pixel(0, 0), RED)
_Canvas.blit_scaled(chk, 0, 0, 2, 1, 0, 0, 2, 1, 0, 255)
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
_Canvas.clear(RED)
_Canvas.blit_scaled(chk, 0, 0, 2, 1, 0, 0, 2, 1, 0, 128)
assert_eq(_Canvas.get_pixel(0, 0), rgba(127, 0, 128, 255))

// Box averaging (flag 8) only when shrinking. A 4x1 half-blue half-green strip:
let strip = _Canvas.sprite_load([BLUE, BLUE, GREEN, GREEN], 4, 1)
_Canvas.init(2, 1)
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(strip, 0, 0, 2, 1, 0, 0, 4, 1, 8, 255)
assert_eq(_Canvas.get_pixel(0, 0), BLUE)     // each box is one pure colour
assert_eq(_Canvas.get_pixel(1, 0), GREEN)
_Canvas.init(1, 1)
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(strip, 0, 0, 1, 1, 0, 0, 4, 1, 8, 255)
assert_eq(_Canvas.get_pixel(0, 0), rgba(0, 127, 127, 255))   // whole strip averaged
_Canvas.clear(CLEAR)
_Canvas.blit_scaled(strip, 0, 0, 1, 1, 0, 0, 4, 1, 0, 255)   // nearest instead
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
// A transparent source pixel never joins the average, and a wholly transparent
// box leaves the destination alone.
let edge = _Canvas.sprite_load([CLEAR, BLUE, BLUE, BLUE], 4, 1)
_Canvas.clear(RED)
_Canvas.blit_scaled(edge, 0, 0, 1, 1, 0, 0, 4, 1, 8, 255)
assert_eq(_Canvas.get_pixel(0, 0), BLUE)
let hole = _Canvas.sprite_load([CLEAR, CLEAR, CLEAR, CLEAR], 4, 1)
_Canvas.clear(RED)
_Canvas.blit_scaled(hole, 0, 0, 1, 1, 0, 0, 4, 1, 8, 255)
assert_eq(_Canvas.get_pixel(0, 0), RED)

assert_eq(try { _Canvas.blit_scaled(chk, 0, 0, 1, 1, 0, 0, 1, 1, 0, "x") }
          catch e { e.message },
          "type error: parameter 'alpha' expects Long")
assert_eq(try { _Canvas.trapezoid(0, 0, 1, 1, 0, 1, 1.5) } catch e { e.message },
          "type error: parameter 'rgba' expects Long")

// --- host-driven prims: headless returns 0 / no-ops (called for symmetry) ---
assert_eq(_Canvas.buttons(), 0)
assert_eq(_Canvas.mouse_x(), 0)
assert_eq(_Canvas.mouse_y(), 0)
assert_eq(_Canvas.mouse_buttons(), 0)
// tone(start_freq, end_freq, attack, decay, sustain, release, vol, peak,
// channel, duty) — 10 Longs; headless is a no-op but the arity/types must match.
_Canvas.tone(700, 870, 10, 5, 0, 3, 10, 20, 0, 1)
_Canvas.present()

print("canvas ok\n")
