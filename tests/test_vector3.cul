# Conformance: stdlib (Vector3). See docs/stdlib.md and docs/language.md.
#
# Vector3 — a minimal 3D float vector (src/preambles/vector3.cul), the 3D
# counterpart of Vector2. Tested on interp, JIT, and AOT via `just test`;
# identical stdout (asserts are silent on success).

assert_eq(Vector3.new(1, 2, 3).typo, nil)

# --- construction / display ---
let a = Vector3.new(1, 2, 3)
assert_eq(a.x, 1.0)
assert_eq(a.y, 2.0)
assert_eq(a.z, 3.0)
assert_eq("{a}", "(1.0, 2.0, 3.0)")
assert_eq(to_string(a), "(1.0, 2.0, 3.0)")

assert_eq(Vector3.new(1, 2, 3).x, 1.0)
assert_eq(Vector3.new(1.5, 2.5, 3.5).x, 1.5)

# --- operators ---
assert_eq(a + Vector3.new(1, 1, 1), Vector3.new(2, 3, 4))
assert_eq(a - Vector3.new(1, 1, 1), Vector3.new(0, 1, 2))
assert_eq(a * 2, Vector3.new(2, 4, 6))
assert_eq(2 * a, Vector3.new(2, 4, 6))
assert_eq(-a, Vector3.new(-1, -2, -3))

# --- equality: nominal (class tag), never throws on a mismatched type ---
assert_eq(Vector3.new(1, 2, 3) == Vector3.new(1, 2, 3), true)
assert_eq(Vector3.new(1, 2, 3) == Vector3.new(1, 2, 4), false)
assert_eq(Vector3.new(1, 2, 3) == 5, false)
assert_eq(Vector3.new(1, 2, 3) == nil, false)
assert_eq(Vector3.new(1, 2, 3) == {x: 1, y: 2, z: 3}, false)  # structural lookalike

# --- hashable: the derived `hash` that comes with the derived `eq` ---
assert_eq({Vector3.new(1, 2, 3), Vector3.new(1, 2, 3)}.size(), 1)
assert_eq({Vector3.new(1, 2, 3), Vector3.new(1, 2, 4)}.size(), 2)

# --- Vector2 / Vector3 disambiguation: same x/y shape, different class tag.
# The critical correctness case this design was built around (nominal
# match-based __eq__, not a structural `has("x") && has("y")` probe).
assert_eq(Vector2.new(1, 2) == Vector3.new(1, 2, 3), false)
assert_eq(Vector3.new(1, 2, 3) == Vector2.new(1, 2), false)

# --- methods ---
let unit_x = Vector3.new(1, 0, 0)
assert_eq(a.dot(unit_x), 1.0)
assert_eq(Vector3.new(2, 3, 6).length_squared(), 49.0)
assert_eq(Vector3.new(2, 3, 6).length(), 7.0)
assert_eq(
  Vector3.new(2, 3, 6).normalized(),
  Vector3.new(2.0 / 7, 3.0 / 7, 6.0 / 7),
)
assert_close(Vector3.new(2, 3, 6).normalized().length(), 1.0, 1e-9)
assert_eq(Vector3.new(0, 0, 0).distance_to(Vector3.new(2, 3, 6)), 7.0)
assert_eq(Vector3.new(0, 0, 0).distance_squared_to(Vector3.new(2, 3, 6)), 49.0)
assert_eq(Vector3.new(1, 2, 3).distance_squared_to(Vector3.new(1, 2, 3)), 0.0)
# Negative components: the squares must not cancel the offset.
assert_eq(
  Vector3.new(-1, -1, -1).distance_squared_to(Vector3.new(1, 1, 1)),
  12.0,
)

# --- error cases ---
assert_throws("ZeroDivisionError", fn () {
  Vector3.new(0, 0, 0).normalized()
})
assert_throws("TypeError", fn () {
  Vector3.new(1, "x", 2)
})
assert_throws("TypeError", fn () {
  Vector3.new(1, 2, 3) * "x"
})
