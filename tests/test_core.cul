test_special_method_ops = fn () {
  make_box = fn (v) {
    {
      v: v,
      __add__: fn (r) {
        match r {
          n: Long => this.v + n,
          _       => this.v + r.v
        }
      },
      __mul__: fn (r) {
        match r {
          n: Long => this.v * n,
          _       => this.v * r.v
        }
      },
      __sub__: fn (r) { this.v - r.v },
      __neg__: fn ()  { -this.v },
      __pow__: fn (e) { this.v ** e.v },
      __matmul__: fn (r) { this.v * r.v + 1 },
      __eq__:  fn (r) { this.v == r.v },
      __lt__:  fn (r) { this.v <  r.v }
    }
  }
  a = make_box(3)
  b = make_box(4)
  # Arithmetic
  assert_eq(a + b, 7)
  assert_eq(a - b, -1)
  assert_eq(a * b, 12)
  assert_eq(a * 5, 15)
  assert_eq(-a, -3)
  assert_eq(a @ b, 13)
  assert_eq(make_box(2) ** make_box(3), 8)
  # Reflection for commutative ops
  assert_eq(2 + a, 5)
  assert_eq(5 * a, 15)
  # Comparisons (derived __le__ from __lt__ + __eq__)
  assert_eq(a, make_box(3))
  assert_ne(a, b)
  assert_lt(a, b)
  assert_le(a, make_box(3))
  assert_gt(b, a)
  assert_ge(b, make_box(4))
  # Equality reflection
  assert_eq(make_box(3), a)
}

test_special_method_ops()
