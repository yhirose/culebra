test_compound_assign = fn () {
  // Identifier target — every operator on Long.
  mut x = 10
  x += 3;  assert_eq(x, 13)
  x -= 5;  assert_eq(x, 8)
  x *= 4;  assert_eq(x, 32)
  x /= 2;  assert_eq(x, 16)
  x %= 7;  assert_eq(x, 2)
  x **= 4; assert_eq(x, 16)

  // Float promotion via `/=` and `**=`.
  mut f = 9
  f /= 2.0; assert_eq(f, 4.5)
  mut e = 2
  e **= -1; assert_eq(e, 0.5)

  // Array index target.
  mut a = [1, 2, 3]
  a[1] += 10;  assert_true(a[0] == 1 && a[1] == 12 && a[2] == 3)
  a[2] *= 100; assert_eq(a[2], 300)
  a[0] -= 1;   assert_eq(a[0], 0)

  // Object property target (must be `mut` to permit reassignment).
  mut o = {mut count: 5, mut total: 1.0}
  o.count += 2; assert_eq(o.count, 7)
  o.total *= 3; assert_eq(o.total, 3.0)
  o.count -= 7; assert_eq(o.count, 0)
}
test_compound_assign()

// Regression: nested 2D index-assign underflowed inner-array refcount
// under --jit (see compile_assignment in include/jit.h).
test_chained_index_assign_in_nested_loops = fn () {
  mut g = []
  for i in range(3) {
    mut row = []
    for j in range(4) { row.push(0.0) }
    g.push(row)
  }
  for k in range(10) {
    for i in range(3) {
      for j in range(4) {
        g[i][j] = g[i][j] + 0.001
      }
    }
  }
  for i in range(3) {
    for j in range(4) {
      assert_gt(g[i][j], 0.0099)
      assert_lt(g[i][j], 0.0101)
    }
  }
}
test_chained_index_assign_in_nested_loops()

// Equality semantics (spec §16): collections (Array / Object / Tuple /
// Set) compare structurally (by value); Function / Tensor compare by
// identity. #181 — interp previously crashed with "invalid internal
// condition." on Array/Object/Tensor.
fn test_value_equality_semantics() {
  let a = [1, 2]; let b = [1, 2]; let c = a
  assert_true((a == b)); assert_eq(a, c)        // value-equal

  let o1 = {x: 1}; let o2 = {x: 1}; let o3 = o1
  assert_true((o1 == o2)); assert_eq(o1, o3)    // value-equal

  fn add1(x) { x + 1 }
  let f = add1; let g = add1
  assert_eq(f, g)                                // same function

  // Tensor still compares by identity (not structural).
  let t1 = Tensor.zeros(2, 3); let t2 = Tensor.zeros(2, 3); let t3 = t1
  assert_false((t1 == t2)); assert_eq(t1, t3)

  // The original #181 repro: .shape() comparison must not crash.
  let s = t1.shape()
  assert_true((s == [2, 3]))   // structural array equality
  assert_eq(s, s)
  assert_true(s[0] == 2 && s[1] == 3)
}
test_value_equality_semantics()

