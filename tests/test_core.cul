test_special_method_ops = fn () {
  make_box = fn (v) {
    {
      v: v,
      __add__: fn (r) {
        match r {
          n: Long => this.v + n,
          _       => this.v + r.v
        }
      },
      __mul__: fn (r) {
        match r {
          n: Long => this.v * n,
          _       => this.v * r.v
        }
      },
      __sub__: fn (r) { this.v - r.v },
      __neg__: fn ()  { -this.v },
      __pow__: fn (e) { this.v ** e.v },
      __matmul__: fn (r) { this.v * r.v + 1 },
      __eq__:  fn (r) { this.v == r.v },
      __lt__:  fn (r) { this.v <  r.v }
    }
  }
  a = make_box(3)
  b = make_box(4)
  # Arithmetic
  assert(a + b == 7)
  assert(a - b == -1)
  assert(a * b == 12)
  assert(a * 5 == 15)
  assert(-a == -3)
  assert(a @ b == 13)
  assert(make_box(2) ** make_box(3) == 8)
  # Reflection for commutative ops
  assert(2 + a == 5)
  assert(5 * a == 15)
  # Comparisons (derived __le__ from __lt__ + __eq__)
  assert(a == make_box(3))
  assert(a != b)
  assert(a < b)
  assert(a <= make_box(3))
  assert(b > a)
  assert(b >= make_box(4))
  # Equality reflection
  assert(make_box(3) == a)
}

