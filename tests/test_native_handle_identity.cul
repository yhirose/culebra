# What a native handle is, and which resource it reaches, lives in C++, where
# no program can reach it: a handle has no fields to remove or set, and an
# Object that only looks like one is not one. Objects the runtime builds and
# then reads back (a Regex match, a Range) are read only as what it made them.

# A wrapped instance cannot be pointed at another one by an id it is given.
let c1 = __Foreign.Counter.new(1)
let c2 = __Foreign.Counter.new(2)
assert_throws('TypeError', || c1.remove("_id"),
  message: 'a Counter has no fields to remove')
assert_throws('TypeError', fn () { c1._id = 2 },
  message: 'a Counter has no fields to set')
assert_eq(c1.value(), 1)

# Nor read a borrow of another instance through an id it is given (the Box
# and its borrow keep borrow id 1 alive for the forged write to name).
let box = __Foreign.Box.new(7)
let inner = box.inner()
let c3 = __Foreign.Counter.new(3)
assert_throws('TypeError', fn () { c3._bid = 1 },
  message: 'a Counter has no fields to set')
assert_eq(c3.value(), 3)

# A class of the same name is not the wrapped class.
class Counter {
  new(@_id) {}
}
let real = __Foreign.Counter.new(5)
assert_throws('TypeError', || real.merge(Counter.new(1)),
  message: 'not a Counter')

# A child process's pid cannot be rewritten to signal another process.
let p = Proc.spawn(["true"])
assert_throws('TypeError', fn () { p._pid = 1 },
  message: 'a Proc has no fields to set')
p.wait()

# A handle's methods cannot be read off it by subscript, so none is ever
# called without its receiver.
let q = Proc.spawn(["true"])
assert_throws('KeyError', || q["wait"])
q.wait()

# A statement's database cannot be swapped for a number.
let db = SQLite.open(":memory:")
let stmt = db.prepare("select 1")
assert_throws('TypeError', || stmt.remove("__parent__"),
  message: 'a Statement has no fields to remove')
assert_throws('TypeError', fn () { stmt.__parent__ = 7 },
  message: 'a Statement has no fields to set')
assert_eq(stmt.run(), 0)

# A listener's address is the runtime's to write.
let ln = Net.listen(0, host: "127.0.0.1")
assert_throws('TypeError', || ln.remove("port"),
  message: 'a Listener has no fields to remove')
assert_eq(ln.port > 0, true)
ln.close()

# A match's named groups read as nothing once the program replaced them.
let m = re"(?<a>x)".find("x")
m.remove("named")
m.named = 7
assert_eq(m["a"], nil)

# So do its positional groups.
let mg = re"(x)".find("x")
mg.remove("groups")
mg.groups = 5
assert_eq(mg[0], nil)

# A range's step is a Long, whatever the program set there.
let r = 0..3
r.remove("step")
r.step = "s"
assert_throws('TypeError', fn () {
  for i in r {
    i
  }
})

# And so are its bounds, when it is asked what it contains.
let rb = 0..3
rb.remove("start")
rb.start = "a"
assert_throws('TypeError', || rb.contains(1))
