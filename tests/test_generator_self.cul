// `self` and generators: the state-machine lowering runs the body inside
// the synthesized class's methods, so a bare `self` there could only name
// the internal state object — it is rejected at parse time (see
// jit_error_pos_test.sh for the rejection side). This file pins what stays
// LEGAL: non-reference spellings of `self`, nested fn values (whose `self`
// follows their own call shape), and the sanctioned capture idiom.

// A property named `self` is a label, not a reference.
fn g_key() {
  let o = { self: 1 }
  yield o.self
}
assert_eq(g_key().collect()[0], 1)

// A kwarg label named `self` likewise.
fn kw(**opts) { opts["self"] }
fn g_kwarg() { yield kw(self: 5) }
assert_eq(g_kwarg().collect()[0], 5)

// A nested fn value keeps its own dynamic-receiver contract: called as an
// object-literal method, its `self` is that object.
fn g_method() {
  let o = { name: "obj", m: fn () { self.name } }
  yield o.m()
}
assert_eq(g_method().collect()[0], "obj")

// The sanctioned idiom: bind the enclosing receiver outside the generator
// and capture the variable.
class Holder {
  new() { self.tag = "held" }
  run() {
    let me = self
    fn g() { yield me.tag }
    return g().collect()
  }
}
assert_eq(Holder.new().run()[0], "held")

// The word `self` inside string content is untouched.
fn g_str() { yield "self service" }
assert_eq(g_str().collect()[0], "self service")

// --- Promoted locals are storage, not methods -----------------------------
// The lowering moves every body local onto the state object. Reading one back
// must hand out the value itself: binding it would make the state object a
// permanent receiver, which is observable three ways below. Both backends
// agreed with each other even while this was broken, so difftest cannot see
// it — these need value asserts.

fn mk_plain() { return fn () { 1 } }
fn mk_self() { return fn () { self } }

// (1) Identity. A bound wrapper is minted per read, so `f == f` went false.
fn g_identity() {
  let f = mk_plain()
  yield f == f
}
assert_eq(g_identity().collect()[0], true)

// (2) A later receiver still wins. The bind is permanent, so a hijacked `f`
// kept answering with the state object no matter who called it.
fn g_receiver() {
  let f = mk_self()
  let holder = { tag: "holder" }
  holder.f = f
  yield holder.f().tag
}
assert_eq(g_receiver().collect()[0], "holder")

// (3) An already-bound method keeps the receiver it was bound to.
class Box {
  new(v) { self.v = v }
  get_v() { self.v }
}
fn g_bound() {
  let b = Box(7)
  let m = b.get_v
  yield m()
}
assert_eq(g_bound().collect()[0], 7)

// The state class's OWN protocol methods are proto entries, not promoted
// locals, so they still bind: reading one as a value keeps its receiver.
fn g_protocol() { yield 11; yield 22 }
let it = g_protocol()
let read_has_next = it.has_next
let read_next = it.next
assert_eq(read_has_next(), true)
assert_eq(read_next(), 11)
assert_eq(read_next(), 22)
assert_eq(read_has_next(), false)

// An ordinary object is unaffected — a function-valued field still binds the
// object it is read off, and each read is a fresh wrapper.
let obj = { tag: "obj", m: fn () { self.tag } }
assert_eq(obj.m(), "obj")
assert_eq(obj.m == obj.m, false)
let stolen = { tag: "other" }
stolen.m = obj.m
assert_eq(stolen.m(), "obj")

// A user class spelled with a lowering's prefix keeps ordinary binding: the
// state class is recognized by name AND by the `<stem#N>` parse label only a
// re-parsed synthesized source carries, so a user file cannot reach it.
class _Gen_decoy { new() { self.m = fn () { self.tag } } }
let decoy = _Gen_decoy()
assert_eq(decoy.m == decoy.m, false)
let decoy_holder = { tag: "holder" }
decoy_holder.m = decoy.m
assert_eq(decoy_holder.m(), nil)   // still bound to the decoy, which has no tag

println("test_generator_self ok")
