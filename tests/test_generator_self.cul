// `self` and generators: a generator body reads `self` as a plain fn does.
// Declared in a method it is the method's receiver, kept across yields and
// after the method returned; where there is no receiver it is a NameError
// at run time (jit_error_pos_test.sh). This file also pins the non-reference
// spellings of `self`, a fn written as an object property (whose `self` is
// the receiver it is called on), and the capture idiom.

// A property named `self` is a label, not a reference.
fn g_key() {
  let o = {self: 1}
  yield o.self
}
assert_eq(g_key().collect()[0], 1)

// A kwarg label named `self` likewise.
fn kw(**opts) {
  opts["self"]
}
fn g_kwarg() {
  yield kw(self: 5)
}
assert_eq(g_kwarg().collect()[0], 5)

// A nested fn value keeps its own dynamic-receiver contract: called as an
// object-literal method, its `self` is that object.
fn g_method() {
  let o = {name: "obj", m: fn () {
    self.name
  }}
  yield o.m()
}
assert_eq(g_method().collect()[0], "obj")

// The sanctioned idiom: bind the enclosing receiver outside the generator
// and capture the variable.
class Holder {
  new() {
    self.tag = "held"
  }
  run() {
    let me = self
    fn g() {
      yield me.tag
    }
    return g().collect()
  }
}
assert_eq(Holder.new().run()[0], "held")

// A generator declared in a method reads the method's receiver, as a plain
// fn declared there does.
class Reader {
  new() {
    self.tag = "held"
    self.items = [1, 2, 3]
  }
  walk() {
    fn g() {
      for x in self.items {
        yield "{self.tag}{x}"
      }
    }
    return g().collect()
  }
  // through a closure written in the body
  via_closure() {
    fn g() {
      let f = fn () {
        self.tag
      }
      yield f()
      yield f()
    }
    return g().collect()
  }
  // the generator outlives the call that made it, and writes through `self`
  later() {
    fn g() {
      yield self.tag
      self.tag = "changed"
      yield self.tag
    }
    return g()
  }
  // closing it runs a defer that reads `self`
  closes() {
    fn g() {
      defer {
        self.tag = "closed"
      }
      yield 1
      yield 2
    }
    for v in g() {
      break
    }
    return self.tag
  }
}
assert_eq(Reader.new().walk(), ["held1", "held2", "held3"])
assert_eq(Reader.new().via_closure(), ["held", "held"])
let reader = Reader.new()
let reader_gen = reader.later()
assert_eq(reader_gen.next(), "held")
assert_eq(reader_gen.next(), "changed")
assert_eq(reader.tag, "changed")
assert_eq(Reader.new().closes(), "closed")

// With no receiver around it, `self` is as undefined in a generator as in a
// plain fn.
fn g_no_receiver() {
  yield self
}
fn p_no_receiver() {
  self
}
assert_throws("NameError", fn () {
  p_no_receiver()
})
assert_throws("NameError", fn () {
  g_no_receiver().collect()
})

// The word `self` inside string content is untouched.
fn g_str() {
  yield "self service"
}
assert_eq(g_str().collect()[0], "self service")

fn mk_plain() {
  return fn () {
    1
  }
}
fn mk_self() {
  return fn () {
    self
  }
}

// A function from OUTSIDE, called bare in the body, is called the way a bare
// call is called anywhere: with no receiver. (When a generator was lowered to
// a state class the local lived on the state object, and the call once
// arrived as a method with that object as `self`.)
fn g_bare() {
  let f = mk_self()
  yield try {
    f()
    "no error"
  } catch e {
    e.kind
  }
}
fn plain_bare() {
  let f = mk_self()
  return try {
    f()
    "no error"
  } catch e {
    e.kind
  }
}
assert_eq(g_bare().collect()[0], "NameError")
assert_eq(g_bare().collect()[0], plain_bare())  // same as outside a generator

// ...and an ordinary local call is untouched by that rewrite, including one
// spelled inside an interpolation.
fn g_local_calls() {
  let add = fn (a, b) {
    a + b
  }
  let mk = fn () {
    [1, 2]
  }
  yield add(2, 3)
  yield mk().size()
  yield "one and one is {add(1, 1)}"
}
assert_eq(g_local_calls().collect(), [5, 2, "one and one is 2"])

// --- A body's locals are values, not methods ------------------------------
// When a generator was lowered to a state class its locals lived on the state
// object, and reading one back had to hand out the value itself: binding it
// made the state object a permanent receiver, which showed three ways below.
// A body that keeps its frame has plain locals; these hold it to that. Both
// backends agreed with each other even while this was broken, so difftest
// cannot see it — these need value asserts.

// (1) Identity. A bound wrapper is minted per read, so `f == f` went false.
fn g_identity() {
  let f = mk_plain()
  yield f == f
}
assert_eq(g_identity().collect()[0], true)

// (2) A later receiver still wins. The bind is permanent, so a hijacked `f`
// kept answering with the state object no matter who called it.
fn g_receiver() {
  let f = mk_self()
  let holder = {tag: "holder"}
  holder.f = f
  yield holder.f().tag
}
assert_eq(g_receiver().collect()[0], "holder")

// (3) An already-bound method keeps the receiver it was bound to.
class Box {
  new(v) {
    self.v = v
  }
  get_v() {
    self.v
  }
}
fn g_bound() {
  let b = Box(7)
  let m = b.get_v
  yield m()
}
assert_eq(g_bound().collect()[0], 7)

// A generator's own protocol methods bind: reading one as a value keeps its
// receiver.
fn g_protocol() {
  yield 11
  yield 22
}
let it = g_protocol()
let read_has_next = it.has_next
let read_next = it.next
assert_eq(read_has_next(), true)
assert_eq(read_next(), 11)
assert_eq(read_next(), 22)
assert_eq(read_has_next(), false)

// An ordinary object is unaffected — a function-valued field still binds the
// object it is read off, and each read is a fresh wrapper.
let obj = {tag: "obj", m: fn () {
  self.tag
}}
assert_eq(obj.m(), "obj")
assert_eq(obj.m == obj.m, false)
let stolen = {tag: "other"}
stolen.m = obj.m
assert_eq(stolen.m(), "obj")

// A user class spelled with the effect lowering's prefix keeps ordinary
// binding: a state class is recognized by name AND by the `<stem#N>` parse
// label only a re-parsed synthesized source carries, so a user file cannot
// reach it.
class _EffBody_decoy {
  new() {
    self.m = fn () {
      self.tag
    }
  }
}
let decoy = _EffBody_decoy()
assert_eq(decoy.m == decoy.m, false)
let decoy_holder = {tag: "holder"}
decoy_holder.m = decoy.m
assert_eq(decoy_holder.m(), nil)  // still bound to the decoy, which has no tag

println("test_generator_self ok")
