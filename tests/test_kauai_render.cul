# Kauai's render(from:, to:): a part of a song, as the whole song
# sounds there (docs/kauai/language.md, section 10), built from only the
# external sounds the part plays. Rendering needs no device, and the test
# harness keeps it closed (CULEBRA_AUDIO=off).

let lines = |xs| xs.join("\n")
let DUO = lines([
  'band Duo {',
  '  voice Tune  pulse(gap=2) plays melody            vol 20',
  '  voice Bass  triangle  plays roots in E2..D#3  vol 30',
  '  drum Kick   noise(freq=120 len=1)  vol 20',
  '}',
  'groove Walk {',
  '  Bass  1 - 5 -',
  '  Kick  x... ....',
  '}',
])

# A part of the song, each end a mark's name or seconds, heard from a second
# before `from`, rising from silence over it as half a cosine, until what
# starts before `to` ends. The song is mixed from its top all the same, so
# from `from` until `to` it is the whole song's samples. Three bars of two
# seconds, with a mark before the second and the third.
let parted = Kauai.new(lines([
  DUO,
  'song First {', '  tempo 120', '  band Duo', '  groove Walk', '  melody in C5..B5',
  '  Verse', '  mark Second', '  Verse', '  mark Third', '  Verse', '}',
  'section Verse {',
  "  C     e4 .g \\f !c'2",
  '}',
]))
assert_eq(parted.marks(), {Second: 2.0, Third: 4.0})
# In a function of its own, so that the samples do not stay for the rest of
# the file: every collection under a collection at every allocation walks
# what is kept.
let parts = fn () {
  let whole = parted.render()
  let part = parted.render(from: "Second", to: "Third")
  assert_eq(parted.render(from: 2, to: 4.0), part)
  # A point is a mark's name or seconds, or a String of seconds or of minutes
  # and seconds, as `kauai --from` takes it; seconds() reads one.
  assert_eq(
    [parted.seconds("Third"), parted.seconds("0:02.5"), parted.seconds("3"), parted.seconds(1)],
    [4.0, 2.5, 3.0, 1.0],
  )
  assert_eq(parted.render(from: "0:02", to: "4"), part)
  for bad in ["1:5", "0:60", "2.", "1:", ":30"] {
    assert_throws("ValueError", fn () { parted.seconds(bad) })
  }
  let unmarked = try {
    parted.seconds("Fourth")
  } catch e: ValueError {
    e.message
  }
  assert_eq(unmarked, "Kauai: the song has no mark Fourth (it has Second, Third)")
  assert_eq(part.slice(44100, 3 * 44100), whole.slice(2 * 44100, 4 * 44100))
  let lead = part.slice(0, 44100)
  assert_eq(lead, iota(44100).map(|i| whole[44100 + i] * (0.5 - 0.5 * Math.cos(Math.pi * i / 44100))))
  assert_true(part.size() >= 3 * 44100 && part.size() < 3.1 * 44100)
  # A second before the top is the top; without `from` there is no lead, and
  # past the end `to` is the end.
  let early = parted.render(from: 0.5)
  assert_eq(early.size(), whole.size())
  assert_eq(early.slice(22050, whole.size()), whole.slice(22050, whole.size()))
  assert_eq(early[0], 0.0)
  assert_eq(parted.render(to: "Second").slice(0, 2 * 44100), whole.slice(0, 2 * 44100))
  assert_eq(parted.render(to: 60), whole)
  assert_throws("ValueError", fn () { parted.render(from: "Fourth") })
  assert_throws("ValueError", fn () { parted.render(from: -1) })
  assert_throws("ValueError", fn () { parted.render(from: 6) })
  assert_throws("ValueError", fn () { parted.render(from: "Third", to: "Second") })
  assert_throws("ValueError", fn () { parted.render(to: 0) })
}
parts()

# A part builds only the external sounds it plays: those that start before
# `to` and play notes from a second before `from` on, a phrase that runs into
# it whole, and the note each voice is weighed by (65, the middle of the
# fiddle's pitches). What prepare() has left is the rest.
let WAV = Encoding.hex.decode("524946462800000057415645666d7420100000000100010040" +
  "1f0000401f000001000800646174610400000080c8803c")
let said = |n| n.keys().map(|k| "{k} {n[k]}").join(", ")
let phrase_said = |notes| notes.map(said).join(" / ")
let SPREAD = lines([
  'band Strings {',
  '  voice Fiddle  Fiddle           plays melody  vol 50',
  '}',
  'song Bow {', '  tempo 60', '  band Strings', '  melody in C4..B4',
  '  First', '  mark Second', '  Second', '  mark Third', '  Third', '}',
  'section First {', '  C  (c4 d) e8 r8 r4', '}',
  'section Second {', '  C  (f4 g) a r', '}',
  'section Third {', '  C  b4 r r r', '}',
])
let bowed = fn () {
  let asked = []
  let fiddle = {
    phrase: fn (notes, params) {
      asked.push(phrase_said(notes))
      Audio.Sound.new(WAV)
    },
    hears: [],
  }
  (Kauai.new(SPREAD, voices: {fiddle: fiddle}), asked)
}
let second_only = ['pitch 65, at 0.0', 'pitch 65, at 0.0 / pitch 67, at 1.0', 'pitch 69, at 0.0']
let (bowing, bowed_notes) = bowed()
bowing.render(from: "Second", to: "Third")
assert_eq(bowed_notes.sorted(), second_only)
assert_eq(bowing.prepare(), 2)
let (crossing, crossed_notes) = bowed()
crossing.render(from: 6.0, to: 7.5)
assert_eq(crossed_notes.sorted(), second_only)

# external_sounds() lists the sounds render() builds for the part, in the
# order they start: where each starts and its notes end, who plays it, its
# instrument, and what the instrument is handed, which is what it is called
# with (and the note it is weighed by besides).
let handed = []
let listing = Kauai.new(SPREAD, voices: {
  fiddle: {
    phrase: fn (notes, params) {
      handed.push(JSON.stringify([notes, params]))
      Audio.Sound.new(WAV)
    },
    hears: ["len"],
  },
})
let listed = listing.external_sounds(from: "Second", to: "Third")
assert_eq(
  listed.map(|s| [s.at, s.until, s.by, s.external]),
  [[4.0, 6.0, "Fiddle", "fiddle"], [6.0, 7.0, "Fiddle", "fiddle"]],
)
assert_eq(listed.map(|s| s.args[0].map(|n| n.pitch)), [[65, 67], [69]])
assert_eq(listing.external_sounds().map(|s| s.at), [0.0, 2.0, 4.0, 6.0, 8.0])
# Its own copy: changing it changes nothing Kauai builds.
listed[0].args[1]["bow"] = 1.0
listing.render(from: "Second", to: "Third")
assert_eq(handed.size(), 3)
assert_true(handed.all(|h| !h.contains("bow")))
assert_true(listing.external_sounds(from: "Second", to: "Third").all(|s| handed.contains(JSON.stringify(s.args))))
assert_throws("ValueError", fn () { listing.external_sounds(from: "Fourth") })
assert_throws("ValueError", fn () { listing.external_sounds(from: 2, to: 1) })

# A knob may be named `keys`, `has` or `get`, like any word: it is read by
# its name, on a band's line and in a score's direction, and an instrument
# the program gives is handed it, whether it plays a note or a phrase.
let named = |voices| Kauai.new(lines([
  'band Named {',
  '  voice Tune  Ep(keys=1 has=2) plays melody  vol 20',
  '}',
  'song Named {', '  tempo 120', '  band Named', '  melody in C5..B5', '  Part', '}',
  'section Part {',
  '  C  \keys=3 c4 d \get=4 e f',
  '}',
]), voices: voices)
let words = ["keys", "has", "get"].map(|n| (n, {default: 0.0, min: 0.0, max: 10.0})).to_object()
let handed_note = named({ep: {note: |pitch, params| nil, knobs: words}}).external_sounds().map(|s| s.args[1])
assert_eq(handed_note.size(), 4)
assert_eq(handed_note[0]["keys"], 3.0)
assert_eq(handed_note[0]["has"], 2.0)
assert_eq(handed_note[3]["get"], 4.0)
let handed_phrase = named({ep: {phrase: |notes, params| nil, hears: ["len"], knobs: words}}).external_sounds().map(|s| s.args[1])
assert_eq(handed_phrase.size(), 4)
assert_eq(handed_phrase[0]["keys"], 3.0)
assert_eq(handed_phrase[0]["has"], 2.0)

print("kauai render ok\n")
