// Comparison chaining: `a < b < c` means `(a < b) && (b < c)`, with
// each middle operand evaluated once and short-circuit on first false
// (Python semantics).

let x = 5
assert_eq(0 < x, true)
assert_eq(0 < x < 10, true)
assert_eq(0 < x < 3, false)        // x < 3 fails
assert_eq(10 < x < 20, false)      // 10 < x fails first
assert_eq(1 <= x <= 5, true)
assert_eq(5 <= x <= 5, true)
assert_eq(3 < x < 10 < 20, true)   // chain of three
assert_eq(1 < 2 < 3 < 2, false)

// Mixed comparison operators in one chain.
assert_eq(1 < 2 == 2, true)        // (1 < 2) && (2 == 2)
assert_eq(5 > 3 > 1, true)
assert_eq(1 == 1 == 1, true)

// Single comparison unchanged.
assert_eq(5 == 5, true)
assert_eq(5 != 6, true)
assert_eq(2 < 3, true)

// Middle operand evaluated exactly once.
mut calls = 0
fn mid() { calls = calls + 1; 5 }
assert_eq(0 < mid() < 10, true)
assert_eq(calls, 1)

// Short-circuit: operands after the first false are not evaluated.
mut hits = 0
fn boom() { hits = hits + 1; 99 }
assert_eq(10 < 5 < boom(), false)
assert_eq(hits, 0)

IO.inspect("test_compare_chain OK")
