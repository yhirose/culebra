// Conformance: stdlib §8 (JSON). See docs/stdlib.md and docs/language.md §25.
//
// JSON.stringify / JSON.parse round-trip (Phase 8-C — JIT binding added).

let v = {name: "alice", age: 30, active: true, score: 3.14, parent: nil}
let s = JSON.stringify(v)
let v2 = JSON.parse(s)
assert_eq(v2.name, "alice")
assert_eq(v2.age, 30)
assert_eq(v2.active, true)
assert_eq(v2.score, 3.14)
assert_eq(v2.parent, nil)

// Insertion order preserved in stringify
let o = {b: 2, a: 1, c: 3}
let s2 = JSON.stringify(o)
assert_eq(s2, '{"b":2,"a":1,"c":3}')

// Array round-trip
let arr = [1, "two", 3.0, true, nil]
let p = JSON.parse(JSON.stringify(arr))
assert_eq(p[0], 1)
assert_eq(p[1], "two")
assert_eq(p[2], 3.0)

// Nested
let nested = JSON.parse('{"a":[1,2,{"b":"c"}]}')
assert_eq(nested.a[2].b, "c")

// --- Pretty stringify ---
let pretty = JSON.stringify({a: 1, b: [2, 3]}, 2)
// The pretty output round-trips back to the same logical value.
let pp = JSON.parse(pretty)
assert_eq(pp.a, 1)
assert_eq(pp.b[0], 2)
assert_eq(pp.b[1], 3)

// --- Tuple → JSON array ---
let tup = (1, 2, 3)
assert_eq(JSON.stringify(tup), JSON.stringify([1, 2, 3]))

// --- Set → JSON array (insertion order) ---
let st = {7, 8, 9}
assert_eq(JSON.stringify(st), JSON.stringify([7, 8, 9]))

// Empty collections. Single quotes dodge culebra's `"{}"` string
// interpolation, which treats braces as an embedded expression.
let empty_arr = []
let empty_obj = {}
assert_eq(JSON.stringify(empty_arr), '[]')
assert_eq(JSON.stringify(empty_obj), '{}')

// --- H cycle: kwargs API (indent / sort_keys / lines / number_mode) ---

// kwargs form: equivalent to the legacy positional indent
let pretty_kw = JSON.stringify({a: 1, b: 2}, indent: 2)
assert_eq(pretty_kw, JSON.stringify({a: 1, b: 2}, 2))

// sort_keys: deterministic alphabetical order regardless of insertion
let sorted = JSON.stringify({z: 1, a: 2, m: 3}, sort_keys: true)
assert_eq(sorted, '{"a":2,"m":3,"z":1}')
let sorted_pretty = JSON.stringify({b: 1, a: 2}, indent: 2, sort_keys: true)
let sorted_pretty_expected = JSON.stringify({a: 2, b: 1}, indent: 2)
assert_eq(sorted_pretty, sorted_pretty_expected)

// JSON Lines round-trip
let xs = [1, 'two', {x: 3}, true, nil]
let jsonl = JSON.stringify(xs, lines: true)
let parsed_lines = JSON.parse(jsonl, lines: true)
assert_eq(parsed_lines.size(), 5)
assert_eq(parsed_lines[0], 1)
assert_eq(parsed_lines[1], 'two')
assert_eq(parsed_lines[2].x, 3)

// Empty-array JSONL → "" (no terminating newline; lines == 0).
assert_eq(JSON.stringify([], lines: true), '')
assert_eq(JSON.parse('', lines: true).size(), 0)

// Dynamic Bool for `lines` (variable, not literal). The JIT path
// resolves at runtime, so this exercises the non-constant slot.
let do_lines = true
assert_eq(JSON.stringify([1, 2], lines: do_lines), "1\n2\n")
let do_lines_off = false
assert_eq(JSON.stringify([1, 2], lines: do_lines_off), '[1,2]')

// number_mode: 'float' forces every number to Float
let n_auto = JSON.parse('1')
assert_eq(n_auto, 1)
let n_float = JSON.parse('1', number_mode: 'float')
assert_eq(n_float, 1.0)
let arr_float = JSON.parse('[1, 2.5, 3]', number_mode: 'float')
assert_true(arr_float[0] == 1.0 && arr_float[2] == 3.0)

// Literal Object splat works on both backends.
let pretty_splat = JSON.stringify({a: 1, b: 2}, **{indent: 2})
assert_eq(pretty_splat, JSON.stringify({a: 1, b: 2}, indent: 2))

// Dynamic `**variable` splat against the built-in dispatch (Option Y
// kwarg adapter). Pre-Option Y this was JIT-rejected; now both
// backends enumerate the runtime Object's keys.
let str_opts = {indent: 2, sort_keys: true}
let dyn_pretty = JSON.stringify({z: 1, a: 2}, **str_opts)
assert_eq(dyn_pretty, JSON.stringify({z: 1, a: 2}, indent: 2, sort_keys: true))

let mixed = JSON.stringify({x: 1}, **{sort_keys: true}, indent: 4)
assert_eq(mixed, JSON.stringify({x: 1}, indent: 4, sort_keys: true))

let parse_opts = {number_mode: 'float'}
assert_eq(JSON.parse('1', **parse_opts), 1.0)

let line_opts = {lines: true}
let parsed = JSON.parse("1\n2\n3\n", **line_opts)
assert_true(parsed.size() == 3 && parsed[0] == 1)

// Unknown kwarg via dynamic splat — catchable at runtime on both
// backends (compile-time path's literal splats throw before catch in
// JIT, but the runtime adapter throws after entry).
let bad = {bogus: 1}
let r = try { JSON.stringify({a: 1}, **bad); nil } catch e { e }
assert_true(r.kind == 'TypeError' && r.message.contains('bogus'))

// --- Full signature symmetry: positional / multi-positional / as-value ------
// Both backends route stringify/parse through the one canonical resolver, so
// every call shape (extra positionals, kwargs, **splats, as a value) binds
// like the interp. (The JIT used to special-case a 1-positional fast path and
// rejected the rest with an ArityError.)

// `indent` / `sort_keys` / `lines` bind positionally after the value.
assert_eq(JSON.stringify([2, 1], 0, true), '[2,1]')      # sort_keys positional
assert_eq(JSON.parse("[1, 2]"), [1, 2])
// `lines` is the 2nd positional of parse (Bool); a non-Bool is a type error
// at that argument, naming the param — same kind/message/wording on both.
let pe = try { JSON.parse("[1]", 2); nil } catch e { e }
assert_eq(pe.kind, 'TypeError')
assert_eq(pe.message, "type error: parameter 'lines' expects Bool")
// `lines: true` as a positional Bool works (JSON Lines mode).
assert_eq(JSON.parse("1\n2\n", true), [1, 2])

// As a first-class value, with positional and keyword extras alike.
let strfy = JSON.stringify
assert_eq(strfy({a: 1}, 2), strfy({a: 1}, indent: 2))    # 2nd positional == indent:
let parse = JSON.parse
assert_eq(parse("[1, 2]", number_mode: "float"), [1.0, 2.0])
// A wrong-typed kwarg through the value path is the interp's typed-param error.
let ae = try { strfy({a: 1}, indent: "no"); nil } catch e { e }
assert_eq(ae.kind, 'TypeError')
assert_eq(ae.message, "type error: parameter 'indent' expects Long")
// An invalid `number_mode` is a ValueError on both backends (the JIT used to
// silently treat any non-"float" value as "auto").
let nme = try { JSON.parse("[1]", number_mode: "bogus"); nil } catch e { e }
assert_eq(nme.kind, 'ValueError')
assert_true(nme.message.contains("number_mode must be 'auto' or 'float'"))

// --- JSONC: comments + trailing commas via `jsonc: true` --------------------
// Existing JSONC config files (tsconfig.json, VSCode settings) carry `//` and
// `/* */` comments plus trailing commas; `jsonc: true` tolerates them while
// strict JSON (the default) keeps rejecting them.
let jc = `{
  // line comment
  "name": "culebra",   // trailing on a line
  /* block
     comment */
  "nums": [1, 2, 3,],  // trailing comma in array
  "nested": { "ok": true, },
}`
let jo = JSON.parse(jc, jsonc: true)
assert_eq(jo.name, "culebra")
assert_eq(jo.nums, [1, 2, 3])
assert_eq(jo.nested.ok, true)

// `//` and `/*` inside a string stay literal (skip_ws only runs between tokens).
let js = JSON.parse(`{"url": "http://x", /* c */ "n": 42}`, jsonc: true)
assert_eq(js.url, "http://x")
assert_eq(js.n, 42)

// Plain JSON parses unchanged with jsonc: true.
assert_eq(JSON.parse(`{"a":1}`, jsonc: true).a, 1)

// Strict mode (default) rejects comments and trailing commas as ValueError.
let sc = try { JSON.parse(jc); nil } catch e { e }
assert_eq(sc.kind, 'ValueError')
let tc = try { JSON.parse("[1, 2,]"); nil } catch e { e }
assert_eq(tc.kind, 'ValueError')

// `jsonc` binds positionally too (s, lines, number_mode, jsonc).
assert_eq(JSON.parse("[1, /* c */ 2,]", false, "auto", true), [1, 2])

// Exact wording + position pins for the parser/stringify error surface.
// The logic is single-sourced in json.h; these keep kind, message, and
// 1-based line:col identical across interp/JIT/AOT.
let pe1 = try { JSON.parse(`{"a" 1}`); nil } catch e { e }
assert_true(pe1.kind == 'ValueError' &&
       pe1.message == "JSON.parse: expected ':'" &&
       pe1.line == 1 && pe1.col == 6)
let pe2 = try { JSON.parse("[1,\n 2,,]"); nil } catch e { e }  // error on line 2
assert_true(pe2.kind == 'ValueError' &&
       pe2.message == 'JSON.parse: expected value' &&
       pe2.line == 2 && pe2.col == 4)
let pe3 = try { JSON.parse(`"a\q"`); nil } catch e { e }
assert_true(pe3.kind == 'ValueError' && pe3.message == 'JSON.parse: bad escape')
let pe4 = try { JSON.parse("[1"); nil } catch e { e }
assert_true(pe4.kind == 'ValueError' &&
       pe4.message == "JSON.parse: expected ',' or ']'")
let pe5 = try { JSON.parse("1 x"); nil } catch e { e }
assert_true(pe5.kind == 'ValueError' &&
       pe5.message == 'JSON.parse: trailing characters' &&
       pe5.line == 1 && pe5.col == 3)
let se1 = try { JSON.stringify(to_float("inf")); nil } catch e { e }
assert_true(se1.kind == 'ValueError' &&
       se1.message == 'JSON.stringify: non-finite Float')
let nsk = {}
nsk[(1, 2)] = "x"
let se2 = try { JSON.stringify(nsk); nil } catch e { e }
assert_true(se2.kind == 'TypeError' &&
       se2.message == 'JSON.stringify: Object has non-String keys')
let se3 = try { JSON.stringify(fn() { 1 }); nil } catch e { e }
assert_true(se3.kind == 'TypeError' &&
       se3.message == 'JSON.stringify: cannot serialize Function')

IO.inspect("test_json OK")
