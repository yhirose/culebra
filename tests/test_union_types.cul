// Conformance: Union types in parameter and return annotations.
// Phase 1 of [[project-type-system]] (Rust/Swift V-Subset).

// --- Param Union accepts either alternative ---
fn show(x: Long | Float) -> String {
  to_string(x)
}
assert(show(1) == "1")
assert(show(2.5) == "2.5")

// --- Whitespace tolerance: no space, one space, multi-space ---
fn shape_a(x: Long|Float) -> Long { 1 }
fn shape_b(x: Long  |  Float) -> Long { 2 }
assert(shape_a(1) == 1)
assert(shape_a(1.5) == 1)
assert(shape_b(2) == 2)

// --- Return-type Union (just a permissive annotation, no narrowing) ---
fn lookup(k: String) -> Long | Nil {
  if k == "answer" { 42 } else { nil }
}
assert(lookup("answer") == 42)
assert(lookup("missing") == nil)

// --- Class instances in Union ---
class Square {
  new (s) { this.side = s }
}
class Circle {
  new (r) { this.r = r }
}
fn area(shape: Square | Circle) -> Float {
  match shape {
    sq: Square => to_float(sq.side) * to_float(sq.side),
    c:  Circle => to_float(c.r) * to_float(c.r) * 3.14,
  }
}
assert(area(Square.new(3)) == 9.0)
let circle_area = area(Circle.new(2))
assert(circle_area > 12.0 && circle_area < 13.0)

// --- Non-matching type still raises a dispatch/type error ---
mut caught = ""
try {
  show("not a number")
} catch e {
  caught = e.kind
}
// multifn dispatcher: no method match → DispatchError (both backends).
assert(caught == "DispatchError")

// --- Single-alternative still works (regression check) ---
fn single(x: Long) { x }
assert(single(7) == 7)

// --- Union in `match` arm (`n: Long | Float => ...`) ---
fn classify(v) {
  match v {
    n: Long | Float => "number",
    s: String => "string",
    _ => "other",
  }
}
assert(classify(1) == "number")
assert(classify(2.5) == "number")
assert(classify("hi") == "string")
assert(classify(nil) == "other")

// --- PATTERN outer `|` vs TYPE_ANNOTATION inner `|` ---
// TYPE_ANNOTATION closes at the first non-Type alt; lowercase
// identifiers and literals fall back to PATTERN outer alternation.
fn boundary(v) {
  match v {
    // Parses as ((n: Long | Float) | 42 | 'zero').
    n: Long | Float | 42 | 'zero' => "matched",
    _ => "other",
  }
}
assert(boundary(1) == "matched")
assert(boundary(1.5) == "matched")
assert(boundary(42) == "matched")
assert(boundary('zero') == "matched")
assert(boundary('other') == "other")
assert(boundary(nil) == "other")

// --- fn.params surfaces the canonical Union string ---
let ps = show.params
assert(ps[0].type == "Long | Float")

// Whitespace variants in source still canonicalize to the same form.
fn no_space(x: Long|Float) { x }
fn many_space(x: Long  |   Float) { x }
assert(no_space.params[0].type == "Long | Float")
assert(many_space.params[0].type == "Long | Float")

// Duplicate alternatives collapse (first-occurrence order kept).
fn dup_alt(x: Long | Long) { x }
fn dup_alt2(x: Float | Long | Float) { x }
assert(dup_alt.params[0].type == "Long")
assert(dup_alt2.params[0].type == "Float | Long")

// Concrete type outranks a Union that includes it.
fn pick(x: Long) -> String { "concrete" }
fn pick(x: Long | Float) -> String { "union" }
assert(pick(1) == "concrete")
assert(pick(1.5) == "union")

// Union outranks bare `Object` when arg is in the Union (Object is
// class-instance catch-all only; primitives go through the Union).
class Holder {
  new (v) { this.value = v }
}
fn rank(x: Object) -> String { "object" }
fn rank(x: Long | Float) -> String { "union" }
assert(rank(1) == "union")
assert(rank(Holder.new(0)) == "object")

// Object as sole option: primitives do NOT slip through Object catch
// (multifn pick agrees with check_type → DispatchError on no match,
// not a spurious TypeError after a false-positive pick).
fn only_object(x: Object) -> String { "object" }
let e = try { only_object("hi"); nil } catch e { e }
assert(e.kind == "DispatchError")
assert(only_object(Holder.new(0)) == "object")
assert(only_object({a: 1}) == "object")

// Whitespace-variant redecl overwrites instead of growing the table.
fn dedup(x: Long|Float) -> String { "first" }
fn dedup(x: Long | Float) -> String { "second" }
assert(dedup(1) == "second")
assert(dedup(1.5) == "second")

IO.puts("test_union_types OK")
