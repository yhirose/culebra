// Conformance: stdlib §Http. See docs/stdlib.md and docs/language.md.
//
// Http namespace — synchronous HTTP/HTTPS client.
// Tests run on interp, JIT, and AOT via `just test`; identical stdout.
// The happy paths (200/POST/headers) need a live server, so they live in
// the deterministic in-process loopback test test/http_test.cc. Here we
// cover only the offline-deterministic paths — URL validation, kwarg type
// errors, and connection refused — which exercise the namespace and the
// error-object construction identically across all three backends.

// What a call raised, as "Kind: message".
fn failure(thunk) {
  try {
    thunk()
    'no error'
  } catch e {
    "{e.kind}: {e.message}"
  }
}

// --- URL validation: a missing scheme is an HttpError, not a crash ---
assert_eq(
  failure(|| Http.get("example.com")),
  'HttpError: Http.get: Http: URL must include a scheme (http:// or https://): example.com',
)

// Http.request shares the same validation, tagged with its own context.
assert_eq(
  failure(|| Http.request("PATCH", "example.com")),
  'HttpError: Http.request: Http: URL must include a scheme (http:// or https://): example.com',
)

// --- headers kwarg: must be an Object of String (checked before any I/O) ---
assert_eq(
  failure(|| Http.get("http://127.0.0.1:1", headers: "nope")),
  'TypeError: Http.get: headers must be an Object of String',
)

assert_eq(
  failure(|| Http.get("http://127.0.0.1:1", headers: {X: 1})),
  'TypeError: Http.get: header values must be String',
)

// --- transport failure: connection refused surfaces as HttpError ---
// Port 1 is never listening, so connect() fails immediately and offline.
assert_throws("HttpError", fn () {
  Http.get("http://127.0.0.1:1/x")
})

// POST shares the failure model.
assert_throws("HttpError", fn () {
  Http.post("http://127.0.0.1:1/x", body: "data")
})

// --- `into:` streaming sink: offline-deterministic error paths (happy paths
//     need a server, covered by the in-process loopback test http_test.cc) ---

// into: a String path that can't be opened is an IOError (before any I/O).
assert_throws("IOError", fn () {
  Http.get("http://127.0.0.1:1/x", into: "tmp/_no_such_dir_/f")
})

// into: anything but nil / String / Function is a TypeError (before any I/O).
assert_throws("TypeError", fn () {
  Http.get("http://127.0.0.1:1/x", into: 123)
})

// into: a callback still surfaces a transport failure as HttpError.
assert_throws("HttpError", fn () {
  Http.get("http://127.0.0.1:1/x", into: fn (c) { nil })
})

// --- `body:` streaming source (upload): offline-deterministic error paths.
//     Happy path (chunked upload echoed back) is in http_test.cc. ---

// body: must be a String or a producer Function (checked before any I/O).
assert_throws("TypeError", fn () {
  Http.post("http://127.0.0.1:1/x", body: 123)
})

// body: a producer Function + transport failure still surfaces as HttpError.
assert_throws("HttpError", fn () {
  Http.post("http://127.0.0.1:1/x", body: fn () { nil })
})

// --- `params:` query string: offline-deterministic error paths (the encoding
//     round-trip is in http_test.cc). ---

// params: must be an Object (of String values).
assert_throws("TypeError", fn () {
  Http.get("http://127.0.0.1:1/x", params: 123)
})

// params: a non-String value is a TypeError.
assert_throws("TypeError", fn () {
  Http.get("http://127.0.0.1:1/x", params: {n: 5})
})

// --- `json:` send / `r.json()`: the round-trip is verified e2e against a local
//     echo server; here, the offline-deterministic checks. ---

// json: and body: together is a TypeError (checked before any I/O).
assert_throws("TypeError", fn () {
  Http.post("http://127.0.0.1:1/x", body: "x", json: {a: 1})
})

// json: alone serializes (then a transport failure surfaces as HttpError).
assert_throws("HttpError", fn () {
  Http.post("http://127.0.0.1:1/x", json: {a: 1})
})

// --- `form:` (application/x-www-form-urlencoded): offline error paths. The
//     encoding round-trip is verified e2e. ---

// form: must be an Object of String values.
assert_throws("TypeError", fn () {
  Http.post("http://127.0.0.1:1/x", form: "nope")
})
assert_throws("TypeError", fn () {
  Http.post("http://127.0.0.1:1/x", form: {n: 5})
})

// at most one of body / json / form.
assert_throws("TypeError", fn () {
  Http.post("http://127.0.0.1:1/x", body: "x", form: {a: "1"})
})

// --- `files:` (multipart/form-data): offline-deterministic error paths. The
//     part framing + streaming round-trip is verified e2e against a local echo
//     server; here, the kwarg type/shape errors and the failure model. ---

// files: must be an Object of parts.
assert_eq(
  failure(|| Http.post("http://127.0.0.1:1/x", files: "nope")),
  'TypeError: Http.post: files must be an Object',
)

// a part value must be a String, Object, or Array.
assert_eq(
  failure(|| Http.post("http://127.0.0.1:1/x", files: {a: 1})),
  "TypeError: Http.post: files['a'] must be a String, Object, or Array",
)

// a part Object needs exactly one of content / path / stream. The count check
// runs before any field type-check (so a wrong-typed second source still
// reports "needs exactly one", not a per-field error) — verified symmetric.
assert_eq(
  failure(|| Http.post("http://127.0.0.1:1/x", files: {a: {filename: "x"}})),
  "TypeError: Http.post: files['a'] needs exactly one of content, path, stream",
)
assert_eq(
  failure(|| Http.post("http://127.0.0.1:1/x", files: {a: {content: 1, path: "y"}})),
  "TypeError: Http.post: files['a'] needs exactly one of content, path, stream",
)

// content / path must be a String — the message names the part and the field
// (interp/JIT must agree exactly, so assert the full text, not just the kind).
assert_eq(
  failure(|| Http.post("http://127.0.0.1:1/x", files: {a: {content: 1}})),
  "TypeError: Http.post: files['a'].content must be a String",
)

assert_eq(
  failure(|| Http.post("http://127.0.0.1:1/x", files: {a: {path: 9}})),
  "TypeError: Http.post: files['a'].path must be a String",
)

// stream must be a Function (producer).
assert_eq(
  failure(|| Http.post("http://127.0.0.1:1/x", files: {a: {stream: 1}})),
  "TypeError: Http.post: files['a'].stream must be a Function (producer)",
)

// path that can't be opened is an IOError (before any I/O).
assert_throws("IOError", fn () {
  Http.post("http://127.0.0.1:1/x", files: {a: {path: "_no_such_dir_/f"}})
})

// files: and body: together is a TypeError (at most one of body/json/form/files).
assert_throws("TypeError", fn () {
  Http.post("http://127.0.0.1:1/x", body: "x", files: {a: "b"})
})

// a valid in-memory part + transport failure still surfaces as HttpError.
assert_throws("HttpError", fn () {
  Http.post("http://127.0.0.1:1/x", files: {a: "b"})
})

// --- `Http.sse` (Server-Sent Events): offline-deterministic paths. The event
//     stream itself needs a server (SseDecoder is unit-tested in http_test.cc);
//     here, the error model. ---

// on_event is required: calling without it is an ArityError before any I/O.
assert_throws("ArityError", fn () {
  Http.sse("http://127.0.0.1:1/x")
})

// a transport failure surfaces as HttpError (same as the other verbs).
assert_throws("HttpError", fn () {
  Http.sse("http://127.0.0.1:1/x", fn (e) {
    nil
  })
})

// --- `Http.client` (persistent connection-reusing client): offline error
//     paths. The base_url join / header merge / reuse round-trips need a server
//     (covered by the in-process loopback test http_test.cc); here, the error
//     model and the per-method kwarg type errors (tagged with a client.* ctx). ---

// a bad base_url (no scheme) fails to open with an HttpError.
assert_eq(
  failure(|| Http.client("example.com")),
  'HttpError: Http.client: Http: URL must include a scheme (http:// or https://): example.com',
)

// a transport failure on a client request surfaces as HttpError (dead port).
let cl = Http.client("http://127.0.0.1:1")
assert_throws("HttpError", fn () {
  cl.get("/x")
})

// a client method's headers kwarg must be an Object of String (client.* ctx).
assert_eq(
  failure(|| cl.get("/x", headers: "nope")),
  'TypeError: client.get: headers must be an Object of String',
)
assert_eq(
  failure(|| cl.get("/x", headers: {X: 1})),
  'TypeError: client.get: header values must be String',
)

// params likewise.
assert_eq(
  failure(|| cl.get("/x", params: 1)),
  'TypeError: client.get: params must be an Object of String',
)

// at most one of body / json / form / files on a client post (client.post ctx).
assert_eq(
  failure(|| cl.post("/x", body: "y", json: {a: 1})),
  'TypeError: client.post: pass at most one of body, json, form, files',
)

// `path` is a typed String param: a StringView (e.g. a slice) is rejected, the
// same as the free Http.* functions' typed url (interp/JIT must agree).
let cl_pathstr = "/abc"
assert_eq(
  failure(|| cl.get(cl_pathstr[0..2])),
  "TypeError: type error: parameter 'path' expects String",
)

// a closed client errors cleanly (no crash) on further use.
cl.close()
assert_eq(
  failure(|| cl.get("/x")),
  'HttpError: client.get: Http: client is closed',
)

inspect("test_http: ok")
