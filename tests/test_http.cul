// Conformance: stdlib §Http. See docs/stdlib.md and docs/language.md.
//
// Http namespace — synchronous HTTP/HTTPS client.
// Tests run on interp, JIT, and AOT via `just test`; identical stdout.
// The happy paths (200/POST/headers) need a live server, so they live in
// the deterministic in-process loopback test test/http_test.cc. Here we
// cover only the offline-deterministic paths — URL validation, kwarg type
// errors, and connection refused — which exercise the namespace and the
// error-object construction identically across all three backends.

// --- URL validation: a missing scheme is an HttpError, not a crash ---
let no_scheme = try { Http.get("example.com"); nil } catch e { e }
assert_eq(no_scheme.kind, "HttpError")
assert_eq(no_scheme.message,
    "Http.get: Http: URL must include a scheme (http:// or https://): example.com")

// Http.request shares the same validation, tagged with its own context.
let req_no_scheme = try { Http.request("PATCH", "example.com"); nil } catch e { e }
assert_eq(req_no_scheme.kind, "HttpError")
assert_eq(req_no_scheme.message,
    "Http.request: Http: URL must include a scheme (http:// or https://): example.com")

// --- headers kwarg: must be an Object of String (checked before any I/O) ---
let bad_headers = try { Http.get("http://127.0.0.1:1", headers: "nope"); nil } catch e { e }
assert_eq(bad_headers.kind, "TypeError")
assert_eq(bad_headers.message, "Http.get: headers must be an Object of String")

let bad_header_val = try { Http.get("http://127.0.0.1:1", headers: {X: 1}); nil } catch e { e }
assert_eq(bad_header_val.kind, "TypeError")
assert_eq(bad_header_val.message, "Http.get: header values must be String")

// --- transport failure: connection refused surfaces as HttpError ---
// Port 1 is never listening, so connect() fails immediately and offline.
let refused = try { Http.get("http://127.0.0.1:1/x"); nil } catch e { e }
assert_eq(refused.kind, "HttpError")

// POST shares the failure model.
let refused_post = try { Http.post("http://127.0.0.1:1/x", body: "data"); nil } catch e { e }
assert_eq(refused_post.kind, "HttpError")

// --- `into:` streaming sink: offline-deterministic error paths (happy paths
//     need a server, covered by the in-process loopback test http_test.cc) ---

// into: a String path that can't be opened is an IOError (before any I/O).
let into_badpath = try { Http.get("http://127.0.0.1:1/x", into: "tmp/_no_such_dir_/f"); nil } catch e { e }
assert_eq(into_badpath.kind, "IOError")

// into: anything but nil / String / Function is a TypeError (before any I/O).
let into_badtype = try { Http.get("http://127.0.0.1:1/x", into: 123); nil } catch e { e }
assert_eq(into_badtype.kind, "TypeError")

// into: a callback still surfaces a transport failure as HttpError.
let into_refused = try { Http.get("http://127.0.0.1:1/x", into: fn (c) { nil }); nil } catch e { e }
assert_eq(into_refused.kind, "HttpError")

// --- `body:` streaming source (upload): offline-deterministic error paths.
//     Happy path (chunked upload echoed back) is in http_test.cc. ---

// body: must be a String or a producer Function (checked before any I/O).
let body_badtype = try { Http.post("http://127.0.0.1:1/x", body: 123); nil } catch e { e }
assert_eq(body_badtype.kind, "TypeError")

// body: a producer Function + transport failure still surfaces as HttpError.
let body_refused = try { Http.post("http://127.0.0.1:1/x", body: fn () { nil }); nil } catch e { e }
assert_eq(body_refused.kind, "HttpError")

// --- `params:` query string: offline-deterministic error paths (the encoding
//     round-trip is in http_test.cc). ---

// params: must be an Object (of String values).
let params_badtype = try { Http.get("http://127.0.0.1:1/x", params: 123); nil } catch e { e }
assert_eq(params_badtype.kind, "TypeError")

// params: a non-String value is a TypeError.
let params_badval = try { Http.get("http://127.0.0.1:1/x", params: {n: 5}); nil } catch e { e }
assert_eq(params_badval.kind, "TypeError")

// --- `json:` send / `r.json()`: the round-trip is verified e2e against a local
//     echo server; here, the offline-deterministic checks. ---

// json: and body: together is a TypeError (checked before any I/O).
let json_and_body = try { Http.post("http://127.0.0.1:1/x", body: "x", json: {a: 1}); nil } catch e { e }
assert_eq(json_and_body.kind, "TypeError")

// json: alone serializes (then a transport failure surfaces as HttpError).
let json_refused = try { Http.post("http://127.0.0.1:1/x", json: {a: 1}); nil } catch e { e }
assert_eq(json_refused.kind, "HttpError")

puts("test_http: ok")
