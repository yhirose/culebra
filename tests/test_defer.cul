// Conformance: §15 (defer, scope-guard pattern). See docs/language.md §25.
//
// Defer semantics: scope-level and function-level, normal exit and
// throw exit. Dual-backend. User `throw v` binds the caught `e`
// directly to `v` (no auto-Error wrap for non-Error user values).
//
// Test uses a mut String trace so we don't depend on Array concat,
// keeping the assertion-comparison logic minimal.

mut log = ''

# Scope-level defer on throw (already worked — sanity baseline)
let r1 = try {
  {
    defer {
      log = "{log}scope-defer;"
    }
    throw 'sx'
  }
  nil
} catch e {
  e
}
assert_eq(r1, 'sx')
assert_eq(log, 'scope-defer;')

# Function-level defer on normal exit
log = ''
let f_normal = fn () {
  defer {
    log = "{log}fn-defer;"
  }
  log = "{log}body;"
  42
}
assert_eq(f_normal(), 42)
assert_eq(log, 'body;fn-defer;')

# Function-level defer on throw exit. JIT previously skipped these —
# the cleanup landingpad introduced in this cycle restores parity
# with the interp.
log = ''
let f_throw = fn () {
  defer {
    log = "{log}fn-defer;"
  }
  throw 'boom'
}
let r2 = try {
  f_throw()
  nil
} catch e {
  e
}
assert_eq(r2, 'boom')
assert_eq(log, 'fn-defer;')

# Multiple fn-level defers run in LIFO on throw
log = ''
let f_multi = fn () {
  defer {
    log = "{log}A;"
  }
  defer {
    log = "{log}B;"
  }
  defer {
    log = "{log}C;"
  }
  throw 'multi'
}
let r3 = try {
  f_multi()
  nil
} catch e {
  e
}
assert_eq(r3, 'multi')
assert_eq(log, 'C;B;A;')

# Mixed: fn-level + nested scope-level, throw from inside the nested
# scope. Inner defers run first, then outer.
log = ''
let f_mixed = fn () {
  defer {
    log = "{log}outer;"
  }
  {
    defer {
      log = "{log}inner;"
    }
    throw 'mixed'
  }
}
let r4 = try {
  f_mixed()
  nil
} catch e {
  e
}
assert_eq(r4, 'mixed')
assert_eq(log, 'inner;outer;')

# A try body is its own defer scope: its defers fire when the block
# closes (before any code after the try), not at function exit. The JIT
# used to treat them as function-level and ran them at frame exit.
log = ''
let f_try_scope = fn () {
  try {
    defer {
      log = "{log}try-defer;"
    }
    log = "{log}body;"
  } catch _ {
    log = "{log}caught;"
  }
  log = "{log}after;"
  nil
}
f_try_scope()
assert_eq(log, 'body;try-defer;after;')

# Same for the catch body: its defers fire when the handler closes.
log = ''
let f_catch_scope = fn () {
  try {
    throw 'cx'
  } catch _ {
    defer {
      log = "{log}catch-defer;"
    }
    log = "{log}handler;"
  }
  log = "{log}after;"
  nil
}
f_catch_scope()
assert_eq(log, 'handler;catch-defer;after;')

# On a caught throw the try body's defers run before the catch body
# (interp's run_deferred(tryEnv) fires between the two blocks).
log = ''
try {
  defer {
    log = "{log}d1;"
  }
  {
    defer {
      log = "{log}d2;"
    }
    throw 'tx'
  }
} catch _ {
  log = "{log}caught;"
}
assert_eq(log, 'd2;d1;caught;')

# A defer throwing at the try body's NORMAL exit escapes its own catch
# (interp runs run_deferred(tryEnv) outside the try/catch pair).
log = ''
let r5 = try {
  try {
    defer {
      throw 'dboom'
    }
    'ok'
  } catch _ {
    log = "{log}inner-caught;"
    'inner'
  }
} catch e {
  log = "{log}outer-caught;"
  e
}
assert_eq(r5, 'dboom')
assert_eq(log, 'outer-caught;')

# break / continue run the defers of a nested lexical scope they jump
# out of, even when the loop body itself declares none. The JIT used to
# consult only the body's own mark and skipped (leaked) these.
log = ''
while true {
  log = "{log}iter;"
  {
    defer {
      log = "{log}scope-d;"
    }
    break
  }
}
assert_eq(log, 'iter;scope-d;')

log = ''
for i in 0..3 {
  {
    defer {
      log = "{log}d{i};"
    }
    if i == 1 {
      continue
    }
    log = "{log}b{i};"
  }
}
assert_eq(log, 'b0;d0;d1;b2;d2;')

IO.inspect('test_defer OK')
