// Conformance: stdlib PEG — errors, the two depth bounds, and packrat.
// A grammar or a subject that is wrong is not an error raised: `load_grammar`
// and `parse` answer false and the logger is told why, as in cpp-peglib.
// Positions are offsets into the grammar or the subject, not into this
// source.

let calc = `
  Additive       <- Multiplicative '+' Additive / Multiplicative
  Multiplicative <- Primary '*' Multiplicative / Primary
  Primary        <- '(' Additive ')' / Number
  Number         <- < [0-9]+ >
  %whitespace    <- [ \t\r\n]*
`

// What the logger is told for `text`, each error as "line:col: msg". Packrat
// is on: without it `calc` takes time exponential in how deep `text` nests.
fn errors_of(grammar, text) {
  let parser = PEG.parser(grammar)
  parser.enable_packrat_parsing()
  let mut said = []
  parser.set_logger(|line, col, msg| said.push("{line}:{col}: {msg}"))
  assert_eq(parser.parse(text), (false, nil))
  said
}

// --- a syntax error in the subject ---
let e = errors_of(calc, "1 +")
assert_eq(e.size(), 1)
assert_true(e[0].starts_with("1:4: syntax error"))

// --- with no logger a failure says nothing more than false ---
assert_eq(PEG.parser(calc).parse("1 +"), (false, nil))

// --- what a failure expected is listed whole, a control character among it
// spelled as its escape; at the end of the input a rule named with a leading
// underscore stays out ---
assert_eq(errors_of(`
  List  <- '[' _ Item (_ ',' _ Item)* _ ']'
  Item  <- < [0-9]+ >
  ~_    <- (Space / EOL)*
  Space <- ' ' / '\t'
  EOL   <- '\n'
`, "[1, 2"), ["1:6: syntax error, expecting ' ', '\\t', '\\n', ',' or ']'."])
assert_eq(errors_of(`
  List   <- '[' _ Item (_ ',' _ Item)* _ ']'
  Item   <- < [0-9]+ >
  ~_     <- (_Space / _EOL)*
  _Space <- ' ' / '\t'
  _EOL   <- '\n'
`, "[1, 2"), ["1:6: syntax error, expecting ',' or ']'."])

// --- a malformed grammar: load_grammar answers false and the logger is told
// where in the grammar, at load and not at the first parse ---
let bad = PEG.parser()
let mut grammar_errors = []
bad.set_logger(|line, col, msg| grammar_errors.push([line, col, msg]))
assert_false(bad.load_grammar("Bad <- ***"))
assert_eq(grammar_errors.size(), 1)
assert_eq(grammar_errors[0].slice(0, 2), [1, 8])
assert_true(grammar_errors[0][2].contains("syntax error"))

// A parser whose grammar did not load parses nothing, and says nothing.
grammar_errors = []
assert_eq(bad.parse("x"), (false, nil))
assert_eq(grammar_errors, [])

// The form that takes the grammar has no logger yet to tell, like
// cpp-peglib's constructor: the parser is just one that parses nothing.
assert_eq(PEG.parser("Bad <- ***").parse("x"), (false, nil))

// --- an undefined start rule ---
assert_false(bad.load_grammar(calc, "Nope"))
assert_true(grammar_errors[0][2].contains("start rule 'Nope' is undefined"))

// --- every error of a grammar is told, not only the first ---
grammar_errors = []
assert_false(bad.load_grammar(`
  A <- B C
`))
assert_eq(grammar_errors.map(|g| g[2]).sorted(), ["'B' is not defined.", "'C' is not defined."])

// --- a grammar that loads can still be warned about; the logger is told on
// every load, the same ---
for round in 0..2 {
  grammar_errors = []
  assert_true(bad.load_grammar(`
    A <- 'a'
    B <- 'b'
  `))
  assert_eq(grammar_errors.map(|g| g[2]), ["'B' is not referenced."])
}
assert_eq(bad.parse("a"), (true, nil))

let deep_subject = "(".repeat(20000) + "1" + ")".repeat(20000)

// --- machine-written nesting is a failed parse, not a crash: it hits the
// rule-nesting bound the front end uses for culebra's own grammar ---
let deep = errors_of(calc, deep_subject)
assert_eq(deep.size(), 1)
assert_true(deep[0].ends_with("nesting too deep (limit 4000)"))

// The bound is per parse, so the same grammar still parses after one input
// went past it.
assert_eq(PEG.parser(calc).parse("1 + 2"), (true, nil))

// The bound is told to the logger even after an error that `%recover` got
// past.
let recovering = `
  S   <- (L / ERR)*
  L   <- A ';'
  A   <- '(' A ')' / [0-9]
  ERR <- 'x'^bad
  bad <- (!';' .)* ';'
`
let after_recovery = "1;?;" + "(".repeat(5000) + "1" + ")".repeat(5000) + ";"
let recovered = errors_of(recovering, after_recovery)
assert_true(recovered.size() > 1)
assert_true(recovered[recovered.size() - 1].ends_with("nesting too deep (limit 4000)"))

// A tree deeper than the rule-nesting bound fails the parse too, though a
// left-recursive chain parses without nesting.
let chain = PEG.parser(`
  Sum <- Sum '+' Num / Num
  Num <- < [0-9] >
`)
chain.enable_ast()
let mut chain_errors = []
chain.set_logger(|line, col, msg| chain_errors.push(msg))
assert_eq(chain.parse("1" + "+1".repeat(5000)), (false, nil))
assert_eq(chain_errors, ["nesting too deep (limit 4000)"])

// --- a tree deeper than the value-nesting bound is a ValueError, the same
// bound (and message) JSON.parse applies to its own trees ---
let tall_parser = PEG.parser(calc)
tall_parser.enable_ast()
tall_parser.enable_packrat_parsing()
let tall = try {
  tall_parser.parse("(".repeat(1100) + "1" + ")".repeat(1100))
} catch err {
  err
}
assert_eq(tall.kind, "ValueError")
assert_true(tall.message.contains("nesting too deep (limit 1000)"))

// --- `path` names the subject for the callbacks; the logger is told the
// position and the message, and the program puts the name to them ---
let named = PEG.parser(calc)
let mut named_errors = []
let report = fn (path) {
  |line, col, msg| named_errors.push("{path}:{line}:{col}: {msg}")
}
named.set_logger(report("prog.pas"))
named.parse("1 +", "prog.pas")
assert_true(named_errors[0].starts_with("prog.pas:1:4: syntax error"))

// --- packrat is off until enable_packrat_parsing(), as in cpp-peglib. It is
// what keeps a grammar whose alternatives share a prefix from backtracking
// exponentially: with it, enter runs once per position; without it, once per
// attempt ---
fn primaries(packrat) {
  let parser = PEG.parser(calc)
  if packrat {
    parser.enable_packrat_parsing()
  }
  let mut entered = 0
  parser["Primary"].enter = |c, s, n| entered += 1
  assert_eq(parser.parse("((((1))))"), (true, nil))
  entered
}
assert_eq(primaries(true), 5)
assert_true(primaries(false) > 100)

// It goes with the grammar: loading another one turns it off again.
let memo = PEG.parser(calc)
memo.enable_packrat_parsing()
memo.load_grammar(calc)
let mut memo_entered = 0
memo["Primary"].enter = |c, s, n| memo_entered += 1
memo.parse("((((1))))")
assert_true(memo_entered > 100)

// --- argument types are checked like any other native row ---
assert_eq(try { PEG.parser(calc).parse(42) } catch err { err.kind }, "TypeError")
assert_eq(try { PEG.parser(42) } catch err { err.kind }, "TypeError")
assert_eq(try { PEG.parser().load_grammar(42) } catch err { err.kind }, "TypeError")

// --- what the cpp-peglib-shaped API replaced is gone, not kept beside it ---
assert_eq(try { PEG.compile } catch err { err.kind }, "AttributeError")
assert_eq(try { PEG.check } catch err { err.kind }, "AttributeError")
assert_eq(try { PEG.test } catch err { err.kind }, "AttributeError")
assert_eq(try { PEG.str } catch err { err.kind }, "AttributeError")
assert_eq(PEG.parser(calc).test, nil)

// --- the namespace is closed: an unknown member raises rather than reading
// as nil (docs/language.md, "Namespaces are closed") ---
assert_eq(try { PEG.zzz } catch err { err.kind }, "AttributeError")
