// Conformance: stdlib PEG — errors, the two depth bounds, and packrat.
// Grammar and subject positions live in the message (they are offsets into
// user data, not into this source), so the assertions read the text.

let calc = `
  Additive       <- Multiplicative '+' Additive / Multiplicative
  Multiplicative <- Primary '*' Multiplicative / Primary
  Primary        <- '(' Additive ')' / Number
  Number         <- < [0-9]+ >
  %whitespace    <- [ \t\r\n]*
`

// --- a syntax error in the subject ---
let e = try {
  PEG.parse(calc, "1 +")
} catch err {
  err
}
assert_eq(e.kind, "PEGError")
assert_true(e.message.starts_with("PEG: 1:4:"))
assert_true(e.message.contains("syntax error"))

// --- what a failure expected is listed whole, a control character among it
// spelled as its escape; at the end of the input a rule named with a leading
// underscore stays out ---
let spaced = try {
  PEG.parse(`
    List  <- '[' _ Item (_ ',' _ Item)* _ ']'
    Item  <- < [0-9]+ >
    ~_    <- (Space / EOL)*
    Space <- ' ' / '\t'
    EOL   <- '\n'
  `, "[1, 2")
} catch err {
  err
}
assert_eq(spaced.message, "PEG: 1:6: syntax error, expecting ' ', '\\t', '\\n', ',' or ']'.")
let unspaced = try {
  PEG.parse(`
    List   <- '[' _ Item (_ ',' _ Item)* _ ']'
    Item   <- < [0-9]+ >
    ~_     <- (_Space / _EOL)*
    _Space <- ' ' / '\t'
    _EOL   <- '\n'
  `, "[1, 2")
} catch err {
  err
}
assert_eq(unspaced.message, "PEG: 1:6: syntax error, expecting ',' or ']'.")

// --- a malformed grammar reports a position inside the grammar ---
let g = try {
  PEG.compile("Bad <- ***")
} catch err {
  err
}
assert_eq(g.kind, "PEGError")
assert_true(g.message.starts_with("PEG: grammar:"))

// --- an undefined start rule ---
let s = try {
  PEG.compile(calc, "Nope")
} catch err {
  err
}
assert_eq(s.kind, "PEGError")
assert_true(s.message.contains("start rule 'Nope' is undefined"))

// --- compile-time validation happens at compile, not at first parse ---
assert_eq(try { PEG.check("Bad <- ***") } catch err { err.kind }, "PEGError")
assert_eq(PEG.check(calc), nil)

let deep_subject = "(".repeat(20000) + "1" + ")".repeat(20000)

// --- errors are catchable, not a crash: machine-written nesting hits the
// rule-nesting bound the front end uses for culebra's own grammar ---
let deep = try {
  PEG.parse(calc, deep_subject)
} catch err {
  err
}
assert_eq(deep.kind, "PEGError")
assert_true(deep.message.contains("nesting too deep"))

// The bound is per parse, so the same grammar still parses after one input
// went past it.
assert_eq(PEG.parse(calc, "1 + 2").name, "Additive")

// PEG.test reports too deep a subject as an error, not as a mismatch, even
// after an error that `%recover` got past.
let deep_test = try {
  PEG.test(calc, deep_subject)
} catch err {
  err
}
assert_eq(deep_test.kind, "PEGError")
assert_true(deep_test.message.contains("nesting too deep (limit 4000)"))

let recovering = `
  S   <- (L / ERR)*
  L   <- A ';'
  A   <- '(' A ')' / [0-9]
  ERR <- 'x'^bad
  bad <- (!';' .)* ';'
`
let after_recovery = "1;?;" + "(".repeat(5000) + "1" + ")".repeat(5000) + ";"
let recovered_test = try { PEG.test(recovering, after_recovery) } catch err { err }
assert_eq(recovered_test.kind, "PEGError")
assert_true(recovered_test.message.contains("nesting too deep (limit 4000)"))
let recovered_parse = try { PEG.parse(recovering, after_recovery) } catch err { err }
assert_true(recovered_parse.message.contains("nesting too deep (limit 4000)"))

// A tree deeper than the rule-nesting bound is a PEGError too, though a
// left-recursive chain parses without nesting.
let chain = `
  Sum <- Sum '+' Num / Num
  Num <- < [0-9] >
`
let long_chain = try { PEG.parse(chain, "1" + "+1".repeat(5000)) } catch err { err }
assert_eq(long_chain.kind, "PEGError")
assert_true(long_chain.message.contains("nesting too deep (limit 4000)"))

// --- a tree deeper than the value-nesting bound is a ValueError, the same
// bound (and message) JSON.parse applies to its own trees ---
let tall = try {
  PEG.parse(calc, "(".repeat(1100) + "1" + ")".repeat(1100), "", false)
} catch err {
  err
}
assert_eq(tall.kind, "ValueError")
assert_true(tall.message.contains("nesting too deep (limit 1000)"))

// --- naming the subject (PEG.parse's / p.parse's `path`) replaces the
// generic "PEG: " prefix with the name, the way any other compiler
// diagnostic reads -- one parser, many files, so it is a per-parse
// argument rather than something set once at compile time ---
let named = try {
  PEG.parse(calc, "1 +", path: "prog.pas")
} catch err {
  err
}
assert_true(named.message.starts_with("prog.pas:1:4:"))
assert_true(named.message.contains("syntax error"))

// A grammar-compile error is about the grammar text, not a subject document,
// so it keeps the "PEG: grammar:" form regardless of `path` -- there is no
// `path` parameter on `check`/`compile` to name one.
assert_true(g.message.starts_with("PEG: grammar:"))

// The nesting bound's message honors `path` too -- it is a subject
// position like any other.
let deep_named = try {
  PEG.parse(calc, deep_subject, path: "deep.pas")
} catch err {
  err
}
assert_true(deep_named.message.starts_with("deep.pas:"))
assert_true(deep_named.message.contains("nesting too deep"))

// `path` does not leak from one parse() call to the next, or into test():
// each call reflects only its own argument.
let p = PEG.compile(calc)
let first = try { p.parse("1 +", "first.pas") } catch err { err }
assert_true(first.message.starts_with("first.pas:1:4:"))
let unnamed = try { p.parse("1 +") } catch err { err }
assert_true(unnamed.message.starts_with("PEG: 1:4:"))

// --- packrat: on by default, and the default is what keeps a grammar whose
// alternatives share a prefix from backtracking exponentially. Off is
// available for inputs where the memo table costs more than the search.
assert_true(PEG.test(calc, "((((((((((1))))))))))"))
assert_true(PEG.test(calc, "1 + 1", "", false))
assert_eq(PEG.parse(calc, "1 + 1", "", true, false).name, "Additive")
assert_eq(PEG.compile(calc, "", true, false).parse("2").token, "2")

// --- argument types are checked like any other native row ---
assert_eq(try { PEG.parse(calc, 42) } catch err { err.kind }, "TypeError")
assert_eq(try { PEG.compile(42) } catch err { err.kind }, "TypeError")

// --- the namespace is closed: an unknown member raises rather than reading
// as nil (docs/language.md, "Namespaces are closed") ---
assert_eq(try { PEG.zzz } catch err { err.kind }, "AttributeError")
