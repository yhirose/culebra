# Static asset serving via `srv.static(mount, Dir.embedded(...))`. Run from
# source (this suite), Dir.embedded reads the live on-disk directory relative to
# the entry script; under an AOT build the same call serves a baked-in table.
# The server is started with listen_async (serves on a background thread);
# stop() halts it.

srv = Http.server()
srv.static("/", Dir.embedded("embed_assets"))
srv.get("/api/ok", fn (req) {
  {content_type: "application/json", body: '{"ok":true}'}
})
# Port 0: the OS picks a free one (so a concurrent gate cannot take it) and
# listen_async hands the number back.
PORT = srv.listen_async(0)
BASE = "http://127.0.0.1:" + PORT.to_string()

# index.html at the mount root, with inferred content type
r = Http.get(BASE + "/")
assert_eq(r.status, 200)
assert_eq(r.headers["Content-Type"], "text/html; charset=utf-8")
assert_eq(r.body.contains("<h1>It works</h1>"), true)
# a named asset
js = Http.get(BASE + "/app.js")
assert_eq(js.status, 200)
assert_eq(js.headers["Content-Type"], "text/javascript; charset=utf-8")
# a registered route still wins over a missing static file (static tried first, misses)
api = Http.get(BASE + "/api/ok")
assert_eq([api.status, api.body], [200, '{"ok":true}'])
# a missing file falls through to 404
miss = Http.get(BASE + "/nope.css")
assert_eq(miss.status, 404)
srv.stop()

# srv.static knows a Dir.embedded by its class, not by its shape or its name:
# a class of the program's own called EmbedDir, with the same field, is not one.
class EmbedDir {
  new(@name) {}
}
let other = Http.server()
let static_err = try {
  other.static("/", EmbedDir("embed_assets"))
} catch e {
  e
}
assert_eq(static_err.kind, 'TypeError')
assert_eq(static_err.message, 'server.static: dir must be a String path or a Dir')

# A Dir.embedded made here and sent to an isolate is still one there.
let assets = Dir.embedded("embed_assets")
let (tx, rx) = Channel.new(1)
let iso = Isolate.spawn(fn () {
  let s = Http.server()
  s.static("/", assets)
  tx.send(s.bind(0))
  tx.drop()
  s.serve()
})
tx.drop()
let port = rx.recv()
let js2 = Http.get("http://127.0.0.1:" + port.to_string() + "/app.js")
assert_eq(js2.status, 200)
iso.drop()
