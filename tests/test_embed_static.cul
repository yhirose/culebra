# Static asset serving via `srv.static(mount, Embed.dir(...))`. Run from source
# (this suite), Embed.dir reads the live on-disk directory relative to the entry
# script; under an AOT build the same call serves a baked-in table. Output is
# identical across interp/JIT (no random / timing values printed). The server is
# started with listen_async (serves on a background thread); stop() halts it.

PORT = 18877
BASE = "http://127.0.0.1:" + PORT.to_string()

srv = Http.server()
srv.static("/", Embed.dir("embed_assets"))
srv.get("/api/ok", fn(req) { { content_type: "application/json", body: '{"ok":true}' } })
srv.listen_async(PORT)   # returns immediately (bind is synchronous)

# index.html at the mount root, with inferred content type
r = Http.get(BASE + "/")
inspect("GET / -> " + r.status.to_string() + " | ct=" + r.headers["Content-Type"] +
     " | h1=" + r.body.contains("<h1>It works</h1>").to_string())
# a named asset
js = Http.get(BASE + "/app.js")
inspect("GET /app.js -> " + js.status.to_string() + " | ct=" + js.headers["Content-Type"])
# a registered route still wins over a missing static file (static tried first, misses)
api = Http.get(BASE + "/api/ok")
inspect("GET /api/ok -> " + api.status.to_string() + " | " + api.body)
# a missing file falls through to 404
miss = Http.get(BASE + "/nope.css")
inspect("GET /nope.css -> " + miss.status.to_string())
srv.stop()
inspect("server stopped")
