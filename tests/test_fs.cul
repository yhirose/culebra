// Conformance: stdlib §3 (FS). See docs/stdlib.md and docs/language.md §25.
//
// FS namespace — path manipulation, queries, dir/file ops.
// Tests run on interp, JIT, and AOT via `just test`; identical stdout.

// --- Path manipulation ---
assert_eq(FS.join("a", "b", "c.txt"), "a{FS.sep()}b{FS.sep()}c.txt")
assert_eq(FS.join("/usr", "local", "bin"), "/usr{FS.sep()}local{FS.sep()}bin")
assert_eq(FS.join(), "")
assert_eq(FS.join("only"), "only")

assert_eq(FS.basename("a/b/c.txt"), "c.txt")
assert_eq(FS.basename("c.txt"), "c.txt")
assert_eq(FS.basename("/"), "")

assert_eq(FS.dirname("a/b/c.txt"), "a/b")
assert_eq(FS.dirname("c.txt"), "")

assert_eq(FS.extension("a/b/c.txt"), ".txt")
assert_eq(FS.extension("noext"), "")
assert_eq(FS.extension(".hidden"), "")  // C++ filesystem treats leading-dot files as no-extension

assert_eq(FS.stem("a/b/c.txt"), "c")
assert_eq(FS.stem("c.txt"), "c")
assert_eq(FS.stem("noext"), "noext")

// --- Queries: use the running test directory as a known-good path ---
// Sys.argv[0] is the first arg passed after `--`. The test harness
// runs us without args, so we synthesize a path via Sys.env if
// available; otherwise we just exercise non-existent paths.
let bogus = "/definitely/not/a/real/path/xyzzy"
assert_eq(FS.exists(bogus), false)
assert_eq(FS.is_file(bogus), false)
assert_eq(FS.is_dir(bogus), false)

// A directory guaranteed to exist, cross-platform (`/tmp` is a POSIX
// assumption that Windows does not meet).
assert_eq(FS.exists(FS.temp_dir()), true)
assert_eq(FS.is_dir(FS.temp_dir()), true)
assert_eq(FS.is_file(FS.temp_dir()), false)

// --- temp_dir / mkdtemp ---
// Where this machine puts scratch files. Reported without a trailing
// separator (Windows' GetTempPath supplies one), so FS.join off it does not
// double one — a path that ends in a separator has an empty basename.
assert_true(FS.is_dir(FS.temp_dir()))
assert_true(FS.basename(FS.temp_dir()) != "")

// Every path below hangs off one mkdtemp: a fixed name under the shared temp
// dir is what makes two checkouts running the suite at once walk into each
// other's tree. The directory is created rather than named, so no two runs
// can pick the same one — not even two seeded the same way.
let tmp_root = FS.mkdtemp("culebra_fs_test_")
assert_true(FS.is_dir(tmp_root))
assert_eq(FS.dirname(tmp_root), FS.temp_dir())
assert_true(FS.basename(tmp_root).starts_with("culebra_fs_test_"))
let second = FS.mkdtemp("culebra_fs_test_")
assert_true(second != tmp_root)
FS.remove(second)

// The prefix names a directory, not a path: a parent that doesn't exist is
// an error rather than a silent mkdir -p.
assert_throws("IOError", fn () {
  FS.mkdtemp("culebra_fs_no_such_dir/x")
})
assert_throws("TypeError", fn () {
  FS.mkdtemp(42)
})

// --- Round-trip: mkdir / write / size / list / remove ---
let dir = FS.join(tmp_root, "round")
let f1 = FS.join(dir, "hello.txt")
let f2 = FS.join(dir, "world.txt")

FS.mkdir(dir)
assert_true(FS.is_dir(dir))

FS.write(f1, "hi\n")
FS.write(f2, "longer content here")

assert_true(FS.is_file(f1))
assert_eq(FS.size(f1), 3)
assert_eq(FS.size(f2), 19)

// A String is a byte string, so FS.write writes ALL of it — embedded NULs are
// content, not a terminator. (The JIT used to strlen the buffer here and
// truncate every binary write to its first NUL, while interp wrote it whole.)
let binary = "AB" + String.from_bytes([0, 0, 67]) + "DE"
FS.write(f1, binary)
assert_eq(FS.size(f1), 7)
assert_eq(FS.read(f1), binary)
assert_eq(FS.read(f1).bytes().collect(), [65, 66, 0, 0, 67, 68, 69])
// A leading NUL leaves nothing before it, and an all-NUL body is still bytes.
FS.write(f1, String.from_bytes([0, 1, 2]))
assert_eq(FS.size(f1), 3)
FS.write(f1, "")
assert_eq(FS.size(f1), 0)
FS.write(f1, "hi\n")

let names = FS.list_dir(dir)
assert_eq(names.size(), 2)
// Order isn't guaranteed across platforms, so check containment.
assert_true(names.contains("hello.txt"))
assert_true(names.contains("world.txt"))

FS.remove(f1)
FS.remove(f2)
assert_eq(FS.exists(f1), false)

FS.remove(dir)
assert_eq(FS.exists(dir), false)

// --- Error path: size on non-existent throws IOError ---
let err = try {
  FS.size(bogus)
  "no-error"
} catch e {
  e.kind
}
assert_eq(err, "IOError")

// read/write of an unopenable path: kind + message identical across backends.
let rerr = try {
  FS.read(bogus)
  "no-error"
} catch e {
  e.kind + ": " + e.message
}
assert_eq(rerr, "IOError: FS.read: cannot open '" + bogus + "'")
let werr = try {
  FS.write("/no/such/dir/x.txt", "x")
  "no-error"
} catch e {
  e.kind + ": " + e.message
}
assert_eq(werr, "IOError: FS.write: cannot open '/no/such/dir/x.txt'")

// --- Extensions: stat / rename / copy / walk / glob / paths / symlinks ---
// Pure path helpers (no I/O).
assert_eq(FS.normpath("a/./b/../c"), "a{FS.sep()}c")
assert_eq(FS.is_abs("/tmp"), true)
assert_eq(FS.is_abs("rel/path"), false)

// abspath: normalize lexically, resolve a relative path against the cwd, and
// touch the disk for neither — a path that does not exist comes back
// unchanged, and a symlink is left as it is (that is realpath's job).
// Compared against Sys.getcwd() rather than a literal, since the absolute
// answer is whatever directory the runner started in.
assert_eq(FS.abspath("/tmp/./a/../b"), "/tmp/b")
assert_eq(FS.abspath("/a//b/./c/"), "/a/b/c/")
assert_eq(FS.abspath("/no/such/path/at/all"), "/no/such/path/at/all")
assert_eq(FS.abspath("rel/x"), FS.join(Sys.getcwd(), "rel/x"))
assert_eq(FS.abspath("a/../b"), FS.join(Sys.getcwd(), "b"))
assert_true(FS.is_abs(FS.abspath(".")))
// The empty path is left to the platform (libstdc++ reports an error where
// another library may answer the cwd), so nothing is pinned for it here.

let xdir = FS.join(tmp_root, "ext")
FS.mkdir(FS.join(xdir, "sub"))
FS.write(FS.join(xdir, "f.txt"), "hello")
FS.write(FS.join(xdir, "sub/g.txt"), "yy")

// stat: regular file is_file/size; mtime/is_dir/is_symlink present.
let stf = FS.stat(FS.join(xdir, "f.txt"))
assert_eq(stf.size, 5)
assert_true(stf.is_file)
assert_eq(stf.is_dir, false)
assert_eq(stf.is_symlink, false)
let std = FS.stat(xdir)
assert_true(std.is_dir)

// chmod sets permission bits; stat.mode reads them back (round-trip).
let cf = FS.join(xdir, "f.txt")
FS.chmod(cf, 0o644)
assert_eq(FS.stat(cf).mode, 0o644)
FS.chmod(cf, 0o600)
assert_eq(FS.stat(cf).mode, 0o600)
FS.chmod(cf, 0o755)
assert_eq(FS.stat(cf).mode, 0o755)
// chmod on a missing path throws IOError; a non-Long mode is a TypeError.
assert_eq(try {
  FS.chmod(bogus, 0o644)
  "ok"
} catch e {
  e.kind
}, "IOError")
assert_eq(try {
  FS.chmod(cf, "644")
  "ok"
} catch e {
  e.kind
}, "TypeError")

// stat exposes uid/gid; chown to the file's own owner/group is allowed for a
// non-root process (so this is root-independent) and leaves them unchanged.
let own = FS.stat(cf)
assert_true(own.uid >= 0)
assert_true(own.gid >= 0)
FS.chown(cf, own.uid, own.gid)  // numeric owner + group
assert_eq(FS.stat(cf).uid, own.uid)
FS.chown(cf, group: own.gid)  // group only; owner left unchanged
assert_eq(FS.stat(cf).uid, own.uid)
// chown errors: missing path -> IOError; unknown name -> IOError; a non
// String/Long/Nil owner -> TypeError. (All identical across backends.)
assert_eq(try {
  FS.chown(bogus, 0)
  "ok"
} catch e {
  e.kind
}, "IOError")
assert_eq(try {
  FS.chown(cf, owner: "no_such_user_zzz")
  "ok"
} catch e {
  e.kind
}, "IOError")
assert_eq(try {
  FS.chown(cf, owner: true)
  "ok"
} catch e {
  e.kind
}, "TypeError")
// A StringView (e.g. a slice) is a name, not a type error: it reaches name
// resolution -> unknown-user IOError, identically on both backends.
assert_eq(try {
  FS.chown(cf, owner: "no_such_user_zzz"[0..5])
  "ok"
} catch e {
  e.kind
}, "IOError")

// walk: every path under xdir (sub/, f.txt, sub/g.txt) = 3 entries.
assert_eq(FS.walk(xdir).size(), 3)

// glob: **/*.txt matches both files.
assert_eq(FS.glob(FS.join(xdir, "**/*.txt")).size(), 2)

// rename then copy.
FS.rename(FS.join(xdir, "f.txt"), FS.join(xdir, "r.txt"))
assert_true(FS.exists(FS.join(xdir, "r.txt")))
assert_eq(FS.exists(FS.join(xdir, "f.txt")), false)
FS.copy(FS.join(xdir, "r.txt"), FS.join(xdir, "c.txt"))
assert_true(FS.exists(FS.join(xdir, "c.txt")))

// symlink / readlink / is_symlink.
FS.symlink(FS.join(xdir, "r.txt"), FS.join(xdir, "link"))
assert_true(FS.is_symlink(FS.join(xdir, "link")))
assert_eq(FS.readlink(FS.join(xdir, "link")), FS.join(xdir, "r.txt"))

// recursive remove (kwarg) cleans the whole tree.
FS.remove(xdir, recursive: true)
assert_eq(FS.exists(xdir), false)

FS.remove(tmp_root, recursive: true)

IO.inspect("test_fs OK")
