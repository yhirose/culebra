// Conformance: stdlib §3 (FS). See docs/stdlib.md and docs/language.md §25.
//
// FS namespace — path manipulation, queries, dir/file ops.
// Tests run on interp, JIT, and AOT via `just test`; identical stdout.

// --- Path manipulation ---
assert_eq(FS.join("a", "b", "c.txt"), "a/b/c.txt")
assert_eq(FS.join("/usr", "local", "bin"), "/usr/local/bin")
assert_eq(FS.join(), "")
assert_eq(FS.join("only"), "only")

assert_eq(FS.basename("a/b/c.txt"), "c.txt")
assert_eq(FS.basename("c.txt"), "c.txt")
assert_eq(FS.basename("/"), "")

assert_eq(FS.dirname("a/b/c.txt"), "a/b")
assert_eq(FS.dirname("c.txt"), "")

assert_eq(FS.extension("a/b/c.txt"), ".txt")
assert_eq(FS.extension("noext"), "")
assert_eq(FS.extension(".hidden"), "")   // C++ filesystem treats leading-dot files as no-extension

assert_eq(FS.stem("a/b/c.txt"), "c")
assert_eq(FS.stem("c.txt"), "c")
assert_eq(FS.stem("noext"), "noext")

// --- Queries: use the running test directory as a known-good path ---
// Sys.argv[0] is the first arg passed after `--`. The test harness
// runs us without args, so we synthesize a path via Sys.env if
// available; otherwise we just exercise non-existent paths.
let bogus = "/definitely/not/a/real/path/xyzzy"
assert_eq(FS.exists(bogus), false)
assert_eq(FS.is_file(bogus), false)
assert_eq(FS.is_dir(bogus), false)

// `/tmp` exists on every CI host we run on.
assert_eq(FS.exists("/tmp"), true)
assert_eq(FS.is_dir("/tmp"), true)
assert_eq(FS.is_file("/tmp"), false)

// --- Round-trip: mkdir / write / size / list / remove ---
// Prefer $TMPDIR so the test plays nicely in sandboxes where /tmp
// isn't writable; fall back to /tmp for environments that don't set
// TMPDIR.
let tmpdir_env = Sys.env("TMPDIR")
let tmp_root = if tmpdir_env != "" { tmpdir_env } else { "/tmp" }
let dir      = FS.join(tmp_root, "culebra_fs_test")
let f1       = FS.join(dir, "hello.txt")
let f2       = FS.join(dir, "world.txt")

// Clean any leftover from a prior failed run.
if FS.exists(f1) { FS.remove(f1) }
if FS.exists(f2) { FS.remove(f2) }
if FS.exists(dir) { FS.remove(dir) }

FS.mkdir(dir)
assert_true(FS.is_dir(dir))

IO.write(f1, "hi\n")
IO.write(f2, "longer content here")

assert_true(FS.is_file(f1))
assert_eq(FS.size(f1), 3)
assert_eq(FS.size(f2), 19)

let names = FS.list_dir(dir)
assert_eq(names.size(), 2)
// Order isn't guaranteed across platforms, so check containment.
assert_true(names.contains("hello.txt"))
assert_true(names.contains("world.txt"))

FS.remove(f1)
FS.remove(f2)
assert_eq(FS.exists(f1), false)

FS.remove(dir)
assert_eq(FS.exists(dir), false)

// --- Error path: size on non-existent throws IOError ---
let err = try { FS.size(bogus); "no-error" } catch e { e.kind }
assert_eq(err, "IOError")

// --- Extensions: stat / rename / copy / walk / glob / paths / symlinks ---
// Pure path helpers (no I/O).
assert_eq(FS.normpath("a/./b/../c"), "a/c")
assert_eq(FS.is_abs("/tmp"), true)
assert_eq(FS.is_abs("rel/path"), false)

let xdir = FS.join(tmp_root, "culebra_fs_ext")
if FS.exists(xdir) { FS.remove(xdir, recursive: true) }
FS.mkdir(FS.join(xdir, "sub"))
IO.write(FS.join(xdir, "f.txt"), "hello")
IO.write(FS.join(xdir, "sub/g.txt"), "yy")

// stat: regular file is_file/size; mtime/is_dir/is_symlink present.
let stf = FS.stat(FS.join(xdir, "f.txt"))
assert_eq(stf.size, 5)
assert_true(stf.is_file)
assert_eq(stf.is_dir, false)
assert_eq(stf.is_symlink, false)
let std = FS.stat(xdir)
assert_true(std.is_dir)

// walk: every path under xdir (sub/, f.txt, sub/g.txt) = 3 entries.
assert_eq(FS.walk(xdir).size(), 3)

// glob: **/*.txt matches both files.
assert_eq(FS.glob(FS.join(xdir, "**/*.txt")).size(), 2)

// rename then copy.
FS.rename(FS.join(xdir, "f.txt"), FS.join(xdir, "r.txt"))
assert_true(FS.exists(FS.join(xdir, "r.txt")))
assert_eq(FS.exists(FS.join(xdir, "f.txt")), false)
FS.copy(FS.join(xdir, "r.txt"), FS.join(xdir, "c.txt"))
assert_true(FS.exists(FS.join(xdir, "c.txt")))

// symlink / readlink / is_symlink.
FS.symlink(FS.join(xdir, "r.txt"), FS.join(xdir, "link"))
assert_true(FS.is_symlink(FS.join(xdir, "link")))
assert_eq(FS.readlink(FS.join(xdir, "link")), FS.join(xdir, "r.txt"))

// recursive remove (kwarg) cleans the whole tree.
FS.remove(xdir, recursive: true)
assert_eq(FS.exists(xdir), false)

IO.puts("test_fs OK")
