// Conformance: built-in Iterable + Iterator traits (Kotlin-style).
//   trait Iterable { iter() -> Iterator }
//   trait Iterator { has_next() -> Bool, next() -> Any }
// Iterator-as-Iterable: a class with iter()+has_next()+next() is both.

// --- User class conforming to Iterator + Iterable ---
class Counter {
  new(start, stop) {
    self.cur = start
    self.stop = stop
  }
  iter() {
    self
  }
  has_next() {
    self.cur < self.stop
  }
  next() {
    let v = self.cur
    self.cur = self.cur + 1
    v
  }
}

mut collected = []
for x in Counter.new(0, 3) {
  collected.push(x)
}
assert_eq(collected.size(), 3)
assert_true(collected[0] == 0 && collected[1] == 1 && collected[2] == 2)

// --- nil yield works (the key advantage over a T?-terminator design) ---
class NilYielder {
  new() {
    self.i = 0
  }
  iter() {
    self
  }
  has_next() {
    self.i < 3
  }
  next() {
    let v = self.i
    self.i = self.i + 1
    if v == 1 {
      nil
    } else {
      v
    }
  }
}

mut seen = []
for x in NilYielder.new() {
  seen.push(x)
}
assert_eq(seen.size(), 3)
assert_true(seen[0] == 0 && seen[1] == nil && seen[2] == 2)

// --- primitive Iterable conformance ---
fn iterate(it: Iterable) -> Long {
  mut n = 0
  for _ in it {
    n = n + 1
  }
  n
}
assert_eq(iterate([1, 2, 3]), 3)
assert_eq(iterate('abc'), 3)
assert_eq(iterate({a: 1, b: 2}), 2)
assert_eq(iterate((1, 2, 3, 4)), 4)
assert_eq(iterate({1, 2, 3}), 3)

// --- Iterator manual driving ---
let arr_iter = [10, 20, 30].iter()
assert_eq(arr_iter.has_next(), true)
assert_eq(arr_iter.next(), 10)
assert_eq(arr_iter.next(), 20)
assert_eq(arr_iter.next(), 30)
assert_eq(arr_iter.has_next(), false)

// --- has_next is idempotent (lazy iters may compute next eagerly) ---
let r = range(3)
let it = r.iter()
assert_eq(it.has_next(), true)
assert_eq(it.has_next(), true)
assert_eq(it.next(), 0)
assert_eq(it.next(), 1)
assert_eq(it.next(), 2)
assert_eq(it.has_next(), false)

// --- next() past the end yields nil, on every source and every backend ---
// §18.5 only promises `next` behind a truthy `has_next`; a drained built-in
// wrapper used to throw on the interpreter alone.
assert_eq(it.next(), nil)
assert_eq(it.next(), nil)
let drained = [1].iter()
drained.next()
assert_eq(drained.next(), nil)
let chained = [1].iter().map(fn (x) {
  x
})
chained.next()
assert_eq(chained.next(), nil)

// --- Iterator pipeline methods compose under the new protocol ---
let doubled = [1, 2, 3].iter().map(fn (x) {
  x * 2
}).collect()
assert_eq(doubled.size(), 3)
assert_true(doubled[0] == 2 && doubled[1] == 4 && doubled[2] == 6)

let evens = range(10).filter(fn (x) {
  x % 2 == 0
}).collect()
assert_eq(evens.size(), 5)
assert_true(evens[0] == 0 && evens[4] == 8)

// --- User class works in the pipeline too ---
let cs = Counter.new(0, 5).map(fn (x) {
  x * x
}).collect()
assert_eq(cs.size(), 5)
assert_true(cs[0] == 0 && cs[4] == 16)

// --- has_next() is read for truthiness, not for a Bool tag ---
// docs §18.5: `next()` runs when `has_next()` was *truthy*. A Long / Float
// answer counts; anything else is the same type error a condition raises.
class NumericGate {
  n: Long
  new() { self.n = 0 }
  iter() { self }
  has_next() { if self.n < 3 { 1 } else { 0 } }
  next() { let v = self.n; self.n = v + 1; v }
}
mut gated = []
for x in NumericGate.new() { gated.push(x) }
assert_eq(gated, [0, 1, 2])
assert_eq(NumericGate.new().iter().count(), 3)

class StringGate {
  iter() { self }
  has_next() { 'yes' }
  next() { 1 }
}
assert_throws('TypeError', fn () {
  for x in StringGate.new() { break }
})
assert_throws('TypeError', fn () { StringGate.new().iter().count() })

// --- A throwing dispose() is swallowed only while an exception unwinds ---
// docs §18.5. `break` and a natural drain already let one out; `return` is an
// ordinary exit too, so it does the same.
class ThrowingDispose {
  iter() { self }
  has_next() { true }
  next() { 1 }
  dispose() { throw 'from dispose' }
}
assert_throws('String', fn () {
  for x in ThrowingDispose.new() { return 'never delivered' }
})
mut swallowed = 'unset'
try {
  for x in ThrowingDispose.new() { throw 'body' }
} catch e {
  swallowed = e
}
assert_eq(swallowed, 'body')

IO.inspect('test_iterator_trait OK')
