// Term: ANSI escape + colour builders, key-name parsing, Screen frame
// buffering, and size fallback. The interactive raw-mode render loop needs
// a real tty, so it is exercised by examples/froggy.cul rather than here.

// --- escape builders (pure strings) ---
assert_eq(Term.clear(), "\x1b[2J\x1b[H")
assert_eq(Term.move(0, 0), "\x1b[1;1H")
assert_eq(Term.move(4, 2), "\x1b[3;5H")     // row = y+1, col = x+1
assert_eq(Term.hide(), "\x1b[?25l")
assert_eq(Term.show(), "\x1b[?25h")

// --- 256-colour / truecolour / attributes (force full capability) ---
Term.set_level(3)
assert_eq(Term.level(), 3)
assert_eq(Term.fg("x", 196), "\x1b[38;5;196mx\x1b[39m")
assert_eq(Term.bg("x", 21), "\x1b[48;5;21mx\x1b[49m")
assert_eq(Term.rgb("x", 255, 128, 0), "\x1b[38;2;255;128;0mx\x1b[39m")
assert_eq(Term.bold("x"), "\x1b[1mx\x1b[22m")
assert_eq(Term.dim("x"), "\x1b[2mx\x1b[22m")
assert_eq(Term.underline("x"), "\x1b[4mx\x1b[24m")
assert_eq(Term.reverse("x"), "\x1b[7mx\x1b[27m")
assert_eq(Term.red("x"), "\x1b[31mx\x1b[39m")
assert_eq(Term.cyan("x"), "\x1b[36mx\x1b[39m")
// colours nest (each wraps with its own reset)
assert_eq(Term.bold(Term.fg("hi", 2)), "\x1b[1m\x1b[38;5;2mhi\x1b[39m\x1b[22m")

// --- capability downsampling ---
// level 2: truecolour rgb -> nearest 256-colour cube index (208 for #ff8000)
Term.set_level(2)
assert_eq(Term.rgb("x", 255, 128, 0), "\x1b[38;5;208mx\x1b[39m")
// level 1: everything collapses to the 16-colour palette
Term.set_level(1)
assert_eq(Term.red("x"), "\x1b[31mx\x1b[39m")
assert_eq(Term.fg("x", 196), "\x1b[91mx\x1b[39m")     // 256 #196 -> bright red
assert_eq(Term.bold("x"), "\x1b[1mx\x1b[22m")
// level 0 (NO_COLOR / non-tty): all styling stripped
Term.set_level(0)
assert_eq(Term.fg("x", 196), "x")
assert_eq(Term.rgb("x", 255, 128, 0), "x")
assert_eq(Term.bold("x"), "x")
assert_eq(Term.red("x"), "x")
Term.set_level(3)   // restore for any later use

// --- key parsing: raw bytes -> key event Object (or nil) ---
assert_eq(Term.parse(""), nil)
fn kev(raw) { Term.parse(raw) }
assert_eq(kev("\x1b[A").kind, "key")
assert_eq(kev("\x1b[A").key, "up")
assert_eq(kev("\x1b[B").key, "down")
assert_eq(kev("\x1b[C").key, "right")
assert_eq(kev("\x1b[D").key, "left")
assert_eq(kev("\x1bOA").key, "up")          // SS3 variant
assert_eq(kev("\x1b").key, "escape")
assert_eq(kev("\r").key, "enter")
assert_eq(kev("\n").key, "enter")
assert_eq(kev("\t").key, "tab")
assert_eq(kev("\x7f").key, "backspace")
assert_eq(kev("q").key, "q")
assert_eq(kev(" ").key, " ")
// extended keys (CSI tilde + SS3 function keys)
assert_eq(kev("\x1b[H").key, "home")
assert_eq(kev("\x1b[1~").key, "home")
assert_eq(kev("\x1b[4~").key, "end")
assert_eq(kev("\x1b[3~").key, "delete")
assert_eq(kev("\x1b[5~").key, "pageup")
assert_eq(kev("\x1b[6~").key, "pagedown")
assert_eq(kev("\x1bOP").key, "f1")
assert_eq(kev("\x1b[15~").key, "f5")
assert_eq(kev("\x1b[24~").key, "f12")
// modifiers: ctrl / shift / alt
let ce = kev("\x1b[1;5C")                   // Ctrl+Right
assert_eq(ce.key, "right")
assert_eq(ce.ctrl, true)
assert_eq(ce.shift, false)
assert_eq(kev("\x1b[1;2A").shift, true)     // Shift+Up
assert_eq(kev("\x1b[3;5~").ctrl, true)      // Ctrl+Delete
assert_eq(kev("\x03").key, "c")             // Ctrl+C control byte
assert_eq(kev("\x03").ctrl, true)
assert_eq(kev("\x1bx").key, "x")            // Alt+x (ESC prefix)
assert_eq(kev("\x1bx").alt, true)

// --- size fallback (no tty under the test runner) ---
assert_eq(Term.cols(), 80)
assert_eq(Term.rows(), 24)
let sz = Term.size()
assert_eq(sz[0], 80)
assert_eq(sz[1], 24)

// --- Screen: double-buffered cell grid with diff rendering ---
let s = Term.Screen.new()
s.clear()
s.put(2, 1, "X")
s.render()                          // first render = full repaint (discard)
// changing one cell emits only that cell's move + glyph
s.put(2, 1, "Y")
assert_eq(s.render(), "\x1b[2;3HY")  // row 2, col 3
// an unchanged frame emits nothing
s.put(2, 1, "Y")
assert_eq(s.render(), "")
// put lays successive graphemes into adjacent cells
s.put(0, 0, "ab")
assert_eq(s.render(), "\x1b[1;1Hab")
// a wide glyph occupies two cells
s.put(5, 3, "🐸")
assert_eq(s.render(), "\x1b[4;6H🐸")
// overwriting both cells of the frog with spaces clears it
s.put(5, 3, " ")
s.set(6, 3, " ")
assert_eq(s.render(), "\x1b[4;6H  ")

// A wide glyph advances the tracked cursor by its real display width even when
// a later draw refills its continuation cell (overlapping entities). Keying the
// advance off the neighbour cell instead would under-count and emit the next
// cell without a cursor move, stranding it one column to the right.
let w = Term.Screen.new()
w.clear()
w.render()                          // full repaint of blanks (discard)
w.clear()
w.set(0, 0, "🐸")                   // wide glyph (blanks col 1)
w.set(1, 0, "z")                    // refill the continuation cell
w.set(3, 0, "Q")                    // later cell that reveals cursor drift
assert_eq(w.render(), "\x1b[1;1H🐸\x1b[1;2Hz\x1b[1;4HQ")

// Screen.size mirrors the namespace size
assert_eq(s.cols(), 80)
assert_eq(s.rows(), 24)

// No resize pending under the test runner (SIGWINCH never fired).
assert_eq(Term.resized(), false)
assert_eq(s.poll(0.0), nil)       // no input, no resize -> nil

// --- display width (wcwidth): ASCII = 1, CJK / emoji = 2, combining = 0 ---
assert_eq(Term.width("a"), 1)
assert_eq(Term.width("abc"), 3)
assert_eq(Term.width(""), 0)
assert_eq(Term.width("あ"), 2)        // hiragana (wide)
assert_eq(Term.width("中文"), 4)       // CJK (2 + 2)
assert_eq(Term.width("🐸"), 2)        // emoji (wide)
assert_eq(Term.width("a🐸b"), 4)      // 1 + 2 + 1
assert_eq(Term.width("e\u{0301}"), 1) // e + combining acute = 1
// measured per extended grapheme cluster: a ZWJ sequence / flag / keycap is
// one 2-cell group, not the sum of its scalars
assert_eq(Term.width("👨‍👩‍👧"), 2)      // family (ZWJ) = one cluster
assert_eq(Term.width("🇯🇵"), 2)        // flag (regional indicators)

// --- Term.style: SGR parameter string for a cell (downsampled to level) ---
Term.set_level(3)
assert_eq(Term.style(), "")                            // no attrs/colour
assert_eq(Term.style(fg: 196), "38;5;196")             // 256 fg
assert_eq(Term.style(bg: 0), "48;5;0")                 // 256 bg
assert_eq(Term.style(fg: 196, bold: true), "1;38;5;196")
assert_eq(Term.style(fg: 2, bg: 4), "38;5;2;48;5;4")
assert_eq(Term.style(fg: (255, 128, 0)), "38;2;255;128;0")   // truecolour fg
assert_eq(Term.style(bold: true, underline: true), "1;4")
Term.set_level(0)
assert_eq(Term.style(fg: 196, bold: true), "")         // stripped at level 0
Term.set_level(3)

// --- per-cell colour: render emits minimal SGR transitions, ends at default ---
let cc = Term.Screen.new()
cc.clear()
cc.put(2, 1, "A", Term.style(fg: 2))
cc.render()                          // first render = full repaint (discard)
// change the glyph, same style: move + reset + style + glyph + trailing reset
cc.put(2, 1, "B", Term.style(fg: 2))
assert_eq(cc.render(), "\x1b[2;3H\x1b[0m\x1b[38;5;2mB\x1b[0m")
// unchanged frame -> nothing
cc.put(2, 1, "B", Term.style(fg: 2))
assert_eq(cc.render(), "")
// drop the colour (default style): the previous frame left the terminal at
// default, so no SGR is needed — just the glyph
cc.put(2, 1, "B")
assert_eq(cc.render(), "\x1b[2;3HB")

// --- mouse: SGR report -> mouse event Object (0-based coordinates) ---
let m1 = Term.parse("\x1b[<0;15;8M")     // left press at col 15, row 8 (1-based)
assert_eq(m1.kind, "mouse")
assert_eq(m1.event, "press")
assert_eq(m1.button, "left")
assert_eq(m1.x, 14)                      // 0-based
assert_eq(m1.y, 7)
assert_eq(m1.shift, false)
let m2 = Term.parse("\x1b[<2;3;4m")      // right release ('m')
assert_eq(m2.button, "right")
assert_eq(m2.event, "release")
let m3 = Term.parse("\x1b[<64;1;1M")     // wheel up
assert_eq(m3.button, "wheel_up")
assert_eq(m3.event, "scroll")
assert_eq(Term.parse("\x1b[<65;1;1M").button, "wheel_down")
let m5 = Term.parse("\x1b[<32;5;6M")     // motion bit set -> drag
assert_eq(m5.event, "drag")
assert_eq(m5.button, "left")
assert_eq(Term.parse("\x1b[<4;1;1M").shift, true)    // shift modifier (bit 2)
assert_eq(Term.parse("\x1b[<16;1;1M").ctrl, true)    // ctrl modifier (bit 4)
// mouse-enable / disable escapes
assert_eq(Term.mouse_on(), "\x1b[?1002h\x1b[?1006h")
assert_eq(Term.mouse_off(), "\x1b[?1002l\x1b[?1006l")
// one event model: keys and mouse both come back as Objects with `kind`
assert_eq(Term.parse("q").kind, "key")
assert_eq(type_of(Term.parse("q")), "Object")

puts("test_term ok")
