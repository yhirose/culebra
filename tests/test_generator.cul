// Conformance: built-in generator functions via `yield`.
// Stage 0: single yield in a straight-line body — exercises the
// AST-transformation infrastructure (anonymous class synthesis +
// factory wrapping). State machine + multi-yield arrive in Stage 1+.

// --- minimal: 1 yield ---
fn one() {
  yield 42
}

let g = one()
assert_eq(g.has_next(), true)
assert_eq(g.next(), 42)
assert_eq(g.has_next(), false)

// --- works as an Iterable (Phase 2 protocol auto-conforms) ---
mut collected = []
for x in one() {
  collected.push(x)
}
assert_eq(collected.size(), 1)
assert_eq(collected[0], 42)

// --- yield expression (non-literal value) ---
fn computed() {
  yield 7 * 6
}
assert_eq(computed().next(), 42)

// --- params flow through to the yielded value ---
fn echo(v) {
  yield v
}
assert_eq(echo("hi").next(), "hi")
assert_eq(echo(nil).next(), nil)  // nil yield works (key advantage)

// --- each call returns a fresh generator instance ---
let g1 = one()
let g2 = one()
g1.next()  // drain g1
assert_eq(g1.has_next(), false)
assert_eq(g2.has_next(), true)  // g2 unaffected
assert_eq(g2.next(), 42)

// --- pipeline composition (Phase 2 Iterator methods) ---
let mapped = echo(10).map(fn (x) {
    x * 3
  }).collect()
assert_eq(mapped.size(), 1)
assert_eq(mapped[0], 30)

// --- Stage 1: N yields in a straight-line body (state dispatch) ---
fn three() {
  yield 1
  yield 2
  yield 3
}
let three_collected = three().collect()
assert_eq(three_collected.size(), 3)
assert_eq(three_collected[0], 1)
assert_eq(three_collected[1], 2)
assert_eq(three_collected[2], 3)

// --- nil among the yields stays distinct from terminator ---
fn with_nil() {
  yield 'a'
  yield nil
  yield 'b'
}
let wn = with_nil().collect()
assert_eq(wn.size(), 3)
assert_eq(wn[0], 'a')
assert_eq(wn[1], nil)
assert_eq(wn[2], 'b')

// --- params reach every yield site ---
fn doubled(v) {
  yield v
  yield v + v
}
let d = doubled(5).collect()
assert_eq(d.size(), 2)
assert_eq(d[0], 5)
assert_eq(d[1], 10)

// --- has_next idempotent across N-yield generators too ---
let it = three().iter()
assert_eq(it.has_next(), true)
assert_eq(it.has_next(), true)
assert_eq(it.next(), 1)
assert_eq(it.next(), 2)
assert_eq(it.next(), 3)
assert_eq(it.has_next(), false)

// --- Stage 2: while loop + yield (the real generator mileposts) ---
fn counter(start, stop) {
  mut cur = start
  while cur < stop {
    yield cur
    cur = cur + 1
  }
}
let cs = counter(0, 4).collect()
assert_eq(cs.size(), 4)
assert_eq(cs[0], 0)
assert_eq(cs[3], 3)

// --- fibonacci, the canonical lazy generator ---
fn fib() {
  mut a = 0
  mut b = 1
  while true {
    yield a
    let t = a + b
    a = b
    b = t
  }
}
let head = fib().take(7).collect()
assert_eq(head.size(), 7)
assert_eq(head[0], 0)
assert_eq(head[1], 1)
assert_eq(head[2], 1)
assert_eq(head[3], 2)
assert_eq(head[6], 8)

// --- early break works (lazy never touches the remaining values) ---
mut sum = 0
for x in counter(0, 1000) {
  sum = sum + x
  if x >= 4 {
    break
  }
}
assert_eq(sum, 0 + 1 + 2 + 3 + 4)

// --- Stage 3: yield inside if (conditional yield) ---
fn filter_even(n) {
  mut i = 0
  while i < n {
    if i % 2 == 0 {
      yield i
    }
    i = i + 1
  }
}
let evens_gen = filter_even(10).collect()
assert_eq(evens_gen.size(), 5)
assert_eq(evens_gen[0], 0)
assert_eq(evens_gen[4], 8)

// --- yield in both if and else arms ---
fn alternating() {
  mut i = 0
  while i < 4 {
    if i % 2 == 0 {
      yield i
    } else {
      yield -i
    }
    i = i + 1
  }
}
let alt = alternating().collect()
assert_eq(alt.size(), 4)
assert_eq(alt[0], 0)
assert_eq(alt[1], -1)
assert_eq(alt[2], 2)
assert_eq(alt[3], -3)

// --- Stage 5: yield inside a for-in loop ---
fn from_array(arr) {
  for v in arr {
    yield v + 1
  }
}
let mapped_s5 = from_array([10, 20, 30]).collect()
assert_eq(mapped_s5.size(), 3)
assert_eq(mapped_s5[0], 11)
assert_eq(mapped_s5[2], 31)

// --- for-in over a generator (nested generator) ---
fn inner_n(n) {
  mut i = 0
  while i < n {
    yield i
    i = i + 1
  }
}
fn outer_times10(n) {
  for x in inner_n(n) {
    yield x * 10
  }
}
let nested = outer_times10(4).collect()
assert_eq(nested.size(), 4)
assert_eq(nested[0], 0)
assert_eq(nested[1], 10)
assert_eq(nested[3], 30)

// --- for-in with conditional yield (Stage 3 + Stage 5 combined) ---
fn keep_evens(arr) {
  for v in arr {
    if v % 2 == 0 {
      yield v
    }
  }
}
let evens_s5 = keep_evens([1, 2, 3, 4, 5, 6]).collect()
assert_eq(evens_s5.size(), 3)
assert_eq(evens_s5[0], 2)
assert_eq(evens_s5[2], 6)

// --- for-in with both arms yielding ---
fn signed_evens(arr) {
  for v in arr {
    if v % 2 == 0 {
      yield v
    } else {
      yield -v
    }
  }
}
let se = signed_evens([1, 2, 3, 4]).collect()
assert_eq(se.size(), 4)
assert_eq(se[0], -1)
assert_eq(se[1], 2)
assert_eq(se[2], -3)
assert_eq(se[3], 4)

// --- early break still works through the for-in path ---
mut sum_s5 = 0
for x in outer_times10(100) {
  sum_s5 = sum_s5 + x
  if x >= 30 {
    break
  }
}
assert_eq(sum_s5, 0 + 10 + 20 + 30)

// a named generator fn declared inside a class method (its lowered class decl
// sits inside the method's fn scope, not directly in the class body)
class GenHost {
  m(n) {
    fn g() {
      yield n
      yield n * 2
    }
    g().collect()
  }
}
assert_eq(GenHost.new().m(7), [7, 14])

IO.inspect('test_generator OK')
