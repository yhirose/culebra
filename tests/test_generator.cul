// Conformance: built-in generator functions via `yield`.
// Stage 0: single yield in a straight-line body — exercises the
// AST-transformation infrastructure (anonymous class synthesis +
// factory wrapping). State machine + multi-yield arrive in Stage 1+.

// --- minimal: 1 yield ---
fn one() {
  yield 42
}

let g = one()
assert_eq(g.has_next(), true)
assert_eq(g.next(), 42)
assert_eq(g.has_next(), false)

// --- works as an Iterable (Phase 2 protocol auto-conforms) ---
mut collected = []
for x in one() {
  collected.push(x)
}
assert_eq(collected.size(), 1)
assert_eq(collected[0], 42)

// --- yield expression (non-literal value) ---
fn computed() {
  yield 7 * 6
}
assert_eq(computed().next(), 42)

// --- params flow through to the yielded value ---
fn echo(v) {
  yield v
}
assert_eq(echo("hi").next(), "hi")
assert_eq(echo(nil).next(), nil)  // nil yield works (key advantage)

// --- each call returns a fresh generator instance ---
let g1 = one()
let g2 = one()
g1.next()  // drain g1
assert_eq(g1.has_next(), false)
assert_eq(g2.has_next(), true)  // g2 unaffected
assert_eq(g2.next(), 42)

// --- pipeline composition (Phase 2 Iterator methods) ---
let mapped = echo(10).map(fn (x) {
  x * 3
}).collect()
assert_eq(mapped.size(), 1)
assert_eq(mapped[0], 30)

// --- Stage 1: N yields in a straight-line body (state dispatch) ---
fn three() {
  yield 1
  yield 2
  yield 3
}
let three_collected = three().collect()
assert_eq(three_collected.size(), 3)
assert_eq(three_collected[0], 1)
assert_eq(three_collected[1], 2)
assert_eq(three_collected[2], 3)

// --- nil among the yields stays distinct from terminator ---
fn with_nil() {
  yield 'a'
  yield nil
  yield 'b'
}
let wn = with_nil().collect()
assert_eq(wn.size(), 3)
assert_eq(wn[0], 'a')
assert_eq(wn[1], nil)
assert_eq(wn[2], 'b')

// --- params reach every yield site ---
fn doubled(v) {
  yield v
  yield v + v
}
let d = doubled(5).collect()
assert_eq(d.size(), 2)
assert_eq(d[0], 5)
assert_eq(d[1], 10)

// --- has_next idempotent across N-yield generators too ---
let it = three().iter()
assert_eq(it.has_next(), true)
assert_eq(it.has_next(), true)
assert_eq(it.next(), 1)
assert_eq(it.next(), 2)
assert_eq(it.next(), 3)
assert_eq(it.has_next(), false)

// --- Stage 2: while loop + yield (the real generator mileposts) ---
fn counter(start, stop) {
  mut cur = start
  while cur < stop {
    yield cur
    cur = cur + 1
  }
}
let cs = counter(0, 4).collect()
assert_eq(cs.size(), 4)
assert_eq(cs[0], 0)
assert_eq(cs[3], 3)

// --- fibonacci, the canonical lazy generator ---
fn fib() {
  mut a = 0
  mut b = 1
  while true {
    yield a
    let t = a + b
    a = b
    b = t
  }
}
let head = fib().take(7).collect()
assert_eq(head.size(), 7)
assert_eq(head[0], 0)
assert_eq(head[1], 1)
assert_eq(head[2], 1)
assert_eq(head[3], 2)
assert_eq(head[6], 8)

// --- early break works (lazy never touches the remaining values) ---
mut sum = 0
for x in counter(0, 1000) {
  sum = sum + x
  break if x >= 4
}
assert_eq(sum, 0 + 1 + 2 + 3 + 4)

// --- Stage 3: yield inside if (conditional yield) ---
fn filter_even(n) {
  mut i = 0
  while i < n {
    yield i if i % 2 == 0
    i = i + 1
  }
}
let evens_gen = filter_even(10).collect()
assert_eq(evens_gen.size(), 5)
assert_eq(evens_gen[0], 0)
assert_eq(evens_gen[4], 8)

// --- yield in both if and else arms ---
fn alternating() {
  mut i = 0
  while i < 4 {
    if i % 2 == 0 {
      yield i
    } else {
      yield -i
    }
    i = i + 1
  }
}
let alt = alternating().collect()
assert_eq(alt.size(), 4)
assert_eq(alt[0], 0)
assert_eq(alt[1], -1)
assert_eq(alt[2], 2)
assert_eq(alt[3], -3)

// --- Stage 5: yield inside a for-in loop ---
fn from_array(arr) {
  for v in arr {
    yield v + 1
  }
}
let mapped_s5 = from_array([10, 20, 30]).collect()
assert_eq(mapped_s5.size(), 3)
assert_eq(mapped_s5[0], 11)
assert_eq(mapped_s5[2], 31)

// --- for-in over a generator (nested generator) ---
fn inner_n(n) {
  mut i = 0
  while i < n {
    yield i
    i = i + 1
  }
}
fn outer_times10(n) {
  for x in inner_n(n) {
    yield x * 10
  }
}
let nested = outer_times10(4).collect()
assert_eq(nested.size(), 4)
assert_eq(nested[0], 0)
assert_eq(nested[1], 10)
assert_eq(nested[3], 30)

// --- for-in with conditional yield (Stage 3 + Stage 5 combined) ---
fn keep_evens(arr) {
  for v in arr {
    yield v if v % 2 == 0
  }
}
let evens_s5 = keep_evens([1, 2, 3, 4, 5, 6]).collect()
assert_eq(evens_s5.size(), 3)
assert_eq(evens_s5[0], 2)
assert_eq(evens_s5[2], 6)

// --- for-in with both arms yielding ---
fn signed_evens(arr) {
  for v in arr {
    if v % 2 == 0 {
      yield v
    } else {
      yield -v
    }
  }
}
let se = signed_evens([1, 2, 3, 4]).collect()
assert_eq(se.size(), 4)
assert_eq(se[0], -1)
assert_eq(se[1], 2)
assert_eq(se[2], -3)
assert_eq(se[3], 4)

// --- early break still works through the for-in path ---
mut sum_s5 = 0
for x in outer_times10(100) {
  sum_s5 = sum_s5 + x
  break if x >= 30
}
assert_eq(sum_s5, 0 + 10 + 20 + 30)

// a named generator fn declared inside a class method (its lowered class decl
// sits inside the method's fn scope, not directly in the class body)
class GenHost {
  m(n) {
    fn g() {
      yield n
      yield n * 2
    }
    g().collect()
  }
}
assert_eq(GenHost.new().m(7), [7, 14])

// --- closures over promoted body locals -----------------------------------
// A generator's locals live on its state instance, so a closure written in
// the body would read them through `self` and the instance would hold the
// closure back. The locals a closure reads live in a box the closure captures
// instead; these pin what that has to keep working.

// read across suspensions
fn cl_across(n) {
  let h = fn (k) {
    k + n
  }
  yield h(1)
  yield h(2)
  yield h(3)
}
assert_eq(cl_across(10).collect(), [11, 12, 13])

// a closure that WRITES a body local, seen by the body and by later calls
fn cl_write(n) {
  mut acc = n
  let bump = fn (k) {
    acc = acc + k
  }
  bump(1)
  yield acc
  bump(10)
  yield acc
}
assert_eq(cl_write(5).collect(), [6, 16])

// two closures over one local read the same binding
fn cl_two(n) {
  mut base = n
  let a = fn () {
    base + 1
  }
  let b = fn () {
    base + 2
  }
  yield a()
  base = base * 10
  yield b()
}
assert_eq(cl_two(3).collect(), [4, 32])

// a deferred body runs the closure at dispose
fn cl_defer(n) {
  let seen = [n]
  let add = fn (k) {
    seen.push(k)
  }
  defer {
    add(99)
  }
  add(1)
  yield seen
}
let cl_g = cl_defer(7)
let cl_seen = cl_g.next()
cl_g.dispose()
assert_eq(cl_seen, [7, 1, 99])

// a closure over a local declared AFTER it (the box exists from construction)
fn cl_later(n) {
  let f = fn () {
    later
  }
  mut later = n * 2
  yield f()
  later = later + 1
  yield f()
}
assert_eq(cl_later(4).collect(), [8, 9])

// --- generator-internal break/continue: baseline (unlabeled), ahead of
// labeled break/continue landing on the CPS `loop_stack` these share ---

// break/continue inside a plain while, driving what's yielded
fn g_while_ctl(n) {
  mut i = 0
  while i < n {
    i = i + 1
    continue if i == 2
    yield i
    break if i >= 4
  }
}
assert_eq(g_while_ctl(10).collect(), [1, 3, 4])

// nobreak does not run when the loop exits via break
fn g_nobreak_break(n) {
  mut i = 0
  while i < n {
    i = i + 1
    yield i
    break if i >= 2
  } nobreak {
    yield 999
  }
}
assert_eq(g_nobreak_break(5).collect(), [1, 2])

// ...but does run on natural completion
fn g_nobreak_natural(n) {
  mut i = 0
  while i < n {
    i = i + 1
    yield i
  } nobreak {
    yield 999
  }
}
assert_eq(g_nobreak_natural(2).collect(), [1, 2, 999])

// break/continue inside a for-in the transform desugars to while + iterator
fn g_forin_ctl(xs) {
  for x in xs {
    continue if x == 2
    yield x
    break if x >= 4
  }
}
assert_eq(g_forin_ctl([1, 2, 3, 4, 5]).collect(), [1, 3, 4])

// two CPS-managed loops: an inner break exits only the inner loop
fn g_double_ctl() {
  mut outs = []
  while true {
    mut j = 0
    while true {
      j = j + 1
      break if j >= 2
      outs.push(j)
    }
    outs.push(100)
    yield outs
    break
  }
}
assert_eq(g_double_ctl().collect(), [[1, 100]])

// return inside a yielding loop ends the whole generator, not just the loop
fn g_return_in_loop(n) {
  mut i = 0
  while i < n {
    i = i + 1
    return if i == 3
    yield i
  }
}
assert_eq(g_return_in_loop(10).collect(), [1, 2])

// --- labeled break/continue inside a generator body ---
//
// The CPS transform keeps its own loop_stack (generator_transform.h), so a
// label has to resolve past any number of CPS-managed loops. The break and
// continue shapes are pinned in tests/test_labeled_loops.cul (15); these are
// the two that file does not reach — a `while` nest, and a label on the
// outer loop of a nobreak pair.

fn g_label_while_ctl(n) {
  mut i = 0
  outer: while i < n {
    i = i + 1
    mut j = 0
    while j < 3 {
      j = j + 1
      continue outer if j == 2
      yield i * 100 + j
    }
  }
}
assert_eq(g_label_while_ctl(2).collect(), [101, 201])

// nobreak belongs to the labelled loop, and an inner loop's break does not
// reach it
fn g_label_nobreak(xs) {
  outer: for x in xs {
    for y in [1, 2] {
      break if y == 2
      yield x * 10 + y
    }
  } nobreak {
    yield 999
  }
}
assert_eq(g_label_nobreak([1, 2]).collect(), [11, 21, 999])

IO.inspect('test_generator OK')
