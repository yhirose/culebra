# The object construction paths that resolve their layout at compile time
# (docs/internals/vm.md §5.4): a literal whose keys are all identifiers
# stores each property by slot index (Op::SlotInit), a class's
# initializer-less declared fields land in one step (Op::FieldsInit), and a
# class meta answers its special-method and `drop` questions from a table
# filled once at the declaration. Each of those replaces a name lookup, so
# what these pin down is that every observable the lookup decided — a
# duplicate key's slot, the well-known-name contract, `drop` registration,
# declaration order and what an initializer sees of it, an instance's own
# slot shadowing the class's dunder — is decided the same way.
#
# Run: ./build/culebra tests/test_object_layout.cul
#      ./build/culebra --jit tests/test_object_layout.cul

# --- literals: duplicate keys keep the first slot, last value wins ---

let dup = {a: 1, b: 2, a: 3}
assert_eq(dup.a, 3)
assert_eq(dup.keys(), ['a', 'b'])
assert_eq(to_string(dup), '{a: 3, b: 2}')

# a literal's mutability flag is per property
let flags = {mut m: 1, k: 2}
flags.m = 10
assert_eq(flags.m, 10)
assert_throws('ImmutableError', fn () {
  flags.k = 20
})

# --- literals: the well-known contract and `drop` registration ---

assert_throws('DropContractError', fn () {
  {next: 1}
})
assert_throws('DropContractError', fn () {
  {iter: fn (a) {
    a
  }}
})

mut dropped = []
fn scope() {
  let r = {name: 'r', drop: fn () {
    dropped.push('r')
  }}
  r.name
}
assert_eq(scope(), 'r')
assert_eq(dropped, ['r'])

# --- declared fields: zeros, order, and what an initializer sees ---

class Zeros {
  f: Float
  n: Long
  s: String
  b: Bool
  o: Object
}
let z = Zeros()
assert_eq(z.f, 0.0)
assert_eq(z.n, 0)
assert_eq(z.s, '')
assert_eq(z.b, false)
assert_eq(z.o, nil)
assert_eq(z.keys(), ['class', 'f', 'n', 's', 'b', 'o'])
z.n = 7
assert_eq(z.n, 7)

class Mixed {
  a: Long
  b: Long = self.a + 1
  # a field declared below is not there yet: this reads nil
  c: Object = self.d
  d: Long
  e: Long = self.d + 10
}
let m = Mixed()
assert_eq(m.a, 0)
assert_eq(m.b, 1)
assert_eq(m.c, nil)
assert_eq(m.d, 0)
assert_eq(m.e, 10)
assert_eq(m.keys(), ['class', 'a', 'b', 'c', 'd', 'e'])

class WithNew {
  x: Float
  y: Float
  new(x, y) {
    self.x = x
    self.y = y
    self.extra = x + y
  }
}
let w = WithNew(1.0, 2.0)
assert_eq(w.keys(), ['class', 'x', 'y', 'extra'])
assert_eq(w.extra, 3.0)

# the same class constructed many times keeps the same shape and values
mut acc = 0.0
for i in 0..100 {
  let v = WithNew(to_float(i), 1.0)
  acc += v.x + v.y
}
assert_eq(acc, 5050.0)

# --- @value: the declared fields are the closed set ---

@value
class P {
  x: Float
  y: Float
  new(x: Float, y: Float) {
    self.x = x
    self.y = y
  }
  __add__(o) {
    P.new(self.x + o.x, self.y + o.y)
  }
}
let box = {p: P.new(1.0, 2.0), q: P.new(3.0, 4.0)}
let sum = box.p + box.q
assert_eq((sum.x, sum.y), (4.0, 6.0))
assert_throws('ImmutableError', fn () {
  box.p.x = 5.0
})
assert_throws('ImmutableError', fn () {
  box.p.z = 5.0
})

# --- special methods: the class table, and an own slot shadowing it ---

class Money {
  new(v) {
    self.v = v
  }
  __add__(o) {
    Money(self.v + o.v)
  }
  __eq__(o) {
    self.v == o.v
  }
  __str__() {
    "${self.v}"
  }
  hash() {
    self.v
  }
}
let a = Money(3)
let b = Money(4)
assert_eq((a + b).v, 7)
assert_eq(to_string(a + b), '$7')
assert_eq(a == Money(3), true)
assert_eq([a].to_set().size(), 1)

# an instance's own slot takes precedence over the class's method
let c = Money(5)
c.__add__ = fn (o) {
  Money(self.v * 100 + o.v)
}
assert_eq((c + a).v, 503)
assert_eq((a + c).v, 8)
c.hash = 42
assert_throws('TypeError', fn () {
  [c].to_set()
})

# a plain object with a dunder key dispatches by name, as always
let plain = {v: 1, __add__: fn (o) {
  self.v + o
}}
assert_eq(plain + 2, 3)

# `drop` declared on the class registers each instance
mut order = []
class Res {
  new(n) {
    self.n = n
  }
  drop() {
    order.push(self.n)
  }
}
fn use_res() {
  let r1 = Res(1)
  let r2 = Res(2)
  r1.n + r2.n
}
assert_eq(use_res(), 3)
assert_eq(order, [2, 1])

# an operator on a class without the dunder is the ordinary TypeError
class Bare {
  new() {}
}
assert_throws('TypeError', fn () {
  Bare() + 1
})

println('ok')
