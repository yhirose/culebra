// Conformance: runtime errors inside effect / generator bodies report the
// ORIGINAL source line and column, not a transform-fragment position. Each
// copy of user source the transforms make carries an anchor naming where it
// came from, and the final fragment parse rebuilds the AST with the positions
// it leads back to (`#@culebra:N` line markers cover the machinery around
// them). Both backends read the same repositioned AST: symmetry is structural.
//
// NOTE: the expected values below are POSITIONS IN THIS FILE — editing the
// file shifts them. Keep additions at the bottom.

fn check(label, expect, thunk) {
  let got = try {
    thunk()
    -1
  } catch e {
    [e.line, e.col]
  }
  assert_eq("{label}:{got}", "{label}:{expect}")
}

effect fn ask()

// error inside a while body (CPS-reordered state)
effect fn in_while() {
  let x = perform ask()
  mut i = 0
  while i < 3 {
    let bad = x + "s"
    i = i + 1
  }
  x
}
check("while-body", [28, 15], fn () {
  handle { in_while() } with ask(k) { k(1) }
})

// error inside an ANF-hoisted operand
effect fn anf_hoist() {
  let y = perform ask() + "s"
  y
}
check("anf-hoisted", [39, 11], fn () {
  handle { anf_hoist() } with ask(k) { k(1) }
})

// error inside a desugared for-in body
effect fn in_for() {
  let x = perform ask()
  for v in [1, 2] {
    let bad = v + "s"
  }
  x
}
check("for-body", [50, 15], fn () {
  handle { in_for() } with ask(k) { k(1) }
})

// error inside a single-line for body (marker sits outside the for's span)
effect fn in_for1() {
  let x = perform ask()
  for v in [1, 2] { let bad = v + "s" }
  x
}
check("for-body-1line", [61, 31], fn () {
  handle { in_for1() } with ask(k) { k(1) }
})

// error inside a nested handle's body
effect fn inner_op()
effect fn nested_err() {
  let base = perform ask()
  handle {
    base + "s" + perform inner_op()
  } with inner_op(k) { k(1) }
}
check("nested-handle", [73, 5], fn () {
  handle { nested_err() } with ask(k) { k(1) }
})

// error inside a handler clause
check("handler-clause", [82, 44], fn () {
  handle { perform ask() } with ask(k) { k(1 + "s") }
})

// a multi-line triple string doesn't derail the lines that follow it
effect fn after_triple() {
  let x = perform ask()
  let doc = """line one
line two
line three"""
  let bad = x + "s"
  "{doc.size()}-{bad}"
}
check("after-triple", [91, 13], fn () {
  handle { after_triple() } with ask(k) { k(1) }
})

// generator: error at a yield inside a while
fn gen_loop() {
  mut i = 0
  while i < 2 {
    yield i + "s"
    i = i + 1
  }
}
check("gen-while-yield", [102, 11], fn () {
  gen_loop().collect()
})

// generator: error at a yield inside a (desugared) single-line for body
fn gen_for() {
  for v in [1, 2] { yield v + "s" }  // kept single-line: fmt-target, see header
}
check("gen-for-yield", [112, 27], fn () {
  gen_for().collect()
})

// generator: plain statement error in a generator body
fn gen_stmt() {
  let a = 1
  let bad = a + "s"
  yield bad
}
check("gen-stmt", [121, 13], fn () {
  gen_stmt().collect()
})

// no-handler EffectError carries the line of the offending `perform`
effect fn nh_body() {
  let a = 1
  let x = perform ask()
  x + a
}
check("no-handler", [131, nil], fn () {
  handle { nh_body() } with return(v) { v }
})

// …and across a delegate chain it is the innermost perform's line
effect fn nh_inner() {
  perform ask()
}
effect fn nh_outer() { nh_inner() }
check("no-handler-delegate", [140, nil], fn () {
  handle { nh_outer() } with return(v) { v }
})

// a user comment ending in a bare `#@N` is not provenance (the marker token
// is the verbose `#@culebra:N`)
effect fn imit_body() {
  let a = 1  # decoy #@5
  let bad = a + "s"
  bad
}
check("marker-imitation", [151, 13], fn () {
  handle { imit_body() } with return(v) { v }
})

// error inside a named generator fn nested in an effect body reports the
// original line (markers survive the effects fragment AND the generator
// re-lowering of the nested fn)
effect fn ng_body() {
  let x = perform ask()
  fn g(n) {
    yield n
    yield n + "s"
  }
  g(x).collect()
}
check("nested-gen-in-effect", [165, 11], fn () {
  handle { ng_body() } with ask(k) { k(1) }
})

// error inside a handle body nested in a generator reports the original line
// (the effects pass sliced it from the generator fragment via the registry)
fn eg_gen() {
  let v = handle {
    let x = perform ask()
    x + "s"
  } with ask(k) { k(1) }
  yield v
}
check("handle-in-gen", [178, 5], fn () {
  eg_gen().collect()
})

// error inside a single-line top-level defer body reports the defer's own
// line (its marker survives the block-brace strip of `defer { ... }`)
effect fn de_prov() {
  let z = nil
  defer { z.no_such() }
  let x = perform ask()
  x
}
check("defer-1line", [190, 11], fn () {
  handle { de_prov() } with ask(k) { k(1) }
})

// the column counts the source as written, though names ahead of the error on
// its line are rewritten (a promoted `v` is stored on the state instance), and
// on the first line of a one-line body
fn col_one() { for v in [1, 2] { if v == 2 { [1][9] }; yield v } }
check("col-one-line", [201, 46], fn () { col_one().collect() })
fn col_names(n) {
  let total = n
  yield total + n + [1][9]
}
check("col-rewritten-names", [205, 21], fn () { col_names(1).collect() })
effect fn col_anf() {
  let base = 10
  let y = base + perform ask() + [1][9]
}
check("col-anf", [210, 34], fn () { handle { col_anf() } with ask(k) { k(1) } })

// ...in a generator nested in a closure, behind a destructure, after
// multi-byte characters (the column counts code points)
fn col_outer() {
  let k = 2
  let f = fn () { fn col_inner() { let q = k; yield q + [1][9] }; col_inner() }
  for x in f() { yield x }
}
check("col-nested", [218, 57], fn () { col_outer().collect() })
fn col_pat() { let [a, b] = [1, 2]; yield a + b + [1][9] }
check("col-destructure", [222, 51], fn () { col_pat().collect() })
fn col_wide() { let s = "ああ"; yield s.size() + [1][9] }
check("col-wide", [224, 48], fn () { col_wide().collect() })

// ...in a handle that reads a generator's local (reached through the
// enclosing instance), and in a handler clause reading one of its own
fn col_capture() {
  let n = 5
  yield handle { let a = perform ask(); n + a + [1][9] } with ask(k) { k(1) }
}
check("col-capture", [231, 49], fn () { col_capture().collect() })
check("col-clause", [235, 57], fn () {
  handle { perform ask() } with ask(k) { let w = 1; w + [1][9] }
})

inspect("test_transform_error_lines: all assertions passed")
