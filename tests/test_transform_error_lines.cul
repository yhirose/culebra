// Conformance: runtime errors inside effect / generator bodies report the
// ORIGINAL source line, not a transform-fragment line. The transforms annotate
// body lines with `#@N` provenance markers (comments that survive every text
// stage) and the final fragment parse rebuilds the AST with original lines.
// Columns stay approximate (rewrites shift them); both backends read the same
// repositioned AST, so symmetry is structural.
//
// NOTE: the expected values below are LINE NUMBERS IN THIS FILE — editing the
// file shifts them. Keep additions at the bottom.

fn check(label, expect, thunk) {
  let got = try { thunk(); -1 } catch e { e.line }
  assert_eq("{label}:{got}", "{label}:{expect}")
}

effect fn ask()

// error inside a while body (CPS-reordered state)
effect fn in_while() {
  let x = perform ask()
  mut i = 0
  while i < 3 {
    let bad = x + "s"
    i = i + 1
  }
  x
}
check("while-body", 23, fn() { handle { in_while() } with ask(k) { k(1) } })

// error inside an ANF-hoisted operand
effect fn anf_hoist() {
  let y = perform ask() + "s"
  y
}
check("anf-hoisted", 32, fn() { handle { anf_hoist() } with ask(k) { k(1) } })

// error inside a desugared for-in body
effect fn in_for() {
  let x = perform ask()
  for v in [1, 2] {
    let bad = v + "s"
  }
  x
}
check("for-body", 41, fn() { handle { in_for() } with ask(k) { k(1) } })

// error inside a single-line for body (marker sits outside the for's span)
effect fn in_for1() {
  let x = perform ask()
  for v in [1, 2] { let bad = v + "s" }
  x
}
check("for-body-1line", 50, fn() { handle { in_for1() } with ask(k) { k(1) } })

// error inside a nested handle's body
effect fn inner_op()
effect fn nested_err() {
  let base = perform ask()
  handle {
    base + "s" + perform inner_op()
  } with inner_op(k) { k(1) }
}
check("nested-handle", 60, fn() { handle { nested_err() } with ask(k) { k(1) } })

// error inside a handler clause
check("handler-clause", 67,
      fn() { handle { perform ask() } with ask(k) { k(1 + "s") } })

// a multi-line triple string doesn't derail the lines that follow it
effect fn after_triple() {
  let x = perform ask()
  let doc = """line one
line two
line three"""
  let bad = x + "s"
  "{doc.size()}-{bad}"
}
check("after-triple", 75, fn() { handle { after_triple() } with ask(k) { k(1) } })

// generator: error at a yield inside a while
fn gen_loop() {
  mut i = 0
  while i < 2 {
    yield i + "s"
    i = i + 1
  }
}
check("gen-while-yield", 84, fn() { gen_loop().collect() })

// generator: error at a yield inside a (desugared) single-line for body
fn gen_for() {
  for v in [1, 2] { yield v + "s" }
}
check("gen-for-yield", 92, fn() { gen_for().collect() })

// generator: plain statement error in a generator body
fn gen_stmt() {
  let a = 1
  let bad = a + "s"
  yield bad
}
check("gen-stmt", 99, fn() { gen_stmt().collect() })

puts("test_transform_error_lines: all assertions passed")
