// Conformance: algebraic effects (thin slice).
// `effect fn` / `perform` / `handle … with` lower, at parse time, onto
// synthesized computation classes + the `__Eff` runtime (dynamically-scoped
// handler stack + multi-shot resume). All three backends run the lowered code,
// so behaviour is symmetric by construction. This slice covers straight-line
// bodies, statement-level performs, one-shot and multi-shot resume, dynamic
// scope (perform inside a called effect fn), A-normalization, control-flow
// bodies (if / while / for with break / continue / return), nested handles,
// and multiple handler clauses.

// --- dynamic scope: perform inside a called effect fn ---
effect fn get()

effect fn compute() {
  let x = perform get()
  x * 2
}

let r = handle {
  compute()
} with get(resume) {
  resume(21)
}
assert_eq(r, 42)

// --- perform directly in a handle body (lexical) ---
effect fn ask()
let a = handle {
  let x = perform ask()
  x + 1
} with ask(resume) {
  resume(10)
}
assert_eq(a, 11)

// --- handler aborts (never resumes): body tail is skipped ---
effect fn fail()
effect fn risky() {
  perform fail()
  99            // unreachable when the handler doesn't resume
}
let b = handle {
  risky()
} with fail(resume) {
  -1
}
assert_eq(b, -1)

// --- effect op with an argument + multiple sequential performs ---
effect fn emit(v)
effect fn producer() {
  perform emit(1)
  perform emit(2)
  "done"
}
mut seen = []
let c = handle {
  producer()
} with emit(v, resume) {
  seen.push(v)
  resume(nil)
}
assert_eq(seen, [1, 2])
assert_eq(c, "done")

// --- resume value flows back as the perform expression's value ---
effect fn twice(n)
effect fn doubler() {
  let y = perform twice(5)
  y + 100
}
let d = handle {
  doubler()
} with twice(n, resume) {
  resume(n * 2)   // n=5 -> resume 10 -> y=10 -> 110
}
assert_eq(d, 110)

// --- a fresh computation per call: handles are independent ---
let e1 = handle { compute() } with get(resume) { resume(1) }
let e2 = handle { compute() } with get(resume) { resume(7) }
assert_eq(e1, 2)
assert_eq(e2, 14)

// --- effect-free code is completely unaffected ---
fn plain(n) { n * n }
assert_eq(plain(6), 36)

// === A-normalization: expression-nested perform ==========================
// A `perform` buried in an expression is hoisted, at parse time, to a
// statement-level binding (ANF) so the straight-line splitter lowers it.
// Only unconditionally-evaluated positions are supported; a perform in a
// short-circuit / ternary operand or behind a method chain is rejected
// symmetrically (see the reject cases at the bottom).

// perform in a binary expression
effect fn anf_get()
effect fn anf_binary() {
  let x = perform anf_get() + 1
  x
}
assert_eq(handle { anf_binary() } with anf_get(resume) { resume(41) }, 42)

// perform as a positional call argument
fn add2(a, b) { a + b }
effect fn anf_arg() {
  let y = add2(perform anf_get(), 2)
  y
}
assert_eq(handle { anf_arg() } with anf_get(resume) { resume(40) }, 42)

// two performs, left-to-right evaluation order
mut anf_order = []
effect fn anf_emit(v)
effect fn anf_two() {
  let z = perform anf_emit(1) + perform anf_emit(2)
  z
}
let anf_r = handle { anf_two() } with anf_emit(v, resume) {
  anf_order.push(v)
  resume(v * 10)
}
assert_eq(anf_order, [1, 2])
assert_eq(anf_r, 30)

// nested perform inside a perform's argument (single handler)
effect fn anf_wrap(v)
effect fn anf_nested() {
  let w = perform anf_wrap(perform anf_wrap(1))
  w
}
// inner wrap(1) -> 101; outer wrap(101) -> 201
assert_eq(handle { anf_nested() } with anf_wrap(v, resume) { resume(v + 100) },
          201)

// perform in a return expression
effect fn anf_ret() {
  return perform anf_get() * 3
}
assert_eq(handle { anf_ret() } with anf_get(resume) { resume(7) }, 21)

// perform as a subscript index
effect fn anf_index() {
  let xs = [10, 20, 30]
  let v = xs[perform anf_get()]
  v
}
assert_eq(handle { anf_index() } with anf_get(resume) { resume(1) }, 20)

// a left operand's side effect runs before the suspension it precedes
mut anf_trace = []
fn anf_se(tag, val) { anf_trace.push(tag); val }
effect fn anf_order_fn() {
  let q = anf_se("left", 100) + perform anf_get()
  q
}
let anf_q = handle { anf_order_fn() } with anf_get(resume) {
  anf_trace.push("handler")
  resume(1)
}
assert_eq(anf_trace, ["left", "handler"])
assert_eq(anf_q, 101)

// perform as an array element
effect fn anf_arr() {
  let arr = [perform anf_get(), 2, 3]
  arr
}
assert_eq(handle { anf_arr() } with anf_get(resume) { resume(1) }, [1, 2, 3])

// === control-flow bodies ================================================
// A `perform` reachable through if / while / for (and break / continue /
// return) lowers to a flat-dispatch state machine — the same CPS shape the
// generator transform uses. `for`-in is desugared to `while` + iterator; the
// tail expression of a body is its value. Symmetric across the backends by
// construction (one lowered program).

// while + statement-level perform; the trailing expression is the value
effect fn cf_ask(i)
effect fn cf_survey(n) {
  mut total = 0
  mut i = 0
  while i < n {
    let a = perform cf_ask(i)
    total = total + a
    i = i + 1
  }
  total
}
assert_eq(handle { cf_survey(3) } with cf_ask(i, resume) { resume(i + 1) }, 6)

// if / else-if / else — each arm suspends and is the arm's value
effect fn cf_choose(x)
effect fn cf_branch(f) {
  if f == 0 { let a = perform cf_choose(0); a }
  else if f == 1 { let b = perform cf_choose(1); b * 2 }
  else { let c = perform cf_choose(2); c + 100 }
}
assert_eq(handle { cf_branch(0) } with cf_choose(x, resume) { resume(x + 10) },
          10)
assert_eq(handle { cf_branch(1) } with cf_choose(x, resume) { resume(x + 10) },
          22)
assert_eq(handle { cf_branch(2) } with cf_choose(x, resume) { resume(x + 10) },
          112)

// for-in body performs (desugared to while + iterator)
effect fn cf_each()
effect fn cf_iterate(xs) {
  mut acc = []
  for x in xs {
    let r = perform cf_each()
    acc.push(x + r)
  }
  acc
}
assert_eq(handle { cf_iterate([10, 20, 30]) } with cf_each(resume) { resume(1) },
          [11, 21, 31])

// break / continue inside a while carrying a perform
effect fn cf_tick()
effect fn cf_counted(n) {
  mut i = 0
  mut sum = 0
  while true {
    if i >= n { break }
    let v = perform cf_tick()
    if v == 0 { i = i + 1; continue }
    sum = sum + v
    i = i + 1
  }
  sum
}
mut cf_ticks = [1, 0, 2, 3]
mut cf_ti = 0
assert_eq(handle { cf_counted(4) } with cf_tick(resume) {
  let v = cf_ticks[cf_ti]; cf_ti = cf_ti + 1; resume(v)
}, 6)

// return early out of a loop
effect fn cf_probe()
effect fn cf_finder(n) {
  mut i = 0
  while i < n {
    let hit = perform cf_probe()
    if hit { return i }
    i = i + 1
  }
  -1
}
mut cf_hits = [false, false, true, false]
mut cf_pi = 0
assert_eq(handle { cf_finder(4) } with cf_probe(resume) {
  let h = cf_hits[cf_pi]; cf_pi = cf_pi + 1; resume(h)
}, 2)

// --- throw as a terminal statement in an effect / handle body ---
// `throw` never yields a value and never falls through, so it lowers to a
// verbatim `throw` state (like `return`, but without assigning `_eff_val`).
// The thrown value unwinds through the effect driver's native frames to the
// nearest user `try/catch`, symmetrically across the backends.

// throw in tail position of an effect fn body (after a resumed perform)
effect fn th_ask()
effect fn th_body() {
  let x = perform th_ask()
  throw "boom"
}
assert_eq(
  try { handle { th_body() } with th_ask(resume) { resume(1) } }
  catch e { "caught:" + e },
  "caught:boom")

// throw directly in a handle body (lexical position)
assert_eq(
  try {
    handle { let x = perform th_ask(); throw "hb" } with th_ask(resume) { resume(7) }
  } catch e { "caught:" + e },
  "caught:hb")

// interior throw skips the (unreachable) tail expression
effect fn th_interior() {
  let x = perform th_ask()
  throw "mid"
  x + 1
}
assert_eq(
  try { handle { th_interior() } with th_ask(resume) { resume(1) } }
  catch e { e },
  "mid")

// throw guarded by an if arm; the other arm returns normally
effect fn th_guard(flag) {
  let x = perform th_ask()
  if flag { throw "hit" } else { x }
}
assert_eq(handle { th_guard(false) } with th_ask(resume) { resume(9) }, 9)
assert_eq(
  try { handle { th_guard(true) } with th_ask(resume) { resume(9) } }
  catch e { e },
  "hit")

// a thrown effect body escapes an enclosing generator's iteration too
fn th_gen() {
  yield try { handle { th_body() } with th_ask(resume) { resume(0) } }
        catch e { "g:" + e }
}
assert_eq(th_gen().collect(), ["g:boom"])

// --- top-level `defer` in an effect / handle body ---
// A `defer` at the body's statement level registers into the computation's
// defer list (rewritten to `self.`) and runs, LIFO, when the body completes or
// throws — not when the `_step` invocation returns at a suspension. Block-scope
// semantics (a defer nested in if / while / for) and a `perform` inside a defer
// are rejected symmetrically.

// a defer registered before a suspension still runs at body completion, not
// early at the perform (the bug this fixes)
effect fn de_ask()
mut de_log = []
effect fn de_before() {
  defer { de_log.push("defer") }
  let x = perform de_ask()
  de_log.push("end")
  x
}
let de_r = handle { de_before() } with de_ask(resume) { resume(1) }
assert_eq(de_log, ["end", "defer"])
assert_eq(de_r, 1)

// LIFO across a suspension: the later-registered defer runs first
mut de_log2 = []
effect fn de_lifo() {
  defer { de_log2.push("d1") }
  let x = perform de_ask()
  defer { de_log2.push("d2") }
  de_log2.push("end")
  x
}
handle { de_lifo() } with de_ask(resume) { resume(1) }
assert_eq(de_log2, ["end", "d2", "d1"])

// a defer fires while a throw unwinds out of the body, before the catcher
mut de_log3 = []
effect fn de_throw() {
  defer { de_log3.push("defer") }
  let x = perform de_ask()
  de_log3.push("before-throw")
  throw "boom"
}
let de_r3 = try {
  handle { de_throw() } with de_ask(resume) { resume(1) }
} catch e { de_log3.push("catch"); e }
assert_eq(de_log3, ["before-throw", "defer", "catch"])
assert_eq(de_r3, "boom")

// a throw from a *called* fn (not a statement-level throw) still runs the defer
mut de_log4 = []
fn de_boom() { throw "x" }
effect fn de_callthrow() {
  defer { de_log4.push("defer") }
  let v = perform de_ask()
  de_boom()
  v
}
let de_r4 = try {
  handle { de_callthrow() } with de_ask(resume) { resume(1) }
} catch e { "caught:" + e }
assert_eq(de_log4, ["defer"])
assert_eq(de_r4, "caught:x")

// multi-shot resume: each fork completes the body, so the defer fires per fork
mut de_log5 = []
effect fn de_ch(a, b)
effect fn de_multi() {
  defer { de_log5.push("d") }
  let x = perform de_ch(1, 2)
  x * 10
}
let de_r5 = handle { de_multi() } with de_ch(a, b, resume) { [resume(a), resume(b)] }
assert_eq(de_r5, [10, 20])
assert_eq(de_log5, ["d", "d"])

// a defer directly in a handle body (lexical) runs at the body's end
mut de_log6 = []
let de_r6 = handle {
  defer { de_log6.push("defer") }
  let x = perform de_ask()
  de_log6.push("end")
  x + 1
} with de_ask(resume) { resume(4) }
assert_eq(de_log6, ["end", "defer"])
assert_eq(de_r6, 5)

// an abort (a handler that never resumes) abandons the body; the driver runs
// the reached defers of the discarded computation. A defer AFTER the aborting
// perform was never reached, so it does not run.
mut de_log7 = []
effect fn de_fail()
effect fn de_abort() {
  defer { de_log7.push("reached") }
  perform de_fail()
  defer { de_log7.push("unreached") }
  99
}
let de_r7 = handle { de_abort() } with de_fail(resume) { "aborted" }
assert_eq(de_r7, "aborted")
assert_eq(de_log7, ["reached"])

// abort through a delegate chain: each abandoned frame's defer runs, deepest
// (innermost) first
mut de_log8 = []
effect fn de_inner() {
  defer { de_log8.push("inner") }
  perform de_fail()
  0
}
effect fn de_outer() {
  defer { de_log8.push("outer") }
  de_inner()
  0
}
let de_r8 = handle { de_outer() } with de_fail(resume) { "ab" }
assert_eq(de_r8, "ab")
assert_eq(de_log8, ["inner", "outer"])

// an escaping continuation (a full-control handler that saves `resume` and
// invokes it after the handle returns) must NOT finalize early: the body's
// defers run when the resumed fork completes, not when the handle returns
mut de_log9 = []
mut de_saved = nil
effect fn de_esc() {
  defer { de_log9.push("pre") }
  let x = perform de_fail()
  de_log9.push("resumed")
  defer { de_log9.push("post") }
  x + 100
}
let de_r9 = handle { de_esc() } with de_fail(resume) { de_saved = resume; "paused" }
de_log9.push("handle:" + de_r9)
let de_r9b = de_saved(42)
assert_eq(de_log9, ["handle:paused", "resumed", "post", "pre"])
assert_eq(de_r9b, 142)

// a defer also runs when an abort *signal* (not a driven abort clause) unwinds
// through a driver. An effect fn bare-called from ordinary code is driven by
// _run_comp; a `perform` handled by an abort clause aborts natively through it,
// abandoning the frame — whose defer must still run.
mut de_log10 = []
effect fn de_sig_op()
effect fn de_sig_f() {
  defer { de_log10.push("f-defer") }
  perform de_sig_op()
  0
}
fn de_sig_plain() { de_sig_f() }   // bare call → _run_comp
let de_r10 = handle { de_sig_plain() } with de_sig_op(resume) { "aborted" }
assert_eq(de_r10, "aborted")
assert_eq(de_log10, ["f-defer"])

// an abort signal that crosses an inner handle (targeting an outer one) unwinds
// through the inner _drive: the inner handle body's defer runs before the signal
// keeps unwinding to the outer handle
mut de_log11 = []
effect fn de_outer_op()
effect fn de_inner_op()
fn de_cross_plain() { perform de_outer_op() }
let de_r11 = handle {
  handle {
    defer { de_log11.push("inner-defer") }
    de_cross_plain()
    0
  } with de_inner_op(resume) { "never" }
} with de_outer_op(resume) { "outer" }
assert_eq(de_r11, "outer")
assert_eq(de_log11, ["inner-defer"])

// a regular `throw` (not an abort signal) unwinding through a delegate chain
// abandons every ancestor frame on the way out, not just the one that threw:
// `_step` finalizes the throwing frame itself, the driver finalizes the rest.
mut de_log12 = []
effect fn de_thrower() {
  defer { de_log12.push("inner") }
  throw { kind: "E", message: "boom" }
}
effect fn de_delegator() {
  defer { de_log12.push("outer") }
  de_thrower()
  0
}
let de_r12 = try { handle { de_delegator() } with dummy(r) { 0 } } catch e { "caught:" + e.message }
assert_eq(de_r12, "caught:boom")
assert_eq(de_log12, ["inner", "outer"])

// soundness: a full-control handler that stores `resume` and then throws (for
// an unrelated reason) must not finalize the stored continuation early — it
// stays viable to resume later, and its defer fires once, on that resume
mut de_log13 = []
mut de_saved13 = nil
effect fn de_esc2() {
  defer { de_log13.push("body-defer") }
  perform de_fail() + 1
}
let de_out13 = try {
  handle { de_esc2() } with de_fail(resume) { de_saved13 = resume; throw { kind: "E", message: "h" } }
} catch e { "caught:" + e.message }
assert_eq(de_out13, "caught:h")
assert_eq(de_log13, [])
assert_eq(de_saved13(41), 42)
assert_eq(de_log13, ["body-defer"])

// a tail clause that throws BEFORE its trailing resume can never have saved
// the continuation, so the suspended body is abandoned for good: its defer
// runs as the throw unwinds — under driven dispatch...
mut de_log14 = []
effect fn de_t14()
effect fn de_body14() {
  defer { de_log14.push("body-defer") }
  perform de_t14()
  0
}
let de_r14 = try {
  handle { de_body14() } with de_t14(resume) {
    de_log14.push("clause")
    throw { kind: "E", message: "t-threw" }
    resume(1)   // dead — its presence is what classifies the clause "t"
  }
} catch e { "caught:" + e.message }
assert_eq(de_r14, "caught:t-threw")
assert_eq(de_log14, ["clause", "body-defer"])

// ...and under direct dispatch (the effect fn bare-called from a plain fn)
mut de_log15 = []
effect fn de_body15() {
  defer { de_log15.push("body-defer") }
  perform de_t14()
  0
}
fn de_plain15() { de_body15() }
let de_r15 = try {
  handle { de_plain15() } with de_t14(resume) {
    de_log15.push("clause")
    throw { kind: "E", message: "t-threw2" }
    resume(1)   // dead — its presence is what classifies the clause "t"
  }
} catch e { "caught:" + e.message }
assert_eq(de_r15, "caught:t-threw2")
assert_eq(de_log15, ["clause", "body-defer"])

// an abort clause (never mentions resume) that throws instead of returning
// likewise abandons the body: its defer runs
mut de_log16 = []
effect fn de_body16() {
  defer { de_log16.push("body-defer") }
  perform de_t14()
  0
}
let de_r16 = try {
  handle { de_body16() } with de_t14(resume) { throw { kind: "E", message: "a-threw" } }
} catch e { "caught:" + e.message }
assert_eq(de_r16, "caught:a-threw")
assert_eq(de_log16, ["body-defer"])

// a no-handler EffectError from a driven perform abandons the frames the same
// way a clause throw does: the body's defer runs as the error unwinds
mut de_log17 = []
effect fn de_unhandled17()
effect fn de_body17() {
  defer { de_log17.push("body-defer") }
  perform de_unhandled17()
  0
}
let de_r17 = try {
  handle { de_body17() } with de_t14(resume) { resume(1) }
} catch e { "caught:" + e.kind }
assert_eq(de_r17, "caught:EffectError")
assert_eq(de_log17, ["body-defer"])

// tail clauses under driven dispatch run without capturing a continuation:
// a long chain of tail performs must not overflow the native stack (the
// driver used to nest one recursive frame per resume — ~3000 was the ceiling).
// 10000 is comfortably past that ceiling; going higher only buys interp time
// (each perform runs the CPS driver, ~166 us under interp).
effect fn tp_tick()
effect fn tp_chain(n) {
  mut total = 0
  mut i = 0
  while i < n {
    total = total + perform tp_tick()
    i = i + 1
  }
  total
}
assert_eq(handle { tp_chain(10000) } with tp_tick(resume) { resume(1) }, 10000)

// a defer in a tail clause fires when the clause returns — BEFORE the
// continuation proceeds — identically under direct dispatch (plain-fn
// perform) and driven dispatch (effect-fn body perform)
mut tp_log1 = []
effect fn tp_op1()
fn tp_plain() {
  let v = perform tp_op1()
  tp_log1.push("after")
  v
}
handle { tp_plain() } with tp_op1(resume) {
  defer { tp_log1.push("clause-defer") }
  resume(1)
}
assert_eq(tp_log1, ["clause-defer", "after"])

mut tp_log2 = []
effect fn tp_op2()
effect fn tp_driven() {
  let v = perform tp_op2()
  tp_log2.push("after")
  v
}
handle { tp_driven() } with tp_op2(resume) {
  defer { tp_log2.push("clause-defer") }
  resume(1)
}
assert_eq(tp_log2, ["clause-defer", "after"])

// the driven tail path still applies the return clause to the final value
let tp_r = handle { tp_chain(3) } with tp_tick(resume) { resume(10) }
  with return(v) { v * 2 }
assert_eq(tp_r, 60)

// A-normalization reaches inside a control-flow body (uniform with top level)
effect fn cf_qty()
effect fn cf_accumulate(n) {
  mut total = 0
  mut i = 0
  while i < n {
    total = total + perform cf_qty() * 2
    i = i + 1
  }
  total
}
assert_eq(handle { cf_accumulate(3) } with cf_qty(resume) { resume(5) }, 30)

// nested control flow: for inside if
effect fn cf_gen()
effect fn cf_nested(flag) {
  if flag {
    mut s = 0
    for x in [1, 2, 3] {
      s = s + perform cf_gen() + x
    }
    s
  } else {
    0
  }
}
assert_eq(handle { cf_nested(true) } with cf_gen(resume) { resume(10) }, 36)
assert_eq(handle { cf_nested(false) } with cf_gen(resume) { resume(10) }, 0)

// a non-suspending loop in tail position runs verbatim; the loop's value is nil
effect fn cf_side()
mut cf_log = []
effect fn cf_trailing_loop() {
  let r = perform cf_side()
  for x in [1, 2] { cf_log.push(x + r) }
}
assert_eq(handle { cf_trailing_loop() } with cf_side(resume) { resume(10) }, nil)
assert_eq(cf_log, [11, 12])

// a non-suspending if in tail position still yields its branch value
effect fn cf_pick()
effect fn cf_tail_if() {
  let r = perform cf_pick()
  if r > 0 { "pos" } else { "neg" }
}
assert_eq(handle { cf_tail_if() } with cf_pick(resume) { resume(5) }, "pos")
assert_eq(handle { cf_tail_if() } with cf_pick(resume) { resume(-5) }, "neg")

// return of an expression-nested perform, from an if nested in a while
effect fn cf_seek()
effect fn cf_ret_in_loop(n) {
  mut i = 0
  while i < n {
    if i == 2 { return perform cf_seek() * 10 }
    i = i + 1
  }
  -1
}
assert_eq(handle { cf_ret_in_loop(5) } with cf_seek(resume) { resume(3) }, 30)

// nested while, perform in the inner loop
effect fn cf_unit()
effect fn cf_grid(n, m) {
  mut sum = 0
  mut i = 0
  while i < n {
    mut j = 0
    while j < m {
      sum = sum + perform cf_unit()
      j = j + 1
    }
    i = i + 1
  }
  sum
}
assert_eq(handle { cf_grid(2, 3) } with cf_unit(resume) { resume(1) }, 6)

// A-normalization inside an if-branch inside a while
effect fn cf_val()
effect fn cf_branch_anf(n) {
  mut total = 0
  mut i = 0
  while i < n {
    if i % 2 == 0 { total = total + perform cf_val() + i }
    i = i + 1
  }
  total
}
assert_eq(handle { cf_branch_anf(4) } with cf_val(resume) { resume(5) }, 12)

// === nested handles =====================================================
// A `handle` may nest inside another (the per-class resume parameter is unique,
// so an inner computation no longer shadows an enclosing one). `perform`
// resolves up the dynamically-scoped handler stack, so an inner body can
// delegate an effect to an outer handler.

// inner handled locally; a separate outer effect delegates up the stack
effect fn nh_inner()
effect fn nh_outer()
let nh1 = handle {
  let a = handle { perform nh_inner() } with nh_inner(resume) { resume(5) }
  let b = perform nh_outer()
  a + b
} with nh_outer(resume) { resume(10) }
assert_eq(nh1, 15)

// multi-effect: an inner body performs two ops; one handled here, one delegated
effect fn nh_a()
effect fn nh_b()
let nh2 = handle {
  handle {
    let x = perform nh_a()
    let y = perform nh_b()
    x + y
  } with nh_a(resume) { resume(1) }
} with nh_b(resume) { resume(2) }
assert_eq(nh2, 3)

// === multiple handler clauses ===========================================
// One `handle` may carry several `with` clauses (one per effect operation);
// an operation resolves up the dynamically-scoped frame stack. An optional
// `with return(v) { … }` clause maps the normal-completion value.

// state effect: get + put threaded through a cell by two clauses
effect fn mc_get()
effect fn mc_put(v)
effect fn mc_counter() {
  let a = perform mc_get()
  perform mc_put(a + 1)
  let b = perform mc_get()
  b
}
mut mc_cell = 10
let mc_r = handle {
  mc_counter()
} with mc_get(resume) {
  resume(mc_cell)
} with mc_put(v, resume) {
  mc_cell = v
  resume(nil)
}
assert_eq(mc_r, 11)
assert_eq(mc_cell, 11)

// three clauses + control-flow body
effect fn mc_ask(i)
effect fn mc_log(m)
effect fn mc_done()
effect fn mc_session(n) {
  mut total = 0
  mut i = 0
  while i < n {
    let x = perform mc_ask(i)
    perform mc_log(x)
    total = total + x
    i = i + 1
  }
  perform mc_done()
  total
}
mut mc_logs = []
let mc_s = handle {
  mc_session(3)
} with mc_ask(i, resume) {
  resume(i * 10)
} with mc_log(m, resume) {
  mc_logs.push(m)
  resume(nil)
} with mc_done(resume) {
  resume(nil)
}
assert_eq(mc_s, 30)
assert_eq(mc_logs, [0, 10, 20])

// a duplicate clause for one effect is rejected (parse-time, symmetric)
// (see the reject corpus; not asserted here since it aborts the module)

// return clause maps the normal-completion value
effect fn rc_ask()
let rc_r = handle {
  let x = perform rc_ask()
  x
} with rc_ask(resume) {
  resume(5)
} with return(v) {
  v + 100
}
assert_eq(rc_r, 105)

// return clause is NOT applied when a handler aborts (never resumes)
effect fn rc_fail()
let rc_a = handle {
  perform rc_fail()
  99
} with rc_fail(resume) {
  -1
} with return(v) {
  v + 100
}
assert_eq(rc_a, -1)

// return clause + multiple clauses + control flow: wrap the result
effect fn rc_q(i)
effect fn rc_note(m)
mut rc_notes = []
let rc_s = handle {
  mut total = 0
  mut i = 0
  while i < 3 {
    let x = perform rc_q(i)
    perform rc_note(x)
    total = total + x
    i = i + 1
  }
  total
} with rc_q(i, resume) {
  resume(i + 1)
} with rc_note(m, resume) {
  rc_notes.push(m)
  resume(nil)
} with return(v) {
  { sum: v, count: rc_notes.size() }
}
assert_eq(rc_s.sum, 6)
assert_eq(rc_s.count, 3)
assert_eq(rc_notes, [1, 2, 3])

// --- multi-shot resume: a handler may resume the same continuation N times ---

// single suspension, resumed twice
effect fn ms_choose(a, b)
effect fn ms_collect() {
  let x = perform ms_choose(1, 2)
  x * 10
}
let ms1 = handle { ms_collect() } with ms_choose(a, b, r) { [r(a), r(b)] }
assert_eq(ms1, [10, 20])

// two suspensions, each resumed twice -> a 2x2 tree of results
effect fn ms_pair() {
  let x = perform ms_choose(1, 2)
  let y = perform ms_choose(10, 20)
  x + y
}
let ms2 = handle { ms_pair() } with ms_choose(a, b, r) { [r(a), r(b)] }
assert_eq(ms2, [[11, 21], [12, 22]])

// the continuation spans a delegate boundary: `* 10` runs once per fork
effect fn ms_inner() { perform ms_choose(1, 2) }
let ms3 = handle { let y = ms_inner() * 10; y } with ms_choose(a, b, r) {
  [r(a), r(b)]
}
assert_eq(ms3, [10, 20])

// shallow clone aliases referenced heap values across forks
effect fn ms_log() {
  let acc = []
  let x = perform ms_choose(1, 2)
  acc.push(x)
  acc
}
mut ms_seen = []
handle { ms_log() } with ms_choose(a, b, r) {
  ms_seen.push(r(a))
  ms_seen.push(r(b))
}
assert_eq(ms_seen[0], [1, 2])   // both forks appended into the same array

// the return clause maps each fork's completion, not the aggregate
effect fn ms_id() { perform ms_choose(1, 2) }
let ms4 = handle { ms_id() } with ms_choose(a, b, r) {
  [r(a), r(b)]
} with return(v) {
  v + 100
}
assert_eq(ms4, [101, 102])

// resuming zero times (abort) still works alongside the multi-shot machinery
effect fn ms_ab() { let x = perform ms_choose(1, 2); x }
let ms5 = handle { ms_ab() } with ms_choose(a, b, r) { 99 }
assert_eq(ms5, 99)

// --- nested-handle capture: an inner handle reads/writes an enclosing binding ---

// inner handle BODY reads an enclosing computation local
effect fn cap_out()
effect fn cap_in()
effect fn cap_body() {
  let base = perform cap_out()
  handle { base + perform cap_in() } with cap_in(k) { k(100) }
}
assert_eq(handle { cap_body() } with cap_out(k) { k(5) }, 105)

// inner handler CLAUSE reads an enclosing local (interp lexically captured this,
// the JIT did not — now both reach it through `_eff_self`)
effect fn cap_body2() {
  let base = perform cap_out()
  handle { perform cap_in() } with cap_in(k) { k(base) }
}
assert_eq(handle { cap_body2() } with cap_out(k) { k(7) }, 7)

// inner handler CLAUSE mutates an enclosing local (write-back to the outer frame)
effect fn cap_tick()
effect fn cap_body3() {
  mut acc = 0
  let r = handle {
    perform cap_tick(); perform cap_tick(); "done"
  } with cap_tick(k) { acc = acc + 1; k(nil) }
  to_string(acc) + r
}
assert_eq(handle { cap_body3() } with cap_out(k) { k(nil) }, "2done")

// inner local coexists with an enclosing capture
effect fn cap_body4() {
  let base = perform cap_out()
  handle { let z = 5; base + z + perform cap_in() } with cap_in(k) { k(1) }
}
assert_eq(handle { cap_body4() } with cap_out(k) { k(100) }, 106)

// capture through two nesting levels (inner-inner reads outer-outer + mid locals)
effect fn cap_e1()
effect fn cap_e2()
effect fn cap_body5() {
  let base = perform cap_out()
  handle {
    let m = perform cap_e1()
    handle { base + m + perform cap_e2() } with cap_e2(k) { k(30) }
  } with cap_e1(k) { k(200) }
}
assert_eq(handle { cap_body5() } with cap_out(k) { k(1000) }, 1230)

// capture combined with multi-shot: each fork sees the captured binding
effect fn cap_pick(a, b)
effect fn cap_body6() {
  let base = perform cap_out()
  handle { base + perform cap_pick(1, 2) } with cap_pick(a, b, k) { [k(a), k(b)] }
}
assert_eq(handle { cap_body6() } with cap_out(k) { k(10) }, [11, 12])

// a top-level nested handle whose body reads the outer handle's local
let cap_g = handle {
  let x = perform cap_out()
  handle { x + perform cap_in() } with cap_in(k) { k(100) }
} with cap_out(k) { k(5) }
assert_eq(cap_g, 105)

// a `self.` in a string literal is NOT a capture (detection walks the AST, not
// the raw text) — a top-level handle carrying such text must not synthesize a
// `_eff_self` wrapper over a nonexistent `self`.
effect fn cap_ask()
let cap_h = handle {
  let msg = "path is self.foo"
  let v = perform cap_ask()
  v + msg.size()
} with cap_ask(k) { k(3) }
assert_eq(cap_h, 3 + 16)

// a local name that also appears as literal text inside a string / comment must
// NOT be rewritten there; only interpolation `{expr}` and code are rewritten.
effect fn sc_ask()
effect fn sc_body() {
  let base = perform sc_ask()      # comment mentioning base stays literal
  let lit = "the base rate"        # literal 'base' — untouched
  let raw = 'base'                 # single-quote raw — untouched
  let interp = "v={base} lit=base" # {base} rewritten, literal 'base' untouched
  "{base}|{lit}|{raw}|{interp}"
}
assert_eq(handle { sc_body() } with sc_ask(k) { k(5) },
          "5|the base rate|base|v=5 lit=base")

// all three comment forms (# / // / block) are skipped even when they contain a
// local name or an unbalanced quote (which would otherwise open a phantom
// string). The block comment is mid-expression (its only valid position).
effect fn cm_ask()
effect fn cm_body() {
  let base = perform cm_ask()   // don't rewrite base in this line comment
  let y = /* it's base */ base + 1
  y                             # base again, still literal
}
assert_eq(handle { cm_body() } with cm_ask(k) { k(10) }, 11)

// an effectful `effect fn` called outside a driver raises EffectError instead
// of returning an un-driven computation object — both in ordinary code and in a
// handler clause (neither is a `_step`, so `__Eff.stepping()` is false there).
effect fn cl_g()
effect fn cl_f() { let v = perform cl_g(); v * 2 }
let cl_bare = try { cl_f(); "no-error" } catch e { e.kind }
assert_eq(cl_bare, "EffectError")

effect fn cl_x()
let cl_in_clause = handle { perform cl_x() } with cl_x(k) {
  let caught = try { cl_f(); "no-error" } catch e { e.kind }
  k(caught)
}
assert_eq(cl_in_clause, "EffectError")

// but a delegate call (effect fn from another effect fn / a handle body) still
// runs under the driver
effect fn cl_inner() { let a = perform cl_g(); a + 1 }
effect fn cl_outer() { let b = cl_inner(); b * 10 }
assert_eq(handle { cl_outer() } with cl_g(k) { k(5) }, 60)

// `self.`-lookalike text inside a string survives a capturing nested handle
// (the capture redirects are string-aware, like the locals rewrite)
effect fn sc2_o()
effect fn sc2_i()
effect fn sc2_body() {
  let base = perform sc2_o()
  handle {
    let m = "path is self.foo"
    to_string(base) + "|" + m + "|" + to_string(perform sc2_i())
  } with sc2_i(k) { k(1) }
}
assert_eq(handle { sc2_body() } with sc2_o(k) { k(5) }, "5|path is self.foo|1")

// --- named fns and generators inside effect / handle bodies ---------------
// A named fn declared at the body's statement level persists across
// suspensions (it lives as an instance field, bound through the `_eff_self`
// IIFE so references to effect locals stay symmetric).
effect fn nf_ask()
effect fn nf_body() {
  fn h(n) { n * 2 }
  let x = perform nf_ask()
  h(x)
}
assert_eq(handle { nf_body() } with nf_ask(k) { k(5) }, 10)

// recursion through the instance field
effect fn nf_rec() {
  let base = perform nf_ask()
  fn fact(n) {
    if n <= 1 { return base }
    n * fact(n - 1)
  }
  fact(4)
}
assert_eq(handle { nf_rec() } with nf_ask(k) { k(1) }, 24)

// a nested named generator fn captures effect locals and works in an effect
// body, a handle body, and a handler clause; the fragment re-parse runs the
// generator chain over it
effect fn yg_body() {
  let x = perform nf_ask()
  fn g(n) {
    yield n
    yield n + x
  }
  g(10).collect()
}
assert_eq(handle { yg_body() } with nf_ask(k) { k(5) }, [10, 15])

let yg_handle = handle {
  let x = perform nf_ask()
  fn g2(n) { yield n; yield n * x }
  g2(3).collect()
} with nf_ask(k) { k(7) }
assert_eq(yg_handle, [3, 21])

let yg_clause = handle { perform nf_ask() } with nf_ask(k) {
  fn g3() { yield 1; yield 2 }
  k(g3().collect())
}
assert_eq(yg_clause, [1, 2])

// for-in and yield-from inside the nested generator
fn yg_base() { yield 100; yield 200 }
effect fn yg_mix() {
  let x = perform nf_ask()
  fn g4() {
    for v in [1, 2] { yield v + x }
    yield from yg_base()
  }
  g4().collect()
}
assert_eq(handle { yg_mix() } with nf_ask(k) { k(10) }, [11, 12, 100, 200])

// multi-shot resume across a body that defines a nested generator
effect fn yg_choose()
effect fn yg_ms() {
  let b = perform yg_choose()
  fn g5(n) { yield n; yield n + 1 }
  g5(b).collect()
}
assert_eq(handle { yg_ms() } with yg_choose(k) { [k(10), k(20)] },
          [[10, 11], [20, 21]])

// a named fn in a CPS-visited tail `if` arm works too
effect fn yg_tail() {
  let x = perform nf_ask()
  if x > 0 {
    fn g6() { yield x }
    g6().collect()
  }
}
assert_eq(handle { yg_tail() } with nf_ask(k) { k(3) }, [3])

// (bare yield / a named fn buried in verbatim control flow stay parse-time
// SyntaxErrors — verified manually on both backends, not runnable here)

// --- effect constructs inside generator bodies ----------------------------
// A self-contained `handle` expression works inside a generator body: the
// effects pass follows the fragment registry to slice it from the
// generator-lowered buffer. (A bare `perform` / an `effect fn` decl inside a
// generator stay parse-time SyntaxErrors.)
effect fn eg_ask()
fn eg_g1() {
  let v = handle { perform eg_ask() + 1 } with eg_ask(k) { k(10) }
  yield v
  yield v * 2
}
assert_eq(eg_g1().collect(), [11, 22])

// in the yielded expression
fn eg_g2() {
  yield handle { perform eg_ask() } with eg_ask(k) { k(5) }
  yield 9
}
assert_eq(eg_g2().collect(), [5, 9])

// the handle body captures a generator local (redirected to the _Gen
// instance through the `_eff_self` machinery)
fn eg_g3(n) {
  let base = n * 10
  let v = handle { base + perform eg_ask() } with eg_ask(k) { k(n) }
  yield v
}
assert_eq(eg_g3(3).collect(), [33])

// inside a yielding for-in loop (desugared before the effects pass runs)
fn eg_g4() {
  for i in [1, 2] {
    let v = handle { perform eg_ask() * i } with eg_ask(k) { k(100) }
    yield v
  }
}
assert_eq(eg_g4().collect(), [100, 200])

// delegation to an effectful effect fn from inside a generator's handle
effect fn eg_dbl() { perform eg_ask() * 2 }
fn eg_g5() {
  yield handle { eg_dbl() } with eg_ask(k) { k(21) }
}
assert_eq(eg_g5().collect(), [42])

// multi-shot resume inside a generator's handle
fn eg_g6() {
  let r = handle { perform eg_ask() } with eg_ask(k) { [k(1), k(2)] }
  yield r
}
assert_eq(eg_g6().collect(), [[1, 2]])

// both directions at once: a generator nested in an effect body, itself
// containing a handle that reads the effect body's local
effect fn eg_outer() {
  let x = perform eg_ask()
  fn inner_gen() {
    yield handle { perform eg_ask() + x } with eg_ask(k) { k(100) }
  }
  inner_gen().collect()
}
assert_eq(handle { eg_outer() } with eg_ask(k) { k(7) }, [107])

// a named fn works at a nested handle's statement level (find_nested_fndef
// stops at HANDLE — the effects pass validates fns inside it)
effect fn nh_a()
effect fn nh_b()
effect fn nh_wrap() {
  let x = perform nh_a()
  let y = handle { fn hf(n) { n * 2 }; hf(3) } with nh_b(k) { k(0) }
  x + y
}
assert_eq(handle { nh_wrap() } with nh_a(k) { k(1) }, 7)

// ... and inside a generator body's handle
fn nh_gen() {
  yield handle { fn hg(n) { n + 1 }; hg(1) } with nh_b(k) { k(0) }
}
assert_eq(nh_gen().collect(), [2])

// extra whitespace in the decl header is fine (the field emission slices
// past the name token, not a textual prefix)
effect fn ws_body() {
  fn  wsf(n) { n * 2 }
  let x = perform nh_a()
  wsf(x)
}
assert_eq(handle { ws_body() } with nh_a(k) { k(5) }, 10)
