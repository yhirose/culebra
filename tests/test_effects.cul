// Conformance: algebraic effects (thin slice).
// `effect fn` / `perform` / `handle … with` lower, at parse time, onto
// synthesized computation classes + the `__Eff` runtime (dynamically-scoped
// handler stack + multi-shot resume). All three backends run the lowered code,
// so behaviour is symmetric by construction. This slice covers straight-line
// bodies, statement-level performs, one-shot and multi-shot resume, dynamic
// scope (perform inside a called effect fn), A-normalization, control-flow
// bodies (if / while / for with break / continue / return), nested handles,
// and multiple handler clauses.

// --- dynamic scope: perform inside a called effect fn ---
effect fn get()

effect fn compute() {
  let x = perform get()
  x * 2
}

let r = handle {
  compute()
} with get(resume) {
  resume(21)
}
assert_eq(r, 42)

// --- perform directly in a handle body (lexical) ---
effect fn ask()
let a = handle {
  let x = perform ask()
  x + 1
} with ask(resume) {
  resume(10)
}
assert_eq(a, 11)

// --- handler aborts (never resumes): body tail is skipped ---
effect fn fail()
effect fn risky() {
  perform fail()
  99  // unreachable when the handler doesn't resume
}
let b = handle {
  risky()
} with fail(resume) {
  -1
}
assert_eq(b, -1)

// --- effect op with an argument + multiple sequential performs ---
effect fn emit(v)
effect fn producer() {
  perform emit(1)
  perform emit(2)
  "done"
}
mut seen = []
let c = handle {
  producer()
} with emit(v, resume) {
  seen.push(v)
  resume(nil)
}
assert_eq(seen, [1, 2])
assert_eq(c, "done")

// --- resume value flows back as the perform expression's value ---
effect fn twice(n)
effect fn doubler() {
  let y = perform twice(5)
  y + 100
}
let d = handle {
  doubler()
} with twice(n, resume) {
  resume(n * 2)  // n=5 -> resume 10 -> y=10 -> 110
}
assert_eq(d, 110)

// --- a fresh computation per call: handles are independent ---
let e1 = handle { compute() } with get(resume) { resume(1) }
let e2 = handle { compute() } with get(resume) { resume(7) }
assert_eq(e1, 2)
assert_eq(e2, 14)

// --- effect-free code is completely unaffected ---
fn plain(n) {
  n * n
}
assert_eq(plain(6), 36)

// === A-normalization: expression-nested perform ==========================
// A `perform` buried in an expression is hoisted, at parse time, to a
// statement-level binding (ANF) so the straight-line splitter lowers it.
// Only unconditionally-evaluated positions are supported; a perform in a
// short-circuit / ternary operand or behind a method chain is rejected
// symmetrically (see the reject cases at the bottom).

// perform in a binary expression
effect fn anf_get()
effect fn anf_binary() {
  let x = perform anf_get() + 1
  x
}
assert_eq(handle { anf_binary() } with anf_get(resume) { resume(41) }, 42)

// perform as a positional call argument
fn add2(a, b) {
  a + b
}
effect fn anf_arg() {
  let y = add2(perform anf_get(), 2)
  y
}
assert_eq(handle { anf_arg() } with anf_get(resume) { resume(40) }, 42)

// two performs, left-to-right evaluation order
mut anf_order = []
effect fn anf_emit(v)
effect fn anf_two() {
  let z = perform anf_emit(1) + perform anf_emit(2)
  z
}
let anf_r = handle { anf_two() } with anf_emit(v, resume) {
  anf_order.push(v)
  resume(v * 10)
}
assert_eq(anf_order, [1, 2])
assert_eq(anf_r, 30)

// nested perform inside a perform's argument (single handler)
effect fn anf_wrap(v)
effect fn anf_nested() {
  let w = perform anf_wrap(perform anf_wrap(1))
  w
}
// inner wrap(1) -> 101; outer wrap(101) -> 201
assert_eq(
  handle { anf_nested() } with anf_wrap(v, resume) { resume(v + 100) },
  201,
)

// perform in a return expression
effect fn anf_ret() {
  return perform anf_get() * 3
}
assert_eq(handle { anf_ret() } with anf_get(resume) { resume(7) }, 21)

// perform as a subscript index
effect fn anf_index() {
  let xs = [10, 20, 30]
  let v = xs[perform anf_get()]
  v
}
assert_eq(handle { anf_index() } with anf_get(resume) { resume(1) }, 20)

// a left operand's side effect runs before the suspension it precedes
mut anf_trace = []
fn anf_se(tag, val) {
  anf_trace.push(tag)
  val
}
effect fn anf_order_fn() {
  let q = anf_se("left", 100) + perform anf_get()
  q
}
let anf_q = handle { anf_order_fn() } with anf_get(resume) {
  anf_trace.push("handler")
  resume(1)
}
assert_eq(anf_trace, ["left", "handler"])
assert_eq(anf_q, 101)

// perform as an array element
effect fn anf_arr() {
  let arr = [perform anf_get(), 2, 3]
  arr
}
assert_eq(handle { anf_arr() } with anf_get(resume) { resume(1) }, [1, 2, 3])

// === control-flow bodies ================================================
// A `perform` reachable through if / while / for (and break / continue /
// return) lowers to a flat-dispatch state machine — the same CPS shape the
// generator transform uses. `for`-in is desugared to `while` + iterator; the
// tail expression of a body is its value. Symmetric across the backends by
// construction (one lowered program).

// while + statement-level perform; the trailing expression is the value
effect fn cf_ask(i)
effect fn cf_survey(n) {
  mut total = 0
  mut i = 0
  while i < n {
    let a = perform cf_ask(i)
    total = total + a
    i = i + 1
  }
  total
}
assert_eq(handle { cf_survey(3) } with cf_ask(i, resume) { resume(i + 1) }, 6)

// if / else-if / else — each arm suspends and is the arm's value
effect fn cf_choose(x)
effect fn cf_branch(f) {
  if f == 0 { let a = perform cf_choose(0); a }
  else if f == 1 { let b = perform cf_choose(1); b * 2 }
  else { let c = perform cf_choose(2); c + 100 }
}
assert_eq(
  handle { cf_branch(0) } with cf_choose(x, resume) { resume(x + 10) },
  10,
)
assert_eq(
  handle { cf_branch(1) } with cf_choose(x, resume) { resume(x + 10) },
  22,
)
assert_eq(
  handle { cf_branch(2) } with cf_choose(x, resume) { resume(x + 10) },
  112,
)

// a postfix `if` / `unless` statement that performs
effect fn cf_note(x)
effect fn cf_tally(skip) {
  mut acc = 0
  acc = acc + perform cf_note(1)
  acc = acc + perform cf_note(10) unless skip
  acc = acc + perform cf_note(100) if skip
  acc
}
assert_eq(handle { cf_tally(false) } with cf_note(x, resume) { resume(x) }, 11)
assert_eq(handle { cf_tally(true) } with cf_note(x, resume) { resume(x) }, 101)

// a bare block that performs, nested or inside an arm
effect fn cf_blocks(flag) {
  mut acc = 0
  { acc = acc + perform cf_note(1) }
  { { acc = acc + perform cf_note(10) } }
  if flag { { acc = acc + perform cf_note(100) } }
  acc
}
assert_eq(handle { cf_blocks(true) } with cf_note(x, resume) { resume(x) }, 111)

// a bare block yields nil in tail position, as in any fn
effect fn cf_tail_block() {
  { perform cf_note(1); 5 }
}
assert_eq(handle { cf_tail_block() } with cf_note(x, resume) { resume(x) }, nil)

// a promoted local destructured twice in one stretch of the body
effect fn cf_redestructure() {
  mut a = 0
  mut b = 0
  let n = perform cf_note(10)
  (a, (b,)) = (1, (2,))
  (a, (b,)) = (a + n, (b + 20,))
  a + b
}
assert_eq(handle { cf_redestructure() } with cf_note(x, resume) { resume(x) }, 33)

// for-in body performs (desugared to while + iterator)
effect fn cf_each()
effect fn cf_iterate(xs) {
  mut acc = []
  for x in xs {
    let r = perform cf_each()
    acc.push(x + r)
  }
  acc
}
assert_eq(
  handle { cf_iterate([10, 20, 30]) } with cf_each(resume) { resume(1) },
  [11, 21, 31],
)
// A block's only statement takes the block's braces as its range in the
// tree: the desugar must replace the loop alone (the body's, an arm's)
effect fn cf_sole_for(xs) {
  for x in xs { perform cf_note(x) }
}
effect fn cf_arm_for(xs) {
  if true { for x in xs { perform cf_note(x) } }
  nil
}
mut cf_sole_seen = []
handle { cf_sole_for([1, 2]); cf_arm_for([3]) } with cf_note(x, resume) {
  cf_sole_seen.push(x)
  resume(nil)
}
assert_eq(cf_sole_seen, [1, 2, 3])
// ...and so must the lowering of a postfix `if` on a destructuring
effect fn cf_sole_postfix(c) {
  mut a = 0
  mut b = 0
  perform cf_note(0)
  if true { (a, b) = (1, 2) if c }
  [a, b]
}
assert_eq(handle { cf_sole_postfix(true) } with cf_note(x, resume) { resume(x) }, [1, 2])
assert_eq(handle { cf_sole_postfix(false) } with cf_note(x, resume) { resume(x) }, [0, 0])

// break / continue inside a while carrying a perform
effect fn cf_tick()
effect fn cf_counted(n) {
  mut i = 0
  mut sum = 0
  while true {
    if i >= n { break }
    let v = perform cf_tick()
    if v == 0 { i = i + 1; continue }
    sum = sum + v
    i = i + 1
  }
  sum
}
mut cf_ticks = [1, 0, 2, 3]
mut cf_ti = 0
assert_eq(
  handle { cf_counted(4) } with cf_tick(resume) {
  let v = cf_ticks[cf_ti]; cf_ti = cf_ti + 1; resume(v)
},
  6,
)

// return early out of a loop
effect fn cf_probe()
effect fn cf_finder(n) {
  mut i = 0
  while i < n {
    let hit = perform cf_probe()
    if hit { return i }
    i = i + 1
  }
  -1
}
mut cf_hits = [false, false, true, false]
mut cf_pi = 0
assert_eq(
  handle { cf_finder(4) } with cf_probe(resume) {
  let h = cf_hits[cf_pi]; cf_pi = cf_pi + 1; resume(h)
},
  2,
)

// --- throw as a terminal statement in an effect / handle body ---
// `throw` never yields a value and never falls through, so it lowers to a
// verbatim `throw` state (like `return`, but without assigning `_eff_val`).
// The thrown value unwinds through the effect driver's native frames to the
// nearest user `try/catch`, symmetrically across the backends.

// throw in tail position of an effect fn body (after a resumed perform)
effect fn th_ask()
effect fn th_body() {
  let x = perform th_ask()
  throw "boom"
}
assert_eq(try {
  handle { th_body() } with th_ask(resume) { resume(1) }
} catch e {
  "caught:" + e
}, "caught:boom")

// throw directly in a handle body (lexical position)
assert_eq(try {
  handle { let x = perform th_ask(); throw "hb" } with th_ask(resume) { resume(7) }
} catch e {
  "caught:" + e
}, "caught:hb")

// interior throw skips the (unreachable) tail expression
effect fn th_interior() {
  let x = perform th_ask()
  throw "mid"
  x + 1
}
assert_eq(try {
  handle { th_interior() } with th_ask(resume) { resume(1) }
} catch e {
  e
}, "mid")

// throw guarded by an if arm; the other arm returns normally
effect fn th_guard(flag) {
  let x = perform th_ask()
  if flag { throw "hit" } else { x }
}
assert_eq(handle { th_guard(false) } with th_ask(resume) { resume(9) }, 9)
assert_eq(try {
  handle { th_guard(true) } with th_ask(resume) { resume(9) }
} catch e {
  e
}, "hit")

// a thrown effect body escapes an enclosing generator's iteration too
fn th_gen() {
  yield try {
    handle { th_body() } with th_ask(resume) { resume(0) }
  } catch e {
    "g:" + e
  }
}
assert_eq(th_gen().collect(), ["g:boom"])

// --- promoted body locals stay values, not methods -------------------------
// The effects lowering moves a body's locals to `self` (PromotedLocals,
// rewrite_locals_to_self in state_lowering.h), so a local promoted onto an
// _EffComp_ / _EffBody_ state object must read back unbound. Both backends
// agreed while this was broken, so difftest cannot see it; these need value
// asserts.
fn pl_mk_plain() {
  return fn () {
    1
  }
}
fn pl_mk_self() {
  return fn () {
    self
  }
}
effect fn pl_ask()

// _EffComp_: an effectful fn's body
effect fn pl_comp() {
  let f = pl_mk_plain()
  let s = pl_mk_self()
  let holder = { tag: "holder" }
  holder.s = s
  perform pl_ask()
  [f == f, holder.s().tag]
}
assert_eq(
  handle { pl_comp() } with pl_ask(resume) { resume(nil) },
  [true, "holder"],
)

// _EffBody_: the handle body itself
assert_eq(
  handle {
  let f = pl_mk_plain()
  let s = pl_mk_self()
  let holder = { tag: "holder" }
  holder.s = s
  perform pl_ask()
  [f == f, holder.s().tag]
} with pl_ask(resume) { resume(nil) },
  [true, "holder"],
)

// --- a class or enum declared in a split body -------------------------------
// Its name is promoted like any local, so the declaration has to store the
// value into the slot every later reference reads, before the suspension and
// after it. A named fn always did.
effect fn td_ask()

effect fn td_comp() {
  class TdCounter {
    new(.n) {}
    next() {
      TdCounter(self.n + 1)
    }
  }
  let early = TdCounter(1).n
  let a = perform td_ask()
  [early, TdCounter(a).next().n]
}
assert_eq(handle { td_comp() } with td_ask(resume) { resume(5) }, [1, 6])

assert_eq(
  handle {
  enum TdLight {
    Red,
    Green,
  }
  @derive(Eq)
  class TdPt {
    new(.x) {}
  }
  let a = perform td_ask()
  [TdLight.Green == TdLight.Green, TdPt(a) == TdPt(a), TdPt(a).x]
} with td_ask(resume) { resume(7) },
  [true, true, 7],
)

// a generic named fn is stored under its name, not its head
assert_eq(
  handle {
  fn td_idt<T>(x: T) {
    x
  }
  let a = perform td_ask()
  td_idt(a)
} with td_ask(resume) { resume(6) },
  6,
)

// a member reads its class's name off its receiver, as in plain code, so
// nothing it captures is held back by a cycle through its own class: the
// resource it captured is dropped when the computation ends
let td_log = []
class TdRes {
  new() {}
  drop() {
    td_log.push("dropped")
  }
}

fn td_plain() {
  let r = TdRes()
  class TdSelf {
    new() {}
    again() {
      [TdSelf(), r]
    }
  }
  TdSelf().again()[0] != nil
}
td_plain()

effect fn td_cyc() {
  let r = TdRes()
  class TdSelf {
    new() {}
    again() {
      [TdSelf(), r]
    }
  }
  let _ = perform td_ask()
  TdSelf().again()[0] != nil
}
handle { td_cyc() } with td_ask(resume) { resume(0) }
assert_eq(td_log, ["dropped", "dropped"])

// a member's own named fns are the member's locals, so a class holding one is
// accepted wherever it stands in the body, a block no suspension splits too
let td_calc = []
effect fn td_member_fn() {
  let base = 100
  if true {
    class TdCalc {
      new(.n) {}
      calc() {
        fn helper(x) {
          TdCalc(x + base).n
        }
        helper(self.n)
      }
    }
    td_calc.push(TdCalc(1).calc())
  }
  let a = perform td_ask()
  a
}
assert_eq(handle { td_member_fn() } with td_ask(resume) { resume(4) }, 4)
assert_eq(td_calc, [101])

// one written last is the body's value, nil, as a declaration's is elsewhere
assert_eq(
  handle {
  let a = perform td_ask()
  class TdLate {
    new(.v) {}
  }
} with td_ask(resume) { resume(1) },
  nil,
)

// --- a name read before a declaration of it has run -------------------------
// The state instance knows whether a declaration of a variable it holds has
// run, as a plain fn's frame does: until one has, a closure's read is the
// NameError, and a read in the body means the variable the name meant above
// the declaration. Each pass through a loop body starts its variables afresh.
effect fn pd_ask()

effect fn pd_early() {
  let pd_c = || x
  let early = try { pd_c() } catch e { [e.kind, e.message] }
  let a = perform pd_ask()
  let x = a
  [early, pd_c()]
}
assert_eq(
  handle { pd_early() } with pd_ask(resume) { resume(7) },
  [["NameError", "undefined variable 'x'"], 7],
)

assert_eq(
  handle {
  let pd_v = "outer"
  mut seen = []
  for i in [1, 2] {
    (i == 1) && (let pd_v = "inner {i}")
    perform pd_ask()
    seen.push(pd_v)
  }
  seen
} with pd_ask(resume) { resume(nil) },
  ["inner 1", "outer"],
)

assert_eq(
  handle {
  false && (let pd_h = 1)
  perform pd_ask()
  try { pd_h } catch e { [e.kind, e.line, e.col] }
} with pd_ask(resume) { resume(nil) },
  ["NameError", 602, 9],
)

// a compound assignment asks before it steps
effect fn pd_step() {
  let pd_c = || (n += 1)
  let pd_d = || (m ??= 3)
  let early = [
    try { pd_c() } catch e { e.kind },
    try { pd_d() } catch e { e.kind },
  ]
  let a = perform pd_ask()
  mut n = a
  mut m = nil
  [early, pd_c(), pd_d()]
}
assert_eq(
  handle { pd_step() } with pd_ask(resume) { resume(10) },
  [["NameError", "NameError"], 11, 3],
)

// what a declaration raises reports at its `let`
effect fn pd_typed() {
  perform pd_ask()
  let pd_m: Long = "s"
  pd_m
}
let pd_typed_at = try {
  handle { pd_typed() } with pd_ask(resume) { resume(nil) }
} catch e {
  [e.kind, e.line, e.col]
}
assert_eq(pd_typed_at, ["TypeError", 628, 3])

// a skipped declaration means what the name meant above it, not a variable
// declared further down
effect fn pd_later(z) {
  mut r = nil
  {
    z && (let pd_a = 2)
    perform pd_ask()
    r = try { pd_a } catch e { e.kind }
  }
  let pd_a = 1
  let pd_c = || pd_a
  [r, pd_c()]
}
assert_eq(
  handle { pd_later(false) } with pd_ask(resume) { resume(nil) },
  ["NameError", 1],
)

// every write goes where the name points until its declaration runs, and is
// then checked against the `mut` of the declaration that ran
effect fn pd_writes(z) {
  mut a = 1
  mut log = []
  {
    z && (mut a = 10)
    perform pd_ask()
    a += 1
    (a, _) = (a * 2, 0)
    log.push(a)
  }
  log.push(a)
  !z && (let h = 1)
  z && (mut h = 2)
  log.push(try { h = 3; h } catch e { e.kind })
  z && (mut k = 1)
  let k = perform pd_ask()
  log.push(try { k = 4 } catch e { e.kind })
  log
}
assert_eq(
  [false, true].map(|z| handle { pd_writes(z) } with pd_ask(resume) { resume(0) }),
  [[4, 4, "ImmutableError", "ImmutableError"], [22, 1, 3, "ImmutableError"]],
)

// a destructuring's value is its right-hand side, the last of a block too
effect fn pd_value(z) {
  mut a = 0
  perform pd_ask()
  let t = try { [a, [pd_b]] = [5, [6]] } catch e { e.kind }
  let i = if z { {a, pd_b} = {a: 7, pd_b: 8} } else { 0 }
  [t, i, a]
}
assert_eq(
  handle { pd_value(true) } with pd_ask(resume) { resume(0) },
  [[5, [6]], {a: 7, pd_b: 8}, 7],
)

// anywhere else the right-hand side goes when the statement ends, and a store
// in it that refuses raises as it would in a plain fn
let pd_drops = []
class PdRes {
  new(.id) {}
  drop() {
    pd_drops.push("drop {self.id}")
  }
}
effect fn pd_side(c) {
  mut a = 0
  perform pd_ask()
  {a, pd_r: [pd_q]} = {a: 1, pd_r: [2], res: PdRes("side")}
  pd_drops.push("after")
  try { [a, [pd_q]] = c = [3, [4]] } catch e { [e.kind, a] }
}
assert_eq(
  handle { pd_side(0) } with pd_ask(resume) { resume(0) },
  ["ImmutableError", 1],
)
assert_eq(pd_drops, ["drop side", "after"])

// --- `self` and the two lowered bodies --------------------------------------
// An effect fn is a named declaration that cannot be a class member, so its
// lowering leaves no receiver and `self` in its body is refused at parse time
// (jit_error_pos_test.sh). A handle body is the other case: it is spliced
// where it was written, so the enclosing method's receiver survives and
// reading `self` there is ordinary code.
effect fn sf_ask()
class SelfHolder {
  new(v) {
    self.v = v
  }
  run() {
    return handle { self.v + perform sf_ask() } with sf_ask(resume) { resume(10) }
  }
  runNested() {
    return handle { (fn () { self.v })() + perform sf_ask() }
           with sf_ask(resume) { resume(100) }
  }
  runBare() {
    return handle {
      let me = self
      let w = self
        .v
      let a = perform sf_ask()
      [me.v, w, {self}.self.v, a]
    } with sf_ask(resume) { resume(self?.v) }
  }
}
assert_eq(SelfHolder.new(1).run(), 11)
assert_eq(SelfHolder.new(2).runNested(), 102)
assert_eq(SelfHolder.new(3).runBare(), [3, 3, 3, 3])

// A nested handle reads the enclosing computation through its instance, but
// the members of a class declared in its body or in a clause keep their own
// `self`.
effect fn sf_nested() {
  mut n = 1
  perform sf_ask()
  handle {
    class SfBox {
      new(.m) {}
      get() { self.m }
    }
    let a = perform sf_ask()
    "{n}:{SfBox(10).get()}:{a}"
  } with sf_ask(resume) {
    class SfTag {
      new(.m) {}
      get() { self.m }
    }
    resume(SfTag(20).get())
  }
}
assert_eq(handle { sf_nested() } with sf_ask(resume) { resume(nil) }, "1:10:20")

// Neither a label nor an object literal's own method is the body's `self`,
// and neither is a member named `self`.
assert_eq(
  handle {
  let o = {self: 3, v: 5, m: fn () { self.v }}
  let a = perform sf_ask()
  [o.self, o.m(), a]
} with sf_ask(resume) { resume(7) },
  [3, 5, 7],
)
effect fn sf_member(o) {
  perform sf_ask()
  o?.self
}
assert_eq(handle { sf_member({self: 9}) } with sf_ask(resume) { resume(nil) }, 9)

// A handle written in another's clause has clauses of its own.
effect fn sf_tell()
assert_eq(
  handle {
  perform sf_ask()
} with sf_ask(resume) {
    resume(handle { perform sf_tell() + 1 } with sf_tell(inner) { inner(40) })
  },
  41,
)
assert_eq(handle { perform sf_ask() } with sf_ask(k1) { k1(handle { perform sf_tell() } with sf_tell(k2) { k2(handle { perform sf_ask() } with sf_ask(k3) { k3(7) }) }) }, 7)
assert_eq(handle { 1 } with return(v1) { handle { v1 + 1 } with return(v2) { handle { v2 + 1 } with return(v3) { v3 * 10 } } }, 30)

// A function from outside, called bare in either body, is called with no
// receiver — the same rewrite the generator lowering shares.
effect fn sf_comp() {
  let f = pl_mk_self()
  let r = try { f(); "no error" } catch e { e.kind }
  perform sf_ask()
  r
}
assert_eq(handle { sf_comp() } with sf_ask(resume) { resume(nil) }, "NameError")
assert_eq(
  handle {
  let f = pl_mk_self()
  let r = try { f(); "no error" } catch e { e.kind }
  perform sf_ask()
  r
} with sf_ask(resume) { resume(nil) },
  "NameError",
)

// --- effect-internal break/continue over the CPS lowering ---
//
// `break` / `continue` / `nobreak` inside a suspending function run through
// the same `loop_stack` the generator transform uses, so each shape is
// pinned on both.

// nobreak does not run when the loop exits via break
effect fn ef_tick()
effect fn ef_nobreak_break(n) {
  mut i = 0
  mut out = []
  while i < n {
    i = i + 1
    let v = perform ef_tick()
    out.push(v)
    if i >= 2 { break }
  } nobreak {
    out.push(999)
  }
  out
}
assert_eq(
  handle { ef_nobreak_break(5) } with ef_tick(resume) { resume(1) },
  [1, 1],
)

// ...but does run on natural completion
effect fn ef_nobreak_natural(n) {
  mut i = 0
  mut out = []
  while i < n {
    i = i + 1
    let v = perform ef_tick()
    out.push(v)
  } nobreak {
    out.push(999)
  }
  out
}
assert_eq(
  handle { ef_nobreak_natural(2) } with ef_tick(resume) { resume(1) },
  [1, 1, 999],
)

// two CPS-managed loops: an inner break exits only the inner loop
effect fn ef_double() {
  mut outs = []
  while true {
    mut j = 0
    while true {
      j = j + 1
      if j >= 2 { break }
      outs.push(j)
    }
    outs.push(100)
    let v = perform ef_tick()
    outs.push(v)
    break
  }
  outs
}
assert_eq(
  handle { ef_double() } with ef_tick(resume) { resume(7) },
  [1, 100, 7],
)

// --- evaluation order across a suspension ---
// A `mut` the handler also reaches is read before the perform: the left
// operand is evaluated first, as anywhere else.
effect fn anf_ask()
mut anf_n = 0
let anf_sum = handle {
  let r = anf_n + perform anf_ask()
  r
} with anf_ask(resume) {
  anf_n = 1000
  resume(1)
}
assert_eq(anf_sum, 1)
anf_n = 0
let anf_pair = handle {
  let r = [anf_n, perform anf_ask()]
  r
} with anf_ask(resume) {
  anf_n = 1000
  resume(1)
}
assert_eq(anf_pair, [0, 1])

// --- locals a handle body carries across a suspension ---
// A bare `y = …` that nothing encloses, and a tuple destructure.
let eff_locals = handle {
  y = 5
  let (a, b) = (1, 2)
  let x = perform anf_ask()
  y + a + b + x
} with anf_ask(resume) {
  resume(10)
}
assert_eq(eff_locals, 18)
// A bare write to an enclosing binding stays a write to that binding.
mut eff_outer = 0
let eff_wrote = handle {
  eff_outer = 5
  let x = perform anf_ask()
  eff_outer + x
} with anf_ask(resume) {
  resume(1)
}
assert_eq(eff_wrote, 6)
assert_eq(eff_outer, 5)
// A promoted local's name as a label (object key, keyword argument,
// shorthand key) is not the local.
fn eff_label_kw(*, x = 0) { x }
let eff_labels = handle {
  let x = perform anf_ask()
  [{x: 1}, eff_label_kw(x: 2), {x}]
} with anf_ask(resume) {
  resume(7)
}
assert_eq(eff_labels, [{x: 1}, 2, {x: 7}])
// A destructured local lives across a perform, and a destructure in tail
// position is still the body's value (its right-hand side).
let eff_ds = handle {
  let [a, {b}] = [1, {b: 2}]
  let x = perform anf_ask()
  a + b + x
} with anf_ask(resume) {
  resume(10)
}
assert_eq(eff_ds, 13)
let eff_ds_tail = handle {
  let x = perform anf_ask()
  let [a, b] = [x, 2]
} with anf_ask(resume) {
  resume(1)
}
assert_eq(eff_ds_tail, [1, 2])
// A closure made on one pass of a loop keeps that pass's binding - of the
// loop variable and of a local the body declares - across a perform; one
// declared outside the loop stays one binding.
let eff_iter = handle {
  mut fs = []
  mut total = 0
  for x in [1, 2] {
    let k = x * 10
    fs.push(|| x + k)
    fs.push(fn () { total += x })
    perform anf_ask()
  }
  fs.map(|f| f()) + [total]
} with anf_ask(resume) {
  resume(nil)
}
assert_eq(eff_iter, [11, 1, 22, 3, 3])
