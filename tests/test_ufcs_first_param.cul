# Conformance: §10 (methods, UFCS). See docs/language.md §25.
#
# The candidate's half of the UFCS gate: a free function is a candidate for a
# receiver only when its first parameter accepts it. One that does not is not
# there as far as the call is concerned, so the call is the ordinary method
# miss rather than a complaint about that function's parameter.
#
# Run: ./build/culebra tests/test_ufcs_first_param.cul
#      ./build/culebra --jit tests/test_ufcs_first_param.cul

trait Greeter {
  hello() -> String
}
enum Shape {
  Circle(Float),
  Origin,
}
enum Other {
  Thing,
}
class C {
  new() {}
}
class Bob {
  new() {}
  hello() {
    'hi'
  }
}

fn message_of(f) {
  try {
    f()
    'no error'
  } catch e {
    "{e.kind}: {e.message}"
  }
}
# A method miss: the call's TypeError, naming the method no receiver answered.
fn is_miss(said, name) {
  said.starts_with(
    "TypeError: type error: expected Function, got Nil ('{name}' is not a method of ")
}

# A closure whose annotation rejects the receiver: the method miss.
let lam = fn (p: Long) {
  'lam'
}
class Caller {
  new() {}
  f() {
    self.lam(0)
  }
}
assert_true(is_miss(message_of(|| Caller().f()), 'lam'))
assert_true(is_miss(message_of(|| 'abc'.lam()), 'lam'))
assert_eq(7.lam(), 'lam')

# An untyped first parameter accepts everything, and so does `Any`.
let open_fn = fn (x, y) {
  y
}
let any_fn = fn (x: Any) {
  'any'
}
assert_eq(C().open_fn(3), 3)
assert_eq(C().any_fn(), 'any')

# A `fn` declaration is a multimethod of one overload: the same answer.
fn one(p: Long) {
  'one'
}
assert_eq(7.one(), 'one')
assert_true(is_miss(message_of(|| C().one()), 'one'))

# One accepting overload is enough; the pick over all the arguments follows.
fn two(p: Long) {
  'two-long'
}
fn two(p: String) {
  'two-string'
}
assert_eq(7.two(), 'two-long')
assert_eq('s'.two(), 'two-string')
assert_true(is_miss(message_of(|| C().two()), 'two'))
# The gate reads the receiver alone: a later argument no overload takes is
# still the dispatch's own error.
fn pair(p: Long, q: Long) {
  'pair'
}
assert_throws('DispatchError', fn () {
  7.pair('x')
})

# The annotation means what it means for an argument: union, trait, enum at
# each level, class, Object.
fn un(x: Long | String) {
  'union'
}
fn tr(x: Greeter) {
  'trait'
}
fn en(x: Shape) {
  'enum'
}
fn va(x: Shape.Circle) {
  'variant'
}
fn cc(x: C) {
  'class'
}
fn ob(x: Object) {
  'object'
}
assert_eq(5.un(), 'union')
assert_eq('s'.un(), 'union')
assert_true(is_miss(message_of(|| C().un()), 'un'))
assert_eq(Bob().tr(), 'trait')
assert_true(is_miss(message_of(|| C().tr()), 'tr'))
assert_eq(Shape.Origin.en(), 'enum')
assert_eq(Shape.Circle(1.0).en(), 'enum')
assert_eq(Shape.Circle(1.0).va(), 'variant')
assert_true(is_miss(message_of(|| Shape.Origin.va()), 'va'))
assert_true(is_miss(message_of(|| Other.Thing.en()), 'en'))
assert_eq(C().cc(), 'class')
assert_true(is_miss(message_of(|| Bob().cc()), 'cc'))
assert_eq(C().ob(), 'object')
assert_eq({a: 1}.ob(), 'object')

# No leading positional parameter declares nothing to fail.
fn rest(*xs) {
  xs.size()
}
let bare = fn () {
  __ARGS__.size()
}
assert_eq(C().rest(1, 2), 3)
assert_eq(C().bare(), 1)

# A default does not excuse the annotation: the receiver fills the slot.
fn df(p: Long = 1) {
  p
}
assert_eq(7.df(), 7)
assert_true(is_miss(message_of(|| C().df()), 'df'))

# The keyword arm sits behind the same gate.
fn kw(p: Long, k = 0) {
  p + k
}
assert_eq(5.kw(k: 1), 6)
assert_true(is_miss(message_of(|| C().kw(k: 1)), 'kw'))

# Asked before any argument runs. An object-ish miss reports after the
# argument list; a scalar has no members at all and fails at the read.
mut ran = []
fn loud(tag) {
  ran.push(tag)
  0
}
fn takes_string(s: String, n) {
  n
}
assert_true(is_miss(message_of(|| C().takes_string(loud('object'))), 'takes_string'))
assert_throws('TypeError', fn () {
  5.takes_string(loud('scalar'))
})
assert_eq(ran, ['object'])
assert_eq('s'.takes_string(loud('taken')), 0)
assert_eq(ran, ['object', 'taken'])

# The question is asked of the signature the callable presents: a bound
# method's underlying method, a native function's declared one.
class K {
  new() {}
  m(p: Long) {
    p
  }
}
let bound = K().m
assert_eq(7.bound(), 7)
assert_true(is_miss(message_of(|| C().bound()), 'bound'))
assert_eq(2.repeat('x'), ['x', 'x'])
assert_true(is_miss(message_of(|| C().repeat('x')), 'repeat'))

# The receiver's own method still wins over any candidate.
class Own {
  new() {}
  one() {
    'own'
  }
}
assert_eq(Own().one(), 'own')

# `x.drop()` sits below the gate: a free `drop` that does not accept the
# receiver leaves the call where no candidate at all would — the explicit
# drop, a no-op on a receiver with no `drop` of its own.
fn drop(x: C) {
  'free drop'
}
assert_eq(C().drop(), 'free drop')
assert_eq(Bob().drop(), nil)
assert_eq({a: 1}.drop(), nil)

println('ok')
