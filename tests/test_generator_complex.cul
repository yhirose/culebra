// Generators whose control flow goes beyond one loop with one yield in it.
//   - post-loop yield   (chunk / group_by tail flush)
//   - code after yield within a branch (chunk's `yield buf; buf = []`)
//   - multiple yields per loop iteration (intersperse)

// --- chunk: fixed-size groups + remainder flush after the loop ---
fn chunk(arr, n) {
  mut buf = []
  for v in arr {
    buf.push(v)
    if buf.size() >= n {
      yield buf
      buf = []
    }
  }
  yield buf if buf.size() > 0
}
assert_eq(chunk([1, 2, 3, 4, 5], 2).collect(), [[1, 2], [3, 4], [5]])

// chunk dividing evenly (no tail) ---
assert_eq(chunk([1, 2, 3, 4], 2).collect(), [[1, 2], [3, 4]])

// --- group_consecutive: flush last run after the loop ---
fn group_consecutive(arr) {
  mut cur = []
  mut key = nil
  for v in arr {
    if cur.size() > 0 && v != key {
      yield cur
      cur = []
    }
    cur.push(v)
    key = v
  }
  yield cur if cur.size() > 0
}
assert_eq(group_consecutive([1, 1, 2, 3, 3, 3]).collect(),
          [[1, 1], [2], [3, 3, 3]])

// --- intersperse: two yields per iteration ---
fn intersperse(arr, sep) {
  mut first = true
  for v in arr {
    yield sep if !first
    yield v
    first = false
  }
}
let s = intersperse([1, 2, 3], 0).collect()
assert_eq(s, [1, 0, 2, 0, 3])

IO.inspect('test_generator_complex OK')
