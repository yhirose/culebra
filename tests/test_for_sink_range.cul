// `for _ in a..b` walks the counted-range fast path (ForPrep/ForLoop) like
// `for i in a..b` does, binding nothing. Every shape the named form has —
// bounds, step, inclusive end, break/continue/nobreak, closures made in the
// body, the range-expression errors — must read the same through a sink.

mut count = 0
for _ in 0..3 {
  count += 1
}
assert_eq(count, 3)

count = 0
for _ in 0..=3 {
  count += 1
}
assert_eq(count, 4)

count = 0
for _ in 0..10 by 3 {
  count += 1
}
assert_eq(count, 4)

count = 0
for _ in 5..2 {
  count += 1
}
assert_eq(count, 0)

// Non-literal bounds evaluate once, before the loop, in source order.
mut log = []
let lo = fn () {
  log.push('lo')
  1
}
let hi = fn () {
  log.push('hi')
  4
}
count = 0
for _ in lo()..hi() {
  count += 1
}
assert_eq(count, 3)
assert_eq(log, ['lo', 'hi'])

// break / continue / nobreak.
count = 0
mut tail = 'none'
for _ in 0..10 {
  count += 1
  break if count == 4
} nobreak {
  tail = 'ran'
}
assert_eq(count, 4)
assert_eq(tail, 'none')

count = 0
mut odd = 0
for _ in 0..6 {
  count += 1
  continue if count % 2 == 1
  odd += 1
} nobreak {
  tail = 'ran'
}
assert_eq(odd, 3)
assert_eq(tail, 'ran')

// Closures built in the body capture the body's own per-iteration locals.
mut fns = []
for _ in 0..3 {
  let k = fns.size()
  fns.push(|| k * 10)
}
assert_eq(fns.map(|f| f()), [0, 10, 20])

// Nested sinks.
count = 0
for _ in 0..3 {
  for _ in 0..4 {
    count += 1
  }
}
assert_eq(count, 12)

// `_` is not bound by the loop: reading it is the NameError it always was.
let e = try {
  for _ in 0..1 {
    inspect(_)
  }
  nil
} catch err {
  err.kind
}
assert_eq(e, 'NameError')

// The range's own errors, unchanged: a Float bound and a zero step.
let fe = try {
  for _ in 0..1.5 {
  }
  nil
} catch err {
  err.kind
}
assert_eq(fe, 'TypeError')

let ze = try {
  for _ in 0..3 by 0 {
  }
  nil
} catch err {
  err.kind
}
assert_eq(ze, 'ValueError')

// A range VALUE (not a literal) still walks the iterator protocol.
let r = 0..3
count = 0
for _ in r {
  count += 1
}
assert_eq(count, 3)
