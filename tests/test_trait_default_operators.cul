# A trait's default method ranks with the class's own methods wherever the
# runtime calls a method by its name, not only in `x.name()`: an operator's
# dunder, `__str__`, `[]` and `[]=`, `iter` in a `for`, and `hash` and `eq`
# for a Dict key. Names that say what a value is or when it is done with
# (`next`, `has_next`, `dispose`, `drop`) are never taken from a default.
# Same across the executor, --jit and an AOT binary.

trait Num {
  v() -> Float
  __add__(o) { self.v() + o }
  __sub__(o) { self.v() - o }
  __mul__(o) { self.v() * o }
  __neg__() { -self.v() }
  __lt__(o) { self.v() < o.v() }
  __eq__(o) { self.v() == o.v() }
  __str__() { "N({self.v()})" }
  __index__(i) { self.v() + i }
  __call__(x) { self.v() * x }
}

class A {
  new(@x) {}
  v() { @x }
}

let a = A(2.0)
let b = A(3.0)
assert_eq(a + 1.0, 3.0)
assert_eq(1.0 + a, 3.0)  # `+` and `*` reflect onto the right operand
assert_eq(a - 0.5, 1.5)
assert_eq(a * 5.0, 10.0)
assert_eq(5.0 * a, 10.0)
assert_eq(-a, -2.0)
assert_true(a < b)
assert_false(b < a)
assert_true(a == A(2.0))
assert_false(a == b)
assert_eq("{a}", 'N(2.0)')
assert_eq(a[10], 12.0)
assert_eq(a(4.0), 8.0)
assert_true(a != b)
assert_eq([b, a].min(), a)
assert_eq([b, a].sorted(), [a, b])
# A callable instance stands in for a Function wherever one is asked for.
fn take(f: Function) { f(1.0) }
assert_eq(take(a), 2.0)
assert_eq([1.0, 2.0].map(a), [2.0, 4.0])

# `==` and `!=` ask a default `__eq__`, not the fields.
trait Alike {
  kind() -> Long
  __eq__(o) { self.kind() == o.kind() }
}
class E {
  new(@x) {}
  kind() { 1 }
}
assert_true(E(1) == E(2))
assert_false(E(1) != E(2))

# The class's own method outranks the default.
class Own {
  new(@x) {}
  v() { @x }
  __mul__(o) { 'own' }
}
assert_eq(Own(1.0) * 2.0, 'own')
assert_eq(Own(1.0) + 2.0, 3.0)

# `[]=` through a default.
trait Slots {
  store() -> Array
  __setindex__(i, v) { self.store()[i] = v * 10 }
}
class Box {
  new() { @xs = [0, 0] }
  store() { @xs }
}
let box = Box()
box[1] = 4
assert_eq(box.store(), [0, 40])

# `for` walks what a default `iter` answers, not the instance's keys.
trait Bagged {
  items() -> Array
  iter() { self.items().iter() }
}
class Bag {
  new(@xs) {}
  items() { @xs }
}
mut sum = 0
for x in Bag([1, 2, 3]) {
  sum += x
}
assert_eq(sum, 6)

# A Dict key hashes and compares through defaults.
trait Keyed {
  k() -> Long
  hash() { self.k() }
  eq(o) { self.k() == o.k() }
}
class K {
  new(@kk) {}
  k() { @kk }
}
let d = {}
d[K(1)] = 'one'
assert_eq(d[K(1)], 'one')
assert_eq(hash(K(7)), 7)
assert_true(Set(K(1), K(2)).contains(K(2)))

# A data field of the name outranks the default, as a method does.
class Tagged {
  new() { @hash = 'data' }
  k() { 1 }
}
assert_throws('TypeError', fn () {
  let t = {}
  t[Tagged()] = 1
})

# A trait declared after the class still reaches its instances.
class Late {
  new() {}
  w() { 4.0 }
}
let late = Late()
trait LateOps {
  w() -> Float
  __mul__(o) { self.w() * o }
}
assert_eq(late * 2.0, 8.0)

# A @value class takes the default, too.
trait Scale {
  k() -> Float
  __mul__(o) { self.k() * o }
}
@value
class V {
  kk: Float
  new(@kk) {}
  k() { @kk }
}
assert_eq(V(2.0) * 3.0, 6.0)

# An eq that @derive supplies is the class's own: it outranks a default.
trait LooseEq {
  tag() -> Long
  eq(o) { true }
}
@derive(Eq)
class P {
  new(@x) {}
  tag() { 1 }
}
assert_false(P(1) == P(2))
assert_true(P(1) == P(1))

# Two traits that each supply the operator leave it ambiguous, as for a call.
trait Left {
  l() -> Long
  __add__(o) { 'left' }
  __neg__() { 'left' }
  __call__(x) { 'left' }
  iter() { [1].iter() }
}
trait Right {
  r() -> Long
  __add__(o) { 'right' }
  __neg__() { 'right' }
  __call__(x) { 'right' }
  iter() { [2].iter() }
}
class Both {
  new() {}
  l() { 1 }
  r() { 2 }
}
assert_throws('DispatchError', fn () {
  let _ = Both() + 1
})
# The ambiguity is raised where the name is asked for: at the operator, the
# call, the `for` head or the read.
let both = Both()
fn raised_at(f) {
  try {
    f()
    nil
  } catch e {
    [e.kind, e.line, e.col]
  }
}
assert_eq(raised_at(fn () { both + 1 }), ['DispatchError', 196, 29])
assert_eq(raised_at(fn () { -both }), ['DispatchError', 197, 29])
assert_eq(raised_at(fn () { both(1) }), ['DispatchError', 198, 29])
assert_eq(raised_at(fn () { both(x: 1) }), ['DispatchError', 199, 29])
assert_eq(raised_at(fn () {
  for x in both {}
}), ['DispatchError', 201, 12])
assert_eq(raised_at(fn () { both.__add__(1) }), ['DispatchError', 203, 29])
# Asking whether it can be called does not call it: an instance two traits
# supply a `__call__` to is callable, and raises where it is called.
assert_true(both is Function)
assert_eq(match both {
  f: Function => 'callable',
  _ => 'other',
}, 'callable')
fn takes_fn(f: Function | Long) { 'taken' }
assert_eq(takes_fn(both), 'taken')

# A class that answers equality, its hash or order itself, under any of the
# names, takes no default for that question: its own `eq` over a default
# `__eq__`, its own `cmp` over a default `__lt__`, its own `eq` over a default
# `hash` (so, with no `hash` of its own, it is no key). By name, a default is
# still the method of that name.
trait Loose {
  loose() -> Long
  __eq__(o) { true }
  __lt__(o) { true }
  hash() { 42 }
}
class Ordered {
  new(@x) {}
  loose() { 1 }
  eq(o) { self.x == o.x }
  cmp(o) { self.x - o.x }
}
assert_false(Ordered(1) == Ordered(2))
assert_false(Ordered(2) < Ordered(1))
assert_eq([Ordered(2), Ordered(3), Ordered(1)].sorted().map(|o| o.x), [1, 2, 3])
assert_throws('TypeError', || Set(Ordered(1)))
assert_true(Ordered(1).__eq__(Ordered(2)))
assert_eq(Ordered(1).hash(), 42)
# What @derive supplies is the class's own as well.
@derive(Eq, Hash, Comparable)
class Derived {
  new(@x) {}
  loose() { 1 }
}
assert_false(Derived(1) == Derived(2))
assert_false(Derived(2) < Derived(1))
assert_eq(Set(Derived(1), Derived(2)).size(), 2)
# Only a method of another name in the group answers for the class: a data
# field named `hash` or `cmp` leaves the default `__eq__` or `__lt__` in place.
trait SameId {
  same_id() -> Long
  __eq__(o) { self.same_id() == o.same_id() }
  __lt__(o) { self.same_id() < o.same_id() }
}
class Commit {
  new(@n, @hash, @cmp) {}
  same_id() { @n }
}
assert_true(Commit(1, 'a', 'x') == Commit(1, 'b', 'y'))
assert_true(Commit(1, 'a', 'x') < Commit(2, 'b', 'y'))

# A default operator that declares its trait again while it runs, which
# releases the default it is running, finishes as it began: the call holds it,
# so it reads what it captured.
fn declare_adds(k) {
  trait Adds {
    w() -> Long
    __add__(o) {
      redeclare_adds()
      let n = iota(1000).map(|i| [i, "s{i}"]).size()
      self.w() + o + k + n
    }
  }
}
fn redeclare_adds() {
  trait Adds {
    w() -> Long
  }
}
declare_adds(7)
class Weighs {
  new() {}
  w() { 1 }
}
assert_eq(Weighs() + 2, 1010)

# `next`, `has_next`, `dispose` and `drop` say what a value is, or when it is
# done with: a default of one of those names is called by name only. A class
# that fits a trait whose `next()` means something else is no iterator.
trait Counter {
  current() -> Long
  next() -> Long { self.current() + 1 }
}
class Zero {
  new() { @at = 0 }
  current() { @at }
}
let z = Zero()
assert_eq(z.next(), 1)
assert_eq(z.size(), 1)
assert_eq(z.keys(), ['at'])
mut walked = []
for k, _ in z {
  walked.push(k)
}
assert_eq(walked, ['at'])

mut disposed = 0
trait Disposing {
  has_next() -> Bool
  dispose() { disposed += 1 }
}
class Two {
  new() { @n = 0 }
  has_next() { @n < 2 }
  next() {
    @n += 1
    @n
  }
}
for x in Two() {
  break
}
assert_eq(Two().map(|x| x * 2).take(1).collect(), [2])
assert_eq(disposed, 0)

# Nor is `drop`: a class that needs one defines it.
mut dropped = 0
trait Closes {
  name() -> String
  drop() { dropped += 1 }
}
class Res {
  new() {}
  name() { 'r' }
}
fn scoped() {
  let r = Res()
  r.name()
}
scoped()
assert_eq(dropped, 0)

# Last, as it reaches every class from here on: a trait that requires nothing
# fits every class, so its defaults reach them all.
class Plain {
  new() {}
}
trait Shown {
  __str__() { 'shown' }
}
assert_eq("{Plain()}", 'shown')
