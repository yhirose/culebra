# `culebra test` compiles a file as a session unit; a function's bare write
# is its own local unless the top level declared the name (the REPL side of
# the same rule is in tests/repl_test.sh).

test("first body declares its own local", fn () {
  z = 5
  assert_eq(z + 1, 6)
})

test("second body declares the same name again", fn () {
  z = 6
  assert_eq(z + 2, 8)
})

# The destructuring form takes the same road.
test("first body destructures bare", fn () {
  [a, b] = [1, 2]
  assert_eq(a + b, 3)
})

test("second body destructures the same names", fn () {
  [a, b] = [10, 20]
  assert_eq(a + b, 30)
})

# A name the file's top level did declare is still the session's: a bare
# write to it from inside a body reassigns — refused when immutable, and
# visible to the next body when not.
shared = 1
mut counter = 0

test("a top-level name is reassigned, not shadowed", fn () {
  assert_throws("ImmutableError", fn () {
    shared = 2
  })
  counter = counter + 1
})

test("the reassignment reached the session", fn () {
  assert_eq(counter, 1)
})
