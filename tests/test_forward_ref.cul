# Conformance: §6 (scope), §11 (closures), §19 (multimethod forward refs).
# See docs/language.md §25.
#
# Forward function references: a let-bound closure may reference a
# name defined later in the same scope. interp resolves through env
# binding (lazy); the JIT pre-allocates a Cell slot at scope entry
# so the closure's capture chain links to the eventual binding.

# --- (1) Top-level: closure → forward let ---
let calls_f = fn () {
  f() + 1
}

let f = fn () {
  41
}

assert_eq(calls_f(), 42)

# --- (2) Top-level: closure → forward class ---
let make_point = fn (x) {
  Point.new(x, x)
}

class Point {
  new(a, b) {
    self.a = a
    self.b = b
  }
}

let p = make_point(3)
assert_true(p.a == 3 && p.b == 3)

# --- (3) Top-level: closure → forward multifn ---
let dispatch = fn () {
  area(5)
}

fn area(s: Long) {
  s * s
}

assert_eq(dispatch(), 25)

# --- (4) Inside a function body: forward ref between locals ---
let outer = fn () {
  let inner_a = fn () {
    inner_b() * 2
  }
  let inner_b = fn () {
    21
  }
  inner_a()
}

assert_eq(outer(), 42)

# --- (5) Stacked forward refs (a refers to b refers to c) ---
let chain_a = fn () {
  chain_b() + 1
}
let chain_b = fn () {
  chain_c() + 1
}
let chain_c = fn () {
  40
}

assert_eq(chain_a(), 42)

# --- (6) Forward ref to an implicit binding (`g = …`, no `let`) ---
# First assignment declares, so the pre-allocated cell must accept it as the
# declaration — not mut-check it as a reassignment.
calls_g = fn () {
  g() + 1
}

g = fn () {
  41
}

assert_eq(calls_g(), 42)
assert_throws('ImmutableError', fn () {
  g = 1
})

# …and `mut` keeps its reassignability through the same cell.
reads_h = fn () {
  h
}

mut h = 1
h = 2

assert_eq(reads_h(), 2)

# --- (7b) Reading a forward ref before its declaration runs ---
# The pre-allocated cell exists as soon as a closure captures it, but the
# name stays unbound until the declaring statement executes: a read —
# direct or through the capture — is a runtime NameError on every
# backend, never a nil placeholder flowing into user code.
let cap_u = fn () {
  unbound_u + 1
}
assert_throws('NameError', cap_u)
assert_eq(try { unbound_u + 1 } catch e { e.kind }, 'NameError')
let unbound_u = 41
assert_eq(cap_u(), 42)

# Same through a forward multifn: capture, then call before the decl.
let call_mf = fn () {
  mf_u(1)
}
assert_throws('NameError', call_mf)
fn mf_u(x) {
  x + 1
}
assert_eq(call_mf(), 2)

# --- (7) Reassignment drops the recorded FUNCTION AST ---
# kwargs resolve against the binding's current value, not the literal the
# name was first declared with.
reads_k = fn () {
  k
}

mut k = fn (a = 0) {
  "a" + to_string(a)
}
k = fn (b = 0) {
  "b" + to_string(b)
}

assert_eq(k(b: 1), "b1")
assert_eq(reads_k()(b: 2), "b2")

# --- (8) A declaration only shadows from the statement that runs it ---
# Before that point the name still means whatever it meant outside, which
# is what the interp's environment chain answers. The compiled backends
# used to bind the whole statement list to the not-yet-run declaration and
# raised NameError instead.
let sh_outer = 7
{
  let sh_outer = sh_outer + 1     # reads the enclosing binding
  assert_eq(sh_outer, 8)
}
assert_eq(sh_outer, 7)

# The same across a frame boundary, with and without a capture in play.
let cross = fn () {
  let sh_outer = sh_outer + 1
  sh_outer
}
assert_eq(cross(), 8)
assert_eq(sh_outer, 7)

# A closure built before the declaration sees the declaration once it runs
# (both live in the same frame), while the enclosing binding is untouched.
let sees_later = fn () {
  let peek = fn () { sh_outer }
  let sh_outer = sh_outer + 1
  [peek(), sh_outer]
}
assert_eq(sees_later(), [8, 8])
assert_eq(sh_outer, 7)

# A plain read before a later `let` of the same name, and the `let` itself
# declaring into this frame rather than writing the captured one.
mut sh_mut = 7
let reads_then_declares = fn () {
  let before = sh_mut
  let sh_mut = 99
  [before, sh_mut]
}
assert_eq(reads_then_declares(), [7, 99])
assert_eq(sh_mut, 7)

# A reassignment that runs before the declaration writes the binding the
# name still means, with that binding's own mutability.
{
  sh_mut = 9
  let hold = fn () { sh_mut }
  let sh_mut = sh_mut + 1
  assert_eq(hold(), 10)
  assert_eq(sh_mut, 10)
}
assert_eq(sh_mut, 9)

# A block's declaration dies with the block: the read after it is the
# enclosing binding again, not the closed block's local.
let after_block = fn () {
  { let sh_outer = 1 }
  sh_outer + 1
}
assert_eq(after_block(), 8)

# Shadowing a builtin, read through a closure built before the shadow.
{
  let use_builtin = fn () { type_of(1) }
  let type_of = type_of
  assert_eq(use_builtin(), 'Long')
  assert_eq(type_of('s'), 'String')
}

# A keyword argument's label and an object pattern's key name a parameter and
# a property, not a variable of the scope they are written in. Reading them as
# variables made a closure claim the name as a free variable, which an inner
# statement list declaring it further down turned into a rejected program.
fn labelled(key: String) {
  key
}

fn label_vs_inner_let(xs) {
  mut out = []
  fn put(v) {
    out.push(labelled(key: v))
  }
  for x in xs {
    let key = "{x}!"
    put(key)
  }
  out
}
assert_eq(label_vs_inner_let(['a', 'b']), ['a!', 'b!'])

fn pattern_key_vs_inner_let(xs) {
  mut out = []
  let take = fn (v) {
    match v {
      {key: k} => out.push(k),
      _ => out.push('none'),
    }
  }
  for x in xs {
    let key = {key: "{x}!"}
    take(key)
  }
  out
}
assert_eq(pattern_key_vs_inner_let(['a', 'b']), ['a!', 'b!'])

# The label still names the callee's parameter, and a value spelled the same
# as the label is still the enclosing binding it reads.
fn same_name_value() {
  let key = 'read'
  let f = fn () { labelled(key: key) }
  f()
}
assert_eq(same_name_value(), 'read')
