# Conformance: §6 (scope), §11 (closures), §19 (multimethod forward refs).
# See docs/language.md §24.
#
# Forward function references: a let-bound closure may reference a
# name defined later in the same scope. interp resolves through env
# binding (lazy); the JIT pre-allocates a Cell slot at scope entry
# so the closure's capture chain links to the eventual binding.

# --- (1) Top-level: closure → forward let ---
let calls_f = fn() { f() + 1 }

let f = fn() { 41 }

assert(calls_f() == 42)

# --- (2) Top-level: closure → forward class ---
let make_point = fn(x) { Point.new(x, x) }

class Point {
  new(a, b) { this.a = a; this.b = b }
}

let p = make_point(3)
assert(p.a == 3 && p.b == 3)

# --- (3) Top-level: closure → forward multifn ---
let dispatch = fn() { area(5) }

fn area(s: Long) { s * s }

assert(dispatch() == 25)

# --- (4) Inside a function body: forward ref between locals ---
let outer = fn() {
  let inner_a = fn() { inner_b() * 2 }
  let inner_b = fn() { 21 }
  inner_a()
}

assert(outer() == 42)

# --- (5) Stacked forward refs (a refers to b refers to c) ---
let chain_a = fn() { chain_b() + 1 }
let chain_b = fn() { chain_c() + 1 }
let chain_c = fn() { 40 }

assert(chain_a() == 42)
