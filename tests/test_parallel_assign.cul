// Parallel / swap assignment: a `let`-less destructure reassigns
// existing variables. `let (a, b) = …` still declares new bindings.

mut a = 1
mut b = 2
(a, b) = (b, a)             // swap
assert_eq(a, 2)
assert_eq(b, 1)

// Three-way rotate.
mut x = 1
mut y = 2
mut z = 3
(x, y, z) = (y, z, x)
assert_eq(x, 2)
assert_eq(y, 3)
assert_eq(z, 1)

// Array pattern, with a sink.
mut p = 0
mut q = 0
[p, q, _] = [10, 20, 30]
assert_eq(p, 10)
assert_eq(q, 20)

// Object pattern shorthand.
mut g = 0
mut h = 0
{g, h} = {g: 7, h: 8}
assert_eq(g, 7)
assert_eq(h, 8)

// `let` still declares.
let (m, n) = (5, 6)
assert_eq(m, 5)
assert_eq(n, 6)

// Assigning to an immutable binding is an error.
let imm = 1
mut ok2 = 2
let e = try { (imm, ok2) = (9, 9); nil } catch er { er.kind }
assert_eq(e, "ImmutableError")

// Destructuring refcounted (heap) elements must retain each leaf binding:
// the temporary tuple/array is released right after the destructure, so a
// borrowed-but-unretained element would be freed out from under the binding
// (a JIT heap-use-after-free / double-free — `let (a,b)=([1],[2])` corrupted).
let (arr1, arr2) = ([1, 2], [3, 4])
arr1.push(99)
arr2.push(88)
assert_eq(arr1, [1, 2, 99])
assert_eq(arr2, [3, 4, 88])

// A closure can capture destructure-bound locals — they are real locals of
// the enclosing scope (promotable to cells), not globals. Capturing one used
// to raise NameError under the JIT.
let (cap_s, cap_t) = (10, 20)
let add = || cap_s + cap_t
assert_eq(add(), 30)

// Captured binding holding a heap value, mutated after capture.
let (lst, _) = ([5, 6], 0)
let read = || lst.size()
lst.push(7)
assert_eq(read(), 3)

// Same retain rule for leaves *after* a rest pattern: `post` is bound from a
// borrowed element past the slice, so it must be retained too.
let [head, ...middle, tail] = [[1], [2], [3]]
head.push(10)
tail.push(30)
assert_eq(head, [1, 10])
assert_eq(middle, [[2]])
assert_eq(tail, [3, 30])

IO.inspect("test_parallel_assign OK")
