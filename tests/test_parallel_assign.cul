// Parallel / swap assignment: a `let`-less destructure reassigns
// existing variables. `let (a, b) = …` still declares new bindings.

mut a = 1
mut b = 2
(a, b) = (b, a)  // swap
assert_eq(a, 2)
assert_eq(b, 1)

// Three-way rotate.
mut x = 1
mut y = 2
mut z = 3
(x, y, z) = (y, z, x)
assert_eq(x, 2)
assert_eq(y, 3)
assert_eq(z, 1)

// Array pattern, with a sink.
mut p = 0
mut q = 0
[p, q, _] = [10, 20, 30]
assert_eq(p, 10)
assert_eq(q, 20)

// Object pattern shorthand.
mut g = 0
mut h = 0
{g, h} = {g: 7, h: 8}
assert_eq(g, 7)
assert_eq(h, 8)

// `let` still declares.
let (m, n) = (5, 6)
assert_eq(m, 5)
assert_eq(n, 6)

// Assigning to an immutable binding is an error.
let imm = 1
mut ok2 = 2
let e = try {
  (imm, ok2) = (9, 9)
  nil
} catch er {
  er.kind
}
assert_eq(e, "ImmutableError")

// Destructuring refcounted (heap) elements must retain each leaf binding:
// the temporary tuple/array is released right after the destructure, so a
// borrowed-but-unretained element would be freed out from under the binding
// (a JIT heap-use-after-free / double-free — `let (a,b)=([1],[2])` corrupted).
let (arr1, arr2) = ([1, 2], [3, 4])
arr1.push(99)
arr2.push(88)
assert_eq(arr1, [1, 2, 99])
assert_eq(arr2, [3, 4, 88])

// A closure can capture destructure-bound locals — they are real locals of
// the enclosing scope (promotable to cells), not globals. Capturing one used
// to raise NameError under the JIT.
let (cap_s, cap_t) = (10, 20)
let add = || cap_s + cap_t
assert_eq(add(), 30)

// Captured binding holding a heap value, mutated after capture.
let (lst, _) = ([5, 6], 0)
let read = || lst.size()
lst.push(7)
assert_eq(read(), 3)

// Same retain rule for leaves *after* a rest pattern: `post` is bound from a
// borrowed element past the slice, so it must be retained too.
let [head, ...middle, tail] = [[1], [2], [3]]
head.push(10)
tail.push(30)
assert_eq(head, [1, 10])
assert_eq(middle, [[2]])
assert_eq(tail, [3, 30])

// A literal on both sides compiles without the Tuple (resolve_shape_test);
// what the Tuple used to guarantee must still hold. The right side runs left
// to right, once each, before any target is written.
mut order = []
fn note(tag, v) {
  order.push(tag)
  v
}
mut sa = 1
mut sb = 2
(sa, sb) = (note("x", sb), note("y", sa))
assert_eq(order, ["x", "y"])
assert_eq([sa, sb], [2, 1])

// An ImmutableError mid-write leaves the targets before it written, through
// both statement forms.
mut w1 = 0
assert_eq(try { (w1, imm) = (5, 6); nil } catch er { er.kind }, "ImmutableError")
assert_eq(w1, 5)
mut w2 = 0
assert_eq(try { [w2, imm] = [7, 8]; nil } catch er { er.kind }, "ImmutableError")
assert_eq(w2, 7)

// A target's old value is dropped by its own write; the new values live on in
// the targets, and a swap drops nothing.
mut drops = []
class Dropped {
  name: String
  new(@name) {}
  drop() { drops.push(@name) }
}
mut d1 = Dropped("a")
mut d2 = Dropped("b")
(d1, d2) = (Dropped("c"), Dropped("d"))
assert_eq(drops, ["a", "b"])
(d1, d2) = (d2, d1)
let (d3, d4) = (Dropped("e"), Dropped("f"))
assert_eq(drops, ["a", "b"])
assert_eq([d1.name, d2.name, d3.name, d4.name], ["d", "c", "e", "f"])

// Elements still held when the statement unwinds are dropped in element
// order, as the Tuple drops them: a throw while the right side runs, and an
// ImmutableError between the writes.
fn boom() { throw "boom" }
drops = []
try { (d1, d2, d3) = (Dropped("g"), Dropped("h"), boom()) } catch _ {}
assert_eq(drops, ["g", "h"])
drops = []
try { (d1, imm, d2) = (Dropped("i"), Dropped("j"), Dropped("k")) } catch _ {}
assert_eq(drops, ["d", "j", "k"])

// The last statement of an `if` arm, and `let` reading the outer names.
if true {
  (sa, sb) = (sb, sa)
}
assert_eq([sa, sb], [1, 2])
let (sb, sa) = (sa, sb)
assert_eq([sa, sb], [2, 1])

// A sized Array literal's children are not the targets' values: `[7](2)` is
// `[7, nil]`, through both statement forms.
let [z1, z2] = [7](2)
assert_eq([z1, z2], [7, nil])
mut y1 = 0
mut y2 = 0
[y1, y2] = [8](2)
assert_eq([y1, y2], [8, nil])

// A destructure whose value is read still evaluates to the right side.
fn swapped() {
  mut p = 1
  mut q = 2
  (p, q) = (q, p)
}
assert_eq(swapped(), (2, 1))

IO.inspect("test_parallel_assign OK")
