// Conformance: §10 (Tuples, destructuring). See docs/language.md §25.
//
// Tuple literal — runs on both interp and JIT (Phase 8-A).

// Type tag.
let pair = (3, 4)
let one  = (1,)
let trip = (1, "two", 3.14)
assert_eq(type_of(pair), "Tuple")
assert_eq(type_of(one), "Tuple")
assert_eq(type_of(trip), "Tuple")

// Equality is element-wise.
let a = (1, 2)
let b = (1, 2)
let c = (1, 3)
assert_eq(a, b)
let ne = (a == c)
assert_eq(ne, false)

// Tuple as Object key.
let grid = {(0,0): "origin", (1,0): "east"}
assert_eq(grid[(0,0)], "origin")
assert_eq(grid[(1,0)], "east")

// Indexing.
let t = (10, 20, 30)
assert_eq(t[0], 10)
assert_eq(t[1], 20)
assert_eq(t[2], 30)

// Iteration.
mut s = 0
for x in (1, 2, 3, 4) {
  s = s + x
}
assert_eq(s, 10)

// Nested tuple equality.
let n1 = ((1, 2), (3, 4))
let n2 = ((1, 2), (3, 4))
assert_eq(n1, n2)

// --- Methods (a-1) ---
assert_eq(t.size(), 3)
assert_true(t.contains(20))
let nope = t.contains(99)
assert_eq(nope, false)
let arr = t.to_array()
assert_eq(type_of(arr), "Array")
assert_eq(arr.size(), 3)
assert_eq(arr[0], 10)

// --- Destructuring (a-4) ---
let (da, db) = (1, 2)
assert_eq(da, 1)
assert_eq(db, 2)
// Nested destructuring.
let (p, (q, r)) = (1, (2, 3))
assert_eq(p, 1)
assert_eq(q, 2)
assert_eq(r, 3)
// Single-element tuple pattern `(a,)` binds the lone element (used to
// collapse to a bare identifier and bind the whole value / crash the JIT).
let (solo,) = (42,)
assert_eq(solo, 42)
let (only,) = [5]  // a list unifies with the tuple pattern
assert_eq(only, 5)
// Match-arm tuple pattern.
let kind = match (1, 2) {
  (0, 0) => "origin",
  (mx, my) => "other",
}
assert_eq(kind, "other")

// Tuple has no `+` concat — raises TypeError.
let err = try {
  let _bad = (1, 2) + (3, 4)
  false
} catch e {
  e.kind == "TypeError"
}
assert_eq(err, true)

IO.inspect("test_tuple OK")
