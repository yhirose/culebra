// Tuple literal — runs on both interp and JIT (Phase 8-A).

// Type tag.
let pair = (3, 4)
let one  = (1,)
let trip = (1, "two", 3.14)
assert(type_of(pair) == "Tuple")
assert(type_of(one)  == "Tuple")
assert(type_of(trip) == "Tuple")

// Equality is element-wise.
let a = (1, 2)
let b = (1, 2)
let c = (1, 3)
assert(a == b)
let ne = (a == c)
assert(ne == false)

// Tuple as Object key.
let grid = {(0,0): "origin", (1,0): "east"}
assert(grid[(0,0)] == "origin")
assert(grid[(1,0)] == "east")

// Indexing.
let t = (10, 20, 30)
assert(t[0] == 10)
assert(t[1] == 20)
assert(t[2] == 30)

// Iteration.
mut s = 0
for x in (1, 2, 3, 4) {
  s = s + x
}
assert(s == 10)

// Nested tuple equality.
let n1 = ((1, 2), (3, 4))
let n2 = ((1, 2), (3, 4))
assert(n1 == n2)

// --- Methods (a-1) ---
assert(t.size() == 3)
assert(t.contains(20))
let nope = t.contains(99)
assert(nope == false)
let arr = t.to_array()
assert(type_of(arr) == "Array")
assert(arr.size() == 3)
assert(arr[0] == 10)

// --- Destructuring (a-4) ---
let (da, db) = (1, 2)
assert(da == 1)
assert(db == 2)
// Nested destructuring.
let (p, (q, r)) = (1, (2, 3))
assert(p == 1)
assert(q == 2)
assert(r == 3)
// Match-arm tuple pattern.
let kind = match (1, 2) {
  (0, 0) => "origin",
  (mx, my) => "other",
}
assert(kind == "other")

// --- Concatenation (G-4) ---
let c = (1, 2) + (3, 4, 5)
assert(type_of(c) == "Tuple")
assert(c.size() == 5)
assert(c[0] == 1 && c[4] == 5)
let one_plus = (1,) + (2,)
assert(one_plus.size() == 2)

// Tuple + non-Tuple is a type error (no implicit coercion).
let err = try {
  let _bad = (1, 2) + "x"
  false
} catch e {
  e.kind == "TypeError"
}
assert(err == true)

IO.puts("test_tuple OK")
