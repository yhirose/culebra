# Helper module for tests/test_import.cul. Exports a small function
# library plus a class so the consumer can exercise both binding shapes.

let add = fn (a, b) {
  a + b
}
let sub = fn (a, b) {
  a - b
}
let helper_internal = fn () {
  'should not be visible'
}

class Pair {
  new(x, y) {
    self.x = x
    self.y = y
  }
  swap() {
    Pair.new(self.y, self.x)
  }
}

# One Object per load of this module, so an importer can tell a second load.
let state = {}

export {add, sub, Pair, state}
