// Canvas preamble: the culebra layer over the _Canvas primitives (colours,
// Sprite, the bitmap font, input helpers). Framebuffer-observable behaviour is
// asserted via Canvas.get so interp and JIT stay identical; the host-driven
// parts (present/input/tone) are smoke-called.

let RED = Canvas.rgba(255, 0, 0)
let GREEN = Canvas.rgba(0, 255, 0)
let BLUE = Canvas.rgba(0, 0, 255, 255)
assert_eq(RED, 255 + 255 * 16777216)          // r=255, a=255
assert_eq(Canvas.rgba(0, 0, 0, 0), 0)

// Canvas.run initialises the framebuffer; a one-shot tick lets us draw and
// inspect. frames=1 + tick returning false keeps it to a single pass.
Canvas.run(8, 8, fn () {
  Canvas.clear(GREEN)
  assert_eq(Canvas.width(), 8)
  assert_eq(Canvas.height(), 8)
  assert_eq(Canvas.get_pixel(0, 0), GREEN)

  Canvas.rect(2, 2, 3, 3, BLUE)
  assert_eq(Canvas.get_pixel(2, 2), BLUE)
  assert_eq(Canvas.get_pixel(1, 1), GREEN)

  // Sprite from packed RGBA: 2x2, top row red, bottom-left blue, rest clear.
  let clear = Canvas.rgba(0, 0, 0, 0)
  let s = Canvas.Sprite.new([RED, RED, BLUE, clear], 2, 2)
  Canvas.clear(GREEN)
  s.draw(0, 0)
  assert_eq(Canvas.get_pixel(0, 0), RED)
  assert_eq(Canvas.get_pixel(0, 1), BLUE)
  assert_eq(Canvas.get_pixel(1, 1), GREEN)          // transparent showed through

  // draw_scaled / draw_sub_scaled: nearest by default, `smooth` box-averages on
  // the way down, `alpha` composites over what is already there.
  Canvas.clear(GREEN)
  s.draw_scaled(0, 0, 4, 4)
  assert_eq(Canvas.get_pixel(1, 1), RED)            // top row, doubled
  assert_eq(Canvas.get_pixel(0, 3), BLUE)
  assert_eq(Canvas.get_pixel(3, 3), GREEN)          // transparent showed through
  Canvas.clear(GREEN)
  s.draw_scaled(0, 0, 4, 4, flip_y: true)
  assert_eq(Canvas.get_pixel(0, 0), BLUE)
  Canvas.clear(GREEN)
  s.draw_scaled(0, 0, 4, 4, alpha: 0)               // fully transparent: no-op
  assert_eq(Canvas.get_pixel(0, 0), GREEN)
  Canvas.clear(GREEN)
  s.draw_sub_scaled(0, 0, 2, 2, 0, 0, 1, 1)         // top-left pixel, doubled
  assert_eq(Canvas.get_pixel(1, 1), RED)
  Canvas.clear(GREEN)
  s.draw_sub_scaled(0, 0, 1, 1, 0, 0, 2, 1, smooth: true)   // both reds averaged
  assert_eq(Canvas.get_pixel(0, 0), RED)

  // triangle / polygon: even-odd fill, half-open rows and spans.
  Canvas.clear(GREEN)
  Canvas.triangle(0, 0, 8, 0, 0, 8, BLUE)
  assert_eq(Canvas.get_pixel(0, 0), BLUE)
  assert_eq(Canvas.get_pixel(7, 7), GREEN)          // past the hypotenuse
  Canvas.clear(GREEN)
  Canvas.polygon([3, 0, 5, 0, 7, 4, 1, 4], BLUE)
  assert_eq(Canvas.get_pixel(3, 0), BLUE)
  assert_eq(Canvas.get_pixel(2, 0), GREEN)          // outside the top edge
  assert_eq(Canvas.get_pixel(1, 3), BLUE)           // the widened bottom row
  assert_eq(Canvas.get_pixel(0, 4), GREEN)          // the closing row is excluded

  // line: both endpoints included, and the same pixels whichever way the
  // endpoints are given.
  Canvas.clear(GREEN)
  Canvas.line(1, 1, 6, 4, BLUE)
  assert_eq(Canvas.get_pixel(1, 1), BLUE)
  assert_eq(Canvas.get_pixel(6, 4), BLUE)
  Canvas.line(6, 4, 1, 1, RED)                // reverse covers exactly the same
  mut stray = 0
  for y in 0..8 { for x in 0..8 { if Canvas.get_pixel(x, y) == BLUE { stray = stray + 1 } } }
  assert_eq(stray, 0)
  Canvas.clear(GREEN)
  Canvas.line(3, 6, 3, 6, BLUE)               // degenerate: one pixel
  assert_eq(Canvas.get_pixel(3, 6), BLUE)
  assert_eq(Canvas.get_pixel(3, 5), GREEN)

  // circle: the centre row spans 2r+1 pixels; outline is the fill's edge.
  Canvas.clear(GREEN)
  Canvas.circle(4, 4, 3, BLUE)
  assert_eq(Canvas.get_pixel(1, 4), BLUE)     // (cx - r, cy) on the circle
  assert_eq(Canvas.get_pixel(7, 4), BLUE)
  assert_eq(Canvas.get_pixel(0, 4), GREEN)
  assert_eq(Canvas.get_pixel(4, 1), BLUE)     // (cx, cy - r) on the circle
  Canvas.clear(GREEN)
  Canvas.circle(4, 4, 3, BLUE, fill: false)
  assert_eq(Canvas.get_pixel(1, 4), BLUE)     // edge drawn
  assert_eq(Canvas.get_pixel(4, 4), GREEN)    // interior untouched
  Canvas.clear(GREEN)
  Canvas.circle(4, 4, 0, BLUE)                // r=0: a single pixel
  assert_eq(Canvas.get_pixel(4, 4), BLUE)
  assert_eq(Canvas.get_pixel(5, 4), GREEN)
  Canvas.clear(GREEN)
  Canvas.ellipse(4, 4, 3, 1, BLUE)            // squashed: 7 wide, 3 tall
  assert_eq(Canvas.get_pixel(1, 4), BLUE)
  assert_eq(Canvas.get_pixel(4, 3), BLUE)
  assert_eq(Canvas.get_pixel(4, 2), GREEN)

  // fill: false on rect / triangle / polygon leaves the interior untouched.
  Canvas.clear(GREEN)
  Canvas.rect(1, 1, 6, 6, BLUE, fill: false)
  assert_eq(Canvas.get_pixel(1, 1), BLUE)
  assert_eq(Canvas.get_pixel(6, 6), BLUE)
  assert_eq(Canvas.get_pixel(3, 3), GREEN)
  Canvas.clear(GREEN)
  Canvas.triangle(0, 0, 7, 0, 0, 7, BLUE, fill: false)
  assert_eq(Canvas.get_pixel(3, 0), BLUE)     // top edge
  assert_eq(Canvas.get_pixel(0, 3), BLUE)     // left edge
  assert_eq(Canvas.get_pixel(7, 0), BLUE)     // vertex included (unlike fill)
  assert_eq(Canvas.get_pixel(2, 2), GREEN)    // interior untouched
  Canvas.clear(GREEN)
  Canvas.polygon([1, 1, 6, 1, 6, 6, 1, 6], BLUE, fill: false)
  assert_eq(Canvas.get_pixel(6, 6), BLUE)     // closing edge drawn
  assert_eq(Canvas.get_pixel(3, 3), GREEN)

  // Indexed sprite: indices into a palette resolve to the same pixels.
  let si = Canvas.Sprite.new([1, 1, 2, 0], 2, 2, [clear, RED, BLUE])
  Canvas.clear(GREEN)
  si.draw(0, 0)
  assert_eq(Canvas.get_pixel(0, 0), RED)
  assert_eq(Canvas.get_pixel(0, 1), BLUE)

  // Text: draws lit pixels of the 8x8 glyph. Lower-case is preserved (no
  // upper-casing), so "a" and "A" are distinct glyphs. Assert some pixel
  // landed and measure the fixed 8px advance.
  Canvas.clear(0)
  Canvas.text("1", 0, 0, RED)
  assert_eq(Canvas.text_width("AB"), 16)      // 2 glyphs * 8px advance
  mut lit = 0
  for y in 0..8 { for x in 0..8 { if Canvas.get_pixel(x, y) == RED { lit = lit + 1 } } }
  assert_eq(lit > 0, true)

  false                                        // stop after one frame
})

// Sprite from PNG bytes: the String constructor and its named form. The size
// comes from the image, so nothing is passed alongside the data. (2x2 RGBA:
// red, green / blue, transparent.)
let PNG = Encoding.hex.decode(
  "89504e470d0a1a0a0000000d494844520000000200000002080600000072b60d24" +
  "0000001349444154789c63f8cfc0f01f0c8134886000003fd205fbcb17a6ce0000" +
  "000049454e44ae426082")
let png_sprite = Canvas.Sprite.from_png(PNG)
assert_eq(png_sprite.width(), 2)
assert_eq(png_sprite.height(), 2)
assert_eq(Canvas.Sprite.new(PNG).width(), 2)      // same thing, String ctor
Canvas.init(2, 2)
Canvas.clear(GREEN)
png_sprite.draw(0, 0)
assert_eq(Canvas.get_pixel(0, 0), RED)
assert_eq(Canvas.get_pixel(1, 1), GREEN)          // transparent showed through
assert_throws("ValueError", fn() { Canvas.Sprite.from_png("not a png") })

// Canvas.init sizes the framebuffer without going through run — for a program
// that drives its own frame loop.
Canvas.init(5, 3)
assert_eq(Canvas.width(), 5)
assert_eq(Canvas.height(), 3)
assert_eq(Canvas.get_pixel(0, 0), 0)          // a fresh buffer is transparent

// Input edge detector (headless: buttons read 0, so nothing is pressed).
let inp = Canvas.Input.new()
inp.update()
assert_eq(inp.down(Canvas.A), false)
assert_eq(inp.pressed(Canvas.A), false)

// Button/wave constants are distinct bits/codes.
assert_eq(Canvas.LEFT + Canvas.RIGHT + Canvas.UP + Canvas.DOWN, 15)
assert_eq(Canvas.NOISE, 3)

// Host-driven, smoke only.
Canvas.tone(440, 8, 100, Canvas.PULSE)
let m = Canvas.mouse()
assert_eq(m.x, 0)

// Music: a self-made 0.2 s sine MP3 (Python wave + lame, MPEG 2.5 mono — its
// 0xff 0xe3 frame sync is exactly the header the format sniff must accept
// beyond the common 0xff 0xfb). Under the test harness the backend is headless
// (CULEBRA_CANVAS_HEADLESS), so playback state stays false and every control
// is a no-op — what this pins is the sniff, the argument contracts and the
// unloaded/no-op behaviour, identically on both backends.
let MP3 = Encoding.hex.decode(
  "ffe318c4000d38be802158000127fffffffffeb0c30c30c30a7a7a7a7cfbb74d09" +
  "664116b1d52e799526b59a4a5d3808b865c753777e5f6f3cf3b180000002be1e1e" +
  "5b2cbdfe9918ffe318c4060e00b2800195c00039a31d552f06813030b8e00f84e8" +
  "03478588685bc01fdd640286880b81c0f71890315804d6e656fc46655765378779" +
  "20690afffe976ef0301682f8ffe318c4090f80ca2c019738000353b61a6030cf81" +
  "e88180d01bb81946931081837a0f4c0c1010e400c7fe99f00c0bf06c201df02bf0" +
  "4ffffd1eaf5fffffecfd9f92ffa531fc9f37ffe318c4060df0da8c019580003591" +
  "c38a0381206c1b680d004b80040c037e3c0028ee2fc800184c6006310a7e01f90a" +
  "c689b837e1cf1c26270dbca3b0a84e48eb115ff1d44b86a4ffe318c4090ee14a18" +
  "0195a8000480ffe0638348186862108480c4c85ff03202041ca40141309b858863" +
  "7ffcc49d21c91b14568ffff9929231241402ffe498ba4c414d45332e3130")
Canvas.music(MP3)                              // defaults: loop, vol 100
Canvas.music(MP3, loop: false, vol: 30, start: 0.1)  // replaces the first
Canvas.music_volume(50)
Canvas.music_seek(0.05)
Canvas.music_seek(1)                           // Long seconds also accepted
Canvas.music_pause()
Canvas.music_resume()
assert_eq(Canvas.music_playing(), false)       // headless: never audible
Canvas.music_stop()
assert_eq(Canvas.music_playing(), false)
// Unloaded controls are no-ops, not errors.
Canvas.music_pause()
Canvas.music_resume()
Canvas.music_volume(80)
Canvas.music_seek(2.5)
// Bytes that are neither MP3 nor Ogg refuse identically everywhere.
assert_throws("ValueError", fn() { Canvas.music("not audio") })
assert_throws("ValueError", fn() { Canvas.music("") })

// Closed like the C++ namespaces: an unknown member raises instead of reading
// as nil. Lives here rather than in test_namespace_attr.cul, which would have
// to splice this whole module into the JIT entry module to say it.
assert_throws("AttributeError", fn() { Canvas.typo })

print("canvas module ok\n")
