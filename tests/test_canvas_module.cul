// Canvas preamble: the culebra layer over the _Canvas primitives (colours,
// Sprite, the bitmap font, input helpers). Framebuffer-observable behaviour is
// asserted via Canvas.get so interp and JIT stay identical; the host-driven
// parts (present/input/tone) are smoke-called.

let RED = Canvas.rgba(255, 0, 0)
let GREEN = Canvas.rgba(0, 255, 0)
let BLUE = Canvas.rgba(0, 0, 255, 255)
assert_eq(RED, 255 + 255 * 16777216)          // r=255, a=255
assert_eq(Canvas.rgba(0, 0, 0, 0), 0)

// Canvas.run initialises the framebuffer; a one-shot tick lets us draw and
// inspect. frames=1 + tick returning false keeps it to a single pass.
Canvas.run(8, 8, fn () {
  Canvas.clear(GREEN)
  assert_eq(Canvas.width(), 8)
  assert_eq(Canvas.height(), 8)
  assert_eq(Canvas.get_pixel(0, 0), GREEN)

  Canvas.rect(2, 2, 3, 3, BLUE)
  assert_eq(Canvas.get_pixel(2, 2), BLUE)
  assert_eq(Canvas.get_pixel(1, 1), GREEN)

  // Sprite from packed RGBA: 2x2, top row red, bottom-left blue, rest clear.
  let clear = Canvas.rgba(0, 0, 0, 0)
  let s = Canvas.Sprite.new([RED, RED, BLUE, clear], 2, 2)
  Canvas.clear(GREEN)
  s.draw(0, 0)
  assert_eq(Canvas.get_pixel(0, 0), RED)
  assert_eq(Canvas.get_pixel(0, 1), BLUE)
  assert_eq(Canvas.get_pixel(1, 1), GREEN)          // transparent showed through

  // draw_scaled / draw_sub_scaled: nearest by default, `smooth` box-averages on
  // the way down, `alpha` composites over what is already there.
  Canvas.clear(GREEN)
  s.draw_scaled(0, 0, 4, 4)
  assert_eq(Canvas.get_pixel(1, 1), RED)            // top row, doubled
  assert_eq(Canvas.get_pixel(0, 3), BLUE)
  assert_eq(Canvas.get_pixel(3, 3), GREEN)          // transparent showed through
  Canvas.clear(GREEN)
  s.draw_scaled(0, 0, 4, 4, flip_y: true)
  assert_eq(Canvas.get_pixel(0, 0), BLUE)
  Canvas.clear(GREEN)
  s.draw_scaled(0, 0, 4, 4, alpha: 0)               // fully transparent: no-op
  assert_eq(Canvas.get_pixel(0, 0), GREEN)
  Canvas.clear(GREEN)
  s.draw_sub_scaled(0, 0, 2, 2, 0, 0, 1, 1)         // top-left pixel, doubled
  assert_eq(Canvas.get_pixel(1, 1), RED)
  Canvas.clear(GREEN)
  s.draw_sub_scaled(0, 0, 1, 1, 0, 0, 2, 1, smooth: true)   // both reds averaged
  assert_eq(Canvas.get_pixel(0, 0), RED)

  // trapezoid: rows [y_top, y_bot), sides interpolated between the two spans.
  Canvas.clear(GREEN)
  Canvas.trapezoid(0, 3, 5, 4, 1, 7, BLUE)
  assert_eq(Canvas.get_pixel(3, 0), BLUE)
  assert_eq(Canvas.get_pixel(2, 0), GREEN)          // outside the top span
  assert_eq(Canvas.get_pixel(1, 3), BLUE)           // the widened bottom row
  assert_eq(Canvas.get_pixel(0, 4), GREEN)          // y_bot itself is excluded

  // Indexed sprite: indices into a palette resolve to the same pixels.
  let si = Canvas.Sprite.new([1, 1, 2, 0], 2, 2, [clear, RED, BLUE])
  Canvas.clear(GREEN)
  si.draw(0, 0)
  assert_eq(Canvas.get_pixel(0, 0), RED)
  assert_eq(Canvas.get_pixel(0, 1), BLUE)

  // Text: draws lit pixels of the 8x8 glyph. Lower-case is preserved (no
  // upper-casing), so "a" and "A" are distinct glyphs. Assert some pixel
  // landed and measure the fixed 8px advance.
  Canvas.clear(0)
  Canvas.text("1", 0, 0, RED)
  assert_eq(Canvas.text_width("AB"), 16)      // 2 glyphs * 8px advance
  mut lit = 0
  for y in 0..8 { for x in 0..8 { if Canvas.get_pixel(x, y) == RED { lit = lit + 1 } } }
  assert_eq(lit > 0, true)

  false                                        // stop after one frame
})

// Sprite from PNG bytes: the String constructor and its named form. The size
// comes from the image, so nothing is passed alongside the data. (2x2 RGBA:
// red, green / blue, transparent.)
let PNG = Encoding.hex.decode(
  "89504e470d0a1a0a0000000d494844520000000200000002080600000072b60d24" +
  "0000001349444154789c63f8cfc0f01f0c8134886000003fd205fbcb17a6ce0000" +
  "000049454e44ae426082")
let png_sprite = Canvas.Sprite.from_png(PNG)
assert_eq(png_sprite.width(), 2)
assert_eq(png_sprite.height(), 2)
assert_eq(Canvas.Sprite.new(PNG).width(), 2)      // same thing, String ctor
Canvas.init(2, 2)
Canvas.clear(GREEN)
png_sprite.draw(0, 0)
assert_eq(Canvas.get_pixel(0, 0), RED)
assert_eq(Canvas.get_pixel(1, 1), GREEN)          // transparent showed through
assert_throws("ValueError", fn() { Canvas.Sprite.from_png("not a png") })

// Canvas.init sizes the framebuffer without going through run — for a program
// that drives its own frame loop.
Canvas.init(5, 3)
assert_eq(Canvas.width(), 5)
assert_eq(Canvas.height(), 3)
assert_eq(Canvas.get_pixel(0, 0), 0)          // a fresh buffer is transparent

// Input edge detector (headless: buttons read 0, so nothing is pressed).
let inp = Canvas.Input.new()
inp.update()
assert_eq(inp.down(Canvas.A), false)
assert_eq(inp.pressed(Canvas.A), false)

// Button/wave constants are distinct bits/codes.
assert_eq(Canvas.LEFT + Canvas.RIGHT + Canvas.UP + Canvas.DOWN, 15)
assert_eq(Canvas.NOISE, 3)

// Host-driven, smoke only.
Canvas.tone(440, 8, 100, Canvas.PULSE)
let m = Canvas.mouse()
assert_eq(m.x, 0)

// Closed like the C++ namespaces: an unknown member raises instead of reading
// as nil. Lives here rather than in test_namespace_attr.cul, which would have
// to splice this whole module into the JIT entry module to say it.
assert_throws("AttributeError", fn() { Canvas.typo })

print("canvas module ok\n")
