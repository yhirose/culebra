// Conformance: stdlib PEG (PEG parser). See docs/stdlib.md.
// Engine: include/stdlib/peg.h over the vendored cpp-peglib — the same parser
// generator culebra's own front end runs on.
//
// Write grammars as backtick RAW strings: no escape processing and no
// `{...}` interpolation, so `\t` and `{2}` pass through to the grammar.

// cpp-peglib's own README calculator. Its alternatives share a prefix, which
// is exactly why memoization is on by default (see test_peg_errors.cul).
let calc = `
  Additive       <- Multiplicative '+' Additive / Multiplicative
  Multiplicative <- Primary '*' Multiplicative / Primary
  Primary        <- '(' Additive ')' / Number
  Number         <- < [0-9]+ >
  %whitespace    <- [ \t\r\n]*
`

// --- compile + parse ---
let p = PEG.compile(calc)
let ast = p.parse("1 + 2 * 3")
assert_eq(ast.name, "Additive")
assert_eq(ast.nodes.size(), 2)
assert_true(ast.is_token == false)

// --- a node is a plain Object, so `match` takes it apart ---
fn eval(n) {
  match n {
    {name: "Number", token} => to_long(token),
    {name: "Additive", nodes: [a, b]} => eval(a) + eval(b),
    {name: "Multiplicative", nodes: [a, b]} => eval(a) * eval(b),
    {nodes: [only]} => eval(only),
    _ => throw "unexpected {n.name}",
  }
}
assert_eq(eval(ast), 7)
assert_eq(eval(p.parse("(1 + 2) * 3")), 9)

// --- token nodes carry their text; branch nodes do not ---
let num = PEG.find(ast, "Number")
assert_eq(num.token, "1")
assert_true(num.is_token)
assert_eq(num.nodes.size(), 0)
assert_eq(ast.token, "")

// --- positions are byte offsets into the subject, like Regex ---
let src = "12 + 345"
let sum = PEG.compile(calc).parse(src)
let rhs = PEG.find_all(sum, "Number")[1]
assert_eq(rhs.line, 1)
assert_eq(rhs.column, 6)
assert_eq(src.slice(rhs.position, rhs.position + rhs.length), "345")

// --- choice: which alternative of a prioritized choice matched ---
let raw = PEG.compile(calc, "", false).parse("1")
assert_eq(raw.name, "Additive")
assert_eq(raw.choice, 1)  // fell through to the second alternative

// --- optimize (default) folds single-child nodes ---
assert_eq(PEG.walk(raw).map(|n| n.name).collect(),
          ["Additive", "Multiplicative", "Primary", "Number"])
assert_eq(PEG.walk(p.parse("1")).map(|n| n.name).collect(), ["Number"])

// --- walk / find / find_all ---
assert_eq(PEG.walk(ast).map(|n| n.name).collect(),
          ["Additive", "Number", "Multiplicative", "Number", "Number"])
assert_eq(PEG.find_all(ast, "Number").map(|n| n.token), ["1", "2", "3"])
assert_eq(PEG.find(ast, "Nothing"), nil)
assert_eq(PEG.find_all(ast, "Nothing"), [])

// --- str: the peglint-style dump ---
assert_eq(PEG.str(p.parse("1 + 2")),
          "+ Additive\n  - Number (1)\n  - Number (2)\n")

// --- test: does it parse at all ---
assert_true(p.test("1 + 2"))
assert_false(p.test("1 +"))

// --- one-shot forms take the grammar directly ---
assert_eq(PEG.parse(calc, "7").name, "Number")
assert_true(PEG.test(calc, "7"))
assert_false(PEG.test(calc, "+"))
assert_eq(PEG.check(calc), nil)

// --- start rule ---
let g = `
  Doc  <- Item+
  Item <- < [a-z]+ > _
  _    <- [ ]*
`
assert_eq(PEG.compile(g).parse("ab cd").name, "Doc")
assert_eq(PEG.compile(g, "Item").parse("ab").name, "Item")
assert_eq(PEG.parse(g, "ab", "Item").name, "Item")
assert_true(PEG.test(g, "ab", "Item"))

// --- the grammar's own AST instructions control the tree shape ---
let named = `
  Atom   <- Number / String
  Number <- < [0-9]+ >        { ast_name: Literal }
  String <- '"' < [^"]* > '"' { ast_name: Literal }
`
assert_eq(PEG.parse(named, "123").name, "Literal")
assert_eq(PEG.parse(named, '"hi"').name, "Literal")

let folded = `
  Wrap  <- Inner
  Inner <- < [0-9]+ >
`
assert_eq(PEG.walk(PEG.parse(folded, "1")).map(|n| n.name).collect(),
          ["Inner"])
let kept = `
  Wrap  <- Inner  { no_ast_opt }
  Inner <- < [0-9]+ >
`
assert_eq(PEG.walk(PEG.parse(kept, "1")).map(|n| n.name).collect(),
          ["Wrap", "Inner"])

// --- a compiled grammar is reusable and independent of the subject ---
let re = PEG.compile(g)
assert_eq(re.parse("ab").name, "Item")  // a lone Item folds up to the root
assert_eq(re.parse("ab cd").nodes.size(), 2)

// --- PEG.PEG is the class the module hands out ---
let direct = PEG.PEG.new(calc)
assert_eq(direct.parse("1").name, "Number")

// --- across an isolate boundary: a grammar is per-thread state, so what
// crosses is the grammar text (a compiled PEG carries it and reloads on the
// other side), and a parsed tree comes back as plain Objects ---
assert_eq(Isolate.spawn(|| p.parse("1").name).join(), "Number")
assert_eq(Isolate.spawn(|| PEG.parse(calc, "1 + 2").name).join(), "Additive")
assert_eq(Isolate.spawn(|| PEG.parse(calc, "1 + 2")).join().nodes.size(), 2)
