# A parameter's default runs where its function is defined, with the
# parameters before it bound: a later parameter's name, read directly or by a
# closure, still means the outer variable. What a default declares is its own.

let pds_b = 'outer'

# A later parameter's name reads the outer variable.
fn pds_later(x = pds_b, pds_b = 5) { [x, pds_b] }
assert_eq(pds_later(), ['outer', 5])
assert_eq(pds_later(1), [1, 5])

# So does a closure in the default, called once the parameters are bound.
fn pds_later_closure(x = || pds_b, pds_b = 5) { [x(), pds_b] }
assert_eq(pds_later_closure(), ['outer', 5])
fn pds_later_nested(x = || (|| pds_b)(), pds_b = 5) { [x(), pds_b] }
assert_eq(pds_later_nested(), ['outer', 5])

# An earlier parameter is the frame's own: a closure shares its cell.
fn pds_earlier_closure(mut a = 1, g = || a) {
  a = 7
  g()
}
assert_eq(pds_earlier_closure(), 7)

# A default's declaration, read by a closure in the same default.
fn pds_own_decl(x = (let v = 2) + (|| v)()) { x }
assert_eq(pds_own_decl(), 4)
assert_eq(pds_own_decl(9), 9)

# ...is not the body's: the body reads the outer variable.
let pds_v = 'outer v'
fn pds_decl_then_body(x = (let pds_v = 3) + 0) { [x, pds_v] }
assert_eq(pds_decl_then_body(), [3, 'outer v'])

# A destructuring parameter is an earlier parameter too.
fn pds_pattern([pds_p], x = pds_p, g = || pds_p) { [x, g()] }
assert_eq(pds_pattern([6]), [6, 6])
