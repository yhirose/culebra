// What a generator body may hold: each form binds and runs as it does in a
// plain fn, across a yield and a close. (jit_error_pos_test.sh holds what a
// generator body still refuses.)

// --- a named fn declared in the body ---------------------------------------

// declared before the first yield, used after resumes
fn nf_basic() {
  fn triple(x) {
    x * 3
  }
  yield triple(2)
  yield triple(3)
}
assert_eq(nf_basic().collect(), [6, 9])

// it closes over a local the body changes across a yield
fn nf_closes_over() {
  mut total = 0
  fn add(x) {
    total = total + x
  }
  add(1)
  yield total
  add(10)
  yield total
}
assert_eq(nf_closes_over().collect(), [1, 11])

// declared after a yield, in a branch, in a loop body (one per pass)
fn nf_scopes(n) {
  yield 0
  if n > 0 {
    fn half(x) {
      x / 2
    }
    yield half(n)
  }
  for i in 0..2 {
    fn sq(x) {
      x * x
    }
    yield sq(i + n)
  }
}
assert_eq(nf_scopes(4).collect(), [0, 2, 16, 25])

// recursion, and a generator declared inside a generator
fn nf_nested() {
  fn fact(n) {
    if n <= 1 {
      1
    } else {
      n * fact(n - 1)
    }
  }
  fn inner() {
    yield fact(3)
    yield fact(4)
  }
  yield from inner()
  yield fact(5)
}
assert_eq(nf_nested().collect(), [6, 24, 120])

// a named fn that outlives the generator
mut nf_kept = []
fn nf_escapes() {
  fn mk(x) {
    x + 100
  }
  nf_kept.push(mk)
  yield 1
}
nf_escapes().collect()
assert_eq(nf_kept[0](5), 105)

// closing before and after the declaration is reached
mut nf_log = []
fn nf_close() {
  defer {
    nf_log.push('defer')
  }
  yield 1
  fn late(x) {
    x
  }
  yield late(2)
}
for v in nf_close() {
  break
}
assert_eq(nf_log, ['defer'])
let nf_second = nf_close()
nf_second.next()
nf_second.next()
nf_second.dispose()
assert_eq(nf_log, ['defer', 'defer'])

// --- an `effect fn` declared in the body ----------------------------------

effect fn bf_ask()

fn bf_effect() {
  effect fn twice(x) {
    let a = perform bf_ask()
    x * a
  }
  effect fn sum_two() {
    let a = perform bf_ask()
    let b = perform bf_ask()
    a + b
  }
  yield 1
  yield handle {
    twice(10)
  } with bf_ask(k) {
    k(3)
  }
  yield handle {
    sum_two()
  } with bf_ask(k) {
    k(4)
  }
  yield 2
}
assert_eq(bf_effect().collect(), [1, 30, 8, 2])

// no handler around it: the error a plain fn gets
fn bf_unhandled() {
  effect fn only() {
    perform bf_ask()
  }
  yield only()
}
assert_throws("EffectError", fn () {
  bf_unhandled().collect()
})

// --- a yield inside try / catch -------------------------------------------

fn tc_plain() {
  try {
    yield 1
    yield 2
  } catch e {
    yield "caught"
  }
  yield 3
}
assert_eq(tc_plain().collect(), [1, 2, 3])

// a throw from the code that runs after a resume lands in the same try, and
// its catch may yield
fn tc_throw(n) {
  try {
    yield 1
    if n > 0 {
      throw "boom{n}"
    }
    yield 2
  } catch e {
    yield "caught {e}"
    yield "again"
  }
  yield "end"
}
assert_eq(tc_throw(0).collect(), [1, 2, "end"])
assert_eq(tc_throw(7).collect(), [1, "caught boom7", "again", "end"])

// a throw on the consumer's side never enters the generator's try
fn tc_consumer() {
  try {
    yield 1
  } catch e {
    yield "never"
  }
}
fn tc_consumer_run() {
  let g = tc_consumer()
  g.next()
  throw "from the consumer"
}
assert_eq(try {
  tc_consumer_run()
} catch e {
  e
}, "from the consumer")

// closing while suspended in the try body: the catch does not run, the
// defers do (innermost first); the same inside a catch body
mut tc_log = []
fn tc_close() {
  defer {
    tc_log.push("outer")
  }
  try {
    defer {
      tc_log.push("try")
    }
    yield 1
    yield 2
  } catch e {
    tc_log.push("handler")
    yield "h"
  }
}
for v in tc_close() {
  break
}
assert_eq(tc_log, ["try", "outer"])
tc_log = []
let tc_second = tc_close()
tc_second.next()
tc_second.dispose()
assert_eq(tc_log, ["try", "outer"])
tc_log = []
fn tc_close_catch() {
  defer {
    tc_log.push("outer")
  }
  try {
    throw "x"
  } catch e {
    defer {
      tc_log.push("catch")
    }
    yield e
    yield "after"
  }
}
for v in tc_close_catch() {
  break
}
assert_eq(tc_log, ["catch", "outer"])

// nested regions, and a rethrow from the inner catch
fn tc_nested() {
  try {
    yield "a"
    try {
      yield "b"
      throw "inner"
    } catch e {
      yield "in {e}"
      throw "re {e}"
    }
    yield "unreached"
  } catch e {
    yield "out {e}"
  }
  yield "done"
}
assert_eq(tc_nested().collect(), ["a", "b", "in inner", "out re inner", "done"])

// break / continue / return crossing the region
fn tc_loop() {
  for i in 0..5 {
    try {
      if i == 1 {
        continue
      }
      if i == 3 {
        break
      }
      yield i
      if i == 2 {
        throw "two"
      }
      yield i * 10
    } catch e {
      yield "c{i}"
    }
  }
  yield "out"
}
assert_eq(tc_loop().collect(), [0, 0, 2, "c2", "out"])
fn tc_return() {
  try {
    yield 1
    return
  } catch e {
    yield "no"
  }
  yield "unreached"
}
assert_eq(tc_return().collect(), [1])

// the try's value, and an error that leaves the body ends the generator
fn tc_value() {
  let v = try {
    yield 1
    10
  } catch e {
    20
  }
  yield v
  let w = try {
    yield 2
    throw "x"
  } catch e {
    30
  }
  yield w
}
assert_eq(tc_value().collect(), [1, 10, 2, 30])
fn tc_escapes() {
  try {
    yield 1
    to_long("x")
  } catch e {
    throw e
  }
}
let tc_dead = tc_escapes()
assert_eq(tc_dead.next(), 1)
assert_throws("TypeError", fn () {
  tc_dead.next()
})
assert_eq(tc_dead.has_next(), false)

// resumed from a deeper frame than the one that made it
fn tc_deep_next(g, n) {
  if n == 0 {
    return g.next()
  }
  return tc_deep_next(g, n - 1)
}
let tc_far = tc_plain()
assert_eq([tc_deep_next(tc_far, 3), tc_deep_next(tc_far, 1)], [1, 2])

IO.inspect('test_generator_body_forms OK')
