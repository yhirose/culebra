# Keyword arguments and `**` splat. Interp-only for now — the JIT
# rejects kwargs against user-defined function calls at compile time
# (built-in dispatchers like JSON.stringify handle their own kwargs).

let f = fn (x, y = 10, z = 100) { x + y + z }

# Positional only (defaults fill in trailing)
assert(f(1, 2, 3) == 6)
assert(f(1) == 111)
assert(f(1, 2) == 103)

# Kwarg basic
assert(f(1, z: 5) == 16)         # middle (y) defaults
assert(f(1, y: 2, z: 3) == 6)
assert(f(z: 3, y: 2, x: 1) == 6) # full reorder

# Splat from an Object literal
let opts = {y: 7, z: 8}
assert(f(1, **opts) == 16)

# Splat + explicit kwarg overrides
assert(f(1, **opts, z: 100) == 108)

# Multiple splats: later wins
assert(f(1, **{y: 2}, **{y: 5}) == 106)

# Splat + multiple explicit kwargs together
assert(f(**{x: 1}, **{y: 2}, z: 3) == 6)

# Defaults eval at call-time; visible to earlier-param refs
let g = fn (a, b = a + 1) { a + b }
assert(g(10) == 21)
assert(g(10, b: 5) == 15)

# Default eval is a fresh eval each call (not cached at def)
mut counter = 0
let inc = fn () { counter = counter + 1; counter }
let h = fn (x = inc()) { x }
assert(h() == 1)
assert(h() == 2)
assert(h(100) == 100)  # default not eval'd when arg passed
assert(h() == 3)

# UFCS path: `x.f(...)` becomes `f(x, ...)`; kwargs flow naturally
let greet = fn (name, greeting = 'hi') { "{greeting}, {name}" }
assert('alice'.greet() == 'hi, alice')
assert('alice'.greet(greeting: 'yo') == 'yo, alice')

# __ARGS__ catches extra positional, not kwargs
let varfn = fn (a) { __ARGS__ }
let extras = varfn(1, 2, 3)
assert(extras.size() == 2 && extras[0] == 2 && extras[1] == 3)

# Kwargs don't contribute to __ARGS__
let g2 = fn (a, b = 0) { __ARGS__ }
let e2 = g2(1, b: 9)
assert(e2.size() == 0)

# --- Error cases ---

let r1 = try { f(1, zzz: 9); nil } catch e { e }
assert(r1.kind == 'TypeError' && r1.message.contains('zzz'))

let r2 = try { f(x: 1, x: 2); nil } catch e { e }
assert(r2.kind == 'TypeError' && r2.message.contains('duplicate'))

let r3 = try { f(1, x: 2); nil } catch e { e }
assert(r3.kind == 'TypeError' && r3.message.contains('both positionally'))

let r4 = try { f(); nil } catch e { e }
assert(r4.kind == 'ArityError' && r4.message.contains("missing required"))

let r5 = try { f(1, **[1, 2]); nil } catch e { e }
assert(r5.kind == 'TypeError' && r5.message.contains('splat operand'))

let r6 = try { f(x: 1, 2); nil } catch e { e }
assert(r6.kind == 'SyntaxError' && r6.message.contains('positional argument follows'))

# Non-String key in splat Object
let r7 = try {
  let bad = {1: 'a'}
  f(1, **bad)
  nil
} catch e { e }
assert(r7.kind == 'TypeError' && r7.message.contains('splat key'))

IO.puts('test_kwargs OK')
