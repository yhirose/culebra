// Mutating Set methods (interp-only for now).
// The JIT skips these because `.add` / `.remove` are common user-method
// names on Objects (e.g. Calculator.add(1)); resolving Set vs Object at
// call sites needs runtime tag dispatch, deferred.

mut s = {1, 2}
let added = s.add(3)
assert(added == true)
assert(s.size() == 3)
let dup = s.add(2)
assert(dup == false)
assert(s.size() == 3)
let rm = s.remove(2)
assert(rm == true)
assert(s.size() == 2)
assert(s.contains(2) == false)
let rm_absent = s.remove(99)
assert(rm_absent == false)

IO.puts("test_set_mutating OK")
