// Set literal (Phase 7-E, interp-only for now; JIT support pending).

let s = {1, 2, 3}
assert(type_of(s) == "Set")

// Duplicate elements collapse.
let dup = {1, 2, 2, 3, 1}
assert(type_of(dup) == "Set")

// Set equality ignores order.
let a = {1, 2, 3}
let b = {3, 2, 1}
assert(a == b)

let c = {1, 2}
let d = {1, 2, 3}
let eq_cd = (a == c)
assert(eq_cd == false)

// Mixed element types.
let mix = {1, "two", 3.14, true}
assert(type_of(mix) == "Set")

IO.puts("test_set OK")
