// Where a unary prefix sits in the precedence ladder.
//
//   +  -            (loosest of the three)
//   *  /  %  @
//   unary + - ! ~
//   **              (tightest)
//
// so `-a * b` is `(-a) * b` and `-2 ** 2` is `-(2 ** 2)`, matching C, Python,
// Ruby and JavaScript. For numbers both readings of `-a * b` agree, which is
// why this file leans on a type whose operators are observable: the order the
// dunder methods run in is the only thing that distinguishes the two.

// --- numeric pins ---------------------------------------------------------
assert_eq(-2 ** 2, -4)  // -(2 ** 2), not (-2) ** 2 == 4
assert_eq((-2) ** 2, 4)
assert_eq(-2 ** 2, -4)
assert_eq(2 ** (-1), 0.5)  // unary is allowed on the ** RHS
assert_eq(2 ** (-3 ** 2), 0.001953125)
assert_eq(-2 * 3, -6)
assert_eq(-2 + 3, 1)
assert_eq(-(2 + 3), -5)
assert_eq(-6 / 4, -1)
assert_eq(-7 % 3, -1)
assert_eq(!true, false)
assert_eq(~0, -1)
assert_eq(-(-3), 3)
assert_eq(2 * 3 ** 2, 18)
assert_eq(-2 * 3 ** 2, -18)  // (-2) * (3 ** 2)

// A unary prefix is also allowed on the *right* of `* / % @`, which the
// ladder only admits once the unary rungs sit below MULTIPLICATIVE.
assert_eq(2 * -3, -6)
assert_eq(10 / -2, -5)
assert_eq(7 % -3, 1)
assert_eq(2 * ~1, -4)
assert_eq(2 + -3, -1)
assert_eq(2 - -3, 5)
assert_eq(2 ** (-3), 0.125)

// --- observable operand order ---------------------------------------------
mut trace = []

class N {
  new(v) {
    self.v = v
  }
  __neg__() {
    trace.push('neg')
    N(-self.v)
  }
  __mul__(o) {
    trace.push('mul')
    N(self.v * o.v)
  }
  __div__(o) {
    trace.push('div')
    N(self.v)
  }
  __mod__(o) {
    trace.push('mod')
    N(self.v)
  }
  __add__(o) {
    trace.push('add')
    N(self.v + o.v)
  }
  __sub__(o) {
    trace.push('sub')
    N(self.v - o.v)
  }
  __pow__(o) {
    trace.push('pow')
    N(o.v)
  }
}

let run = fn (f) {
  trace = []
  f()
  trace
}

// unary binds tighter than `*`, `/`, `%`: negate first, then combine
assert_eq(run(fn () {
  -N(2) * N(3)
}), ['neg', 'mul'])
assert_eq(run(fn () {
  -N(2) / N(3)
}), ['neg', 'div'])
assert_eq(run(fn () {
  -N(2) % N(3)
}), ['neg', 'mod'])
assert_eq(run(fn () {
  N(2) * -N(3)
}), ['neg', 'mul'])

// ... and tighter than `+` / `-` too
assert_eq(run(fn () {
  -N(2) + N(3)
}), ['neg', 'add'])
assert_eq(run(fn () {
  -N(2) - N(3)
}), ['neg', 'sub'])

// ... but looser than `**`: the power runs first and its result is negated
assert_eq(run(fn () {
  -N(2) ** N(3)
}), ['pow', 'neg'])

// parentheses still override, in both directions
assert_eq(run(fn () {
  -(N(2) * N(3))
}), ['mul', 'neg'])
assert_eq(run(fn () {
  (-N(2)) ** N(3)
}), ['neg', 'pow'])

// `!` and `~` sit on the same rungs. They take no dunder (`!` is Bool-only,
// `~` Long-only), so the operand order shows through the value instead.
assert_eq(!true || true, true)  // (!true) || true — not !(true || true)
assert_eq(~0 & 3, 3)            // (~0) & 3 == -1 & 3 — not ~(0 & 3) == -1
assert_eq(~1 * 2, -4)           // (~1) * 2 == -2 * 2

// stacked unaries apply innermost-first
assert_eq(run(fn () {
  -(-N(2))
}), ['neg', 'neg'])

// a longer chain: each operand negates before it is combined
assert_eq(run(fn () {
  -N(2) * N(3) + -N(4)
}), ['neg', 'mul', 'neg', 'add'])
