# Deterministic drop() + RC release must fire when an exception unwinds a
# scope, exactly as they do on normal fall-through / return. This was a JIT
# interp/JIT asymmetry (the JIT skipped scope cleanup on the throw path); the
# difftest corpus does not exercise drop-on-throw, so this is the regression
# guard. Each section records what ran, in order, and asserts the sequence.

mut ev = []

class Res {
  new(id) {
    self.id = id
  }
  drop() {
    ev.push("drop {self.id}")
  }
}

# 1. simple: local dropped when the function throws
fn simple() {
  let r = Res.new(1)
  throw "x"
}
try {
  simple()
} catch e {
  ev.push("caught")
}
assert_eq(ev, ['drop 1', 'caught'])
ev = []

# 2. nested lexical scopes: inner drops before outer, LIFO
fn nested() {
  let outer = Res.new(2)
  {
    let inner = Res.new(3)
    throw "x"
  }
}
try {
  nested()
} catch e {
  ev.push("caught")
}
assert_eq(ev, ['drop 3', 'drop 2', 'caught'])
ev = []

# 3. defer + drop ordering: defer runs before the scope's drops (in a nested
# lexical block, so it exercises the per-scope cleanup, not the fn-level one)
fn deferdrop() {
  let keep = Res.new(6)
  {
    let a = Res.new(4)
    defer {
      ev.push("defer")
    }
    let b = Res.new(5)
    throw "x"
  }
}
try {
  deferdrop()
} catch e {
  ev.push("caught")
}
assert_eq(ev, ['defer', 'drop 5', 'drop 4', 'drop 6', 'caught'])
ev = []

# 4. while body: the current iteration's local is dropped on throw
fn wloop() {
  let mut i = 0
  while i < 3 {
    let r = Res.new(10 + i)
    throw "x" if i == 1
    i = i + 1
  }
}
try {
  wloop()
} catch e {
  ev.push("caught")
}
assert_eq(ev, ['drop 10', 'drop 11', 'caught'])
ev = []

# 5. for body
fn floop() {
  for i in 0..3 {
    let r = Res.new(20 + i)
    throw "x" if i == 1
  }
}
try {
  floop()
} catch e {
  ev.push("caught")
}
assert_eq(ev, ['drop 20', 'drop 21', 'caught'])
ev = []

# 6. match: arm body local + drop-having subject both released
fn matchthrow() {
  match Res.new(30) {
    x => {
      let r = Res.new(31)
      throw "x"
    },
  }
}
try {
  matchthrow()
} catch e {
  ev.push("caught")
}
assert_eq(ev, ['drop 31', 'drop 30', 'caught'])
ev = []

# 7. try body: local dropped before the catch handler runs
fn trythrow() {
  let outer = Res.new(40)
  try {
    let inner = Res.new(41)
    throw "x"
  } catch e {
    ev.push("inner caught")
  }
  throw "x"
}
try {
  trythrow()
} catch e {
  ev.push("outer caught")
}
assert_eq(ev, ['drop 41', 'inner caught', 'drop 40', 'outer caught'])
ev = []

# 8. escaped container: dropping the array frees its held elements
fn escape() {
  let a = Res.new(50)
  let b = [a, Res.new(51)]
  throw "x"
}
try {
  escape()
} catch e {
  ev.push("caught")
}
assert_eq(ev, ['drop 51', 'drop 50', 'caught'])
ev = []

# 8b. a captured local releases in DECLARATION order like any other, newest
# first — the compiling backends pre-allocate its cell at the top of the scope
# (forward-ref support), which must not move its drop ahead of locals declared
# before it. The closure is a temporary, so nothing holds the cell at the throw
# and all backends resolve it here rather than at a later collection.
fn captured_order() {
  let first = Res.new(70)
  let held = Res.new(71)
  ev.push((fn () { held.id })())
  throw "x"
}
try {
  captured_order()
} catch e {
  ev.push("caught")
}
assert_eq(ev, [71, 'drop 71', 'drop 70', 'caught'])
ev = []

# 8b'. the same shape with the names' alphabetical order REVERSED from their
# declaration order. A closure literal in the scope routes the interp's
# finalization through the environment's own teardown, and its dictionary is
# name-ordered — the release must still run in reverse DECLARATION order, not
# whatever node order the names hash the tree into (this diverged per-STL:
# libstdc++ and Apple's libc++ tore the tree down differently).
fn captured_order_rev() {
  let z = Res.new(80)
  let a = Res.new(81)
  ev.push((fn () { a.id })())
  throw "x"
}
try {
  captured_order_rev()
} catch e {
  ev.push("caught")
}
assert_eq(ev, [81, 'drop 81', 'drop 80', 'caught'])
ev = []

# 8c. a `drop` body that throws is logged and swallowed, and the error already
# unwinding survives it — the compiled backends carry the thrown payload in a
# global the body's own throw would otherwise overwrite.
class Noisy {
  new(id) {
    self.id = id
  }
  drop() {
    ev.push("drop noisy")
    throw "from drop"
  }
}
fn drop_throws() {
  let n = Noisy.new(1)
  throw "original"
}
try {
  drop_throws()
} catch e {
  ev.push("caught " + e)
}
assert_eq(ev, ['drop noisy', 'caught original'])
ev = []

# 9. for-in over a generator: body local dropped on throw (the generator's own
# dispose on the way out is checked in test_iter_dispose_ownership.cul)
fn gen(n) {
  for i in 0..n {
    yield i
  }
}
fn geniter() {
  for i in gen(5) {
    let r = Res.new(60 + i)
    throw "x" if i == 2
  }
}
try {
  geniter()
} catch e {
  ev.push("caught")
}
assert_eq(ev, ['drop 60', 'drop 61', 'drop 62', 'caught'])
