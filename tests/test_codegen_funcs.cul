# CodeGen.Module, continued from test_codegen.cul: the per-function flags
# (set_tail_calls, set_singleton) and host functions (declare_native /
# native_ref, bound at run() and compile()+Program.run()). Split from
# test_codegen.cul once that file crossed the --jit compile-time bound: a
# flat script compiles as one JIT function, whose optimization cost grows
# superlinearly with size.
#
# Run with:  ./build/culebra tests/test_codegen_funcs.cul
#            ./build/culebra --jit tests/test_codegen_funcs.cul

let ORIGIN_F = {line: 1, column: 1}

fn stmt_block(m, stmts) {
  let list = m.list_new()
  for s in stmts {
    m.list_push(list, s)
  }
  m.block(stmts: list, line: 1, col: 1)
}

fn print_stmt(m, value) {
  let args = m.list_new()
  m.list_push(args, value)
  m.intrinsic(name: 'print', args: args, line: 1, col: 1)
}

fn call_intr(m, name, args) {
  let list = m.list_new()
  for a in args {
    m.list_push(list, a)
  }
  m.intrinsic(name: name, args: list, line: 1, col: 1)
}

# --- A function may opt into tail calls: a call chain deeper than the frame
# limit completes in one frame. The control is the same module with the flag
# off, which really does exhaust the limit -- without it this test would pass
# on a build that ignored the flag entirely. ---
fn counting_chain(m) {
  # down(n) = n == 0 ? 'bottom' : down(n - 1), reached through main.
  let empty = m.add_capture_map(m.capture_map_new())
  let n = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  let self_ref = m.make_closure(func: 1, cmap: empty, line: 1, col: 1)
  let args = m.list_new()
  m.list_push(
    args,
    m.binary(
      op: 'sub',
      lhs: n,
      rhs: m.literal(v: 1, line: 1, col: 1),
      line: 1,
      col: 1,
    ),
  )
  let down_body = m.make_if_else(
    cond: m.binary(op: 'eq', lhs: n, rhs: m.literal(v: 0, line: 1, col: 1),
                   line: 1, col: 1),
    then_branch: m.make_return(value: m.str_literal(s: 'bottom', line: 1, col: 1),
                               line: 1, col: 1),
    else_branch: m.make_return(
      value: m.call_value(callee: self_ref, args: args, line: 1, col: 1),
      line: 1, col: 1),
    line: 1,
    col: 1,
  )

  let call_args = m.list_new()
  m.list_push(call_args, m.literal(v: 50000, line: 1, col: 1))  # 5x the limit
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, m.call_value(
               callee: m.make_closure(func: 1, cmap: empty, line: 1, col: 1),
               args: call_args, line: 1, col: 1)),
  )
  m.add_func(
    name: 'down',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 1,
    body: down_body,
  )
  m
}
{
  let m = counting_chain(CodeGen.Module.new())
  assert_false(m.func_tail_calls(func: 1))
  m.set_tail_calls(func: 1)
  assert_true(m.func_tail_calls(func: 1))
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "bottom\n")
}
{
  # The control: the same chain without the flag really does run out of
  # frames, so the case above is testing the optimization, not the arithmetic.
  let m = counting_chain(CodeGen.Module.new())
  m.verify()
  let err = try {
    m.run()
  } catch e {
    e
  }
  assert_eq("{err.kind}: {err.message}", 'IrError: recursion limit exceeded')
}

# --- The shapes the IR has to see *through* to find a call still in tail
# position. `set_tail_calls`' own documentation names four containers -- a
# make_return's operand, or a body's final value through a block, an if, a
# switch or a scope -- and the case above covers only the first two. Each
# chain below is 50000 deep, five times the frame limit, so a call the IR
# failed to recognize does not merely run slower: it does not finish. ---

# down(n), reached through main, with the recursive call placed by `body_of`.
# `n` is local 0; `again` is the call that has to stay in tail position.
fn tail_chain(m, body_of, nlocals = 1) {
  let empty = m.add_capture_map(m.capture_map_new())
  let n = m.var_ref('local', 0, ORIGIN_F)
  let again = m.call_value(
    m.make_closure(1, empty, ORIGIN_F),
    [m.binary('sub', n, m.literal(1, ORIGIN_F), ORIGIN_F)],
    ORIGIN_F,
  )
  let done = m.str_literal('bottom', ORIGIN_F)
  let at_zero = m.binary('eq', n, m.literal(0, ORIGIN_F), ORIGIN_F)

  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, m.call_value(
               m.make_closure(1, empty, ORIGIN_F),
               [m.literal(50000, ORIGIN_F)],
               ORIGIN_F,
             )),
  )
  m.add_func(
    name: 'down',
    num_locals: nlocals,
    num_captures: 0,
    num_cells: 0,
    num_params: 1,
    body: body_of(m, at_zero, again, done),
  )
  m.set_tail_calls(func: 1)
  m
}

fn runs_to_bottom(m) {
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "bottom\n")
}

# the *then* arm, where the case above used the else
runs_to_bottom(tail_chain(CodeGen.Module.new(), fn (m, at_zero, again, done) {
  m.make_if_else(
    m.make_if_else(
      at_zero,
      m.bool_literal(false, ORIGIN_F),
      m.bool_literal(true, ORIGIN_F),
      ORIGIN_F,
    ),
    m.make_return(again, ORIGIN_F),
    m.make_return(done, ORIGIN_F),
    ORIGIN_F,
  )
}))

# a block's final value, with no make_return around it
runs_to_bottom(tail_chain(CodeGen.Module.new(), fn (m, at_zero, again, done) {
  m.block(
    [m.make_if(at_zero, m.make_return(done, ORIGIN_F), ORIGIN_F), again],
    ORIGIN_F,
  )
}))

# a switch arm, and its default
runs_to_bottom(tail_chain(CodeGen.Module.new(), fn (m, at_zero, again, done) {
  m.make_switch_default(
    m.var_ref('local', 0, ORIGIN_F),
    [m.literal(0, ORIGIN_F), m.make_return(done, ORIGIN_F)],
    again,
    ORIGIN_F,
  )
}))

# a scope's final value
runs_to_bottom(tail_chain(CodeGen.Module.new(), fn (m, at_zero, again, done) {
  m.scope(
    1,
    1,
    m.block(
      [m.make_if(at_zero, m.make_return(done, ORIGIN_F), ORIGIN_F), again],
      ORIGIN_F,
    ),
    ORIGIN_F,
  )
}))

# --- Mutual recursion: neither function's frame may survive its own call,
# so a chain alternating between the two only completes if both are flagged.
{
  let m = CodeGen.Module.new()
  let empty = m.add_capture_map(m.capture_map_new())
  let n = m.var_ref('local', 0, ORIGIN_F)
  let dec = m.binary('sub', n, m.literal(1, ORIGIN_F), ORIGIN_F)
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, m.call_value(
               m.make_closure(1, empty, ORIGIN_F),
               [m.literal(50000, ORIGIN_F)],
               ORIGIN_F,
             )),
  )
  # ping(n) = n == 0 ? 'bottom' : pong(n - 1);  pong(n) = ping(n)
  for f in [1, 2] {
    let callee = cond {
      f == 1 => 2,
      _ => 1,
    }
    let arg = cond {
      f == 1 => dec,
      _ => n,
    }
    m.add_func(
      name: cond {
        f == 1 => 'ping',
        _ => 'pong',
      },
      num_locals: 1,
      num_captures: 0,
      num_cells: 0,
      num_params: 1,
      body: m.make_if_else(
        m.binary('eq', n, m.literal(0, ORIGIN_F), ORIGIN_F),
        m.make_return(m.str_literal('bottom', ORIGIN_F), ORIGIN_F),
        m.make_return(
          m.call_value(m.make_closure(callee, empty, ORIGIN_F), [arg], ORIGIN_F),
          ORIGIN_F,
        ),
        ORIGIN_F,
      ),
    )
    m.set_tail_calls(func: f)
  }
  runs_to_bottom(m)
}

# --- Where a tail call is refused, on purpose: the frame has to still be
# there. A call inside a try region needs its handler, and a scope that
# releases its own locals needs to run those releases after the callee
# returns -- so both stay ordinary calls and both run out of frames. ---
fn exhausts(m) {
  m.verify()
  let err = try {
    m.run()
  } catch e {
    e
  }
  assert_eq("{err.kind}: {err.message}", 'IrError: recursion limit exceeded')
}

# The try's own handler is what proves it: the chain runs out of frames and
# the handler is still there to catch it, which is the whole reason the call
# could not have replaced the frame.
{
  let m = tail_chain(CodeGen.Module.new(), fn (m2, at_zero, again, done) {
    m2.make_try(
      1,
      m2.block(
        [m2.make_if(at_zero, m2.make_return(done, ORIGIN_F), ORIGIN_F), again],
        ORIGIN_F,
      ),
      m2.make_return(m2.str_literal('caught', ORIGIN_F), ORIGIN_F),
      ORIGIN_F,
    )
  }, 2)
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "caught\n")
}

exhausts(tail_chain(CodeGen.Module.new(), fn (m, at_zero, again, done) {
  m.scope_release(
    0,
    1,
    m.block(
      [m.make_if(at_zero, m.make_return(done, ORIGIN_F), ORIGIN_F), again],
      ORIGIN_F,
    ),
    [m.var_ref('local', 0, ORIGIN_F)],
    ORIGIN_F,
  )
}))

# --- Singletons: one closure per function, shared by every make_closure. ---

# main prints whether two closures of func 1 are the same object.
fn twin_closures(m) {
  let empty = m.add_capture_map(m.capture_map_new())
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, call_intr(m, 'same', [
               m.make_closure(func: 1, cmap: empty, line: 1, col: 1),
               m.make_closure(func: 1, cmap: empty, line: 1, col: 1),
             ])),
  )
  m.add_func(
    name: 'helper',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: m.make_return(value: m.literal(v: 1, line: 1, col: 1), line: 1, col: 1),
  )
  m
}
{
  let m = twin_closures(CodeGen.Module.new())
  assert_false(m.func_singleton(func: 1))
  m.set_singleton(func: 1)
  assert_true(m.func_singleton(func: 1))
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "true\n")
}
{
  # The control: without the flag each make_closure builds its own object.
  let m = twin_closures(CodeGen.Module.new())
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "false\n")
}
{
  # A function with captures cannot be a singleton: its closure is built
  # from the frame that makes it, so there is no one object to share.
  let m = CodeGen.Module.new()
  let cm = m.capture_map_new()
  m.capture_map_push(cmap: cm, kind: 'cell', index: 0)
  let with_cell = m.add_capture_map(cm)
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 1,
    num_params: 0,
    body: m.make_closure(func: 1, cmap: with_cell, line: 1, col: 1),
  )
  m.add_func(
    name: 'f',
    num_locals: 0,
    num_captures: 1,
    num_cells: 0,
    num_params: 0,
    body: m.var_ref(kind: 'capture', index: 0, line: 1, col: 1),
  )
  m.verify()
  m.set_singleton(func: 1)
  let err = try {
    m.verify()
  } catch e {
    e
  }
  assert_eq(
    "{err.kind}: {err.message}",
    'IrError: singleton func cannot take captures',
  )
}

# --- Host functions: a module names them, run() says what they do. ----------

# A call of native `name` with `args`, as a node.
fn native_call(m, name, args) {
  let idx = m.declare_native(name: name)
  let list = m.list_new()
  for a in args {
    m.list_push(list, a)
  }
  m.call_value(
    callee: m.native_ref(index: idx, line: 1, col: 1),
    args: list,
    line: 1,
    col: 1,
  )
}

# main = print(name(args...))
fn native_call_module(m, name, args) {
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, native_call(m, name, args)),
  )
  m.verify()
  m
}

# main = try { name(args...) } catch e { print(e[key]) } -- the shape every
# "the program catches what the bridge reports" case below wants.
fn native_catch_module(m, name, args, key) {
  let caught = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  m.add_func(
    name: 'main',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: m.make_try(
               caught_local: 0, body: native_call(m, name, args),
               handler: print_stmt(m, m.index(recv: caught,
                                              key: m.str_literal(s: key, line: 1, col: 1),
                                              line: 1, col: 1)),
               line: 1, col: 1),
  )
  m.verify()
  m
}

{
  # The answer flows on into the program's own arithmetic, not just to print.
  let m = CodeGen.Module.new()
  let idx = m.declare_native(name: 'add')
  let args = m.list_new()
  m.list_push(args, m.literal(v: 2, line: 1, col: 1))
  m.list_push(args, m.literal(v: 3, line: 1, col: 1))
  let called = m.call_value(
    callee: m.native_ref(index: idx, line: 1, col: 1),
    args: args,
    line: 1,
    col: 1,
  )
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, m.binary(op: 'mul', lhs: called,
                                          rhs: m.literal(v: 10, line: 1, col: 1),
                                          line: 1, col: 1)),
  )
  m.verify()
  let out = IO.capture(fn () {
    m.compile().run(natives: {add: |a, b| a + b})
  })
  assert_eq(out, "50\n")
}
{
  # Strings cross as copies, both ways.
  let m = CodeGen.Module.new()
  let mm = native_call_module(
    m,
    'shout',
    [m.str_literal(s: 'hi', line: 1, col: 1)],
  )
  assert_eq(IO.capture(fn () {
    mm.compile().run(natives: {shout: |s| s + '!'})
  }), "hi!\n")
}
{
  # Float and Bool round-trip through the boundary.
  let m = CodeGen.Module.new()
  let mm = native_call_module(
    m,
    'half',
    [m.double_literal(v: 5.0, line: 1, col: 1)],
  )
  assert_eq(IO.capture(fn () {
    mm.compile().run(natives: {half: |x| x / 2.0})
  }), "2.5\n")
}
{
  # A native's throw is the program's to catch: a scalar arrives as itself.
  let m = CodeGen.Module.new()
  let idx = m.declare_native(name: 'boom')
  let call = m.call_value(
    callee: m.native_ref(index: idx, line: 1, col: 1),
    args: m.list_new(),
    line: 1,
    col: 1,
  )
  m.add_func(
    name: 'main',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: m.make_try(caught_local: 0, body: call,
                              handler: print_stmt(
                                m, m.var_ref(kind: 'local', index: 0, line: 1, col: 1)),
                              line: 1, col: 1),
  )
  m.verify()
  let out = IO.capture(fn () {
    m.compile().run(natives: {boom: fn () { throw 'kaboom' }})
  })
  assert_eq(out, "kaboom\n")
}
{
  # A non-scalar throw cannot cross as itself, so it arrives as the
  # {kind, message, line, col} object a culebra error would have shown.
  let m = native_catch_module(CodeGen.Module.new(), 'boom', [], 'message')
  let out = IO.capture(fn () {
    m
      .compile()
      .run(natives: {boom: || throw {kind: 'MyError', message: 'nope'}})
  })
  assert_eq(out, "nope\n")
}
{
  # A culebra-level error inside the native is the same shape.
  let m = CodeGen.Module.new()
  let mm = native_call_module(m, 'bad', [m.literal(v: 1, line: 1, col: 1)])
  let p = mm.compile()
  let err = try {
    p.run(natives: {bad: |n| n.no_such_method()})
  } catch e {
    e
  }
  assert_true(err != nil)
}
{
  # A native's throw is answered HERE, so it must not stay in flight on the
  # culebra side: the guest caught it, and culebra never will. The check is
  # the very next run, with nothing in between to clear a stale carrier --
  # it must fail for its own reason, not be handed the previous throw.
  let thrower = CodeGen.Module.new()
  let ti = thrower.declare_native(name: 'boom')
  let tcall = thrower.call_value(
    callee: thrower.native_ref(index: ti, line: 1, col: 1),
    args: thrower.list_new(),
    line: 1,
    col: 1,
  )
  thrower.add_func(
    name: 'main',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: thrower.make_try(caught_local: 0, body: tcall,
                                          handler: thrower.nil_literal(line: 1, col: 1),
                                          line: 1, col: 1),
  )
  thrower.verify()
  thrower.compile().run(natives: {boom: fn () { throw 'kaboom' }})

  let m = CodeGen.Module.new()
  let idx = m.declare_native(name: 'unsupplied')
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: m.native_ref(index: idx, line: 1, col: 1),
  )
  m.verify()
  let err = try {
    m.compile().run()
  } catch e {
    e
  }
  assert_eq(
    "{err.kind}: {err.message}",
    "IrError: native 'unsupplied' is declared but not supplied",
  )
}
{
  # Declared but not supplied -- named, and refused before the run starts.
  let m = CodeGen.Module.new()
  let mm = native_call_module(m, 'missing', [])
  let p = mm.compile()
  let err = try {
    p.run()
  } catch e {
    e
  }
  assert_eq(
    "{err.kind}: {err.message}",
    "IrError: native 'missing' is declared but not supplied",
  )
  # The error is positioned at the call, like every other wrapped method's:
  # run's own thunk is hand-written, so it owes that guard itself.
  assert_true(err.line > 0)
}
{
  # Supplied as something that is not a Function.
  let m = CodeGen.Module.new()
  let mm = native_call_module(m, 'nope', [])
  let p = mm.compile()
  let err = try {
    p.run(natives: {nope: 5})
  } catch e {
    e
  }
  assert_eq(
    "{err.kind}: {err.message}",
    "TypeError: native 'nope' must be a Function, got Long",
  )
}
{
  # run's thunk is hand-written, so the argument type check the deduced ones
  # get from wrap.h is its own to do. Without it jit_handle_self would
  # reinterpret_cast a Long into a handle -- a wild pointer, not an error.
  let m = CodeGen.Module.new()
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: m.nil_literal(line: 1, col: 1),
  )
  m.verify()
  let p = m.compile()
  assert_throws('TypeError', || p.run(rt: 5))
  assert_throws('TypeError', || p.run(rt: m))  # a handle of the wrong class
  assert_throws('TypeError', || p.run(max_call_depth: 'oops'))
  assert_throws('TypeError', || p.run(natives: 5))
  p.run()  # and every argument is still optional
}
{
  # A name the module never declared is fine: one table can serve several
  # programs, and this one declares nothing at all.
  let m = CodeGen.Module.new()
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, m.literal(v: 1, line: 1, col: 1)),
  )
  m.verify()
  assert_eq(IO.capture(fn () {
    m.compile().run(natives: {unused: || 0})
  }), "1\n")
}
{
  # Arity is checked against the culebra closure, and the guest can catch it.
  let m = CodeGen.Module.new()
  let mm = native_catch_module(
    m,
    'add',
    [m.literal(v: 1, line: 1, col: 1)],
    'kind',
  )
  let out = IO.capture(fn () {
    mm.compile().run(natives: {add: |a, b| a + b})
  })
  assert_eq(out, "ArityError\n")
}
{
  # A value with heap identity cannot cross either way -- named, catchable,
  # and not a crash. Out first: the guest hands an array to the native.
  let m = CodeGen.Module.new()
  let items = m.list_new()
  m.list_push(items, m.literal(v: 1, line: 1, col: 1))
  let mm = native_catch_module(
    m,
    'take',
    [m.array_lit(items: items, line: 1, col: 1)],
    'kind',
  )
  assert_eq(IO.capture(fn () {
    mm.compile().run(natives: {take: |x| 0})
  }), "TypeError\n")
}
{
  # And back: the native returns an array.
  let m = native_catch_module(CodeGen.Module.new(), 'give', [], 'kind')
  assert_eq(IO.capture(fn () {
    m.compile().run(natives: {give: || [1, 2]})
  }), "TypeError\n")
}
{
  # Two declared names may share one closure, and the same Program may run
  # twice with different tables -- the table is built per run, not cached.
  let m = CodeGen.Module.new()
  let a = m.declare_native(name: 'a')
  let b = m.declare_native(name: 'b')
  fn call0(mm, i) {
    mm.call_value(
      callee: mm.native_ref(index: i, line: 1, col: 1),
      args: mm.list_new(),
      line: 1,
      col: 1,
    )
  }
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: stmt_block(m, [print_stmt(m, call0(m, a)),
                                  print_stmt(m, call0(m, b))]),
  )
  m.verify()
  let p = m.compile()
  let same = || 7
  assert_eq(IO.capture(fn () {
    p.run(natives: {a: same, b: same})
  }), "7\n7\n")
  assert_eq(IO.capture(fn () {
    p.run(natives: {a: || 1, b: || 2})
  }), "1\n2\n")
}

# --- The five shapes a front end would otherwise write for itself: the
# unary not, joining and sizing an array, counting a map's entries, and
# ASCII case. Each is here because two or more of examples/languages had
# written its own before the IR had one. ---
{
  let m = CodeGen.Module.new()
  let xs = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  let mp = m.var_ref(kind: 'local', index: 1, line: 1, col: 1)
  m.add_func(
    name: 'main',
    num_locals: 2,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: stmt_block(m, [
      # not answers for every value, over the truthiness a condition tests
      print_stmt(m, m.unary(
        op: 'not',
        operand: m.bool_literal(v: true, line: 1, col: 1),
        line: 1,
        col: 1,
      )),
      print_stmt(m, m.unary(
        op: 'not',
        operand: m.nil_literal(line: 1, col: 1),
        line: 1,
        col: 1,
      )),
      print_stmt(m, m.unary(
        op: 'not',
        operand: m.literal(v: 0, line: 1, col: 1),
        line: 1,
        col: 1,
      )),
      # arrayfill starts an array at a length, arrayconcat joins one on
      m.assign(kind: 'local', index: 0, value: call_intr(m, 'arrayfill', [
        m.literal(v: 2, line: 1, col: 1),
        m.literal(v: 7, line: 1, col: 1),
      ]), line: 1, col: 1),
      call_intr(m, 'arrayconcat', [xs, m.array_lit(
        items: [m.literal(v: 9, line: 1, col: 1)],
        line: 1,
        col: 1,
      )]),
      print_stmt(m, call_intr(m, 'len', [xs])),
      print_stmt(m, m.index(
        recv: xs,
        key: m.literal(v: 2, line: 1, col: 1),
        line: 1,
        col: 1,
      )),
      # len answers a map's entry count as well as an array's length
      m.assign(kind: 'local', index: 1, value: call_intr(m, 'mapnew', []),
               line: 1, col: 1),
      m.set_index(
        recv: mp,
        key: m.str_literal(s: 'a', line: 1, col: 1),
        value: m.literal(v: 1, line: 1, col: 1),
        line: 1,
        col: 1,
      ),
      print_stmt(m, call_intr(m, 'len', [mp])),
      # ASCII case, and only ASCII: the two-byte character is untouched
      print_stmt(m, call_intr(m, 'strupper', [
        m.str_literal(s: 'aB1é', line: 1, col: 1),
      ])),
      print_stmt(m, call_intr(m, 'strlower', [
        m.str_literal(s: 'Ab1É', line: 1, col: 1),
      ])),
    ]),
  )
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "false\ntrue\ntrue\n3\n9\n1\nAB1é\nab1É\n")
}

# --- The message a read gets when the captures are not numbered yet. It
# names the fix, because the other way to reach the same place -- a read
# nothing recorded -- has a different one. ---
{
  let m = CodeGen.Module.new()
  let rs = CodeGen.Resolver.new()
  let outer = rs.new_fn(-1)
  rs.set_func_index(outer, 0)
  rs.push_scope()
  let v = rs.declare('x', outer)
  rs.set_var_slot(v, 0)
  let inner = rs.new_fn(outer)
  rs.set_func_index(inner, 1)
  rs.use(v, inner)
  assert_throws('IrError', fn () {
    rs.read(m, inner, v, line: 1, col: 1)
  })
}

println('test_codegen_funcs OK')
