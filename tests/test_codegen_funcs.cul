# CodeGen.Module, continued from test_codegen.cul: the per-function flags
# (set_tail_calls, set_singleton) and host functions (declare_native /
# native_ref, bound at run() and compile()+Program.run()). Split from
# test_codegen.cul once that file crossed the --jit compile-time bound: a
# flat script compiles as one JIT function, whose optimization cost grows
# superlinearly with size.
#
# Run with:  ./build/culebra tests/test_codegen_funcs.cul
#            ./build/culebra --jit tests/test_codegen_funcs.cul

fn stmt_block(m, stmts) {
  let list = m.list_new()
  for s in stmts {
    m.list_push(list, s)
  }
  m.block(stmts_list: list, line: 1, col: 1)
}

fn print_stmt(m, value) {
  let args = m.list_new()
  m.list_push(args, value)
  m.intrinsic(name: 'print', args_list: args, line: 1, col: 1)
}

fn call_intr(m, name, args) {
  let list = m.list_new()
  for a in args {
    m.list_push(list, a)
  }
  m.intrinsic(name: name, args_list: list, line: 1, col: 1)
}

# --- A function may opt into tail calls: a call chain deeper than the frame
# limit completes in one frame. The control is the same module with the flag
# off, which really does exhaust the limit -- without it this test would pass
# on a build that ignored the flag entirely. ---
fn counting_chain(m) {
  # down(n) = n == 0 ? 'bottom' : down(n - 1), reached through main.
  let empty = m.add_capture_map(m.capture_map_new())
  let n = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  let self_ref = m.make_closure(func: 1, cmap: empty, line: 1, col: 1)
  let args = m.list_new()
  m.list_push(
    args,
    m.binary(
      op: 'sub',
      lhs: n,
      rhs: m.literal(v: 1, line: 1, col: 1),
      line: 1,
      col: 1,
    ),
  )
  let down_body = m.make_if_else(
    cond: m.binary(op: 'eq', lhs: n, rhs: m.literal(v: 0, line: 1, col: 1),
                   line: 1, col: 1),
    then_branch: m.make_return(value: m.str_literal(s: 'bottom', line: 1, col: 1),
                               line: 1, col: 1),
    else_branch: m.make_return(
      value: m.call_value(callee: self_ref, args_list: args, line: 1, col: 1),
      line: 1, col: 1),
    line: 1,
    col: 1,
  )

  let call_args = m.list_new()
  m.list_push(call_args, m.literal(v: 50000, line: 1, col: 1))  # 5x the limit
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, m.call_value(
               callee: m.make_closure(func: 1, cmap: empty, line: 1, col: 1),
               args_list: call_args, line: 1, col: 1)),
  )
  m.add_func(
    name: 'down',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 1,
    body: down_body,
  )
  m
}
{
  let m = counting_chain(CodeGen.Module.new())
  assert_false(m.func_tail_calls(func: 1))
  m.set_tail_calls(func: 1)
  assert_true(m.func_tail_calls(func: 1))
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "bottom\n")
}
{
  # The control: the same chain without the flag really does run out of
  # frames, so the case above is testing the optimization, not the arithmetic.
  let m = counting_chain(CodeGen.Module.new())
  m.verify()
  let err = try {
    m.run()
  } catch e {
    e
  }
  assert_eq("{err.kind}: {err.message}", 'IrError: recursion limit exceeded')
}

# --- Singletons: one closure per function, shared by every make_closure. ---

# main prints whether two closures of func 1 are the same object.
fn twin_closures(m) {
  let empty = m.add_capture_map(m.capture_map_new())
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, call_intr(m, 'same', [
               m.make_closure(func: 1, cmap: empty, line: 1, col: 1),
               m.make_closure(func: 1, cmap: empty, line: 1, col: 1),
             ])),
  )
  m.add_func(
    name: 'helper',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: m.make_return(value: m.literal(v: 1, line: 1, col: 1), line: 1, col: 1),
  )
  m
}
{
  let m = twin_closures(CodeGen.Module.new())
  assert_false(m.func_singleton(func: 1))
  m.set_singleton(func: 1)
  assert_true(m.func_singleton(func: 1))
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "true\n")
}
{
  # The control: without the flag each make_closure builds its own object.
  let m = twin_closures(CodeGen.Module.new())
  m.verify()
  assert_eq(IO.capture(fn () {
    m.run()
  }), "false\n")
}
{
  # A function with captures cannot be a singleton: its closure is built
  # from the frame that makes it, so there is no one object to share.
  let m = CodeGen.Module.new()
  let cm = m.capture_map_new()
  m.capture_map_push(cmap: cm, kind: 'cell', index: 0)
  let with_cell = m.add_capture_map(cm)
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 1,
    num_params: 0,
    body: m.make_closure(func: 1, cmap: with_cell, line: 1, col: 1),
  )
  m.add_func(
    name: 'f',
    num_locals: 0,
    num_captures: 1,
    num_cells: 0,
    num_params: 0,
    body: m.var_ref(kind: 'capture', index: 0, line: 1, col: 1),
  )
  m.verify()
  m.set_singleton(func: 1)
  let err = try {
    m.verify()
  } catch e {
    e
  }
  assert_eq(
    "{err.kind}: {err.message}",
    'IrError: singleton func cannot take captures',
  )
}

# --- Host functions: a module names them, run() says what they do. ----------

# A call of native `name` with `args`, as a node.
fn native_call(m, name, args) {
  let idx = m.declare_native(name: name)
  let list = m.list_new()
  for a in args {
    m.list_push(list, a)
  }
  m.call_value(
    callee: m.native_ref(index: idx, line: 1, col: 1),
    args_list: list,
    line: 1,
    col: 1,
  )
}

# main = print(name(args...))
fn native_call_module(m, name, args) {
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, native_call(m, name, args)),
  )
  m.verify()
  m
}

# main = try { name(args...) } catch e { print(e[key]) } -- the shape every
# "the program catches what the bridge reports" case below wants.
fn native_catch_module(m, name, args, key) {
  let caught = m.var_ref(kind: 'local', index: 0, line: 1, col: 1)
  m.add_func(
    name: 'main',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: m.make_try(
               caught_local: 0, body: native_call(m, name, args),
               handler: print_stmt(m, m.index(recv: caught,
                                              key: m.str_literal(s: key, line: 1, col: 1),
                                              line: 1, col: 1)),
               line: 1, col: 1),
  )
  m.verify()
  m
}

{
  # The answer flows on into the program's own arithmetic, not just to print.
  let m = CodeGen.Module.new()
  let idx = m.declare_native(name: 'add')
  let args = m.list_new()
  m.list_push(args, m.literal(v: 2, line: 1, col: 1))
  m.list_push(args, m.literal(v: 3, line: 1, col: 1))
  let called = m.call_value(
    callee: m.native_ref(index: idx, line: 1, col: 1),
    args_list: args,
    line: 1,
    col: 1,
  )
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, m.binary(op: 'mul', lhs: called,
                                          rhs: m.literal(v: 10, line: 1, col: 1),
                                          line: 1, col: 1)),
  )
  m.verify()
  let out = IO.capture(fn () {
    m.compile().run(natives: {add: |a, b| a + b})
  })
  assert_eq(out, "50\n")
}
{
  # Strings cross as copies, both ways.
  let m = CodeGen.Module.new()
  let mm = native_call_module(
    m,
    'shout',
    [m.str_literal(s: 'hi', line: 1, col: 1)],
  )
  assert_eq(IO.capture(fn () {
    mm.compile().run(natives: {shout: |s| s + '!'})
  }), "hi!\n")
}
{
  # Float and Bool round-trip through the boundary.
  let m = CodeGen.Module.new()
  let mm = native_call_module(
    m,
    'half',
    [m.double_literal(v: 5.0, line: 1, col: 1)],
  )
  assert_eq(IO.capture(fn () {
    mm.compile().run(natives: {half: |x| x / 2.0})
  }), "2.5\n")
}
{
  # A native's throw is the program's to catch: a scalar arrives as itself.
  let m = CodeGen.Module.new()
  let idx = m.declare_native(name: 'boom')
  let call = m.call_value(
    callee: m.native_ref(index: idx, line: 1, col: 1),
    args_list: m.list_new(),
    line: 1,
    col: 1,
  )
  m.add_func(
    name: 'main',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: m.make_try(caught_local: 0, body: call,
                              handler: print_stmt(
                                m, m.var_ref(kind: 'local', index: 0, line: 1, col: 1)),
                              line: 1, col: 1),
  )
  m.verify()
  let out = IO.capture(fn () {
    m.compile().run(natives: {boom: fn () { throw 'kaboom' }})
  })
  assert_eq(out, "kaboom\n")
}
{
  # A non-scalar throw cannot cross as itself, so it arrives as the
  # {kind, message, line, col} object a culebra error would have shown.
  let m = native_catch_module(CodeGen.Module.new(), 'boom', [], 'message')
  let out = IO.capture(fn () {
    m
      .compile()
      .run(natives: {boom: || throw {kind: 'MyError', message: 'nope'}})
  })
  assert_eq(out, "nope\n")
}
{
  # A culebra-level error inside the native is the same shape.
  let m = CodeGen.Module.new()
  let mm = native_call_module(m, 'bad', [m.literal(v: 1, line: 1, col: 1)])
  let p = mm.compile()
  let err = try {
    p.run(natives: {bad: |n| n.no_such_method()})
  } catch e {
    e
  }
  assert_true(err != nil)
}
{
  # A native's throw is answered HERE, so it must not stay in flight on the
  # culebra side: the guest caught it, and culebra never will. The check is
  # the very next run, with nothing in between to clear a stale carrier --
  # it must fail for its own reason, not be handed the previous throw.
  let thrower = CodeGen.Module.new()
  let ti = thrower.declare_native(name: 'boom')
  let tcall = thrower.call_value(
    callee: thrower.native_ref(index: ti, line: 1, col: 1),
    args_list: thrower.list_new(),
    line: 1,
    col: 1,
  )
  thrower.add_func(
    name: 'main',
    num_locals: 1,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: thrower.make_try(caught_local: 0, body: tcall,
                                          handler: thrower.nil_literal(line: 1, col: 1),
                                          line: 1, col: 1),
  )
  thrower.verify()
  thrower.compile().run(natives: {boom: fn () { throw 'kaboom' }})

  let m = CodeGen.Module.new()
  let idx = m.declare_native(name: 'unsupplied')
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: m.native_ref(index: idx, line: 1, col: 1),
  )
  m.verify()
  let err = try {
    m.compile().run()
  } catch e {
    e
  }
  assert_eq(
    "{err.kind}: {err.message}",
    "IrError: native 'unsupplied' is declared but not supplied",
  )
}
{
  # Declared but not supplied -- named, and refused before the run starts.
  let m = CodeGen.Module.new()
  let mm = native_call_module(m, 'missing', [])
  let p = mm.compile()
  let err = try {
    p.run()
  } catch e {
    e
  }
  assert_eq(
    "{err.kind}: {err.message}",
    "IrError: native 'missing' is declared but not supplied",
  )
  # The error is positioned at the call, like every other wrapped method's:
  # run's own thunk is hand-written, so it owes that guard itself.
  assert_true(err.line > 0)
}
{
  # Supplied as something that is not a Function.
  let m = CodeGen.Module.new()
  let mm = native_call_module(m, 'nope', [])
  let p = mm.compile()
  let err = try {
    p.run(natives: {nope: 5})
  } catch e {
    e
  }
  assert_eq(
    "{err.kind}: {err.message}",
    "TypeError: native 'nope' must be a Function, got Long",
  )
}
{
  # run's thunk is hand-written, so the argument type check the deduced ones
  # get from wrap.h is its own to do. Without it jit_handle_self would
  # reinterpret_cast a Long into a handle -- a wild pointer, not an error.
  let m = CodeGen.Module.new()
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: m.nil_literal(line: 1, col: 1),
  )
  m.verify()
  let p = m.compile()
  assert_throws('TypeError', || p.run(rt: 5))
  assert_throws('TypeError', || p.run(rt: m))  # a handle of the wrong class
  assert_throws('TypeError', || p.run(max_call_depth: 'oops'))
  assert_throws('TypeError', || p.run(natives: 5))
  p.run()  # and every argument is still optional
}
{
  # A name the module never declared is fine: one table can serve several
  # programs, and this one declares nothing at all.
  let m = CodeGen.Module.new()
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: print_stmt(m, m.literal(v: 1, line: 1, col: 1)),
  )
  m.verify()
  assert_eq(IO.capture(fn () {
    m.compile().run(natives: {unused: || 0})
  }), "1\n")
}
{
  # Arity is checked against the culebra closure, and the guest can catch it.
  let m = CodeGen.Module.new()
  let mm = native_catch_module(
    m,
    'add',
    [m.literal(v: 1, line: 1, col: 1)],
    'kind',
  )
  let out = IO.capture(fn () {
    mm.compile().run(natives: {add: |a, b| a + b})
  })
  assert_eq(out, "ArityError\n")
}
{
  # A value with heap identity cannot cross either way -- named, catchable,
  # and not a crash. Out first: the guest hands an array to the native.
  let m = CodeGen.Module.new()
  let items = m.list_new()
  m.list_push(items, m.literal(v: 1, line: 1, col: 1))
  let mm = native_catch_module(
    m,
    'take',
    [m.array_lit(items_list: items, line: 1, col: 1)],
    'kind',
  )
  assert_eq(IO.capture(fn () {
    mm.compile().run(natives: {take: |x| 0})
  }), "TypeError\n")
}
{
  # And back: the native returns an array.
  let m = native_catch_module(CodeGen.Module.new(), 'give', [], 'kind')
  assert_eq(IO.capture(fn () {
    m.compile().run(natives: {give: || [1, 2]})
  }), "TypeError\n")
}
{
  # Two declared names may share one closure, and the same Program may run
  # twice with different tables -- the table is built per run, not cached.
  let m = CodeGen.Module.new()
  let a = m.declare_native(name: 'a')
  let b = m.declare_native(name: 'b')
  fn call0(mm, i) {
    mm.call_value(
      callee: mm.native_ref(index: i, line: 1, col: 1),
      args_list: mm.list_new(),
      line: 1,
      col: 1,
    )
  }
  m.add_func(
    name: 'main',
    num_locals: 0,
    num_captures: 0,
    num_cells: 0,
    num_params: 0,
    body: stmt_block(m, [print_stmt(m, call0(m, a)),
                                  print_stmt(m, call0(m, b))]),
  )
  m.verify()
  let p = m.compile()
  let same = || 7
  assert_eq(IO.capture(fn () {
    p.run(natives: {a: same, b: same})
  }), "7\n7\n")
  assert_eq(IO.capture(fn () {
    p.run(natives: {a: || 1, b: || 2})
  }), "1\n2\n")
}

println('test_codegen_funcs OK')
