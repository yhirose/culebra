# Conformance: §18 (builtins). See docs/language.md.
#
# Builtin functions as first-class values. The direct-call forms
# (`type_of(x)`, `inspect(x)`) keep their fast paths; binding a builtin to a
# variable or handing it to a higher-order function exercises the runtime
# closure path. Runs under interp, --jit, and AOT — all must agree.
#
# Run: ./build/culebra tests/test_builtin_fn_value.cul
#      ./build/culebra --jit tests/test_builtin_fn_value.cul

# Bound to a variable, then called.
let t = type_of
assert_eq(t(3.14), 'Float')
assert_eq(t(1), 'Long')
assert_eq(t('s'), 'String')

let g = to_string
assert_eq([g(1), g(true), g(nil)], ['1', 'true', 'nil'])

let h = hash
assert_eq(h(42), hash(42))

# Passed to higher-order functions (the original motivating case).
assert_eq([1, 2, 3].map(type_of), ['Long', 'Long', 'Long'])
assert_eq([1, 2, 3].map(to_float), [1.0, 2.0, 3.0])
assert_eq([1.9, 2.1, -3.5].map(to_long), [1, 2, -3])
assert_eq([1, 22, 333].map(to_string), ['1', '22', '333'])
assert_eq(['1', '2', '3'].map(to_long), [1, 2, 3])

# filter with a builtin predicate-shaped value (to_bool not a builtin; use
# a chain through map instead — type_of as the discriminator).
assert_eq([1, 2.0, 3].map(type_of).filter(fn (s) { s == 'Long' }).size(), 2)

# Side-effecting builtin (inspect) as a for_each callback — newline per element.
[7, 8].for_each(inspect)

# range / iota as first-class values (variadic: 1 or 2 positional args).
let r = range
assert_eq(r(0, 5).collect(), [0, 1, 2, 3, 4])
assert_eq(r(3).collect(), [0, 1, 2])
let it = iota
assert_eq(it(5), [0, 1, 2, 3, 4])
assert_eq(it(2, 6), [2, 3, 4, 5])

# range / iota handed to a HOF — the variadic builtin runs per element with
# its `step` default and __ARGS__ supplied, exactly like a direct call.
assert_eq([1, 2, 3].map(range).map(fn (g) { g.collect() }),
          [[0], [0, 1], [0, 1, 2]])
assert_eq([3, 5].map(iota), [[0, 1, 2], [0, 1, 2, 3, 4]])

# Another variadic builtin (Math.min) bound and called directly.
let mn = Math.min
assert_eq(mn(3, 1, 2), 1)

# range's keyword-only `step` and `**` splat survive the value/closure path,
# not just the direct-call fast path. (The bare-positional and kwarg/splat
# calls all build the same args-rest slab.)
assert_eq(r(0, 10, step: 2).collect(), [0, 2, 4, 6, 8])
assert_eq(r(0, 10, **{step: 3}).collect(), [0, 3, 6, 9])
let kw = {step: 2}
assert_eq(range(0, 10, **kw).collect(), [0, 2, 4, 6, 8])   # direct splat

# Args-rest arity is validated off the collected positionals: 1 arg is `end`,
# a stray 3rd positional is an error even through the closure path.
assert_eq(r(7).collect(), [0, 1, 2, 3, 4, 5, 6])
