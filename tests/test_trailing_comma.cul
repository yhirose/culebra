// Conformance: §array / §object / §call / §params — a single trailing comma is
// allowed after the last element of a collection literal, argument list,
// parameter list, lambda params, and destructuring pattern. Every lane agrees.
//
// Kept as written: `culebra fmt` drops a trailing comma, which is what each
// line here tests, so do not reformat this file.

// --- collection literals ---
assert_eq([1, 2, 3,], [1, 2, 3])
assert_eq([1,], [1])
assert_eq({a: 1, b: 2,}, {a: 1, b: 2})
assert_eq({1, 2, 3,}, {1, 2, 3})
assert_eq((1, 2,), (1, 2))
assert_eq([[1, 2,], [3,],], [[1, 2], [3]]) // nested
// The comma is what makes a one-element tuple.
assert_eq(type_of((1,)), 'Tuple')
assert_eq(type_of((1)), 'Long')

// --- call arguments (positional, keyword, `**` splat) ---
fn add3(x, y, z) { x + y + z }
assert_eq(add3(1, 2, 3,), 6)
fn variadic(*xs) { xs.size() }
assert_eq(variadic(1, 2, 3,), 3)
fn kw_add(x, *, y = 0) { x + y }
assert_eq(kw_add(1, y: 2,), 3)
assert_eq(kw_add(1, **{y: 3},), 4)

// --- parameter lists + lambda params ---
fn mul3(a, b, c,) { a * b * c }
assert_eq(mul3(2, 3, 4,), 24)
let sub = |p, q,| p - q
assert_eq(sub(9, 4,), 5)

// --- destructuring patterns ---
let [m, n,] = [10, 20,]
assert_eq(m + n, 30)
let {a: aa, b: bb,} = {a: 5, b: 6,}
assert_eq(aa + bb, 11)

// --- empty literals are unaffected (no element → no trailing comma) ---
assert_eq([], [])
assert_eq({}, {})
