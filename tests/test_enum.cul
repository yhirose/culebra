// Sum types (enum): variant-as-class lowering. Constructing
// `Name.Variant(payload)` makes an instance tagged with the variant
// name and the parent enum name; nullary variants are singletons.
// Match uses constructor patterns `Ok(x)` (bare or `Name.Ok(x)`);
// type patterns match both the variant (`: Ok`) and the enum (`: Name`).

enum Result<T, E> {
  Ok(T),
  Err(E),
}
enum Color {
  Red,
  Green,
  Blue,
}
enum Shape {
  Circle(Float),
  Rect(Float, Float),
  Origin,
}

// --- Construction + payload field access ---
let r = Result.Ok(5)
assert_eq(r._0, 5)
assert_eq(r.class, "Ok")
let e = Result.Err("boom")
assert_eq(e._0, "boom")

// --- Constructor patterns bind positional payload ---
let unwrap = fn (v) {
  match v {
    Ok(x) => x,
    Err(m) => -1,
    _ => -2,
  }
}
assert_eq(unwrap(Result.Ok(42)), 42)
assert_eq(unwrap(Result.Err("x")), -1)

// --- Qualified ctor pattern + multi-payload + nullary via type pattern ---
let describe = fn (s) {
  match s {
    Shape.Circle(rad) => "circle:{rad}",
    Rect(w, h) => "rect:{w}x{h}",
    x: Origin => "origin",
    _ => "?",
  }
}
assert_eq(describe(Shape.Circle(2.0)), "circle:2.0")
assert_eq(describe(Shape.Rect(3, 4)), "rect:3x4")
assert_eq(describe(Shape.Origin), "origin")

// --- Type matching: variant name and enum parent name ---
let kind = fn (v) {
  match v {
    x: Result => "result",
    x: Color => "color",
    _ => "other",
  }
}
assert_eq(kind(Result.Ok(1)), "result")  // enum-parent match
assert_eq(kind(Result.Err(1)), "result")
assert_eq(kind(Color.Red), "color")
assert_eq(kind(Color.Blue), "color")
assert_eq(kind(42), "other")

// Variant-name type pattern is more specific than enum.
let is_ok = fn (v) {
  match v {
    x: Ok => true,
    _ => false,
  }
}
assert_eq(is_ok(Result.Ok(1)), true)
assert_eq(is_ok(Result.Err(1)), false)

// --- Nested ctor pattern (payload is itself matched) ---
let deep = fn (v) {
  match v {
    Ok(Ok(x)) => "nested:{x}",
    Ok(y) => "single",
    _ => "no",
  }
}
assert_eq(deep(Result.Ok(Result.Ok(9))), "nested:9")
assert_eq(deep(Result.Ok(7)), "single")

// --- Constructors are first-class values ---
let mk = Result.Ok
assert_eq(mk(11)._0, 11)

// --- Free-fn multidispatch on the VARIANT works (exact class tag) ---
fn tag_of(x: Ok) {
  "ok"
}
fn tag_of(x: Err) {
  "err"
}
fn tag_of(x: Long) {
  "long"
}
assert_eq(tag_of(Result.Ok(1)), "ok")
assert_eq(tag_of(Result.Err(1)), "err")
assert_eq(tag_of(5), "long")

// Canonical sum-type style: an untyped param + match over variants.
fn area(s) {
  match s {
    Circle(r) => r,
    Rect(w, h) => w,
    _ => 0,
  }
}
assert_eq(area(Shape.Circle(9.0)), 9.0)
assert_eq(area(Shape.Rect(2, 3)), 2)
assert_eq(area(Shape.Origin), 0)

// Extra positional arguments to a variant constructor are dropped, matching
// the interpreter; the arity that counts is the one the variant declares.
assert_eq(Result.Ok(1, 2)._0, 1)

// --- Variants as keys ---
// A variant is Eq and Hashable by construction — its identity is the enum,
// the variant, and each payload field — so it is an Object / Set key and a
// `hash(v)` argument as-is (no `@derive`; an enum rejects the decorator).
mut by_color = {}
by_color[Color.Red] = "warm"
by_color[Color.Blue] = "cool"
assert_eq(by_color[Color.Red], "warm")
by_color[Color.Red] = "hot"
assert_eq(by_color.size(), 2)
assert_eq(by_color[Color.Red], "hot")

// The payload is part of the key: equal payload, same slot.
mut areas = {}
areas[Shape.Circle(1.0)] = 3
areas[Shape.Rect(2.0, 3.0)] = 6
areas[Shape.Circle(2.0)] = 12
assert_eq(areas[Shape.Circle(1.0)], 3)
assert_eq(areas[Shape.Rect(2.0, 3.0)], 6)
assert_eq(areas.size(), 3)

// Set membership dedups the same way.
let seen = {Color.Red, Color.Green, Color.Red}
assert_eq(seen.size(), 2)
assert_eq(seen.contains(Color.Red), true)
assert_eq(seen.contains(Color.Blue), false)

// `hash(v)` agrees with the key path: equal variants, equal hash.
assert_eq(hash(Color.Red), hash(Color.Red))

// The enum is part of the identity: same-named variants of two enums are
// two keys.
enum Left {
  Same,
  L2,
}
enum Right {
  Same,
}
mut homonyms = {}
homonyms[Left.Same] = 1
homonyms[Right.Same] = 2
assert_eq(homonyms.size(), 2)
assert_eq(homonyms[Left.Same], 1)

// An unhashable payload makes the variant unhashable, with the payload's
// own TypeError.
let e_payload = try {
  mut m = {}
  m[Result.Ok([1, 2])] = 1
  nil
} catch e {
  e
}
assert_eq(e_payload.kind, "TypeError")
assert_eq(e_payload.message, "unhashable type: 'Array'")

// Trait conformance follows: `Hashable` / `Eq` at a typed boundary, as a
// bound, and as a multimethod key.
fn key_of(x: Hashable) {
  hash(x)
}
assert_eq(key_of(Color.Red), hash(Color.Red))
fn same<T: Eq>(a: T, b: T) {
  a == b
}
assert_eq(same(Color.Red, Color.Red), true)
assert_eq(same(Color.Red, Color.Green), false)
fn kind(x: Hashable) {
  "hashable"
}
fn kind(x: Array) {
  "array"
}
assert_eq(kind(Color.Red), "hashable")
assert_eq(kind([1]), "array")

// --- Multimethod dispatch on the enum name ---
// The enum-parent match a type pattern already makes (`x: Result` above)
// also keys dispatch: an annotation naming the enum accepts every variant
// of it, ranking below the variant spelled out and above `Any`.
fn arm(r: Ok) {
  "variant"
}
fn arm(r: Result) {
  "enum"
}
fn arm(x) {
  "any"
}
assert_eq(arm(Result.Ok(1)), "variant")
assert_eq(arm(Result.Err(1)), "enum")
assert_eq(arm(Color.Red), "any")

// The enum name outranks a Union that spells its variants out, and both
// outrank the optional form of the same name.
fn rank(r: Result) {
  "enum"
}
fn rank(r: Ok | Err) {
  "union"
}
assert_eq(rank(Result.Ok(1)), "enum")
fn opt(r: Result) {
  "plain"
}
fn opt(r: Result?) {
  "optional"
}
assert_eq(opt(Result.Ok(1)), "plain")
assert_eq(opt(nil), "optional")

// The parent comes off the value, not off the variant name: the two
// `Same` variants above dispatch to their own enum.
fn side(x: Left) {
  "left"
}
fn side(x: Right) {
  "right"
}
assert_eq(side(Left.Same), "left")
assert_eq(side(Right.Same), "right")

// Instance methods key on it the same way.
class Handler {
  new() {}
  on(r: Ok) {
    "m-variant"
  }
  on(r: Result) {
    "m-enum"
  }
}
let h = Handler.new()
assert_eq(h.on(Result.Ok(1)), "m-variant")
assert_eq(h.on(Result.Err(1)), "m-enum")

// A value of another enum still finds no arm.
fn only_result(r: Result) {
  "result"
}
let no_arm = try {
  only_result(Color.Red)
} catch e {
  e
}
assert_eq(no_arm.kind, "DispatchError")

// --- A qualified constructor pattern names its enum ---
// `Left.Same()` takes Left's `Same`, not Right's: the two are two types
// (they compare unequal and key separately, above), so an arm that spells
// the enum out gets what it asked for.
let side_of = fn (v) {
  match v {
    Left.Same() => "left",
    Right.Same() => "right",
    _ => "other",
  }
}
assert_eq(side_of(Left.Same), "left")
assert_eq(side_of(Right.Same), "right")

// The bare form names a variant, not an enum, and still takes either.
let bare_same = fn (v) {
  match v {
    Same() => "same",
    _ => "other",
  }
}
assert_eq(bare_same(Left.Same), "same")
assert_eq(bare_same(Right.Same), "same")

// Payload binding is unchanged under a qualifier.
let unwrap = fn (v) {
  match v {
    Result.Ok(x) => x,
    _ => -1,
  }
}
assert_eq(unwrap(Result.Ok(7)), 7)
assert_eq(unwrap(Result.Err(1)), -1)

// A class instance that happens to share a variant's name carries no
// enum, so the qualified pattern misses it (the bare one still matches
// on the class tag).
class Ok {
  new() {}
}
assert_eq(unwrap(Ok.new()), -1)

// --- The qualified name works in a type position too ---
// `Result.Ok` in an annotation reads the way `Result.Ok(p)` reads as a
// pattern: the variant, and the enum it belongs to.
fn qual(x: Left.Same) {
  "left"
}
assert_eq(qual(Left.Same), "left")
let wrong_enum = try {
  qual(Right.Same)
} catch e {
  e
}
assert_eq(wrong_enum.kind, "DispatchError")

// The new tier sits above the bare variant name (`arm` above pins the
// rest of the ladder): Right's `Same` falls past the qualified arm.
fn grain(x: Left.Same) {
  "qualified"
}
fn grain(x: Same) {
  "variant"
}
assert_eq(grain(Left.Same), "qualified")
assert_eq(grain(Right.Same), "variant")

// Type patterns, unions and the optional form all take it.
let which = fn (v) {
  match v {
    x: Left.Same => "left",
    x: Right.Same => "right",
    _ => "other",
  }
}
assert_eq(which(Left.Same), "left")
assert_eq(which(Right.Same), "right")
assert_eq(which(Left.L2), "other")
fn either(x: Left.Same | Right.Same) {
  "either"
}
assert_eq(either(Left.Same), "either")
assert_eq(either(Right.Same), "either")
fn maybe(x: Left.Same?) {
  "ok"
}
assert_eq(maybe(nil), "ok")
assert_eq(maybe(Left.Same), "ok")

// Annotated assignment and return type report the qualified name.
let assign_err = try {
  let v: Left.Same = Right.Same
  nil
} catch e {
  e
}
assert_eq(assign_err.kind, "TypeError")
assert_eq(assign_err.message, "type error: assignment expects Left.Same")

// Introspection canonicalizes it like any other name.
fn shown(x: Left.Same?) {
  x
}
assert_eq(shown.params[0].type, "Left.Same | Nil")

IO.inspect("test_enum OK")
