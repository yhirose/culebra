# Conformance: §19 (multimethods). See docs/language.md §25.
#
# Multiple dispatch (multimethod). Top-level `fn name(...) body`
# declarations with type-annotated params build a multimethod; the
# call site picks the most specific match based on the dynamic types
# of the arguments. Works on both interp and JIT (and AOT).

# --- Concrete-type dispatch ---

fn area(s: Long) {
  s * s
}
fn area(s: Float) {
  s * s
}
fn area(s: String) {
  s.size()
}

assert_eq(area(5), 25)
assert_eq(area(5.0), 25.0)
assert_eq(area("hello"), 5)

# --- Any (no annotation) catch-all ---

fn area(x) {
  -1
}
assert_eq(area([1, 2, 3]), -1)
assert_eq(area(true), -1)

# --- Specificity: concrete beats Any ---

fn label(x: Long, y) {
  "long-any"
}
fn label(x, y: Long) {
  "any-long"
}
fn label(x: Long, y: Long) {
  "long-long"
}  # most specific
fn label(x, y) {
  "any-any"
}

assert_eq(label(1, 2), "long-long")
assert_eq(label(1, "x"), "long-any")
assert_eq(label("x", 1), "any-long")
assert_eq(label("x", "y"), "any-any")

# --- Class-instance dispatch ---

class Square {
  new(side) {
    self.side = side
  }
}
class Circle {
  new(r) {
    self.r = r
  }
}

fn shape_area(s: Square) {
  s.side * s.side
}
fn shape_area(c: Circle) {
  3.14 * c.r * c.r
}

let s = Square.new(4)
let c = Circle.new(2)
assert_eq(shape_area(s), 16)
assert_eq(shape_area(c), 12.56)

# --- Same-signature redefinition overwrites (REPL-friendly) ---

fn greet(name: String) {
  "hi, {name}"
}
fn greet(name: String) {
  "hello, {name}"
}
assert_eq(greet("alice"), "hello, alice")

# --- Disambiguated dispatch (concrete-on-one-side wins) ---

fn amb(x: Long, y) {
  1
}
fn amb(x, y: Long) {
  2
}

# amb(1, "x") — only (Long, Any) matches.
assert_eq(amb(1, "x"), 1)
# amb("x", 1) — only (Any, Long) matches.
assert_eq(amb("x", 1), 2)
# amb(1, 2) is ambiguous — no test here, raises (verified manually).
# amb("x", "y") raises no-match — no test here.

# --- Coexist with closures: regular `let f = fn(...)` still works ---

let helper = fn (x) {
  x * 2
}
assert_eq(helper(7), 14)

# --- Coexist with class methods + special methods ---
#
# Adding multimethod free functions doesn't disturb instance method
# dispatch via `obj.method()`.

class Box {
  new(v) {
    self.v = v
  }
  squared() {
    self.v * self.v
  }
}
let b = Box.new(5)
assert_eq(b.squared(), 25)

# --- kwargs flow through dispatch (Julia-flavored kwsorter) ---
#
# Multifn dispatch picks on positional types only; kwargs flow into
# the picked method's signature like any other call.

fn greet(name: String, *, prefix: String = 'hi') {
  "{prefix}, {name}"
}
fn greet(n: Long, *, prefix: String = 'num') {
  "{prefix}:{n}"
}

assert_eq(greet('alice'), 'hi, alice')
assert_eq(greet('alice', prefix: 'yo'), 'yo, alice')
assert_eq(greet(42), 'num:42')
assert_eq(greet(42, prefix: 'got'), 'got:42')

# Splat into a multifn
let opts = {prefix: 'splat'}
assert_eq(greet('bob', **opts), 'splat, bob')

# Methods can have their own kw-only defaults
fn paint(shape: String, *, color: String = 'red') {
  "{color} {shape}"
}
fn paint(n: Long, *, color: String = 'blue') {
  "{color} {n}"
}
assert_eq(paint('circle'), 'red circle')
assert_eq(paint(7), 'blue 7')
assert_eq(paint('box', color: 'green'), 'green box')

# **rest inside a multifn method body
fn collect(tag: String, **opts) {
  "{tag}:{opts.a}"
}
assert_eq(collect('hi', a: 99, b: 5), 'hi:99')

# Regular (positional) params with defaults: a multimethod matches arg counts
# in [required, total], filling the tail from defaults. The omitted param may
# also be supplied as a trailing keyword. (Previously these raised
# DispatchError — dispatch matched arity exactly, ignoring defaults.)
fn deff(a, b = 10) {
  a + b
}
assert_eq(deff(1), 11)       # default applied
assert_eq(deff(1, 2), 3)     # positional
assert_eq(deff(1, b: 2), 3)  # trailing keyword
fn deff2(a, b = 2, c = 3) {
  a * 100 + b * 10 + c
}
assert_eq(deff2(1), 123)
assert_eq(deff2(1, 5), 153)
assert_eq(deff2(1, c: 7), 127)  # skip b, set c by keyword

# An exact-arity overload outranks a default-filled one of equal type
# specificity (fewer params filled by default = more specific).
fn ovd(a) {
  'one'
}
fn ovd(a, b = 9) {
  'two'
}
assert_eq(ovd(5), 'one')
assert_eq(ovd(5, 6), 'two')

# Defaults compose with a `*args` tail.
fn vd(a, b = 1, *rest) {
  a + b + rest.size()
}
assert_eq(vd(1), 2)
assert_eq(vd(1, 2), 3)
assert_eq(vd(1, 2, 9, 9), 5)

# A keyword argument may cover a *required* param the positional args didn't
# fill (CLOS-style: keywords contribute to applicability). Order-independent.
fn kwc(a, b = 10) {
  a + b
}
assert_eq(kwc(a: 1, b: 2), 3)  # both required+optional by keyword
assert_eq(kwc(a: 5), 15)       # required by keyword, b defaulted
assert_eq(kwc(b: 7, a: 1), 8)  # keyword order doesn't matter
fn kwc3(a, b = 2, c = 3) {
  a * 100 + b * 10 + c
}
assert_eq(kwc3(a: 1), 123)
assert_eq(kwc3(a: 1, c: 9), 129)

# A required param supplied by NO argument is still unmatched (sound).
let miss = try {
  kwc(b: 5)
  'no error'
} catch e {
  e.kind
}
assert_eq(miss, 'DispatchError')

# Selection still scores on positional args, so type-distinguished overloads
# dispatch as usual; keywords don't change which overload is most specific.
fn kt(a: Long) {
  'long'
}
fn kt(a: String) {
  'str'
}
assert_eq(kt(5), 'long')
assert_eq(kt('x'), 'str')

# A nested `fn name` is scoped to its enclosing scope: a same-named `fn` in a
# sibling scope must NOT see it. (The JIT once funneled every `fn name` into one
# by-name global table, so `scope1`'s `g/1` silently satisfied `scope2`'s `g(99)`
# — a wrong result, not the DispatchError the interp raises.)
fn scope1() {
  fn g(x) {
    x
  }
  g(1)
}
fn scope2() {
  fn g(x, y) {
    x + y
  }
  g(99)
}
assert_eq(scope1(), 1)
let leak = try {
  scope2()
  'no error'
} catch e {
  e.kind
}
assert_eq(leak, 'DispatchError')

# Same-scope overloads still merge into one dispatcher.
fn merged() {
  fn h(x) {
    'one'
  }
  fn h(x, y) {
    'two'
  }
  [h(1), h(1, 2)]
}
assert_eq(merged(), ['one', 'two'])

# A nested helper survives across two activations of its enclosing function
# (the per-scope table is rebuilt on each entry without bleeding state).
fn twice(n) {
  fn k(x) {
    x * 2
  }
  k(n)
}
assert_eq(twice(10), 20)
assert_eq(twice(21), 42)

# Each activation of a declaration gets its own dispatcher and method table,
# so a body keeps the captures of the activation that declared it. A registry
# shared by name would let the later run displace the earlier one's bodies.
fn make_pair(tag) {
  fn m(a) {
    "{tag}-one"
  }
  fn m(a, b) {
    "{tag}-two"
  }
  m
}
let first = make_pair('A')
let second = make_pair('B')
assert_eq([first(1), first(1, 2)], ['A-one', 'A-two'])
assert_eq([second(1), second(1, 2)], ['B-one', 'B-two'])
assert_eq(first == second, false)

# Same rule for a single-arm `fn` re-declared each iteration.
mut kept = []
for i in 0..3 {
  fn per_round(x) {
    "{i}:{x}"
  }
  kept.push(per_round)
}
assert_eq(kept.map(fn (f) { f(9) }), ['0:9', '1:9', '2:9'])

# Re-entering the declaring frame from inside one of the overloads leaves the
# outer activation's table alone.
fn nest(depth) {
  fn r(a) {
    "d{depth}"
  }
  fn r(a, b) {
    if depth > 0 {
      nest(depth - 1)
    } else {
      'bottom'
    }
  }
  let inner = r(1, 2)
  "{r(0)}|{inner}"
}
assert_eq(nest(2), 'd2|d1|d0|bottom')

# The body's own name is the dispatch-delivered self-handle (not a capture
# of the binding cell — that capture would be a refcount ring only the
# tracing backstop could reclaim). Same value as the binding, identity
# stable, visible to nested closures, and usable via UFCS.
fn sh(n) {
  if n == 0 {
    sh
  } else {
    sh(0)
  }
}
assert_eq(sh(1) == sh, true)
fn cap(n) {
  let f = fn () {
    cap
  }
  f() == cap
}
assert_eq(cap(1), true)
fn shadowed(n) {
  let before = type_of(shadowed)
  let shadowed = 99
  "{before}/{shadowed}"
}
assert_eq(shadowed(1), 'Function/99')

# Sibling if-arm declarations share the enclosing scope slot, so each
# executed path gets its own dispatcher — chosen by the runtime state of
# the binding, like the interp's per-activation env frame. (The arm that
# did not run this call must not contribute: this used to read a cell
# that was never created and crash.)
fn arms(c) {
  if c {
    fn ah(a) {
      'then'
    }
    ah(1)
  } else {
    fn ah(a, b) {
      'else'
    }
    ah(1, 2)
  }
}
assert_eq(arms(true), 'then')
assert_eq(arms(false), 'else')
assert_eq(arms(true), 'then')

# Handed to a builtin that calls it as a zero-argument thunk, a dispatcher
# reports the same miss it would report at a bare `mm()` call site.
fn mm(x: Long) {
  x + 1
}
fn mm(x: String) {
  x + '!'
}
mut tally = {}
assert_throws('DispatchError', fn () {
  tally.get_or_put('k', mm)
})

# --- Monomorphic shortcut ---
#
# A dispatcher over exactly one untyped overload invokes it without
# resolution. The cached body must track every table change and never
# change what resolution would have answered.

# A later same-scope overload turns a monomorphic dispatcher polymorphic.
fn grow(x) {
  "any"
}
assert_eq(grow(1), "any")
fn grow(x: Long) {
  "long"
}
assert_eq(grow(1), "long")
assert_eq(grow("s"), "any")

# Same-signature re-declaration swaps the cached body.
fn swap(x) {
  "old"
}
assert_eq(swap(1), "old")
fn swap(x) {
  "new"
}
assert_eq(swap(1), "new")

# Defaults and *args widen the accepted count; outside it the miss is the
# generic DispatchError, not a bad call.
fn wide(a, b = 2, *rest) {
  a + b + rest.size()
}
assert_eq(wide(1), 3)
assert_eq(wide(1, 5), 6)
assert_eq(wide(1, 5, 0, 0), 8)
let under = try {
  wide()
  "no error"
} catch e {
  "{e.kind}: {e.message}"
}
assert_eq(under, "DispatchError: no matching method for `wide`")
fn narrow(a) {
  a
}
let over = try {
  narrow(1, 2)
  "no error"
} catch e {
  "{e.kind}: {e.message}"
}
assert_eq(over, "DispatchError: no matching method for `narrow`")

# Shipped to an isolate, the rebuilt dispatcher answers the same way.
fn twice(x) {
  x * 2
}
let iso = Isolate.spawn(fn (f) {
  f(21)
}, twice)
assert_eq(iso.join(), 42)

inspect("test_multidispatch: OK")
