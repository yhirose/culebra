# A closure captures a variable through its cell. Where FnAnalysis and the
# compiler disagree about which scope holds a name, the compiler would find a
# plain slot instead; it refuses the closure (a VmError where the code
# building it runs) rather than handing the slot over as a cell, which
# crashed the process. Each shape below was such a scope bug, and is now the
# value the program means.

fn cnc_outcome(f) {
  try {
    f()
  } catch e {
    [e.kind, e.message]
  }
}

let cnc_u = 100

# A field initializer's declaration, read by a closure in a later field: the
# declaration ended with its initializer, so the closure reads the outer one.
fn cnc_initializer_carried() {
  class CncCarried {
    f = (let cnc_u = 7) + 1
    g = (|| cnc_u)()
  }
  CncCarried().g
}
assert_eq(cnc_outcome(cnc_initializer_carried), 100)

# The same declaration, read by a closure in its own initializer.
fn cnc_initializer_own() {
  class CncOwn {
    f = (let cnc_u = 7) + (|| cnc_u)()
  }
  CncOwn().f
}
assert_eq(cnc_outcome(cnc_initializer_own), 14)

# An initializer's closure over the enclosing function's variable: a cell
# the field-init function captures in turn.
fn cnc_initializer_outer() {
  let w = 100
  class CncOuter {
    f = (let cnc_w = 7) + (|| w + cnc_w)()
  }
  CncOuter().f
}
assert_eq(cnc_outcome(cnc_initializer_outer), 114)

# A static value's declaration, read by a closure in the same value, inside a
# nested function: the value's own, a local of that function's frame.
fn cnc_static_value() {
  let inner = fn () {
    class CncStatic {
      static s = (let t = 5) + (|| t)()
    }
    CncStatic.s
  }
  inner()
}
assert_eq(cnc_outcome(cnc_static_value), 10)
