# Conformance: C3 @packable + SharedBuffer + zero-copy view.
#
# A @packable class declares a fixed C-ABI byte layout over its typed
# fields. SharedBuffer.new(n, Cls) allocates n zero-initialized records;
# buf[i] is a packed view whose .field reads/writes the backing bytes
# directly (zero copy). interp / JIT / AOT are byte-identical.
#
# Run: ./build/culebra tests/test_packable.cul
#      ./build/culebra --jit tests/test_packable.cul

@packable
class FloatPair {
  x: Float32 = 0.0
  y: Float32 = 0.0
}

let buf = SharedBuffer.new(3, FloatPair)
assert_eq(buf.size, 3)
assert_eq(buf.count, 3)
assert_eq(buf.len, 3)

# Zero-initialized.
assert_eq(buf[0].x, 0.0)
assert_eq(buf[0].y, 0.0)

# Write then read back through a fresh view (zero copy).
buf[0].x = 1.5
buf[0].y = 2.5
assert_eq(buf[0].x, 1.5)
assert_eq(buf[0].y, 2.5)

# Elements are independent.
buf[1].x = 9.0
assert_eq(buf[1].x, 9.0)
assert_eq(buf[0].x, 1.5)

# A stored view aliases the same bytes.
let v = buf[0]
v.x = 42.0
assert_eq(buf[0].x, 42.0)

# Compound assignment.
buf[2].x = 10.0
buf[2].x += 5.0
assert_eq(buf[2].x, 15.0)

# Negative indexing.
buf[-1].y = 7.0
assert_eq(buf[2].y, 7.0)

# Mixed scalar types exercise natural alignment (Bool, Int64, Int32, Byte).
@packable
class Mix {
  flag: Bool = false
  big: Int64 = 0
  small: Int32 = 0
  b: Byte = 0
}

let m = SharedBuffer.new(2, Mix)
assert_eq(m[0].flag, false)
assert_eq(m[0].big, 0)
m[0].flag = true
m[0].big = 1234567890123
m[0].small = -7
m[0].b = 255
assert_eq(m[0].flag, true)
assert_eq(m[0].big, 1234567890123)
assert_eq(m[0].small, -7)
assert_eq(m[0].b, 255)
# Second record untouched.
assert_eq(m[1].big, 0)
assert_eq(m[1].flag, false)

# Explicit drop frees the buffer; using the handle afterward errors (rather
# than crashing or silently leaking) — proof the core was reclaimed.
let tmp = SharedBuffer.new(1, FloatPair)
tmp[0].x = 1.0
tmp.drop()
assert_throws('ValueError', fn () {
  tmp[0].x
})

# --- FixedArray<T,N> fields: fixed-capacity inline collection ---------------
@packable
class Vec {
  n: Int32 = 0
  xs: FixedArray<Float32, 4>
}
let vb = SharedBuffer.new(2, Vec)
let a = vb[0]
assert_eq(a.xs.size(), 0)  # zero-initialized
assert_eq(a.xs.capacity(), 4)
a.xs.push(1.5)
a.xs.push(2.5)
assert_eq(a.xs.size(), 2)
assert_eq(a.xs.get(0), 1.5)
assert_eq(a.xs[1], 2.5)
a.xs[0] = 9.0
assert_eq(a.xs[0], 9.0)
a.xs[1] += 0.5  # compound
assert_eq(a.xs[1], 3.0)
mut fasum = 0.0
for x in a.xs {
  fasum = fasum + x
}
assert_eq(fasum, 12.0)
a.n = 7  # scalar field coexists
assert_eq(a.n, 7)
assert_eq(vb[1].xs.size(), 0)  # second record independent
assert_throws('IndexError', fn () {
  a.xs[5]
})  # out of range
assert_throws('TypeError', fn () {
  vb[0].xs = 1
})  # whole-field assign

@packable
class Two {
  xs: FixedArray<Int32, 2>
}
let tb = SharedBuffer.new(1, Two)
let t = tb[0]
t.xs.push(1)
t.xs.push(2)
assert_throws('IndexError', fn () {
  t.xs.push(3)
})  # capacity full

# --- File-backed storage: SharedBuffer.file (mmap, persists to a file) ------
@packable
class FCell {
  v: Int64 = 0
}
mut tmpdir = Sys.env("TMPDIR")
tmpdir = "/tmp" if tmpdir == ""
let fpath = tmpdir + "/culebra_test_packable_file.bin"
let fb = SharedBuffer.file(fpath, 3, FCell)
fb[0].v = 7
fb[1].v = 8
fb.flush()  # msync to disk (file-only method)
assert_eq(fb[0].v, 7)
let fb2 = SharedBuffer.file(fpath, 3, FCell)  # reopen same path → same bytes
assert_eq(fb2[0].v, 7)
assert_eq(fb2[1].v, 8)
assert_eq(SharedBuffer.new(1, FCell).count, 1)  # heap path still works
FS.remove(fpath)                                # cleanup

# --- with_lock: the synchronization escape hatch ---------------------------
@packable
class Counter {
  n: Int64 = 0
}
# Runs the callback holding the lock and returns its value; mutations stick.
let lb = SharedBuffer.new(1, Counter)
assert_eq(lb.with_lock(fn () {
    lb[0].n = lb[0].n + 41
    99
  }), 99)
assert_eq(lb[0].n, 41)
assert_eq(lb.with_lock(fn () {
    "released"
  }), "released")  # lock freed each call
# Contended read-modify-write across isolates: the lock makes it exact (a
# lost-update race would undercount 8 * 1000).
let shared_counter = SharedBuffer.new(1, Counter)
Parallel.each(iota(0, 8), fn (w) {
  mut k = 0
  while k < 1000 {
    shared_counter.with_lock(fn () {
      shared_counter[0].n = shared_counter[0].n + 1
    })
    k = k + 1
  }
})
assert_eq(shared_counter[0].n, 8000)
# A non-function argument is a TypeError; using a dropped buffer is a ValueError.
assert_throws('TypeError', fn () {
  lb.with_lock(3)
})
lb.drop()
assert_throws('ValueError', fn () {
  lb.with_lock(fn () {
    1
  })
})

inspect("packable ok")
