# A range is recognized by identity, not by the shape it wears: `a..b` and
# `Range(...)` share one meta per Runtime, and nothing else is a range. An
# object carrying class:"Range" and every field a range has used to be
# indistinguishable from a real one — it sliced, it displayed in source form,
# it satisfied `grid`'s `Range` parameter — because the gates re-derived the
# answer from the slots. They no longer can.

let a = [1, 2, 3]

# The constructor builds what the literal builds.
assert_eq(a[Range(1, 3)], [2, 3])
assert_eq(Range(1, 3), 1..3)
assert_eq(Range(1, 3, true), 1..=3)
assert_eq("{Range(1, 9, false, 2)}", "1..9 by 2")
# What the literal cannot spell at runtime: which end is open.
assert_eq("{Range(2, nil)}", "2..")
assert_eq("{Range(nil, 4)}", "..4")

# A hand-built object is a plain Object however complete it looks: an Array
# subscript takes the point-key path and rejects the Object key.
let complete = {"class": "Range", "start": 1, "end": 3, "inclusive": false}
let stepped = {"class": "Range", "start": 1, "end": 3, "inclusive": false, "step": 1}
let partial = {"class": "Range"}
for fake in [complete, stepped, partial] {
  mut caught = ""
  try {
    a[fake]
  } catch e {
    caught = e.kind
  }
  assert_eq(caught, "TypeError")
}

# Display: a real range prints in source form, a hand-built one generically.
assert_eq("{1..3}", "1..3")
assert_eq("{partial}", 'Range {}')
assert_eq("{complete}", 'Range {start: 1, end: 3, inclusive: false}')

# Iteration: a hand-built one walks its (key, value) pairs like any Object.
mut pairs = []
for kv in partial {
  pairs.push(kv)
}
assert_eq(pairs, [("class", "Range")])

# grid() takes a real range and rejects a hand-built one, complete or not.
assert_eq(grid(Range(0, 2), Range(0, 2)).collect().size(), 4)
for fake in [complete, partial] {
  mut caught = ""
  try {
    grid(fake, fake)
  } catch e {
    caught = e.message
  }
  assert_eq(caught, "type error: parameter 'x_range' expects Range")
}

# Zero step is refused the way the literal's is.
mut caught = ""
try {
  Range(1, 5, false, 0)
} catch e {
  caught = e.kind
}
assert_eq(caught, "ValueError")

println('range shape OK')
