# A class's name answers for the class at compile time (which constructor
# `Name.new(...)` reaches, a flat `@value` class laid out in slots) only
# where the class is the one declaration of that name in its scope. A
# `fn Name` or a `let Name` beside it declares the same variable, and a read
# then finds whatever was written to it last, as with any other variable.

class CnrOther {
  new(a, b) {
    self.x = 'other'
  }
}

fn cnr_kind(f) {
  try {
    f()
  } catch e {
    e.kind
  }
}

# --- 1) the name is declared again after the class: a function made before
#        reads the new value. A plain class and a flat `@value` one agree.
fn cnr_plain_then_let() {
  class CnrPlain {
    new(.x, .y) {}
  }
  let make = || CnrPlain.new(1.0, 2.0).x
  let before = make()
  let CnrPlain = CnrOther
  [before, make()]
}
assert_eq(cnr_plain_then_let(), [1.0, 'other'])

fn cnr_flat_then_let() {
  @value
  class CnrFlat {
    new(.x: Float, .y: Float) {}
  }
  let make = || CnrFlat.new(1.0, 2.0).x
  let before = make()
  let CnrFlat = CnrOther
  [before, make()]
}
assert_eq(cnr_flat_then_let(), [1.0, 'other'])

# --- 2) declared again as a function: `.new` on it is the TypeError it is
#        on any function
fn cnr_plain_then_fn() {
  class CnrCalled {
    new(.x, .y) {}
  }
  let make = || CnrCalled.new(1.0, 2.0).x
  let before = make()
  fn CnrCalled(a, b) {
    'the function'
  }
  [before, cnr_kind(make)]
}
assert_eq(cnr_plain_then_fn(), [1.0, 'TypeError'])

fn cnr_flat_then_fn() {
  @value
  class CnrFlatCalled {
    new(.x: Float, .y: Float) {}
  }
  let make = || CnrFlatCalled.new(1.0, 2.0).x
  let before = make()
  fn CnrFlatCalled(a, b) {
    'the function'
  }
  [before, cnr_kind(make)]
}
assert_eq(cnr_flat_then_fn(), [1.0, 'TypeError'])

# --- 3) declared before the class: while the class's static values run the
#        name still holds the function, and afterwards the class
fn cnr_fn_then_flat() {
  fn CnrEarly(a, b) {
    'the function'
  }
  let called = CnrEarly(1, 2)
  @value
  class CnrEarly {
    new(.x: Float, .y: Float) {}
    static early = cnr_kind(|| CnrEarly.new(1.0, 2.0).x)
  }
  [called, CnrEarly.early, CnrEarly.new(1.0, 2.0).x]
}
assert_eq(cnr_fn_then_flat(), ['the function', 'TypeError', 1.0])

# --- 4) a function kept in a static, and the name declared again later
fn cnr_static_then_let() {
  @value
  class CnrKept {
    new(.x: Float, .y: Float) {}
    static make = || CnrKept.new(1.0, 2.0).x
  }
  let make = CnrKept.make
  let before = make()
  let CnrKept = CnrOther
  [before, make()]
}
assert_eq(cnr_static_then_let(), [1.0, 'other'])
