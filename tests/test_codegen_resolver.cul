# CodeGen.Resolver / CodeGen.FrameLayout -- the closure conversion a front
# end would otherwise write itself. The program built here is the smallest
# one that needs every piece:
#
#   let x = 1
#   fn outer() { fn inner() { x } }
#
# `inner` reads a variable `main` owns, two levels out, so `x` has to become
# a cell in main, a capture in outer, and a capture in inner -- and outer has
# to carry it even though outer never names it.

# --- the propagation: a read two levels in is free in between ---------------

let rs = CodeGen.Resolver.new()
let main = rs.new_fn()
rs.push_scope()
let x = rs.declare('x', main)
let outer = rs.new_fn(main)
let inner = rs.new_fn(outer)
rs.use(x, inner)

assert_eq(rs.num_fns(), 3)
assert_eq(rs.parent_of(outer), main)
assert_eq(rs.parent_of(main), -1)
assert_eq(rs.num_vars(), 1)
assert_eq(rs.var_name(x), 'x')
assert_eq(rs.var_owner(x), main)

# free in inner *and* in outer, not in main (which owns it)
assert_eq(rs.free_count(inner), 1)
assert_eq(rs.free_at(inner, 0), x)
assert_eq(rs.free_count(outer), 1)
assert_eq(rs.free_count(main), 0)

# --- scopes -----------------------------------------------------------------

assert_eq(rs.depth(), 1)
assert_eq(rs.declared_here('x'), x)
assert_eq(rs.declared_here('nope'), -1)
assert_eq(rs.lookup('x'), x)
assert_eq(rs.lookup('nope'), -1)

rs.push_scope()
assert_eq(rs.depth(), 2)
let y = rs.declare('y', main)
let y2 = rs.declare('y', main)        # shadowing within one block: two bindings
assert_eq(rs.declared_here('y'), y2)  # the map holds the second
assert_eq(rs.declared_count(1), 2)    # the order holds both
assert_eq(rs.declared_index(1, 0), y)
assert_eq(rs.declared_index(1, 1), y2)
# an alias names something already declared, so it joins no order table
rs.alias('z', y)
assert_eq(rs.declared_here('z'), y)
assert_eq(rs.declared_count(1), 2)
# the outer scope is still reachable by index and by search
assert_eq(rs.declared_at(0, 'x'), x)
assert_eq(rs.declared_at(1, 'x'), -1)
assert_eq(rs.lookup_from('y', 0), -1)
rs.pop_scope()
assert_eq(rs.depth(), 1)
# a scope that closes takes its order with it
rs.push_scope()
assert_eq(rs.declared_count(1), 0)
rs.pop_scope()

# --- numbering: local, cell, capture ----------------------------------------

let m = CodeGen.Module.new()
rs.set_func_index(main, 0)
rs.set_func_index(outer, 1)
rs.set_func_index(inner, 2)
rs.set_var_slot(x, 0)
rs.number_captures()

# main owns x and something nested captures it, so it is a cell there
assert_eq(rs.access_kind(main, x), 'cell')
assert_eq(rs.access_index(main, x), 0)
assert_eq(rs.num_cells(main), 1)
assert_eq(rs.cell_of(main, x), 0)
# outer and inner reach it through their own capture lists
assert_eq(rs.access_kind(outer, x), 'capture')
assert_eq(rs.access_index(outer, x), 0)
assert_eq(rs.access_kind(inner, x), 'capture')
assert_eq(rs.num_captures(outer), 1)
assert_eq(rs.num_captures(inner), 1)
assert_eq(rs.num_cells(outer), 0)
assert_eq(rs.cell_of(outer, x), -1)

# a plain local: owned, captured by nobody
rs.set_var_slot(y, 1)
assert_eq(rs.access_kind(main, y), 'local')
assert_eq(rs.access_index(main, y), 1)

# --- capture maps -----------------------------------------------------------

# outer is where inner is written, so it can supply what inner captures
let cmap = rs.capture_map(m, outer, inner)
assert_eq(m.num_capture_entries(cmap), 1)
assert_eq(m.capture_kind(cmap, 0), 'capture')
assert_eq(m.capture_index(cmap, 0), 0)

# main can name x too -- it owns it, as a cell
assert_true(rs.reaches(outer, x))
assert_true(rs.reaches(main, x))
let from_main = rs.capture_map(m, main, outer)
assert_eq(m.capture_kind(from_main, 0), 'cell')

# `other` is a sibling of outer that never read x, so it can supply nothing:
# a closure of inner built in its frame would forward a capture index that
# was never assigned. capture_map says so instead of writing one.
let other = rs.new_fn(main)
rs.set_func_index(other, 3)
assert_false(rs.reaches(other, x))
assert_throws('IrError', fn () {
  rs.capture_map(m, other, inner)
})

# --- FrameLayout: slots handed out, and given back at a block's end ---------

let fl = CodeGen.FrameLayout.new()
assert_eq(fl.alloc_local('a'), 0)
assert_eq(fl.alloc_local('b'), 1)
let mark = fl.mark()
assert_eq(mark, 2)
assert_eq(fl.alloc_local('inner1'), 2)
assert_eq(fl.alloc_local('inner2'), 3)
# the block ends: its slots go back, and the end of the range is the answer
assert_eq(fl.release(mark), 4)
# a sibling block reuses them
assert_eq(fl.alloc_local('sibling'), 2)
# num_locals is the high-water mark, which is what Func::num_locals wants
assert_eq(fl.num_locals(), 4)
assert_eq(fl.local_name(0), 'a')
assert_eq(fl.local_name(2), 'sibling')
assert_eq(fl.local_name(3), 'inner2')

# --- the errors a front end actually hits -----------------------------------

assert_throws('IndexError', fn () {
  rs.var_name(999)
})
assert_throws('IndexError', fn () {
  rs.parent_of(999)
})
assert_throws('IndexError', fn () {
  rs.declared_at(99, 'x')
})
assert_throws('IndexError', fn () {
  rs.declared_index(0, 99)
})
assert_throws('IndexError', fn () {
  rs.free_at(main, 0)
})
assert_throws('IrError', fn () {
  fl.release(99)
})

# --- a prelude bound once, programs built on top of it ----------------------
#
# What a front end writing part of its runtime in its own language does: bind
# that once, then give back each program's additions instead of binding it
# again.

let pr = CodeGen.Resolver.new()
let entry = pr.new_fn()
pr.set_func_index(entry, 0)
pr.push_scope()
let gvar = pr.declare('$global', entry)
let helper = pr.new_fn(entry)
pr.set_func_index(helper, 1)
pr.use(gvar, helper)
let after_prelude = pr.mark()

# a program on top: one more function, one more variable
let pfn = pr.new_fn(entry)
pr.set_func_index(pfn, 2)
let px = pr.declare('x', entry)
pr.use(px, pfn)
pr.number_captures()
assert_eq(pr.num_cells(entry), 2)

pr.rollback(after_prelude)
assert_eq(pr.num_fns(), 2)
assert_eq(pr.num_vars(), 1)
# the prelude's own analysis survived
assert_eq(pr.free_count(helper), 1)
assert_eq(pr.free_at(helper, 0), gvar)

# the entry function is rebuilt per program, so it starts over
pr.reset_fn(entry)
pr.number_captures()
assert_eq(pr.num_cells(entry), 1)
assert_eq(pr.cell_of(entry, gvar), 0)

assert_throws('IndexError', fn () {
  pr.rollback(99)
})

# --- read/write and the call-edge closure -----------------------------------

let em = CodeGen.Module.new()
let er = CodeGen.Resolver.new()
let top = er.new_fn()
er.set_func_index(top, 0)
er.push_scope()
let ev = er.declare('n', top)
er.set_var_slot(ev, 0)
let nested = er.new_fn(top)
er.set_func_index(nested, 1)
er.use(ev, nested)
er.number_captures()

# read/write build the node access_kind/access_index describe
let at = {line: 4, column: 2}
let got = er.read(em, nested, ev, at)
assert_eq(em.var_kind(got), er.access_kind(nested, ev))
assert_eq(em.var_index(got), er.access_index(nested, ev))
assert_eq(em.node_line(got), 4)
let put = er.write(em, top, ev, em.literal(1, at), at)
assert_eq(em.var_kind(put), 'cell')

# a frame that cannot name it is refused, not silently mis-numbered
let sibling = er.new_fn(top)
assert_throws('IrError', fn () {
  er.read(em, sibling, ev, at)
})

# call edges: the caller takes the callee's free set, and only when asked
let cr = CodeGen.Resolver.new()
let cmain = cr.new_fn()
cr.push_scope()
let cx = cr.declare('x', cmain)
let couter = cr.new_fn(-1)  # PL/0 shape: closures built at the reference
let cinner = cr.new_fn(-1)
cr.use(cx, cinner)
cr.note_call(couter, cinner)
cr.note_call(cinner, cinner)  # self-recursion, the case one pass misses
assert_eq(cr.free_count(couter), 0)
cr.close_over_calls()
assert_eq(cr.free_count(couter), 1)
assert_eq(cr.free_at(couter, 0), cx)
assert_eq(cr.free_count(cmain), 0)  # the owner does not capture its own
