// `@derive(Eq, Hash, Show, Comparable)` — compiler-recognized directive
// that injects reflective methods over a class's data fields. The four
// derivable names map to: Eq -> eq(other), Hash -> hash(), Show ->
// to_s(), Comparable -> cmp(other). The trait defaults (neq, lt/le/gt/ge)
// fall out of structural conformance once eq / cmp exist.

@derive(Eq, Hash, Show, Comparable)
class Point {
  new(x, y) {
    self.x = x
    self.y = y
  }
}

let a = Point.new(1, 2)
let b = Point.new(1, 2)
let c = Point.new(1, 3)

// --- Eq: field-by-field over data fields ---
assert_eq(a.eq(b), true)
assert_eq(a.eq(c), false)
// neq comes from the Eq trait default (!self.eq(other)).
assert_eq(a.neq(c), true)
assert_eq(a.neq(b), false)
// A non-Point compares unequal (nominal: class tag must match).
assert_eq(a.eq(42), false)

// --- Hash: equal instances hash equally ---
assert_eq(a.hash(), b.hash())
assert_eq(hash(a), hash(b))

// --- Show: ClassName(field reprs) ---
assert_eq(a.to_s(), "Point(1, 2)")

// --- Comparable: lexicographic over fields in declaration order ---
assert_eq(a.cmp(b), 0)
assert_eq(a.cmp(c), -1)
assert_eq(c.cmp(a), 1)
// lt/le/gt/ge come from the Comparable trait default (derived from cmp).
assert_eq(a.lt(c), true)
assert_eq(c.gt(a), true)
assert_eq(a.le(b), true)
assert_eq(a.ge(b), true)

// --- Derived Eq + Hash make the class usable as Object / Set key ---
mut bag = {}
mut bag[Point.new(1, 2)] = "a"
assert_eq(bag[Point.new(1, 2)], "a")

mut s = {Point.new(1, 1), Point.new(2, 2)}
s.add(Point.new(1, 1))  // duplicate -> no growth
assert_eq(s.size(), 2)

// --- String fields are quoted in to_s (value repr) ---
@derive(Show)
class Named {
  new(n) {
    self.n = n
  }
}
assert_eq(Named.new("bob").to_s(), "Named('bob')")

// --- User definitions win over derived ones ---
@derive(Show)
class Custom {
  new(v) {
    self.v = v
  }
  to_s() {
    "custom!"
  }
}
assert_eq(Custom.new(1).to_s(), "custom!")

// --- Partial derive: only requested traits get methods ---
@derive(Eq)
class OnlyEq {
  new(v) {
    self.v = v
  }
}
let oe = OnlyEq.new(5)
assert_eq(oe.eq(OnlyEq.new(5)), true)
// hash() was NOT derived -> absent.
let probe = try {
  oe.hash()
  "present"
} catch e {
  "absent"
}
assert_eq(probe, "absent")

// --- eq / cmp declare a required parameter ---
// The generated pair takes `other`, so calling either with nothing is the
// ordinary missing-required ArityError, not a default-shaped answer.
@derive(Eq, Hash, Show, Comparable)
class Bare {
  new(v) {
    self.v = v
  }
}
let bare = Bare.new(1)
let eq_arity = try {
  bare.eq()
  "no-error"
} catch e {
  e.kind
}
assert_eq(eq_arity, "ArityError")
let cmp_arity = try {
  bare.cmp()
  "no-error"
} catch e {
  e.kind
}
assert_eq(cmp_arity, "ArityError")
// hash() / to_s() take none, so they stay callable.
assert_eq(bare.to_s(), "Bare(1)")

// --- cmp orders the field types `<` orders, and refuses the rest ---
// Derived cmp reaches the same ordering the `<` operator does, so a field
// the language will not order is a TypeError instead of an invented answer.
@derive(Comparable)
class Holder {
  new(v) {
    self.v = v
  }
}
assert_eq(Holder.new(1).cmp(Holder.new(2)), -1)
assert_eq(Holder.new("b").cmp(Holder.new("a")), 1)
assert_eq(Holder.new(1.5).cmp(Holder.new(1.5)), 0)
let cmp_array = try {
  Holder.new([1]).cmp(Holder.new([2]))
  "no-error"
} catch e {
  e.kind + ": " + e.message
}
assert_eq(cmp_array, "TypeError: type error: cannot compare Array and Array")
let cmp_mixed = try {
  Holder.new(1).cmp(Holder.new("a"))
  "no-error"
} catch e {
  e.kind + ": " + e.message
}
assert_eq(cmp_mixed, "TypeError: type error: cannot compare Long and String")
// Equal fields never reach the ordering, so a same-valued Array pair is fine.
assert_eq(Holder.new([1]).cmp(Holder.new([1])), 0)

IO.inspect("test_derive OK")
