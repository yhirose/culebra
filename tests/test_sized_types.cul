// Which types have a length: the receivers `size()` / `empty()` / `presence()`
// accept, and the error every other receiver gets.
//
// The two backends state this set in different places — the JIT in one tag
// switch (jit.h::emit_size_probe), the interpreter across five builtins
// tables (object / array / string / set / tuple). Nothing in the code makes
// them agree, so this file pins the set from both sides: adding a type to one
// backend and not the other fails here, and so does dropping one.

// --- the six tags that carry a length ---------------------------------
assert_eq("ab".size(), 2)               // String
assert_eq("abc".slice(0, 2).size(), 2)  // StringView
assert_eq([1, 2].size(), 2)             // Array
assert_eq((1, 2).size(), 2)             // Tuple
assert_eq({a: 1}.size(), 1)             // Object
assert_eq(Set(1, 2).size(), 2)             // Set

// `empty()` is `size() == 0`; `presence()` is self-or-nil on the same probe.
assert_eq("".empty(), true)
assert_eq("ab".slice(0, 0).empty(), true)
assert_eq([].empty(), true)
assert_eq({}.empty(), true)
assert_eq((1, 2).empty(), false)   // a Tuple has no zero-arity literal
let drained = Set(1, 2).diff(Set(1, 2))  // as Set(); `{}` is an Object
assert_eq(drained.empty(), true)

// `presence()` on each of the six is `tests/test_presence.cul`'s subject —
// not restated here. What it does not cover is the receivers that answer
// nothing at all, which is the rejection block below.

// A class instance rides the Object arm and reports its property count. (An
// iterator and a Range are Objects too, but they are not sized: see below.)
class Box {
  new() {
    self.x = 1
  }
}
assert_eq(Box.new().size(), 1)  // just `x`: the class name is not a field
// A `next` that is not a function is data, not the iterator protocol.
assert_eq({value: 1, next: {value: 2}}.size(), 2)

// --- every other receiver is rejected, identically on both backends -----
// A scalar has no member table at all, so it raises the shared
// receiver-resolution error naming what could have answered.
fn rejects(v, kind, message_for) {
  let calls = [
    ['size', || v.size()],
    ['empty', || v.empty()],
    ['presence', || v.presence()],
  ]
  for call in calls {
    let f = call[1]
    let e = try {
      f()
      nil
    } catch err {
      err
    }
    assert_eq(e.kind, kind)
    assert_eq(e.message, message_for(call[0]))
  }
}

for scalar in [nil, true, 1, 1.5] {
  rejects(
    scalar,
    "TypeError",
    |_| "type error: expected Object, Array, or Tensor, got {type_of(scalar)}",
  )
}

// Functions and Tensors do have member access, so `.size` reads as a missing
// property (`nil`) and the call is what fails, naming it. Note the scalar message above
// names Tensor as a receiver that could have answered, but a Tensor does not
// carry a length either — it reports its extent through `.shape`.
fn sized_miss(type) {
  |name| "type error: expected Function, got Nil ('{name}' is not a method of {type})"
}
rejects(|x| x, "TypeError", sized_miss('Function'))
rejects(Tensor.zeros([2]), "TypeError", sized_miss('Tensor'))

// --- a sequence is not a container --------------------------------------
// An iterator and a Range are Objects, but their properties are protocol
// slots (`iter`, `has_next`, `next`; a Range's `start`, `end`, ...). Counting
// them answered 3 or 4 whatever the length, and `empty()` was always false.
// They lack the three names as they lack any other method.
fn two() {
  yield 1
  yield 2
}
class Counter {
  new() {}
  iter() {
    self
  }
  has_next() {
    false
  }
  next() {
    nil
  }
}
// Only `next`, no `has_next`: the protocol's shape is a function-valued `next`.
class Lexer {
  new() {}
  next() {
    1
  }
}
let half_open = 0..5
let closed = 0..=5
let by_hand = {iter: || 1, has_next: || false, next: || 1}
rejects(range(5), "TypeError", sized_miss('Object'))
rejects([1, 2, 3, 4].iter(), "TypeError", sized_miss('Object'))
rejects(range(5).map(|x| x * 2), "TypeError", sized_miss('Object'))
rejects(two(), "TypeError", sized_miss('Generator'))
rejects(Counter(), "TypeError", sized_miss('Counter'))
rejects(Lexer(), "TypeError", sized_miss('Lexer'))
rejects(by_hand, "TypeError", sized_miss('Object'))
rejects(half_open, "TypeError", sized_miss('Range'))
rejects(closed, "TypeError", sized_miss('Range'))

// The length of a sequence is a walk away: `count()` consumes it,
// `collect().size()` keeps the elements.
assert_eq(range(5).count(), 5)
assert_eq(range(5).collect().size(), 5)
assert_eq(two().collect().empty(), false)

// An own `size` still answers first, whatever the shape.
class Sized {
  new() {}
  next() {
    nil
  }
  size() {
    42
  }
}
assert_eq(Sized().size(), 42)

IO.inspect("test_sized_types OK")
