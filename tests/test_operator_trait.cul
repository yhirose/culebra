// Operator overload falls back to trait methods: `==`/`!=` route through
// `eq(other)` (Eq / @derive(Eq) / Hashable) and `<`/`<=`/`>`/`>=` route
// through `cmp(other)` (Comparable / @derive(Comparable)) when the class
// does not define the explicit `__eq__` / `__lt__` operator dunders.
// Precedence: explicit dunder > trait method > default (structural eq /
// TypeError for ordering).

// --- @derive(Eq) makes `==` / `!=` work (was structural-only before) ---
@derive(Eq, Hash, Comparable)
class Point {
  new(x, y) { this.x = x; this.y = y }
}

let a = Point.new(1, 2)
let b = Point.new(1, 2)
let c = Point.new(1, 3)

assert_eq(a == b, true)
assert_eq(a == c, false)
assert_eq(a != c, true)
assert_eq(a != b, false)

// --- @derive(Comparable) makes `<` `<=` `>` `>=` work via cmp ---
assert_eq(a < c, true)
assert_eq(c < a, false)
assert_eq(a <= b, true)
assert_eq(a >= b, true)
assert_eq(c > a, true)
assert_eq(a > c, false)

// --- `==` operator and key-equality now agree (no divergence) ---
mut bag = {}
mut bag[a] = "hit"
assert_eq(bag[b], "hit")   // key lookup uses eq
assert_eq(a == b, true)    // operator now uses eq too

// --- Hand-written eq: `==` routes through it ---
class Mod3 {
  new(n) { this.n = n }
  eq(other) { this.n % 3 == other.n % 3 }
}
assert_eq(Mod3.new(1) == Mod3.new(4), true)   // 1%3 == 4%3
assert_eq(Mod3.new(1) == Mod3.new(2), false)
assert_eq(Mod3.new(1) != Mod3.new(2), true)

// --- Hand-written cmp: ordering routes through it ---
class Rev {
  new(n) { this.n = n }
  cmp(other) { other.n - this.n }   // reversed order
}
assert_eq(Rev.new(1) < Rev.new(2), false)   // reversed: 1 > 2 under cmp
assert_eq(Rev.new(2) < Rev.new(1), true)
assert_eq(Rev.new(1) >= Rev.new(2), true)

// --- Explicit __eq__ / __lt__ win over the trait methods ---
class Tagged {
  new(n) { this.n = n }
  eq(other) { false }              // trait method says never-equal
  __eq__(other) { this.n == other.n }   // dunder wins
  cmp(other) { 0 }                 // trait method says always-equal
  __lt__(other) { this.n < other.n }    // dunder wins
}
assert_eq(Tagged.new(5) == Tagged.new(5), true)   // __eq__ used, not eq
assert_eq(Tagged.new(1) < Tagged.new(2), true)    // __lt__ used, not cmp

puts("test_operator_trait ok")
