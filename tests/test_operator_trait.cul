// Operator overload falls back to trait methods: `==`/`!=` route through
// `eq(other)` (Eq / @derive(Eq) / Hashable) and `<`/`<=`/`>`/`>=` route
// through `cmp(other)` (Comparable / @derive(Comparable)) when the class
// does not define the explicit `__eq__` / `__lt__` operator dunders.
// Precedence: explicit dunder > trait method > default (structural eq /
// TypeError for ordering).

// --- `==` / `!=` on a derived class: by structure (a derived eq states no
// equality of its own; test_derive.cul pins where the two relations part) ---
@derive(Eq, Hash, Comparable)
class Point {
  new(x, y) {
    self.x = x
    self.y = y
  }
}

let a = Point.new(1, 2)
let b = Point.new(1, 2)
let c = Point.new(1, 3)

assert_eq(a == b, true)
assert_eq(a == c, false)
assert_eq(a != c, true)
assert_eq(a != b, false)

// --- @derive(Comparable) makes `<` `<=` `>` `>=` work via cmp ---
assert_eq(a < c, true)
assert_eq(c < a, false)
assert_eq(a <= b, true)
assert_eq(a >= b, true)
assert_eq(c > a, true)
assert_eq(a > c, false)

// --- ...and as a key, by its fields: equal Long fields, one key ---
mut bag = {}
mut bag[a] = "hit"
assert_eq(bag[b], "hit")  // key lookup matches the fields

// --- Hand-written eq: `==` routes through it ---
class Mod3 {
  new(n) {
    self.n = n
  }
  eq(other) {
    self.n % 3 == other.n % 3
  }
}
assert_eq(Mod3.new(1) == Mod3.new(4), true)  // 1%3 == 4%3
assert_eq(Mod3.new(1) == Mod3.new(2), false)
assert_eq(Mod3.new(1) != Mod3.new(2), true)

// --- Hand-written cmp: ordering routes through it ---
class Rev {
  new(n) {
    self.n = n
  }
  cmp(other) {
    other.n - self.n
  }  // reversed order
}
assert_eq(Rev.new(1) < Rev.new(2), false)  // reversed: 1 > 2 under cmp
assert_eq(Rev.new(2) < Rev.new(1), true)
assert_eq(Rev.new(1) >= Rev.new(2), true)

// --- Explicit __eq__ / __lt__ win over the trait methods ---
class Tagged {
  new(n) {
    self.n = n
  }
  eq(other) {
    false
  }  // trait method says never-equal
  __eq__(other) {
    self.n == other.n
  }  // dunder wins
  cmp(other) {
    0
  }  // trait method says always-equal
  __lt__(other) {
    self.n < other.n
  }  // dunder wins
}
assert_eq(Tagged.new(5) == Tagged.new(5), true)  // __eq__ used, not eq
assert_eq(Tagged.new(1) < Tagged.new(2), true)   // __lt__ used, not cmp

// `<=` is `__le__`, or else `a < b or a == b` with `==` whole; `__eq__` alone
// orders nothing, so `<=` falls to `cmp` as `<` does.
class EqAndCmp {
  new(v) {
    self.v = v
  }
  __eq__(o) {
    self.v == o.v
  }
  cmp(o) {
    self.v - o.v
  }
}
let lo = EqAndCmp.new(1)
let hi = EqAndCmp.new(2)
assert_eq(lo < hi, true)
assert_eq(lo <= hi, true)
assert_eq(lo > hi, false)
assert_eq(lo >= hi, false)
assert_eq(hi > lo, true)
assert_eq(lo <= lo, true)
assert_eq(lo > lo, false)

// ...and with `__lt__` but no `__eq__`, the equal half is `==`'s own answer,
// structure here, not a missing dunder read as "unequal".
class LtOnly {
  new(v) {
    self.v = v
  }
  __lt__(o) {
    self.v < o.v
  }
}
let same_a = LtOnly.new(1)
let same_b = LtOnly.new(1)
assert_eq(same_a == same_b, true)
assert_eq(same_a <= same_b, true)
assert_eq(same_a > same_b, false)
assert_eq(same_a >= same_b, true)
assert_eq(LtOnly.new(1) <= LtOnly.new(2), true)
assert_eq(LtOnly.new(2) <= LtOnly.new(1), false)

// ...a stated `eq` counts as `==` does.
class LtAndEq {
  new(id, label) {
    self.id = id
    self.label = label
  }
  __lt__(o) {
    self.id < o.id
  }
  eq(o) {
    self.id == o.id
  }
  hash() {
    self.id
  }
}
assert_eq(LtAndEq.new(1, 'a') == LtAndEq.new(1, 'b'), true)
assert_eq(LtAndEq.new(1, 'a') <= LtAndEq.new(1, 'b'), true)
assert_eq(LtAndEq.new(1, 'a') > LtAndEq.new(1, 'b'), false)

inspect("test_operator_trait ok")
