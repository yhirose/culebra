// dict.get(key, fallback): read-only lookup with a default.
d = {"a": 1}
assert_eq(d.get("a", 0), 1)
assert_eq(d.get("z", 0), 0)
assert_eq(d.has("z"), false)  // get never inserts

// get_or_put: a hit returns the existing value; a miss inserts and returns it.
assert_eq(d.get_or_put("a", 9), 1)  // existing kept, not overwritten
assert_eq(d.get_or_put("z", 9), 9)  // inserted on miss
assert_eq(d.get("z", 0), 9)

// Lazy init: the thunk runs only on a miss.
mut calls = 0
fn mk() {
  calls = calls + 1
  []
}
d.get_or_put("a", || mk())    // hit -> thunk not called
d.get_or_put("new", || mk())  // miss -> thunk called once
assert_eq(calls, 1)

// Accumulator: the returned value shares storage with the stored one, so
// push grows the dict's array. Keys here are StringViews (`w[0..1]`).
groups = {}
for w in ["apple", "avocado", "banana"] {
  groups.get_or_put(w[0..1], || []).push(w)
}
assert_eq(groups["a"], ["apple", "avocado"])
assert_eq(groups["b"], ["banana"])

// A non-function init is used as-is (eager value), inserted on a miss.
counts = {}
assert_eq(counts.get_or_put("x", 0), 0)
assert_eq(counts.get_or_put("x", 0), 0)  // now a hit

// String and StringView are the same key across every dict op.
e = {}
k = "hello"[0..2]      // StringView "he"
e[k] = 1               // subscript-set with a StringView key
assert_eq(e["he"], 1)  // String-literal read finds it
assert_eq(e.has("he"), true)
assert_eq(e.get("he", 0), 1)
e.remove("hello"[0..2])  // remove via a StringView key
assert_eq(e.has("he"), false)

// The key stays the value the program wrote wherever it goes on as one: a
// class's `__index__` / `__setindex__` reads it and may keep it...
class Keyed {
  new() {
    self.seen = []
  }
  __index__(k) {
    self.seen.push(k)
    k + "!"
  }
  __setindex__(k, v) {
    self.seen.push(k + "=" + to_string(v))
  }
}
keyed = Keyed()
assert_eq(keyed["hello"[0..2]], "he!")
keyed["hello"[2..5]] = 7
keyed["hello"[0..1]] ??= 8
assert_eq(keyed.seen, ["he", "llo=7", "h"])
assert_eq(type_of(keyed.seen[0]), "StringView")
// ...the insertion order drops it by its name...
mixed = {}
mixed["he"] = 1
mixed[1] = 2
mixed.remove("hello"[0..2])
assert_eq(mixed.keys(), [1])
mixed["he"] = 3
assert_eq(mixed.keys(), [1, "he"])
// ...and a Shared view and a Regex match look it up as they do a String.
assert_eq(Shared.new({he: 1})["hello"[0..2]], 1)
assert_eq(Regex.find("(?<he>l+)", "hello")["hello"[0..2]], "ll")

// `init` is invoked as a zero-argument thunk, so a callee that requires an
// argument is an ArityError — not a frame with an unbound name in it.
assert_throws("ArityError", || {a: 1}.get_or_put("z", |k| k))
assert_throws("ArityError", || {a: 1}.get_or_put("z", |a, b| a))
assert_throws("ArityError", || {a: 1}.get_or_put("z", fn (*, k) {
  k
}))
// ...but a thunk whose parameters all have somewhere to come from runs.
assert_eq({a: 1}.get_or_put("z", fn (q = 5) {
  q
}), 5)
assert_eq({a: 1}.get_or_put("y", fn (*rest) {
  rest.size()
}), 0)

// A key and a value that never reach the slot (the thunk raised, or the key
// is unhashable) must not strand — the RC-leak net for these lives in the
// difftest leak corpus; these pin the observable behaviour.
assert_throws("TypeError", || {a: 1}.get_or_put([1, 2], || [3, 4]))
assert_eq({a: 1}.get_or_put((1, "k"), || "made"), "made")

// A native builtin as `init` runs through its own trampoline on a miss, so
// the rejection is the count-based ArityError its ordinary call gives
// (`let f = to_string; f()`) — not the user-fn missing-required wording.
// The JIT used to answer "function does not accept keyword arguments" here:
// its thunk invoke goes through the shared kwargs dispatch, which has no
// parameter metadata for a native and, with no keyword content in the call,
// now hands it the plain positional path instead of rejecting.
mut native_init_msg = ""
try {
  let _ = {a: 1}.get_or_put("z", to_string)
} catch e {
  native_init_msg = "{e.kind}: {e.message}"
}
assert_eq(native_init_msg, "ArityError: expected 1 positional argument, got 0")
