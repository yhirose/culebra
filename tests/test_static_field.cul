# Conformance: §10 (class sugar — static fields).
# Static fields are immutable class-level constants, eagerly evaluated
# at class declaration time and installed as properties on the class
# namespace object (same place as static methods).

test_static_field_basic = fn () {
  class Shape {
    new() {}
    static PI = 3.14
    static MAX_SIDES = 100
  }
  assert_eq(Shape.PI, 3.14)
  assert_eq(Shape.MAX_SIDES, 100)
}

# Static fields and static methods coexist on the same class namespace.
test_static_field_with_method = fn () {
  class Circle {
    new(r) {
      self.radius = r
    }
    static PI = 3.14
    static unit() {
      Circle.new(1)
    }
    area() {
      self.radius * self.radius * Circle.PI
    }
  }
  let c = Circle.unit()
  assert_eq(c.area(), 3.14)
  assert_eq(Circle.PI, 3.14)
}

# Value expressions can be arbitrary expressions; eagerly evaluated.
test_static_field_expression = fn () {
  class Config {
    new() {}
    static BASE = 10
    static DOUBLE = 10 * 2
    static GREETING = "hello world"
    static SUM = [1, 2, 3].sum()
  }
  assert_eq(Config.BASE, 10)
  assert_eq(Config.DOUBLE, 20)
  assert_eq(Config.GREETING, 'hello world')
  assert_eq(Config.SUM, 6)
}

# Static fields are not visible on instances (mirrors static method semantics).
# Missing instance properties resolve to nil (culebra's general semantics).
test_static_field_not_on_instance = fn () {
  class K {
    new() {}
    static FOO = 42
  }
  let k = K.new()
  assert_eq(k.FOO, nil)
  assert_eq(K.FOO, 42)
}

# Static fields are immutable from the outside.
test_static_field_immutable = fn () {
  class Const {
    new() {}
    static VAL = 1
  }
  let kind = try {
    Const.VAL = 2
    'no error'
  } catch e {
    "kind={e.kind}"
  }
  assert_true(kind == 'kind=ImmutableError' || kind == 'kind=TypeError')
}

# A static field may annotate its value's type: still a constant on the
# class object, checked against the type once, where the class is declared.
test_static_field_typed = fn () {
  class Typed {
    static PI: Float = 3.14
    static NAMES: Array<String> = ['circle']
    static NONE: Long? = nil
  }
  assert_eq(Typed.PI, 3.14)
  assert_eq(Typed.NAMES, ['circle'])
  assert_eq(Typed.NONE, nil)
  assert_eq(Typed().PI, nil)
  assert_eq(try { Typed.PI = 2.0 } catch e { e.kind }, 'ImmutableError')
}

test_static_field_typed_mismatch = fn () {
  let declare = fn () {
    class Wrong {
      static PI: Long = 3.14
    }
    Wrong.PI
  }
  assert_eq(try { declare() } catch e { [e.kind, e.message] },
            ['TypeError', "type error: static field 'PI' expects Long"])
}

# A class's type parameter in a static's annotation checks as Any, as it does
# in every other member annotation.
test_static_field_typed_generic = fn () {
  class Default<T> {
    static D: T = 5
  }
  assert_eq(Default.D, 5)
}

# What a static value declares is its own: it ends with the value, and a
# closure in the value reads it through a cell of its own.
mut sf_scope_t = 0
class SfScoped {
  static s = (let sf_scope_t = 5) + 1
  static c = (let sf_own = 4) + (|| sf_own)()
}
test_static_field_value_scope = fn () {
  assert_eq([SfScoped.s, SfScoped.c, sf_scope_t], [6, 8, 0])
  # A write after it reaches the outer `mut`, not the value's `let`.
  class SfWriteAfter {
    static s = (let sf_scope_t = 7) + 0
  }
  sf_scope_t = 6
  assert_eq([SfWriteAfter.s, sf_scope_t], [7, 6])
  let in_fn = fn () {
    let v = 'outer'
    class SfInFn {
      static s = (let v = 1) + 0
    }
    [SfInFn.s, v]
  }
  assert_eq(in_fn(), [1, 'outer'])
}

# The class's own name is not bound while its static values are evaluated.
# A read there is the NameError of any name read before its declaration has
# run, whether the value reads it or a function it calls does. A function
# kept in a static runs later, and names the class then.
test_static_field_own_class = fn () {
  let unbound = |name| "NameError: undefined variable '{name}'"
  let said = fn (f) {
    try {
      f()
      'bound'
    } catch e {
      "{e.kind}: {e.message}"
    }
  }
  let direct = said(fn () {
    class SfOwnDirect {
      static s = 4
      static t = SfOwnDirect.s + 1
    }
  })
  assert_eq(direct, unbound('SfOwnDirect'))
  let through_fn = said(fn () {
    class SfOwnCalled {
      static s = 4
      static t = (|| SfOwnCalled.s + 1)()
    }
  })
  assert_eq(through_fn, unbound('SfOwnCalled'))
  let as_value = said(fn () {
    class SfOwnValue {
      static me = SfOwnValue
    }
  })
  assert_eq(as_value, unbound('SfOwnValue'))
  let made = said(fn () {
    class SfOwnMade {
      new() {}
      static one = SfOwnMade.new()
    }
  })
  assert_eq(made, unbound('SfOwnMade'))
  let called = said(fn () {
    class SfOwnSugar {
      new() {}
      static one = SfOwnSugar()
    }
  })
  assert_eq(called, unbound('SfOwnSugar'))

  class SfOwnLater {
    new() {
      self.v = 1
    }
    static make = || SfOwnLater()
    static kind = || type_of(SfOwnLater)
  }
  assert_eq([SfOwnLater.make().v, SfOwnLater.kind()], [1, 'Class'])
}

test_static_field_basic()
test_static_field_own_class()
test_static_field_with_method()
test_static_field_expression()
test_static_field_not_on_instance()
test_static_field_immutable()
test_static_field_typed()
test_static_field_typed_mismatch()
test_static_field_typed_generic()
test_static_field_value_scope()

inspect('static-field OK')
