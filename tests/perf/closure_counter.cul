# Closure with mutable captured state (cell reads/writes)
# perf: min_speedup 0.85   # recalibrated B7-c: vm (not interp) is the reference lane
make_counter = fn () {
  mut n = 0
  fn () {
    n = n + 1
    n
  }
}
c = make_counter()
mut last = 0
mut i = 0
while i < 1000000 {
  last = c()
  i = i + 1
}
inspect(last)
