// Conformance: class getters (`get name() { ... }` read as `obj.name`).
// A getter is a no-parameter method invoked on a bare property read; it also
// works when spelled with call parens. Tested on interp, JIT, and AOT via
// `just test` — identical stdout (asserts are silent on success).

class Circle {
  new(r) { this.r = r }
  get area() { 3 * this.r * this.r }   // pure, no parens at the call site
  get r2() { this.r * this.r }
  scale(k) { Circle.new(this.r * k) }  // a plain method still needs parens
}

let c = Circle.new(2)

// --- bare read invokes the getter ---
assert_eq(c.area, 12)
assert_eq(c.r2, 4)

// --- both spellings invoke it (backward compatible) ---
assert_eq(c.area, c.area())

// --- getter composes with method chains ---
assert_eq(c.scale(3).area, 108)
assert_eq(c.scale(3).area, c.scale(3).area())

// --- a getter reads `this` fields like any method ---
class Point {
  new(x, y) { this.x = x; this.y = y }
  get sum() { this.x + this.y }
  get name() { "pt" }                  // a getter named `name` fires, not fn intro
}
let pt = Point.new(3, 4)
assert_eq(pt.sum, 7)
assert_eq(pt.name, "pt")               // introspection-name path also fires getters
assert_eq(pt.name, pt.name())

// --- getters read inside a HOF lambda ---
let pts = [Point.new(1, 1), Point.new(2, 2)].map(|p| p.sum)
assert_eq(pts, [2, 4])

// --- a plain 0-arg method is NOT auto-invoked by a bare read ---
class Box {
  new(v) { this.v = v }
  peek() { this.v }                    // ordinary method — bare read yields it
}
let b = Box.new(9)
assert_eq(type_of(b.peek), "Function") // not called
assert_eq(b.peek(), 9)                 // called

// --- a member literally named `get` is not the `get` modifier ---
// (the contextual keyword only fires when an identifier follows)
class Getter {
  new(v) { this.v = v }
  get() { this.v }                     // method named "get"
}
assert_eq(Getter.new(5).get(), 5)
// A getter declared with parameters is a SyntaxError — asserted out-of-band in
// the JIT/interp symmetry harness, not here (it is a whole-module parse error).
