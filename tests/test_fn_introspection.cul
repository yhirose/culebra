// Conformance: function introspection via `fn.name`, `fn.params`,
// `fn.return_type`. Phase 1 of [[project-fn-params-introspection]].
// Both backends + AOT must agree.

// --- fn.name on declared function ---
fn add(a, b) { a + b }
assert_eq(add.name, "add")

// Anonymous functions: name is ""
let inc = fn (x) { x + 1 }
assert_eq(inc.name, "")

// Lambda: also anonymous
let dbl = |x| x * 2
assert_eq(dbl.name, "")

// --- fn.params basic ---
let ps = add.params
assert_eq(ps.size(), 2)
assert_eq(ps[0].name, "a")
assert_eq(ps[0].mut, false)
assert_eq(ps[0].type, "")
assert_eq(ps[0].has_default, false)
assert_eq(ps[0].kw_only, false)
assert_eq(ps[0].kwargs_rest, false)
assert_eq(ps[1].name, "b")

// --- type annotation ---
fn typed(x: Long, y: String) -> Long { x }
assert_eq(typed.name, "typed")
assert_eq(typed.return_type, "Long")
let tps = typed.params
assert_eq(tps[0].type, "Long")
assert_eq(tps[1].type, "String")

// No annotation: empty
assert_eq(add.return_type, "")

// --- mut param ---
fn modify(mut x) { x }
let mps = modify.params
assert_eq(mps[0].mut, true)

// --- default value ---
fn with_default(x, y = 10) { x + y }
let dps = with_default.params
assert_eq(dps[0].has_default, false)
assert_eq(dps[1].has_default, true)

// --- kw-only (* separator) ---
fn kw_fn(x, *, kw_a, kw_b = 5) { x }
let kps = kw_fn.params
assert_eq(kps[0].name, "x")
assert_eq(kps[0].kw_only, false)
assert_eq(kps[1].name, "kw_a")
assert_eq(kps[1].kw_only, true)
assert_eq(kps[2].name, "kw_b")
assert_eq(kps[2].kw_only, true)
assert_eq(kps[2].has_default, true)

// --- **rest ---
fn rest_fn(x, **rest) { x }
let rps = rest_fn.params
assert_eq(rps[0].kwargs_rest, false)
assert_eq(rps[1].name, "rest")
assert_eq(rps[1].kwargs_rest, true)

// --- params is a fresh Array each access (mutating one copy does not
// affect a later fetch; collections are value-equal so freshness is
// checked by mutation, not by reference inequality) ---
let p1 = add.params
let p2 = add.params
assert_eq(p1, p2)                  // same content (value-equal)
mut pmut = add.params
let n0 = pmut.size()
pmut.push(nil)
assert_eq(add.params.size(), n0)   // a fresh fetch is unaffected

// --- class method also has name ---
class Box {
  new (v) { self.v = v }
  get () { self.v }
}
let bx = Box.new(7)
// `get` was wrapped with `self` bound for method call; the bound
// wrapper is itself a Function, so `.name` should still reflect "get".
// (Note: this checks the post-wrapping function; if culebra wraps
// methods on each access, the name should propagate. We accept either
// "get" or "" — both are coherent.)
let g = bx.get
assert_true(g.name == "get" || g.name == "")

IO.puts("test_fn_introspection OK")
