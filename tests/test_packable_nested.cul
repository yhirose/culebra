// Nested @packable struct: a @packable class field whose type is another
// @packable class. The inner record is stored inline; `outer.inner` yields a
// view over those bytes, so `outer.inner.x = v` writes through in place.

@packable
class Point {
  x: Float32
  y: Float32
}

@packable
class Line {
  id: Int32
  start: Point
  end: Point
}

buf = SharedBuffer.new(3, Line)

// Zero value: nested scalars start at 0.
assert_eq(buf[0].start.x, 0.0)
assert_eq(buf[0].end.y, 0.0)

// Write through the nested view, read back.
buf[0].id = 1
buf[0].start.x = 1.0
buf[0].start.y = 2.0
buf[0].end.x = 3.0
buf[0].end.y = 4.0
assert_eq(buf[0].start.x, 1.0)
assert_eq(buf[0].start.y, 2.0)
assert_eq(buf[0].end.x, 3.0)
assert_eq(buf[0].end.y, 4.0)
assert_eq(buf[0].id, 1)

// Records and sub-records are independent.
buf[1].start.x = 9.0
assert_eq(buf[0].start.x, 1.0)
assert_eq(buf[0].end.x, 3.0)         // a sibling sub-record is untouched

// Whole sub-record copy (memcpy of the inner bytes).
buf[2].start = buf[0].start
assert_eq(buf[2].start.x, 1.0)
assert_eq(buf[2].start.y, 2.0)
// the copy is independent of the source afterward
buf[0].start.x = 100.0
assert_eq(buf[2].start.x, 1.0)

// Copying from a wrong-class record is a TypeError.
@packable
class Other { a: Int32 }
ob = SharedBuffer.new(1, Other)
try {
  buf[0].start = ob[0]
  assert_eq("no throw", "should throw")
} catch e { assert_eq(e.kind, "TypeError") }

// Cross-isolate share: a child writes the nested sub-record's fields.
shared = SharedBuffer.new(1, Line)
w = Isolate.spawn(fn() {
  shared[0].start.x = 7.0
  shared[0].end.y = 8.0
})
w.join()
assert_eq(shared[0].start.x, 7.0)
assert_eq(shared[0].end.y, 8.0)

IO.puts("test_packable_nested OK")
