// Conformance: §10 (non-String keys). See docs/language.md §25.
//
// Non-String literal keys on Object (Phase 7-B/C).
// Both backends accept Long/Float/Bool/Nil as keys and look them up
// via obj[k].

let m = {1: "one", 2: "two", 3.14: "pi"}
assert_eq(m[1], "one")
assert_eq(m[2], "two")
assert_eq(m[3.14], "pi")

// Single-key cases (avoid Python-style numeric cross-type collision).
let by_bool = {true: "y"}
assert_eq(by_bool[true], "y")

let by_nil = {nil: "n"}
assert_eq(by_nil[nil], "n")

// Key identity is Ruby's `eql?`: keys of different types are never equal, so
// `1`, `1.0`, and `true` are three distinct keys. A literal mixing them keeps
// every key (unlike Python's `1 == True` / `1 == 1.0` key collapse).
let mixnk = {1: "one", true: "yes", 0: "zero", false: "no"}
assert_eq(mixnk[1], "one")
assert_eq(mixnk[true], "yes")
assert_eq(mixnk[0], "zero")
assert_eq(mixnk[false], "no")
assert_eq(mixnk.size(), 4)
// Long and Float of equal value are STILL distinct keys (type-strict).
let numk = {2: "L", 2.0: "F", true: "B"}
assert_eq(numk.size(), 3)
assert_eq(numk[2], "L")
assert_eq(numk[2.0], "F")
assert_eq(numk[true], "B")
// The `==` operator coerces across numeric types (`1 == 1.0`) but Bool is not
// numeric, so `1 == true` is false — key identity is strictly finer than `==`
// only for the Long/Float pair.
assert_eq(1 == 1.0, true)
assert_eq(1 == true, false)

// Duplicate keys in a literal overwrite last-wins (the interp's `initialize`
// semantics — a literal isn't a sequence of immutable `o[k] = v` assignments).
assert_eq(to_string({1: "x", 1: "y"}), to_string({1: "y"}))
assert_eq(to_string({1.0: "a", 1.0: "b"}), to_string({1.0: "b"}))
let dupt = {(1, 2): "a", (1, 2): "b"}
assert_eq(dupt[(1, 2)], "b")
assert_eq(dupt.size(), 1)
// The later occurrence's `mut` wins too; a post-construction write then obeys
// the (now mutable) slot, while a genuinely immutable slot still rejects it.
mut mm = {x: 1, mut x: 2}
mm.x = 7
assert_eq(mm.x, 7)

// String keys keep working alongside non-String ones — String keys
// flow through the shape/string_view path; non-String keys live in
// the lazy sidecar.
let mix = {a: 1, 99: "ninety-nine"}
assert_eq(mix.a, 1)
assert_eq(mix[99], "ninety-nine")

// Mixed-key str rendering: String and non-String keys interleave in
// their true insertion order. String literals can't embed `{` or `'`
// cleanly, so the assertion compares against another to_string call
// of the same logical Object.
let m2 = {a: 1, 2: "two", b: 3, 4: "four"}
let m3 = {a: 1, 2: "two", b: 3, 4: "four"}
assert_eq(to_string(m2), to_string(m3))
// Distinct insertion orders render differently.
let m4 = {2: "two", a: 1, 4: "four", b: 3}
let diff = to_string(m2) == to_string(m4)
assert_eq(diff, false)

// And the same insertion order yields the same render.
let n = {10: "x", 5: "y", 1: "z"}
let n2 = {10: "x", 5: "y", 1: "z"}
assert_eq(to_string(n), to_string(n2))

// --- Runtime keys via `obj[k] = v` ---
// Object subscript-assignment routes String keys through the shape
// (same slot as `obj.x`) and everything else (Long, Float, Bool, Nil,
// Tuple) through the non-String sidecar.
mut bag = {}
let sk = "alpha"
bag[sk] = 100
bag[42] = "long"
bag[(1, 2)] = "tuple"
bag[true] = "bool"
assert_eq(bag[sk], 100)
assert_eq(bag[42], "long")
assert_eq(bag[(1, 2)], "tuple")
assert_eq(bag[true], "bool")

// String literal keys via subscript work too.
mut named = {}
named["foo"] = 1
named["bar"] = 2
assert_eq(named["foo"], 1)
assert_eq(named["bar"], 2)

// Subscript writes with String keys unify with shape-based `obj.foo`
// access — `obj["x"] = v` and `obj.x = v` reach the same slot, so
// either form of read sees the other's write.
mut split = {}
split["x"] = 99
assert_eq(split.x, 99)
split.y = 7
assert_eq(split["y"], 7)

// `mut` on subscript-set makes the slot mutable, so a later write
// (subscript or dot, either flow into the same shape slot) succeeds.
mut split2 = {}
mut split2["x"] = 1
split2["x"] = 2  // update via subscript
split2.x = 3     // update via dot — same slot
assert_eq(split2.x, 3)
assert_eq(split2["x"], 3)

// --- G-1/G-2: size/has/keys/remove cover both key kinds ---
mut bag2 = {a: 1, b: 2}
bag2[10] = "ten"
bag2[(1, 2)] = "tup"
assert_eq(bag2.size(), 4)
assert_true(bag2.has("a"))
assert_true(bag2.has(10))
assert_true(bag2.has((1, 2)))
let absent = bag2.has("zzz")
assert_eq(absent, false)
let ks = bag2.keys()
assert_eq(ks.size(), 4)
assert_eq(ks[0], "a")
assert_eq(ks[2], 10)
assert_eq(ks[3], (1, 2))

// for-in yields (key, value) pairs; the keys (first of each pair) match
// keys() — String and non-String interleaved in insertion order.
// (Regression: interp's for-in used to walk only the String shape,
// dropping non-String keys, so it diverged from both keys() and size().)
mut iter_keys = []
for k, v in bag2 {
  iter_keys.push(k)
}
assert_eq(iter_keys, ks)

bag2.remove(10)
assert_eq(bag2.size(), 3)
bag2.remove("a")
assert_eq(bag2.size(), 2)
bag2.remove((1, 2))
assert_eq(bag2.size(), 1)

// --- Compound subscript-set (interp + JIT) ---
// Both forms (`obj[k] += v` and `obj.k += v`) reach the same slot for
// String keys and honor the slot's `mut` flag; non-String keys live in
// the sidecar but compound updates work there too.
mut counts = {mut a: 10, mut b: 20}
counts['a'] += 5  // shape slot via subscript
assert_eq(counts.a, 15)
counts.b -= 3  // dot reaches the same slot
assert_eq(counts['b'], 17)
counts['a'] *= 2
assert_eq(counts.a, 30)

mut sidebag = {}
mut sidebag[42] = 100
sidebag[42] += 7
assert_eq(sidebag[42], 107)
sidebag[42] /= 7
assert_eq(sidebag[42], 15)

mut tally = {}
mut tally[(1, 2)] = 50
tally[(1, 2)] -= 10
assert_eq(tally[(1, 2)], 40)

// Tuple-key refcount stress: repeated insert/update/has/remove on the
// same Tuple-shaped key. The JIT runtime previously leaked one ref
// per update / remove / has call against refcounted keys; this loop
// would have grown unbounded garbage. Now the helpers consume the
// caller's +1 in every path so the loop runs flat.
mut bag3 = {}
mut i = 0
while i < 20 {
  let k = (i, i + 1)
  mut bag3[k] = i  // insert
  bag3[k] = i * 2  // update
  assert_true(bag3.has((i, i + 1)))
  assert_eq(bag3[(i, i + 1)], i * 2)
  bag3[k] += 1
  assert_eq(bag3[(i, i + 1)], i * 2 + 1)
  bag3.remove((i, i + 1))
  i = i + 1
}
assert_eq(bag3.size(), 0)

// Regression: an unhashable non-IDENTIFIER key (a Tuple containing an
// unhashable Array) repeatedly thrown in a loop used to corrupt the JIT's
// heap a few hundred iterations later — object_set_any's own unwind-time
// release of the key/value raced the JIT's automatic unwind-temp window,
// which released the same pair again on the same throw (a double release;
// the interp has no such window so it never showed the bug). Enough
// iterations to reliably reproduce the pre-fix corruption.
mut j = 0
while j < 2000 {
  let ok = try {
    let bad = {([j], 1): "x"}
    false
  } catch er {
    er.kind == "TypeError"
  }
  assert_true(ok)
  j = j + 1
}

// Removing a non-String key from an object that holds none is a no-op, but it
// still hashes the key — an unhashable one has to raise here the way the
// interpreter's sidecar does, rather than silently do nothing.
mut only_str = {a: 1}
only_str.remove(42)
assert_eq(only_str.size(), 1)
assert_throws('TypeError', fn () { only_str.remove([1]) })

IO.inspect("test_object_keys OK")
