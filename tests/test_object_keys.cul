// Non-String literal keys on Object (Phase 7-B/C).
// Both backends accept Long/Float/Bool/Nil as keys and look them up
// via obj[k].

let m = {1: "one", 2: "two", 3.14: "pi"}
assert(m[1] == "one")
assert(m[2] == "two")
assert(m[3.14] == "pi")

// Single-key cases (avoid Python-style numeric cross-type collision).
let by_bool = {true: "y"}
assert(by_bool[true] == "y")

let by_nil = {nil: "n"}
assert(by_nil[nil] == "n")

// String keys keep working alongside non-String ones — String keys
// flow through the shape/string_view path; non-String keys live in
// the lazy sidecar.
let mix = {a: 1, 99: "ninety-nine"}
assert(mix.a == 1)
assert(mix[99] == "ninety-nine")

// Mixed-key str rendering: String and non-String keys interleave in
// their true insertion order. String literals can't embed `{` or `'`
// cleanly, so the assertion compares against another to_string call
// of the same logical Object.
let m2 = {a: 1, 2: "two", b: 3, 4: "four"}
let m3 = {a: 1, 2: "two", b: 3, 4: "four"}
assert(to_string(m2) == to_string(m3))
// Distinct insertion orders render differently.
let m4 = {2: "two", a: 1, 4: "four", b: 3}
let diff = (to_string(m2) == to_string(m4))
assert(diff == false)

// And the same insertion order yields the same render.
let n  = {10: "x", 5: "y", 1: "z"}
let n2 = {10: "x", 5: "y", 1: "z"}
assert(to_string(n) == to_string(n2))

// --- Runtime keys via `obj[k] = v` ---
// Object subscript-assignment routes every key (Long, Float, Bool,
// Nil, Tuple, runtime String) through the non-String sidecar.
mut bag = {}
let sk = "alpha"
bag[sk] = 100
bag[42] = "long"
bag[(1, 2)] = "tuple"
bag[true] = "bool"
assert(bag[sk] == 100)
assert(bag[42] == "long")
assert(bag[(1, 2)] == "tuple")
assert(bag[true] == "bool")

// String literal keys via subscript work too.
mut named = {}
named["foo"] = 1
named["bar"] = 2
assert(named["foo"] == 1)
assert(named["bar"] == 2)

// Subscript writes don't unify with shape-based `obj.foo` access —
// runtime String keys live in the sidecar, static identifiers in
// the shape, so `obj.foo` after `obj["foo"] = v` is still nil.
mut split = {}
split["x"] = 99
assert(split.x == nil)

IO.puts("test_object_keys OK")
