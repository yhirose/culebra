# Conformance: §18 (String iterators). See docs/language.md §25.
#
# The iterators over a String (code_points, graphemes, words, sentences, bytes)
# and the inverses that build a String from numbers. The for-in protocol and
# range are in test_iter.cul.

# --- Phase 2: String iteration (UTF-8 scalar walk) ---
mut count = 0
for c in 'hello' {
  count = count + 1
}
assert_eq(count, 5)

# Non-ASCII: 'café' is 5 UTF-8 bytes but 4 scalars
mut scalars = 0
for c in 'café' {
  scalars = scalars + 1
}
assert_eq(scalars, 4)

# Scalars are yielded as 1-char Strings, not Longs
mut parts = []
for c in 'ab' {
  parts.push(c)
}
assert_eq(parts.size(), 2)
assert_true(parts[0] == 'a' && parts[1] == 'b')

# --- String.code_points() — Iterator<Long> over Unicode scalars ---
cps = 'café'.code_points().collect()
assert_eq(cps.size(), 4)
assert_true(cps[0] == 99 && cps[1] == 97 && cps[2] == 102 && cps[3] == 233)

# Numeric ops are natural on code points (range / classification)
upper = 'Hello World'.code_points().filter(fn (cp) {
  cp >= 65 && cp <= 90
}).count()
assert_eq(upper, 2)

# Empty and ASCII-only
assert_eq(''.code_points().count(), 0)
assert_eq('hello'.code_points().count(), 5)

# --- String.graphemes() — Iterator<String> over Extended Grapheme Clusters ---
gs = 'a👨‍👩‍👧b'.graphemes().collect()
assert_eq(gs, ['a', '👨‍👩‍👧', 'b'])

# No combining marks → each scalar is its own grapheme
assert_eq('café'.graphemes().count(), 4)
# Scalar count depends on exact source bytes (ZWJ separators included);
# grapheme count is the API-level guarantee.
assert_eq('a👨‍👩‍👧b'.code_points().count(), 7)
assert_eq('a👨‍👩‍👧b'.graphemes().count(), 3)
assert_eq(''.graphemes().count(), 0)

# --- String.words() — Iterator<Tuple> over UAX #29 word boundary segments ---
# Every run between two boundaries is its own segment (whitespace and
# punctuation included), tagged `(text, is_word)`.
ws = 'Hello, world!'.words().collect()
assert_eq(ws, [
  ('Hello', true),
  (',', false),
  (' ', false),
  ('world', true),
  ('!', false),
])

# Filtering on is_word keeps only the real words
real_words = 'Hello, world!'.words().filter(|(_, w)| w).map(|(t, _)| t).collect()
assert_eq(real_words, ['Hello', 'world'])

# Non-ASCII words and an apostrophe held inside a word (WB6/WB7 MidNumLet)
assert_eq('café résumé'.words().filter(|(_, w)| w).map(|(t, _)| t).collect(),
  ['café', 'résumé'])
assert_eq("don't stop".words().filter(|(_, w)| w).map(|(t, _)| t).collect(),
  ["don't", 'stop'])

assert_eq(''.words().count(), 0)

# --- String.sentences() — Iterator<StringView> over UAX #29 sentence boundary segments ---
# One sentence per step; trailing whitespace stays attached to the sentence
# before it.
assert_eq('Hello. World.'.sentences().collect(), ['Hello. ', 'World.'])
assert_eq('One sentence only'.sentences().collect(), ['One sentence only'])
assert_eq(''.sentences().count(), 0)

# --- String.bytes() — Iterator<Long> over raw UTF-8 bytes (no decoding) ---
bs = 'café'.bytes().collect()
assert_eq(bs.size(), 5)  # 'é' is 2 bytes; code_points() above sees 4 scalars
assert_true(bs[0] == 99 &&
  bs[1] == 97 &&
  bs[2] == 102 &&
  bs[3] == 195 &&
  bs[4] == 169)
assert_eq(''.bytes().count(), 0)
assert_eq('hello'.bytes().count(), 5)
# ASCII: bytes() and code_points() agree
assert_eq('hello'.bytes().collect(), 'hello'.code_points().collect())

# --- String.from_code_point(cp) — inverse of code_points()/\u and \U ---
assert_eq(String.from_code_point(97), 'a')
assert_eq(String.from_code_point(233), 'é')
# Round-trips through code_points()
assert_eq(String.from_code_point('é'.code_points().collect()[0]), 'é')
assert_throws("ValueError", fn () {
  String.from_code_point(0x110000)
})  # above max scalar
assert_throws("ValueError", fn () {
  String.from_code_point(0xD800)
})  # surrogate range
assert_throws("TypeError", fn () {
  String.from_code_point('a')
})  # not a Long

# --- String.from_code_points(cps) — plural inverse of code_points() ---
assert_eq(String.from_code_points([99, 97, 102, 233]), 'café')
assert_eq(String.from_code_points([]), '')
# Round-trips through code_points() for any String
assert_eq(String.from_code_points('café'.code_points().collect()), 'café')
assert_eq(
  String.from_code_points('a👨‍👩‍👧b'.code_points().collect()),
  'a👨‍👩‍👧b',
)
# Agrees with the singular form
assert_eq(String.from_code_points([233]), String.from_code_point(233))
assert_throws("ValueError", fn () {
  String.from_code_points([0x110000])
})
assert_throws("ValueError", fn () {
  String.from_code_points([0xD800])
})
assert_throws("TypeError", fn () {
  String.from_code_points(['a'])
})

# --- String.from_bytes(bytes) — inverse of bytes() (no UTF-8 validation) ---
assert_eq(String.from_bytes([99, 97, 102, 195, 169]), 'café')
assert_eq(String.from_bytes([]), '')
# Round-trips through bytes() for any String, including multi-byte scalars
assert_eq(String.from_bytes('café'.bytes().collect()), 'café')
assert_eq(
  String.from_bytes('a👨‍👩‍👧b'.bytes().collect()),
  'a👨‍👩‍👧b',
)
# Invalid UTF-8 byte still builds — culebra Strings tolerate invalid UTF-8
assert_eq(String.from_bytes([0xFF]).bytes().collect(), [0xFF])
# An ill-formed sequence is its first byte alone, and every walk over a
# String splits it the same way: E3 41 is two scalars, not one.
let bad = String.from_bytes([0xE3, 0x41, 0x82])
mut walked = []
for c in bad {
  walked.push(c.bytes().collect())
}
assert_eq(walked, [[0xE3], [0x41], [0x82]])
assert_eq(bad.iter().map(fn (c) { c.bytes().collect() }).collect(), walked)
let b82 = String.from_bytes([0x82])
assert_eq(bad.tr(b82, '').bytes().collect(), [0xE3, 0x41])
assert_eq(bad.trim_end(b82).bytes().collect(), [0xE3, 0x41])
assert_throws("ValueError", fn () {
  String.from_bytes([256])
})  # above byte range
assert_throws("ValueError", fn () {
  String.from_bytes([-1])
})  # below byte range
assert_throws("TypeError", fn () {
  String.from_bytes(['a'])
})  # not a Long

