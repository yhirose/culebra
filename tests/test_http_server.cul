# Http.server — v0 single-threaded HTTP server. The server blocks in serve(),
# so it runs in an Isolate (its own thread + runtime) while the main thread
# drives requests through the existing Http client over loopback. Dropping the
# isolate handle sets its interrupt flag, which the server's accept loop polls
# and stops on — giving a clean, deterministic shutdown. Output is identical
# across interp/JIT (no random or timing-dependent values are printed).
#
# Every server here binds port 0 and reports the port the OS gave it. bind()
# returning is both the port and the readiness signal: the socket is open with a
# backlog, so a connection sent after it is queued even before serve() accepts.
# That removes both hazards of a fixed port — another gate on this machine
# cannot take it, and nothing has to guess when the bind finished.

# The bound port, or a named failure. recv() yields nil when the channel closed
# without a port, i.e. the isolate died before binding; without this the caller
# would meet it as a type error on nil several lines later.
fn bound_port(rx) {
  let p = rx.recv()
  if p == nil {
    throw {kind: "AssertionError", message: "server never bound"}
  }
  return p
}

let (tx, rx) = Channel.new(1)
iso = Isolate.spawn(fn () {
  let srv = Http.server()
  srv.get("/", fn (req) {
    "Hello, world!"
  })
  srv.get("/users/:id", fn (req) {
    "user " + req.params["id"]
  })
  srv.post("/echo", fn (req) {
    req.body
  })
  srv.get("/q", fn (req) {
    "name=" + req.query["name"]
  })
  srv.get("/method", fn (req) {
    req.method
  })
  srv.get("/json", fn (req) {
    {
      status: 201,
      body: '{"ok":true}',
      content_type: "application/json",
      headers: {"X-Test": "yes"},
    }
  })
  srv.get("/empty", fn (req) {
    nil
  })
  # PUT / DELETE routes, for the client verbs of the same name. HEAD has no
  # route of its own: the server answers it from the matching GET handler
  # (cpp-httplib routes the two together), which is what /json pins below.
  srv.put("/item", fn (req) {
    "put:" + req.body
  })
  srv.delete("/item", fn (req) {
    {status: 204}
  })
  # Malformed response objects: a wrong-typed field is a TypeError → 500, with
  # an identical message across interp/JIT (the trampoline puts e.what() in the
  # body). These lock the apply-response type checks symmetric.
  srv.get("/bad_status", fn (req) {
    {status: "x"}
  })
  srv.get("/bad_ct", fn (req) {
    {body: "ok", content_type: 9}
  })
  srv.get("/bad_body", fn (req) {
    {body: 9}
  })
  srv.get("/bad_hdr", fn (req) {
    {body: "ok", headers: {"A": 1}}
  })
  # Streaming (chunked / SSE): the handler returns an Object with a `stream`
  # Function. The provider runs on this worker thread and hands the closure a
  # `sink` whose .write(chunk) pushes one chunk. status/content_type/headers
  # apply as usual; body + stream is a TypeError → 500.
  srv.get("/count", fn (req) {
    {stream: fn (sink) {
      for i in 0..5 {
        sink.write(i.to_string() + ",")
      }
    }}
  })
  srv.get("/sse", fn (req) {
    {status: 202, content_type: "text/event-stream", headers: {"Cache-Control": "no-cache"}, stream: fn (sink) {
      for i in 0..3 {
        sink.write("data: " + i.to_string() + "\n\n")
      }
    }}
  })
  # An event stream answering a POST, the shape of a streaming LLM API: the
  # posted body and the request's Accept come back as events.
  srv.post("/events", fn (req) {
    {content_type: "text/event-stream", stream: fn (sink) {
      sink.write("event: echo\ndata: " + req.body + "\n\n")
      sink.write("data: " + req.headers["Accept"] + "\n\n")
    }}
  })
  # The same endpoint refusing: not 2xx, so its body is not an event stream.
  srv.post("/events_refused", fn (req) {
    {status: 429, content_type: "application/json", body: '{"error":"slow down"}'}
  })
  srv.get("/busy", fn (req) {
    {status: 503, body: "busy"}
  })
  srv.get("/stream_both", fn (req) {
    {body: "x", stream: fn (sink) {
      sink.write("y")
    }}
  })
  srv.get("/stream_bad", fn (req) {
    {stream: 42}
  })
  tx.send(srv.bind(0))  # bind first, hand the port to the parent
  tx.drop()
  srv.serve()
})
tx.drop()  # the parent's copy; the isolate holds one
BASE = "http://127.0.0.1:" + bound_port(rx).to_string()

r = Http.get(BASE + "/")
assert_eq(r.status.to_string() + " | " + r.body, '200 | Hello, world!')

r2 = Http.get(BASE + "/users/42")
assert_eq(r2.status.to_string() + " | " + r2.body, '200 | user 42')

r3 = Http.post(BASE + "/echo", body: "payload-123")
assert_eq(r3.status.to_string() + " | " + r3.body, '200 | payload-123')

r4 = Http.get(BASE + "/q", params: { name: "alice" })
assert_eq(r4.status.to_string() + " | " + r4.body, '200 | name=alice')

r5 = Http.get(BASE + "/method")
assert_eq(r5.body, 'GET')

r6 = Http.get(BASE + "/json")
assert_eq(r6.status.to_string() +
  " | " +
  r6.body +
  " | ct=" +
  r6.headers["Content-Type"] +
  " | x=" +
  r6.headers["X-Test"], '201 | {"ok":true} | ct=application/json | x=yes')

r7 = Http.get(BASE + "/empty")
assert_eq(r7.status.to_string() +
  " | len=" +
  r7.body.size().to_string(), '200 | len=0')

r8 = Http.get(BASE + "/missing")
assert_eq(r8.status.to_string(), '404')

# The client verbs past get/post. `put` carries a body like `post`; `delete`
# takes none and its 204 arrives with an empty one; `head` reaches the GET
# handler and keeps its status and headers while the body is dropped — the
# property that makes it worth a request at all.
rput = Http.put(BASE + "/item", body: "v2")
assert_eq(rput.status.to_string() + " | " + rput.body, '200 | put:v2')

rdel = Http.delete(BASE + "/item")
assert_eq(rdel.status.to_string() +
  " | len=" +
  rdel.body.size().to_string(), '204 | len=0')

rhead = Http.head(BASE + "/json")
assert_eq(rhead.status.to_string() +
  " | ok=" +
  rhead.ok.to_string() +
  " | reason=" +
  rhead.reason +
  " | len=" +
  rhead.body.size().to_string() +
  " | ct=" +
  rhead.headers["Content-Type"] +
  " | x=" +
  rhead.headers["X-Test"], '201 | ok=true | reason=Created | len=0 | ct=application/json | x=yes')

let bad_answers = ["/bad_status", "/bad_ct", "/bad_body", "/bad_hdr"].map(
  fn (bad) {
    let rb = Http.get(BASE + bad)
    "{rb.status} | {rb.body}"
  })
assert_eq(bad_answers, ['500 | type error: expected Long, got String',
                        '500 | type error: expected String, got Long',
                        '500 | type error: expected String, got Long',
                        '500 | type error: expected String, got Long'])

# Streaming: the client buffers the reassembled chunked body.
rc = Http.get(BASE + "/count")
assert_eq(rc.status.to_string() + " | " + rc.body, '200 | 0,1,2,3,4,')

rs = Http.get(BASE + "/sse")
assert_eq(rs.status.to_string() +
  " | ct=" +
  rs.headers["Content-Type"] +
  " | cc=" +
  rs.headers["Cache-Control"] +
  " | bytes=" +
  rs.body.size().to_string(), '202 | ct=text/event-stream | cc=no-cache | bytes=27')

# `events:` reads any request's body as Server-Sent Events, and sends
# `Accept: text/event-stream` unless the request sets Accept itself.
let echoed = []
let ev_resp = Http.post(BASE + "/events", json: {q: 1}, events: fn (e) {
  echoed.push("{e.event}: {e.data}")
})
assert_eq(echoed, ['echo: {"q":1}', 'message: text/event-stream'])
assert_eq("{ev_resp.status} | {ev_resp.body.size()}", '200 | 0')

let own_accept = []
Http.post(BASE + "/events", headers: {Accept: "text/plain"}, events: |e| own_accept.push(e.data))
assert_eq(own_accept, ['', 'text/plain'])

# Not 2xx is not an event stream: events is never called, and the body (the
# error a caller has to read) stays in the response.
let refused = []
let rr = Http.post(BASE + "/events_refused", json: {}, events: |e| refused.push(e.data))
assert_eq("{refused.size()} | {rr.status} | {rr.body}", '0 | 429 | {"error":"slow down"}')

# A throw from the callback ends the stream and propagates as it is.
assert_throws("ValueError", fn () {
  Http.post(BASE + "/events", events: fn (e) {
    throw {kind: "ValueError", message: "stop"}
  })
})

# Through a client, one kept-alive connection serves every streamed turn.
let api = Http.client(BASE)
let turns = [1, 2].map(fn (t) {
  let got = []
  api.post("/events", json: {turn: t}, events: |e| got.push(e.data))
  got[0]
})
assert_eq(turns, ['{"turn":1}', '{"turn":2}'])
api.close()

# Http.sse is Http.get(url, events:): the same events, and the same rule for a
# status that is not 2xx.
let sse_data = []
let rs2 = Http.sse(BASE + "/sse", |e| sse_data.push(e.data))
assert_eq(sse_data, ['0', '1', '2'])
assert_eq("{rs2.status} | {rs2.body.size()}", '202 | 0')
let busy = []
let rb = Http.sse(BASE + "/busy", |e| busy.push(e.data))
assert_eq("{busy.size()} | {rb.status} | {rb.body}", '0 | 503 | busy')

let stream_answers = ["/stream_both", "/stream_bad"].map(fn (sb) {
  let rsb = Http.get(BASE + sb)
  "{rsb.status} | {rsb.body}"
})
assert_eq(stream_answers,
          ['500 | Http.server: response cannot set both body and stream',
           '500 | Http.server: response stream must be a Function'])

iso.drop()

# --- Concurrent worker pool (workers > 1): each worker thread gets its own
# runtime with the handlers rebuilt onto it (so they must be Sendable), giving
# true parallel request handling. Parallel.map preserves input order, so the
# output is deterministic across backends.
let (tx2, rx2) = Channel.new(1)
iso2 = Isolate.spawn(fn () {
  let srv = Http.server()
  srv.get("/sq/:n", fn (req) {
    let n = to_long(req.params["n"])
    (n * n).to_string()
  })
  tx2.send(srv.bind(0))
  tx2.drop()
  srv.serve(workers: 4)
})
tx2.drop()
BASE2 = "http://127.0.0.1:" + bound_port(rx2).to_string()
squares = Parallel.map([1, 2, 3, 4, 5, 6, 7, 8], fn (i) {
  Http.get(BASE2 + "/sq/" + i.to_string()).body
})
assert_eq(squares, ['1', '4', '9', '16', '25', '36', '49', '64'])
iso2.drop()

# --- A non-Sendable handler is rejected with SendError when serving starts (the
# check is at serve, so listen() has bound by then) — identical across backends.
bad = Http.server()
mut hits = 0
bad.get("/", fn (req) {
  hits = hits + 1
  "x"
})
try {
  bad.listen(0, workers: 2)
} catch e {
  assert_eq(e.kind, 'SendError')
}
# The routes survive the rejection, so the retry reaches the same verdict rather
# than quietly serving an empty server.
mut bad2 = "none"
try {
  bad.serve_async(workers: 2)
} catch e {
  bad2 = e.kind
}
assert_eq(bad2, 'SendError')
bad.close()

# Port-free checks: handle methods chain (return the handle), and close is
# idempotent. These never bind a socket.
srv2 = Http.server()
chained = srv2.get("/a", fn (req) {
  "a"
}).post("/b", fn (req) {
  "b"
})
assert_eq(chained == srv2, true)
srv2.close()
srv2.close()

# --- WebSocket: a ws handler runs a long-lived loop over the connection. The
# server echoes (for-in form) and greets (explicit receive + req access); the
# client connects with Http.ws and the same handle shape drives both. A separate
# route pushes messages then returns, which the client drains with for-in. Under
# a worker pool so each connection occupies its own worker.
let (wtx, wrx) = Channel.new(1)
wiso = Isolate.spawn(fn () {
  let srv = Http.server()
  srv.ws("/echo", fn (req, ws) {
    for msg in ws {
      ws.send("echo:" + msg)
    }
  })
  srv.ws("/greet", fn (req, ws) {
    while true {
      let m = ws.receive()
      break if m == nil
      ws.send(req.path + ":" + m)
    }
  })
  srv.ws("/push", fn (req, ws) {
    mut i = 0
    while i < 3 {
      ws.send("p" + i.to_string())
      i = i + 1
    }
  })
  # A bounded read hands control back without closing the connection, so this
  # handler writes on its own schedule instead of parking in a read — the shape
  # a relay needs. It answers a message, and speaks up on its own after a few
  # empty rounds.
  srv.ws("/tick", fn (req, ws) {
    ws.set_timeout(50)
    mut empties = 0
    mut running = true
    while running {
      match ws.try_receive() {
        Message(m) => ws.send("got:" + m),
        Empty() => empties = empties + 1,
        Closed() => running = false,
      }
      if empties == 3 {
        ws.send("tick")
        empties = 0
      }
    }
  })
  wtx.send(srv.bind(0))
  wtx.drop()
  srv.serve(workers: 2)
})
wtx.drop()
WBASE = "ws://127.0.0.1:" + bound_port(wrx).to_string()

we = Http.ws(WBASE + "/echo")
we.send("one")
assert_eq(we.receive(), 'echo:one')
we.send("two")
assert_eq(we.receive() + " | open=" + we.is_open().to_string(), 'echo:two | open=true')
we.close()

wg = Http.ws(WBASE + "/greet")
wg.send("hi")
assert_eq(wg.receive(), '/greet:hi')
wg.close()

# Concurrent ws echoes, one client (isolate) each — Parallel.map keeps order.
wmany = Parallel.map([1, 2, 3, 4], fn (i) {
  let c = Http.ws(WBASE + "/echo")
  c.send(i.to_string())
  let r = c.receive()
  c.close()
  r
})
assert_eq(wmany, ['echo:1', 'echo:2', 'echo:3', 'echo:4'])

# Client drains server-pushed messages with for-in (ends when the server closes).
wp = Http.ws(WBASE + "/push")
mut pushed = []
for m in wp {
  pushed.push(m)
}
assert_eq(pushed, ['p0', 'p1', 'p2'])

# try_receive answers Empty / Message / Closed rather than overloading nil.
# Empty is pinned against a peer that was sent nothing, so no amount of load
# turns it into a message; the Message side gets a timeout long enough that a
# slow machine cannot turn it back into Empty.
wt = Http.ws(WBASE + "/echo")
wt.set_timeout(50)
assert_eq("{wt.try_receive()}", "WsResult.Empty")
assert_eq(wt.is_open(), true)
wt.set_timeout(5000)
wt.send("three")
assert_eq("{wt.try_receive()}", "WsResult.Message('echo:three')")
# receive() keeps meaning "the next message" with a timeout set.
wt.send("four")
assert_eq(wt.receive(), 'echo:four')
wt.close()
assert_eq("{wt.try_receive()}", "WsResult.Closed")

# The server side of the same thing: nothing is sent to /tick until after its
# unprompted message arrives, so that message can only have come from the
# handler's own timeout path.
wk = Http.ws(WBASE + "/tick")
assert_eq(wk.receive(), 'tick')
wk.send("five")
assert_eq(wk.receive(), 'got:five')
wk.close()

# A bad URL is an HttpError.
mut werr = "none"
try {
  Http.ws("ws://127.0.0.1:1/nope")
} catch e {
  werr = e.kind
}
assert_eq(werr, 'HttpError')

wiso.drop()

# --- listen_async + stop: a background server with no isolate wrapper. The
# server serves on its own thread while the main thread drives requests, then
# stop() halts it cross-thread and joins. listen_async always runs handlers on a
# worker pool (off this thread), so they must be Sendable. It returns the bound
# port, so bind/serve is only needed where the call blocks.
asrv = Http.server()
asrv.get("/", fn (req) {
  "async-hi"
})
asrv.get("/sq/:n", fn (req) {
  let n = to_long(req.params["n"])
  (n * n).to_string()
})
APORT = asrv.listen_async(0, workers: 2)  # returns the port immediately
ABASE = "http://127.0.0.1:" + APORT.to_string()

ar = Http.get(ABASE + "/")
assert_eq(ar.status.to_string() + " | " + ar.body, '200 | async-hi')
assert_eq(Http.get(ABASE + "/sq/9").body, '81')
# A server is single-use: starting it again (even on a free port) is a catchable
# error, not a crash/hang — serve again with a fresh Http.server().
mut reerr = "none"
try {
  asrv.listen_async(0)
} catch e {
  reerr = e.kind
}
assert_eq(reerr, 'HttpError')
# Mounting a directory after the start would hand the workers a table they are
# reading; it is the same catchable error as a second start.
mut sterr = "none"
try {
  asrv.static("/late", ".")
} catch e {
  sterr = e.kind
}
assert_eq(sterr, 'HttpError')
asrv.stop()  # cross-thread stop + join
mut reerr2 = "none"
try {
  asrv.listen_async(0)
} catch e {
  reerr2 = e.kind
}
assert_eq(reerr2, 'HttpError')

# After stop the port is free: a fresh server binds that same port and serves it.
asrv2 = Http.server()
asrv2.get("/", fn (req) {
  "rebound"
})
asrv2.listen_async(APORT)
assert_eq(Http.get(ABASE + "/").body, 'rebound')
asrv2.stop()

# A non-Sendable handler is rejected at listen_async (it runs off this thread).
abad = Http.server()
mut acount = 0
abad.get("/", fn (req) {
  acount = acount + 1
  "x"
})
try {
  abad.listen_async(0)
} catch e {
  assert_eq(e.kind, 'SendError')
}
abad.close()

# A bad bind (a host not on this machine) is an HttpError, reported synchronously.
abind = Http.server()
abind.get("/", fn (req) {
  "x"
})
mut abinderr = "none"
try {
  abind.listen_async(0, "192.0.2.1")
} catch e {
  abinderr = e.kind
}
assert_eq(abinderr, 'HttpError')
abind.close()

# --- exclusive bind: a port with a live listener must refuse a second server
# loudly. (cpp-httplib's default socket options set SO_REUSEPORT, under which a
# second bind silently succeeds and the two processes shadow/split requests —
# culebra overrides them with exclusive ones.) The holder takes an OS-assigned
# port; the intruder asks for exactly that one.
xsrv = Http.server()
xsrv.get("/", fn (req) {
  "holder"
})
XPORT = xsrv.listen_async(0, workers: 1)
XBASE = "http://127.0.0.1:" + XPORT.to_string()
xsrv2 = Http.server()
xsrv2.get("/", fn (req) {
  "intruder"
})
mut xerr = "none"
try {
  xsrv2.listen_async(XPORT, workers: 1)
} catch e {
  xerr = e.kind
}
assert_eq(xerr, 'HttpError')
assert_eq(Http.get(XBASE).body, 'holder')
xsrv2.close()
xsrv.stop()

# --- port 0: the OS picks a free port, listen_async returns it. (Don't print
# the port itself — it differs per run, and interp/jit outputs are diffed.)
zsrv = Http.server()
zsrv.get("/", fn (req) {
  "zeroed"
})
zport = zsrv.listen_async(0, workers: 1)
assert_eq(zport > 0 && zport <= 65535, true)
assert_eq(Http.get("http://127.0.0.1:" + zport.to_string() + "/").body, 'zeroed')
zsrv.stop()

# --- a handler that throws a value answers 500 with what the value says, as
# an error answers with its message, and the throw ends at the handler: the
# worker's next handler catches its own error. One worker, so the same one
# takes every request. A stream that throws aborts its connection, and a
# WebSocket handler that throws closes its socket.
fn thrown_values_end_at_the_handler() {
  let srv = Http.server()
  srv.get("/object", |req| throw {kind: 'ValueError', message: 'plain'})
  srv.get("/string", |req| throw 'boom')
  srv.get("/stream", fn (req) {
    {stream: fn (sink) {
      sink.write('partial')
      throw 'mid-stream'
    }}
  })
  srv.ws("/ws", |req, ws| throw 'in a socket')
  srv.get("/caught", fn (req) {
    try {
      1 / 0
    } catch e {
      e.kind
    }
  })
  let port = srv.listen_async(0, workers: 1)
  let at = "127.0.0.1:{port}"
  let next_catch = || Http.get("http://{at}/caught").body

  for path, said in {'/object': 'plain', '/string': 'boom'} {
    let thrown = Http.get("http://{at}{path}")
    assert_eq(thrown.status, 500, path)
    assert_eq(thrown.body, said, path)
    assert_eq(next_catch(), 'ZeroDivisionError', path)
  }

  assert_throws('HttpError', || Http.get("http://{at}/stream"))
  assert_eq(next_catch(), 'ZeroDivisionError', 'stream')

  let socket = Http.ws("ws://{at}/ws")
  assert_eq(socket.receive(), nil)
  socket.close()
  assert_eq(next_catch(), 'ZeroDivisionError', 'ws')
  srv.stop()
}
thrown_values_end_at_the_handler()

# --- bind / serve as separate steps. serve() needs a bound socket, bind() is
# once-only, and listen() includes a bind — each mis-sequencing is a catchable
# HttpError naming what is wrong, not a crash or a hang.
ssrv = Http.server()
ssrv.get("/", fn (req) {
  "split"
})
mut unbound = "none"
try {
  ssrv.serve_async()
} catch e {
  unbound = e.message
}
assert_eq(unbound, 'server.serve_async: Http: server is not bound (call bind(port) first)')

# A rejected serve leaves the recorded routes alone — the same handle can serve
# them afterwards (below). Both backends must agree on that, so a failed attempt
# neither consumes the records nor half-installs their trampolines.
SPORT = ssrv.bind(0)
mut rebound = "none"
try {
  ssrv.bind(0)
} catch e {
  rebound = e.message
}
assert_eq(rebound, 'server.bind: Http: server already bound')
mut relisten = "none"
try {
  ssrv.listen_async(0)
} catch e {
  relisten = e.message
}
assert_eq(relisten, 'server.listen_async: Http: server already bound')

# Routes registered after bind still take effect — bind only opens the socket.
ssrv.get("/late", fn (req) {
  "registered after bind"
})
ssrv.serve_async(workers: 2)
SBASE = "http://127.0.0.1:" + SPORT.to_string()
assert_eq(Http.get(SBASE + "/").body, 'split')
assert_eq(Http.get(SBASE + "/late").body, 'registered after bind')
ssrv.stop()

# A failed bind leaves the handle usable, so "try the next port" works. (cpp-httplib
# decommissions the server on a failed bind and then refuses every later one, so
# this only holds because http_server_bind clears that.)
fsrv = Http.server()
fsrv.get("/", fn (req) {
  "recovered"
})
mut firstbind = "none"
try {
  fsrv.bind(0, "192.0.2.1")
} catch e {
  firstbind = e.kind
}
FPORT = fsrv.bind(0)
fsrv.serve_async(workers: 2)
assert_eq(firstbind +
  " | " +
  Http.get("http://127.0.0.1:" + FPORT.to_string() + "/").body, 'HttpError | recovered')
fsrv.stop()

# A missing or wrong-typed port is rejected the same way on bind and listen
# (these unwind through the handle-method path, so they also pin its refcounting).
fn error_kind(f) {
  return try {
    f()
    "none"
  } catch e {
    e.kind
  }
}
esrv = Http.server()
assert_eq(error_kind(fn () {
  esrv.bind()
}), 'ArityError')
assert_eq(error_kind(fn () {
  esrv.bind("80")
}), 'TypeError')
assert_eq(error_kind(fn () {
  esrv.listen()
}), 'ArityError')
assert_eq(error_kind(fn () {
  esrv.serve_async(workers: "4")
}), 'TypeError')

# A port outside 0..65535 is a ValueError on bind / listen / listen_async, not
# a port the socket layer wrapped it to (bind(70000) used to bind 4464 and
# still return 70000). It is refused before any bind, so the server stays usable.
fn error_message(f) {
  return try {
    f()
    "none"
  } catch e {
    e.kind + ": " + e.message
  }
}
for p in [-1, 65536, 70000, 1 << 32] {
  let refusal = "port must be between 0 and 65535, got {p}"
  assert_eq(error_message(fn () {
    esrv.bind(p)
  }), "ValueError: server.bind: {refusal}")
  assert_eq(error_message(fn () {
    esrv.listen(p)
  }), "ValueError: server.listen: {refusal}")
  assert_eq(error_message(fn () {
    esrv.listen_async(p)
  }), "ValueError: server.listen_async: {refusal}")
}
assert_eq(esrv.bind(0) > 0, true)
esrv.close()

# A method is a token. CR/LF in one ended the request line early and smuggled
# a second request onto the connection: the server answered it, and the client
# read that answer as its own. A method that is not a token is a ValueError
# naming it, raised before anything is sent -- it used to surface, once
# refused, as a failed write the program could not tell from a network fault.
# A header with CR/LF is refused by the transport as before, and without then
# waiting on a response that is never coming (that wait was the server's idle
# close, about five seconds). Neither refusal does I/O past the connect, so the
# bound below has three orders of magnitude of slack. /smuggled answers 418,
# so a smuggled request would show as "none" below.
msrv = Http.server()
msrv.get("/", fn (req) {
  "ok"
})
msrv.get("/smuggled", fn (req) {
  {status: 418, body: "smuggled"}
})
msrv.get("/badheader", fn (req) {
  {status: 200, headers: {"X-Foo": "bar\r\nX-Injected: evil"}, body: "hi"}
})
msrv.get("/badcontenttype", fn (req) {
  {status: 200, content_type: "text/plain\r\nX-Injected: evil", body: "hi"}
})
MPORT = msrv.listen_async(0, "127.0.0.1", workers: 1)
MURL = "http://127.0.0.1:" + MPORT.to_string()
SMUGGLE = "GET /smuggled HTTP/1.1\r\nHost: x\r\n\r\nGET"
fn refused_at_once(kind, f) {
  let t0 = Time.monotonic()
  assert_eq(error_kind(f), kind)
  assert_true(Time.monotonic() - t0 < 2.0)
}
refused_at_once("ValueError", fn () {
  Http.request(SMUGGLE, MURL + "/")
})
refused_at_once("HttpError", fn () {
  Http.get(MURL + "/", headers: {"X-Bad": "a\r\nInjected: b"})
})
mapi = Http.client(MURL)
refused_at_once("ValueError", fn () {
  mapi.request(SMUGGLE, "/")
})
assert_eq(mapi.get("/").body, "ok")

# Every non-token is refused the same way, the empty method included (read as
# nothing, not as GET), and the message shows it with its control characters
# visible. Case is kept: `get` is a token of its own and goes out as written.
for bad in ["", "GE T", " GET", "GE\tT", "GÉT"] {
  refused_at_once("ValueError", fn () {
    Http.request(bad, MURL + "/")
  })
}
assert_eq(error_message(fn () {
  mapi.request("GET\r\nX: y", "/")
}), "ValueError: client.request: method must be an HTTP token, got \"GET\\r\\nX: y\"")
assert_eq(error_kind(fn () {
  Http.request("get", MURL + "/")
}), "none")

# A response header goes out verbatim too: httplib used to accept it and
# silently drop the header (still answering 200), which read to a handler as
# "the header I set is just missing" rather than as a rejected value. Setting
# one is now checked before it ever reaches httplib, turning the handler's
# return into the same 500 a thrown error gets -- so nothing gets smuggled and
# nothing looks like it merely went missing.
hres = mapi.get("/badheader")
assert_eq(hres.status, 500)
assert_eq(hres.body,
  "Http.server: header \"X-Foo\" must not contain control characters, got " +
  "\"bar\\r\\nX-Injected: evil\"")
assert_true(!hres.headers.has("X-Foo"))
assert_true(!hres.headers.has("X-Injected"))

# content_type reaches the response through a second path -- httplib's own
# set_content sets the Content-Type header internally -- so it is checked the
# same way, not left as a gap the headers: field's check doesn't reach.
ctres = mapi.get("/badcontenttype")
assert_eq(ctres.status, 500)
assert_eq(ctres.body,
  "Http.server: header \"Content-Type\" must not contain control characters, " +
  "got \"text/plain\\r\\nX-Injected: evil\"")
assert_true(!ctres.headers.has("X-Injected"))

mapi.close()
msrv.stop()

# A handler that streams itself: the response's closure is the very handler
# the worker holds, so both pin it. The stream letting go must not unpin it
# for the worker, or a collection frees the handler it still calls.
fn streams_itself(x) {
  if x.has('method') {
    return {stream: streams_itself}
  }
  x.write('chunk')
  nil
}
let ssrv = Http.server()
ssrv.get('/s', streams_itself)
# What frees it is a collection the allocations start (GC.stat()'s alone does
# not), so the handler allocates; none of it is kept, or every collection under
# CULEBRA_GC_STRESS walks a heap growing to 20000 pairs.
ssrv.get('/gc', fn (req) {
  for i in range(20000) {
    [i, "{i}"]
  }
  GC.stat()
  'gc'
})
let sport = ssrv.listen_async(0, workers: 1)
for _ in range(0, 5) {
  assert_eq(Http.get("http://127.0.0.1:{sport}/s").body, 'chunk')
  assert_eq(Http.get("http://127.0.0.1:{sport}/gc").body, 'gc')
}
ssrv.stop()
