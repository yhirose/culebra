# Http.server — v0 single-threaded HTTP server. The server blocks in listen(),
# so it runs in an Isolate (its own thread + runtime) while the main thread
# drives requests through the existing Http client over loopback. Dropping the
# isolate handle sets its interrupt flag, which the server's accept loop polls
# and stops on — giving a clean, deterministic shutdown. Output is identical
# across interp/JIT (no random or timing-dependent values are printed).

PORT = 18799
BASE = "http://127.0.0.1:" + PORT.to_string()

iso = Isolate.spawn(fn() {
  let srv = Http.server()
  srv.get("/", fn(req) { "Hello, world!" })
  srv.get("/users/:id", fn(req) { "user " + req.params["id"] })
  srv.post("/echo", fn(req) { req.body })
  srv.get("/q", fn(req) { "name=" + req.query["name"] })
  srv.get("/method", fn(req) { req.method })
  srv.get("/json", fn(req) {
    { status: 201, body: '{"ok":true}', content_type: "application/json",
      headers: { "X-Test": "yes" } }
  })
  srv.get("/empty", fn(req) { nil })
  # Malformed response objects: a wrong-typed field is a TypeError → 500, with
  # an identical message across interp/JIT (the trampoline puts e.what() in the
  # body). These lock the apply-response type checks symmetric.
  srv.get("/bad_status", fn(req) { { status: "x" } })
  srv.get("/bad_ct", fn(req) { { body: "ok", content_type: 9 } })
  srv.get("/bad_body", fn(req) { { body: 9 } })
  srv.get("/bad_hdr", fn(req) { { body: "ok", headers: { "A": 1 } } })
  # Streaming (chunked / SSE): the handler returns an Object with a `stream`
  # Function. The provider runs on this worker thread and hands the closure a
  # `sink` whose .write(chunk) pushes one chunk. status/content_type/headers
  # apply as usual; body + stream is a TypeError → 500.
  srv.get("/count", fn(req) {
    { stream: fn(sink) { for i in 0..5 { sink.write(i.to_string() + ",") } } }
  })
  srv.get("/sse", fn(req) {
    { status: 202, content_type: "text/event-stream",
      headers: { "Cache-Control": "no-cache" },
      stream: fn(sink) {
        for i in 0..3 { sink.write("data: " + i.to_string() + "\n\n") }
      } }
  })
  srv.get("/stream_both", fn(req) {
    { body: "x", stream: fn(sink) { sink.write("y") } }
  })
  srv.get("/stream_bad", fn(req) { { stream: 42 } })
  srv.listen(PORT)
})

# Retry until the server thread has bound the port.
fn wait_get(p) {
  mut a = 0
  while a < 200 {
    mut r = nil
    try { r = Http.get(BASE + p) } catch e { r = nil }
    if r != nil { return r }
    a = a + 1
  }
  return nil
}

r = wait_get("/")
inspect("GET / -> " + r.status.to_string() + " | " + r.body)

r2 = Http.get(BASE + "/users/42")
inspect("route param -> " + r2.status.to_string() + " | " + r2.body)

r3 = Http.post(BASE + "/echo", body: "payload-123")
inspect("POST echo -> " + r3.status.to_string() + " | " + r3.body)

r4 = Http.get(BASE + "/q", params: { name: "alice" })
inspect("query -> " + r4.status.to_string() + " | " + r4.body)

r5 = Http.get(BASE + "/method")
inspect("method -> " + r5.body)

r6 = Http.get(BASE + "/json")
inspect("object return -> " + r6.status.to_string() + " | " + r6.body +
     " | ct=" + r6.headers["Content-Type"] + " | x=" + r6.headers["X-Test"])

r7 = Http.get(BASE + "/empty")
inspect("nil return -> " + r7.status.to_string() + " | len=" + r7.body.size().to_string())

r8 = Http.get(BASE + "/missing")
inspect("unmatched -> " + r8.status.to_string())

for bad in ["/bad_status", "/bad_ct", "/bad_body", "/bad_hdr"] {
  let rb = Http.get(BASE + bad)
  inspect(bad + " -> " + rb.status.to_string() + " | " + rb.body)
}

# Streaming: the client buffers the reassembled chunked body.
rc = Http.get(BASE + "/count")
inspect("stream count -> " + rc.status.to_string() + " | " + rc.body)

rs = Http.get(BASE + "/sse")
inspect("stream sse -> " + rs.status.to_string() + " | ct=" +
     rs.headers["Content-Type"] + " | cc=" + rs.headers["Cache-Control"] +
     " | bytes=" + rs.body.size().to_string())

for sb in ["/stream_both", "/stream_bad"] {
  let rsb = Http.get(BASE + sb)
  inspect(sb + " -> " + rsb.status.to_string() + " | " + rsb.body)
}

iso.drop()
inspect("server stopped")

# --- Concurrent worker pool (workers > 1): each worker thread gets its own
# runtime with the handlers rebuilt onto it (so they must be Sendable), giving
# true parallel request handling. Parallel.map preserves input order, so the
# output is deterministic across backends.
PORT2 = 18856
BASE2 = "http://127.0.0.1:" + PORT2.to_string()
iso2 = Isolate.spawn(fn() {
  let srv = Http.server()
  srv.get("/sq/:n", fn(req) {
    let n = to_long(req.params["n"])
    (n * n).to_string()
  })
  srv.listen(PORT2, workers: 4)
})
fn wait2(p) {
  mut a = 0
  while a < 200 {
    mut r = nil
    try { r = Http.get(BASE2 + p) } catch e { r = nil }
    if r != nil { return r }
    a = a + 1
  }
  return nil
}
wait2("/sq/0")
squares = Parallel.map([1, 2, 3, 4, 5, 6, 7, 8], fn(i) {
  Http.get(BASE2 + "/sq/" + i.to_string()).body
})
inspect("concurrent squares: " + squares.to_string())
iso2.drop()
inspect("pool stopped")

# --- A non-Sendable handler is rejected at listen(workers>1) with SendError,
# before binding — surfaced identically across backends.
bad = Http.server()
mut hits = 0
bad.get("/", fn(req) { hits = hits + 1; "x" })
try {
  bad.listen(18857, workers: 2)
} catch e {
  inspect("non-sendable handler -> " + e.kind)
}
bad.close()

# Port-free checks: handle methods chain (return the handle), and close is
# idempotent. These never bind a socket.
srv2 = Http.server()
chained = srv2.get("/a", fn(req) { "a" }).post("/b", fn(req) { "b" })
inspect("chaining returns handle -> " + (chained == srv2).to_string())
srv2.close()
srv2.close()
inspect("double close ok")

# --- WebSocket: a ws handler runs a long-lived loop over the connection. The
# server echoes (for-in form) and greets (explicit receive + req access); the
# client connects with Http.ws and the same handle shape drives both. A separate
# route pushes messages then returns, which the client drains with for-in. Under
# a worker pool so each connection occupies its own worker.
WPORT = 18902
WBASE = "ws://127.0.0.1:" + WPORT.to_string()
wiso = Isolate.spawn(fn() {
  let srv = Http.server()
  srv.ws("/echo", fn(req, ws) {
    for msg in ws { ws.send("echo:" + msg) }
  })
  srv.ws("/greet", fn(req, ws) {
    while true {
      let m = ws.receive()
      if m == nil { break }
      ws.send(req.path + ":" + m)
    }
  })
  srv.ws("/push", fn(req, ws) {
    mut i = 0
    while i < 3 { ws.send("p" + i.to_string()); i = i + 1 }
  })
  srv.listen(WPORT, workers: 2)
})

fn ws_connect(p) {
  mut a = 0
  while a < 200 {
    mut c = nil
    try { c = Http.ws(WBASE + p) } catch e { c = nil }
    if c != nil { return c }
    a = a + 1
  }
  return nil
}

we = ws_connect("/echo")
we.send("one")
inspect("ws echo -> " + we.receive())
we.send("two")
inspect("ws echo -> " + we.receive() + " | open=" + we.is_open().to_string())
we.close()

wg = Http.ws(WBASE + "/greet")
wg.send("hi")
inspect("ws greet -> " + wg.receive())
wg.close()

# Concurrent ws echoes, one client (isolate) each — Parallel.map keeps order.
wmany = Parallel.map([1, 2, 3, 4], fn(i) {
  let c = Http.ws(WBASE + "/echo")
  c.send(i.to_string())
  let r = c.receive()
  c.close()
  r
})
inspect("ws pool -> " + wmany.to_string())

# Client drains server-pushed messages with for-in (ends when the server closes).
wp = Http.ws(WBASE + "/push")
mut pushed = []
for m in wp { pushed.push(m) }
inspect("ws pushed -> " + pushed.to_string())

# A bad URL is an HttpError.
mut werr = "none"
try { Http.ws("ws://127.0.0.1:1/nope") } catch e { werr = e.kind }
inspect("ws bad connect -> " + werr)

wiso.drop()
inspect("ws stopped")

# --- listen_async + stop: a background server with no isolate wrapper. The
# server serves on its own thread while the main thread drives requests, then
# stop() halts it cross-thread and joins. listen_async always runs handlers on a
# worker pool (off this thread), so they must be Sendable.
APORT = 18920
ABASE = "http://127.0.0.1:" + APORT.to_string()
asrv = Http.server()
asrv.get("/", fn(req) { "async-hi" })
asrv.get("/sq/:n", fn(req) { let n = to_long(req.params["n"]); (n * n).to_string() })
asrv.listen_async(APORT, workers: 2)      # returns immediately

fn await_get(p) {
  mut a = 0
  while a < 200 {
    mut r = nil
    try { r = Http.get(ABASE + p) } catch e { r = nil }
    if r != nil { return r }
    a = a + 1
  }
  return nil
}
ar = await_get("/")
inspect("listen_async GET / -> " + ar.status.to_string() + " | " + ar.body)
inspect("listen_async route -> " + Http.get(ABASE + "/sq/9").body)
# A server is single-use: starting it again (even on a free port) is a catchable
# error, not a crash/hang — serve again with a fresh Http.server().
mut reerr = "none"
try { asrv.listen_async(18923) } catch e { reerr = e.kind }
inspect("listen_async twice -> " + reerr)
asrv.stop()                                # cross-thread stop + join
inspect("async stopped")
mut reerr2 = "none"
try { asrv.listen_async(18924) } catch e { reerr2 = e.kind }
inspect("relisten after stop -> " + reerr2)

# After stop the port is free: a fresh server binds and serves it.
asrv2 = Http.server()
asrv2.get("/", fn(req) { "rebound" })
asrv2.listen_async(APORT)
inspect("rebind -> " + await_get("/").body)
asrv2.stop()

# A non-Sendable handler is rejected at listen_async (it runs off this thread).
abad = Http.server()
mut acount = 0
abad.get("/", fn(req) { acount = acount + 1; "x" })
try {
  abad.listen_async(18921)
} catch e {
  inspect("async non-sendable -> " + e.kind)
}
abad.close()

# A bad bind (a host not on this machine) is an HttpError, reported synchronously.
abind = Http.server()
abind.get("/", fn(req) { "x" })
mut abinderr = "none"
try { abind.listen_async(18922, "192.0.2.1") } catch e { abinderr = e.kind }
inspect("async bind fail -> " + abinderr)
abind.close()
