# Conformance: §10 (class sugar, operator overloading, __str__,
# auto-reflection, static methods), §11. See docs/language.md §25.
#
# Class-sugar regression tests. Runs on both the tree interpreter and
# the JIT.

test_class_basic = fn () {
  class Car {
    new(mpr) { this.miles = 0; this.mpr = mpr }
    run(n)   { this.miles = this.miles + this.mpr * n }
    total()  { this.miles }
  }
  c = Car.new(5)
  c.run(1); c.run(2)
  assert_eq(c.total(), 15)
  assert_eq(c.class, 'Car')
}

test_class_default_ctor = fn () {
  class Empty {
    greet() { 'hi' }
  }
  e = Empty.new()
  assert_eq(e.greet(), 'hi')
  assert_eq(e.class, 'Empty')
}

test_class_independent_instances = fn () {
  class Car {
    new(mpr) { this.miles = 0; this.mpr = mpr }
    run(n)   { this.miles = this.miles + this.mpr * n }
    total()  { this.miles }
  }
  a = Car.new(10); b = Car.new(20)
  a.run(1); b.run(1)
  assert_true(a.total() == 10 && b.total() == 20)
}

test_class_chain = fn () {
  class Counter {
    new()  { this.n = 0 }
    bump() { this.n = this.n + 1; this }
    value(){ this.n }
  }
  k = Counter.new()
  k.bump().bump().bump()
  assert_eq(k.value(), 3)
}

test_class_match_tag = fn () {
  class Point { new(x, y) { this.x = x; this.y = y } }
  describe = fn (o) {
    match o {
      {class} if class == 'Point' => 'point',
      _ => 'other'
    }
  }
  assert_eq(describe(Point.new(0, 0)), 'point')
  assert_eq(describe({}), 'other')
}

test_op_overload = fn () {
  class Vec {
    new(x, y) { this.x = x; this.y = y }
    __add__(r) { Vec.new(this.x + r.x, this.y + r.y) }
    __sub__(r) { Vec.new(this.x - r.x, this.y - r.y) }
    __mul__(r) {
      match r {
        n: Long => Vec.new(this.x * n, this.y * n),
        _       => Vec.new(this.x * r.x, this.y * r.y)
      }
    }
    __neg__()  { Vec.new(-this.x, -this.y) }
    __eq__(r)  { this.x == r.x && this.y == r.y }
    __lt__(r)  {
      (this.x * this.x + this.y * this.y) < (r.x * r.x + r.y * r.y)
    }
  }
  a = Vec.new(1, 2)
  b = Vec.new(3, 4)

  s = a + b
  assert_true(s.x == 4 && s.y == 6)
  assert_eq((b - a).x, 2)
  assert_eq((a * 3).x, 3)                 # scalar scale
  assert_eq((a * b).y, 8)                 # element-wise
  assert_eq((-a).x, -1)

  assert_eq(a, Vec.new(1, 2))
  assert_ne(a, b)
  assert_lt(a, b)
  assert_le(a, Vec.new(1, 2))             # derives from __lt__ + __eq__
  assert_gt(b, a)
  assert_ge(b, Vec.new(3, 4))
}

test_pow_overload = fn () {
  class Wrapped {
    new(n) { this.n = n }
    __pow__(e) { Wrapped.new(this.n * e.n) }   # silly demo semantics
  }
  r = Wrapped.new(3) ** Wrapped.new(4)
  assert_eq(r.n, 12)
}

# `obj[k]` / `obj[k] = v` delegate to __index__ / __setindex__ on a class
# instance, so a user collection wrapper subscripts like a built-in.
test_subscript_overload = fn () {
  class Grid {
    new() { this.d = [10, 20, 30] }
    __index__(i)    { this.d[i] }
    __setindex__(i, v) { this.d[i] = v }     # exercises this.d[i] = v lvalue
  }
  g = Grid.new()
  assert_eq(g[0], 10)
  assert_eq(g[2], 30)
  g[1] = 99
  assert_eq(g[1], 99)
  assert_eq(g.d[1], 99)                       # the setter mutated the field
  g[2] += 5                                   # compound: read __index__, write __setindex__
  assert_eq(g[2], 35)

  # Non-integer keys route through the same hooks.
  class Bag {
    new() { this.m = {} }
    __index__(k)    { this.m[k] }
    __setindex__(k, v) { this.m[k] = v }
  }
  b = Bag.new()
  b["x"] = 1
  b["y"] = 2
  assert_eq(b["x"], 1)
  assert_eq(b["y"], 2)

  # Subscript overloading is a class-instance feature: a plain dict that
  # merely holds an `__index__` / `__setindex__` value treats them as
  # ordinary data, not hooks. `d[k]` misses -> KeyError; `d[k] = v` stores
  # a normal entry.
  let plain = { __index__: fn(i) { 999 } }
  mut threw = false
  try { let _ = plain[5] } catch e { threw = true }
  assert_true(threw)
  mut store = { __setindex__: fn(k, v) { 0 } }
  store["z"] = 42
  assert_eq(store["z"], 42)
}

test_auto_reflect = fn () {
  class Vec {
    new(x, y) { this.x = x; this.y = y }
    __add__(r) {
      match r {
        n: Long => Vec.new(this.x + n, this.y + n),
        _       => Vec.new(this.x + r.x, this.y + r.y)
      }
    }
    __mul__(r) {
      match r {
        n: Long => Vec.new(this.x * n, this.y * n),
        _       => Vec.new(this.x * r.x, this.y * r.y)
      }
    }
    __eq__(r) { this.x == r.x && this.y == r.y }
  }
  v = Vec.new(3, 4)
  a = 2 * v                          # Long * Vec reflects to v.__mul__(2)
  assert_true(a.x == 6 && a.y == 8)
  b = 10 + v                         # Long + Vec reflects to v.__add__(10)
  assert_true(b.x == 13 && b.y == 14)
  # Equality reflection (Object RHS)
  assert_eq(v, Vec.new(3, 4))
  assert_eq(Vec.new(3, 4), v)
}

test_matmul_overload = fn () {
  class Mat {
    new(data) { this.data = data }
    __matmul__(r) {
      mut out = []
      for i in 0..this.data.size() {
        mut row = []
        for j in 0..r.data[0].size() {
          mut s = 0
          for k in 0..r.data.size() {
            s = s + this.data[i][k] * r.data[k][j]
          }
          row.push(s)
        }
        out.push(row)
      }
      Mat.new(out)
    }
  }
  a = Mat.new([[1, 2], [3, 4]])
  b = Mat.new([[5, 6], [7, 8]])
  c = a @ b
  assert_true(c.data[0][0] == 19 && c.data[0][1] == 22)
  assert_true(c.data[1][0] == 43 && c.data[1][1] == 50)
  # Chains left-associatively (same precedence as *).
  d = a @ b @ a
  assert_eq(d.data[0][0], 19 + 66)
}

test_str_special = fn () {
  class Matrix {
    new(r, c) { this.rows = r; this.cols = c }
    __str__()  { "Matrix {this.rows}x{this.cols}" }
  }
  m = Matrix.new(2, 3)

  # to_string picks up __str__
  assert_eq(to_string(m), 'Matrix 2x3')

  # String interpolation picks it up too
  assert_eq("shape: {m}", 'shape: Matrix 2x3')

  # Object without __str__ falls back to the default formatter
  plain = {a: 1, b: 2}
  assert_eq(to_string(plain), '{a: 1, b: 2}')
}

test_default_display = fn () {
  # Class-sugar instance: `class:` tag is hoisted to a prefix, and
  # omitted from the property list to avoid repetition.
  class Point { new(x, y) { this.x = x; this.y = y } }
  p = Point.new(3, 4)
  assert_eq(to_string(p), 'Point {mut x: 3, mut y: 4}')

  # Plain literals using the `class:` convention get the same treatment.
  tagged = {class: 'Tag', x: 10}
  assert_eq(to_string(tagged), 'Tag {x: 10}')

  # A non-String `class` field is treated as a regular property.
  weird = {class: 42, x: 1}
  assert_eq(to_string(weird), '{class: 42, x: 1}')

  # Untagged Object is unchanged.
  plain = {a: 1, b: 2}
  assert_eq(to_string(plain), '{a: 1, b: 2}')
}

# `this` is immutable inside the constructor body. interp and JIT
# both raise ImmutableError when user code attempts `this = newObj`,
# matching Java/Crystal/Ruby. Identity-swap factories live as plain
# top-level functions instead (see samples/drop.cul guideline).
test_this_immutable_in_ctor = fn () {
  class C {
    new () {
      let r = try { this = {hijacked: true}; "no error" }
                catch e { "kind={e.kind}" }
      this.result = r
    }
  }
  c = C.new()
  assert_eq(c.result, 'kind=ImmutableError')
  # The original instance survives; the would-be replacement is discarded.
  assert_false(c.has('hijacked'))
}

# Constructor return value is always the allocated instance regardless
# of an explicit `return` inside the body.
test_ctor_return_ignored = fn () {
  class C {
    new () {
      this.tag = 'allocated'
      return {tag: 'returned'}
    }
  }
  c = C.new()
  assert_eq(c.tag, 'allocated')
}

# `static` methods live on the class object itself (not the instance),
# providing class-as-namespace. Resolved via standard property access
# (Shape.create(...)) on both backends.
test_static_methods = fn () {
  class Shape {
    new () {}
    static make_circle (r) {
      let s = Shape.new()
      s.kind = 'circle'
      s.radius = r
      s
    }
    area () {
      if this.kind == 'circle' { 3 * this.radius * this.radius } else { 0 }
    }
  }
  let circle = Shape.make_circle(4)
  assert_eq(circle.kind, 'circle')
  assert_eq(circle.area(), 48)
  # Static methods are *not* on the instance.
  let inst_call_kind = try { circle.make_circle(1); 'no error' }
                       catch e { "kind={e.kind}" }
  assert_true(inst_call_kind == 'kind=AttributeError' ||
         inst_call_kind == 'kind=TypeError')
}

# Multiple statics + interop with the regular constructor.
test_static_multiple = fn () {
  class Counter {
    new (start) { this.n = start }
    bump () { this.n = this.n + 1; this }
    static zero () { Counter.new(0) }
    static from_array (arr) { Counter.new(arr.size()) }
  }
  let a = Counter.zero()
  let b = Counter.from_array([1, 2, 3])
  assert_eq(a.n, 0)
  assert_eq(b.n, 3)
  a.bump().bump()
  assert_eq(a.n, 2)
  assert_eq(b.n, 3)
}

test_class_basic()
test_class_default_ctor()
test_class_independent_instances()
test_class_chain()
test_class_match_tag()
test_op_overload()
test_subscript_overload()
test_pow_overload()
test_auto_reflect()
test_matmul_overload()
test_str_special()
test_default_display()
test_this_immutable_in_ctor()
test_ctor_return_ignored()
test_static_methods()
test_static_multiple()

puts('class-sugar OK')

# --- A throwing static initializer is catchable; execution continues --------
# The JIT used to emit the class declaration's runtime calls as invokes
# targeting the ENCLOSING function's landingpad from inside the synthesized
# constructor fn (emit_constructor_fn saved only the insert point, not the
# full per-function state) — invalid IR that crashed the optimizer whenever
# a class was declared inside a `try`.
fn test_class_decl_throw_catchable() {
  let r = try {
    class ThrowingInit {
      static v = to_long('x')
      m() { 1 }
    }
    'no error'
  } catch e { e.kind }
  assert_eq(r, 'TypeError')
}
test_class_decl_throw_catchable()

puts('class-sugar throw-catch OK')

# --- Declared instance fields (`x: T = e`) ----------------------------------
# Initializers run per instance — declaration order, `this` in scope, after
# the ctor args bind, before the `new` body (Kotlin's model). The JIT used
# to drop typed fields entirely (every declared field read nil).

fn test_field_defaults() {
  class P {
    x: Long = 5
    y: Float = 2.5
    s: String = 'hi'
    b: Bool = true
    a: Array = [1, 2]
  }
  let p = P.new()
  assert_eq(p.x, 5)
  assert_eq(p.y, 2.5)
  assert_eq(p.s, 'hi')
  assert_eq(p.b, true)
  assert_eq(p.a, [1, 2])
}
test_field_defaults()

fn test_field_zero_values() {
  class Z {
    n: Long
    f: Float
    s: String
    b: Bool
    arr: Array
  }
  let z = Z.new()
  assert_eq(z.n, 0)
  assert_eq(z.f, 0.0)
  assert_eq(z.s, '')
  assert_eq(z.b, false)
  assert_eq(z.arr, nil)
}
test_field_zero_values()

fn test_field_per_instance() {
  # A mutable default is evaluated per instance — no Python-style sharing.
  class Box {
    items: Array = []
  }
  let a = Box.new()
  let b = Box.new()
  a.items.push(1)
  assert_eq(a.items, [1])
  assert_eq(b.items, [])
}
test_field_per_instance()

fn test_field_this_and_order() {
  # Declaration order; `this` sees earlier fields and methods.
  let base = 100
  class K {
    a: Long = base + 1
    b: Long = this.a * 2
    c: Long = this.calc()
    calc() { this.a + this.b }
  }
  let k = K.new()
  assert_eq(k.a, 101)
  assert_eq(k.b, 202)
  assert_eq(k.c, 303)
}
test_field_this_and_order()

fn test_field_before_new_body() {
  class N {
    x: Long = 5
    new(m) { this.y = this.x * m }
  }
  assert_eq(N.new(10).y, 50)
}
test_field_before_new_body()

fn test_field_mutable_in_methods() {
  class C {
    n: Long = 0
    bump() { this.n = this.n + 1 }
  }
  let c = C.new()
  c.bump(); c.bump()
  assert_eq(c.n, 2)
}
test_field_mutable_in_methods()

fn test_field_captures_enclosing() {
  # A class declared inside a fn: field inits capture enclosing locals and
  # stay live after the fn returns.
  fn make(start) {
    class Counter {
      n: Long = start * 10
    }
    Counter
  }
  let C = make(5)
  assert_eq(C.new().n, 50)
}
test_field_captures_enclosing()

fn test_field_init_throw_at_construction() {
  # A throwing initializer fires at construction (catchable), not at the
  # class declaration.
  class Boom {
    x: Long = to_long('nope')
  }
  let r = try { Boom.new(); 'no error' } catch e { e.kind }
  assert_eq(r, 'TypeError')
}
test_field_init_throw_at_construction()

fn test_field_init_after_arg_binding() {
  # Initializers run only once the ctor args bound successfully: an arity
  # error fires first, with no field side effects (interp/JIT symmetric).
  mut ran = 0
  fn noisy() { ran = ran + 1; 1 }
  class A {
    x: Long = noisy()
    new(a, b) { this.s = a + b }
  }
  let r = try { A.new(1); 'built' } catch e { e.kind }
  assert_eq(r, 'ArityError')
  assert_eq(ran, 0)
  A.new(1, 2)
  assert_eq(ran, 1)
}
test_field_init_after_arg_binding()

puts('class-fields OK')
