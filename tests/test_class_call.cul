// Class objects are callable: `C(args)` constructs an instance, dispatching
// to the class's `new` constructor. `C(args)` is exactly `C.new(args)`.

// --- basic construction ---
class Point {
  new(x, y) {
    self.x = x
    self.y = y
  }
  sum() {
    self.x + self.y
  }
}
let p = Point(3, 4)
assert_eq(p.x, 3)
assert_eq(p.y, 4)
assert_eq(p.sum(), 7)
// identical to .new
assert_eq(Point(3, 4).sum(), Point.new(3, 4).sum())

// --- default (no explicit `new`) constructor ---
class Empty {
  greet() {
    "hi"
  }
}
assert_eq(Empty().greet(), "hi")

// --- keyword arguments forward to `new` ---
class Config {
  new(host, port = 80) {
    self.host = host
    self.port = port
  }
}
let c = Config("localhost", port: 8080)
assert_eq(c.host, "localhost")
assert_eq(c.port, 8080)
assert_eq(Config("h").port, 80)
assert_eq(Config(port: 9, host: "x").port, 9)

// --- callable class composes: chaining, higher-order use ---
class Adder {
  new(n) {
    self.n = n
  }
  add(x) {
    self.x = x
    self.n + x
  }
}
assert_eq(Adder(10).add(5), 15)
let makers = [Point, Empty]
assert_eq(makers[0](1, 2).sum(), 3)

// a class flows as a callable through an untyped parameter
fn apply0(f) {
  f()
}
assert_eq(apply0(Empty).greet(), "hi")

// MVP boundary (symmetric across interp/JIT): a class object does NOT
// satisfy the `Function` type used by higher-order builtins — `map(Cls)` is
// a clean TypeError on both backends. Use `map(|x| Cls(x))` instead. Frozen
// here so a future relaxation is a deliberate, symmetric change.
let mut map_threw = false
try {
  let _ = [1, 2, 3].map(Point)
} catch e {
  map_threw = true
}
assert_eq(map_threw, true)

// --- a plain dict holding a "new" key stays NON-callable ---
let fake = {new: fn (x) {
  x + 1
}}
let mut threw = false
try {
  fake(5)
} catch e {
  threw = true
}
assert_eq(threw, true)
// its `new` member is still an ordinary callable field
assert_eq(fake.new(5), 6)

// --- arity error from `new` surfaces normally ---
let mut bad = false
try {
  Point(1)
} catch e {
  bad = true
}
assert_eq(bad, true)

// --- native classes construct the same way as `class` ones ---
// A wrapped class (wrap.h) with a registered ctor is callable, so the rule
// has no exceptions: anything with a documented `.new(...)` also answers to
// `X(...)`. Instances are native handles compared by identity, so the two
// spellings are equivalent in what they build, not in `==`.
assert_eq(type_of(CodeGen.Module()), type_of(CodeGen.Module.new()))
assert_eq(CodeGen.Module() == CodeGen.Module.new(), false)
assert_eq(type_of(__Foreign.Box(4)), type_of(__Foreign.Box.new(4)))
assert_eq(type_of(CodeGen.Resolver()), type_of(CodeGen.Resolver.new()))

// A builtin namespace whose own `new` is a factory answers too — without
// becoming a class (see the type_of block below).
let (tx, rx) = Channel()
tx.send(7)
assert_eq(rx.recv(), 7)
assert_eq(type_of(Shared(42)), "Object")

// Both spellings reject keyword arguments identically: a wrapped ctor
// declares parameter names but takes positionals only. Frozen so the
// sugar can never drift from `.new` on this.
let mut kw_sugar = false
try {
  let _ = __Foreign.Box(start: 4)
} catch e {
  kw_sugar = true
}
let mut kw_new = false
try {
  let _ = __Foreign.Box.new(start: 4)
} catch e {
  kw_new = true
}
assert_eq(kw_sugar, kw_new)
assert_eq(kw_sugar, true)

// The `Function` boundary above holds for native classes too.
let mut map_native = false
try {
  let _ = [1].map(CodeGen.Module)
} catch e {
  map_native = true
}
assert_eq(map_native, true)

// --- what is a class, and what merely constructs ---
// A type reports 'Class'; a namespace stays 'Object' even though calling it
// now works. A wrapped class with no ctor is a handle you get from a
// factory, so it is neither callable nor a class.
assert_eq(type_of(CodeGen.Module), "Class")
assert_eq(type_of(__Foreign.Box), "Class")
assert_eq(type_of(Channel), "Object")
assert_eq(type_of(Math), "Object")
assert_eq(type_of(CodeGen.Program), "Object")

// A namespace with no `new` is unchanged: same TypeError as before.
let mut ns_threw = false
try {
  Math()
} catch e {
  ns_threw = true
}
assert_eq(ns_threw, true)
let mut noctor = false
try {
  CodeGen.Program()
} catch e {
  noctor = true
}
assert_eq(noctor, true)

// Lazy preamble modules are ordinary object literals tagged as namespaces
// after the fact, so a `new:` key added to one would silently make it
// constructible. None has one today — frozen here so that is a decision.
for ns in [Time, Term, Canvas, Args, Regex, PEG, FST, Log, Desktop] {
  assert_eq(ns.has("new"), false)
}

// Constructing through the sugar hands the class object over as the
// receiver exactly as `.new` does, so it must not accumulate references
// either (test_ns_receiver_rc.cul covers the ABI contract itself).
let rc_base = GC.refcount(CodeGen.Module)
for _ in range(200) {
  CodeGen.Module()
}
assert_eq(GC.refcount(CodeGen.Module), rc_base)

inspect("test_class_call ok")
