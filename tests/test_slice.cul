// Range slicing: seq[a..b] / seq[a..=b] / open-ended seq[a..] / seq[..b] /
// seq[..]. Array -> shallow copy, String/StringView -> byte-unit view,
// Tuple -> tuple. Ranges are first-class values.

let xs = [10, 20, 30, 40, 50]

// --- Array: exclusive / inclusive / empty ---
assert_eq(xs[1..3], [20, 30])
assert_eq(xs[1..=3], [20, 30, 40])
assert_eq(xs[0..0], [])
assert_eq(xs[2..2], [])

// --- Array: negative indices ---
assert_eq(xs[1..-1], [20, 30, 40])
assert_eq(xs[-3..-1], [30, 40])
assert_eq(xs[-2..=-1], [40, 50])

// --- Array: out-of-range clamp / reversed -> empty ---
assert_eq(xs[1..100], [20, 30, 40, 50])
assert_eq(xs[2..1], [])
assert_eq(xs[10..20], [])

// --- inclusive end at LONG_MAX clamps to len (no signed overflow) ---
assert_eq(xs[0..=9223372036854775807], [10, 20, 30, 40, 50])
assert_eq(xs[0..=-100], [])

// --- Array: shallow copy is independent of source mutation ---
mut ys = [10, 20, 30]
let sl = ys[0..2]
ys[0] = 999
assert_eq(sl, [10, 20])

// --- Array: slice is a normal array (methods, chaining) ---
assert_eq(xs[1..4].size(), 3)
assert_eq(xs[1..4][0..2], [20, 30])
let g = [10, 20, 30, 40][1..3]
g.push(99)
assert_eq(g, [20, 30, 99])

// --- String: byte-unit view ---
assert_eq("hello"[1..3], "el")
assert_eq("hello"[0..2], "he")
assert_eq("hello"[1..=3], "ell")
assert_eq("hello"[2..100], "llo")
assert_eq(""[0..3], "")
assert_eq("hello world"[0..5][1..3], "el")

// --- String: byte unit (UTF-8 multibyte: あ=3 bytes each) ---
assert_eq("あいう"[0..3], "あ")
assert_eq("あいう"[3..6], "い")
assert_eq("あいう"[0..6], "あい")

// --- Tuple: slice returns a tuple ---
assert_eq((10, 20, 30, 40)[1..3], (20, 30))

// --- Open-ended ranges: open start -> 0, open end -> length ---
assert_eq(xs[2..], [30, 40, 50])
assert_eq(xs[..3], [10, 20, 30])
assert_eq(xs[..], [10, 20, 30, 40, 50])
assert_eq(xs[..=2], [10, 20, 30])
assert_eq(xs[-2..], [40, 50])
assert_eq(xs[..-2], [10, 20, 30])
assert_eq("hello"[2..], "llo")
assert_eq("hello"[..2], "he")
assert_eq("hello"[..], "hello")
// the motivating case: drop the header line
assert_eq(["head", "a", "b", "c"][1..], ["a", "b", "c"])

// --- Range as a first-class value (stored, passed, used in subscript) ---
let r = 1..3
assert_eq(xs[r], [20, 30])
let ropen = 2..
assert_eq(xs[ropen], [30, 40, 50])
fn drop_first(seq) {
  seq[1..]
}
assert_eq(drop_first(xs), [20, 30, 40, 50])

// --- for-in over a bounded range (.. and ..=) ---
mut s1 = 0
for i in 1..4 {
  s1 = s1 + i
}
assert_eq(s1, 6)
mut s2 = 0
for i in 1..=4 {
  s2 = s2 + i
}
assert_eq(s2, 10)

// --- range repr (source form) ---
assert_eq("{1..3}", "1..3")
assert_eq("{2..}", "2..")
assert_eq("{..3}", "..3")
assert_eq("{..}", "..")
assert_eq("{1..=3}", "1..=3")

// --- GC: tight-loop slicing must not leak ---
let big = []
for i in 0..1000 {
  big.push(i)
}
mut acc = 0
for r in 0..2000 {
  acc = acc + big[10..20].size()
}
assert_eq(acc, 20000)

// Stored-range slicing (`xs[r]`) must release the range value each pass.
let g0 = GC.stat().live_objects
for n in 0..3000 {
  let rng = 5..15
  acc = acc + big[rng].size()
}
assert_eq(GC.stat().live_objects - g0 < 200, true)

// --- range values compare structurally (the `class` slot is a real
// header-backed string; this used to segfault the JIT's `==` walk) ---
assert_eq((1..3) == (1..3), true)
assert_eq((1..3) == (1..=3), false)
assert_eq([1..2] == [1..2], true)
let req = 4..6
assert_eq(req.class, "Range")
assert_eq(req.class == "Range", true)

inspect("slice ok")
