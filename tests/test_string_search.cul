// String search + split family: index_of / last_index_of / strip_prefix /
// strip_suffix / split(limit) / rsplit / split_whitespace / split_once /
// rsplit_once / replace_first.

// --- index_of / last_index_of ---------------------------------------
// Byte offsets, -1 when absent (Array.index_of's convention).
assert_eq("hello world".index_of("o"), 4)
assert_eq("hello world".index_of("o", 5), 7)
assert_eq("hello world".last_index_of("o"), 7)
assert_eq("hello world".index_of("z"), -1)
assert_eq("hello world".last_index_of("z"), -1)
// start past the end finds nothing; a negative start counts from the end
assert_eq("abc".index_of("a", 99), -1)
assert_eq("abcabc".index_of("a", -3), 3)
assert_eq("abc".index_of("a", -99), 0)
// an empty needle matches at the start, as contains("") is true
assert_eq("abc".index_of(""), 0)
assert_eq("abc".last_index_of(""), 3)
// multibyte: the answer is a byte offset, like slice's indices
assert_eq("aé b".index_of("b"), 4)
assert_eq("aé b".slice(4, 5), "b")
// a StringView receiver searches its own bytes, not the source's
assert_eq("xxabc".slice(2, 5).index_of("a"), 0)
// Array.index_of keeps its own meaning at the same name
assert_eq([1, 2, 3].index_of(2), 1)
assert_eq([1, 2, 3].index_of(9), -1)
// ...and its own arity: the String-only `start` is not an Array argument
assert_throws("ArityError", || [1, 2].index_of(1, 0))

// --- strip_prefix / strip_suffix ------------------------------------
assert_eq("foobar".strip_prefix("foo"), "bar")
assert_eq("foobar".strip_suffix("bar"), "foo")
// not there -> unchanged (no error)
assert_eq("foobar".strip_prefix("xxx"), "foobar")
assert_eq("foobar".strip_suffix("xxx"), "foobar")
// matches the whole affix once, unlike trim_start's scalar set
assert_eq("foofoobar".strip_prefix("foo"), "foobar")
assert_eq("foofoobar".trim_start("fo"), "bar")
// an affix equal to the receiver empties it; an empty affix is a no-op
assert_eq("abc".strip_prefix("abc"), "")
assert_eq("abc".strip_prefix(""), "abc")
// an affix longer than the receiver never matches
assert_eq("ab".strip_prefix("abc"), "ab")

// --- split(limit) / rsplit ------------------------------------------
assert_eq("a.b.c".split("."), ["a", "b", "c"])
assert_eq("a.b.c".split(".", 2), ["a", "b.c"])
assert_eq("a.b.c".rsplit(".", 2), ["a.b", "c"])
// limit 1 yields the receiver whole; 0 (the default) is uncapped
assert_eq("a.b.c".split(".", 1), ["a.b.c"])
assert_eq("a.b.c".split(".", 0), ["a", "b", "c"])
// a limit above the piece count changes nothing
assert_eq("a.b.c".split(".", 99), ["a", "b", "c"])
// without a limit the two directions agree
assert_eq("a.b.c".rsplit("."), "a.b.c".split("."))
// empty pieces are kept, as in split
assert_eq("a..b".split(".", 2), ["a", ".b"])
assert_eq("a..b".rsplit(".", 2), ["a.", "b"])
// an empty separator never splits
assert_eq("abc".split("", 2), ["abc"])
assert_throws("ValueError", || "a.b".split(".", -1))
assert_throws("ValueError", || "a.b".rsplit(".", -1))

// --- split_whitespace -----------------------------------------------
// runs collapse and the ends yield no empty piece, unlike split(" ")
assert_eq("  a  b ".split_whitespace(), ["a", "b"])
assert_eq("  a  b ".split(" ").size(), 6)
assert_eq("a\tb\nc".split_whitespace(), ["a", "b", "c"])
assert_eq("".split_whitespace(), [])
assert_eq("   ".split_whitespace(), [])
// Unicode whitespace counts too (U+3000 IDEOGRAPHIC SPACE)
assert_eq("a\u3000b".split_whitespace(), ["a", "b"])

// --- split_once / rsplit_once ---------------------------------------
// the halves around the first (last) separator, or nil
assert_eq("a=b=c".split_once("="), ("a", "b=c"))
assert_eq("a=b=c".rsplit_once("="), ("a=b", "c"))
assert_eq("abc".split_once("="), nil)
assert_eq("abc".rsplit_once("="), nil)
// a separator at either end yields an empty half
assert_eq("=b".split_once("="), ("", "b"))
assert_eq("a=".split_once("="), ("a", ""))
// an empty separator never splits, matching split("")
assert_eq("abc".split_once(""), nil)
// multi-byte separators consume their whole width
assert_eq("a::b::c".split_once("::"), ("a", "b::c"))

// --- replace_first ---------------------------------------------------
assert_eq("a.b.c".replace_first(".", "-"), "a-b.c")
assert_eq("a.b.c".replace(".", "-"), "a-b-c")
// no match -> unchanged
assert_eq("abc".replace_first("x", "y"), "abc")
// a Regex pattern replaces its first match
assert_eq("a1b22c".replace_first(re'\d+', "#"), "a#b22c")
// a StringView pattern is literal, like a String one
assert_eq("a.b.c".replace_first(".".view(), "-"), "a-b.c")

IO.inspect("test_string_search OK")
