# Conformance: §19 (grid), §18 (the non-terminal Iterator methods). See
# docs/language.md §25. The for-in protocol and range are in test_iter.cul.

# --- grid(x_range, y_range): cartesian-product iterator, x fastest ---
assert_eq(
  grid(0..3, 0..2).collect(),
  [(0, 0), (1, 0), (2, 0), (0, 1), (1, 1), (2, 1)],
)

# Inclusive ranges, negative step, single cell.
assert_eq(grid(0..=1, 5..=6).collect(), [(0, 5), (1, 5), (0, 6), (1, 6)])
assert_eq(grid(2..=0 by -1, 0..1).collect(), [(2, 0), (1, 0), (0, 0)])
assert_eq(grid(5..=5, 7..=7).collect(), [(5, 7)])

# Either side empty → the whole product is empty.
assert_eq(grid(0..0, 0..3).collect(), [])
assert_eq(grid(0..3, 0..0).collect(), [])
assert_eq(grid(0..0, 0..0).collect(), [])

# `for (x, y) in grid(...)` destructures directly.
mut cells = []
for (x, y) in grid(0..2, 0..2) {
  cells.push(x + y)
}
assert_eq(cells, [0, 1, 1, 2])

# Non-Range arguments raise the same TypeError both backends give any
# Parameter-annotated arg (grid()'s declared signature).
assert_throws("TypeError", fn () {
  grid(1, 2..3)
})
assert_throws("TypeError", fn () {
  grid(1..2, 3)
})

# Wrong arity: 'grid' takes 2 arguments, matching the builtin-method
# arity-error wording (see try_compile_core_global in jit.h).
assert_throws("ArityError", fn () {
  grid(1..2)
})
assert_throws("ArityError", fn () {
  grid(1..2, 3..4, 5..6)
})

# Unbounded / zero-step ranges raise the same errors range()'s own
# consumers do (range_bounds() / culebra_runtime_range_iter).
assert_throws("TypeError", fn () {
  grid(1.., 3..4)
})
assert_throws("ValueError", fn () {
  grid(1..2 by 0, 3..4)
})

# --- Phase 3: non-terminal Iterator methods ---

# map
r1 = [1, 2, 3].iter().map(fn (x) {
  x * 10
}).collect()
assert_eq(r1.size(), 3)
assert_true(r1[0] == 10 && r1[2] == 30)

# filter
r2 = range(10).filter(fn (x) {
  x % 3 == 0
}).collect()
assert_eq(r2.size(), 4)
assert_true(r2[0] == 0 && r2[3] == 9)

# take — lazy: never touches the 1M elements beyond index 3
r3 = range(1000000).take(3).collect()
assert_eq(r3.size(), 3)
assert_true(r3[0] == 0 && r3[2] == 2)

# skip
r4 = range(10).skip(7).collect()
assert_eq(r4.size(), 3)
assert_true(r4[0] == 7 && r4[2] == 9)

# take_while
r5 = range(20).take_while(fn (x) {
  x < 5
}).collect()
assert_eq(r5.size(), 5)
assert_true(r5[0] == 0 && r5[4] == 4)

# chunks: last group may be shorter
assert_eq([1, 2, 3, 4, 5].iter().chunks(2).collect(), [[1, 2], [3, 4], [5]])
assert_eq(range(6).chunks(3).collect(), [[0, 1, 2], [3, 4, 5]])
assert_eq([].iter().chunks(2).collect(), [])
try {
  [1].iter().chunks(0).collect()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}

# windows: sliding, full windows only
assert_eq(
  [1, 2, 3, 4, 5].iter().windows(3).collect(),
  [[1, 2, 3], [2, 3, 4], [3, 4, 5]],
)
assert_eq([1, 2].iter().windows(3).collect(), [])
try {
  [1].iter().windows(-1).collect()
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}

# chain
r6 = [1, 2].iter().chain([3, 4]).collect()
assert_eq(r6.size(), 4)
assert_true(r6[0] == 1 && r6[3] == 4)

# zip: stops at shorter side
r7 = [1, 2, 3, 4].iter().zip([10, 20]).collect()
assert_eq(r7.size(), 2)
assert_true(r7[0].first == 1 && r7[0].second == 10)
assert_true(r7[1].first == 2 && r7[1].second == 20)

# enumerate yields (index, value) tuples
r8 = ['a', 'b'].iter().enumerate().collect()
assert_eq(r8, [(0, 'a'), (1, 'b')])

# flat_map
r9 = [[1, 2], [], [3]].iter().flat_map(fn (xs) {
  xs
}).collect()
assert_eq(r9.size(), 3)
assert_true(r9[0] == 1 && r9[1] == 2 && r9[2] == 3)
