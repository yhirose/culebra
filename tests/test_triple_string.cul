// Triple-quoted strings `"""..."""`: multi-line, interpolated like
// `"..."`, but single/double quotes need no escaping. (Single-quote
// `'...'` remains the raw, no-escape form.)

let name = "Alice"

// Interpolation works.
assert_eq("""Hello {name}!""", "Hello Alice!")

// Embedded quotes need no escaping.
let q = """She said "hi" and 'bye'."""
assert_eq(q, "She said \"hi\" and 'bye'.")

// Multi-line.
let prompt = """line one
line two"""

assert_eq(prompt, "line one\nline two")

// Escapes decode; `\{` is a literal open brace (`}` needs no escape).
assert_eq("""tab\tend""", "tab\tend")
assert_eq("""a \{b} c""", "a \{b} c")

// Interpolation + embedded quotes + a literal brace (LLM-prompt shape).
let role = "assistant"
let msg = """role: "{role}", brace: \{x}"""
assert_eq(msg, "role: \"assistant\", brace: \{x}")

// Single-quote raw is unchanged (regex literal).
assert_eq('\d+', "\\d+")

// --- Swift-style block form ---
// When the opening `"""` is followed by a newline, the leading/trailing
// newlines are dropped and each line is dedented by the indentation of the
// closing `"""`.
let html = """
    <html>
    </html>
    """

assert_eq(html, "<html>\n</html>")

// Interpolation inside a block; relative indentation is preserved.
let block = """
    Hello {name}
      indented more
    """

assert_eq(block, "Hello Alice\n  indented more")

// Blank lines are normalized to empty (their whitespace is not significant).
let para = """
    a

    c
    """

assert_eq(para, "a\n\nc")

// A block with only the delimiter lines is the empty string.
assert_eq("""
    """, "")

// Inline form is unaffected: content on the opening line is raw (no dedent),
// so the historical single-line and inline-multiline shapes still work.
assert_eq("""Hello {name}!""", "Hello Alice!")
assert_eq("""line one
line two""", "line one\nline two")

IO.inspect("test_triple_string OK")
