// C-style ternary `cond ? a : b`.

assert_eq(true ? 1 : 2, 1)
assert_eq(false ? 1 : 2, 2)

// Truthiness mirrors `if`: false and zero are falsy, nonzero is truthy
// (nil as a condition is a TypeError, exactly as `if nil` would be).
assert_eq(0 ? "t" : "f", "f")
assert_eq(5 ? "t" : "f", "t")

// Precedence: below `||`/`&&`/comparison, above assignment.
assert_eq(1 == 1 || false ? "a" : "b", "a")   // (1==1||false) ? "a" : "b"
x = 3 > 0 ? 10 : 20                            // = binds looser than ?:
assert_eq(x, 10)

// `??` binds tighter than `?:`.
assert_eq(nil ?? 7 ? "nz" : "zz", "nz")        // (nil ?? 7) is truthy

// Right-associative: a ? b : c ? d : e  ==  a ? b : (c ? d : e)
fn sign(n) { n > 0 ? "pos" : n < 0 ? "neg" : "zero" }
assert_eq(sign(5), "pos")
assert_eq(sign(-5), "neg")
assert_eq(sign(0), "zero")

// The ternary `:` does not collide with kwarg / dict `:`.
fn pick(a, label) { "{label}:{a}" }
assert_eq(pick(true ? 1 : 2, label: false ? "P" : "N"), "N:1")
d = {k: 3 > 0 ? "hi" : "lo"}
assert_eq(d["k"], "hi")

// Inside string interpolation and array literals.
assert_eq("v={true ? 1 : 0}", "v=1")
assert_eq([true ? 1 : 2, false ? 3 : 4], [1, 4])

// Branches can be arbitrary expressions (calls, nested ternaries).
fn f(n) { n * 2 }
assert_eq(true ? f(3) : f(9), 6)
