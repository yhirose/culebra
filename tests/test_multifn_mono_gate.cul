// A `fn name` with one overload reaches its body without consulting the
// overload table. That shortcut used to be withdrawn the moment a parameter
// carried an annotation, because the body's own entry check reports a
// mismatch differently from the picker: `TypeError: parameter 'n' expects
// Long` at the argument, against `DispatchError: no matching method` at the
// call. The shortcut is now gated instead — on the argument tags where the
// annotation's tags decide it, on the picker's own score where they do not —
// so a matching call takes it and everything else still goes to the picker.
//
// What this file pins is that the gate is invisible. The two errors are told
// apart by their message, so asserting the message is what catches a gate that
// let a mismatched argument through to the body.

fn only(n: Long) {
  "long:{n}"
}
assert_eq(only(3), 'long:3')

// A mismatch is the picker's error, not the body's.
mut e = nil
try {
  only('x')
} catch ex {
  e = ex
}
assert_eq(e.kind, 'DispatchError')
assert_eq(e.message, 'no matching method for `only`')

// So is an arity the one overload does not accept.
mut e2 = nil
try {
  only(1, 2)
} catch ex {
  e2 = ex
}
assert_eq(e2.kind, 'DispatchError')
assert_eq(e2.message, 'no matching method for `only`')

// --- annotations no tag decides: the gate scores them as the picker does,
// so they match what the picker matches and refuse what it refuses.

// `Float` does not admit a Long, and the gate must not widen it.
fn onlyf(x: Float) {
  'float'
}
assert_eq(onlyf(3.5), 'float')
mut e3 = nil
try {
  onlyf(3)
} catch ex {
  e3 = ex
}
assert_eq(e3.kind, 'DispatchError')

// A class name: an Object tag says nothing about which class.
class Box {
  new(v) {
    self.v = v
  }
}
fn takesbox(b: Box) {
  'box'
}
assert_eq(takesbox(Box(1)), 'box')
mut e4 = nil
try {
  takesbox(3)
} catch ex {
  e4 = ex
}
assert_eq(e4.kind, 'DispatchError')

// `Function` admits a class instance with `__call__`, so the tag is not the
// whole answer and the gate scores it as the picker does.
class Callable {
  __call__(a) {
    a
  }
}
fn takesfn(f: Function) {
  'fn'
}
assert_eq(takesfn(Callable()), 'fn')
assert_eq(takesfn(fn (a) {
  a
}), 'fn')

// Optional and union spellings.
fn opt(x: Long?) {
  'opt'
}
assert_eq(opt(1), 'opt')
assert_eq(opt(nil), 'opt')

fn uni(x: Long | String) {
  'uni'
}
assert_eq(uni(1), 'uni')
assert_eq(uni('s'), 'uni')

// --- shapes where the arguments do not line up with the annotations one to
// one, which is why the gate declines them outright.

fn withdef(a: Long, b: Long = 2) {
  a + b
}
assert_eq(withdef(1), 3)
assert_eq(withdef(1, 5), 6)

fn variadic(a: Long, *rest) {
  a + rest.size()
}
assert_eq(variadic(1), 1)
assert_eq(variadic(1, 9, 9), 3)

// --- a second overload withdraws the shortcut; both still dispatch.
fn two(n: Long) {
  'long'
}
fn two(s: String) {
  'string'
}
assert_eq(two(1), 'long')
assert_eq(two('s'), 'string')
mut e5 = nil
try {
  two(1.5)
} catch ex {
  e5 = ex
}
assert_eq(e5.kind, 'DispatchError')

// --- the other tag-exact annotations, so the table in
// _jit_tag_exactly_matching is exercised rather than trusted.
fn s_(x: String) {
  'S'
}
fn b_(x: Bool) {
  'B'
}
fn a_(x: Array) {
  'A'
}
fn t_(x: Tuple) {
  'T'
}
fn n_(x: Nil) {
  'N'
}
assert_eq(s_('x'), 'S')
assert_eq(b_(true), 'B')
assert_eq(a_([1]), 'A')
assert_eq(t_((1, 2)), 'T')
assert_eq(n_(nil), 'N')

// --- scored annotations: an argument the picker refuses is still its
// DispatchError, however close it comes (another class, nil, a variant of the
// wrong arm, an error of another kind).
fn no_match(f) {
  try {
    f()
    'ran'
  } catch ex {
    "{ex.kind}: {ex.message}"
  }
}
class Other {}
assert_eq(no_match(|| takesbox(Other())), 'DispatchError: no matching method for `takesbox`')
assert_eq(no_match(|| takesbox(nil)), 'DispatchError: no matching method for `takesbox`')

fn anyv(x: Any) {
  'any'
}
assert_eq([anyv(nil), anyv(1), anyv(Box(1))], ['any', 'any', 'any'])

fn objv(x: Object) {
  'obj'
}
assert_eq([objv({a: 1}), objv(Box(1))], ['obj', 'obj'])
assert_eq(no_match(|| objv(1)), 'DispatchError: no matching method for `objv`')

// `Function` takes an instance the scorer cannot tell from a callable; the
// body's check is what refuses it, as it was before the gate.
assert_eq(no_match(|| takesfn(Other())), "TypeError: type error: parameter 'f' expects Function")

fn boxlong(x: Box | Long) {
  'boxlong'
}
assert_eq([boxlong(Box(1)), boxlong(2)], ['boxlong', 'boxlong'])
assert_eq(no_match(|| boxlong('s')), 'DispatchError: no matching method for `boxlong`')

fn optbox(x: Box?) {
  'optbox'
}
assert_eq([optbox(nil), optbox(Box(1))], ['optbox', 'optbox'])
assert_eq(no_match(|| optbox(1)), 'DispatchError: no matching method for `optbox`')

enum Res { Ok(Any), Err(Any) }
fn res(r: Res) {
  'res'
}
fn okv(r: Ok) {
  'ok'
}
fn qual(r: Res.Ok) {
  'qual'
}
assert_eq([res(Res.Ok(1)), res(Res.Err(1)), okv(Res.Ok(1)), qual(Res.Ok(1))],
  ['res', 'res', 'ok', 'qual'])
assert_eq(no_match(|| res(1)), 'DispatchError: no matching method for `res`')
assert_eq(no_match(|| okv(Res.Err(1))), 'DispatchError: no matching method for `okv`')
assert_eq(no_match(|| qual(Res.Err(1))), 'DispatchError: no matching method for `qual`')

let te = try {
  1 + 'a'
} catch ex {
  ex
}
let ze = try {
  1 / 0
} catch ex {
  ex
}
fn terr(e: TypeError) {
  'terr'
}
assert_eq(terr(te), 'terr')
assert_eq(no_match(|| terr(ze)), 'DispatchError: no matching method for `terr`')

fn mixed(a: Box, b: Long) {
  'mixed'
}
assert_eq(mixed(Box(1), 2), 'mixed')
assert_eq(no_match(|| mixed(Box(1), 'x')), 'DispatchError: no matching method for `mixed`')
assert_eq(no_match(|| mixed(Other(), 2)), 'DispatchError: no matching method for `mixed`')

// A trait scores from a conformance cache the picker fills; while it is cold
// the gate declines, so both answers stay the picker's.
trait Named {
  name()
}
class Named1 {
  name() {
    'n'
  }
}
fn named(x: Named) {
  'named'
}
assert_eq(named(Named1()), 'named')
assert_eq(named(Named1()), 'named')  // the cache is warm now: the gate admits
assert_eq(no_match(|| named(Other())), 'DispatchError: no matching method for `named`')

// A name that becomes a trait after the first call: refused while it names
// nothing, taken once the trait it names is declared.
class Speaker {
  speak() {
    'hi'
  }
}
fn talk(x: Talker) {
  'talked'
}
assert_eq(no_match(|| talk(Speaker())), 'DispatchError: no matching method for `talk`')
let declare_talker = fn () {
  trait Talker {
    speak()
  }
  nil
}
declare_talker()
assert_eq(talk(Speaker()), 'talked')

// --- the interned annotation's own reading (culebra::TypeAnnotation): what
// its tags and names settle must be what the picker and the entry check say.

// Built-in alternatives only: a value outside them is refused outright.
assert_eq(no_match(|| uni(1.5)), 'DispatchError: no matching method for `uni`')
assert_eq(no_match(|| opt(1.5)), 'DispatchError: no matching method for `opt`')
fn arrl(x: Array<Long>) {
  'arrl'
}
assert_eq(arrl([1]), 'arrl')
assert_eq(no_match(|| arrl((1, 2))), 'DispatchError: no matching method for `arrl`')

// A function type takes a closure by its tag and a callable instance by the
// text.
fn apply1(f: fn(Long) -> Long) {
  f(1)
}
assert_eq([apply1(|x| x + 1), apply1(Callable())], [2, 1])
assert_eq(no_match(|| apply1(1)), 'DispatchError: no matching method for `apply1`')

// An enum's name beside a built-in type, and a variant's name.
fn reslong(x: Res | Long) {
  'reslong'
}
assert_eq([reslong(Res.Err(1)), reslong(3)], ['reslong', 'reslong'])
assert_eq(no_match(|| reslong(Box(1))), 'DispatchError: no matching method for `reslong`')
fn okornil(x: Ok?) {
  'okornil'
}
assert_eq([okornil(Res.Ok(1)), okornil(nil)], ['okornil', 'okornil'])
assert_eq(no_match(|| okornil(Res.Err(1))), 'DispatchError: no matching method for `okornil`')

// The checks that are not a gate's read the same annotation: a return value
// and an assignment.
fn made_box(v) -> Box? {
  v
}
assert_eq(made_box(nil), nil)
assert_eq(made_box(Box(1)).v, 1)
assert_eq(no_match(|| made_box(Other())), 'TypeError: type error: return value expects Box?')
assert_eq(no_match(fn () { let y: Box | Long = 'x' }),
  'TypeError: type error: assignment expects Box | Long')
