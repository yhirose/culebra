# Conformance: §10 (auto-synthesized parameters()). See docs/language.md §25.
#
# Auto-synthesized class.parameters() — works on both interp and JIT.
#
# Every class instance gets a built-in `parameters()` method that
# walks its fields and returns a flat Array of class-instance Values.
# Arrays of any depth are descended; plain Object dict literals
# (no class: tag) are descended into; class instances are leaves.
# Property keys starting with '_' (cache or private fields) are
# skipped. A user-defined parameters() method takes precedence.

# --- Basic: scalar fields + class-instance fields ---

class V {
  new(d) {
    self.data = d
    self.grad = 0.0
  }
}

class M1 {
  new() {
    self.a = V.new(1.0)
    self.b = V.new(2.0)
    self.scalar = 42  # not a class instance — should be skipped
  }
}

let m1 = M1.new()
let p1 = m1.parameters()
assert_eq(p1.size(), 2)
# Iteration order is sorted-by-key (std::map): a, b. scalar is Long, skipped.
assert_eq(p1[0].data, 1.0)
assert_eq(p1[1].data, 2.0)

# --- Nested Array of class instances ---

class M2 {
  new() {
    self.row = [V.new(10.0), V.new(20.0), V.new(30.0)]
  }
}

let m2 = M2.new()
let p2 = m2.parameters()
assert_eq(p2.size(), 3)
assert_eq(p2[0].data, 10.0)
assert_eq(p2[2].data, 30.0)

# --- Array of Array (matrix shape) ---

class M3 {
  new() {
    self.W = [[V.new(1.0), V.new(2.0)], [V.new(3.0), V.new(4.0)]]
  }
}

let m3 = M3.new()
let p3 = m3.parameters()
assert_eq(p3.size(), 4)
assert_eq(p3[0].data, 1.0)
assert_eq(p3[3].data, 4.0)

# --- Plain dict literal (no class: tag) is descended ---

class M4 {
  new() {
    self.state = {x: V.new(7.0), y: V.new(8.0)}
  }
}

let m4 = M4.new()
let p4 = m4.parameters()
assert_eq(p4.size(), 2)
# Sorted by key: x then y.
assert_eq(p4[0].data, 7.0)
assert_eq(p4[1].data, 8.0)

# --- Underscore fields are skipped ---

class M5 {
  new() {
    self.a = V.new(1.0)
    self._cache = V.new(99.0)  # leading underscore — skipped
    self._visited = false      # also skipped
  }
}

let m5 = M5.new()
let p5 = m5.parameters()
assert_eq(p5.size(), 1)
assert_eq(p5[0].data, 1.0)

# --- User-defined parameters() takes precedence ---

class M6 {
  new() {
    self.a = V.new(100.0)
    self.b = V.new(200.0)
  }
  parameters() {
    [self.a]
  }  # explicit override: only `a` is trainable
}

let m6 = M6.new()
let p6 = m6.parameters()
assert_eq(p6.size(), 1)
assert_eq(p6[0].data, 100.0)

# --- SGD-shaped usage: mutating the leaves through the returned Array ---

class M7 {
  new() {
    self.W = [[V.new(0.5), V.new(1.5)]]
  }
}

let m7 = M7.new()
for p in m7.parameters() {
  p.data = p.data * 2.0
}
# Re-fetch parameters and check the underlying instances were mutated.
let after = m7.parameters()
assert_eq(after[0].data, 1.0)
assert_eq(after[1].data, 3.0)
# Original through the field path also sees the mutation (same Values).
assert_eq(m7.W[0][0].data, 1.0)
assert_eq(m7.W[0][1].data, 3.0)

# The synthesized method takes no parameters, and — like every other
# 0-parameter method — a surplus positional argument is evaluated and then
# ignored rather than turning the call into a member miss.
let arg_ran = fn () {
  arg_seen = arg_seen + 1
  9
}
mut arg_seen = 0
class Pw {
  new(a) { self.a = a }
}
assert_eq(to_string(Pw.new(1).parameters(arg_ran())), '[]')
assert_eq(to_string(Pw.new(1).parameters(1, 2)), '[]')
assert_eq(arg_seen, 1)

inspect("test_class_parameters: OK")
