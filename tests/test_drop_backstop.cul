# Phase 2-4: the GC backstop fires `drop` exactly once on resources whose
# owner was orphaned — the narrow residue deterministic scope-exit drop
# cannot reach (the "option 2 backstop", PEP 442 style).
#
# Closure-held cycles used to be a backstop case on both backends; the
# JIT now resolves them at scope exit (the owned walker follows closure
# captures, and a call site no longer leaks its callee ref), so cases
# 1/2/4/6 fire deterministically there. The interp's whole-env capture
# force-pins a self-captured env instead, so the same shapes fire at its
# next (precise) collection — the gc_settle below covers that, and the
# settled counts are exact on both backends. The remaining true backstop
# case is cyclic garbage discarded at the TOP LEVEL (a scope that never
# exits, case 5): there the JIT's CONSERVATIVE collector can retain an
# orphan for a whole run when a stale stack/register word happens to
# alias it, so only that case keeps an upper-bound tolerance. The hard
# assertions stay the SOUNDNESS ones (a drop never fires twice, never on
# a live resource); finalization order within one collection is
# unspecified (PEP 442).

# The JIT's conservative collector may retain an orphan across collections
# while a stale callee-saved register / stack word still looks like a
# pointer to it (rt_gc.h: completeness is best-effort). Two pieces of
# hygiene keep the observations deterministic on both backends: interleave
# real, register-churning work with a few collections (gc_settle), and run
# each case's mutating part inside a helper fn — its spills then live in a
# dead frame region below the collector's stack scan, instead of in the
# top-level frame that stays scanned forever. The interp (precise) fires
# on the first pass either way.
fn churn(n) {
  mut acc = []
  mut i = 0
  while i < n {
    acc.push('x' + i.to_string())
    i = i + 1
  }
  acc.size()
}
# Adaptive: collect until the expected number of drops landed (or a
# generous cap — a genuinely missing drop still fails the assert that
# follows). A fixed iteration count flakes: a stale word can survive
# several collections.
# `arr` is the current case's own event array: a LATE backstop fire from a
# prior case (conservatively retained past its own settle) pushes into that
# prior case's array, never into a later case's observations.
fn gc_settle(arr, want) {
  mut i = 0
  while i < 20 && arr.size() < want {
    churn(8)
    GC.stat()
    i = i + 1
  }
}

# --- 1) Closure-held cycle: `g` captures the scope that binds `res`. ---
let ev1 = []
make_lam = fn () {
  let res = {id: 'lam', drop: fn () {
    ev1.push('lam')
  }}
  let g = fn () {
    res.id
  }
  g()
}
fn run_lam() {
  {
    let _l = make_lam()
  }
  nil
}
run_lam()
gc_settle(ev1, 1)
assert_eq(ev1.size(), 1)  # exactly once (JIT: at scope exit;
for e in ev1 {
  assert_eq(e, 'lam')
}  # interp: at the settle's collect)

# --- 2) Nested `fn name` (multimethod) capturing a resource. ---
let ev2 = []
make_nf = fn () {
  let res = {id: 'nf', drop: fn () {
    ev2.push('nf')
  }}
  fn use_res() {
    res.id
  }
  use_res()
}
fn run_nf() {
  {
    let _n = make_nf()
  }
  nil
}
run_nf()
gc_settle(ev2, 1)
assert_eq(ev2.size(), 1)
for e in ev2 {
  assert_eq(e, 'nf')
}

# --- 3) Exactly-once: further collections must not re-fire. ---
let n3 = ev2.size()
gc_settle(ev2, n3 + 1)
assert_eq(ev2.size(), n3)

# --- 4) Several orphans in one collection: all fire, order unspecified. ---
let ev4 = []
make_each = fn (tag) {
  let res = {id: tag, drop: fn () {
    ev4.push(tag)
  }}
  fn use_res() {
    res.id
  }
  use_res()
}
fn run_each() {
  make_each('a')
  make_each('b')
  make_each('c')
  nil
}
run_each()
gc_settle(ev4, 3)
# Exact: the JIT fires each at its make_each exit, the interp at the
# settle's precise collect — neither depends on the conservative scan.
assert_eq(ev4.size(), 3)
let seen = ev4.sorted_by(|x| x)
mut prev = ''
for t in seen {
  assert_true(t != prev)  # no double-fire
  assert_true(t == 'a' || t == 'b' || t == 'c')
  prev = t
}

# --- 5) Top-level discarded object cycle (no enclosing scope ever exits).
# The bindings themselves are top-level; only the literal construction is
# wrapped so its temps don't pin the cycle from the immortal main frame.
let ev5 = []
mut a = nil
mut b = nil
fn build_pair() {
  a = {drop: fn () {
    ev5.push('ta')
  }}
  b = {drop: fn () {
    ev5.push('tb')
  }}
  a.other = b
  b.other = a
  nil
}
build_pair()
a = nil
b = nil
gc_settle(ev5, 2)
assert_true(ev5.size() <= 2)
let seen2 = ev5.sorted_by(|x| x)
mut prev2 = ''
for t in seen2 {
  assert_true(t != prev2)  # exactly-once per member
  assert_true(t == 'ta' || t == 'tb')
  prev2 = t
}

# --- 6) A LIVE resource must never be touched by the backstop, even when
# its holder sits next to garbage in the same collection.
let ev6 = []
let keeper = {drop: fn () {
  ev6.push('live')
}}
fn run_cyc() {
  {
    let cyc = {drop: fn () {
      ev6.push('dead')
    }, keep: keeper}
    cyc.me = cyc
  }
  nil
}
run_cyc()
# One unconditional collection: on the JIT `cyc` already dropped at the
# block's exit, so without this the "garbage next to a live holder"
# collection scenario would only ever run on the interp.
GC.stat()
gc_settle(ev6, 1)
for e in ev6 {
  assert_eq(e, 'dead')
}  # keeper must NEVER fire here
assert_eq(ev6.size(), 1)
let before = ev6.size()
keeper.drop()  # still alive and explicitly droppable
assert_eq(ev6.size(), before + 1)
assert_eq(ev6[before], 'live')
gc_settle(ev6, before + 2)
assert_eq(ev6.size(), before + 1)  # no re-fire of either
