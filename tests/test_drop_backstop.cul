# Phase 2-4: the GC backstop fires `drop` exactly once on resources whose
# owner was orphaned — the narrow residue deterministic scope-exit drop
# cannot reach (the "option 2 backstop", PEP 442 style).
#
# Closure-held cycles used to be a backstop case; the owned walker now
# follows closure captures (and a call site no longer leaks its callee
# ref), so cases 1/2/4/6 fire at scope exit, on both lanes. The remaining
# true backstop case is cyclic garbage discarded at the TOP LEVEL (a scope
# that never exits, case 5). `GC.stat()` finds its roots from the
# reference counts, so what it finalizes is exact on both lanes: every
# count below is asserted, not bounded. The soundness assertions stay as
# well (a drop never fires twice, never on a live resource);
# finalization order within one collection is unspecified (PEP 442).

# --- 1) Closure-held cycle: `g` captures the scope that binds `res`. ---
let ev1 = []
make_lam = fn () {
  let res = {id: 'lam', drop: fn () {
    ev1.push('lam')
  }}
  let g = fn () {
    res.id
  }
  g()
}
fn run_lam() {
  {
    let _l = make_lam()
  }
  nil
}
run_lam()
GC.stat()
assert_eq(ev1.size(), 1)  # exactly once, at the scope exit
for e in ev1 {
  assert_eq(e, 'lam')
}

# --- 2) Nested `fn name` (multimethod) capturing a resource. ---
let ev2 = []
make_nf = fn () {
  let res = {id: 'nf', drop: fn () {
    ev2.push('nf')
  }}
  fn use_res() {
    res.id
  }
  use_res()
}
fn run_nf() {
  {
    let _n = make_nf()
  }
  nil
}
run_nf()
GC.stat()
assert_eq(ev2.size(), 1)
for e in ev2 {
  assert_eq(e, 'nf')
}

# --- 3) Exactly-once: further collections must not re-fire. ---
let n3 = ev2.size()
GC.stat()
GC.stat()
assert_eq(ev2.size(), n3)

# --- 4) Several orphans in one collection: all fire, order unspecified. ---
let ev4 = []
make_each = fn (tag) {
  let res = {id: tag, drop: fn () {
    ev4.push(tag)
  }}
  fn use_res() {
    res.id
  }
  use_res()
}
fn run_each() {
  make_each('a')
  make_each('b')
  make_each('c')
  nil
}
run_each()
GC.stat()
assert_eq(ev4.size(), 3)  # each at its make_each exit
let seen = ev4.sorted_by(|x| x)
mut prev = ''
for t in seen {
  assert_true(t != prev)  # no double-fire
  assert_true(t == 'a' || t == 'b' || t == 'c')
  prev = t
}

# --- 5) Top-level discarded object cycle (no enclosing scope ever exits).
# The bindings themselves are top-level; only the literal construction is
# wrapped so its temps don't pin the cycle from the immortal main frame.
let ev5 = []
mut a = nil
mut b = nil
fn build_pair() {
  a = {drop: fn () {
    ev5.push('ta')
  }}
  b = {drop: fn () {
    ev5.push('tb')
  }}
  a.other = b
  b.other = a
  nil
}
build_pair()
a = nil
b = nil
GC.stat()
assert_eq(ev5.size(), 2)  # both members, at this collection
let seen2 = ev5.sorted_by(|x| x)
mut prev2 = ''
for t in seen2 {
  assert_true(t != prev2)  # exactly-once per member
  assert_true(t == 'ta' || t == 'tb')
  prev2 = t
}

# --- 6) A LIVE resource must never be touched by the backstop, even when
# its holder sits next to garbage in the same collection.
let ev6 = []
let keeper = {drop: fn () {
  ev6.push('live')
}}
fn run_cyc() {
  {
    let cyc = {drop: fn () {
      ev6.push('dead')
    }, keep: keeper}
    cyc.me = cyc
  }
  nil
}
run_cyc()
# `cyc` dropped at the block's exit; this collection sweeps its memory,
# which still holds the edge to the live keeper.
GC.stat()
for e in ev6 {
  assert_eq(e, 'dead')
}  # keeper must NEVER fire here
assert_eq(ev6.size(), 1)
let before = ev6.size()
keeper.drop()  # still alive and explicitly droppable
assert_eq(ev6.size(), before + 1)
assert_eq(ev6[before], 'live')
GC.stat()
assert_eq(ev6.size(), before + 1)  # no re-fire of either
