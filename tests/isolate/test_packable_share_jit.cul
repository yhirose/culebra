# C3 段階1.5: cross-isolate zero-copy sharing of a @packable SharedBuffer.
#
# A SharedBuffer handle crosses an isolate boundary by its hidden id (the
# backing bytes live in a process-global registry), so the child isolate
# reads/writes the SAME bytes — zero copy, no serialization of the data.
# Runs on interp and (via the _jit suffix) the JIT; both must agree.
#
# Run: ./build/culebra tests/isolate/test_packable_share_jit.cul
#      ./build/culebra --jit tests/isolate/test_packable_share_jit.cul

@packable
class Vec2 {
  x: Float32 = 0.0
  y: Float32 = 0.0
}

# --- Passed as an argument: child mutates, parent observes ------------------
let buf = SharedBuffer.new(2, Vec2)
buf[0].x = 1.0
Isolate.spawn(fn (b) {
  b[0].x = 99.0
  b[1].y = 7.0
}, buf).join()
assert_eq(buf[0].x, 99.0)
assert_eq(buf[1].y, 7.0)

# --- Captured by the closure: same sharing -----------------------------------
let buf2 = SharedBuffer.new(1, Vec2)
Isolate.spawn(fn () {
  buf2[0].x = 3.5
}).join()
assert_eq(buf2[0].x, 3.5)

# --- Parallel workers writing disjoint elements (no overlap → no race) -------
@packable
class Cell {
  v: Int64 = 0
}
let cells = SharedBuffer.new(8, Cell)
Parallel.each([0, 1, 2, 3, 4, 5, 6, 7], fn (i) {
  cells[i].v = i * i
})
mut total = 0
for i in 0..8 {
  total = total + cells[i].v
}
assert_eq(total, 140)  # 0+1+4+9+16+25+36+49

# --- Sent through a channel --------------------------------------------------
let cbuf = SharedBuffer.new(1, Cell)
let (tx, rx) = Channel.new(1)
Isolate.spawn(fn (t) {
  cbuf[0].v = 42
  t.send(1)
}, tx).join()
rx.recv()
assert_eq(cbuf[0].v, 42)

inspect("packable share ok")
