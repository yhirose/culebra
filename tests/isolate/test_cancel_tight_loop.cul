# Regression: a spawned isolate running a tight CPU loop (no channel / IO — only
# a loop backedge can act as a safepoint) must be cancellable via drop(). The JIT
# loop safepoint inlines a load of a process "wake" flag; before the fix it loaded
# only the global Ctrl+C flag, never the per-isolate `core->interrupt`, so drop()
# — which sets interrupt and waits for the isolate to finish — hung forever under
# --jit. Runs under interp + --jit (the justfile's `cul` timeout turns a
# regression into a fast failure instead of a hang).
let h = Isolate.spawn(fn () {
  mut i = 0
  while true {
    i = i + 1
  }
})
Time.sleep(0.05)
h.drop()  # cancel the still-spinning isolate; must return, not hang

# One left spinning when its program ends, with a handle nothing lets go of:
# the end of the run still cancels and joins it, on either engine. (The AOT
# sweep holds the same file's output to --vm's.)
for engine in ["--vm", "--jit"] {
  let r = Proc.run([
    Sys.executable,
    engine,
    "tests/test_isolate_left_running.cul",
  ])
  assert_eq(r.stdout, "the program ends\nthe isolate was stopped\n", engine)
}
inspect("test_cancel_tight_loop: passed")
