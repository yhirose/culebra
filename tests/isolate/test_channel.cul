# Channel (C2-a): bounded message passing between isolates.

# --- producer isolate streams into a channel; consumer drains via for-in ---
let (tx, rx) = Channel.new(4)
let prod = Isolate.spawn(fn () {
  for i in 1..6 {
    tx.send(i * 10)
  }
  tx.drop()  # release the sender copy so the channel can close
})
tx.drop()  # the parent's own sender copy — both must drop to close
mut got = []
for v in rx {
  got.push(v)
}
prod.join()
assert_eq(got, [10, 20, 30, 40, 50])

# --- explicit recv() returns values then nil once closed + drained ---
let (tx2, rx2) = Channel.new(2)
let p2 = Isolate.spawn(fn () {
  tx2.send("a")
  tx2.send("b")
  tx2.drop()
})
tx2.drop()
assert_eq(rx2.recv(), "a")
assert_eq(rx2.recv(), "b")
assert_eq(rx2.recv(), nil)  # closed + empty
p2.join()

# --- multi-producer via tx.clone(); fan-in sum ---
let (tx3, rx3) = Channel.new(8)
mut workers = []
for w in 0..3 {
  let mytx = tx3.clone()
  workers.push(Isolate.spawn(fn () {
    mytx.send(w + 1)
    mytx.drop()
  }))
}
tx3.drop()  # drop the original; clones keep it open
mut total = 0
for v in rx3 {
  total = total + v
}
for wk in workers {
  wk.join()
}
assert_eq(total, 6)  # 1 + 2 + 3

# --- backpressure: capacity-1 channel, producer outpaces consumer ---
let (tx4, rx4) = Channel.new(1)
let p4 = Isolate.spawn(fn () {
  for i in 0..5 {
    tx4.send(i)
  }
  tx4.drop()
})
tx4.drop()
mut sum4 = 0
for v in rx4 {
  sum4 = sum4 + v
}
p4.join()
assert_eq(sum4, 10)  # 0+1+2+3+4

# --- sending a structured value across the channel ---
let (tx5, rx5) = Channel.new(2)
let p5 = Isolate.spawn(fn () {
  tx5.send({id: 1, tags: ["a", "b"]})
  tx5.drop()
})
tx5.drop()
let rec = rx5.recv()
p5.join()
assert_eq(rec, {id: 1, tags: ["a", "b"]})

# --- dropping an isolate blocked on recv() unwinds it (interrupt-aware wait) ---
let (tx6, rx6) = Channel.new(1)
let blocked = Isolate.spawn(fn () {
  rx6.recv()
})              # blocks: no value is ever sent
blocked.drop()  # must not hang (reaching the
tx6.drop()      # final line proves it)

# --- an endpoint can itself be sent through a channel (the Sendable exception);
#     the refcount stays balanced (no leak / premature close) ---
let (ctrl_tx, ctrl_rx) = Channel.new(1)
let (data_tx, data_rx) = Channel.new(4)
ctrl_tx.send(data_tx)  # ship the data-sender over the control channel
ctrl_tx.drop()
data_tx.drop()                 # parent's original data sender
let moved_tx = ctrl_rx.recv()  # the rebuilt data-sender
moved_tx.send(42)
moved_tx.drop()
assert_eq(data_rx.recv(), 42)

# --- a producer that does NOT explicitly drop its tx still auto-closes: the
#     spawned closure's captured endpoint drops when the isolate finishes ---
let (atx, arx) = Channel.new(4)
let auto_prod = Isolate.spawn(fn () {
  atx.send(7)
  atx.send(8)
})          # no atx.drop()
atx.drop()  # only the parent drops explicitly
mut auto_got = []
for v in arx {
  auto_got.push(v)
}  # ends only if the channel actually closes
auto_prod.join()
assert_eq(auto_got, [7, 8])

# --- an endpoint is a handle onto its channel: it shows as one, has no
#     fields, compares by channel and role, and cannot be made from a dict ---
let (htx, hrx) = Channel.new(2)
let (otx, orx) = Channel.new(2)
let htx2 = htx.clone()
assert_eq("{htx} {hrx}", '[Channel tx] [Channel rx]')
assert_eq(htx.keys(), [])
assert_eq(JSON.stringify(htx), '{}')
assert_throws('TypeError', fn () { htx.id = 1 })
assert_throws('TypeError', fn () { for k in htx { k } })
assert_eq([htx == htx2, htx == otx, htx == hrx], [true, false, false])
otx.send({__channel_endpoint__: true, __channel_id__: 1, __channel_role__: 0})
assert_eq(orx.recv().send, nil)

# --- a dropped endpoint is a closed one, whatever its clones do ---
htx2.send(1)
htx.drop()
assert_eq("{htx}", '[dropped Channel tx]')
assert_eq(htx == htx2, false)
assert_throws('ChannelError', fn () { htx.send(2) })
assert_throws('ChannelError', fn () { htx.clone().send(2) })
assert_eq(hrx.recv(), 1)
htx2.drop()
assert_eq(hrx.recv(), nil)
hrx.drop()

# --- an endpoint left unread in a channel that goes away goes with it ---
let (ltx, lrx) = Channel.new(1)
otx.send(ltx.clone())
ltx.drop()
assert_eq("{lrx.try_recv()}", 'ChannelResult.Empty')
otx.drop()
orx.drop()
assert_eq("{lrx.try_recv()}", 'ChannelResult.Closed')
lrx.drop()

# --- so is an rx's for-in cursor, which gives back the value it took ---
let (ptx, prx) = Channel.new(2)
let (qtx, qrx) = Channel.new(2)
ptx.send(qtx.clone())
qtx.drop()
mut cursor = prx.iter()
assert_throws('TypeError', fn () { cursor._rx = {} })
assert_eq(cursor.has_next(), true)
cursor = nil
assert_eq("{qrx.try_recv()}", 'ChannelResult.Closed')
ptx.drop()
prx.drop()
qrx.drop()

# --- a value that fails to rebuild here (a Set member's hash() throws once
#     its field changed) is taken all the same, as recv() takes it: the
#     cursor goes on to the next ---
class HashedByX {
  new(.x) {}
  hash() {
    throw {kind: 'HashError', message: 'changed since the add'} if self.x > 0
    0
  }
  eq(o) {
    true
  }
}
let hk = HashedByX(0)
let hset = Set(hk)
hk.x = 1
let (stx, srx) = Channel.new(4)
stx.send(hset)
stx.send('after')
stx.drop()
let scursor = srx.iter()
assert_eq(scursor.has_next(), true)
assert_throws('HashError', fn () { scursor.next() })
assert_eq(scursor.has_next(), true)
assert_eq(scursor.next(), 'after')
assert_eq(scursor.has_next(), false)
srx.drop()

# --- and what was rebuilt of it before the throw goes, whichever way it was
#     received ---
let rebuild_fails = fn (receive) {
  let (tx, rx) = Channel.new(1)
  let round = fn () {
    tx.send([[1, 2], hset])  # the Arrays are rebuilt before the Set fails
    assert_throws('HashError', fn () { receive(rx) })
  }
  round()
  let before = GC.stat().rc_objects
  for _ in 0..3 {
    round()
  }
  let grew = GC.stat().rc_objects - before
  tx.drop()
  rx.drop()
  grew
}
assert_eq(rebuild_fails(|rx| rx.recv()), 0)
assert_eq(rebuild_fails(|rx| rx.try_recv()), 0)
assert_eq(rebuild_fails(|rx| rx.drain()), 0)
assert_eq(rebuild_fails(fn (rx) {
  for v in rx {
    return v
  }
}), 0)

# --- a drain's batch, taken in one step, goes as one ---
let (btx, brx) = Channel.new(3)
btx.send('before')
btx.send(hset)
btx.send('after')
assert_throws('HashError', fn () { brx.drain() })
assert_eq("{brx.try_recv()}", 'ChannelResult.Empty')
btx.drop()
brx.drop()

# --- a value that is in a message twice arrives as one value, with a
#     reference for each place it is in ---
let twice = |x| x + 1
let (wtx, wrx) = Channel.new(1)
wtx.send([twice, twice])
let pair = wrx.recv()
assert_eq(GC.refcount(pair[0]), GC.refcount(twice) + 1)

# --- even when the first place it was in is gone before the second is
#     rebuilt: a Set member that comes out equal to an earlier one here ---
class SameByX {
  new(.x, .f) {}
  hash() {
    self.x
  }
  eq(o) {
    self.x == o.x
  }
}
let plus100 = |y| y + 100
let kept = SameByX(1, nil)
let dropped = SameByX(2, plus100)  # plus100 is rebuilt here first
let colliding = Set(kept, dropped)
kept.x = 2
wtx.send([colliding, plus100])
let after = wrx.recv()
assert_eq(after[0].size(), 1)
assert_eq(after[1](1), 101)
wtx.drop()
wrx.drop()

# --- what an isolate hands back keeps its ends for as long as the isolate:
#     every join rebuilds them, and the isolate's going lets them go ---
let (rtx, rrx) = Channel.new(4)
mut thrower = Isolate.spawn(fn (t) { throw [t, t] }, rtx)
for _ in 0..2 {
  try {
    thrower.join()
  } catch e {
    e[0].send(1)
  }
}
thrower = nil
rtx.drop()
assert_eq(rrx.drain(), [1, 1])
assert_eq("{rrx.try_recv()}", 'ChannelResult.Closed')
rrx.drop()

# --- each fan_in producer is sent the function on its own, ends and all ---
let (ftx, frx) = Channel.new(8)
let fmerged = Channel.fan_in([1, 2, 3], fn (item, tx) { ftx.send(item) })
for _ in fmerged {
}
fmerged.drop()
ftx.drop()
mut fsum = 0
for v in frx {
  fsum += v
}
assert_eq(fsum, 6)
frx.drop()

inspect("test_channel: all assertions passed")
