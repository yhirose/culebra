# Cross-process SharedBuffer: the parent allocates an anonymous, fd-backed
# buffer with SharedBuffer.shared(...), hands it to a child culebra via
# Proc.run/spawn `share: {name: buf}`, and the child re-attaches it with
# SharedBuffer.receive(name, T) — both ends address the same physical pages
# (zero copy across the process boundary). Runs under interp and (via the
# `_jit` suffix) JIT; the children are launched under both backends explicitly.
@packable
class Cell {
  v: Int64 = 0
}

let add_worker = "tests/isolate/proc_share_worker/add.cul"
let slot_worker = "tests/isolate/proc_share_worker/slot.cul"
let lock_worker = "tests/isolate/proc_share_worker/lock.cul"

# --- round trip, child under interp ---------------------------------------
let g1 = SharedBuffer.shared(4, Cell)
g1[0].v = 100
g1[1].v = 200
let r1 = Proc.run([Sys.executable, add_worker], share: {grid: g1})
assert_eq(r1.ok, true)
assert_eq(g1.count, 4)
assert_eq(g1[0].v, 110)  # 100 + 1*10  (child wrote it)
assert_eq(g1[1].v, 220)  # 200 + 2*10
assert_eq(g1[2].v, 30)   #   0 + 3*10  (zero-init, then child)
assert_eq(g1[3].v, 40)   #   0 + 4*10
g1.drop()

# --- round trip, child under JIT ------------------------------------------
let g2 = SharedBuffer.shared(3, Cell)
g2[0].v = 5
let r2 = Proc.run([Sys.executable, "--jit", add_worker], share: {grid: g2})
assert_eq(r2.ok, true)
assert_eq(g2[0].v, 15)  # 5 + 10
assert_eq(g2[1].v, 20)  # 0 + 20
assert_eq(g2[2].v, 30)  # 0 + 30
g2.drop()

# --- concurrent disjoint writes (Proc.spawn) ------------------------------
# Four child processes each own one cell; no two touch the same element, so
# the writes need no synchronization and never race.
let grid = SharedBuffer.shared(4, Cell)
let handles = []
for w in 0..4 {
  handles.push(Proc.spawn(
    [Sys.executable, slot_worker],
    share: {grid: grid},
    env: {SLOT: w.to_string()},
  ))
}
for h in handles {
  h.wait()
}
assert_eq(grid[0].v, 100)
assert_eq(grid[1].v, 200)
assert_eq(grid[2].v, 300)
assert_eq(grid[3].v, 400)
grid.drop()

# --- contended writes under with_lock (Proc.spawn) ------------------------
# Four child processes (two interp, two JIT) each bump the SAME cell 500 times.
# The PROCESS_SHARED mutex in the buffer header serializes the read-modify-write
# across processes AND across backends, so the total is exact (a lost-update
# race would undercount).
let tally = SharedBuffer.shared(1, Cell)
let bumpers = []
for w in 0..4 {
  let argv = if w % 2 == 0 {
    [Sys.executable, lock_worker]
  } else {
    [Sys.executable, "--jit", lock_worker]
  }
  bumpers.push(Proc.spawn(argv, share: {grid: tally}, env: {REPS: "500"}))
}
for h in bumpers {
  h.wait()
}
assert_eq(tally[0].v, 2000)  # 4 procs * 500, none lost
tally.drop()

# --- error paths (symmetric interp/JIT) -----------------------------------
# receive a name the parent never shared.
mut missing = false
try {
  SharedBuffer.receive("nope", Cell)
} catch e {
  missing = e.kind == "ValueError"
}
assert_eq(missing, true)

# only a .shared() buffer may cross a process boundary (heap is isolate-local).
mut heap_rejected = false
let h = SharedBuffer.new(2, Cell)
try {
  Proc.run([Sys.executable, add_worker], share: {grid: h})
} catch e {
  heap_rejected = e.kind == "ValueError"
}
assert_eq(heap_rejected, true)
h.drop()

# --- Proc.all with share: (contended counter across N children) -----------
# All children share one anonymous buffer; each bumps cell 0 100x under
# with_lock, so the total is exact (no lost increments) and ordering-free.
let count_worker = "tests/isolate/proc_share_worker/count.cul"
let allg = SharedBuffer.shared(1, Cell)
mut allcmds = []
for w in 0..3 {
  allcmds.push([Sys.executable, count_worker])
}
let allres = Proc.all(allcmds, share: {grid: allg})
for r in allres {
  assert_eq(r.ok, true)
}
assert_eq(allg[0].v, 300)  # 3 children * 100, none lost
allg.drop()

# --- Proc.race with share: (the winner writes the shared buffer) ----------
let raceg = SharedBuffer.shared(2, Cell)
let racer = Proc.race([[Sys.executable, add_worker]], share: {grid: raceg})
assert_eq(racer.ok, true)
assert_eq(raceg[0].v, 10)  # add_worker bumped cell 0 by 1*10
raceg.drop()

# only a .shared() buffer may cross via Proc.all/race too.
mut all_heap_rejected = false
let hh = SharedBuffer.new(1, Cell)
try {
  Proc.all([[Sys.executable, count_worker]], share: {grid: hh})
} catch e {
  all_heap_rejected = e.kind == "ValueError"
}
assert_eq(all_heap_rejected, true)
hh.drop()

# --- share: survives a call the keyword peephole never sees ----------------
# `share` used to be implemented only in the compile-time keyword form, so a
# call that reached the runtime resolver instead — a namespace function read
# as a value on any backend, or any direct call on the bytecode VM, which has
# no peephole — dropped it and the child could not attach the buffer.
let vg = SharedBuffer.shared(2, Cell)
let run_via_value = Proc.run
let vr = run_via_value([Sys.executable, add_worker], share: {grid: vg})
assert_eq(vr.ok, true)
assert_eq(vg[0].v, 10)
assert_eq(vg[1].v, 20)
vg.drop()

let sg = SharedBuffer.shared(1, Cell)
let spawn_via_value = Proc.spawn
let sh = spawn_via_value(
  [Sys.executable, slot_worker],
  share: {grid: sg},
  env: {SLOT: "0"},
)
sh.wait()
assert_eq(sg[0].v, 100)
sg.drop()

inspect("proc share ok")
