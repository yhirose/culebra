# Run by test_cancel_tight_loop.cul: the program ends with an isolate still
# spinning, its handle held in a cycle a top-level binding reaches, so nothing
# lets the handle go. The end of the run must still cancel and join it; its
# defer printing is how the parent sees that.
let (started_tx, started_rx) = Channel(1)
let held = {}
held.me = held
held.isolate = Isolate.spawn(fn () {
  defer {
    println("child unwound")
  }
  started_tx.send(true)
  mut i = 0
  while true {
    i += 1
  }
})
assert_eq(started_rx.recv(), true)
println("main ends")
