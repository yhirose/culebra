# Channel.fan_in — merge several receivers into one. Runs under BOTH backends.
# Each producer owns its own channel (no shared tx.clone bookkeeping); fan_in
# reads from whichever source is ready and ends once all sources close.

# N producers, each its own channel, merged. Order is non-deterministic, so
# check the multiset via the sum.
mut handles = []
mut sources = []
for w in [1, 2, 3, 4] {
  let (tx, rx) = Channel.new(2)
  handles.push(Isolate.spawn(fn () {
    for i in 1..6 {
      tx.send(w * 100 + i)
    }
  }))
  tx.drop()  # the parent's own sender; the producer's auto-drops
  sources.push(rx)
}
mut got = []
for v in Channel.fan_in(sources) {
  got.push(v)
}
for h in handles {
  h.join()
}
assert_eq(got.size(), 20)                     # 4 producers x 5 values
assert_eq(got.reduce(0, |a, b| a + b), 5060)  # (101..105)+(201..205)+(301..305)+(401..405)

# explicit recv() until nil also works
let (t1, r1) = Channel.new(4)
let (t2, r2) = Channel.new(4)
t1.send(1)
t2.send(2)
t1.send(3)
t1.drop()
t2.drop()
let m = Channel.fan_in([r1, r2])
mut sum = 0
mut v = m.recv()
while v != nil {
  sum = sum + v
  v = m.recv()
}
assert_eq(sum, 6)

# single source is a pass-through
let (ta, ra) = Channel.new(4)
ta.send(42)
ta.drop()
let one = Channel.fan_in([ra])
assert_eq(one.recv(), 42)
assert_eq(one.recv(), nil)

# empty source list → an immediately-closed rx
mut empty_count = 0
for v in Channel.fan_in([]) {
  empty_count = empty_count + 1
}
assert_eq(empty_count, 0)

# type errors
try {
  Channel.fan_in(42)
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}
try {
  let (txx, rxx) = Channel.new()
  Channel.fan_in([txx])  # a sender, not a receiver
  assert_true(false)
} catch e {
  assert_eq(e.kind, "TypeError")
}

# fan_in(items, fn): spawn a producer per item + merge — no tx, no drop, no
# handle in user code. (The producer's tx auto-drops; fan_in owns the rest.)
let merged = Channel.fan_in([1, 2, 3], fn (w, tx) {
  for i in 1..6 {
    tx.send(w * 100 + i)
  }
})
mut g2 = []
for v in merged {
  g2.push(v)
}
merged.join()
assert_eq(g2.size(), 15)  # 3 producers x 5
assert_eq(g2.reduce(0, |a, b| a + b), 3045)

# a structured producer error surfaces via merged.join() (both backends)
let mf = Channel.fan_in([1, 2], fn (w, tx) {
  tx.send(w)
  if w == 2 {
    let bad = 1 / 0
  }  # ZeroDivisionError
})
mut cf = 0
for v in mf {
  cf = cf + 1
}
assert_eq(cf, 2)
let kind = try {
  mf.join()
  "no error"
} catch e {
  e.kind
}
assert_eq(kind, "ZeroDivisionError")

# a raw `throw <value>` from a producer crosses the isolate boundary intact —
# join() re-raises the value itself, identically under interp and JIT.
let mr = Channel.fan_in([7], fn (w, tx) {
  tx.send(w)
  throw "boom"
})
mut cr = 0
for v in mr {
  cr = cr + 1
}
assert_eq(cr, 1)
let caught = try {
  mr.join()
  "no error"
} catch e {
  e
}
assert_eq(caught, "boom")

# the same raw-throw symmetry on a plain Isolate.spawn handle
let h = Isolate.spawn(fn () {
  throw [1, 2, 3]
})
let ch = try {
  h.join()
  nil
} catch e {
  e
}
assert_eq(ch, [1, 2, 3])

# A merged rx is a handle onto its merge, as an endpoint is onto its channel:
# it has no fields and does not cross to an isolate. Its for-in cursor holds
# the merge too, so the loop runs whatever becomes of the rx it came from.
let (th, rh) = Channel.new(4)
th.send(10)
th.send(20)
th.drop()
let mh = Channel.fan_in([rh])
assert_eq("{mh}", "[merged Channel rx]")
assert_eq(mh.keys(), [])
assert_throws('TypeError', fn () {
  mh.x = 1
})
mut read = []
for v in mh {
  read.push(v)
  mh.drop()
}
assert_eq(read, [10, 20])
assert_eq("{mh}", "[dropped merged Channel rx]")
assert_eq(mh.recv(), nil)

# Dropping a merged rx stops the producers still running: the one below never
# ends on its own, and its `side_tx` closes when it is cancelled.
let (side_tx, side_rx) = Channel.new(1)
let spin = Channel.fan_in([1], fn (w, tx) {
  tx.send(w)
  side_tx.send(w)
  mut i = 0
  while true {
    i += 1
  }
})
side_tx.drop()
assert_eq(spin.recv(), 1)
assert_eq(side_rx.recv(), 1)
spin.drop()
assert_eq(side_rx.recv(), nil)

# join() only waits for the producers: what their fn returns is not its
# result, and is not built on this side.
fn join_once() {
  let mj = Channel.fan_in([1, 2], fn (w, tx) {
    tx.send(w)
    [w, w]
  })
  for _ in mj {
  }
  mj.join()
}
fn join_leaked() {
  join_once()
  let before = GC.stat().rc_objects
  for _ in 0..5 {
    join_once()
  }
  GC.stat().rc_objects - before
}
assert_eq(join_leaked(), 0)

# A producer that throws an Object: join() re-raises it whole. It used to hand
# the value back with its carrier's reference already let go, so the Object's
# first field read as nil (a kind of "ValueError" came back as nil) and the
# next spawn died on the freed value.
let mo = Channel.fan_in([2], fn (w, tx) {
  throw {kind: "ValueError", message: "w{w}"}
})
let thrown = try {
  mo.join()
  nil
} catch e {
  e
}
assert_eq(thrown.kind, "ValueError")
assert_eq(thrown.message, "w2")
assert_eq(Isolate.spawn(fn () { 40 + 2 }).join(), 42)

# With several producers throwing, join() re-raises the first and lets the
# others go: what it did not keep is released, not leaked.
fn join_threw() {
  let m = Channel.fan_in([1, 2, 3], fn (w, tx) {
    throw {kind: "ValueError", message: "w{w}"}
  })
  let r = try {
    m.join()
    nil
  } catch e {
    e
  }
  r.kind
}
fn join_threw_leaked() {
  join_threw()
  let before = GC.stat().rc_objects
  for _ in 0..5 {
    join_threw()
  }
  GC.stat().rc_objects - before
}
assert_eq(join_threw(), "ValueError")
assert_eq(join_threw_leaked(), 0)

inspect("test_fanin: all assertions passed")
