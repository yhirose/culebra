# Rendezvous channel (cap 0): send blocks until a receiver takes the value —
# synchronous hand-off, no buffering. Runs under BOTH interp and --jit.

# producer isolate, parent consumer (relies on auto-close, no explicit drop)
let (tx, rx) = Channel.new(0)
let prod = Isolate.spawn(fn () {
  tx.send(1)
  tx.send(2)
  tx.send(3)
})
tx.drop()                  # parent's own sender; producer's drops on exit
mut got = []
for v in rx { got.push(v) }
prod.join()
assert_eq(got, [1, 2, 3])

# parent producer, consumer isolate (rendezvous send from the parent thread)
let (tx2, rx2) = Channel.new(0)
let cons = Isolate.spawn(fn () {
  mut sum = 0
  for v in rx2 { sum = sum + v }
  return sum
})
tx2.send(10)
tx2.send(20)
tx2.send(30)
tx2.drop()                 # closes the channel so the consumer's for-in ends
assert_eq(cons.join(), 60)

# explicit recv() also works with rendezvous
let (tx3, rx3) = Channel.new(0)
let p3 = Isolate.spawn(fn () { tx3.send(99) })
tx3.drop()
assert_eq(rx3.recv(), 99)
assert_eq(rx3.recv(), nil)  # closed + drained
p3.join()

# negative capacity is rejected
try {
  Channel.new(-1)
  assert_true(false)
} catch e {
  assert_eq(e.kind, "ValueError")
}

inspect("test_rendezvous_jit: all assertions passed")
