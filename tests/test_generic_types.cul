// Conformance: Generic type annotations (Phase 2 MVP).
// Element runtime check is no-op (Rust/Swift design); annotations
// are documentation + multifn dispatch tie-break.

// --- Outer-only match (element type is documentation) ---
fn first(xs: Array<Long>) -> Long {
  xs[0]
}
assert_eq(first([1, 2, 3]), 1)
assert_eq(first([1, "two", 3]), 1)  // element check no-op

// --- Nested Generic ---
fn rows(m: Array<Array<Long>>) -> Long {
  m.size()
}
assert_eq(rows([[1, 2], [3, 4], [5, 6]]), 3)

// --- Generic + Union in return type ---
fn lookup(k: String) -> Array<Long> | Nil {
  if k == "yes" {
    [1, 2]
  } else {
    nil
  }
}
assert_eq(lookup("yes"), [1, 2])
assert_eq(lookup("no"), nil)

// return_type canonicalizes symmetric to params[i].type.
fn ws_return(xs: Array<Long>) -> Array < Long > {
  xs
}
assert_eq(ws_return.return_type, "Array<Long>")
fn union_return(k: Long) -> Long  |  Float {
  to_float(k)
}
assert_eq(union_return.return_type, "Long | Float")

// --- Whitespace canonicalization in params ---
fn ws_a(xs: Array<Long>) {
  xs[0]
}
fn ws_b(xs: Array < Long >) {
  xs[0]
}
fn ws_c(xs: Array<  Long  >) {
  xs[0]
}
assert_eq(ws_a.params[0].type, "Array<Long>")
assert_eq(ws_b.params[0].type, "Array<Long>")
assert_eq(ws_c.params[0].type, "Array<Long>")

// Nested canonical (Union inside Generic).
fn nested_canon(m: Array<Array<Long|Float>>) {
  m.size()
}
assert_eq(nested_canon.params[0].type, "Array<Array<Long | Float>>")

// Duplicate Union alts dedup at canonicalization.
fn dup(xs: Array<Long> | Array<Long>) {
  xs[0]
}
assert_eq(dup.params[0].type, "Array<Long>")

// --- Dispatch tie-break: Generic outranks bare outer ---
fn handle(xs: Array) -> String {
  "bare"
}
fn handle(xs: Array<Long>) -> String {
  "generic"
}
assert_eq(handle([1, 2, 3]), "generic")

// --- Generic class declaration ---
class Box<T> {
  new(v) {
    self.v = v
  }
}
let b = Box.new(42)
assert_true(type_of(b) == "Box" && b.v == 42)

class Pair<K, V> {
  new(k, v) {
    self.k = k
    self.v = v
  }
}
let p = Pair.new("a", 1)
assert_true(type_of(p) == "Pair" && p.k == "a" && p.v == 1)

fn unbox(b: Box<Long>) -> Long {
  b.v
}
assert_eq(unbox(Box.new(7)), 7)

// --- Type-param in method signature is Any-equivalent ---
class Cell<T> {
  new(v: T) {
    self.v = v
  }
  set(v: T) {
    self.v = v
  }
}
let c = Cell.new(1)
c.set("now a string")
assert_eq(c.v, "now a string")

// Introspection preserves declared T (runtime sees Any).
assert_eq(c.set.params[0].type, "T")
class Bagged<T> {
  fill(xs: Array<T>) {
    self.xs = xs
  }
}
assert_eq(Bagged.new().fill.params[0].type, "Array<T>")

// --- match arm strips Generic on both backends ---
fn classify(v) {
  match v {
    xs: Array<Long> => "array",
    n: Long => "long",
    _ => "other",
  }
}
assert_eq(classify([1, 2, 3]), "array")
assert_eq(classify(42), "long")
assert_eq(classify("hi"), "other")
assert_eq(classify(nil), "other")

// --- Composite type-param (Array<T>, T | Long) neutralizes too ---
class Bag<T> {
  put(v: T | Long) {
    self.v = v
  }
  fill(xs: Array<T>) {
    self.xs = xs
  }
}
let bag = Bag.new()
bag.put("anything")
assert_eq(bag.v, "anything")
bag.fill([1, "two", 3.5])
assert_eq(bag.xs.size(), 3)

// --- Nested fn/lambda inside Generic method: backend-symmetric ---
class Holder<T> {
  unwrap(x: T) {
    let lam = |y| y + 1
    fn helper(z) {
      z * 2
    }
    helper(lam(x))
  }
}
assert_eq(Holder.new().unwrap(3), 8)

// --- A type parameter is in scope through its declaration's whole body ---
// A nested function's, a `let`'s, a return type's, a pattern's and a nested
// class field's `Elem` is the enclosing declaration's parameter, not the
// class that happens to be called Elem; an inner declaration's own `Elem`
// shadows it.
class Elem {
  x: Float
  new(@x) {}
}
class Plain {
  new(@x) {}
}
trait Labeled {
  label() -> String
}
class Badge {
  new(@x) {}
  label() {
    'badge'
  }
}

fn in_scope<Elem>(v) {
  let lam = |p: Elem| p.x
  fn named(p: Elem) -> Elem {
    p
  }
  let held: Elem = v
  let picked = match v {
    p: Elem => 'matched',
    _ => 'fell through',
  }
  [lam(v), named(v).x, held.x, picked]
}
assert_eq(in_scope(Plain('p')), ['p', 'p', 'p', 'matched'])

fn maybe<Elem>(v: Elem?) {
  v
}
assert_eq([maybe(Plain('m')).x, maybe(nil)], ['m', nil])

fn wrapped<Elem>(v) {
  class Wrap {
    item: Elem
    new(@item) {}
  }
  fn read(w: Wrap) {
    let item = w.item
    item.x
  }
  read(Wrap(v))
}
assert_eq(wrapped(Plain('w')), 'w')

// a bound is the enclosing parameter's too, and a class's own bounded
// parameter names no class to a reader of its field
fn bounded<Elem: Labeled>(v) {
  let f = |p: Elem| p.label()
  f(v)
}
assert_eq(bounded(Badge(1)), 'badge')
let refused = try {
  bounded(Plain('p'))
} catch e {
  [e.message, e.line]
}
assert_eq(refused, ["type error: parameter 'p' expects Labeled", 217])

class Shelf<Elem: Labeled> {
  item: Elem
  new(@item) {}
}
fn shelf_x(s: Shelf) {
  let item = s.item
  item.x
}
assert_eq(shelf_x(Shelf(Badge('s'))), 's')

fn shadowed<Elem: Labeled>(v) {
  fn inner<Elem>(p: Elem) {
    'inner'
  }
  inner(v)
}
assert_eq(shadowed(Plain('s')), 'inner')

// a trait's own parameter, supertraits or not, and a `@value` member's,
// spliced in or called boxed: the body reads it where it was written
trait KeepsElem<Elem>: Labeled {
  keep_elem(v) {
    let held: Elem = v
    held.x
  }
}
class Keeper {
  label() {
    'keeper'
  }
}
assert_eq(Keeper().keep_elem(Plain('kept')), 'kept')

@value class Scaled<Elem> {
  k: Float
  new(k: Float) {
    self.k = k
  }
  doubled(v) {
    let held: Elem = v
    self.k * 2.0
  }
}
assert_eq([Scaled.new(1.5).doubled(Plain('s')),
           [Scaled.new(1.5)][0].doubled(Plain('s'))], [3.0, 3.0])

// a static field's value is the class's code, as its annotation is
class Statics<Elem> {
  static held: Elem = Plain('h')
  static picked = match Plain('h') {
    p: Elem => 'matched',
    _ => 'fell through',
  }
}
assert_eq([Statics.held.x, Statics.picked], ['h', 'matched'])

// a field typed by a parameter is read as the parameter is: one bound to a
// scalar is that scalar's field, its zero and its check included
class Measure<Elem: Float> {
  v: Elem
  w: Elem?
  get() {
    self.v
  }
}
let measure = Measure()
assert_eq([measure.get(), measure.w], [0.0, nil])
measure.v = 2.5
assert_eq(measure.get(), 2.5)
assert_throws('TypeError', fn () { measure.v = 1 })
assert_throws('TypeError', fn () { measure.w = 's' })
class Count<Elem: Long> {
  v: Elem
}
assert_eq(Count().v, 0)

// a `@packable` class's fields are its byte layout, read as written, so a
// parameter in scope that shares a field type's name leaves them alone
fn packed_of<Byte: Float>() {
  @packable
  class Packed {
    x: Byte
  }
  Packed
}
let Packed = packed_of()
let packed = Packed()
packed.x = 7
assert_eq(String.unpack(Packed, String.pack(Packed, [packed]))[0].x, 7)

// a `@value` class's field reads its class's own parameter as its bound, as
// `Count`'s does
@value
class Meter<Elem: Float> {
  x: Elem
  new(@x) {}
  doubled() {
    Meter(self.x * 2.0)
  }
}
assert_eq(Meter(1.5).doubled().x, 3.0)
assert_throws('TypeError', fn () { Meter(1) })

// and its own alone: an enclosing function's parameter of a value class's
// name does not rename the field, so what its contract admitted is what each
// write is checked against
fn wrapped_in<Meter>(v) {
  @value
  class Wrapped {
    m: Meter
    new(@m) {}
  }
  Wrapped(v)
}
assert_eq(wrapped_in(Meter(2.0)).m.x, 2.0)
assert_throws('TypeError', fn () { wrapped_in('not a value') })

// --- Generic-inner-Union must not recurse forever (depth-aware gate) ---
fn inner_union(xs: Array<Long | Float>) -> Long {
  xs.size()
}
assert_eq(inner_union([1, 2.5, 3]), 3)

// Class-in-class is rejected at eval/compile time — verified manually
// (JIT raises pre-runtime, doesn't fit the output-diff harness).

IO.inspect("test_generic_types OK")
