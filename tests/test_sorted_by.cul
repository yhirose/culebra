// Array.sorted_by(f): non-mutating sort_by — returns a new sorted Array and
// leaves the receiver untouched, so it chains.

let xs = ["bb", "a", "ccc"]
assert_eq(xs.sorted_by(fn (x) {
  x.size()
}), ["a", "bb", "ccc"])
assert_eq(xs, ["bb", "a", "ccc"])  // receiver unchanged

// descending via negated key
assert_eq(["bb", "a", "ccc"].sorted_by(fn (x) {
  -x.size()
}), ["ccc", "bb", "a"])

// stable (equal keys keep input order)
assert_eq([[1, "a"], [1, "b"], [0, "c"]].sorted_by(fn (p) {
  p[0]
}), [[0, "c"], [1, "a"], [1, "b"]])

// chains with other methods
assert_eq(["bb", "a", "ccc"].sorted_by(fn (x) {
  x.size()
}).join(","), "a,bb,ccc")

// empty
assert_eq([].sorted_by(fn (x) {
  x
}), [])

// A String key has no owner but the sort's own table, and any later key
// call may collect: every key must survive to the comparison (the
// GC-stress lane collects on each allocation).
let n = 2000
let shuffled = iota(n).map(|i| (i * 7919) % n)
assert_eq(shuffled.sorted_by(|x| "k{x:07}"), iota(n))

IO.inspect("test_sorted_by OK")
