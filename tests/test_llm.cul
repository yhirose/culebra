# LLM without a server: the schema a tool is given, and what is refused before
# any request. The conversation itself is in test_llm_server.cul.
#
# This file names only LLM. Under `culebra build` that has to be enough to link
# what LLM is written over, which the last check below proves.

# What a call raised, as "Kind: message".
fn failure(thunk) {
  try {
    thunk()
    "no error"
  } catch e {
    "{e.kind}: {e.message}"
  }
}

# --- a tool's schema comes from its annotations ---------------------------------

fn weather(note, city: String, days: Long = 1, unit: String? = nil, ok: Bool = true) {
  "{city}: sunny"
}
let w = LLM.tool(weather, "the weather in a city", city: "a city name")
assert_eq(type_of(w), "LLMTool")
assert_eq([w.name, w.description], ["weather", "the weather in a city"])
# Unannotated takes any value; a default or `?` makes it optional; a
# description given by name goes on that parameter.
assert_eq(JSON.stringify(w.input_schema),
  '{"type":"object","properties":{"note":{},"city":{"type":"string","description":"a city name"},' +
  '"days":{"type":"integer"},"unit":{"type":"string"},"ok":{"type":"boolean"}},' +
  '"required":["note","city"]}')
# What goes out is everything but the function.
assert_eq(w.spec().keys(), ["name", "description", "input_schema"])

fn shapes(xs: Array<Long | String>, ratio: Float, o: Object, any: Long | String) {
  nil
}
assert_eq(JSON.stringify(LLM.tool(shapes, "s").input_schema.properties),
  '{"xs":{"type":"array","items":{"anyOf":[{"type":"integer"},{"type":"string"}]}},' +
  '"ratio":{"type":"number"},"o":{"type":"object"},' +
  '"any":{"anyOf":[{"type":"integer"},{"type":"string"}]}}')

# Only a top-level Nil makes a parameter optional; one inside `Array<...>` is
# what the elements may be.
fn holes(xs: Array<Long | Nil>, y: Long?) {
  nil
}
assert_eq(LLM.tool(holes, "h").input_schema.required, ["xs"])

# A function of no parameters has nothing required.
fn now() {
  "noon"
}
assert_eq(JSON.stringify(LLM.tool(now, "the time").input_schema),
          '{"type":"object","properties":{}}')

# --- refused before any request -----------------------------------------------------

assert_eq(failure(|| LLM.tool(weather, "w", cty: "typo")),
          "ValueError: LLM.tool: weather has no parameter 'cty'")
assert_eq(failure(|| LLM.tool(|x| x, "anonymous")),
          "ValueError: LLM.tool: the function has no name; declare it with `fn name(...)`")
assert_eq(failure(|| LLM.tool("weather", "w")),
          "TypeError: type error: parameter 'f' expects Function")
assert_eq(failure(|| LLM.chat()), "ArityError: missing required argument 'provider'")
assert_eq(failure(|| LLM.anthropic(api_key: "")),
          "LLMError: LLM: no API key: set ANTHROPIC_API_KEY or pass api_key:")

# A wrong argument is the TypeError a typed parameter raises.
let nowhere = {api_key: "k", base_url: "http://127.0.0.1:1"}
let nowhere_provider = LLM.anthropic(**nowhere)
assert_eq(failure(|| LLM.chat(provider: nowhere_provider, model: "m", tools: [weather])),
          "TypeError: LLM.chat: tools takes what LLM.tool makes, got Function")
assert_eq(failure(|| LLM.chat(provider: 3, model: "m")),
          "TypeError: type error: parameter 'provider' expects a provider (an object with a turn method)")
assert_eq(failure(|| LLM.chat(provider: nowhere_provider)),
          "LLMError: LLM: model: is required for anthropic")
assert_eq(failure(|| LLM.ask("hi", provider: nowhere_provider)),
          "LLMError: LLM: model: is required for anthropic")
assert_eq(failure(|| LLM.chat(provider: nowhere_provider, model: 3)),
          "TypeError: type error: parameter 'model' expects String | Nil")
assert_eq(failure(|| LLM.chat(provider: nowhere_provider, model: "m", system: 3)),
          "TypeError: type error: parameter 'system' expects String | Nil")
assert_eq(failure(|| LLM.chat(provider: nowhere_provider, model: "m", max_tokens: "9")),
          "TypeError: type error: parameter 'max_tokens' expects Long")
assert_eq(failure(|| LLM.chat(provider: nowhere_provider, model: "m", max_turns: "9")),
          "TypeError: type error: parameter 'max_turns' expects Long")
assert_eq(failure(|| LLM.ask(3, provider: nowhere_provider, model: "m")),
          "TypeError: type error: parameter 'prompt' expects String")
assert_eq(failure(|| LLM.ask("hi", provider: nowhere_provider, model: "m", on_text: 3)),
          "TypeError: type error: parameter 'on_text' expects Function | Nil")
assert_eq(failure(|| LLM.request([], provider: nowhere_provider)),
          "TypeError: type error: parameter 'body' expects Object")
assert_eq(failure(|| LLM.request({}, provider: nowhere_provider, headers: "x")),
          "TypeError: type error: parameter 'headers' expects Object | Nil")
assert_eq(failure(|| LLM.request({}, provider: 3)),
          "TypeError: type error: parameter 'provider' expects a provider (an object with a turn method)")
# A provider takes a request as it is only if it says how.
assert_eq(failure(|| LLM.request({}, provider: {name: "plain", turn: fn (request, on_text) { {} }})),
          "LLMError: LLM.request: plain does not take a request as it is")
let rq_seen = []
let rq_provider = {name: "own", turn: fn (request, on_text) { {} },
                   request: fn (body, headers) { rq_seen.push([body, headers]); {ok: true} }}
assert_eq(LLM.request({a: 1}, provider: rq_provider, headers: {"x-b": "c"}), {ok: true})
assert_eq(rq_seen, [[{a: 1}, {"x-b": "c"}]])
assert_eq(LLM.request({a: 2}, provider: rq_provider), {ok: true})
assert_eq(rq_seen[1], [{a: 2}, nil])
# A slice is taken as the String it reads as.
assert_eq(LLM.tool(weather, "the weather in a city".slice(0, 11)).description,
          "the weather")

# The error points at the call into the library, not into it: the same line
# as an error raised beside it.
fn line_of(thunk) {
  try {
    thunk()
    0
  } catch e {
    e.line
  }
}
let lines = [line_of(|| LLM.anthropic(api_key: "")), line_of(|| [][1])]
assert_eq(lines[0], lines[1])

# --- LLM.repair: a history a provider would refuse, made one it accepts --------------

fn rp_user(t) {
  {role: "user", content: t}
}
fn rp_say(t) {
  {role: "assistant", content: [{type: "text", text: t}]}
}
fn rp_ask(ids, t = nil) {
  let parts = ids.map(|id| {type: "tool_call", id: id, name: "weather", args: {}})
  {role: "assistant", content: t == nil ? parts : [{type: "text", text: t}] + parts}
}
fn rp_answer(ids) {
  {role: "tool", content: ids.map(|id| {type: "tool_result", id: id, content: "ok", is_error: false})}
}
let rp_histories = []
fn rp(history) {
  rp_histories.push(history)
  LLM.repair(history)
}

# A history whose calls and results pair up is returned as it is.
let rp_good = [rp_user("hi"), rp_ask(["a"], "checking"), rp_answer(["a"]), rp_say("done")]
assert_eq(rp(rp_good), rp_good)
assert_eq(rp([]), [])

# A result whose call is not there goes, and its message when nothing is left.
assert_eq(rp([rp_user("hi"), rp_answer(["a"]), rp_say("done")]),
          [rp_user("hi"), rp_say("done")])
assert_eq(rp([rp_user("hi"), rp_ask(["a"]), rp_answer(["a", "b"]), rp_say("done")]),
          [rp_user("hi"), rp_ask(["a"]), rp_answer(["a"]), rp_say("done")])

# A call whose result is not there goes; what the message said stays.
assert_eq(rp([rp_user("hi"), rp_ask(["a"], "let me"), rp_say("done")]),
          [rp_user("hi"), rp_say("let me"), rp_say("done")])
assert_eq(rp([rp_user("hi"), rp_ask(["a"]), rp_user("again")]),
          [rp_user("hi"), rp_user("again")])
assert_eq(rp([rp_user("hi"), rp_ask(["a", "b"]), rp_answer(["a"]), rp_say("done")]),
          [rp_user("hi"), rp_ask(["a"]), rp_answer(["a"]), rp_say("done")])

# The results follow the call directly, in one tool message or several.
assert_eq(rp([rp_user("hi"), rp_ask(["a", "b"]), rp_answer(["a"]), rp_answer(["b"]), rp_say("done")]),
          [rp_user("hi"), rp_ask(["a", "b"]), rp_answer(["a"]), rp_answer(["b"]), rp_say("done")])
assert_eq(rp([rp_user("hi"), rp_answer(["a"]), rp_ask(["a"]), rp_say("done")]),
          [rp_user("hi"), rp_say("done")])
assert_eq(rp([rp_user("hi"), rp_ask(["a"], "x"), rp_user("more"), rp_answer(["a"]), rp_say("done")]),
          [rp_user("hi"), rp_say("x"), rp_user("more"), rp_say("done")])
assert_eq(rp([rp_user("hi"), rp_ask(["a"], "x"), {role: "system", content: "s"},
              rp_answer(["a"]), rp_say("done")]),
          [rp_user("hi"), rp_say("x"), {role: "system", content: "s"}, rp_say("done")])

# A call is answered once, and a call id is used once.
assert_eq(rp([rp_user("hi"), rp_ask(["a"]), rp_answer(["a"]), rp_answer(["a"]), rp_say("done")]),
          [rp_user("hi"), rp_ask(["a"]), rp_answer(["a"]), rp_say("done")])
assert_eq(rp([rp_user("hi"), rp_ask(["a", "a"]), rp_answer(["a"]), rp_say("done")]),
          [rp_user("hi"), rp_ask(["a"]), rp_answer(["a"]), rp_say("done")])

# A call and a result with no id are not a pair.
assert_eq(rp([rp_user("hi"),
              {role: "assistant", content: [{type: "text", text: "x"}, {type: "tool_call", name: "w"}]},
              {role: "tool", content: [{type: "tool_result", content: "ok"}]},
              rp_say("done")]),
          [rp_user("hi"), rp_say("x"), rp_say("done")])

# Nothing else is touched: other parts, String content, system, empty content.
let rp_odd = [
  {role: "system", content: "be brief"},
  rp_user("hi"),
  {role: "assistant", content: [
    {type: "reasoning", text: "t", format: "anthropic", opaque: {signature: "sig"}},
    {type: "other", format: "anthropic", opaque: {type: "web_search_tool_result"}},
    {type: "text", text: "hello"}]},
  {role: "assistant", content: "plain text"},
  {role: "assistant", content: []},
]
assert_eq(rp(rp_odd), rp_odd)

# The history it is given is not changed, and a repaired history needs no more repair.
let rp_snapshot = JSON.parse(JSON.stringify(rp_histories))
for i, history in rp_histories.enumerate() {
  assert_eq(history, rp_snapshot[i])
  assert_eq(LLM.repair(LLM.repair(history)), LLM.repair(history))
}

assert_eq(failure(|| LLM.repair("x")),
          "TypeError: type error: parameter 'messages' expects Array")
assert_eq(failure(|| LLM.repair([rp_user("hi"), 3])),
          "TypeError: type error: messages[1] expects Object")

# --- LLM is a namespace, as Time and Log are ---------------------------------------

# A member it does not have is an error, not nil, and a function read off it
# stays in the isolate that read it, as every library function does.
assert_eq(failure(|| LLM.asks), "AttributeError: namespace 'LLM' has no member 'asks'")
let llm_ask = LLM.ask
assert_eq(failure(|| Isolate.spawn(|| llm_ask("hi", model: "m")).join()),
  "SendError: Isolate.spawn: a native/builtin function is not Sendable")

# --- a transport failure is the transport's ----------------------------------------

# Nothing listens on port 1. The failure is the connection's, which also says
# the HTTP runtime is linked into a binary that never named it.
let refused = try {
  LLM.ask("hi", provider: nowhere_provider, model: "m")
  nil
} catch e {
  e
}
assert_eq(refused.kind, "HttpError")
assert_true(!refused.message.contains("not linked"))
