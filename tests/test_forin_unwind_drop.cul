# A throw unwinding out of a for-in must release the iterable's scope-slot
# ref during unwind, firing its drop before the catch — like the
# interpreter. The for statement's own cleanup pad covers every branch
# (keys, protocol, set); the JIT used to strand that ref (drop never fired,
# and the object leaked when the frame wasn't re-entered). Each section records
# what ran, in order, and asserts the sequence.

mut ev = []

# Keys branch: plain object, body throws.
fn run_keys() {
  for k in {a: 1, b: 2, drop: fn () {
    ev.push("keys: iterable dropped")
  }} {
    throw "boom"
  }
}
try {
  run_keys()
} catch e {
  ev.push("keys: caught " + e)
}
assert_eq(ev, ["keys: iterable dropped", "keys: caught boom"])
ev = []

# Protocol branch, distinct iterator: body throws; the iterator is disposed
# and dropped by the protocol cleanup, then the iterable by the for scope.
fn mk_proto() {
  {
    v: 1,
    iter: fn () {
      {
        mut i: 0,
        has_next: fn () {
          self.i < 3
        },
        next: fn () {
          self.i = self.i + 1
          self.i
        },
        dispose: fn () {
          ev.push("proto: disposed")
        },
        drop: fn () {
          ev.push("proto: iter dropped")
        },
      }
    },
    drop: fn () {
      ev.push("proto: iterable dropped")
    },
  }
}
fn run_proto() {
  for x in mk_proto() {
    throw "boom"
  }
}
try {
  run_proto()
} catch e {
  ev.push("proto: caught " + e)
}
assert_eq(ev, ["proto: disposed", "proto: iter dropped", "proto: iterable dropped", "proto: caught boom"])
ev = []

# Protocol branch, throwing dispose on break: the dispose's own throw
# propagates, and both the iterator and the iterable still drop.
fn mk_throwing() {
  {
    v: 1,
    iter: fn () {
      {
        mut i: 0,
        has_next: fn () {
          self.i < 3
        },
        next: fn () {
          self.i = self.i + 1
          self.i
        },
        dispose: fn () {
          throw "dboom"
        },
        drop: fn () {
          ev.push("dthrow: iter dropped")
        },
      }
    },
    drop: fn () {
      ev.push("dthrow: iterable dropped")
    },
  }
}
fn run_dthrow() {
  for x in mk_throwing() {
    break
  }
}
try {
  run_dthrow()
} catch e {
  ev.push("dthrow: caught " + e)
}
assert_eq(ev, ["dthrow: iter dropped", "dthrow: iterable dropped", "dthrow: caught dboom"])
ev = []

# Set branch: members survive the unwind (the temp array's slot releases,
# the set itself is dropped at its let scope's exit).
fn run_set() {
  let s = Set(10, 20)
  for x in s {
    throw "boom"
  }
}
try {
  run_set()
} catch e {
  ev.push("set: caught " + e)
}
assert_eq(ev, ["set: caught boom"])
ev = []

# The element itself, not just the iterable: a destructuring loop variable
# whose pattern misses throws while the cursor still holds this iteration's
# +1 and no slot has taken it over yet. That element must die on the unwind
# too. The JIT used to strand it (one leaked element per throw) because the
# cursor's element guard was outside the loop's cleanup pad.
fn mk_elem(n) {
  {at: n, drop: fn () {
    ev.push("elem: dropped " + self.at.to_string())
  }}
}
fn run_elem_mismatch() {
  for (a, b) in [mk_elem(1)] {
    ev.push("elem: body ran")
  }
}
try {
  run_elem_mismatch()
} catch e {
  ev.push("elem: caught " + e.kind)
}
assert_eq(ev, ["elem: dropped 1", "elem: caught ValueError"])
ev = []

# Same window on the protocol cursor, where the element comes from next().
fn mk_elem_gen() {
  {iter: fn () {
    {
      mut done: false,
      has_next: fn () {
        !self.done
      },
      next: fn () {
        self.done = true
        mk_elem(2)
      },
    }
  }}
}
fn run_elem_proto() {
  for (a, b) in mk_elem_gen() {
    ev.push("proto: body ran")
  }
}
try {
  run_elem_proto()
} catch e {
  ev.push("elem: caught " + e.kind)
}
assert_eq(ev, ["elem: dropped 2", "elem: caught ValueError"])
ev = []

# A matching pattern hands the element to the body slot, so it dies at the
# end of the iteration — the guard must not release it a second time.
fn run_elem_ok() {
  for (a, b) in [(mk_elem(3), 9)] {
    ev.push("ok: body ran")
  }
}
run_elem_ok()
assert_eq(ev, ["ok: body ran", "elem: dropped 3"])
ev = []

// docs §18.5 closes the iterator on the way out, after the iteration's own
// bindings die — so the element's and the body's drops precede `dispose` on
// every exit, not only on a natural drain.
class Res {
  id = ""
  new(id) { self.id = id }
  drop() { ev.push("drop " + self.id) }
}

fn mk_source() {
  {
    mut n: 0,
    iter: fn () { self },
    has_next: fn () { self.n < 3 },
    next: fn () {
      let v = self.n
      self.n = v + 1
      Res.new("e" + to_string(v))
    },
    dispose: fn () { ev.push("dispose") },
  }
}

for r in mk_source() {
  let local = Res.new("L")
  break
}
assert_eq(ev, ["drop L", "drop e0", "dispose"])
ev = []

try {
  for r in mk_source() {
    let local = Res.new("L")
    throw "boom"
  }
} catch e {
  ev.push("caught " + e)
}
assert_eq(ev, ["drop L", "drop e0", "dispose", "caught boom"])
ev = []

// A `return` also travels through here. The element's refcount hits zero
// while the return is still unwinding, and the drop body has to run there —
// its statements used to short-circuit on the pending flow, so the drop was
// silently a no-op.
fn leave_early() {
  for r in mk_source() {
    let local = Res.new("L")
    return "left"
  }
}
ev.push(leave_early())
assert_eq(ev, ["drop L", "drop e0", "dispose", "left"])
ev = []

// A destructure mismatch is an error leaving the loop: it is the one that
// reaches the `catch`, and a `dispose` throwing on the way out is swallowed
// like any other unwind.
fn mk_bad() {
  {
    iter: fn () { self },
    has_next: fn () { true },
    next: fn () { 5 },
    dispose: fn () { throw "from dispose" },
  }
}
try {
  for (a, b) in mk_bad() {
    ev.push("never")
  }
} catch e {
  ev.push("mismatch caught " + e.kind)
}
assert_eq(ev, ["mismatch caught ValueError"])
