let FACTORY_NAMES = FACTORY.map(|p| p.name)

# `x` as a number within lo..hi, or `default` when it is not a number.
fn number(x, lo, hi, default) {
  x is Long | Float && x == x && Math.abs(x) != Math.inf
    ? Math.clamp(x + 0.0, lo, hi)
    : default
}

# Each number's range, [lo, hi]: an operator's and the patch's. The page's
# knobs span the same (the engine sends them).
let RANGES = {
  op: {
    ratio: [0.5, 16.0],
    detune: [-50.0, 50.0],
    level: [0.0, 100.0],
    attack: [0.001, 5.0],
    decay: [0.01, 10.0],
    sustain: [0.0, 100.0],
    release: [0.01, 10.0],
  },
  patch: {
    feedback: [0.0, 100.0],
    volume: [0.0, 100.0],
    reverb: [0.0, 100.0],
    breath_bright: [0.0, 100.0],
    glide: [0.0, 1.0],
  },
}

# The numbers `ranges` names, from `given`, or else from `default`.
fn numbers(given, default, ranges) {
  ranges
    .iter()
    .map(|(k, r)| (k, number(given.get(k, nil), r[0], r[1], default[k])))
    .to_object()
}

# `p` (from a file or the page) made a whole patch: what is missing or out of
# range is the default's.
fn whole(p, name = nil) {
  let d = FACTORY[0]
  let given = p is Object ? p : {}
  let ops = given.get("ops", [])
  {
    name: name ?? (given.get("name", nil) is String ? given.name : "Untitled"),
    algorithm: fm.ALGORITHMS.has(given.get("algorithm", ""))
      ? given.algorithm
      : d.algorithm,
    ops: iota(3).map(fn (i) {
      let o = ops is Array && i < ops.size() && ops[i] is Object ? ops[i] : {}
      numbers(o, d.ops[i], RANGES.op)
    }),
    ...numbers(given, d, RANGES.patch),
  }
}

# The player's presets and settings live in `dir`: a file name made of the
# preset's name, percent-encoded so that no two names share one.
let file_of = |dir, name| FS.join(
  dir,
  "presets",
  "{Encoding.url.encode(name)}.json",
)

# A store of the player's presets in `dir`.
class Store {
  new(dir: String) {
    @dir = dir
  }
  # The player's presets, by name, in order of name.
  mine() {
    let folder = FS.join(@dir, "presets")
    return [] unless FS.is_dir(folder)
    FS.list_dir(folder).filter(|f| FS.extension(f) == ".json").map(fn (f) {
      try {
        whole(JSON.parse(FS.read(FS.join(folder, f))))
      } catch _ {
        nil
      }
    }).filter(|p| p != nil).sorted_by(|p| p.name.lower())
  }
  # Every preset's name: the app's, then the player's.
  names() {
    {factory: FACTORY_NAMES, mine: self.mine().map(|p| p.name)}
  }
  # The preset named `name`: the player's first, so one of theirs is never hidden.
  find(name: String) {
    self.mine().find(|p| p.name == name) ?? FACTORY.find(|p| p.name == name)
  }
  # `p` kept as the player's preset `name`; a name the app's presets have is
  # refused, as the app's presets do not change.
  save(name: String, p) {
    let n = name.trim()
    throw "give the preset a name" if n.empty()
    throw "\"{n}\" is one of the app's presets: give yours another name" if FACTORY_NAMES.contains(n)
    FS.mkdir(FS.join(@dir, "presets"))
    FS.write(file_of(@dir, n), JSON.stringify(whole(p, n), indent: 2))
    n
  }
  delete(name: String) {
    let f = file_of(@dir, name)
    FS.remove(f) if FS.exists(f)
  }
  # The settings kept between runs (the patch last played, each input's
  # mode, the breath's source); {} when there are none, or the file holds
  # anything but an object.
  settings() {
    let f = FS.join(@dir, "settings.json")
    let read = try {
      FS.exists(f) ? JSON.parse(FS.read(f)) : {}
    } catch _ {
      {}
    }
    read is Object ? read : {}
  }
  keep_settings(s) {
    FS.mkdir(@dir)
    FS.write(FS.join(@dir, "settings.json"), JSON.stringify(s, indent: 2))
  }
}

# The app's folder, where the platform keeps a program's data.
let app_dir = || Sys.data_dir("culebra-fm-synth")

export {FACTORY, RANGES, whole, Store, app_dir}
