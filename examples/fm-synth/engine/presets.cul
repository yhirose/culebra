# The patches: the ones that come with the app, the player's own (one JSON
# file each in the app's folder), and what makes any of them whole.
#
# A patch: `algorithm` (a key of fm.ALGORITHMS), `ops` (three operators, each
# a `ratio` to the note, a `detune` in cents, a `level` 0..100, and an
# envelope: `attack`, `decay`, `release` in seconds and `sustain` 0..100),
# `feedback` 0..100 (operator 3's), `volume` 0..100, `reverb` 0..100, and
# for a wind controller `breath_bright` 0..100 (how much the breath opens the
# modulators) and `glide` (seconds from note to note).

import fm from './fm.cul'

fn op(ratio, level, attack, decay, sustain, release, detune = 0.0) {
  {ratio, detune, level, attack, decay, sustain, release}
}

fn patch(
  name,
  algorithm,
  ops,
  feedback = 0.0,
  reverb = 20.0,
  breath_bright = 50.0,
  glide = 0.03,
  volume = 75.0,
) {
  {name, algorithm, ops, feedback, volume, reverb, breath_bright, glide}
}

let FACTORY = [
