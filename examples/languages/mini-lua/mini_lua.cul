# A slice of Lua 5.4, compiled to Core-IR.
#
# `PEG` for the syntax and `CodeGen` for everything after it. What is here is
# Lua's grammar, its scope rules and its lowering; `lua` itself is the oracle
# the samples are checked against.
#
# Lua is the front end for the parts of the IR the others do not reach:
#
#   * **A block's own bindings.** `local x` twice in one block is two
#     bindings, and the second hides the first from there on. Every other
#     front end here reuses the slot; Lua is why `Resolver.declared_index`
#     answers per declaration rather than per name.
#   * **Coroutines in their user-facing form** -- `coroutine.create` /
#     `resume` / `yield` / `status`, which is what CoroCreate and friends
#     are made of.
#   * **Tail calls**, which Lua is one of the few languages to *guarantee*,
#     so `lua` is a real oracle for them and not just a faster path.
#
#   * **Metatables**, which are how one value answers for the events another
#     language would put in the VM: what `a + b` means, what a missing key
#     reads as, what a call on something that is not a function does.
#
# Two things shape everything below. A Lua call hands over one list and gets
# one back, because a Lua function takes and answers any number of values
# and the IR's does neither -- so a call is `f(args)` with one argument, and
# the names on both sides read out of it. And the tree is walked twice: the
# first pass opens the scopes and settles what every name means, because a
# capture's index has to stop moving before any read of it is built.
#
# Where Lua's semantics differ from the VM's defaults, the answer is a func
# written here in the IR and spliced ahead of the program: what is true
# (only nil and false are false, where the VM calls 0 false too), how `%`
# and `//` round (toward negative infinity, where the VM truncates), what
# `==` means across two types, and how a float prints. The last of those is
# the one thing asked of the host instead, because "%.14g" is not an IR node.
#
# Run it:  culebra examples/languages/mini-lua/mini_lua.cul FILE.lua
#          culebra examples/languages/mini-lua/mini_lua.cul --ir FILE.lua

let grammar = `
  program    <- _ block !.                                  { no_ast_opt }
  block      <- stmt*                                       { no_ast_opt }

  stmt       <- emptystmt / localfn / localdecl / fnstat / ifstat / whilestat
              / repeatstat / fornum / forin / dostat / breakstat / retstat
              / assign / callstmt

  emptystmt  <- ';' _                                       { no_ast_opt }
  localfn    <- 'local' __ 'function' __ ident funcbody
  localdecl  <- 'local' __ namelist ('=' ![=] _ exprlist)?   { no_ast_opt }
  namelist   <- ident (',' _ ident)*                         { no_ast_opt }
  exprlist   <- expr (',' _ expr)*                           { no_ast_opt }

  fnstat     <- 'function' __ funcname funcbody
  funcname   <- ident (dotname / colonname)*                 { no_ast_opt }
  dotname    <- '.' _ ident                                  { no_ast_opt }
  colonname  <- ':' _ ident                                  { no_ast_opt }
  funcbody   <- '(' _ params ')' _ block 'end' __
  params     <- (ident (',' _ ident)*)? ','? _               { no_ast_opt }

  ifstat     <- 'if' __ expr 'then' __ block elseifpart* elsepart? 'end' __
  elseifpart <- 'elseif' __ expr 'then' __ block
  elsepart   <- 'else' __ block                              { no_ast_opt }
  whilestat  <- 'while' __ expr 'do' __ block 'end' __
  repeatstat <- 'repeat' __ block 'until' __ expr
  fornum     <- 'for' __ ident '=' ![=] _ expr ',' _ expr forstep? 'do' __
                block 'end' __
  forstep    <- ',' _ expr                                   { no_ast_opt }
  forin      <- 'for' __ namelist 'in' __ exprlist 'do' __ block 'end' __
  dostat     <- 'do' __ block 'end' __                       { no_ast_opt }
  breakstat  <- 'break' __                                   { no_ast_opt }
  retstat    <- 'return' __ exprlist? ';'? _                 { no_ast_opt }
  assign     <- varlist '=' ![=] _ exprlist
  varlist    <- suffixedexp (',' _ suffixedexp)*             { no_ast_opt }
  callstmt   <- suffixedexp                                  { no_ast_opt }

  expr       <- orexp
  orexp      <- andexp ('or' __ andexp)*
  andexp     <- cmpexp ('and' __ cmpexp)*
  cmpexp     <- concatexp (cmpop concatexp)*
  cmpop      <- < '==' / '~=' / '<=' / '>=' / '<' / '>' > _
  concatexp  <- addexp ('..' ![.] _ addexp)*
  addexp     <- mulexp (addop mulexp)*
  addop      <- < '+' / '-' ![-] > _
  mulexp     <- unaryexp (mulop unaryexp)*
  mulop      <- < '//' / '*' / '/' / '%' > _

  unaryexp   <- notexp / negexp / lenexp / powexp
  notexp     <- 'not' __ unaryexp                            { no_ast_opt }
  negexp     <- '-' ![-] _ unaryexp                          { no_ast_opt }
  lenexp     <- '#' _ unaryexp                               { no_ast_opt }
  powexp     <- suffixedexp powpart?
  powpart    <- '^' _ unaryexp                               { no_ast_opt }

  suffixedexp <- primaryexp suffix*
  suffix     <- callsfx / methodsfx / dotsfx / indexsfx
  callsfx    <- '(' _ args ')' _ / strargsfx                 { no_ast_opt }
  strargsfx  <- string                                       { no_ast_opt }
  args       <- (expr (',' _ expr)*)? ','? _                 { no_ast_opt }
  methodsfx  <- ':' _ ident '(' _ args ')' _                 { no_ast_opt }
  dotsfx     <- '.' _ ident                                  { no_ast_opt }
  indexsfx   <- '[' _ expr ']' _                             { no_ast_opt }

  primaryexp <- funcexpr / tablector / float / number / string / literal
              / ident / paren
  paren      <- '(' _ expr ')' _                             { no_ast_opt }
  funcexpr   <- 'function' __ funcbody                       { no_ast_opt }

  tablector  <- '{' _ (field (fieldsep field)*)? fieldsep? _ '}' _
                                                             { no_ast_opt }
  field      <- keyedfield / namedfield / expr
  keyedfield <- '[' _ expr ']' _ '=' ![=] _ expr
  namedfield <- ident '=' ![=] _ expr
  ~fieldsep  <- (',' / ';') _

  literal    <- < ('true' / 'false' / 'nil') ![a-zA-Z0-9_] > _
  float      <- < [0-9]+ '.' [0-9]* ([eE] [-+]? [0-9]+)?
                / [0-9]+ [eE] [-+]? [0-9]+ > _
  number     <- < [0-9]+ > _
  string     <- ['] < (!['\\] . / '\\' .)* > ['] _
              / ["] < (!["\\] . / '\\' .)* > ["] _
  ident      <- !keyword < [a-zA-Z_] [a-zA-Z0-9_]* > _
  ~keyword   <- ('and' / 'break' / 'do' / 'elseif' / 'else' / 'end' / 'false'
               / 'for' / 'function' / 'goto' / 'if' / 'in' / 'local' / 'nil'
               / 'not' / 'or' / 'repeat' / 'return' / 'then' / 'true'
               / 'until' / 'while') ![a-zA-Z0-9_]

  ~_         <- ([ \t\r\n] / '--' [^\n]*)*
  ~__        <- ![a-zA-Z0-9_] _
`

fn fail(node, msg) {
  throw {kind: 'LuaError', message: msg, line: node.line, col: node.column}
}

# --- The runtime this front end writes in its own IR ------------------------
#
# Lua's semantics differ from the VM's defaults in a handful of places, and
# each difference is one func built here: what is true (only nil and false
# are false, where the VM calls 0 false too), how `//` and `%` round (toward
# negative infinity, where the VM truncates), what `==` means across two
# types (false, where the VM refuses the comparison), and how a value prints.
#
# They are funcs rather than inlined shapes because every call site would
# otherwise carry the whole test; each is capture-free, so `set_singleton`
# makes every call name one closure.

# Every helper is registered before any body is built, because one calls
# another and a call names its callee's index as it builds the node.
mut rt_pending = []

# A helper's parent is the root frame, so the one that reads the string
# metatable can capture it. Every other helper is capture-free and stays a
# singleton -- `set_singleton` is gated on the capture count, not on this.
fn rt_func(name, nparams, nlocals, build) {
  let f = new_func(name, nil, root_fn)
  globals_fn[name] = f
  rt_params[f] = nparams
  rt_locals[f] = nlocals
  rt_pending.push((f, build))
  f
}

fn rt_finish() {
  for (f, build) in rt_pending {
    rt_body[f] = build(f)
  }
}

fn L(i) {
  m.var_ref('local', i, AT)
}

fn S(v) {
  m.str_literal(v, AT)
}

# 'a'..'z' is 97..122; subtracting 32 is the same letter in upper case.
fn uppercase_byte(b) {
  m.make_if_else(
    m.make_if_else(
      m.binary('ge', b, m.literal(97, AT), AT),
      m.binary('le', b, m.literal(122, AT), AT),
      m.bool_literal(false, AT),
      AT,
    ),
    m.binary('sub', b, m.literal(32, AT), AT),
    b,
    AT,
  )
}

# `s:upper()` and `("x"):rep(3)`, as a chain over the names string.* has.
fn str_method(f, key) {
  mut acc = m.nil_literal(AT)
  for (gname, helper, arity) in string_lib {
    acc = m.make_if_else(
      m.binary('eq', key, S(gname), AT),
      rs.closure(m, f, globals_fn["lua:string.{gname}"], AT),
      acc,
      AT,
    )
  }
  acc
}

# The metatable key: a string Lua source cannot write, because a Lua string
# literal in this grammar never carries a NUL byte.
fn mt_key() {
  m.str_literal("\u0000mt", AT)
}

# The metamethod for a binary event, taken from the left operand and then
# the right -- Lua's order.
fn binary_mm(f, event) {
  m.make_if_else(
    is_type(call_rt(f, '__mm', [L(0), event], AT), 'nil'),
    call_rt(f, '__mm', [L(1), event], AT),
    call_rt(f, '__mm', [L(0), event], AT),
    AT,
  )
}

# There is no unary `not` in the IR; the shape it would have is this.
fn negate(b) {
  m.make_if_else(b, m.bool_literal(false, AT), m.bool_literal(true, AT), AT)
}

fn is_type(v, t) {
  m.binary('eq', m.intrinsic('typeof', [v], AT), S(t), AT)
}

fn ret(v) {
  m.make_return(v, AT)
}

fn runtime() {
  # __truthy(v): only nil and false are false
  rt_func('__truthy', 1, 1, fn (f) {
    m.make_if_else(
      is_type(L(0), 'nil'),
      ret(m.bool_literal(false, AT)),
      m.make_if_else(
        is_type(L(0), 'bool'),
        ret(L(0)),
        ret(m.bool_literal(true, AT)),
        AT,
      ),
      AT,
    )
  })
  rt_func('__not', 1, 1, fn (f) {
    ret(m.make_if_else(
      call_rt(f, '__truthy', [L(0)], AT),
      m.bool_literal(false, AT),
      m.bool_literal(true, AT),
      AT,
    ))
  })
  # Two values of different types are never equal in Lua, where the VM
  # refuses the comparison; and two tables are equal only when they are the
  # same table, which is `same` rather than `eq` -- the VM refuses that one
  # too.
  rt_func('__eq', 2, 3, fn (f) {
    m.block(
      [
        # Lua's two number types compare across the line -- 1 == 1.0 -- so
        # the type test is on Lua's names rather than the VM's
        m.make_if(
          m.binary(
            'ne',
            call_rt(f, '__type', [L(0)], AT),
            call_rt(f, '__type', [L(1)], AT),
            AT,
          ),
          ret(m.bool_literal(false, AT)),
          AT,
        ),
        m.make_if(
          m.make_if_else(
            is_type(L(0), 'map'),
            m.bool_literal(true, AT),
            is_type(L(0), 'function'),
            AT,
          ),
          m.block(
            [
              m.make_if(
                m.intrinsic('same', [L(0), L(1)], AT),
                ret(m.bool_literal(true, AT)),
                AT,
              ),
              # two different tables are equal only if __eq says so
              m.assign('local', 2, binary_mm(f, S('__eq')), AT),
              m.make_if(
                negate(is_type(L(2), 'nil')),
                ret(call_rt(f, '__truthy', [one(
                  f,
                  m.call_value(L(2), [m.array_lit([L(0), L(1)], AT)], AT),
                  AT,
                )], AT)),
                AT,
              ),
              ret(m.bool_literal(false, AT)),
            ],
            AT,
          ),
          AT,
        ),
        ret(m.binary('eq', L(0), L(1), AT)),
      ],
      AT,
    )
  })
  rt_func('__ne', 2, 2, fn (f) {
    ret(call_rt(f, '__not', [call_rt(f, '__eq', [L(0), L(1)], AT)], AT))
  })
  # the four orderings are the VM's, on operands of one type
  for (
    nm,
    op,
  ) in [('__lt', 'lt'), ('__le', 'le'), ('__gt', 'gt'), ('__ge', 'ge')] {
    rt_func(nm, 2, 2, fn (f) {
      ret(m.binary(op, L(0), L(1), AT))
    })
  }
  # `a + b` on a table is whichever operand carries the metamethod, which
  # is Lua's rule for every binary event
  for (nm, op) in [('__add', 'add'), ('__sub', 'sub'), ('__mul', 'mul')] {
    rt_func(nm, 2, 3, fn (f) {
      m.block(
        [
          m.assign('local', 2, binary_mm(f, S(nm)), AT),
          m.make_if(
            negate(is_type(L(2), 'nil')),
            ret(one(
              f,
              m.call_value(L(2), [m.array_lit([L(0), L(1)], AT)], AT),
              AT,
            )),
            AT,
          ),
          ret(m.binary(op, L(0), L(1), AT)),
        ],
        AT,
      )
    })
  }
  # `/` is always a float in Lua
  rt_func('__div', 2, 2, fn (f) {
    ret(m.binary(
      'div',
      m.intrinsic('todouble', [L(0)], AT),
      m.intrinsic('todouble', [L(1)], AT),
      AT,
    ))
  })
  # `^` is always a float in Lua, so 2^10 is 1024.0 rather than 1024
  rt_func('__pow', 2, 2, fn (f) {
    ret(m.intrinsic('todouble', [m.intrinsic('pow', [L(0), L(1)], AT)], AT))
  })
  # `//` floors where the VM truncates: a negative quotient that did not
  # divide exactly is one too high
  rt_func('__idiv', 2, 3, fn (f) {
    let q = L(2)
    m.block(
      [
        m.assign('local', 2, m.binary('div', L(0), L(1), AT), AT),
        m.make_if(
          m.make_if_else(
            m.binary('lt', q, m.literal(0, AT), AT),
            m.binary('ne', m.binary('mul', q, L(1), AT), L(0), AT),
            m.bool_literal(false, AT),
            AT,
          ),
          ret(m.binary('sub', q, m.literal(1, AT), AT)),
          AT,
        ),
        ret(q),
      ],
      AT,
    )
  })
  # and `%` follows `//`, so it takes the divisor's sign
  rt_func('__mod', 2, 3, fn (f) {
    let r = L(2)
    m.block(
      [
        m.assign('local', 2, m.binary('mod', L(0), L(1), AT), AT),
        m.make_if(
          m.make_if_else(
            m.binary('ne', r, m.literal(0, AT), AT),
            m.binary('lt', m.binary('mul', r, L(1), AT), m.literal(0, AT), AT),
            m.bool_literal(false, AT),
            AT,
          ),
          ret(m.binary('add', r, L(1), AT)),
          AT,
        ),
        ret(r),
      ],
      AT,
    )
  })
  rt_func('__cat', 2, 2, fn (f) {
    ret(m.binary(
      'add',
      call_rt(f, '__str', [L(0)], AT),
      call_rt(f, '__str', [L(1)], AT),
      AT,
    ))
  })
  # Lua renders a float with "%.14g" and then keeps a `.0` on one that came
  # out looking like an integer. Neither is an IR node, and writing 14
  # significant digits as a loop over digits would be a worse answer than
  # asking the host -- so the module declares a native and `run` supplies
  # it. That is the one thing here the IR deliberately does not have.
  rt_func('__str', 1, 2, fn (f) {
    m.block(
      [
        m.make_if(is_type(L(0), 'string'), ret(L(0)), AT),
        m.assign(
          'local',
          1,
          call_rt(f, '__mm', [L(0), S('__tostring')], AT),
          AT,
        ),
        m.make_if(
          negate(is_type(L(1), 'nil')),
          ret(one(f, m.call_value(L(1), [m.array_lit([L(0)], AT)], AT), AT)),
          AT,
        ),
        m.make_if(
          is_type(L(0), 'double'),
          ret(m.call_value(m.native_ref(native_fmt, AT), [L(0)], AT)),
          AT,
        ),
        ret(m.intrinsic('tostr', [L(0)], AT)),
      ],
      AT,
    )
  })

  # A table is an Object, and a key carries its own type: `t[1]` and `t["1"]`
  # are different keys in Lua, so a number is stored under "n1" and a string
  # under "s1". Nothing else in the front end has to know that.
  # whether a rendered number already shows it is a float
  rt_func('__hasfrac', 1, 3, fn (f) {
    m.block(
      [
        m.assign('local', 1, m.literal(0, AT), AT),
        m.assign('local', 2, m.intrinsic('len', [L(0)], AT), AT),
        m.make_while(
          m.binary('lt', L(1), L(2), AT),
          m.block(
            [
              m.make_if(
                m.make_if_else(
                  m.binary(
                    'eq',
                    m.intrinsic('strbyte', [L(0), L(1)], AT),
                    m.literal(46, AT),
                    AT,
                  ),
                  m.bool_literal(true, AT),
                  m.binary(
                    'eq',
                    m.intrinsic('strbyte', [L(0), L(1)], AT),
                    m.literal(101, AT),
                    AT,
                  ),
                  AT,
                ),
                ret(m.bool_literal(true, AT)),
                AT,
              ),
              m.assign(
                'local',
                1,
                m.binary('add', L(1), m.literal(1, AT), AT),
                AT,
              ),
            ],
            AT,
          ),
          AT,
        ),
        ret(m.bool_literal(false, AT)),
      ],
      AT,
    )
  })

  rt_func('__newtable', 0, 0, fn (f) {
    ret(m.intrinsic('mapnew', [], AT))
  })
  # A table's keys are the values themselves -- the Map is value-keyed, so
  # `t[1]` and `t["1"]` are already different slots. The one rule to apply
  # is Lua's: a float with no fraction is the same key as the integer, so
  # `t[1.0]` overwrites `t[1]`.
  rt_func('__key', 1, 1, fn (f) {
    ret(m.make_if_else(
      is_type(L(0), 'double'),
      m.make_if_else(
        m.binary(
          'eq',
          m.intrinsic('todouble', [m.intrinsic('toint', [L(0)], AT)], AT),
          L(0),
          AT,
        ),
        m.intrinsic('toint', [L(0)], AT),
        L(0),
        AT,
      ),
      L(0),
      AT,
    ))
  })
  # Every string shares one metatable in Lua, whose __index is the string
  # library. Lua keeps that metatable in the registry rather than on the
  # value, and the IR has no module-level storage to answer it the same way.
  # The library is a closed set here, so the lookup is written out: no
  # registry, and no binding for a helper to capture.
  # A table's metatable lives in the table, under a key Lua source cannot
  # write: the Map is value-keyed and every Lua string key is a Lua string,
  # so a key with a NUL byte in it is reachable from here and nowhere else.
  # Real Lua keeps the metatable beside the table rather than in it; the
  # difference shows only in `pairs`, which skips the key for that reason.
  rt_func('__meta', 1, 1, fn (f) {
    ret(m.make_if_else(
      is_type(L(0), 'map'),
      m.index(L(0), mt_key(), AT),
      m.nil_literal(AT),
      AT,
    ))
  })
  # `h(mt, event)`: the metamethod a metatable carries, or nil
  rt_func('__mm', 2, 3, fn (f) {
    m.block(
      [
        m.assign('local', 2, call_rt(f, '__meta', [L(0)], AT), AT),
        ret(m.make_if_else(
          is_type(L(2), 'map'),
          m.index(L(2), L(1), AT),
          m.nil_literal(AT),
          AT,
        )),
      ],
      AT,
    )
  })
  # a raw read and a raw write, which `rawget` / `rawset` are and which
  # __index / __newindex fall back to
  rt_func('__rawget', 2, 2, fn (f) {
    ret(m.index(L(0), call_rt(f, '__key', [L(1)], AT), AT))
  })
  rt_func('__rawset', 3, 3, fn (f) {
    m.block(
      [
        m.make_if(
          is_type(L(2), 'nil'),
          ret(m.intrinsic(
            'objectremove',
            [L(0), call_rt(f, '__key', [L(1)], AT)],
            AT,
          )),
          AT,
        ),
        ret(m.set_index(L(0), call_rt(f, '__key', [L(1)], AT), L(2), AT)),
      ],
      AT,
    )
  })
  rt_func('__setmeta', 2, 2, fn (f) {
    m.block([m.set_index(L(0), mt_key(), L(1), AT), ret(L(0))], AT)
  })

  rt_func('__get', 2, 3, fn (f) {
    m.block(
      [
        m.make_if(is_type(L(0), 'string'), ret(str_method(f, L(1))), AT),
        m.assign('local', 2, call_rt(f, '__rawget', [L(0), L(1)], AT), AT),
        m.make_if(negate(is_type(L(2), 'nil')), ret(L(2)), AT),
        # a miss consults __index: a function answers the read, a table is
        # read in turn -- and that read consults its own __index
        m.assign('local', 2, call_rt(f, '__mm', [L(0), S('__index')], AT), AT),
        m.make_if(
          is_type(L(2), 'function'),
          ret(one(f, m.call_value(L(2), [m.array_lit([L(0), L(1)], AT)], AT),
                  AT)),
          AT,
        ),
        m.make_if(
          is_type(L(2), 'map'),
          ret(call_rt(f, '__get', [L(2), L(1)], AT)),
          AT,
        ),
        ret(m.nil_literal(AT)),
      ],
      AT,
    )
  })
  # __newindex sees only a key the table does not already have; assigning
  # nil removes the key, which is what makes `#t` and `pairs` agree with Lua
  # after `t[2] = nil`
  rt_func('__set', 3, 4, fn (f) {
    m.block(
      [
        m.assign(
          'local',
          3,
          m.intrinsic('objecthas', [L(0), call_rt(f, '__key', [L(1)], AT)], AT),
          AT,
        ),
        m.make_if(
          negate(L(3)),
          m.block(
            [
              m.assign(
                'local',
                3,
                call_rt(f, '__mm', [L(0), S('__newindex')], AT),
                AT,
              ),
              m.make_if(
                is_type(L(3), 'function'),
                ret(one(
                  f,
                  m.call_value(L(3), [m.array_lit([L(0), L(1), L(2)], AT)], AT),
                  AT,
                )),
                AT,
              ),
              m.make_if(
                is_type(L(3), 'map'),
                ret(call_rt(f, '__set', [L(3), L(1), L(2)], AT)),
                AT,
              ),
            ],
            AT,
          ),
          AT,
        ),
        ret(call_rt(f, '__rawset', [L(0), L(1), L(2)], AT)),
      ],
      AT,
    )
  })
  # `#t` counts from 1 until the first hole; `#s` is the string's length
  rt_func('__len', 1, 2, fn (f) {
    m.block(
      [
        m.make_if(
          is_type(L(0), 'string'),
          ret(m.intrinsic('len', [L(0)], AT)),
          AT,
        ),
        m.assign('local', 1, m.literal(0, AT), AT),
        m.make_while(
          m.intrinsic(
            'objecthas',
            [
              L(0),
              call_rt(
                f,
                '__key',
                [m.binary('add', L(1), m.literal(1, AT), AT)],
                AT,
              ),
            ],
            AT,
          ),
          m.assign('local', 1, m.binary('add', L(1), m.literal(1, AT), AT), AT),
          AT,
        ),
        ret(L(1)),
      ],
      AT,
    )
  })
  # `type(v)` answers Lua's name for a value's kind, not the VM's
  rt_func('__type', 1, 2, fn (f) {
    m.block(
      [
        m.assign('local', 1, m.intrinsic('typeof', [L(0)], AT), AT),
        m.make_if(m.binary('eq', L(1), S('bool'), AT), ret(S('boolean')), AT),
        m.make_if(m.binary('eq', L(1), S('map'), AT), ret(S('table')), AT),
        m.make_if(
          m.binary('eq', L(1), S('coroutine'), AT),
          ret(S('thread')),
          AT,
        ),
        m.make_if(m.binary('eq', L(1), S('int'), AT), ret(S('number')), AT),
        m.make_if(m.binary('eq', L(1), S('double'), AT), ret(S('number')), AT),
        ret(L(1)),
      ],
      AT,
    )
  })
  # A call on something that is not a function is `__call`, with the value
  # itself as the first argument.
  rt_func('__callv', 2, 3, fn (f) {
    m.block(
      [
        m.make_if(
          is_type(L(0), 'function'),
          ret(m.call_value(L(0), [L(1)], AT)),
          AT,
        ),
        m.assign('local', 2, call_rt(f, '__mm', [L(0), S('__call')], AT), AT),
        m.make_if(
          is_type(L(2), 'nil'),
          m.make_throw(
            m.str_literal('attempt to call a non-function value', AT),
            AT,
          ),
          AT,
        ),
        ret(m.call_value(
          L(2),
          [call_rt(f, '__append', [m.array_lit([L(0)], AT), L(1)], AT)],
          AT,
        )),
      ],
      AT,
    )
  })

  # A Lua call hands over one list and gets one back, so building an
  # argument list is appending one list to another, and reading a value out
  # of either is a read that answers nil past the end -- Lua's rule for both
  # a missing argument and a value the callee did not return.
  rt_func('__append', 2, 3, fn (f) {
    m.block(
      [
        m.assign('local', 2, m.literal(0, AT), AT),
        m.make_while(
          m.binary('lt', L(2), m.intrinsic('len', [L(1)], AT), AT),
          m.block(
            [
              m.intrinsic('arraypush', [L(0), m.index(L(1), L(2), AT)], AT),
              m.assign(
                'local',
                2,
                m.binary('add', L(2), m.literal(1, AT), AT),
                AT,
              ),
            ],
            AT,
          ),
          AT,
        ),
        ret(L(0)),
      ],
      AT,
    )
  })
  rt_func('__nth', 2, 2, fn (f) {
    ret(m.make_if_else(
      m.binary('lt', L(1), m.intrinsic('len', [L(0)], AT), AT),
      m.index(L(0), L(1), AT),
      m.nil_literal(AT),
      AT,
    ))
  })
  # `{f()}` puts every value f answered into the table, from `start` on
  rt_func('__spread', 3, 4, fn (f) {
    m.block(
      [
        m.assign('local', 3, m.literal(0, AT), AT),
        m.make_while(
          m.binary('lt', L(3), m.intrinsic('len', [L(2)], AT), AT),
          m.block(
            [
              call_rt(
                f,
                '__set',
                [
                  L(0),
                  m.binary('add', L(1), L(3), AT),
                  m.index(L(2), L(3), AT),
                ],
                AT,
              ),
              m.assign(
                'local',
                3,
                m.binary('add', L(3), m.literal(1, AT), AT),
                AT,
              ),
            ],
            AT,
          ),
          AT,
        ),
        ret(L(0)),
      ],
      AT,
    )
  })

  # --- the standard-library slice the samples reach --------------------
  #
  # Each is a plain helper answering one value; the adapters below wrap them
  # into the return list a Lua call expects.

  # string.upper / string.sub, over the VM's byte view of a string
  rt_func('__strupper', 1, 4, fn (f) {
    m.block(
      [
        m.assign('local', 1, S(''), AT),
        m.assign('local', 2, m.literal(0, AT), AT),
        m.assign('local', 3, m.intrinsic('len', [L(0)], AT), AT),
        m.make_while(
          m.binary('lt', L(2), L(3), AT),
          m.block(
            [
              m.assign(
                'local',
                1,
                m.binary(
                  'add',
                  L(1),
                  m.intrinsic(
                    'strfrombyte',
                    [uppercase_byte(m.intrinsic('strbyte', [L(0), L(2)], AT))],
                    AT,
                  ),
                  AT,
                ),
                AT,
              ),
              m.assign(
                'local',
                2,
                m.binary('add', L(2), m.literal(1, AT), AT),
                AT,
              ),
            ],
            AT,
          ),
          AT,
        ),
        ret(L(1)),
      ],
      AT,
    )
  })
  # Lua's string.sub is 1-based and inclusive at both ends. A missing end
  # runs to the string's, and a negative start counts back from it.
  rt_func('__strsub', 3, 4, fn (f) {
    m.block(
      [
        m.assign('local', 3, m.intrinsic('len', [L(0)], AT), AT),
        ret(m.intrinsic(
          'strslice',
          [
            L(0),
            m.make_if_else(
              m.binary('lt', L(1), m.literal(0, AT), AT),
              m.binary('add', L(3), L(1), AT),
              m.binary('sub', L(1), m.literal(1, AT), AT),
              AT,
            ),
            m.make_if_else(is_type(L(2), 'nil'), L(3), L(2), AT),
          ],
          AT,
        )),
      ],
      AT,
    )
  })
  rt_func('__strrep', 2, 4, fn (f) {
    m.block(
      [
        m.assign('local', 2, S(''), AT),
        m.assign('local', 3, m.literal(0, AT), AT),
        m.make_while(
          m.binary('lt', L(3), L(1), AT),
          m.block(
            [
              m.assign('local', 2, m.binary('add', L(2), L(0), AT), AT),
              m.assign(
                'local',
                3,
                m.binary('add', L(3), m.literal(1, AT), AT),
                AT,
              ),
            ],
            AT,
          ),
          AT,
        ),
        ret(L(2)),
      ],
      AT,
    )
  })
  # table.insert(t, v) appends; table.concat(t, sep) joins 1..#t
  rt_func('__tabinsert', 2, 2, fn (f) {
    ret(call_rt(
      f,
      '__set',
      [
        L(0),
        m.binary('add', call_rt(f, '__len', [L(0)], AT), m.literal(1, AT), AT),
        L(1),
      ],
      AT,
    ))
  })
  rt_func('__tabconcat', 2, 4, fn (f) {
    m.block(
      [
        m.assign('local', 2, S(''), AT),
        m.assign('local', 3, m.literal(1, AT), AT),
        m.make_while(
          m.binary('le', L(3), call_rt(f, '__len', [L(0)], AT), AT),
          m.block(
            [
              m.make_if(
                m.binary('gt', L(3), m.literal(1, AT), AT),
                m.assign('local', 2, m.binary('add', L(2), L(1), AT), AT),
                AT,
              ),
              m.assign(
                'local',
                2,
                m.binary(
                  'add',
                  L(2),
                  call_rt(
                    f,
                    '__str',
                    [call_rt(f, '__get', [L(0), L(3)], AT)],
                    AT,
                  ),
                  AT,
                ),
                AT,
              ),
              m.assign(
                'local',
                3,
                m.binary('add', L(3), m.literal(1, AT), AT),
                AT,
              ),
            ],
            AT,
          ),
          AT,
        ),
        ret(L(2)),
      ],
      AT,
    )
  })

  # `math.type` separates the two Lua number types the VM already keeps apart
  rt_func('__mathtype', 1, 2, fn (f) {
    m.block(
      [
        m.assign('local', 1, m.intrinsic('typeof', [L(0)], AT), AT),
        m.make_if(m.binary('eq', L(1), S('int'), AT), ret(S('integer')), AT),
        m.make_if(m.binary('eq', L(1), S('double'), AT), ret(S('float')), AT),
        ret(m.nil_literal(AT)),
      ],
      AT,
    )
  })
}

# --- the binder -------------------------------------------------------------

mut m = nil
mut rs = nil
mut funcs = []       # per func: {name, params, body, node}
mut nslots = []      # per func: locals handed out
mut scope_base = []  # per func: where its own scopes start on the one stack
mut root_fn = -1
mut g_var = -1       # the root frame's binding for the globals table
mut globals_fn = {}  # prelude func name -> its func id
mut pending = []     # closures whose bodies are not written yet
mut rt_body = {}     # runtime helper -> its body, built in IR here
mut rt_params = {}
mut rt_locals = {}
mut native_fmt = -1  # the host function that renders a float Lua's way
mut chunk = ''       # the program's name, as `error` reports it

let AT = {line: 1, column: 1}

fn new_func(name, node, parent) {
  let f = funcs.size()
  funcs.push({name: name, params: [], mut body: nil, mut node: node})
  rs.new_fn(cond {
    parent == nil => -1,
    _ => parent,
  })
  rs.set_func_index(f, f)
  nslots.push(0)
  scope_base.push(-1)
  f
}

fn enter_scope(f) {
  rs.push_scope()
  if scope_base[f] == -1 {
    scope_base[f] = rs.depth() - 1
  }
}

fn leave_scope(f) {
  rs.pop_scope()
}

# `local x` twice in one block is two bindings, and the second hides the
# first from there on -- so this always declares rather than reusing what
# the name already means. That is the rule no other front end here has.
fn declare(f, name, node) {
  let v = rs.declare(name, f)
  rs.set_var_slot(v, nslots[f])
  nslots[f] = nslots[f] + 1
  v
}

# --- Values -----------------------------------------------------------------
#
# A Lua function returns a list of values, because Lua's calling convention
# is not the IR's: `return 1, 2` is one Return of an array, and a call in
# single-value position takes element 0. The cost is an array per call; the
# alternative is a second return channel the IR does not have.
#
# A Lua table is a value-keyed Map, so `t[1]` and `t["1"]` are different
# slots with no encoding to do. The binder only ever calls __get / __set,
# which apply the one rule the Map does not: 1.0 is the key 1.

# Every helper above answers one value; a Lua call answers a list. One
# adapter per library name bridges the two, and the same adapter is what
# both the library table and the string metatable hold.
mut adapters = []

# `pairs` and `ipairs` answer three values each, so they are written in the
# Lua convention directly rather than through an adapter over a helper that
# answers one. So are the two steppers they hand back.
fn luafn(gname, nlocals, build) {
  let fid = new_func("lua {gname}", nil, root_fn)
  globals_fn["lua:{gname}"] = fid
  rt_params[fid] = 1
  rt_locals[fid] = nlocals
  rt_pending.push((fid, build))
  fid
}

# A generic `for` calls `it(state, control)` until the first value is nil.
# ipairs walks 1, 2, 3 until a hole; pairs walks the keys the table has now,
# with the walk's own position kept in the state rather than recovered from
# the control -- which keeps a step O(1) instead of a search.
fn register_iterators() {
  # everything after the first value: what pcall and the coroutine calls
  # hand on to the function they are given
  rt_func('__rest', 1, 3, fn (f) {
    m.block(
      [
        m.assign('local', 1, m.array_lit([], AT), AT),
        m.assign('local', 2, m.literal(1, AT), AT),
        m.make_while(
          m.binary('lt', L(2), m.intrinsic('len', [L(0)], AT), AT),
          m.block(
            [
              m.intrinsic('arraypush', [L(1), m.index(L(0), L(2), AT)], AT),
              m.assign(
                'local',
                2,
                m.binary('add', L(2), m.literal(1, AT), AT),
                AT,
              ),
            ],
            AT,
          ),
          AT,
        ),
        ret(L(1)),
      ],
      AT,
    )
  })

  # the keys a table has, minus the one the metatable hides under
  rt_func('__keys', 1, 4, fn (f) {
    m.block(
      [
        m.assign('local', 1, m.array_lit([], AT), AT),
        m.assign('local', 2, m.intrinsic('objectkeys', [L(0)], AT), AT),
        m.assign('local', 3, m.literal(0, AT), AT),
        m.make_while(
          m.binary('lt', L(3), m.intrinsic('len', [L(2)], AT), AT),
          m.block(
            [
              m.make_if(
                m.binary('ne', m.index(L(2), L(3), AT), mt_key(), AT),
                m.intrinsic('arraypush', [L(1), m.index(L(2), L(3), AT)], AT),
                AT,
              ),
              m.assign(
                'local',
                3,
                m.binary('add', L(3), m.literal(1, AT), AT),
                AT,
              ),
            ],
            AT,
          ),
          AT,
        ),
        ret(L(1)),
      ],
      AT,
    )
  })

  # `error(v)` raises v. A string is prefixed with where the call is, which
  # is Lua's `level 1`: the position belongs to the caller of error, and the
  # binder is the only thing here that knows it, so it passes it in.
  luafn('$error', 2, fn (f) {
    m.block(
      [
        m.assign('local', 1, nth(f, L(0), 0, AT), AT),
        m.make_throw(
          m.make_if_else(
            is_type(L(1), 'string'),
            m.binary('add', nth(f, L(0), 1, AT), L(1), AT),
            L(1),
            AT,
          ),
          AT,
        ),
      ],
      AT,
    )
  })
  # `pcall(f, ...)` is a try: true and everything f answered, or false and
  # whatever was raised -- a value, not a class, so it comes back unchanged.
  luafn('pcall', 3, fn (f) {
    m.make_try(
      2,
      m.make_return(
        call_rt(
          f,
          '__append',
          [
            m.array_lit([m.bool_literal(true, AT)], AT),
            call_rt(
              f,
              '__callv',
              [nth(f, L(0), 0, AT), call_rt(f, '__rest', [L(0)], AT)],
              AT,
            ),
          ],
          AT,
        ),
        AT,
      ),
      m.make_return(m.array_lit([m.bool_literal(false, AT), L(2)], AT), AT),
      AT,
    )
  })

  # Coroutines. A Lua function already takes one list and answers one, and
  # CoroResume hands its argument to the body and answers what came back --
  # so the two conventions meet with nothing in between. What is written
  # here is the part that is Lua's rather than the intrinsic's: resuming a
  # dead coroutine answers false instead of raising, the state names differ,
  # and `wrap` strips the true off.
  luafn('coroutine.create', 1, fn (f) {
    m.make_return(
      m.array_lit([m.intrinsic('corocreate', [nth(f, L(0), 0, AT)], AT)], AT),
      AT,
    )
  })
  luafn('coroutine.yield', 1, fn (f) {
    m.make_return(m.intrinsic('coroyield', [L(0)], AT), AT)
  })
  luafn('coroutine.resume', 5, fn (f) {
    m.block(
      [
        m.assign('local', 1, nth(f, L(0), 0, AT), AT),
        m.make_if(
          m.binary('eq', m.intrinsic('corostatus', [L(1)], AT), S('done'), AT),
          m.make_return(
            m.array_lit(
              [m.bool_literal(false, AT), S('cannot resume dead coroutine')],
              AT,
            ),
            AT,
          ),
          AT,
        ),
        m.make_try(
          4,
          m.block(
            [
              m.assign(
                'local',
                3,
                m.intrinsic(
                  'cororesume',
                  [L(1), call_rt(f, '__rest', [L(0)], AT)],
                  AT,
                ),
                AT,
              ),
              m.make_return(
                call_rt(
                  f,
                  '__append',
                  [
                    m.array_lit([m.bool_literal(true, AT)], AT),
                    m.index(L(3), S('value'), AT),
                  ],
                  AT,
                ),
                AT,
              ),
            ],
            AT,
          ),
          m.make_return(m.array_lit([m.bool_literal(false, AT), L(4)], AT), AT),
          AT,
        ),
      ],
      AT,
    )
  })
  luafn('coroutine.status', 2, fn (f) {
    m.block(
      [
        m.assign(
          'local',
          1,
          m.intrinsic('corostatus', [nth(f, L(0), 0, AT)], AT),
          AT,
        ),
        m.make_return(
          m.array_lit(
            [m.make_if_else(
              m.binary('eq', L(1), S('done'), AT),
              S('dead'),
              m.make_if_else(
                m.binary('eq', L(1), S('start'), AT),
                S('suspended'),
                L(1),
                AT,
              ),
              AT,
            )],
            AT,
          ),
          AT,
        ),
      ],
      AT,
    )
  })
  # `wrap` answers something callable that is not a func, which is what
  # __call is for -- the coroutine rides in the table the metatable is on.
  luafn('coroutine.wrap', 3, fn (f) {
    m.block(
      [
        m.assign('local', 1, m.intrinsic('mapnew', [], AT), AT),
        call_rt(
          f,
          '__rawset',
          [L(1), S('co'), m.intrinsic('corocreate', [nth(f, L(0), 0, AT)], AT)],
          AT,
        ),
        m.assign('local', 2, m.intrinsic('mapnew', [], AT), AT),
        m.set_index(
          L(2),
          S('__call'),
          rs.closure(m, f, globals_fn['lua:$wrapcall'], AT),
          AT,
        ),
        call_rt(f, '__setmeta', [L(1), L(2)], AT),
        m.make_return(m.array_lit([L(1)], AT), AT),
      ],
      AT,
    )
  })
  luafn('$wrapcall', 2, fn (f) {
    m.block(
      [
        m.assign(
          'local',
          1,
          m.intrinsic(
            'cororesume',
            [
              call_rt(f, '__rawget', [nth(f, L(0), 0, AT), S('co')], AT),
              call_rt(f, '__rest', [L(0)], AT),
            ],
            AT,
          ),
          AT,
        ),
        m.make_return(m.index(L(1), S('value'), AT), AT),
      ],
      AT,
    )
  })

  luafn('$inext', 3, fn (f) {
    m.block(
      [
        m.assign(
          'local',
          1,
          m.binary('add', nth(f, L(0), 1, AT), m.literal(1, AT), AT),
          AT,
        ),
        m.assign(
          'local',
          2,
          call_rt(f, '__get', [nth(f, L(0), 0, AT), L(1)], AT),
          AT,
        ),
        m.make_if(
          is_type(L(2), 'nil'),
          m.make_return(m.array_lit([], AT), AT),
          AT,
        ),
        m.make_return(m.array_lit([L(1), L(2)], AT), AT),
      ],
      AT,
    )
  })
  luafn('$knext', 5, fn (f) {
    m.block(
      [
        m.assign('local', 1, nth(f, L(0), 0, AT), AT),
        m.assign('local', 2, m.index(L(1), S('keys'), AT), AT),
        m.assign('local', 3, m.index(L(1), S('i'), AT), AT),
        m.make_if(
          m.binary('ge', L(3), m.intrinsic('len', [L(2)], AT), AT),
          m.make_return(m.array_lit([], AT), AT),
          AT,
        ),
        m.assign('local', 4, m.index(L(2), L(3), AT), AT),
        m.set_index(
          L(1),
          S('i'),
          m.binary('add', L(3), m.literal(1, AT), AT),
          AT,
        ),
        m.make_return(
          m.array_lit([L(4), m.index(m.index(L(1), S('t'), AT), L(4), AT)], AT),
          AT,
        ),
      ],
      AT,
    )
  })
  luafn('ipairs', 1, fn (f) {
    m.make_return(
      m.array_lit(
        [
          rs.closure(m, f, globals_fn['lua:$inext'], AT),
          nth(f, L(0), 0, AT),
          m.literal(0, AT),
        ],
        AT,
      ),
      AT,
    )
  })
  luafn('pairs', 2, fn (f) {
    m.block(
      [
        m.assign('local', 1, m.intrinsic('mapnew', [], AT), AT),
        m.set_index(L(1), S('t'), nth(f, L(0), 0, AT), AT),
        m.set_index(L(1), S('i'), m.literal(0, AT), AT),
        m.set_index(
          L(1),
          S('keys'),
          call_rt(f, '__keys', [nth(f, L(0), 0, AT)], AT),
          AT,
        ),
        m.make_return(
          m.array_lit(
            [
              rs.closure(m, f, globals_fn['lua:$knext'], AT),
              L(1),
              m.nil_literal(AT),
            ],
            AT,
          ),
          AT,
        ),
      ],
      AT,
    )
  })
}

fn adapter(gname, helper, arity) {
  let fid = new_func("lua {gname}", nil, root_fn)
  globals_fn["lua:{gname}"] = fid
  rt_params[fid] = 1
  rt_locals[fid] = 1
  adapters.push((fid, helper, arity))
  fid
}

# --- the standard-library slice the samples reach ---------------------------
#
# (Lua name, helper, parameters). `set_lenient_arity` fills a call that
# passes fewer, which is what makes `s:sub(2)` reach the same __sub.
let string_lib = [
  ('upper', '__strupper', 1),
  ('sub', '__strsub', 3),
  ('rep', '__strrep', 2),
]
let lib_tables = [
  ('string', string_lib),
  ('table', [('insert', '__tabinsert', 2), ('concat', '__tabconcat', 2)]),
  ('math', [('type', '__mathtype', 1)]),
]
let lib_globals = [
  ('type', '__type', 1),
  ('tostring', '__str', 1),
  ('setmetatable', '__setmeta', 2),
  ('getmetatable', '__meta', 1),
  ('rawget', '__rawget', 2),
  ('rawset', '__rawset', 3),
]

let lua_raw = ['ipairs', 'pairs', 'pcall']
# tables whose entries answer more than one value, so they are luafns rather
# than adapters over a helper
let lua_raw_tables = [(
  'coroutine',
  ['create', 'resume', 'yield', 'status', 'wrap'],
)]

fn register_library() {
  register_iterators()
  # `error` is reachable as a value, and the prefix a direct call passes is
  # simply missing there -- the one place this differs from Lua
  globals_fn['lua:error'] = globals_fn['lua:$error']
  for (gname, helper, arity) in lib_globals {
    adapter(gname, helper, arity)
  }
  for (tname, entries) in lib_tables {
    for (gname, helper, arity) in entries {
      adapter("{tname}.{gname}", helper, arity)
    }
  }
  let pf = new_func('print', nil, root_fn)
  globals_fn['__print1'] = pf
  rt_params[pf] = 1
  rt_locals[pf] = 2
}

# The bodies, and the statements that install the names -- all after the
# capture numbering, because each one builds a closure.
fn emit_library() {
  for (fid, helper, arity) in adapters {
    mut ps = []
    for i in range(arity) {
      ps.push(nth(fid, L(0), i, AT))
    }
    rt_body[fid] = m.make_return(
      m.array_lit([call_rt(fid, helper, ps, AT)], AT),
      AT,
    )
  }
  # print takes any number of values, which under this convention is no
  # different from taking one list
  let pf = globals_fn['__print1']
  rt_body[pf] = m.block(
    [
      m.assign('local', 1, m.literal(0, AT), AT),
      m.make_while(
        m.binary('lt', L(1), m.intrinsic('len', [L(0)], AT), AT),
        m.block(
          [
            m.make_if(
              m.binary('gt', L(1), m.literal(0, AT), AT),
              m.intrinsic('printraw', [S("\t")], AT),
              AT,
            ),
            m.intrinsic(
              'printraw',
              [call_rt(pf, '__str', [m.index(L(0), L(1), AT)], AT)],
              AT,
            ),
            m.assign(
              'local',
              1,
              m.binary('add', L(1), m.literal(1, AT), AT),
              AT,
            ),
          ],
          AT,
        ),
        AT,
      ),
      m.intrinsic('printraw', [S("\n")], AT),
      m.make_return(m.array_lit([], AT), AT),
    ],
    AT,
  )

  mut ids = []
  for (gname, helper, arity) in lib_globals {
    ids.push(m.set_index(
      genv(root_fn, AT),
      S(gname),
      rs.closure(m, root_fn, globals_fn["lua:{gname}"], AT),
      AT,
    ))
  }
  ids.push(m.set_index(
    genv(root_fn, AT),
    S('print'),
    rs.closure(m, root_fn, pf, AT),
    AT,
  ))
  ids.push(m.set_index(
    genv(root_fn, AT),
    S('error'),
    rs.closure(m, root_fn, globals_fn['lua:$error'], AT),
    AT,
  ))
  for gname in lua_raw {
    ids.push(m.set_index(
      genv(root_fn, AT),
      S(gname),
      rs.closure(m, root_fn, globals_fn["lua:{gname}"], AT),
      AT,
    ))
  }
  for (tname, entries) in lib_tables {
    let t = new_scratch(root_fn)
    ids.push(m.assign('local', t, m.intrinsic('mapnew', [], AT), AT))
    for (gname, helper, arity) in entries {
      let af = globals_fn["lua:{tname}.{gname}"]
      ids.push(call_rt(
        root_fn,
        '__set',
        [m.var_ref('local', t, AT), S(gname), rs.closure(m, root_fn, af, AT)],
        AT,
      ))
    }
    ids.push(m.set_index(
      genv(root_fn, AT),
      S(tname),
      m.var_ref('local', t, AT),
      AT,
    ))
  }
  for (tname, names) in lua_raw_tables {
    let t = new_scratch(root_fn)
    ids.push(m.assign('local', t, m.intrinsic('mapnew', [], AT), AT))
    for gname in names {
      ids.push(call_rt(
        root_fn,
        '__set',
        [
          m.var_ref('local', t, AT),
          S(gname),
          rs.closure(m, root_fn, globals_fn["lua:{tname}.{gname}"], AT),
        ],
        AT,
      ))
    }
    ids.push(m.set_index(
      genv(root_fn, AT),
      S(tname),
      m.var_ref('local', t, AT),
      AT,
    ))
  }
  ids
}

fn call_rt(f, name, args, at) {
  if !globals_fn.has(name) {
    fail(at, "no runtime helper {name}")
  }
  rs.call(m, f, globals_fn[name], args, at)
}

fn one(f, v, at) {
  call_rt(f, '__nth', [v, m.literal(0, at)], at)
}

fn nth(f, v, i, at) {
  call_rt(f, '__nth', [v, m.literal(i, at)], at)
}

# A call at the end of an expression list contributes every value it
# answered; anywhere else it contributes its first. That is the whole of
# Lua's multiple-value rule, and it is why an expression list is emitted as
# one list rather than as a value each.
fn is_call_expr(node) {
  node.name == 'suffixedexp' &&
    [
      'callsfx',
      'strargsfx',
      'methodsfx',
    ].contains(node.nodes[node.nodes.size() - 1].name)
}

fn emit_multi(f, exprs, at) {
  if exprs.empty() {
    return m.array_lit([], at)
  }
  let last = exprs[exprs.size() - 1]
  mut front = []
  for e in exprs.slice(0, exprs.size() - 1) {
    front.push(emit_expr(f, e))
  }
  cond {
    !is_call_expr(last) => m.array_lit([...front, emit_expr(f, last)], at),
    front.empty() => emit_suffixed(f, last.nodes, last, true),
    _ => call_rt(
      f,
      '__append',
      [m.array_lit(front, at), emit_suffixed(f, last.nodes, last, true)],
      at,
    ),
  }
}

# --- Pass A: scopes and names -----------------------------------------------
#
# A Lua function reads what an enclosing one declared, and the IR wants every
# such read as a capture whose index is settled before any read is built. So
# the tree is walked twice. This pass opens the scopes, declares the
# bindings, and records which binding each name means; the emit pass below
# reads that back and never touches a scope. They walk the same shape, which
# is the one thing keeping them honest.
#
# Recording is keyed by source position, because a name occurrence is the
# only thing at its own line and column.

mut name_v = {}  # a name -> the binding it means, -1 for a global
mut decl_v = {}  # a declaring name -> the binding it makes
mut fn_of = {}   # a function body -> the func it becomes
mut self_v = {}  # a `function T:m()` -> the binding of its implicit self

fn pkey(node) {
  "{node.line}:{node.column}"
}

fn scan_declare(f, id) {
  let v = declare(f, id.token, id)
  decl_v[pkey(id)] = v
  v
}

# Lua has no declaration for a global, so a name no scope binds is a key in
# the table the root frame holds -- and naming one means capturing that table.
fn scan_name(f, id) {
  let v = rs.lookup(id.token)
  name_v[pkey(id)] = v
  rs.use(cond {
    v != -1 => v,
    _ => g_var,
  }, f)
}

# `function T:m(a)` declares a parameter the source does not write, which
# is the same implicit argument `t:m(a)` passes at the call.
fn scan_closure(f, name, funcbody, at, has_self) {
  let g = new_func(
    cond {
      name == nil => 'anonymous',
      _ => name,
    },
    at,
    f,
  )
  fn_of[pkey(funcbody)] = g
  # slot 0 is the argument list every Lua function takes; the declared
  # parameters are locals the prologue fills from it
  new_scratch(g)
  enter_scope(g)
  if has_self {
    self_v[g] = declare(g, 'self', at)
  }
  for prm in funcbody.nodes[0].nodes {
    funcs[g].params.push(scan_declare(g, prm))
  }
  scan_block(g, funcbody.nodes[1])
  leave_scope(g)
}

fn scan_block(f, blk) {
  for st in blk.nodes {
    scan_stmt(f, st)
  }
}

fn scan_emit_block(f, blk) {
  enter_scope(f)
  scan_block(f, blk)
  leave_scope(f)
}

fn scan_exprs(f, list) {
  for e in list.nodes {
    scan_expr(f, e)
  }
}

fn scan_expr(f, node) {
  match node {
    {name: 'number'} => nil,
    {name: 'float'} => nil,
    {name: 'string'} => nil,
    {name: 'literal'} => nil,
    {name: 'ident'} => scan_name(f, node),
    {
      name: 'funcexpr',
      nodes: [body],
    } => scan_closure(f, nil, body, node, false),
    {name: 'suffixedexp', nodes} => scan_suffixed(f, nodes),
    {name: 'tablector', nodes} => scan_table(f, nodes),
    _ => {
      # every other expression is operands and operator tokens, and an
      # operator token has no children to reach
      if node.nodes != nil {
        for c in node.nodes {
          scan_expr(f, c)
        }
      }
    },
  }
}

fn scan_table(f, nodes) {
  for fld in nodes {
    match fld {
      {name: 'keyedfield', nodes: [k, v]} => {
        scan_expr(f, k)
        scan_expr(f, v)
      },
      # the key of `{x = 1}` is a literal name, not a read
      {name: 'namedfield', nodes: [_, v]} => scan_expr(f, v),
      _ => scan_expr(f, fld),
    }
  }
}

fn scan_args(f, nodes) {
  for n in nodes {
    if n.name == 'args' {
      for a in n.nodes {
        scan_expr(f, a)
      }
    }
  }
}

fn scan_suffixed(f, nodes) {
  scan_expr(f, nodes[0])
  for sfx in nodes.slice(1, nodes.size()) {
    match sfx {
      {name: 'indexsfx', nodes: [ix]} => scan_expr(f, ix),
      {name: 'callsfx', nodes} => scan_args(f, nodes),
      # a dotted or method name is a key, and a string argument a literal
      {name: 'methodsfx', nodes} => scan_args(f, nodes.slice(1, nodes.size())),
      _ => nil,
    }
  }
}

fn scan_stmt(f, node) {
  match node {
    {name: 'emptystmt'} => nil,
    {name: 'breakstat'} => nil,
    {name: 'callstmt', nodes: [inner]} => scan_expr(f, inner),
    {name: 'suffixedexp', nodes} => scan_suffixed(f, nodes),
    {name: 'localdecl', nodes} => {
      # the values are read before the names exist, so `local x = x` reads
      # the outer x
      if nodes.size() > 1 {
        scan_exprs(f, nodes[1])
      }
      for id in nodes[0].nodes {
        scan_declare(f, id)
      }
    },
    # the name is visible inside the body, so it is declared first
    {name: 'localfn', nodes: [id, fb]} => {
      scan_declare(f, id)
      scan_closure(f, id.token, fb, node, false)
    },
    {name: 'fnstat', nodes: [fname, fb]} => {
      let parts = fname.nodes
      scan_closure(
        f,
        parts[0].token,
        fb,
        node,
        parts[parts.size() - 1].name == 'colonname',
      )
      scan_name(f, parts[0])
    },
    {name: 'assign', nodes: [targets, values]} => {
      scan_exprs(f, values)
      for t in targets.nodes {
        scan_target(f, t)
      }
    },
    {name: 'retstat', nodes} => {
      for l in nodes {
        scan_exprs(f, l)
      }
    },
    {name: 'ifstat', nodes} => scan_if(f, nodes, 0),
    {name: 'whilestat', nodes: [c, blk]} => {
      scan_expr(f, c)
      scan_emit_block(f, blk)
    },
    {name: 'dostat', nodes: [blk]} => scan_emit_block(f, blk),
    # the `until` condition can see the body's own locals, so the two share
    # one scope rather than nesting
    {name: 'repeatstat', nodes: [blk, c]} => {
      enter_scope(f)
      scan_block(f, blk)
      scan_expr(f, c)
      leave_scope(f)
    },
    {name: 'forin', nodes: [namelist, exprlist, blk]} => {
      scan_exprs(f, exprlist)
      enter_scope(f)
      for id in namelist.nodes {
        scan_declare(f, id)
      }
      scan_block(f, blk)
      leave_scope(f)
    },
    {name: 'fornum', nodes} => {
      scan_expr(f, nodes[1])
      scan_expr(f, nodes[2])
      if nodes.size() > 4 {
        scan_expr(f, nodes[3].nodes[0])
      }
      enter_scope(f)
      scan_declare(f, nodes[0])
      scan_block(f, nodes[nodes.size() - 1])
      leave_scope(f)
    },
    _ => fail(node, "cannot execute {node.name}"),
  }
}

fn scan_if(f, nodes, i) {
  cond {
    i + 1 < nodes.size() && nodes[i].name != 'elsepart' => {
      scan_expr(f, nodes[i])
      scan_emit_block(f, nodes[i + 1])
      if i + 2 < nodes.size() {
        scan_if(f, nodes, i + 2)
      }
    },
    nodes[i].name == 'elseifpart' => scan_if(f, nodes[i].nodes, 0),
    nodes[i].name == 'elsepart' => scan_emit_block(f, nodes[i].nodes[0]),
    _ => scan_emit_block(f, nodes[i]),
  }
}

fn scan_target(f, t) {
  if t.name == 'ident' {
    return scan_name(f, t)
  }
  let parts = t.nodes
  cond {
    parts.size() == 1 && parts[0].name == 'ident' => scan_name(f, parts[0]),
    _ => {
      scan_expr(f, parts[0])
      for i in range(1, parts.size()) {
        let sfx = parts[i]
        if sfx.name == 'indexsfx' {
          scan_expr(f, sfx.nodes[0])
        }
      }
    },
  }
}

# --- Expressions ------------------------------------------------------------

let binop_rt = {
  '+': '__add',
  '-': '__sub',
  '*': '__mul',
  '/': '__div',
  '//': '__idiv',
  '%': '__mod',
  '..': '__cat',
  '==': '__eq',
  '~=': '__ne',
  '<': '__lt',
  '<=': '__le',
  '>': '__gt',
  '>=': '__ge',
}

fn emit_expr(f, node) {
  match node {
    {name: 'number', token} => m.literal(to_long(token), node),
    {name: 'float', token} => m.double_literal(to_float(token), node),
    {name: 'string', token} => m.str_literal(unescape(token), node),
    {name: 'literal', token} => cond {
      token == 'true' => m.bool_literal(true, node),
      token == 'false' => m.bool_literal(false, node),
      _ => m.nil_literal(node),
    },
    {name: 'ident'} => emit_name(f, node, node),
    {name: 'paren', nodes: [inner]} => emit_expr(f, inner),
    {
      name: 'notexp',
      nodes: [inner],
    } => call_rt(f, '__not', [emit_expr(f, inner)], node),
    {
      name: 'negexp',
      nodes: [inner],
    } => m.unary('neg', emit_expr(f, inner), node),
    {
      name: 'lenexp',
      nodes: [inner],
    } => call_rt(f, '__len', [emit_expr(f, inner)], node),
    {name: 'powexp', nodes} => cond {
      nodes.size() == 1 => emit_expr(f, nodes[0]),
      _ => call_rt(
        f,
        '__pow',
        [emit_expr(f, nodes[0]), emit_expr(f, nodes[1].nodes[0])],
        node,
      ),
    },
    # and/or answer one of their operands, not a boolean, and only evaluate
    # the second when the first does not already decide
    {name: 'orexp', nodes} => emit_shortcut(f, nodes, true, node),
    {name: 'andexp', nodes} => emit_shortcut(f, nodes, false, node),
    {name: 'cmpexp', nodes} => emit_binchain(f, nodes),
    {name: 'concatexp', nodes} => emit_concat(f, nodes, node),
    {name: 'addexp', nodes} => emit_binchain(f, nodes),
    {name: 'mulexp', nodes} => emit_binchain(f, nodes),
    {name: 'suffixedexp', nodes} => emit_suffixed(f, nodes, node, false),
    {name: 'tablector', nodes} => emit_table(f, nodes, node),
    {name: 'funcexpr', nodes: [body]} => emit_closure(f, body, node),
    _ => fail(node, "cannot evaluate {node.name}"),
  }
}

fn emit_binchain(f, nodes) {
  let [head, ...rest] = nodes
  mut acc = emit_expr(f, head)
  for [op, operand] in rest.iter().chunks(2) {
    acc = call_rt(f, binop_rt[op.token], [acc, emit_expr(f, operand)], op)
  }
  acc
}

fn emit_concat(f, nodes, at) {
  let [head, ...rest] = nodes
  mut acc = emit_expr(f, head)
  for r in rest {
    acc = call_rt(f, '__cat', [acc, emit_expr(f, r)], at)
  }
  acc
}

# `a or b` is a if a is true, else b -- and a is evaluated once, so it lands
# in a scratch slot the test and the result both read.
fn emit_shortcut(f, nodes, is_or, at) {
  cond {
    nodes.size() == 1 => emit_expr(f, nodes[0]),
    _ => {
      let [head, ...rest] = nodes
      mut acc = emit_expr(f, head)
      for r in rest {
        let slot = new_scratch(f)
        let store = m.assign('local', slot, acc, at)
        let test = call_rt(f, '__truthy', [m.var_ref('local', slot, at)], at)
        let kept = m.var_ref('local', slot, at)
        let other = emit_expr(f, r)
        acc = m.block([store, cond {
          is_or => m.make_if_else(test, kept, other, at),
          _ => m.make_if_else(test, other, kept, at),
        }], at)
      }
      acc
    },
  }
}

fn new_scratch(f) {
  let k = nslots[f]
  nslots[f] = k + 1
  k
}

fn unescape(s) {
  mut out = ''
  mut i = 0
  while i < s.size() {
    let c = s.slice(i, i + 1).to_string()
    if c == "\\" && i + 1 < s.size() {
      let n = s.slice(i + 1, i + 2).to_string()
      out += cond {
        n == 'n' => "\n",
        n == 't' => "\t",
        _ => n,
      }
      i += 2
    } else {
      out += c
      i += 1
    }
  }
  out
}

# --- Names ------------------------------------------------------------------
#
# A global lives in a table the root frame holds in a cell, so a function
# declared anywhere reaches it the same way -- Lua has no declaration for a
# global, and the only alternative is capturing every one of them.

fn emit_name(f, id, at) {
  let v = name_v[pkey(id)]
  cond {
    v != -1 => rs.read(m, f, v, at),
    _ => m.index(genv(f, at), m.str_literal(id.token, at), at),
  }
}

fn genv(f, node) {
  rs.read(m, f, g_var, node)
}

# --- Suffixed expressions: calls, indexing, methods -------------------------

# `all` asks for the list a trailing call answered rather than its first
# value -- the one place the caller's context changes what a call means.
# `error(msg)` prefixes a string with the position of the call, which Lua
# takes off the stack and this front end takes off the source. The prefix is
# an extra argument the binder appends at a direct call to the global name;
# `error` reached any other way raises the value unchanged.
fn is_error_call(f, nodes) {
  nodes.size() == 2 &&
    nodes[0].name == 'ident' &&
    nodes[0].token == 'error' &&
    name_v[pkey(nodes[0])] == -1 &&
    nodes[1].name == 'callsfx'
}

fn emit_suffixed(f, nodes, at, all) {
  if is_error_call(f, nodes) {
    return call_rt(
      f,
      '__callv',
      [
        emit_expr(f, nodes[0]),
        call_rt(
          f,
          '__append',
          [
            emit_args(f, nodes[1].nodes, at),
            m.array_lit([S("{chunk}:{at.line}: ")], at),
          ],
          at,
        ),
      ],
      at,
    )
  }
  mut v = emit_expr(f, nodes[0])
  let last = nodes.size() - 1
  for i in range(1, nodes.size()) {
    let sfx = nodes[i]
    let keep = all && i == last
    v = match sfx {
      {
        name: 'dotsfx',
        nodes: [id],
      } => call_rt(f, '__get', [v, m.str_literal(id.token, sfx)], sfx),
      {
        name: 'indexsfx',
        nodes: [ix],
      } => call_rt(f, '__get', [v, emit_expr(f, ix)], sfx),
      {
        name: 'callsfx',
        nodes,
      } => trim(
        f,
        call_rt(f, '__callv', [v, emit_args(f, nodes, sfx)], sfx),
        keep,
        sfx,
      ),
      {
        name: 'strargsfx',
        nodes: [lit],
      } => trim(
        f,
        call_rt(
          f,
          '__callv',
          [v, m.array_lit([m.str_literal(unescape(lit.token), sfx)], sfx)],
          sfx,
        ),
        keep,
        sfx,
      ),
      # `o:m(a)` is `o.m(o, a)` with o evaluated once
      {name: 'methodsfx', nodes} => {
        let slot = new_scratch(f)
        let store = m.assign('local', slot, v, sfx)
        let recv = m.var_ref('local', slot, sfx)
        let fnv = call_rt(
          f,
          '__get',
          [recv, m.str_literal(nodes[0].token, sfx)],
          sfx,
        )
        let args = call_rt(
          f,
          '__append',
          [
            m.array_lit([m.var_ref('local', slot, sfx)], sfx),
            emit_args(f, nodes.slice(1, nodes.size()), sfx),
          ],
          sfx,
        )
        m.block(
          [store, trim(f, call_rt(f, '__callv', [fnv, args], sfx), keep, sfx)],
          sfx,
        )
      },
      _ => fail(sfx, "cannot apply {sfx.name}"),
    }
  }
  v
}

fn trim(f, call, keep, at) {
  cond {
    keep => call,
    _ => one(f, call, at),
  }
}

fn emit_args(f, nodes, at) {
  mut out = []
  for n in nodes {
    if n.name == 'args' {
      for a in n.nodes {
        out.push(a)
      }
    }
  }
  emit_multi(f, out, at)
}

# --- Tables -----------------------------------------------------------------

fn emit_table(f, nodes, at) {
  let slot = new_scratch(f)
  mut ids = [m.assign('local', slot, call_rt(f, '__newtable', [], at), at)]
  mut idx = 1
  let last = nodes.size() - 1
  for k, fld in nodes.enumerate() {
    let t = m.var_ref('local', slot, at)
    match fld {
      {
        name: 'keyedfield',
        nodes: [k, v],
      } => ids.push(call_rt(
        f,
        '__set',
        [t, emit_expr(f, k), emit_expr(f, v)],
        fld,
      )),
      {
        name: 'namedfield',
        nodes: [k, v],
      } => ids.push(call_rt(
        f,
        '__set',
        [t, m.str_literal(k.token, fld), emit_expr(f, v)],
        fld,
      )),
      # a call in the last position contributes every value it answered
      _ => cond {
        is_call_expr(fld) &&
          k ==
            last => ids.push(call_rt(
          f,
          '__spread',
          [t, m.literal(idx, fld), emit_suffixed(f, fld.nodes, fld, true)],
          fld,
        )),
        _ => {
          ids.push(call_rt(
            f,
            '__set',
            [t, m.literal(idx, fld), emit_expr(f, fld)],
            fld,
          ))
          idx += 1
        },
      },
    }
  }
  ids.push(m.var_ref('local', slot, at))
  m.block(ids, at)
}

# --- Functions --------------------------------------------------------------

fn emit_closure(f, funcbody, at) {
  let g = fn_of[pkey(funcbody)]
  pending.push({g: g, body: funcbody})
  rs.closure(m, f, g, at)
}

fn bind_funcbody(g, funcbody) {
  mut ids = []
  mut base = 0
  if self_v.has(g) {
    ids.push(rs.write(m, g, self_v[g], nth(g, L(0), 0, AT), AT))
    base = 1
  }
  for i, prm in funcbody.nodes[0].nodes.enumerate() {
    ids.push(rs.write(
      m,
      g,
      decl_v[pkey(prm)],
      nth(g, m.var_ref('local', 0, prm), i + base, prm),
      prm,
    ))
  }
  ids.push(emit_block(g, funcbody.nodes[1]))
  # a Lua function that runs off its end returns no values
  ids.push(m.make_return(m.array_lit([], AT), AT))
  m.block(ids, AT)
}

# --- Statements -------------------------------------------------------------

fn emit_block(f, blk) {
  mut ids = []
  for st in blk.nodes {
    let e = emit_stmt(f, st)
    if e != nil {
      ids.push(e)
    }
  }
  m.block(ids, blk)
}

fn emit_stmt(f, node) {
  match node {
    {name: 'emptystmt'} => nil,
    {name: 'callstmt', nodes: [inner]} => emit_expr(f, inner),
    {name: 'suffixedexp'} => emit_expr(f, node),
    {name: 'localdecl', nodes} => {
      let names = nodes[0].nodes
      mut ids = []
      let vals = values_slot(f, nodes, node, ids)
      # every `local` declares anew, so a second `local x` in one block is a
      # second binding and the first keeps whatever closed over it
      for i, id in names.enumerate() {
        ids.push(rs.write(m, f, decl_v[pkey(id)], vals(i, id), id))
      }
      m.block(ids, node)
    },
    {name: 'localfn', nodes: [id, fb]} => {
      let v = decl_v[pkey(id)]
      rs.write(m, f, v, emit_closure(f, fb, node), node)
    },
    {name: 'fnstat', nodes: [fname, fb]} => {
      let parts = fname.nodes
      let c = emit_closure(f, fb, node)
      cond {
        parts.size() == 1 => emit_store(f, parts[0], c, node),
        _ => {
          mut t = emit_name(f, parts[0], node)
          for i in range(1, parts.size() - 1) {
            t = call_rt(
              f,
              '__get',
              [t, m.str_literal(parts[i].nodes[0].token, node)],
              node,
            )
          }
          let last = parts[parts.size() - 1].nodes[0].token
          call_rt(f, '__set', [t, m.str_literal(last, node), c], node)
        },
      }
    },
    {name: 'assign', nodes: [targets, values]} => {
      mut ids = []
      let vals = values_slot(f, [nil, values], node, ids)
      for i, t in targets.nodes.enumerate() {
        ids.push(emit_target(f, t, vals(i, t), node))
      }
      m.block(ids, node)
    },
    {name: 'retstat', nodes} => {
      mut exprs = []
      for l in nodes {
        for e in l.nodes {
          exprs.push(e)
        }
      }
      m.make_return(emit_multi(f, exprs, node), node)
    },
    {name: 'ifstat', nodes} => emit_if(f, nodes, 0, node),
    {
      name: 'whilestat',
      nodes: [c, blk],
    } => m.make_while(
      call_rt(f, '__truthy', [emit_expr(f, c)], node),
      emit_block(f, blk),
      node,
    ),
    {name: 'dostat', nodes: [blk]} => emit_block(f, blk),
    # `repeat ... until c` runs the body first, and the condition can see the
    # body's own locals -- Lua's one block that outlives its own end, so the
    # two share a scope rather than nesting
    {name: 'repeatstat', nodes: [blk, c]} => {
      let b = emit_block(f, blk)
      let test = call_rt(f, '__truthy', [emit_expr(f, c)], node)
      m.make_while(
        m.bool_literal(true, node),
        m.block([b, m.make_if(test, m.make_break(node), node)], node),
        node,
      )
    },
    # `for i = a, b, step`: the bounds are evaluated once, the variable is
    # the loop's own and a closure made inside gets that turn's value
    {name: 'fornum', nodes} => {
      let step_given = nodes.size() > 4
      let lo = new_scratch(f)
      let hi = new_scratch(f)
      let st = new_scratch(f)
      mut ids = [m.assign(
        'local',
        lo,
        emit_expr(f, nodes[1]),
        node,
      ), m.assign(
        'local',
        hi,
        emit_expr(f, nodes[2]),
        node,
      ), m.assign('local', st, cond {
        step_given => emit_expr(f, nodes[3].nodes[0]),
        _ => m.literal(1, node),
      }, node)]
      let v = decl_v[pkey(nodes[0])]
      let body = emit_block(f, nodes[nodes.size() - 1])
      # a step may be negative, so the test is "still on the right side of
      # the bound", not simply <=
      let going_up = m.binary(
        'ge',
        m.var_ref('local', st, node),
        m.literal(0, node),
        node,
      )
      let test = m.make_if_else(
        going_up,
        m.binary(
          'le',
          m.var_ref('local', lo, node),
          m.var_ref('local', hi, node),
          node,
        ),
        m.binary(
          'ge',
          m.var_ref('local', lo, node),
          m.var_ref('local', hi, node),
          node,
        ),
        node,
      )
      # each turn of the loop is its own binding, so three closures made
      # inside remember three numbers rather than sharing the last
      let fresh = cond {
        rs.access_kind(f, v) ==
          'cell' => [m.cell_fresh(rs.cell_of(f, v), node)],
        _ => [],
      }
      ids.push(m.make_while(
        test,
        m.block(
          [
            ...fresh,
            rs.write(m, f, v, m.var_ref('local', lo, node), node),
            body,
            m.assign(
              'local',
              lo,
              m.binary(
                'add',
                m.var_ref('local', lo, node),
                m.var_ref('local', st, node),
                node,
              ),
              node,
            ),
          ],
          node,
        ),
        node,
      ))
      m.block(ids, node)
    },
    # `for k, v in explist`: the list answers an iterator, a state and a
    # control, and each turn calls the iterator with the last two. The loop
    # ends the moment the first value back is nil.
    {name: 'forin', nodes: [namelist, exprlist, blk]} => {
      let vs = new_scratch(f)
      let it = new_scratch(f)
      let st = new_scratch(f)
      let ct = new_scratch(f)
      mut ids = [
        m.assign('local', vs, emit_multi(f, exprlist.nodes, node), node),
        m.assign(
          'local',
          it,
          nth(f, m.var_ref('local', vs, node), 0, node),
          node,
        ),
        m.assign(
          'local',
          st,
          nth(f, m.var_ref('local', vs, node), 1, node),
          node,
        ),
        m.assign(
          'local',
          ct,
          nth(f, m.var_ref('local', vs, node), 2, node),
          node,
        ),
      ]
      mut step = [
        m.assign(
          'local',
          vs,
          call_rt(
            f,
            '__callv',
            [
              m.var_ref('local', it, node),
              m.array_lit(
                [m.var_ref('local', st, node), m.var_ref('local', ct, node)],
                node,
              ),
            ],
            node,
          ),
          node,
        ),
        m.assign(
          'local',
          ct,
          nth(f, m.var_ref('local', vs, node), 0, node),
          node,
        ),
        m.make_if(
          is_type(m.var_ref('local', ct, node), 'nil'),
          m.make_break(node),
          node,
        ),
      ]
      for i, id in namelist.nodes.enumerate() {
        let v = decl_v[pkey(id)]
        # a closure made in the body keeps that turn's binding
        if rs.access_kind(f, v) == 'cell' {
          step.push(m.cell_fresh(rs.cell_of(f, v), id))
        }
        step.push(rs.write(
          m,
          f,
          v,
          nth(f, m.var_ref('local', vs, node), i, node),
          id,
        ))
      }
      step.push(emit_block(f, blk))
      ids.push(m.make_while(
        m.bool_literal(true, node),
        m.block(step, node),
        node,
      ))
      m.block(ids, node)
    },
    {name: 'breakstat'} => m.make_break(node),
    _ => fail(node, "cannot execute {node.name}"),
  }
}

# `local a, b = f()` and `a, b = f()` both bind from one list, which is
# evaluated once into a slot the names then read positionally. The answer is
# a reader rather than a list of nodes, because how many values there are is
# not known until the call runs.
fn values_slot(f, nodes, at, ids) {
  if nodes.size() < 2 {
    return |i, node| m.nil_literal(node)
  }
  let slot = new_scratch(f)
  ids.push(m.assign('local', slot, emit_multi(f, nodes[1].nodes, at), at))
  |i, node| nth(f, m.var_ref('local', slot, node), i, node)
}

fn emit_if(f, nodes, i, at) {
  cond {
    i + 1 < nodes.size() && nodes[i].name != 'elsepart' => {
      let c = call_rt(f, '__truthy', [emit_expr(f, nodes[i])], at)
      let then_b = emit_block(f, nodes[i + 1])
      let rest = i + 2
      cond {
        rest >= nodes.size() => m.make_if(c, then_b, at),
        _ => m.make_if_else(c, then_b, emit_if(f, nodes, rest, at), at),
      }
    },
    nodes[i].name == 'elseifpart' => emit_if(f, nodes[i].nodes, 0, at),
    nodes[i].name == 'elsepart' => emit_block(f, nodes[i].nodes[0]),
    _ => emit_block(f, nodes[i]),
  }
}

fn emit_store(f, id, v, at) {
  let b = name_v[pkey(id)]
  cond {
    b != -1 => rs.write(m, f, b, v, at),
    _ => m.set_index(genv(f, at), m.str_literal(id.token, at), v, at),
  }
}

fn emit_target(f, t, v, node) {
  # a suffixedexp with no suffix folds to the name itself
  if t.name == 'ident' {
    return emit_store(f, t, v, node)
  }
  let parts = t.nodes
  cond {
    parts.size() == 1 &&
      parts[0].name == 'ident' => emit_store(f, parts[0], v, node),
    _ => {
      mut recv = emit_expr(f, parts[0])
      for i in range(1, parts.size() - 1) {
        recv = emit_one_suffix(f, recv, parts[i])
      }
      let last = parts[parts.size() - 1]
      let key = match last {
        {name: 'dotsfx', nodes: [id]} => m.str_literal(id.token, last),
        {name: 'indexsfx', nodes: [ix]} => emit_expr(f, ix),
        _ => fail(last, 'cannot assign here'),
      }
      call_rt(f, '__set', [recv, key, v], node)
    },
  }
}

fn emit_one_suffix(f, v, sfx) {
  match sfx {
    {
      name: 'dotsfx',
      nodes: [id],
    } => call_rt(f, '__get', [v, m.str_literal(id.token, sfx)], sfx),
    {
      name: 'indexsfx',
      nodes: [ix],
    } => call_rt(f, '__get', [v, emit_expr(f, ix)], sfx),
    _ => fail(sfx, "cannot apply {sfx.name} here"),
  }
}

# --- Build ------------------------------------------------------------------
#
# The globals table lives in a cell of the root frame, so every function --
# including one declared inside another -- reaches a global the same way.
# Lua has no declaration for a global, so there is nothing else to capture.

fn build(mm, root) {
  m = mm
  rs = CodeGen.Resolver.new()
  root_fn = new_func('main', root, nil)
  enter_scope(root_fn)
  g_var = declare(root_fn, '_ENV', root)
  rs.force_cell(g_var)
  native_fmt = m.declare_native('__luafmt')
  runtime()
  register_library()

  # Pass A settles every binding and every capture; nothing below opens a
  # scope, and every read is built against a numbering that no longer moves.
  scan_block(root_fn, root.nodes[0])
  leave_scope(root_fn)
  rs.number_captures()

  rt_finish()
  let body = m.block(
    [...emit_library(), emit_block(root_fn, root.nodes[0])],
    root,
  )
  # bodies of the closures the walk created
  mut i = 0
  while i < pending.size() {
    let pd = pending[i]
    rt_body[pd.g] = bind_funcbody(pd.g, pd.body)
    i += 1
  }

  let root_body = m.block(
    [
      rs.write(m, root_fn, g_var, m.intrinsic('mapnew', [], AT), AT),
      body,
      m.make_return(m.nil_literal(AT), AT),
    ],
    AT,
  )
  rt_body[root_fn] = root_body
  rt_locals[root_fn] = nslots[root_fn]
  rt_params[root_fn] = 0

  for f in range(funcs.size()) {
    let is_rt = rt_params.has(f)
    m.add_func(
      name: funcs[f].name,
      num_locals: cond {
        is_rt => rt_locals[f],
        _ => nslots[f],
      },
      num_captures: rs.num_captures(f),
      num_cells: rs.num_cells(f),
      # every Lua function takes the one list, however many names it
      # declares
      num_params: cond {
        is_rt => rt_params[f],
        _ => 1,
      },
      body: rt_body[f],
    )
    rs.name_captures(m, f, f)
    if rs.num_captures(f) == 0 {
      m.set_singleton(func: f)
    }
    m.set_lenient_arity(func: f)
    # Lua guarantees `return f(...)` reuses the frame. The call itself is
    # made inside __callv, so the guarantee needs both frames to go: the
    # caller tail-calls __callv, and __callv tail-calls the function.
    m.set_tail_calls(func: f)
  }
  m
}

let want_ir = Sys.argv.contains('--ir')
let want_ast = Sys.argv.contains('--ast')
let args = Sys.argv.filter(|a| a != '--ir' && a != '--ast')
if args.empty() {
  println('usage: culebra mini_lua.cul [--ir] PROGRAM.lua')
  Sys.exit(1)
}

try {
  chunk = args[0]
  let tree = PEG.parse(grammar, FS.read(args[0]), path: args[0])
  if want_ast {
    inspect(tree)
    Sys.exit(0)
  }
  let mod = build(CodeGen.Module.new(), tree)
  mod.verify()
  cond {
    want_ir => print(mod.dump_ir()),
    # a native is supplied per run, so the program goes through compile()
    # and Program.run rather than Module.run
    _ => mod
      .compile()
      .run(natives: {
      # Lua's own float rendering: 14 significant digits, and a `.0` kept on
      # one that would otherwise read as an integer.
      __luafmt: fn (v) {
        let t = "{v:.14g}"
        cond {
          t.contains('.') || t.contains('e') || t.contains('n') => t,
          _ => t + '.0',
        }
      },
    }),
  }
} catch e {
  match e {
    {kind: 'LuaError'} => IO.eprintln("{args[0]}:{e.line}:{e.col}: {e.message}"),
    {kind: 'PEGError'} => IO.eprintln(e.message),
    _ => throw e,
  }
  Sys.exit(1)
}
