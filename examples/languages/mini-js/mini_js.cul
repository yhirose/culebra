# --- Compiler tables ------------------------------------------------------------

fn fail(node, msg) {
  throw {kind: 'MiniError', message: msg, line: node.line, col: node.column}
}

# The prelude and the user program are separate parse trees whose line/col
# ranges overlap, so position keys carry which side they are from -- and one
# run compiles several programs, so a program's keys carry its turn as well
# (the prelude's tables outlive them all).
mut in_prelude = false
mut prog_gen = 0
fn pkey(node) {
  cond {
    node.key != nil => node.key,
    in_prelude => "p{node.line}:{node.column}",
    _ => "u{prog_gen}:{node.line}:{node.column}",
  }
}

mut synth_count = 0
fn synth(name, nodes, at) {
  synth_count = synth_count + 1
  {
    name: name,
    nodes: nodes,
    token: '',
    line: at.line,
    column: at.column,
    key: "s{synth_count}",
  }
}

mut funcs = []           # {parent, name, params, stmts, body_expr, is_prelude, is_arrow, ...}
mut nslots = []          # per func: named local slots
mut closure_of = {}      # pkey of a function node -> func index
mut resolved = {}        # pkey of an ident -> {kind: 'var', owner, slot} | {kind: 'global', name}
mut block_slots = {}     # pkey of a block -> the slots it declares
mut prelude_named = {}   # prelude fn name -> func index
mut prelude_bound = {}   # prelude top-level binding name -> its key on __G
mut prelude_inits = []   # [{key, init}], in prelude order
mut prelude_end = 0      # funcs.size() once the prelude is bound
mut prelude_nslots = []  # nslots for funcs[0..prelude_end) as pass A left them
mut g_slot = 0           # main's slot holding __G
mut this_slot = 0        # main's `this`
mut loop_ctx = []        # per func (emit time): [{step: fn(m) -> [ids]}...]
mut pending_labels = []  # per func (emit time): label names seen, not yet
# attached to the loop/switch they wrap
mut classes = {}    # pkey of a class node -> {home, derived, name, ctor, fields, members}
mut for_close = {}  # pkey of a for-of -> {func: the closer, slot: its iterator binding}

# per func, what it captures and which of its slots are cells, and the
# scopes its names bind in (front.cul); the Emitter is over the program
# being compiled
let frames = front.Frames.new()
let scopes = front.Scopes.new(frames)
mut ir = nil

# Prelude names that are VM intrinsics, with their arities.
let intrinsics = {
  __typeof: 'typeof',
  __tostr: 'tostr',
  __len: 'len',
  __toint: 'toint',
  __todouble: 'todouble',
  __fmod: 'fmod',
  __pow: 'pow',
  __arraypush: 'arraypush',
  __arraypop: 'arraypop',
  __objecthas: 'objecthas',
  __objectkeys: 'objectkeys',
  __objectremove: 'objectremove',
  __same: 'same',
  __argcount: 'argcount',
  __print: 'print',
  __genresume: 'genresume',
  __genthrow: 'genthrow',
  __enqueue: 'enqueue',
  __genreturn: 'genreturn',
}
# Prelude names that are raw VM binary / unary operations over Longs.
let raw_binops = {
  __bitand: 'bitand',
  __bitor: 'bitor',
  __bitxor: 'bitxor',
  __ishl: 'shl',
  __ishr: 'shr',
  __idiv: 'div',
  __imod: 'mod',
  __bitnot: 'bitnot',
}

fn new_func(parent, name, stmts, body_expr, is_arrow) {
  let f = funcs.size()
  funcs.push({
    parent: parent,
    name: name,
    params: [],
    dflts: [],
    stmts: stmts,
    body_expr: body_expr,
    is_prelude: in_prelude,
    is_arrow: is_arrow,
    var_names: [],
  })
  frames.add(parent)
  scopes.add()
  nslots.push(0)
  loop_ctx.push([])
  pending_labels.push([])
  # every function reaches the global table through main's cell
  if f != 0 {
    frames.use(f, 0, g_slot)
  }
  f
}

# --- Pass A: bind ---------------------------------------------------------------

fn enter_scope(f) {
  scopes.push(f)
}
# Leave the scope, recording the slots it declared under the node that owns
# it -- what the emitter refreshes per entry.
fn close_scope(f, node) {
  block_slots[pkey(node)] = scopes.bound(f)
  leave_scope(f)
}

fn leave_scope(f) {
  scopes.pop(f)
}

# declared again in the same block: the same binding, its slot reused
fn declare_var(f, name, at) {
  mut slot = scopes.here(f, name)
  if slot == nil {
    slot = nslots[f]
    nslots[f] = slot + 1
    scopes.bind(f, name, slot)
  }
  if at != nil {
    resolved[pkey(at)] = {kind: 'var', owner: f, slot: slot}
  }
  slot
}

# `var` binds at the function's outermost scope wherever it appears
fn declare_fn_var(f, name, at) {
  # already visible (a parameter, or declared before)? keep that slot
  mut slot = scopes.own(f, name)
  if slot == nil {
    slot = nslots[f]
    nslots[f] = slot + 1
    scopes.bind_at(f, 0, name, slot)
    funcs[f].var_names.push(slot)
  }
  if at != nil {
    resolved[pkey(at)] = {kind: 'var', owner: f, slot: slot}
  }
  slot
}

fn resolve(f, name) {
  if name == '__G' {
    return {kind: 'var', owner: 0, slot: g_slot}
  }
  let found = scopes.lookup(f, name)
  if found != nil {
    let (h, slot) = found
    return {kind: 'var', owner: h, slot: slot}
  }
  if in_prelude && prelude_bound.has(name) {
    return {kind: 'preconst', key: prelude_bound[name]}
  }
  if in_prelude && prelude_named.has(name) {
    return {kind: 'fn', func: prelude_named[name]}
  }
  if in_prelude && intrinsics.has(name) {
    return {kind: 'intrinsic', name: name}
  }
  if in_prelude && raw_binops.has(name) {
    return {kind: 'rawop', name: name}
  }
  if in_prelude && name == '__allchars' {
    return {kind: 'const'}
  }
  {kind: 'global', name: name}
}

fn note_use(node, f) {
  let r = resolve(f, node.token)
  resolved[pkey(node)] = r
  if r.kind == 'var' {
    frames.use(f, r.owner, r.slot)
  }
  r
}

# Names a statement list declares at its own level (hoisted to the block
# start): let/const/function. `var` names go to the function.
fn hoist_block(stmts, f) {
  mut fn_nodes = []
  for st in stmts {
    cond {
      st.name == 'var_decl' || st.name == 'var_decl_ns' => {
        let kw = st.nodes[0].token
        mut i = 1
        while i < st.nodes.size() {
          declare_pattern(f, st.nodes[i].nodes[0], kw)
          i = i + 1
        }
      },
      fn_decl_forms.has(st.name) => {
        declare_var(f, st.nodes[0].token, st.nodes[0])
        fn_nodes.push(st)
      },
      st.name == 'class_d' => declare_var(f, st.nodes[0].token, st.nodes[0]),
      _ => nil,
    }
  }
  fn_nodes
}

# The forms whose body belongs to a function of its own: a `var` inside one
# is that function's, and a scan must not descend past it.
let fn_forms = {
  fn_decl: true,
  fn_expr: true,
  arrow: true,
  gen_decl: true,
  gen_expr: true,
  async_decl: true,
  async_expr: true,
  async_arrow: true,
  method_p: true,
  gmethod_p: true,
  amethod_p: true,
  getter_p: true,
  setter_p: true,
  class_d: true,
  class_e: true,
}
# ... and the three that are hoisted declarations of one.
let fn_decl_forms = {fn_decl: true, gen_decl: true, async_decl: true}

fn collect_vars(node, f) {
  if node.nodes == nil {
    return nil
  }
  if fn_forms.has(node.name) {
    return nil
  }
  if (node.name == 'var_decl' || node.name == 'var_decl_ns') &&
      node.nodes[0].token == 'var' {
    mut i = 1
    while i < node.nodes.size() {
      for id in pattern_idents(node.nodes[i].nodes[0], []) {
        declare_fn_var(f, id.token, nil)
      }
      i = i + 1
    }
  }
  if (node.name == 'for_of' || node.name == 'for_in') &&
      node.nodes[0].token == 'var' {
    for id in pattern_idents(node.nodes[1], []) {
      declare_fn_var(f, id.token, nil)
    }
  }
  for c in node.nodes {
    collect_vars(c, f)
  }
  nil
}

fn param_parts(p) {
  cond {
    p.name == 'rest_p' => {id: p.nodes[0], dflt: nil, rest: true},
    p.name == 'dflt_p' => {id: p.nodes[0], dflt: p.nodes[1], rest: false},
    _ => {id: p, dflt: nil, rest: false},
  }
}

# The identifiers a binding pattern introduces, in source order.
fn pattern_idents(pat, out) {
  cond {
    pat.name == 'ident' => out.push(pat),
    pat.name == 'arr_pat' || pat.name == 'obj_pat' => {
      for el in pat.nodes {
        pattern_idents(el, out)
      }
    },
    pat.name == 'pat_dflt' ||
      pat.name == 'rest_b' => pattern_idents(pat.nodes[0], out),
    pat.name == 'opat_kv' => pattern_idents(pat.nodes[1], out),
    pat.name == 'opat_short' => out.push(pat.nodes[0]),
    _ => nil,
  }
  out
}

# The member-expression targets a pattern assigns to (assignment only).
fn pattern_targets(pat, out) {
  cond {
    pat.name == 'postfix' || pat.name == 'paren' => out.push(pat),
    pat.name == 'arr_pat' || pat.name == 'obj_pat' => {
      for el in pat.nodes {
        pattern_targets(el, out)
      }
    },
    pat.name == 'pat_dflt' ||
      pat.name == 'rest_b' => pattern_targets(pat.nodes[0], out),
    pat.name == 'opat_kv' => pattern_targets(pat.nodes[1], out),
    _ => nil,
  }
  out
}

# The default expressions inside a pattern (scanned in the pattern's scope).
fn pattern_dflts(pat, out) {
  cond {
    pat.name == 'arr_pat' || pat.name == 'obj_pat' => {
      for el in pat.nodes {
        pattern_dflts(el, out)
      }
    },
    pat.name == 'pat_dflt' || pat.name == 'opat_short' => {
      if pat.nodes.size() > 1 {
        out.push(pat.nodes[1])
      }
      if pat.name == 'pat_dflt' {
        pattern_dflts(pat.nodes[0], out)
      }
    },
    pat.name == 'rest_b' => pattern_dflts(pat.nodes[0], out),
    pat.name == 'opat_kv' => pattern_dflts(pat.nodes[1], out),
    _ => nil,
  }
  out
}

fn declare_pattern(f, pat, kw) {
  for id in pattern_idents(pat, []) {
    cond {
      kw == 'var' => declare_fn_var(f, id.token, id),
      _ => declare_var(f, id.token, id),
    }
  }
}

fn scan_pattern_dflts(pat, f) {
  for d in pattern_dflts(pat, []) {
    scan_expr(d, f)
  }
}

fn walk_fn(f, param_nodes, this_node) {
  enter_scope(f)
  let fi = funcs[f]
  cond {
    # the prelude spells its receiver parameter itself (a helper has none)
    fi.is_prelude => nil,
    fi.is_arrow => {
      declare_var(f, "\x01this", nil)
      fi.params.push("\x01this")
    },
    _ => {
      declare_var(f, 'this', nil)
      fi.params.push('this')
    },
  }
  # parameters take the first slots; a pattern parameter lands in a hidden
  # one and is unpacked by the prologue
  mut pat_params = []
  for p in param_nodes {
    let pp = param_parts(p)
    cond {
      pp.rest => {
        fi['rest'] = pp.id.token
        mut k = 0
        while k < 8 {
          declare_var(f, "\x01r{k}", nil)
          fi.params.push("\x01r{k}")
          k = k + 1
        }
        declare_var(f, pp.id.token, pp.id)
      },
      pp.id.name == 'ident' => {
        declare_var(f, pp.id.token, pp.id)
        fi.params.push(pp.id.token)
        fi.dflts.push(pp.dflt)
      },
      _ => {
        let hn = "\x01p{fi.params.size()}"
        let slot = declare_var(f, hn, nil)
        fi.params.push(hn)
        fi.dflts.push(pp.dflt)
        pat_params.push((slot, pp.id))
      },
    }
  }
  fi['pat_params'] = pat_params
  for pp in pat_params {
    let (slot, pat) = pp
    declare_pattern(f, pat, 'let')
  }
  if fi.self_name != nil {
    fi['self_slot'] = declare_var(f, fi.self_name, fi.self_node)
  }
  for pp in fi.dflts {
    if pp != nil {
      scan_expr(pp, f)
    }
  }
  for pp in pat_params {
    let (slot, pat) = pp
    scan_pattern_dflts(pat, f)
  }
  cond {
    fi.body_expr != nil => scan_expr(fi.body_expr, f),
    _ => {
      for st in fi.stmts {
        collect_vars(st, f)
      }
      scan_stmts(fi.stmts, f)
    },
  }
  leave_scope(f)
}

fn scan_stmts(stmts, f) {
  let fn_nodes = hoist_block(stmts, f)
  for s in fn_nodes {
    let id = s.nodes[0]
    let g = new_func(f, id.token, s.nodes[2].nodes, nil, false)
    closure_of[pkey(s)] = g
    frames.note_call(f, g)
    walk_fn(g, s.nodes[1].nodes, nil)
    if s.name == 'gen_decl' {
      wrap_generator(f, s, g, id.token)
    }
    if s.name == 'async_decl' {
      wrap_async(f, s, g, id.token)
    }
  }
  for s in stmts {
    scan_stmt(s, f)
  }
}

fn scan_block(blk, f) {
  enter_scope(f)
  scan_stmts(blk.nodes, f)
  close_scope(f, blk)
}

# a statement in a position that is not a block still gets its own scope
fn scan_sub(st, f) {
  cond {
    st.name == 'block' => scan_block(st, f),
    _ => {
      enter_scope(f)
      scan_stmts([st], f)
      leave_scope(f)
    },
  }
}

fn scan_stmt(node, f) {
  match node {
    {name: 'var_decl'} | {name: 'var_decl_ns'} => scan_decl(node, f),
    {name: 'fn_decl'} => nil,  # hoisted by scan_stmts
    {name: 'gen_decl'} => nil,
    {name: 'async_decl'} => nil,
    {name: 'class_d'} => scan_class(node, f),
    {name: 'if_s'} => {
      scan_expr(node.nodes[0], f)
      scan_sub(node.nodes[1], f)
      if node.nodes.size() > 2 {
        scan_sub(node.nodes[2].nodes[0], f)
      }
    },
    {name: 'label_s'} => scan_sub(node.nodes[1], f),
    {name: 'while_s'} => {
      scan_expr(node.nodes[0], f)
      scan_sub(node.nodes[1], f)
    },
    {name: 'do_s'} => {
      scan_sub(node.nodes[0], f)
      scan_expr(node.nodes[1], f)
    },
    {name: 'for_of'} | {name: 'for_in'} => scan_for_each(node, f),
    {name: 'switch_s'} => {
      scan_expr(node.nodes[0], f)
      # the cases share one block scope
      enter_scope(f)
      mut all = []
      mut i = 1
      while i < node.nodes.size() {
        let c = node.nodes[i]
        let body = c.nodes[c.nodes.size() - 1]
        if c.name == 'case_c' {
          scan_expr(c.nodes[0], f)
        }
        for st in body.nodes {
          all.push(st)
        }
        i = i + 1
      }
      scan_stmts(all, f)
      close_scope(f, node)
    },
    {name: 'for_s'} => {
      let [init, cnd, step, body] = node.nodes
      enter_scope(f)
      if init.nodes.size() > 0 {
        let i0 = init.nodes[0]
        cond {
          i0.name == 'var_decl_ns' => scan_decl(i0, f),
          _ => scan_expr(i0, f),
        }
      }
      if cnd.nodes.size() > 0 {
        scan_expr(cnd.nodes[0], f)
      }
      if step.nodes.size() > 0 {
        scan_expr(step.nodes[0], f)
      }
      scan_sub(body, f)
      close_scope(f, node)
    },
    {name: 'return_s'} => {
      if node.nodes[0].nodes.size() > 0 {
        scan_expr(node.nodes[0].nodes[0], f)
      }
    },
    {name: 'break_s'} => nil,
    {name: 'continue_s'} => nil,
    {name: 'throw_s'} => scan_expr(node.nodes[0], f),
    {name: 'try_s'} => {
      scan_block(node.nodes[0], f)
      mut i = 1
      while i < node.nodes.size() {
        let c = node.nodes[i]
        cond {
          c.name == 'catch_c' => {
            enter_scope(f)
            let cp = c.nodes[0]
            # the caught value always has a slot, named or not
            let slot = cond {
              cp.nodes.size() >
                0 => declare_var(f, cp.nodes[0].token, cp.nodes[0]),
              _ => declare_var(f, "\x01caught", nil),
            }
            resolved[pkey(c)] = {kind: 'var', owner: f, slot: slot}
            scan_block(c.nodes[1], f)
            leave_scope(f)
          },
          _ => {
            let g = new_func(f, 'finally', c.nodes[0].nodes, nil, true)
            closure_of[pkey(c)] = g
            frames.note_call(f, g)
            walk_fn(g, [], nil)
          },
        }
        i = i + 1
      }
    },
    {name: 'block'} => scan_block(node, f),
    {name: 'empty_s'} => nil,
    {name: 'expr_s'} => scan_expr(node.nodes[0], f),
    _ => scan_expr(node, f),
  }
}

# for-of / for-in: the head's binding lives in the loop's own scope
fn scan_for_each(node, f) {
  let [kw, pat, src, body] = node.nodes
  scan_expr(src, f)
  enter_scope(f)
  if node.name == 'for_of' {
    # leaving the loop early closes the iterator (a generator's finally
    # runs): the iterator lives in a hidden binding a deferred closer
    # captures
    let slot = declare_var(f, "\x01it" + pkey(node), nil)
    let g = new_func(f, 'iterclose', [], nil, true)
    funcs[g]['close_of'] = {owner: f, slot: slot}
    frames.use(g, f, slot)
    frames.note_call(f, g)
    for_close[pkey(node)] = {func: g, slot: slot}
  }
  declare_pattern(f, pat, kw.token)
  scan_pattern_dflts(pat, f)
  scan_sub(body, f)
  close_scope(f, node)
}

fn scan_decl(node, f) {
  let kw = node.nodes[0].token
  mut i = 1
  while i < node.nodes.size() {
    let d = node.nodes[i]
    let pat = d.nodes[0]
    # hoist_block declared the names when the block was entered; a for-init
    # or a var is declared here
    for id in pattern_idents(pat, []) {
      cond {
        kw == 'var' => declare_fn_var(f, id.token, id),
        resolved.has(pkey(id)) => nil,
        _ => declare_var(f, id.token, id),
      }
    }
    scan_pattern_dflts(pat, f)
    if d.nodes.size() > 1 {
      scan_expr(d.nodes[1], f)
    }
    i = i + 1
  }
}

# A member key, in a class body or an object literal: a computed one is an
# expression of the enclosing function and leaves the member unnamed.
fn mkey_name(mk) {
  cond {
    mk.name == 'computed_k' => '',
    _ => prop_key_text(mk),
  }
}
fn scan_mkey(mk, f) {
  if mk.name == 'computed_k' {
    scan_expr(mk.nodes[0], f)
  }
  mkey_name(mk)
}

# A member's parameters and body, by its form: an accessor spells them
# differently from a method, in a class body and an object literal alike.
fn member_params_body(mem) {
  cond {
    mem.name.starts_with('getter') => ([], mem.nodes[1]),
    mem.name.starts_with('setter') => ([mem.nodes[1]], mem.nodes[2]),
    _ => (mem.nodes[1].nodes, mem.nodes[2]),
  }
}
# ... and the function a call reaches: a generator or async member is its raw
# body plus the wrapper that answers the activation.
fn wrap_member(f, mem, g, mname) {
  cond {
    mem.name.starts_with('gmethod') => wrap_generator(f, mem, g, mname),
    mem.name.starts_with('amethod') => wrap_async(f, mem, g, mname),
    _ => g,
  }
}

# What a step after a primary contributes to the scan -- the same list the
# emitter walks, for a postfix chain and for a new expression alike.
fn scan_step(step, f) {
  cond {
    step.name == 'call_p' ||
      step.name == 'opt_call' => scan_args(step.nodes[0], f),
    step.name == 'index_p' ||
      step.name == 'opt_index' => scan_expr(step.nodes[0], f),
    step.name == 'new_args' &&
      step.nodes.size() > 0 => scan_args(step.nodes[0], f),
    _ => nil,
  }
}

# A class: every method, accessor and the constructor is a function of its
# own whose `super` reaches the class through a hidden binding in the
# enclosing scope (the home); instance fields become one more function the
# constructor runs.
fn scan_class(node, f) {
  let tail = node.nodes[1]
  let ext = tail.nodes[0]
  let cname = cond {
    node.name == 'class_d' => node.nodes[0].token,
    node.nodes[0].nodes.size() > 0 => node.nodes[0].nodes[0].token,
    _ => '',
  }
  if ext.nodes.size() > 0 {
    scan_expr(ext.nodes[0], f)
  }
  let home = declare_var(f, "\x01home" + pkey(node), nil)
  let derived = ext.nodes.size() > 0
  mut info = {
    home: home,
    mut name: cname,
    mut ctor: nil,
    fields: [],
    members: [],
  }
  mut i = 1
  while i < tail.nodes.size() {
    mut mem = tail.nodes[i]
    mut is_static = false
    if mem.name == 'static_c' {
      is_static = true
      mem = mem.nodes[0]
    }
    let mk = mem.nodes[0]
    let mname = scan_mkey(mk, f)
    cond {
      mem.name == 'method_c' &&
        !is_static &&
        mk.name != 'computed_k' &&
        mk.token == 'constructor' => {
        let g = new_func(f, cname, mem.nodes[2].nodes, nil, false)
        closure_of[pkey(mem)] = g
        frames.note_call(f, g)
        funcs[g]['home'] = {owner: f, slot: home}
        funcs[g]['is_ctor'] = true
        funcs[g]['derived'] = derived
        frames.use(g, f, home)
        walk_fn(g, mem.nodes[1].nodes, nil)
        info.ctor = g
      },
      mem.name == 'method_c' ||
        mem.name == 'gmethod_c' ||
        mem.name == 'amethod_c' ||
        mem.name == 'getter_c' ||
        mem.name == 'setter_c' => {
        let (params, blk) = member_params_body(mem)
        let g = new_func(f, mname, blk.nodes, nil, false)
        closure_of[pkey(mem)] = g
        frames.note_call(f, g)
        funcs[g]['home'] = {owner: f, slot: home}
        funcs[g]['is_static'] = is_static
        frames.use(g, f, home)
        walk_fn(g, params, nil)
        let fv = wrap_member(f, mem, g, mname)
        info.members.push({node: mem, is_static: is_static, key: mk, func: fv})
      },
      mem.name == 'field_c' && is_static => {
        if mem.nodes.size() > 1 {
          scan_expr(mem.nodes[1], f)
        }
        info.members.push({node: mem, is_static: true, key: mk, func: nil})
      },
      mem.name == 'field_c' => info.fields.push(mem),
      _ => nil,
    }
    i = i + 1
  }
  if info.fields.size() > 0 {
    # the initializers run as a method of their own, in order
    let g = new_func(f, cname + '.fields', [], nil, false)
    frames.note_call(f, g)
    funcs[g]['home'] = {owner: f, slot: home}
    funcs[g]['field_inits'] = info.fields
    frames.use(g, f, home)
    enter_scope(g)
    declare_var(g, 'this', nil)
    funcs[g].params.push('this')
    for fld in info.fields {
      if fld.nodes.size() > 1 {
        scan_expr(fld.nodes[1], g)
      }
    }
    leave_scope(g)
    info['fields_func'] = g
  }
  classes[pkey(node)] = info
  nil
}

# `super` inside a method (or an arrow within one) names the method's home
fn resolve_super(node, f) {
  mut h = f
  while h != nil {
    if funcs[h].home != nil {
      let r = {
        kind: 'super',
        home: funcs[h].home,
        is_static: funcs[h].is_static == true,
      }
      resolved[pkey(node)] = r
      frames.use(f, r.home.owner, r.home.slot)
      return r
    }
    h = funcs[h].parent
  }
  fail(node, "'super' keyword unexpected here")
}

# A generator function is two VM functions: the raw generator (the body,
# with the parameters) and a wrapper that is the JS-visible function --
# it forwards its arguments to the raw one and answers the activation
# wrapped as a generator object.
fn wrap_generator(f, node, g, name) {
  wrap_body(f, node, g, name, false)
}
fn wrap_async(f, node, g, name) {
  wrap_body(f, node, g, name, true)
}

fn wrap_body(f, node, g, name, is_async) {
  funcs[g]['is_gen'] = true
  let w = new_func(f, name, [], nil, false)
  funcs[w]['gen_raw'] = g
  funcs[w]['is_async'] = is_async
  frames.note_call(w, g)
  enter_scope(w)
  declare_var(w, 'this', nil)
  funcs[w].params.push('this')
  for k in range(8) {
    declare_var(w, "\x01a{k}", nil)
    funcs[w].params.push("\x01a{k}")
  }
  leave_scope(w)
  closure_of[pkey(node)] = w
  w
}

fn scan_fn_value(node, f, param_nodes, body, is_arrow, name) {
  let stmts = cond {
    body.name == 'block' => body.nodes,
    _ => nil,
  }
  let body_expr = cond {
    body.name == 'block' => nil,
    _ => body,
  }
  let g = new_func(f, name, stmts, body_expr, is_arrow)
  closure_of[pkey(node)] = g
  frames.note_call(f, g)
  walk_fn(g, param_nodes, nil)
  g
}

fn scan_expr(node, f) {
  match node {
    {name: 'ident'} => note_use(node, f),
    {name: 'number'} => nil,
    {name: 'string'} => nil,
    {name: 'true_l'} => nil,
    {name: 'false_l'} => nil,
    {name: 'null_l'} => nil,
    {name: 'this_e'} => {
      let r = resolve(f, 'this')
      resolved[pkey(node)] = r
      if r.kind == 'var' {
        frames.use(f, r.owner, r.slot)
      }
    },
    {name: 'template'} => {
      for p in node.nodes {
        if p.name == 'tsub' {
          scan_expr(p.nodes[0], f)
        }
      }
    },
    {name: 'arrow'} => {
      let [ap, body] = node.nodes
      let params = cond {
        ap.name == 'arrow_one' => [ap.nodes[0]],
        _ => ap.nodes,
      }
      scan_fn_value(node, f, params, body, true, '')
    },
    {name: 'fn_expr'} => {
      let [fname, prms, blk] = node.nodes
      let name = cond {
        fname.nodes.size() > 0 => fname.nodes[0].token,
        _ => '',
      }
      cond {
        name != '' => {
          # a named function expression sees its own name inside
          let g = new_func(f, name, blk.nodes, nil, false)
          closure_of[pkey(node)] = g
          frames.note_call(f, g)
          funcs[g]['self_name'] = name
          funcs[g]['self_node'] = fname.nodes[0]
          walk_fn(g, prms.nodes, nil)
        },
        _ => scan_fn_value(node, f, prms.nodes, blk, false, ''),
      }
    },
    {name: 'gen_expr'} => {
      let [fname, prms, blk] = node.nodes
      let name = cond {
        fname.nodes.size() > 0 => fname.nodes[0].token,
        _ => '',
      }
      let g = scan_fn_value(node, f, prms.nodes, blk, false, name)
      wrap_generator(f, node, g, name)
    },
    {name: 'async_expr'} => {
      let [fname, prms, blk] = node.nodes
      let name = cond {
        fname.nodes.size() > 0 => fname.nodes[0].token,
        _ => '',
      }
      let g = scan_fn_value(node, f, prms.nodes, blk, false, name)
      wrap_async(f, node, g, name)
    },
    {name: 'async_arrow'} => {
      let [ap, body] = node.nodes
      let params = cond {
        ap.name == 'arrow_one' => [ap.nodes[0]],
        _ => ap.nodes,
      }
      let g = scan_fn_value(node, f, params, body, true, '')
      wrap_async(f, node, g, '')
    },
    {name: 'await_e'} => scan_expr(node.nodes[0], f),
    {name: 'yield_e'} => {
      if node.nodes[0].nodes.size() > 0 {
        scan_expr(node.nodes[0].nodes[0], f)
      }
    },
    {name: 'yield_from'} => scan_expr(node.nodes[0], f),
    {name: 'assign_e'} => {
      scan_target(node.nodes[0], f)
      scan_expr(node.nodes[2], f)
    },
    {name: 'seq_e'} => {
      for c in node.nodes {
        scan_expr(c, f)
      }
    },
    {name: 'pre_inc'} => scan_target(node.nodes[1], f),
    {name: 'post_inc'} => scan_target(node.nodes[0], f),
    {name: 'unary'} => {
      for c in node.nodes {
        if c.name != 'unary_op' {
          scan_expr(c, f)
        }
      }
    },
    {name: 'postfix'} | {name: 'new_e'} => {
      scan_expr(node.nodes[0], f)
      mut i = 1
      while i < node.nodes.size() {
        scan_step(node.nodes[i], f)
        i = i + 1
      }
    },
    {name: 'array_lit'} => {
      for c in node.nodes {
        scan_expr(arg_val(c), f)
      }
    },
    {name: 'object_lit'} => {
      for p in node.nodes {
        match p {
          {name: 'kv_p'} => {
            scan_mkey(p.nodes[0], f)
            scan_expr(p.nodes[1], f)
          },
          {name: 'short_p'} => note_use(p.nodes[0], f),
          {name: 'ospread'} => scan_expr(p.nodes[0], f),
          # the rest are functions under an mkey, as a class's members are
          _ => {
            let mname = scan_mkey(p.nodes[0], f)
            let (params, body) = member_params_body(p)
            wrap_member(
              f,
              p,
              scan_fn_value(p, f, params, body, false, mname),
              mname,
            )
          },
        }
      }
    },
    {name: 'paren'} => scan_expr(node.nodes[0], f),
    {name: 'spread'} => scan_expr(node.nodes[0], f),
    {name: 'class_e'} => scan_class(node, f),
    {name: 'super_call'} => {
      scan_args(node.nodes[0], f)
      resolve_super(node, f)
      let r = resolve(f, 'this')
      resolved["this@" + pkey(node)] = r
      if r.kind == 'var' {
        frames.use(f, r.owner, r.slot)
      }
    },
    {name: 'super_mem'} => {
      resolve_super(node, f)
      let r = resolve(f, 'this')
      resolved["this@" + pkey(node)] = r
      if r.kind == 'var' {
        frames.use(f, r.owner, r.slot)
      }
    },
    {name: 'ternary'} => {
      for c in node.nodes {
        scan_expr(c, f)
      }
    },
    {name: 'exp_e'} => {
      for c in node.nodes {
        scan_expr(c, f)
      }
    },
    _ => {
      # a binary chain: operands interleaved with op tokens
      if node.nodes != nil {
        for c in node.nodes {
          if !c.name.ends_with('_op') {
            scan_expr(c, f)
          }
        }
      }
    },
  }
  nil
}

fn arg_val(a) {
  cond {
    a.name == 'spread' => a.nodes[0],
    _ => a,
  }
}

fn scan_args(args, f) {
  for a in args.nodes {
    scan_expr(arg_val(a), f)
  }
}

fn scan_target(t, f) {
  cond {
    t.name == 'ident' => note_use(t, f),
    t.name == 'postfix' => scan_expr(t, f),
    t.name == 'paren' => scan_target(t.nodes[0], f),
    t.name == 'arr_pat' || t.name == 'obj_pat' => {
      for id in pattern_idents(t, []) {
        note_use(id, f)
      }
      for tt in pattern_targets(t, []) {
        scan_target(tt, f)
      }
      scan_pattern_dflts(t, f)
    },
    _ => fail(t, 'Invalid left-hand side in assignment'),
  }
}

# --- Pass B: captures -------------------------------------------------------------
#
# Frames.solve (front.cul). A call obliges the caller to hand the callee its
# captures; a nested function obliges its parent the same way (a wrapper is
# pushed onto its own calls list, so the two edges are not the same edge).

# --- Pass C: emit ------------------------------------------------------------------

# The lowering keeps its line/col pairs; the Emitter takes a position
fn call_pre(m, f, name, arg_ids, at) {
  ir.call(f, prelude_named[name], arg_ids, at)
}

fn var_read(m, f, r, at) {
  ir.read(f, r.owner, r.slot, at)
}

fn var_write(m, f, r, v, at) {
  ir.write(f, r.owner, r.slot, v, at)
}

fn gref(m, f, at) {
  var_read(m, f, {owner: 0, slot: g_slot}, at)
}

fn nil_l(m, at) {
  ir.nil_literal(at)
}
fn str_l(m, s, at) {
  ir.str_literal(s, at)
}
fn dbl_l(m, v, at) {
  ir.double_literal(v, at)
}

# A lowering temp: one more local, appended after the named ones (every
# declaration is bound in pass A, so the count is settled before emit).
fn new_scratch(f) {
  let k = nslots[f]
  nslots[f] = k + 1
  k
}

fn scratch_ref(m, slot, at) {
  ir.local(slot, at)
}

# a user-mode value's truthiness, or the raw VM test inside the prelude
fn emit_test(m, f, v, at) {
  cond {
    in_prelude => v,
    _ => call_pre(m, f, '__truthy', [v], at),
  }
}

fn unescape(s) {
  mut out = ''
  mut i = 0
  while i < s.size() {
    let c = s.slice(i, i + 1)
    cond {
      c == "\\" && i + 1 < s.size() => {
        let d = s.slice(i + 1, i + 2)
        cond {
          d == 'n' => {
            out = out + "\n"
            i = i + 2
          },
          d == 't' => {
            out = out + "\t"
            i = i + 2
          },
          d == 'r' => {
            out = out + "\r"
            i = i + 2
          },
          d == '0' => {
            out = out + String.from_code_point(0)
            i = i + 2
          },
          d == 'x' && i + 3 < s.size() => {
            out = out +
              String.from_code_point(to_long(s.slice(i + 2, i + 4), base: 16))
            i = i + 4
          },
          d == 'u' && i + 5 < s.size() => {
            out = out +
              String.from_code_point(to_long(s.slice(i + 2, i + 6), base: 16))
            i = i + 6
          },
          d == "\n" => i = i + 2,  # a line continuation
          _ => {
            out = out + d
            i = i + 2
          },
        }
      },
      _ => {
        out = out + c
        i = i + 1
      },
    }
  }
  out
}

fn number_value(tok) {
  cond {
    tok.starts_with('0x') ||
      tok.starts_with('0X') => to_float(to_long(
      tok.slice(2, tok.size()),
      base: 16,
    )),
    tok.starts_with('0b') ||
      tok.starts_with('0B') => to_float(to_long(
      tok.slice(2, tok.size()),
      base: 2,
    )),
    tok.starts_with('0o') ||
      tok.starts_with('0O') => to_float(to_long(
      tok.slice(2, tok.size()),
      base: 8,
    )),
    tok.starts_with('.') => to_float('0' + tok),
    tok.ends_with('.') => to_float(tok + '0'),
    _ => to_float(tok),
  }
}

let binop_pre = {
  '+': '__add',
  '-': '__sub',
  '*': '__mul',
  '/': '__div',
  '%': '__mod',
  '**': '__powop',
  '<': '__lt',
  '<=': '__le',
  '>': '__gt',
  '>=': '__ge',
  '===': '__seq',
  '==': '__eq',
  '&': '__band',
  '|': '__bor',
  '^': '__bxor',
  '<<': '__shl',
  '>>': '__shr',
  '>>>': '__ushr',
  'instanceof': '__instanceof',
  'in': '__in',
}
let binop_raw = {
  '+': 'add',
  '-': 'sub',
  '*': 'mul',
  '/': 'div',
  '%': 'mod',
  '<': 'lt',
  '<=': 'le',
  '>': 'gt',
  '>=': 'ge',
  '===': 'eq',
  '==': 'eq',
  '!==': 'ne',
  '!=': 'ne',
  '&': 'bitand',
  '|': 'bitor',
  '^': 'bitxor',
  '<<': 'shl',
  '>>': 'shr',
}

fn emit_binop(m, f, tok, l, r, at) {
  cond {
    in_prelude => cond {
      tok == '**' => ir.intrinsic('pow', [l, r], at),
      tok == '%' => ir.intrinsic('fmod', [l, r], at),
      _ => ir.binary(binop_raw[tok], l, r, at),
    },
    tok == '!==' => ir_not(m, call_pre(m, f, '__seq', [l, r], at), at),
    tok == '!=' => ir_not(m, call_pre(m, f, '__eq', [l, r], at), at),
    _ => call_pre(m, f, binop_pre[tok], [l, r], at),
  }
}

fn ir_not(m, v, at) {
  ir.lnot(v, at)
}

# `typeof v == 'nil'` -- how the compiler asks "is this undefined?", since
# the VM's own eq refuses two different tags.
fn is_undef(m, v, at) {
  ir.binary('eq', ir.intrinsic('typeof', [v], at), str_l(m, 'nil', at), at)
}

fn is_undefined_node(n) {
  n.name == 'ident' && n.token == 'undefined'
}

# a left-associative operator chain: [operand, op, operand, op, ...]
fn emit_chain(m, node, f) {
  mut acc = emit_expr(m, node.nodes[0], f)
  mut i = 1
  while i + 1 < node.nodes.size() {
    let op = node.nodes[i]
    let rn = node.nodes[i + 1]
    let tok = op.token
    # in the prelude a comparison against undefined is a tag test: the VM's
    # eq refuses two different tags
    cond {
      in_prelude &&
        (tok == '===' || tok == '!==' || tok == '==' || tok == '!=') &&
        (is_undefined_node(rn) ||
          i == 1 && is_undefined_node(node.nodes[0])) => {
        let subject = cond {
          is_undefined_node(rn) => acc,
          _ => emit_expr(m, rn, f),
        }
        let test = is_undef(m, subject, op)
        acc = cond {
          tok == '===' || tok == '==' => test,
          _ => ir_not(m, test, op),
        }
      },
      _ => {
        let rhs = emit_expr(m, rn, f)
        acc = emit_binop(m, f, tok, acc, rhs, op)
      },
    }
    i = i + 2
  }
  acc
}

# && / || / ??: the left operand is kept in a temp and is the result when
# the test says so
fn emit_shortcircuit(m, node, f) {
  let n = node.name
  let [head, ...pairs] = node.nodes
  mut acc = emit_expr(m, head, f)
  for [op, rn] in pairs.iter().chunks(2) {
    let tmp = new_scratch(f)
    let t = fn () {
      ir.local(tmp, op)
    }
    let store = ir.store_local(tmp, acc, op)
    let rhs = emit_expr(m, rn, f)
    let test = cond {
      n == 'nullish' => cond {
        in_prelude => ir.binary('eq', t(), ir.nil_literal(op), op),
        _ => call_pre(m, f, '__isnullish', [t()], op),
      },
      _ => emit_test(m, f, t(), op),
    }
    # `||` answers the left operand when the test passes; `&&` and `??`
    # answer the right one
    let (then_b, else_b) = cond {
      n == 'lor' => (t(), rhs),
      _ => (rhs, t()),
    }
    acc = ir.seq([store], ir.make_if_else(test, then_b, else_b, op), op)
  }
  acc
}

fn emit_string(m, node) {
  let tok = node.token
  str_l(m, unescape(tok.slice(1, tok.size() - 1)), node)
}

# The literal's text between substitutions is read back from the source
# (the parser skips whitespace before each part, so a chunk node has lost
# its leading spaces); a substitution's value goes through ToString.
fn emit_template(m, node, f) {
  let src = cond {
    in_prelude => prelude_src,
    _ => cur_src,
  }
  mut acc = str_l(m, '', node)
  mut cursor = node.position + 1
  fn chunk(upto) {
    if upto > cursor {
      acc = ir.binary(
        'add',
        acc,
        str_l(m, unescape(src.slice(cursor, upto).to_string()), node),
        node,
      )
    }
  }
  for p in node.nodes {
    if p.name == 'tsub' {
      chunk(p.position)
      let v = emit_expr(m, p.nodes[0], f)
      let sv = cond {
        in_prelude => v,
        _ => call_pre(m, f, '__str', [v], p),
      }
      acc = ir.binary('add', acc, sv, node)
      # the node's length runs past the whitespace the parser skipped after
      # the closing brace; back up to the brace itself
      mut end = p.position + p.length
      while src.slice(end - 1, end) != '}' {
        end = end - 1
      }
      cursor = end
    }
  }
  chunk(node.position + node.length - 1)
  acc
}

# JS's Function.length: the parameters before the first default or rest
fn fn_length(g) {
  # a generator's wrapper takes no parameters of its own: its arity is the
  # body's, which is where the defaults are
  let ds = funcs[cond {
    funcs[g].gen_raw != nil => funcs[g].gen_raw,
    _ => g,
  }].dflts
  for i in range(ds.size()) {
    if ds[i] != nil {
      return i
    }
  }
  ds.size()
}

fn emit_fn_value(m, node, f, name, is_arrow) {
  let g = closure_of[pkey(node)]
  let c = ir.closure(f, g, node)
  cond {
    # a prelude helper referenced as a value is the raw closure; a prelude
    # function expression is a JS function like any other
    in_prelude => c,
    _ => mkfn_id(m, f, g, name, is_arrow, true, node),
  }
}

# [values...] with spreads expanded: an array literal when there is no
# spread, else built by __spread_into
fn emit_arg_array(m, f, arg_nodes, at) {
  let has_spread = arg_nodes.any(|a| a.name == 'spread')
  cond {
    !has_spread => {
      mut ids = []
      for a in arg_nodes {
        ids.push(emit_expr(m, a, f))
      }
      ir.array_lit(ids, at)
    },
    _ => {
      let tmp = new_scratch(f)
      mut ids = [ir.store_local(tmp, ir.array_lit([], at), at)]
      for a in arg_nodes {
        cond {
          a.name ==
            'spread' => ids.push(call_pre(
            m,
            f,
            '__spread_into',
            [scratch_ref(m, tmp, at), emit_expr(m, a.nodes[0], f)],
            a,
          )),
          _ => ids.push(ir.intrinsic(
            'arraypush',
            [scratch_ref(m, tmp, at), emit_expr(m, a, f)],
            a,
          )),
        }
      }
      ids.push(scratch_ref(m, tmp, at))
      ir.block(ids, at)
    },
  }
}

fn emit_get(m, f, obj, key, at) {
  cond {
    in_prelude => ir.index(obj, key, at),
    _ => call_pre(m, f, '__get', [obj, key], at),
  }
}

fn emit_set(m, f, obj, key, v, at) {
  cond {
    in_prelude => ir.set_index(obj, key, v, at),
    _ => call_pre(m, f, '__set', [obj, key, v], at),
  }
}

# a call of a raw prelude closure (no receiver)
fn emit_raw_call(m, f, callee, arg_nodes, at) {
  mut ids = []
  for a in arg_nodes {
    ids.push(emit_expr(m, a, f))
  }
  ir.call_value(callee, ids, at)
}

fn emit_postfix(m, node, f) {
  let head = node.nodes[0]
  let steps = node.nodes.slice(1, node.nodes.size())
  # an intrinsic or raw op in the prelude is spelled as a call
  if in_prelude &&
      head.name == 'ident' &&
      steps.size() == 1 &&
      steps[0].name == 'call_p' {
    let r = resolved[pkey(head)]
    if r.kind == 'intrinsic' {
      let iname = intrinsics[head.token]
      mut ids = []
      for a in steps[0].nodes[0].nodes {
        ids.push(emit_expr(m, a, f))
      }
      return ir.intrinsic(iname, ids, node)
    }
    if r.kind == 'const' {
      # the 128 ASCII characters, which the prelude cannot spell itself
      return str_l(m, String.from_bytes(range(128).collect()), node)
    }
    if r.kind == 'rawop' {
      let args = steps[0].nodes[0].nodes
      let op = raw_binops[head.token]
      let l = emit_expr(m, args[0], f)
      cond {
        args.size() == 1 => return ir.unary('bitnot', l, node),
        _ => return ir.binary(op, l, emit_expr(m, args[1], f), node),
      }
    }
  }
  # super.m(args) keeps the receiver and starts the lookup at the parent
  if head.name == 'super_mem' && steps.size() > 0 && steps[0].name == 'call_p' {
    let r = resolved[pkey(head)]
    let cp = steps[0]
    let called = call_pre(
      m,
      f,
      '__super_callm',
      [
        home_ref(m, f, r, head),
        ir.bool_literal(r.is_static, head),
        this_ref(m, f, head),
        str_l(m, head.nodes[0].token, head),
        emit_arg_array(m, f, cp.nodes[0].nodes, cp),
      ],
      cp,
    )
    return emit_steps(m, f, called, steps, 1)
  }
  emit_steps(m, f, emit_expr(m, head, f), steps, 0)
}

fn home_ref(m, f, r, at) {
  var_read(m, f, {owner: r.home.owner, slot: r.home.slot}, at)
}

# the `this` a super form runs with (resolved next to the node)
fn this_ref(m, f, node) {
  let r = resolved["this@" + pkey(node)]
  cond {
    r.kind == 'var' => var_read(m, f, r, node),
    _ => nil_l(m, node),
  }
}

# The class value: the constructor function object, its prototype filled
# with the methods and accessors, the statics on itself.
fn emit_class(m, node, f) {
  let info = classes[pkey(node)]
  let tail = node.nodes[1]
  let ext = tail.nodes[0]
  let parent = cond {
    ext.nodes.size() > 0 => emit_expr(m, ext.nodes[0], f),
    _ => nil_l(m, node),
  }
  let ctor = cond {
    info.ctor != nil => ir.closure(f, info.ctor, node),
    _ => nil_l(m, node),
  }
  let fields = cond {
    info.fields_func !=
      nil => mkfn_id(m, f, info.fields_func, 'fields', false, false, node),
    _ => nil_l(m, node),
  }
  let home = {owner: f, slot: info.home}
  mut ids = [var_write(
    m,
    f,
    home,
    call_pre(
      m,
      f,
      '__mkclass',
      [str_l(m, info.name, node), parent, ctor, fields],
      node,
    ),
    node,
  )]
  for mem in info.members {
    let mk = mem.key
    let key = emit_mkey(m, f, mk, mem.node)
    let is_static = ir.bool_literal(mem.is_static, mem.node)
    let pl = mem.node.line
    let pc = mem.node.column
    cond {
      mem.node.name == 'field_c' => {
        let v = cond {
          mem.node.nodes.size() > 1 => emit_expr(m, mem.node.nodes[1], f),
          _ => nil_l(m, front.pos(pl, pc)),
        }
        ids.push(call_pre(
          m,
          f,
          '__set',
          [var_read(m, f, home, front.pos(pl, pc)), key, v],
          front.pos(pl, pc),
        ))
      },
      mem.node.name == 'method_c' ||
        mem.node.name == 'gmethod_c' ||
        mem.node.name == 'amethod_c' => {
        let fv = mkfn_id(
          m,
          f,
          mem.func,
          prop_key_text(mk),
          false,
          true,
          front.pos(pl, pc),
        )
        ids.push(call_pre(
          m,
          f,
          '__def_method',
          [var_read(m, f, home, front.pos(pl, pc)), is_static, key, fv],
          front.pos(pl, pc),
        ))
      },
      _ => {
        let kind = cond {
          mem.node.name == 'getter_c' => 'get',
          _ => 'set',
        }
        let fv = mkfn_id(
          m,
          f,
          mem.func,
          prop_key_text(mk),
          false,
          false,
          front.pos(pl, pc),
        )
        ids.push(call_pre(
          m,
          f,
          '__def_accessor',
          [
            var_read(m, f, home, front.pos(pl, pc)),
            is_static,
            str_l(m, kind, front.pos(pl, pc)),
            key,
            fv,
          ],
          front.pos(pl, pc),
        ))
      },
    }
  }
  ids.push(var_read(m, f, home, node))
  ir.block(ids, node)
}

# an optional step, as the plain step it stands for
fn plain_step(step) {
  let name = cond {
    step.name == 'opt_member' => 'member_p',
    step.name == 'opt_index' => 'index_p',
    _ => 'call_p',
  }
  synth(name, step.nodes, step)
}

fn emit_steps(m, f, value0, steps, start) {
  mut value = value0
  mut i = start
  while i < steps.size() {
    let step = steps[i]
    if step.name.starts_with('opt_') {
      # a?.b: the rest of the chain runs only when a is not nullish
      let tmp = new_scratch(f)
      let store = ir.store_local(tmp, value, step)
      let rest = [plain_step(step)] + steps.slice(i + 1, steps.size())
      let rest_v = emit_steps(m, f, scratch_ref(m, tmp, step), rest, 0)
      let pick = ir.make_if_else(
        call_pre(m, f, '__isnullish', [scratch_ref(m, tmp, step)], step),
        nil_l(m, step),
        rest_v,
        step,
      )
      return ir.block([store, pick], step)
    }
    cond {
      step.name == 'call_p' => {
        cond {
          in_prelude => value = emit_raw_call(
            m,
            f,
            value,
            step.nodes[0].nodes,
            step,
          ),
          _ => value = call_pre(
            m,
            f,
            '__call',
            [
              value,
              nil_l(m, step),
              emit_arg_array(m, f, step.nodes[0].nodes, step),
            ],
            step,
          ),
        }
      },
      step.name == 'member_p' || step.name == 'index_p' => {
        let key = cond {
          step.name == 'member_p' => str_l(m, step.nodes[0].token, step),
          _ => emit_expr(m, step.nodes[0], f),
        }
        # a method call keeps the receiver: o.m(args)
        cond {
          !in_prelude &&
            i + 1 < steps.size() &&
            steps[i + 1].name == 'call_p' => {
            let cp = steps[i + 1]
            value = call_pre(
              m,
              f,
              '__callm',
              [value, key, emit_arg_array(m, f, cp.nodes[0].nodes, cp)],
              cp,
            )
            i = i + 1
          },
          !in_prelude &&
            i + 1 < steps.size() &&
            steps[i + 1].name == 'opt_call' => {
            # o.m?.(args): the receiver is kept, and the rest of the chain
            # runs only when the method is there
            let cp = steps[i + 1]
            let recv = new_scratch(f)
            let fnv = new_scratch(f)
            let store_r = ir.store_local(recv, value, step)
            let store_f = ir.store_local(
              fnv,
              emit_get(m, f, scratch_ref(m, recv, step), key, step),
              step,
            )
            let called = call_pre(
              m,
              f,
              '__call',
              [
                scratch_ref(m, fnv, step),
                scratch_ref(m, recv, step),
                emit_arg_array(m, f, cp.nodes[0].nodes, cp),
              ],
              cp,
            )
            let rest_v = emit_steps(m, f, called, steps, i + 2)
            let pick = ir.make_if_else(
              call_pre(m, f, '__isnullish', [scratch_ref(m, fnv, step)], step),
              nil_l(m, step),
              rest_v,
              step,
            )
            return ir.block([store_r, store_f, pick], step)
          },
          _ => value = emit_get(m, f, value, key, step),
        }
      },
      _ => fail(step, 'unexpected postfix'),
    }
    i = i + 1
  }
  value
}

# `new C.of[k](args).m()`: the grammar puts `new_args` after the steps that
# name the constructor and before the ones applied to the object, so each
# half is an ordinary postfix chain around one __new.
fn emit_new(m, node, f) {
  let steps = node.nodes
  mut cut = 1
  while steps[cut].name != 'new_args' {
    cut = cut + 1
  }
  let callee = emit_steps(
    m,
    f,
    emit_expr(m, steps[0], f),
    steps.slice(0, cut),
    1,
  )
  let arg_nodes = cond {
    steps[cut].nodes.size() > 0 => steps[cut].nodes[0].nodes,
    _ => [],
  }
  let obj = call_pre(
    m,
    f,
    '__new',
    [callee, emit_arg_array(m, f, arg_nodes, node)],
    node,
  )
  emit_steps(m, f, obj, steps, cut + 1)
}

# --- assignment targets ---

# {kind: 'var', r} | {kind: 'global', name} | {kind: 'prop', obj_id, key_id}
# with the object and key already evaluated into temps
fn emit_target(m, f, t) {
  cond {
    t.name == 'paren' => emit_target(m, f, t.nodes[0]),
    t.name == 'ident' => {
      let r = resolved[pkey(t)]
      cond {
        r.kind == 'var' => {kind: 'var', r: r, pre: []},
        r.kind == 'global' => {kind: 'global', name: t.token, pre: []},
        _ => fail(t, 'Invalid assignment target'),
      }
    },
    t.name == 'postfix' => {
      let last = t.nodes[t.nodes.size() - 1]
      if last.name != 'member_p' && last.name != 'index_p' {
        fail(t, 'Invalid assignment target')
      }
      let base = cond {
        t.nodes.size() == 2 => t.nodes[0],
        _ => synth('postfix', t.nodes.slice(0, t.nodes.size() - 1), t),
      }
      let ot = new_scratch(f)
      let kt = new_scratch(f)
      let key = cond {
        last.name == 'member_p' => str_l(m, last.nodes[0].token, last),
        _ => emit_expr(m, last.nodes[0], f),
      }
      let pre = [
        ir.store_local(ot, emit_expr(m, base, f), last),
        ir.store_local(kt, key, last),
      ]
      {kind: 'prop', ot: ot, kt: kt, pre: pre}
    },
    _ => fail(t, 'Invalid assignment target'),
  }
}

fn target_read(m, f, tg, at) {
  cond {
    tg.kind == 'var' => var_read(m, f, tg.r, at),
    tg.kind ==
      'global' => call_pre(m, f, '__gget', [str_l(m, tg.name, at)], at),
    _ => emit_get(
      m,
      f,
      scratch_ref(m, tg.ot, at),
      scratch_ref(m, tg.kt, at),
      at,
    ),
  }
}

# the write, as a node whose value is the stored value
fn target_write(m, f, tg, v, at) {
  cond {
    tg.kind == 'var' => {
      let st = var_write(m, f, tg.r, v, at)
      ir.block([st, var_read(m, f, tg.r, at)], at)
    },
    tg.kind == 'global' => cond {
      in_prelude => ir.set_index(gref(m, f, at), str_l(m, tg.name, at), v, at),
      _ => call_pre(m, f, '__gset', [str_l(m, tg.name, at), v], at),
    },
    _ => emit_set(
      m,
      f,
      scratch_ref(m, tg.ot, at),
      scratch_ref(m, tg.kt, at),
      v,
      at,
    ),
  }
}

fn with_pre(m, pre, v, at) {
  cond {
    pre.size() == 0 => v,
    _ => {
      mut ids = pre
      ids.push(v)
      ir.block(ids, at)
    },
  }
}

fn emit_assign(m, node, f) {
  let [lhs, op, rhs] = node.nodes
  if lhs.name == 'arr_pat' || lhs.name == 'obj_pat' {
    # [a, b] = v: the value is the expression's own
    let tmp = new_scratch(f)
    mut ids = [ir.store_local(tmp, emit_expr(m, rhs, f), op)]
    for x in emit_bind(m, f, lhs, scratch_ref(m, tmp, op), op) {
      ids.push(x)
    }
    ids.push(scratch_ref(m, tmp, op))
    return ir.block(ids, op)
  }
  let tg = emit_target(m, f, lhs)
  cond {
    op.token ==
      '=' => with_pre(
      m,
      tg.pre,
      target_write(m, f, tg, emit_expr(m, rhs, f), op),
      op,
    ),
    op.token == '||=' || op.token == '&&=' || op.token == '??=' => {
      let cur = target_read(m, f, tg, op)
      let tmp = new_scratch(f)
      let store = ir.store_local(tmp, cur, op)
      let test = cond {
        op.token ==
          '??=' => call_pre(m, f, '__isnullish', [scratch_ref(m, tmp, op)], op),
        _ => emit_test(m, f, scratch_ref(m, tmp, op), op),
      }
      let write = target_write(m, f, tg, emit_expr(m, rhs, f), op)
      # `||=` keeps the current value when the test passes; `&&=` and `??=`
      # take the write
      let (then_b, else_b) = cond {
        op.token == '||=' => (scratch_ref(m, tmp, op), write),
        _ => (write, scratch_ref(m, tmp, op)),
      }
      let pick = ir.make_if_else(test, then_b, else_b, op)
      mut ids = tg.pre
      ids.push(store)
      ids.push(pick)
      ir.block(ids, op)
    },
    _ => {
      let bop = op.token.slice(0, op.token.size() - 1).to_string()
      let cur = target_read(m, f, tg, op)
      let v = emit_binop(m, f, bop, cur, emit_expr(m, rhs, f), op)
      with_pre(m, tg.pre, target_write(m, f, tg, v, op), op)
    },
  }
}

fn emit_update(m, node, f, prefix) {
  let (op, t) = cond {
    prefix => (node.nodes[0], node.nodes[1]),
    _ => (node.nodes[1], node.nodes[0]),
  }
  let tg = emit_target(m, f, t)
  let tmp = new_scratch(f)
  let old = cond {
    in_prelude => target_read(m, f, tg, op),
    _ => call_pre(m, f, '__tonum', [target_read(m, f, tg, op)], op),
  }
  let store = ir.store_local(tmp, old, op)
  let delta = cond {
    in_prelude => ir.literal(1, op),
    _ => dbl_l(m, 1.0, op),
  }
  let nv = ir.binary(
    cond {
      op.token == '++' => 'add',
      _ => 'sub',
    },
    scratch_ref(m, tmp, op),
    delta,
    op,
  )
  let write = target_write(m, f, tg, nv, op)
  mut ids = tg.pre
  ids.push(store)
  cond {
    prefix => ids.push(write),
    _ => {
      ids.push(write)
      ids.push(scratch_ref(m, tmp, op))
    },
  }
  ir.block(ids, op)
}

fn emit_unary(m, node, f) {
  if node.nodes.size() == 1 {
    return emit_expr(m, node.nodes[0], f)
  }
  let [op, operand] = node.nodes
  let tok = op.token
  cond {
    tok == 'typeof' => {
      # typeof of an unbound name is 'undefined', not a ReferenceError
      let v = cond {
        !in_prelude &&
          operand.name == 'ident' &&
          resolved[pkey(operand)].kind ==
            'global' => ir.index(
          gref(m, f, op),
          str_l(m, operand.token, op),
          op,
        ),
        _ => emit_expr(m, operand, f),
      }
      cond {
        in_prelude => ir.intrinsic('typeof', [v], op),
        _ => call_pre(m, f, '__typeof_js', [v], op),
      }
    },
    tok == 'void' => ir.block([emit_expr(m, operand, f), nil_l(m, op)], op),
    tok == 'delete' => {
      let tg = emit_target(m, f, operand)
      cond {
        tg.kind ==
          'prop' => with_pre(
          m,
          tg.pre,
          call_pre(
            m,
            f,
            '__delete',
            [scratch_ref(m, tg.ot, op), scratch_ref(m, tg.kt, op)],
            op,
          ),
          op,
        ),
        _ => ir.bool_literal(true, op),
      }
    },
    in_prelude => {
      let v = emit_expr(m, operand, f)
      cond {
        tok == '!' => ir_not(m, v, op),
        tok == '-' => ir.unary('neg', v, op),
        tok == '+' => v,
        _ => ir.unary('bitnot', v, op),
      }
    },
    _ => {
      let v = emit_expr(m, operand, f)
      let name = cond {
        tok == '!' => '__not',
        tok == '-' => '__neg',
        tok == '+' => '__tonum',
        _ => '__bnot',
      }
      call_pre(m, f, name, [v], op)
    },
  }
}

fn emit_object(m, node, f) {
  let tmp = new_scratch(f)
  mut ids = [ir.store_local(tmp, ir.object_lit([], node), node)]
  fn put(pk, pv, pl, pc) {
    ids.push(m.set_index(
      recv: scratch_ref(m, tmp, front.pos(pl, pc)),
      key: pk,
      value: pv,
      line: pl,
      col: pc,
    ))
  }
  # A member under a computed key goes through the prelude: the key is only
  # a value at run time, and an anonymous function takes its name from it,
  # as JS names one after the property it is written under. A static key is
  # a plain store with that name already baked into the function.
  fn put_member(mk, pv, pl, pc) {
    cond {
      mk.name == 'computed_k' &&
        !in_prelude => ids.push(call_pre(
        m,
        f,
        '__def_prop',
        [
          scratch_ref(m, tmp, front.pos(pl, pc)),
          emit_expr(m, mk.nodes[0], f),
          pv,
        ],
        front.pos(pl, pc),
      )),
      _ => put(emit_mkey(m, f, mk, front.pos(pl, pc)), pv, pl, pc),
    }
  }
  for p in node.nodes {
    match p {
      {name: 'kv_p'} => put_member(
        p.nodes[0],
        emit_expr(m, p.nodes[1], f),
        p.line,
        p.column,
      ),
      {name: 'method_p'} | {name: 'gmethod_p'} | {name: 'amethod_p'} => put_member(
        p.nodes[0],
        emit_fn_value(m, p, f, mkey_name(p.nodes[0]), false),
        p.line,
        p.column,
      ),
      {name: 'short_p'} => put(
        str_l(m, p.nodes[0].token, p),
        emit_expr(m, p.nodes[0], f),
        p.line,
        p.column,
      ),
      {name: 'getter_p'} | {name: 'setter_p'} => put(
        emit_acc_key(m, f, p, p),
        emit_fn_value(m, p, f, mkey_name(p.nodes[0]), false),
        p.line,
        p.column,
      ),
      {name: 'ospread'} => ids.push(call_pre(
        m,
        f,
        '__obj_spread',
        [scratch_ref(m, tmp, p), emit_expr(m, p.nodes[0], f)],
        p,
      )),
      _ => nil,
    }
  }
  ids.push(scratch_ref(m, tmp, node))
  ir.block(ids, node)
}

# The property name a member key stores under, and the one an accessor of
# that name stores under; a computed key is only known at run time.
fn emit_mkey(m, f, mk, at) {
  cond {
    mk.name != 'computed_k' => str_l(m, prop_key_text(mk), at),
    in_prelude => emit_expr(m, mk.nodes[0], f),
    _ => call_pre(m, f, '__key', [emit_expr(m, mk.nodes[0], f)], at),
  }
}
fn emit_acc_key(m, f, mem, at) {
  let kind = cond {
    mem.name.starts_with('getter') => 'get',
    _ => 'set',
  }
  let mk = mem.nodes[0]
  cond {
    mk.name != 'computed_k' => str_l(m, "\x01{kind}:{prop_key_text(mk)}", at),
    _ => call_pre(
      m,
      f,
      '__acc_key',
      [str_l(m, kind, at), emit_expr(m, mk.nodes[0], f)],
      at,
    ),
  }
}

# a numeric literal key, spelled the way ToString would
fn number_key(tok) {
  let v = number_value(tok)
  cond {
    v == to_float(to_long(v)) && v < 1.0e21 && v > -1.0e21 => "{to_long(v)}",
    _ => "{v}",
  }
}

fn emit_expr(m, node, f) {
  match node {
    {name: 'number'} => cond {
      in_prelude &&
        !node.token.contains('.') &&
        !node.token.contains('e') &&
        !node.token.contains('E') => ir.literal(to_long(node.token), node),
      _ => dbl_l(m, number_value(node.token), node),
    },
    {name: 'string'} => emit_string(m, node),
    {name: 'template'} => emit_template(m, node, f),
    {name: 'true_l'} => ir.bool_literal(true, node),
    {name: 'false_l'} => ir.bool_literal(false, node),
    {name: 'null_l'} => ir.index(
      gref(m, f, node),
      str_l(m, 'null', node),
      node,
    ),
    {name: 'this_e'} => {
      let r = resolved[pkey(node)]
      cond {
        r.kind == 'var' => var_read(m, f, r, node),
        _ => nil_l(m, node),
      }
    },
    {name: 'ident'} => {
      let r = resolved[pkey(node)]
      cond {
        r.kind == 'var' => var_read(m, f, r, node),
        r.kind == 'fn' => ir.closure(f, r.func, node),
        r.kind ==
          'preconst' => ir.index(gref(m, f, node), str_l(m, r.key, node), node),
        r.kind == 'global' => cond {
          node.token == 'undefined' => nil_l(m, node),
          in_prelude => ir.index(
            gref(m, f, node),
            str_l(m, node.token, node),
            node,
          ),
          _ => call_pre(m, f, '__gget', [str_l(m, node.token, node)], node),
        },
        _ => fail(node, "cannot use '{node.token}' as a value"),
      }
    },
    {name: 'paren'} => emit_expr(m, node.nodes[0], f),
    {name: 'arrow'} | {name: 'async_arrow'} => emit_fn_value(
      m,
      node,
      f,
      '',
      true,
    ),
    {name: 'await_e'} => ir.make_yield(emit_expr(m, node.nodes[0], f), node),
    {name: 'fn_expr'} => {
      let fname = node.nodes[0]
      let name = cond {
        fname.nodes.size() > 0 => fname.nodes[0].token,
        _ => '',
      }
      # a named function expression binds its own name in its scope: the
      # prologue stores the closure into that slot, so the value here is
      # just the function
      emit_fn_value(m, node, f, name, false)
    },
    {name: 'class_e'} => emit_class(m, node, f),
    {name: 'gen_expr'} => {
      let fname = node.nodes[0]
      let name = cond {
        fname.nodes.size() > 0 => fname.nodes[0].token,
        _ => '',
      }
      emit_fn_value(m, node, f, name, false)
    },
    {name: 'async_expr'} => {
      let fname = node.nodes[0]
      let name = cond {
        fname.nodes.size() > 0 => fname.nodes[0].token,
        _ => '',
      }
      emit_fn_value(m, node, f, name, false)
    },
    {name: 'yield_e'} => {
      let yv = node.nodes[0]
      let v = cond {
        yv.nodes.size() > 0 => emit_expr(m, yv.nodes[0], f),
        _ => nil_l(m, node),
      }
      ir.make_yield(v, node)
    },
    {name: 'yield_from'} => {
      # it = iterator(expr); r = it.next(); while (!r.done) { sent = yield r.value; r = it.next(sent) }; r.value
      let it = new_scratch(f)
      let r = new_scratch(f)
      let sent = new_scratch(f)
      fn next_of(arg) {
        call_pre(
          m,
          f,
          '__callm',
          [
            scratch_ref(m, it, node),
            str_l(m, 'next', node),
            ir.array_lit([arg], node),
          ],
          node,
        )
      }
      fn field(k) {
        call_pre(
          m,
          f,
          '__get',
          [scratch_ref(m, r, node), str_l(m, k, node)],
          node,
        )
      }
      let body = ir.block(
        [
          ir.store_local(sent, ir.make_yield(field('value'), node), node),
          ir.store_local(r, next_of(scratch_ref(m, sent, node)), node),
        ],
        node,
      )
      ir.block(
        [
          ir.store_local(
            it,
            call_pre(
              m,
              f,
              '__iter_obj',
              [emit_expr(m, node.nodes[0], f)],
              node,
            ),
            node,
          ),
          ir.store_local(r, next_of(nil_l(m, node)), node),
          ir.make_while(
            ir_not(m, call_pre(m, f, '__truthy', [field('done')], node), node),
            body,
            node,
          ),
          field('value'),
        ],
        node,
      )
    },
    {name: 'super_call'} => {
      let r = resolved[pkey(node)]
      let call = call_pre(
        m,
        f,
        '__super_call',
        [
          home_ref(m, f, r, node),
          this_ref(m, f, node),
          emit_arg_array(m, f, node.nodes[0].nodes, node),
        ],
        node,
      )
      # the instance fields of the class whose constructor this is run
      # once the parent has built the object
      ir.block(
        [
          call,
          call_pre(
            m,
            f,
            '__run_fields',
            [home_ref(m, f, r, node), this_ref(m, f, node)],
            node,
          ),
        ],
        node,
      )
    },
    {name: 'super_mem'} => {
      let r = resolved[pkey(node)]
      call_pre(
        m,
        f,
        '__super_get',
        [
          home_ref(m, f, r, node),
          ir.bool_literal(r.is_static, node),
          this_ref(m, f, node),
          str_l(m, node.nodes[0].token, node),
        ],
        node,
      )
    },
    {name: 'assign_e'} => emit_assign(m, node, f),
    {name: 'pre_inc'} => emit_update(m, node, f, true),
    {name: 'post_inc'} => emit_update(m, node, f, false),
    {name: 'unary'} => emit_unary(m, node, f),
    {name: 'postfix'} => emit_postfix(m, node, f),
    {name: 'new_e'} => emit_new(m, node, f),
    {name: 'array_lit'} => emit_arg_array(m, f, node.nodes, node),
    {name: 'object_lit'} => emit_object(m, node, f),
    {name: 'ternary'} => {
      let [c, a, b] = node.nodes
      ir.make_if_else(
        emit_test(m, f, emit_expr(m, c, f), node),
        emit_expr(m, a, f),
        emit_expr(m, b, f),
        node,
      )
    },
    {name: 'exp_e'} => {
      let l = emit_expr(m, node.nodes[0], f)
      let r = emit_expr(m, node.nodes[1], f)
      emit_binop(m, f, '**', l, r, node)
    },
    {name: 'seq_e'} => {
      mut ids = []
      for c in node.nodes {
        ids.push(emit_expr(m, c, f))
      }
      ir.block(ids, node)
    },
    {name: 'lor'} | {name: 'land'} | {name: 'nullish'} => emit_shortcircuit(
      m,
      node,
      f,
    ),
    {name: 'spread'} => fail(node, 'unexpected spread'),
    _ => cond {
      node.nodes != nil && node.nodes.size() >= 3 => emit_chain(m, node, f),
      node.nodes != nil &&
        node.nodes.size() == 1 => emit_expr(m, node.nodes[0], f),
      _ => fail(node, "unexpected expression '{node.name}'"),
    },
  }
}

# --- statements ---

fn emit_block(m, blk, f) {
  let slots = block_slots[pkey(blk)]
  mut ids = fresh_slots(m, f, slots, blk)
  emit_stmts_into(m, blk.nodes, f, ids)
  ir.block(ids, blk)
}

# a block's own bindings start out undefined on every entry; a captured
# one gets a fresh cell so earlier closures keep theirs
fn fresh_slots(m, f, slots, at) {
  mut ids = []
  for s in slots {
    cond {
      frames.in_cell(f, s) => {
        ids.push(ir.cell_fresh(frames.cell_of(f, s), at))
        ids.push(ir.store_cell(frames.cell_of(f, s), nil_l(m, at), at))
      },
      _ => ids.push(ir.store_local(s, nil_l(m, at), at)),
    }
  }
  ids
}

fn emit_stmts_into(m, stmts, f, ids) {
  # hoisted function declarations come first
  for s in stmts {
    if fn_decl_forms.has(s.name) {
      let r = resolved[pkey(s.nodes[0])]
      ids.push(var_write(
        m,
        f,
        r,
        emit_fn_value(m, s, f, s.nodes[0].token, false),
        s,
      ))
    }
  }
  for s in stmts {
    if !fn_decl_forms.has(s.name) {
      let e = emit_stmt(m, s, f)
      if e != nil {
        ids.push(e)
      }
    }
  }
  nil
}

fn emit_sub(m, st, f) {
  cond {
    st.name == 'block' => emit_block(m, st, f),
    _ => {
      let e = emit_stmt(m, st, f)
      cond {
        e == nil => ir.block([], st),
        _ => e,
      }
    },
  }
}

# Bind a pattern to a value: the statements that store it, in order. An
# identifier writes its binding (a declaration's, or an assignment's
# target: a global when nothing declares it).
fn write_ident(m, f, id, v, at) {
  let r = resolved[pkey(id)]
  cond {
    r.kind == 'var' => var_write(m, f, r, v, at),
    r.kind ==
      'global' => call_pre(m, f, '__gset', [str_l(m, id.token, at), v], at),
    _ => fail(id, 'Invalid assignment target'),
  }
}

fn emit_bind(m, f, pat, v, at) {
  cond {
    pat.name == 'ident' => [write_ident(m, f, pat, v, at)],
    pat.name == 'postfix' || pat.name == 'paren' => {
      let tg = emit_target(m, f, pat)
      [with_pre(m, tg.pre, target_write(m, f, tg, v, at), at)]
    },
    pat.name == 'pat_dflt' || pat.name == 'opat_short' => cond {
      pat.nodes.size() > 1 => {
        # the default applies when the value is undefined
        let tmp = new_scratch(f)
        let store = ir.store_local(tmp, v, at)
        let test = is_undef(m, scratch_ref(m, tmp, at), at)
        let picked = ir.make_if_else(
          test,
          emit_expr(m, pat.nodes[1], f),
          scratch_ref(m, tmp, at),
          at,
        )
        mut ids = [store]
        for x in emit_bind(m, f, pat.nodes[0], picked, at) {
          ids.push(x)
        }
        ids
      },
      _ => emit_bind(m, f, pat.nodes[0], v, at),
    },
    pat.name == 'arr_pat' => {
      let tmp = new_scratch(f)
      mut ids = [ir.store_local(
        tmp,
        call_pre(m, f, '__destr_arr', [v], at),
        at,
      )]
      mut i = 0
      for el in pat.nodes {
        cond {
          el.name == 'pat_hole' => nil,
          el.name == 'rest_b' => {
            let rest = call_pre(
              m,
              f,
              '__slice_from',
              [scratch_ref(m, tmp, at), ir.literal(i, at)],
              at,
            )
            for x in emit_bind(m, f, el.nodes[0], rest, at) {
              ids.push(x)
            }
          },
          _ => {
            let item = call_pre(
              m,
              f,
              '__at',
              [scratch_ref(m, tmp, at), ir.literal(i, at)],
              at,
            )
            for x in emit_bind(m, f, el, item, at) {
              ids.push(x)
            }
          },
        }
        i = i + 1
      }
      ids
    },
    pat.name == 'obj_pat' => {
      let tmp = new_scratch(f)
      mut ids = [ir.store_local(
        tmp,
        call_pre(m, f, '__destr_obj', [v], at),
        at,
      )]
      mut keys = []
      for el in pat.nodes {
        cond {
          el.name == 'rest_b' => {
            mut kids = []
            for k in keys {
              kids.push(str_l(m, k, at))
            }
            let rest = call_pre(
              m,
              f,
              '__obj_rest',
              [scratch_ref(m, tmp, at), ir.array_lit(kids, at)],
              at,
            )
            for x in emit_bind(m, f, el.nodes[0], rest, at) {
              ids.push(x)
            }
          },
          _ => {
            let (key, target) = cond {
              el.name == 'opat_kv' => (prop_key_text(el.nodes[0]), el.nodes[1]),
              _ => (el.nodes[0].token, el),
            }
            keys.push(key)
            let item = call_pre(
              m,
              f,
              '__get',
              [scratch_ref(m, tmp, at), str_l(m, key, at)],
              at,
            )
            for x in emit_bind(m, f, target, item, at) {
              ids.push(x)
            }
          },
        }
      }
      ids
    },
    _ => fail(pat, "unexpected pattern '{pat.name}'"),
  }
}

# a literal property key's text: a name, a string, or a number
fn prop_key_text(k) {
  cond {
    k.name == 'string' => unescape(k.token.slice(1, k.token.size() - 1)),
    k.name == 'number' => number_key(k.token),
    _ => k.token,
  }
}

# `let f = function () {}` / `= () => ..` / `= class {}` names the value
# after the binding, as JS does
fn emit_named_value(m, f, value, name) {
  cond {
    value.name == 'arrow' ||
      value.name == 'async_arrow' => emit_fn_value(m, value, f, name, true),
    (value.name == 'fn_expr' ||
      value.name == 'async_expr' ||
      value.name == 'gen_expr') &&
      value.nodes[0].nodes.size() ==
        0 => emit_fn_value(m, value, f, name, false),
    value.name == 'class_e' && value.nodes[0].nodes.size() == 0 => {
      classes[pkey(value)].name = name
      emit_class(m, value, f)
    },
    _ => emit_expr(m, value, f),
  }
}

fn emit_decl(m, node, f) {
  mut ids = []
  mut i = 1
  while i < node.nodes.size() {
    let d = node.nodes[i]
    let pat = d.nodes[0]
    cond {
      d.nodes.size() > 1 => {
        let v = cond {
          pat.name == 'ident' => emit_named_value(m, f, d.nodes[1], pat.token),
          _ => emit_expr(m, d.nodes[1], f),
        }
        for x in emit_bind(m, f, pat, v, pat) {
          ids.push(x)
        }
      },
      node.nodes[0].token == 'var' => nil,  # `var x;` leaves the binding alone
      pat.name ==
        'ident' => ids.push(write_ident(m, f, pat, nil_l(m, pat), pat)),
      _ => fail(pat, 'Missing initializer in destructuring declaration'),
    }
    i = i + 1
  }
  cond {
    ids.size() == 0 => nil,
    ids.size() == 1 => ids[0],
    _ => ir.block(ids, node),
  }
}

fn for_step_ids(m, f, slots, step_node, at) {
  mut ids = []
  for s in slots {
    if frames.in_cell(f, s) {
      let tmp = new_scratch(f)
      let ci = frames.cell_of(f, s)
      ids.push(ir.store_local(tmp, ir.cell(ci, at), at))
      ids.push(ir.cell_fresh(ci, at))
      ids.push(ir.store_cell(ci, scratch_ref(m, tmp, at), at))
    }
  }
  if step_node != nil {
    ids.push(emit_expr(m, step_node, f))
  }
  ids
}

# The label(s) (if any) immediately wrapping the loop/switch about to push
# its own loop_ctx entry -- taken and cleared here, since a label always
# names the very next loop/switch the grammar lets it wrap (see label_s).
fn take_pending_labels(f) {
  let labels = pending_labels[f]
  pending_labels[f] = []
  labels
}

fn has_label(labels, name) {
  mut i = 0
  while i < labels.size() {
    if labels[i] == name {
      return true
    }
    i = i + 1
  }
  false
}

# Depth (loop_ctx frames to skip) from the innermost loop/switch out to the
# one `name` labels. `want_loop` rejects a switch target (JS: continue may
# only name an enclosing iteration statement, never a switch).
fn find_label_depth(f, name, want_loop, node) {
  let ctx = loop_ctx[f]
  mut i = ctx.size() - 1
  while i >= 0 {
    if ctx[i].labels != nil && has_label(ctx[i].labels, name) {
      if want_loop && ctx[i].cont != nil {
        fail(
          node,
          "Illegal continue statement: '" +
            name +
            "' does not denote an iteration statement",
        )
      }
      return ctx.size() - 1 - i
    }
    i = i - 1
  }
  fail(node, "Undefined label '" + name + "'")
}

fn emit_stmt(m, node, f) {
  match node {
    {name: 'var_decl'} | {name: 'var_decl_ns'} => emit_decl(m, node, f),
    {name: 'fn_decl'} => nil,
    {name: 'class_d'} => {
      let id = node.nodes[0]
      let r = resolved[pkey(id)]
      var_write(m, f, r, emit_class(m, node, f), node)
    },
    {name: 'if_s'} => {
      let c = emit_test(m, f, emit_expr(m, node.nodes[0], f), node)
      let t = emit_sub(m, node.nodes[1], f)
      cond {
        node.nodes.size() >
          2 => ir.make_if_else(
          c,
          t,
          emit_sub(m, node.nodes[2].nodes[0], f),
          node,
        ),
        _ => ir.make_if(c, t, node),
      }
    },
    {name: 'while_s'} => {
      loop_ctx[f].push({step: nil, labels: take_pending_labels(f)})
      let body = emit_sub(m, node.nodes[1], f)
      loop_ctx[f].pop()
      ir.make_while(
        emit_test(m, f, emit_expr(m, node.nodes[0], f), node),
        body,
        node,
      )
    },
    {name: 'do_s'} => {
      # first = true; while (first || cond) { first = false; body }
      let flag = new_scratch(f)
      loop_ctx[f].push({step: nil, labels: take_pending_labels(f)})
      let body = emit_sub(m, node.nodes[0], f)
      loop_ctx[f].pop()
      let test = ir.make_if_else(
        scratch_ref(m, flag, node),
        ir.bool_literal(true, node),
        emit_test(m, f, emit_expr(m, node.nodes[1], f), node),
        node,
      )
      let clear = ir.store_local(flag, ir.bool_literal(false, node), node)
      ir.block(
        [
          ir.store_local(flag, ir.bool_literal(true, node), node),
          ir.make_while(test, ir.block([clear, body], node), node),
        ],
        node,
      )
    },
    {name: 'for_s'} => {
      let [init, cnd, step, body] = node.nodes
      let slots = block_slots[pkey(node)]
      mut ids = fresh_slots(m, f, slots, node)
      if init.nodes.size() > 0 {
        let i0 = init.nodes[0]
        let e = cond {
          i0.name == 'var_decl_ns' => emit_decl(m, i0, f),
          _ => emit_expr(m, i0, f),
        }
        if e != nil {
          ids.push(e)
        }
      }
      let step_node = cond {
        step.nodes.size() > 0 => step.nodes[0],
        _ => nil,
      }
      loop_ctx[f].push({step: fn (m2) {
        for_step_ids(m2, f, slots, step_node, node)
      }, labels: take_pending_labels(f)})
      let b = emit_sub(m, body, f)
      loop_ctx[f].pop()
      mut body_ids = [b]
      for s in for_step_ids(m, f, slots, step_node, node) {
        body_ids.push(s)
      }
      let test = cond {
        cnd.nodes.size() >
          0 => emit_test(m, f, emit_expr(m, cnd.nodes[0], f), node),
        _ => ir.bool_literal(true, node),
      }
      ids.push(ir.make_while(test, ir.block(body_ids, node), node))
      ir.block(ids, node)
    },
    {name: 'for_of'} => emit_for_each(m, node, f, '__iter'),
    {name: 'for_in'} => emit_for_each(m, node, f, '__forin_iter'),
    {name: 'switch_s'} => emit_switch(m, node, f),
    {name: 'return_s'} => {
      let rv = node.nodes[0]
      let v = cond {
        rv.nodes.size() > 0 => emit_expr(m, rv.nodes[0], f),
        _ => nil_l(m, node),
      }
      ir.make_return(v, node)
    },
    {name: 'break_s'} => cond {
      node.nodes.size() == 0 => ir.make_break(node),
      _ => {
        let depth = find_label_depth(f, node.nodes[0].token, false, node)
        ir.make_break(node, depth)
      },
    },
    {name: 'continue_s'} => {
      let ctx = loop_ctx[f]
      if ctx.size() == 0 {
        fail(node, 'Illegal continue statement')
      }
      cond {
        # A labeled continue already names its exact target (must be a real
        # loop, checked by find_label_depth): jump straight there, running
        # that loop's own step first -- no need for the switch-forwarding
        # dance below, since the depth crosses any switch in between as a
        # plain loop_ctx frame, not a construct we have to unwind by hand.
        node.nodes.size() > 0 => {
          let depth = find_label_depth(f, node.nodes[0].token, true, node)
          let target = ctx[ctx.size() - 1 - depth]
          mut ids = cond {
            target.step != nil => target.step(m),
            _ => [],
          }
          ids.push(ir.make_continue(node, depth))
          ir.block(ids, node)
        },
        _ => {
          let top = ctx[ctx.size() - 1]
          cond {
            # inside a switch: leave it with the flag set; the enclosing
            # loop continues after the switch
            top.cont !=
              nil => ir.block(
              [
                ir.store_local(top.cont, ir.bool_literal(true, node), node),
                ir.make_break(node),
              ],
              node,
            ),
            top.step == nil => ir.make_continue(node),
            _ => {
              mut ids = top.step(m)
              ids.push(ir.make_continue(node))
              ir.block(ids, node)
            },
          }
        },
      }
    },
    {name: 'label_s'} => {
      pending_labels[f].push(node.nodes[0].token)
      emit_sub(m, node.nodes[1], f)
    },
    {name: 'throw_s'} => ir.make_throw(emit_expr(m, node.nodes[0], f), node),
    {name: 'try_s'} => emit_try(m, node, f),
    {name: 'block'} => emit_block(m, node, f),
    {name: 'empty_s'} => nil,
    {name: 'expr_s'} => emit_expr(m, node.nodes[0], f),
    _ => emit_expr(m, node, f),
  }
}

# for (pat of/in src) body: the source's iterator (for-in walks its key
# list), each step binding the pattern anew
fn emit_for_each(m, node, f, iter_fn) {
  let [kw, pat, src, body] = node.nodes
  let closer = cond {
    for_close.has(pkey(node)) => for_close[pkey(node)],
    _ => nil,
  }
  let cur = new_scratch(f)
  # the iterator: a hidden binding (for-of, whose closer captures it) or a
  # plain temp (for-in)
  let it_slot = cond {
    closer != nil => closer.slot,
    _ => new_scratch(f),
  }
  # the loop's own bindings, refreshed per iteration -- not the iterator's
  let slots = block_slots[pkey(node)].filter(|sl| sl != it_slot)
  let it_a = frames.access(f, f, it_slot)
  fn it_ref(m2) {
    m2.var_ref(
      kind: it_a.kind,
      index: it_a.index,
      line: node.line,
      col: node.column,
    )
  }
  mut ids = [m.assign(
    kind: it_a.kind,
    index: it_a.index,
    value: call_pre(m, f, iter_fn, [emit_expr(m, src, f)], node),
    line: node.line,
    col: node.column,
  )]
  fn advance(m2) {
    [m2.assign(
      kind: 'local',
      index: cur,
      value: call_pre(m2, f, '__iter_step', [it_ref(m2)], node),
      line: node.line,
      col: node.column,
    )]
  }
  ids.push(advance(m)[0])
  loop_ctx[f].push({step: advance, labels: take_pending_labels(f)})
  let b = emit_sub(m, body, f)
  loop_ctx[f].pop()
  mut body_ids = fresh_slots(m, f, slots, node)
  let item = ir.index(scratch_ref(m, cur, node), ir.literal(0, node), node)
  for x in emit_bind(m, f, pat, item, node) {
    body_ids.push(x)
  }
  body_ids.push(b)
  body_ids.push(advance(m)[0])
  let test = ir_not(m, is_undef(m, scratch_ref(m, cur, node), node), node)
  ids.push(ir.make_while(test, ir.block(body_ids, node), node))
  let loop = ir.block(ids, node)
  cond {
    closer != nil => {
      let d = ir.make_defer(ir.closure(f, closer.func, node), node)
      ir.scope(0, 0, ir.block([d, loop], node), node)
    },
    _ => loop,
  }
}

# switch: pick the first case whose value is === the subject (else the
# default), then run every case body from there on -- fall-through -- in a
# loop a break leaves.
fn emit_switch(m, node, f) {
  let cases = node.nodes.slice(1, node.nodes.size())
  let slots = block_slots[pkey(node)]
  let subj = new_scratch(f)
  let idx = new_scratch(f)
  let cont = new_scratch(f)
  let none = 1000000
  mut ids = fresh_slots(m, f, slots, node)
  ids.push(ir.store_local(subj, emit_expr(m, node.nodes[0], f), node))
  ids.push(ir.store_local(idx, ir.literal(none, node), node))
  ids.push(ir.store_local(cont, ir.bool_literal(false, node), node))
  # the tests, in order, each stopping the search
  mut default_i = nil
  mut chain = ir.block([], node)
  mut k = cases.size() - 1
  while k >= 0 {
    let c = cases[k]
    cond {
      c.name == 'default_c' => default_i = k,
      _ => {
        let test = call_pre(
          m,
          f,
          '__seq',
          [scratch_ref(m, subj, node), emit_expr(m, c.nodes[0], f)],
          c,
        )
        chain = ir.make_if_else(
          test,
          ir.store_local(idx, ir.literal(k, node), node),
          chain,
          c,
        )
      },
    }
    k = k - 1
  }
  ids.push(chain)
  if default_i != nil {
    ids.push(ir.make_if(
      ir.binary('eq', scratch_ref(m, idx, node), ir.literal(none, node), node),
      ir.store_local(idx, ir.literal(default_i, node), node),
      node,
    ))
  }
  loop_ctx[f].push({step: nil, cont: cont, labels: take_pending_labels(f)})
  mut body_ids = []
  for k2 in range(cases.size()) {
    let c = cases[k2]
    let body = c.nodes[c.nodes.size() - 1]
    mut stmt_ids = []
    emit_stmts_into(m, body.nodes, f, stmt_ids)
    body_ids.push(ir.make_if(
      ir.binary('le', scratch_ref(m, idx, node), ir.literal(k2, node), node),
      ir.block(stmt_ids, c),
      c,
    ))
  }
  loop_ctx[f].pop()
  body_ids.push(ir.make_break(node))
  ids.push(ir.make_while(
    ir.bool_literal(true, node),
    ir.block(body_ids, node),
    node,
  ))
  # a continue inside targeted the loop around the switch
  let outer = loop_ctx[f]
  if outer.size() > 0 {
    let top = outer[outer.size() - 1]
    mut cids = cond {
      top.step != nil => top.step(m),
      _ => [],
    }
    cids.push(cond {
      top.cont !=
        nil => ir.block(
        [
          ir.store_local(top.cont, ir.bool_literal(true, node), node),
          ir.make_break(node),
        ],
        node,
      ),
      _ => ir.make_continue(node),
    })
    ids.push(ir.make_if(scratch_ref(m, cont, node), ir.block(cids, node), node))
  }
  ir.block(ids, node)
}

fn emit_try(m, node, f) {
  mut body = emit_block(m, node.nodes[0], f)
  mut catch_c = nil
  mut finally_c = nil
  mut i = 1
  while i < node.nodes.size() {
    let c = node.nodes[i]
    cond {
      c.name == 'catch_c' => catch_c = c,
      _ => finally_c = c,
    }
    i = i + 1
  }
  if catch_c != nil {
    let r = resolved[pkey(catch_c)]
    let a = frames.access(f, f, r.slot)
    # the VM lands the value in a plain local; a captured binding is copied
    # into its cell after the trap-to-error fix
    let slot = cond {
      a.kind == 'local' => a.index,
      _ => new_scratch(f),
    }
    let fixed = cond {
      in_prelude => scratch_ref(m, slot, node),
      _ => call_pre(m, f, '__catch_fix', [scratch_ref(m, slot, node)], node),
    }
    let bind = cond {
      a.kind == 'local' => ir.store_local(slot, fixed, node),
      _ => ir.block(
        [ir.cell_fresh(a.index, node), ir.store_cell(a.index, fixed, node)],
        node,
      ),
    }
    let handler = ir.block([bind, emit_block(m, catch_c.nodes[1], f)], node)
    body = ir.make_try(slot, body, handler, node)
  }
  if finally_c != nil {
    # finally runs on every way out: as a defer in a scope around the try
    let g = closure_of[pkey(finally_c)]
    let d = ir.make_defer(ir.closure(f, g, node), node)
    body = ir.scope(0, 0, ir.block([d, body], node), node)
  }
  body
}

# --- functions and the driver ---

# The JS function object for VM function g: its closure, its name, whether
# it binds `this` lexically, and (where a caller wants it) the arity a
# `fn.length` reports.
fn mkfn_id(m, f, g, name, is_arrow, with_len, at) {
  mut args = [
    ir.closure(f, g, at),
    str_l(m, name, at),
    ir.bool_literal(is_arrow, at),
  ]
  if with_len {
    args.push(dbl_l(m, to_float(fn_length(g)), at))
  }
  call_pre(m, f, '__mkfn', args, at)
}

# The positionals that overflowed a function's declared parameters: the
# eight hidden trailing slots, trimmed to the count the call supplied.
fn rest_pack(m, f, first, at) {
  mut hidden = []
  for k in range(8) {
    hidden.push(ir.local(first + k, at))
  }
  let cnt = ir.binary(
    'sub',
    ir.intrinsic('argcount', [], at),
    ir.literal(first, at),
    at,
  )
  call_pre(m, f, '__rest_pack', [ir.array_lit(hidden, at), cnt], at)
}

fn emit_funcs(m) {
  for f in range(funcs.size()) {
    let fi = funcs[f]
    in_prelude = fi.is_prelude
    mut ids = []
    # defaults: a parameter that arrived undefined takes its default. A
    # generator's wrapper has no parameters of its own, so it has no
    # defaults either -- they are the body's, and running them here as well
    # would run them twice.
    for pi in range(fi.dflts.size()) {
      let d = fi.dflts[pi]
      if d != nil {
        let slot = pi + cond {
          fi.params.size() > fi.dflts.size() => 1,
          _ => 0,
        }
        let test = is_undef(m, ir.local(slot, front.ORIGIN), front.ORIGIN)
        ids.push(ir.make_if(
          test,
          ir.store_local(slot, emit_expr(m, d, f), front.ORIGIN),
          front.ORIGIN,
        ))
      }
    }
    # a rest parameter: pack the hidden trailing slots by the supplied count
    if fi.rest != nil {
      ids.push(ir.write(
        f,
        f,
        fi.params.size(),
        rest_pack(m, f, fi.params.size() - 8, front.ORIGIN),
        front.ORIGIN,
      ))
    }
    # a base class's constructor runs the instance fields at entry
    if fi.is_ctor == true && fi.derived != true {
      let hr = var_read(
        m,
        f,
        {owner: fi.home.owner, slot: fi.home.slot},
        front.ORIGIN,
      )
      ids.push(call_pre(
        m,
        f,
        '__run_fields',
        [hr, ir.local(0, front.ORIGIN)],
        front.ORIGIN,
      ))
    }
    # pattern parameters unpack from their hidden slots
    if fi.pat_params != nil {
      for pp in fi.pat_params {
        let (slot, pat) = pp
        for x in emit_bind(m, f, pat, ir.local(slot, front.ORIGIN), front.ORIGIN) {
          ids.push(x)
        }
      }
    }
    # captured parameters move into their cells
    for p in range(fi.params.size()) {
      if frames.in_cell(f, p) {
        ids.push(ir.store_cell(
          frames.cell_of(f, p),
          ir.local(p, front.ORIGIN),
          front.ORIGIN,
        ))
      }
    }
    # a named function expression's own name
    if fi.self_slot != nil {
      ids.push(ir.write(
        f,
        f,
        fi.self_slot,
        mkfn_id(m, f, f, fi.name, false, false, front.ORIGIN),
        front.ORIGIN,
      ))
    }
    # the function's vars start out undefined
    for s in fi.var_names {
      ids.push(ir.write(f, f, s, nil_l(m, front.ORIGIN), front.ORIGIN))
    }
    if f == 0 {
      # the global table exists before anything fills it, so the prelude's
      # own constants have a home that __init_globals can already reach
      ids.push(ir.store_cell(
        frames.cell_of(0, g_slot),
        ir.object_lit([], front.ORIGIN),
        front.ORIGIN,
      ))
      in_prelude = true
      for b in prelude_inits {
        ids.push(ir.set_index(
          gref(m, 0, front.ORIGIN),
          str_l(m, b.key, front.ORIGIN),
          emit_expr(m, b.init, 0),
          front.ORIGIN,
        ))
      }
      in_prelude = false
      ids.push(call_pre(m, 0, '__init_globals', [], front.ORIGIN))
      ids.push(ir.write(
        0,
        0,
        this_slot,
        ir.object_lit([], front.ORIGIN),
        front.ORIGIN,
      ))
    }
    cond {
      fi.close_of != nil => {
        ids.push(call_pre(
          m,
          f,
          '__iter_close',
          [ir.read(f, fi.close_of.owner, fi.close_of.slot, front.ORIGIN)],
          front.ORIGIN,
        ))
        ids.push(ir.make_return(nil_l(m, front.ORIGIN), front.ORIGIN))
      },
      fi.gen_raw != nil => {
        # the wrapper: the raw generator's activation, as a generator object
        let args = rest_pack(m, f, 1, front.ORIGIN)
        let act = call_pre(
          m,
          f,
          '__apply',
          [
            ir.closure(f, fi.gen_raw, front.ORIGIN),
            ir.local(0, front.ORIGIN),
            args,
          ],
          front.ORIGIN,
        )
        ids.push(ir.make_return(call_pre(
          m,
          f,
          cond {
            fi.is_async == true => '__async_run',
            _ => '__mkgen',
          },
          [act],
          front.ORIGIN,
        ), front.ORIGIN))
      },
      fi.field_inits != nil => {
        # this.key = init, in order; a computed key was evaluated at the
        # class definition (captured through the home is not needed: the
        # key expression is re-evaluated here, which the samples avoid)
        for fld in fi.field_inits {
          let key = emit_mkey(m, f, fld.nodes[0], fld)
          let v = cond {
            fld.nodes.size() > 1 => emit_expr(m, fld.nodes[1], f),
            _ => nil_l(m, fld),
          }
          ids.push(call_pre(
            m,
            f,
            '__set',
            [ir.local(0, front.ORIGIN), key, v],
            fld,
          ))
        }
        ids.push(ir.make_return(nil_l(m, front.ORIGIN), front.ORIGIN))
      },
      fi.body_expr !=
        nil => ids.push(ir.make_return(
        emit_expr(m, fi.body_expr, f),
        front.ORIGIN,
      )),
      _ => {
        emit_stmts_into(m, fi.stmts, f, ids)
        ids.push(ir.make_return(nil_l(m, front.ORIGIN), front.ORIGIN))
      },
    }
    mut body = ir.block(ids, front.ORIGIN)
    if f == 0 {
      # whatever escapes the program is reported the way Node reports it
      let slot = new_scratch(0)
      let caught = ir.local(slot, front.ORIGIN)
      body = ir.make_try(
        slot,
        body,
        ir.make_throw(
          call_pre(m, 0, '__uncaught_text', [caught], front.ORIGIN),
          front.ORIGIN,
        ),
        front.ORIGIN,
      )
    }
    let func = ir.add_func(fi.name, f, nslots[f], fi.params.size(), body)
    m.set_lenient_arity(func: func)
    if fi.is_gen == true {
      m.set_generator(func: func)
    }
  }
  in_prelude = false
}

# main is funcs[0] and the prelude follows it. The prelude's binding pass is
# the same whatever program is compiled, so it runs once; each program then
# rebuilds main's own entry and drops the functions the last one left.
fn build_prelude(prelude_tree) {
  in_prelude = true
  # prelude helpers are parentless raw closures; each is registered before
  # any body is walked so they can call each other in any order. A top-level
  # binding is a constant of the runtime: it takes a slot of main's that a
  # program's own names cannot reach, and main's prologue initializes it
  # before __init_globals -- so its initializer cannot read __G.
  for s in prelude_tree.nodes {
    cond {
      s.name == 'fn_decl' => {
        let id = s.nodes[0]
        prelude_named[id.token] = new_func(
          nil,
          id.token,
          s.nodes[2].nodes,
          nil,
          false,
        )
      },
      s.name == 'var_decl' => {
        mut i = 1
        while i < s.nodes.size() {
          let d = s.nodes[i]
          if d.nodes[0].name != 'ident' || d.nodes.size() < 2 {
            fail(d, 'a prelude binding is a plain name with an initializer')
          }
          # \x01 keeps the runtime's own names out of the program's globals
          let key = "\x01{d.nodes[0].token}"
          prelude_bound[d.nodes[0].token] = key
          prelude_inits.push({key: key, init: d.nodes[1]})
          i = i + 1
        }
      },
      _ => fail(
        s,
        'the prelude holds function declarations and constant bindings only',
      ),
    }
  }
  for s in prelude_tree.nodes {
    if s.name == 'fn_decl' {
      let g = prelude_named[s.nodes[0].token]
      walk_fn(g, s.nodes[1].nodes, nil)
    }
  }
  for b in prelude_inits {
    scan_expr(b.init, 0)
  }
  in_prelude = false
  prelude_end = funcs.size()
  prelude_nslots = []
  for f in range(prelude_end) {
    prelude_nslots.push(nslots[f])
  }
}

fn reset_main(stmts) {
  in_prelude = false
  frames.truncate(prelude_end)
  scopes.truncate(prelude_end)
  while funcs.size() > prelude_end {
    funcs.pop()
    nslots.pop()
    loop_ctx.pop()
    pending_labels.pop()
  }
  # emit hands itself scratch slots as it walks, so the prelude's slot counts
  # go back to what its binding pass left
  for f in range(prelude_end) {
    nslots[f] = prelude_nslots[f]
  }
  funcs[0] = {
    parent: nil,
    name: 'main',
    params: [],
    dflts: [],
    stmts: stmts,
    body_expr: nil,
    is_prelude: false,
    is_arrow: false,
    var_names: [],
  }
  frames.reset(0, nil)
  scopes.reset(0)
  loop_ctx[0] = []
  pending_labels[0] = []
  nslots[0] = 0
  enter_scope(0)
  g_slot = declare_var(0, '__G', nil)
  this_slot = declare_var(0, 'this', nil)
}

fn build(m, root) {
  reset_main(root.nodes)
  # main's body: the program's statements, in main's own scope
  for s in root.nodes {
    collect_vars(s, 0)
  }
  scan_stmts(root.nodes, 0)
  leave_scope(0)

  frames.solve()
  emit_funcs(m)
}

let flags = {'--ir': true, '--bc': true, '--ast': true}
let want_ir = Sys.argv.contains('--ir')
let want_bc = Sys.argv.contains('--bc')
let want_ast = Sys.argv.contains('--ast')
mut lib_src = ''
mut cli = []
mut skip = false
for i in range(Sys.argv.size()) {
  let a = Sys.argv[i]
  cond {
    skip => skip = false,
    a == '--lib' => {
      lib_src = lib_src + FS.read(Sys.argv[i + 1]) + "\n"
      skip = true
    },
    flags.has(a) => nil,
    _ => cli.push(a),
  }
}
if cli.empty() {
  println("usage: culebra mini_js.cul [--lib FILE.js] [--ir | --bc] PROGRAM.js...")
  Sys.exit(1)
}

let prelude_tree = PEG.parse(grammar, prelude_src, path: '<prelude>')
# main's shell first: every other function reaches the global table through
# main's cell, so its slots have to exist before the prelude is bound
let main_shell = new_func(nil, 'main', [], nil, false)
enter_scope(main_shell)
g_slot = declare_var(main_shell, '__G', nil)
this_slot = declare_var(main_shell, 'this', nil)
build_prelude(prelude_tree)

mut cur_src = ''
mut had_err = false
for path in cli {
  if cli.size() > 1 {
    println('-----8<----- ' + FS.basename(path))
  }
  prog_gen = prog_gen + 1
  try {
    cur_src = lib_src + FS.read(path)
    let tree = PEG.parse(grammar, cur_src, path: path)
    if want_ast {
      inspect(tree)
      continue
    }
    let m = CodeGen.Module.new()
    ir = front.Emitter.new(m, frames)
    build(m, tree)
    ir.finish(want_ir, want_bc)
  } catch e {
    match e {
      {kind: 'MiniError'} => {
        IO.eprintln("{path}:{e.line}:{e.col}: SyntaxError: {e.message}")
        had_err = true
      },
      {kind: 'PEGError'} => {
        IO.eprintln(e.message)
        had_err = true
      },
      {kind: 'IrError'} => {
        cond {
          e.message.starts_with('uncaught: ') => IO.eprintln(e
            .message
            .slice(10, e.message.size())
            .to_string()),
          _ => IO.eprintln("{path}:{e.line}:{e.col}: {e.message}"),
        }
        had_err = true
      },
      _ => throw e,
    }
  }
}
if had_err {
  Sys.exit(1)
}
