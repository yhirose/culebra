# The rest of the syntax the corpus uses: assignment as an expression and
# the `mut o[k] = v` store, pattern assignment with literals / types /
# rest / nested objects, **rest and keyword-only parameters, **splat at
# the call, generic declarations, format specs, the trait-method operators
# and @derive, typed-parameter error positions, and an assert's label.
fn show(label, f) {
  let r = try { f() } catch e { "!{e.kind}: {e.message}" }
  println("{label}: {inspect(r)}")
}
fn show_at(label, f) {
  let r = try { f() } catch e { "!{e.kind}: {e.message} @{e.line}:{e.col}" }
  println("{label}: {inspect(r)}")
}

# --- assignment is an expression; ??= reads once and stores only on nil ---
mut av = 1
show('assign expr', fn () { let v = (av = 5); [v, av] })
show('compound expr', fn () { let v = (av += 2); [v, av] })
mut o = {z: 1}
show('nilco existing', fn () { let v = (o.z ??= 9); [v, o] })
mut o2 = {}
show('nilco adds', fn () { let v = (o2['k'] ??= 3); [v, o2] })
show('nilco keeps', fn () { let v = (o2['k'] ??= 4); [v, o2] })
mut evaluated = false
fn rhs_side_effect() {
  evaluated = true
  999
}
mut has_val = {z: 1}
show('nilco short-circuits', fn () { [has_val.z ??= rhs_side_effect(), evaluated] })
mut tally = {}
show('tally idiom', fn () {
  for w in ['a', 'b', 'a'] {
    tally[w] ??= 0
    tally[w] += 1
  }
  tally
})
show('mut store', fn () { mut bag = {}; mut bag['a'] = 1; bag['a'] = 2; bag })
show('mut store dot', fn () { mut bag = {}; mut bag.b = 1; bag.b = 2; bag })
show('dot adds a mut key', fn () { let a = {}; a.x = 1; a })

# --- pattern assignment: matched first, written after ---
mut m1 = 0
mut m2 = 0
show('typed ok', fn () { [m1, m2: Long] = [1, 2]; [m1, m2] })
show('typed bad', fn () { [m1, m2: Long] = [1, 's'] })
show('literal', fn () { [m1, 5] = [9, 5]; m1 })
show('literal bad', fn () { [m1, 5] = [9, 6] })
show('object', fn () { [m1, {k: m2}] = [1, {k: 2}]; [m1, m2] })
show('object bad key', fn () { [m1, {k: m2}] = [1, {j: 2}] })
show('rest', fn () { [m1, ...r] = [1, 2, 3]; [m1, r] })
show('rest min', fn () { [m1, m2, ...r] = [1] })
show('tuple source', fn () { [m1, m2] = (7, 8); [m1, m2] })
show('paren target', fn () { (m1, m2) = [3, 4]; [m1, m2] })
show('arity', fn () { [m1, m2] = [1] })
show('shorthand', fn () { {m1, m2} = {m1: 5, m2: 6}; [m1, m2] })
show('nested', fn () { [m1, [m2, 9]] = [1, [2, 3]] })
[fresh_a, ...fresh_t] = (1, 2, 3)
show('binds new names', || [fresh_a, fresh_t])
let frozen = 1
show('immutable target', fn () { [m1, frozen] = [5, 6] })
show('immutable target wrote first', || m1)

# --- **rest, keyword-only, **splat ---
let r1 = fn (a, **opts) { [a, opts] }
show('kwrest', || r1(1, x: 2, y: 3))
show('kwrest none', || r1(1))
show('kwrest extra positional', || r1(1, 2))
show('kwrest display', || "{r1(1, x: 2)[1]}")
show('kwrest keys immutable', fn () { let k = r1(1, a: 1)[1]; k.a = 2 })
let g = fn (x, *, y, z = 10) { x + y + z }
show('kwonly', || [g(1, y: 2), g(1, y: 2, z: 3)])
show('kwonly positional', || g(1, 2))
show('kwonly missing', || g(1))
let f = fn (x, y = 10, z = 100) { x + y + z }
show('splat', || f(1, **{y: 7, z: 8}))
show('splat override', || f(1, **{y: 7}, z: 1))
show('splat later wins', || f(1, **{y: 2}, **{y: 5}))
show('splat non object', || f(1, **5))
show('splat unknown', || f(1, **{q: 1}))
fn named_kw(a, **opts) { [a, opts] }
show('named kwrest', || named_kw(1, k: 2))
show('named splat', || named_kw(**{a: 3, k: 4}))
class K {
  new(a, **opts) {
    self.a = a
    self.o = opts
  }
  m(*, q = 1) { q }
}
show('ctor kwrest', || K(1, z: 2).o)
show('method kwonly', || [K(1).m(), K(1).m(q: 5)])
show('method kwonly positional', || K(1).m(2))
let byname = fn (a, b) { [a, b] }
show('closure kwargs by name', || byname(b: 1, a: 2))
show('closure unknown kw', || byname(1, 2, c: 3))
let vari = fn (a, *xs) { [a, xs] }
show('closure rest', || [vari(1), vari(1, 2, 3)])
show('closure rest kw', || vari(a: 1))
show('rest thunk', || {a: 1}.get_or_put('y', fn (*rest) { rest.size() }))
show('thunk needs arg', || {a: 1}.get_or_put('z', |k| k))

# --- generics are documentation ---
class Cell<T> {
  new(v: T) {
    self.v = v
  }
  new(a: T, b: T) {
    self.v = a + b
  }
}
show('generic one', || Cell(7).v)
show('generic two', || Cell(1, 2).v)
show('generic class name', || Cell(7).class)
fn ident<T>(x: T) -> T { x }
show('generic fn', || ident('s'))

# --- format specs ---
let big = 3000000000
let pi = 3.14159
show('fmt', || ["{big:d}", "{big:x}", "{255:X}", "{255:#x}", "{5:b}", "{8:o}"])
show('fmt float', || ["{pi:.2f}", "{5:.2f}", "{42:05}", "{42:+}", "{1234.5:e}", "{1234.5:g}"])
show('fmt align', || ["{'ab':>10}|", "{'ab':<5}|", "{'ab':^6}|", "{42:6}|", "{'x':4}|", "{7:*>4}"])
show('fmt nested', fn () { let w = 6; "{'a':>{w}}|" })
show('fmt bad', || "{'s':d}")
show('fmt float as d', || "{1.5:d}")
show('fmt bool', || "{true:>6}|")

# --- operators through trait methods and @derive ---
@derive(Eq, Hash, Comparable)
class Point {
  new(x, y) {
    self.x = x
    self.y = y
  }
}
let pa = Point.new(1, 2)
let pb = Point.new(1, 2)
let pc = Point.new(1, 3)
show('derive eq', || [pa == pb, pa == pc, pa != pc])
show('derive cmp', || [pa < pc, pc < pa, pa <= pb, pa >= pb, pc > pa, Point.new(0, 9) < pa])
show('derive hash set', || {pa, pb, pc}.size())
show('derive key', fn () { mut bag = {}; mut bag[pa] = 'hit'; bag[pb] })
show('derive cmp other', || pa < 5)
class Mod3 {
  new(n) { self.n = n }
  eq(other) { self.n % 3 == other.n % 3 }
}
show('eq method', || [Mod3(1) == Mod3(4), Mod3(1) == Mod3(2), Mod3(1) != Mod3(2)])
class Rev {
  new(n) { self.n = n }
  cmp(other) { other.n - self.n }
}
show('cmp method', || [Rev(1) < Rev(2), Rev(2) < Rev(1), Rev(1) >= Rev(2)])
class Plain {
  new(n) { self.n = n }
}
show_at('plain lt', || Plain(1) < Plain(2))
@derive(Hash)
class OnlyHash {
  new(x) { self.x = x }
}
show('only hash set', || {OnlyHash(1), OnlyHash(1)}.size())
class WithHash {
  new(x) { self.x = x }
  hash() { self.x }
  eq(o) { self.x == o.x }
}
show('hash+eq methods set', || {WithHash(1), WithHash(1)}.size())
show('fresh bound wrapper', fn () { let obj = {m: fn () { self }}; obj.m == obj.m })

# --- typed-parameter errors point at the argument ---
let t1 = fn (n: Long) { n }
show_at('direct', || t1('x'))
let t2 = fn (a: Long, b: Long) { a }
show_at('second positional', || t2(1, 'x'))
show_at('keyword', || t2(1, b: 'x'))
let t3 = fn (a: Long, b: Long = 'x') { a }
show_at('bad default', || t3(1))
let o1 = {m: fn (n: Long) { n }}
show_at('property method', || o1.m('x'))
show_at('ufcs receiver', || 'x'.t2(1))
show_at('hof callback', || [1, 'x'].for_each(t1))
show_at('string arg', || 'abc'.contains(0))
show_at('sort_by positional', || ([3, 1]).sort_by(1, 2))
show_at('paren callee', || (t1)(n: 'x'))
show_at('property write', fn () { let imm = {x: 1}; imm.x = 2 })
show_at('missing key', fn () { let imm = {x: 1}; imm['nope'] })

# --- an assert takes a label ---
assert_eq(1, 1, 'labeled')
show('assert label', || assert_eq(1, 2, 'labeled'))
show('to_string as thunk', || {a: 1}.get_or_put('z', to_string))
