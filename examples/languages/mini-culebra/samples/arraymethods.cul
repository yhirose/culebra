# array methods
mut m = [3, 1, 2]
println(m.size())
println(m.sorted())
println(m)
m.push(0)
println(m.pop())
println(m.contains(3))
println(m.index_of(1))
println(m.slice(1, 99))
println([1, 2, 3].map(|x| x * x))
println([1, 2, 3, 4].filter(|x| x % 2 == 0))
println([1, 2, 3].reduce(0, |acc, x| acc + x))
println([1, 2].any(|x| x > 1))
println([1, 2].all(|x| x > 1))
println([5, 6].sum())
println(['a', 'b'].join('-'))
m.reverse()
println(m)
println([].empty())
println([9].get(0, nil))
println([9].get(5, 'fb'))
