# sets: literals, membership, algebra, mutation
fn show(label, f) {
  try { println("{label}: {f()}") } catch e { println("{label}: !{e.kind}: {e.message}") }
}
show('disp', || Set(1, 2, 3))
show('type', || type_of(Set(1, 2)))
show('one', || Set(42))
show('mixed', || Set(1, 'two', 3.14, true, nil))
show('dup', || Set(1, 1, 2))
show('num_types', || Set(1, 1.0, true).size())
show('eq', || Set(1, 2, 3) == Set(3, 2, 1))
show('ne', || Set(1, 2) == Set(1, 2, 3))
show('eq_arr', || Set(1, 2) == [1, 2])
show('eq_typed', || Set(1) == Set(1.0))
show('size', || Set(1, 2).size())
show('empty_disp', || [].to_set())
show('empty', || [].to_set().empty())
show('presence', || [].to_set().presence())
show('presence2', || Set(1).presence())
show('contains', || Set(1, 'a').contains('a'))
show('contains_f', || Set(1, 'a').contains(1.0))
show('union', || Set(1, 2).union(Set(2, 3)))
show('intersect', || Set(1, 2, 3).intersect(Set(3, 2, 9)))
show('diff', || Set(1, 2, 3).diff(Set(2)))
show('sym_diff', || Set(1, 2).sym_diff(Set(2, 3)))
show('subset', || Set(1).subset(Set(1, 2)))
show('subset_f', || Set(1, 5).subset(Set(1, 2)))
show('superset', || Set(1, 2).superset(Set(1)))
show('to_array', || Set(3, 1, 2).to_array())
show('iter', || Set(3, 1).iter().map(|x| x * 2).collect())
fn set_for() {
  mut s = ''
  for x in Set(1, 2) { s = s + "{x}" }
  s
}
show('for', set_for)
fn set_add() {
  mut s = Set(1)
  let r = s.add(2)
  "{r} {s}"
}
show('add', set_add)
fn set_add_dup() {
  mut s = Set(1)
  s.add(1)
}
show('add_dup', set_add_dup)
fn set_remove() {
  mut s = Set(1, 2)
  let r = s.remove(1)
  "{r} {s}"
}
show('remove', set_remove)
fn set_remove_no() {
  mut s = Set(1)
  s.remove(9)
}
show('remove_no', set_remove_no)
fn set_add_let() {
  let s = Set(1)
  s.add(2)
  s
}
show('add_let', set_add_let)
show('unhash', || Set([1], 2))
show('tuple_members', || Set((1, 2), (1, 2), (2, 1)))
show('nested', || Set(Set(1, 2), Set(1, 2)))
show('union_bad', || Set(1).union([2]))
show('in_arr', || [Set(1, 2), 'x'])
show('index', || Set(1, 2)[0])
let s1 = Set(1)
show('truthy', || if s1 { 'y' } else { 'n' })
show('plus', || Set(1) + Set(2))
show('map_missing', || Set(3, 1).map(|x| x))
show('collect', || Set(3, 1).iter().to_set())
show('of_strs', || ['b', 'a', 'b'].to_set())
show('in_obj', || {s: Set(1, 2)})
show('arity', || Set(1).union())
