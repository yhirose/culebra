# mini-culebra: culebra's sequential core, compiled to CodeGen (cpp-vmlib's
# Core-IR) and run on its bytecode executor.
#
# Every samples/*.cul runs unchanged under the real `culebra` binary, which
# is what makes the oracle work: tests/mini_culebra_test.sh diffs this
# compiler's stdout against the real implementation's for every sample.
# Where PL/0 (examples/pl0/) proved the backend carries a static language,
# this proves it carries a dynamic one.
#
# What's in: all scalars (Long incl. hex/binary literals, Float, String
# with '...' raw / "..." interpolated forms, Bool, Nil), the full scalar
# operator set at culebra's own precedence (|| && chained-comparisons
# | ^ & << >> + - * / % unary - ! ~ and right-associative **), block
# scoping with shadowing, if/else (as statement and expression), while,
# return/break/continue, try/catch/throw (and `e.kind`-style property
# reads on caught error objects), defer, named `fn` declarations (mutually
# recursive), first-class closures, println/print -- and, since the
# container batch: Array/Object/Tuple literals with culebra's index rules
# (negative reads wrap, writes don't; a literal object key is immutable,
# a bracket-added one is `mut`; a missing bracket key is KeyError where a
# missing property is nil), destructuring `let`, compound assignment,
# `|x|` lambdas, `for` over arrays / strings (by code point) / objects
# (as (key, value) tuples) / tuples / anything with the iter() protocol
# -- each iteration its own binding, the way closures observe it -- and
# the first slice of the SS18 built-in methods plus inspect / type_of /
# to_string / to_long / range / iota / assert_eq / assert_true /
# assert_false, written in the prelude itself. The match batch adds:
# match (literal / binding / object / array / tuple / nil patterns, with
# guards) and cond as expressions, the ternary and ??, parameter defaults
# (evaluated in the callee, so they can name earlier params), keyword
# arguments, *rest, multimethods dispatched on scalar type annotations
# (DispatchError when nothing matches), UFCS for names outside the
# built-in method set, decorators, named functions as values, and
# let-closures that see their own binding -- the cell->closure->cell
# cycle they can build now falls to cpp-vmlib's tracing backstop. The
# class batch adds: class declarations (constructor via Name(...) or
# Name.new(...); fields all-mutable; instances are ordinary objects whose
# 'class' key holds the class object, exactly culebra's own shape),
# methods with self, structural traits (required signatures + default
# methods, conformance checked by name and arity at class build), typed
# dispatch on class and trait annotations, the operator dunders
# (__add__/__sub__/__mul__/__neg__/__lt__/__eq__/__index__/__str__),
# @derive accepted as a no-op (the default == is already structural), and
# deterministic drop() -- carried to the VM's drop contract, which calls
# a hidden-key closure the moment an instance's refcount reaches zero.
# The generator batch adds: `yield` / `yield from` in named fns, the
# iter/has_next/next/dispose protocol object, and for-in / yield-from
# disposing their iterator on every exit path. The iterator batch adds:
# the lazy iterator method set (map .. enumerate, collect .. unzip) over
# every source that has has_next/next, Sets and non-String Object keys
# (one hashable-key spelling under both), `self` inside closure literals
# (bound by a method call or a dot read, falling back to the enclosing
# method's receiver), culebra's arity rule for closures (extras dropped,
# a missing argument named), the `{mut k: v}` literal form, `(x,)`, `;`,
# and the remaining SS18 String / Array methods.
#
# The call-shape batch adds: keyword arguments to constructors, methods,
# callable instances, and values called through a variable; overloaded
# methods and constructors (a class stores each name as a family record
# that binds the call at run time: a lone overload strictly, with
# culebra's TypeError / ArityError naming the parameter, a family by the
# first fit or DispatchError); the operator dunders overloaded on the
# operand type, with + * == reflected onto a right-hand instance;
# __setindex__; @value classes (closed field set, frozen after new,
# derived equality and hash); @derive(Show)'s to_s; the synthesized
# parameters(); hash(); the sized-array form [items](n, fill); decorators
# on classes; a multimethod family carried as a value; and a receiver's
# own method taking precedence over a UFCS call of the same name.
# The scope batch adds: a redeclaration in the same statement list
# rebinding the same binding, a closure inside a let's own initializer
# naming that binding, a bare assignment inside a closure reaching a mut
# declared later, an enclosing function's later declaration outranking
# anything further out, culebra's static shadow rule (a name any
# enclosing function binds, the top level and for variables excepted),
# NameError for a binding read before its declaration ran, declared
# return types (unions and ?), __ARGS__, built-in arity as a runtime
# ArityError, ranges as the plain {class, start, end, inclusive, step}
# objects culebra builds (recognized by shape, so a hand-built one is a
# range too), grid(), UFCS through closure variables and built-ins, and
# the ZWJ / combining-mark rules of graphemes().
# The syntax tail adds: assignment as an expression (with ??= reading
# once and storing only on nil, and a missing key reading as nil), the
# `mut o[k] = v` store, pattern assignment (`[a, b: Long, ...rest] = v`,
# literals, nested objects; matched first, written after, new names bound
# like bare bindings), **rest and keyword-only parameters, the ** splat,
# every closure with parameters carrying its parameter list so a call
# through a value binds by name and type (and a *rest / __ARGS__ closure
# still packs its overflow), generic declarations (type parameters are
# Any), format specs after the std::format mini-language, the trait
# operators (eq / cmp behind == and the orderings, @derive(Eq, Hash,
# Comparable) with hashing by fields), errors reported where culebra
# reports them (an operator at its left operand, a subscript or property
# at the receiver, a typed parameter at its argument, a bad default at the
# call), a dot store adding a key as a mutable one, and an assert's
# optional label.
# The drop-timing batch (with cpp-vmlib's owned stack, release lists and
# entry-frame option) adds: a literal's drop key as a resource, the
# protocol contract on drop / iter / has_next / next where they are
# bound, release in reverse declaration order on every exit with captured
# bindings in their own turn, the for-in order (body locals, element,
# dispose, iterator, iterable; a throwing dispose swallowed while an
# error is already unwinding), cycles of resources dropped at the scope
# exit that owns them (every block and function body is a scope), a
# program's top-level bindings kept to the end without drop, GC.stat (a
# full collection, then {live_objects, rc_objects, heap_bytes}; the
# namespace has no other member), the callback arity check of the
# higher-order methods (fnarity), a fn declared inside a block, a tuple
# sliced by a range, and property reads on Strings, Arrays and Functions
# answering nil.
#
# Known differences from culebra, all documented rather than hidden:
# no StringView type (slice/view give a String); normalize() is the
# identity and graphemes() walks code points (no Unicode database);
# upper/lower/title cover ASCII, Latin-1, Greek, and Cyrillic; is_alpha
# knows the major letter blocks; a generator displays as its protocol
# object; a callback's parameter count is not checked; keyword arguments
# to built-in methods, and to a plain closure called through a variable,
# pass positionally; a class object displays all of its descriptor; a
# user-defined hash() does not make an instance a Set member or key; the
# arguments of a call with keywords are evaluated positionals first; a
# return-type TypeError points at the function, not the call; a named fn
# can be called before its declaration statement ran (culebra raises
# NameError); a built-in method name read as a property is nil rather
# than the "cannot be used as a value" error; the rc_objects of GC.stat
# equals live_objects (the VM counts every heap object one way).
#
# Semantics are culebra's, not the VM's: a prelude of helper functions
# (written in this same subset, compiled alongside the program) wraps every
# operator whose culebra behavior differs from the raw Core-IR node --
# truthiness that rejects non-numeric operands, `==` that answers false
# across types instead of failing, ZeroDivisionError/TypeError objects with
# culebra's kind/message/line/col shape, wrapping MIN/-1 division, float %
# via fmod, int ** with wrapping multiply, whole doubles displayed as
# "4.0" -- so both output and a caught error look the way culebra's do.
# Inside the prelude itself operators compile to raw VM nodes (the prelude
# is type-correct by construction; wrapping its own operators in itself
# would recurse forever).
#
# What's out (deliberately): isolates, string subscripts, and fn/class
# declarations below a function's top level.
#
# The syntax batch adds: statement modifiers (`stmt if c` / `unless`),
# `//` and `/* */` comments, `let mut`, typed `let`, `for k, v in`,
# `**=` / `??=`, spread in array and object literals, object shorthand,
# `fn` as the running function, the class members `static NAME = v`,
# `static m()`, `get m()`, and declared fields (typed ones start at the
# type's zero), bare `x = v` bindings, names a nested function resolves
# to a later declaration in an enclosing scope, `a..b` / `a..=b` ranges
# (with `by`, and open-ended for slicing), `?.`, `0o` literals, tuple
# parameters, rest / typed patterns, `(a, b) = ...` parallel assignment,
# and culebra's own one-line report for an uncaught error. The grammar
# is newline-aware the way culebra's is: a line that begins with `(`,
# `[`, or an operator starts a new statement, while a line that ends
# with an operator, a comma, or an opening bracket continues.
#
# Run it:  culebra examples/mini-culebra/mini_culebra.cul prog.cul
#          culebra examples/mini-culebra/mini_culebra.cul --ir prog.cul
#          culebra examples/mini-culebra/mini_culebra.cul --bc prog.cul

import front from '../front.cul'

let grammar = `
  program    <- nl (stmt nl)*                               { no_ast_opt }
  stmt       <- mod_stmt / core_stmt
  mod_stmt   <- core_stmt mod_kw expr                        { no_ast_opt }
  mod_kw     <- < 'if' / 'unless' > kw_end
  core_stmt  <- class_d / trait_d / fn_decl / decl / pdecl / mut_store / while /
                for / if / try / match / cond_e / return_s / break_s /
                continue_s / throw_s / defer_s / yield_f / yield_v / bare_block /
                passign / assign / expr
  mut_store  <- 'mut' __ postfix assign_op nl expr                { no_ast_opt }
  passign    <- tpat assign_op nl expr                            { no_ast_opt }
  tpat       <- arr_t / tup_t / obj_t
  arr_t      <- '[' nl (telem (nl ',' nl telem)* (nl ',')?)? nl ']' _ { no_ast_opt }
  tup_t      <- '(' nl telem (nl ',' nl telem)+ (nl ',')? nl ')' _ { no_ast_opt }
  obj_t      <- '{' nl tentry (nl ',' nl tentry)* (nl ',')? nl '}' _ { no_ast_opt }
  tentry     <- pname ':' nl telem / ident                        { no_ast_opt }
  telem      <- rest_pt / typed_t / arr_t / tup_t / obj_t / expr
  typed_t    <- ident ':' _ tyexpr                                { no_ast_opt }
  class_d    <- deco* 'class' __ ident tparams? '{' nl (cmember nl)* '}' _
  tparams    <- '<' nl tparam (nl ',' nl tparam)* nl '>' _  { no_ast_opt }
  tparam     <- ident (':' _ ident ('+' _ ident)*)?         { no_ast_opt }
  cmember    <- static_f / static_m / getter / method / field
  static_f   <- 'static' __ ident '=' !'=' nl expr           { no_ast_opt }
  static_m   <- 'static' __ method                          { no_ast_opt }
  getter     <- 'get' __ method                             { no_ast_opt }
  method     <- ident '(' nl fparams nl ')' _ ret_ann? nl block { no_ast_opt }
  field      <- ident ftype? finit?                          { no_ast_opt }
  ftype      <- ':' _ tyexpr                                { no_ast_opt }
  finit      <- '=' !'=' nl expr                            { no_ast_opt }
  trait_d    <- 'trait' __ ident tparams? '{' nl (titem nl)* '}' _
  titem      <- ident '(' nl fparams nl ')' _ ret_ann? (nl block)? { no_ast_opt }
  ret_ann    <- '->' _ tyexpr                               { no_ast_opt }
  tyexpr     <- tyatom tyor* tyopt?
  tyor       <- '|' _ tyatom                                { no_ast_opt }
  tyopt      <- < '?' > _                                   { no_ast_opt }
  tyatom     <- fn_ty / gen_ty / ident
  gen_ty     <- ident '<' nl targ (nl ',' nl targ)* nl '>' _ { no_ast_opt }
  targ       <- tyexpr / number
  fn_ty      <- 'fn' _ '(' nl (tyexpr (nl ',' nl tyexpr)*)? nl ')' _ ('->' _ tyexpr)? { no_ast_opt }

  fn_decl    <- deco* 'fn' __ ident tparams? '(' nl fparams nl ')' _ ret_ann? nl block
  deco       <- '@' ident ('(' nl args nl ')' _)? nl        { no_ast_opt }
  fparams    <- (fparam (nl ',' nl fparam)*)?               { no_ast_opt }
  fparam     <- kwrest_p / rest_p / kwonly_p / tydef_p / typed_p / def_p / dparam / ident
  kwrest_p   <- '**' _ ident                                { no_ast_opt }
  rest_p     <- '*' ident                                   { no_ast_opt }
  kwonly_p   <- '*' !'*' _                                  { no_ast_opt }
  tydef_p    <- ident ':' _ tyexpr '=' !'=' nl expr         { no_ast_opt }
  typed_p    <- ident ':' _ tyexpr                          { no_ast_opt }
  dparam     <- tup_pat                                     { no_ast_opt }
  def_p      <- ident '=' !'=' nl expr                      { no_ast_opt }
  params     <- (lparam (nl ',' nl lparam)*)?               { no_ast_opt }
  lparam     <- dparam / ident
  decl       <- decl_kw decl_pat '=' !'=' nl expr
  pdecl      <- decl_kw pattern '=' !'=' nl expr             { no_ast_opt }
  decl_pat   <- typed_pat / tup_pat / arr_pat / ident
  typed_pat  <- ident ':' _ tyexpr                          { no_ast_opt }
  tup_pat    <- '(' nl ident (nl ',' nl ident)+ nl ')' _    { no_ast_opt }
  bare_tup   <- ident (',' _ ident)+                        { no_ast_opt }
  arr_pat    <- '[' nl ident (nl ',' nl ident)* nl ']' _    { no_ast_opt }
  decl_kw    <- < 'let' __ 'mut' ![a-zA-Z0-9_] / 'let' / 'mut' > __
  while      <- 'while' __ expr nl block
  for        <- 'for' __ for_pat 'in' __ expr nl block
  for_pat    <- tup_pat / arr_pat / bare_tup / ident
  if         <- 'if' __ expr nl block (nl 'else' __ (if / block))?
  try        <- 'try' _ nl block nl 'catch' __ ident nl block
  return_s   <- 'return' kw_end (!stmt_kw expr)?            { no_ast_opt }
  break_s    <- 'break' kw_end                              { no_ast_opt }
  continue_s <- 'continue' kw_end                           { no_ast_opt }
  throw_s    <- 'throw' __ expr                             { no_ast_opt }
  defer_s    <- 'defer' _ nl block                          { no_ast_opt }
  yield_f    <- 'yield' kw_end 'from' kw_end expr           { no_ast_opt }
  yield_v    <- 'yield' kw_end expr                         { no_ast_opt }
  bare_block <- block                                       { no_ast_opt }
  assign     <- postfix assign_op nl expr
  assign_op  <- < '**=' / '??=' / '+=' / '-=' / '*=' / '/=' / '%=' / '=' !'=' >
  block      <- '{' nl (stmt nl)* '}' _                     { no_ast_opt }
  stmt_kw    <- ('let' / 'mut' / 'while' / 'return' / 'break' / 'continue' /
                 'throw' / 'defer') ![a-zA-Z0-9_]

  expr       <- assign_e / ternary
  assign_e   <- postfix assign_op nl expr                         { no_ast_opt }
  ternary    <- nilco (nl '?' !'?' nl expr nl ':' nl expr)?
  rangee     <- range_lit / add
  range_lit  <- add range_op add? step? / range_op add? step? { no_ast_opt }
  step       <- 'by' __ add                                 { no_ast_opt }
  range_op   <- < '..=' / '..' > _
  nilco      <- lor (nilco_op lor)*
  nilco_op   <- < '??' > nl
  match      <- 'match' __ expr nl '{' nl arm (nl ',' nl arm)* (nl ',')? nl '}' _
  arm        <- pattern guard? '=>' nl arm_body             { no_ast_opt }
  guard      <- 'if' __ expr                                { no_ast_opt }
  arm_body   <- expr / block
  cond_e     <- 'cond' _ '{' nl carm (nl ',' nl carm)* (nl ',')? nl '}' _
  carm       <- (wild_p / expr) '=>' nl arm_body            { no_ast_opt }
  pattern    <- nil_p / true_p / false_p / float_p / num_p / str_p /
                obj_p / arr_p / tup_p / wild_p / typed_pt / bind_p
  typed_pt   <- ident ':' _ ident                           { no_ast_opt }
  rest_pt    <- '...' ident                                 { no_ast_opt }
  apat       <- rest_pt / pattern
  nil_p      <- 'nil' kw_end                                { no_ast_opt }
  true_p     <- 'true' kw_end                               { no_ast_opt }
  false_p    <- 'false' kw_end                              { no_ast_opt }
  float_p    <- float                                       { no_ast_opt }
  num_p      <- number                                      { no_ast_opt }
  str_p      <- str_sq                                      { no_ast_opt }
  obj_p      <- '{' nl (opat (nl ',' nl opat)*)? nl '}' _   { no_ast_opt }
  opat       <- pname (':' nl pattern)?                     { no_ast_opt }
  arr_p      <- '[' nl (apat (nl ',' nl apat)*)? nl ']' _   { no_ast_opt }
  tup_p      <- '(' nl pattern (nl ',' nl pattern)+ nl ')' _ { no_ast_opt }
  wild_p     <- '_' ![a-zA-Z0-9_] _                         { no_ast_opt }
  bind_p     <- ident                                       { no_ast_opt }
  lor        <- land (lor_op land)*
  lor_op     <- < '||' > nl
  land       <- cmp (land_op cmp)*
  land_op    <- < '&&' > nl
  cmp        <- bor (cmp_op bor)*
  cmp_op     <- < '==' / '!=' / '<=' / '<' !'<' / '>=' / '>' !'>' > nl
  bor        <- bxor (bor_op bxor)*
  bor_op     <- < '|' > ![|=] nl
  bxor       <- band (bxor_op band)*
  bxor_op    <- < '^' > nl
  band       <- shift (band_op shift)*
  band_op    <- < '&' > ![&=] nl
  shift      <- rangee (shift_op rangee)*
  shift_op   <- < '<<' / '>>' > nl
  add        <- mul (add_op mul)*
  add_op     <- < [+-] > ![=] nl
  mul        <- unary (mul_op unary)*
  mul_op     <- < [*/%] > !'*' ![=] nl
  unary      <- neg / lnot / bnot / power
  neg        <- '-' _ unary                                 { no_ast_opt }
  lnot       <- '!' !'=' _ unary                            { no_ast_opt }
  bnot       <- '~' _ unary                                 { no_ast_opt }
  power      <- postfix (pow_op unary)?
  pow_op     <- < '**' > nl
  postfix    <- primary (nmcall / nprop / mcall / pcall / prop / subscript)*
  nmcall     <- nl '?.' pname '(' nl args nl ')' _          { no_ast_opt }
  nprop      <- nl '?.' pname                               { no_ast_opt }
  pcall      <- '(' nl args nl ')' _                        { no_ast_opt }
  mcall      <- nl '.' pname '(' nl args nl ')' _           { no_ast_opt }
  prop       <- nl '.' pname                                { no_ast_opt }
  subscript  <- '[' nl expr nl ']' _                        { no_ast_opt }
  primary    <- float / number / str_dq / str_sq / true_l / false_l /
                nil_l / closure / lambda / call / if / try / match / cond_e /
                ident / array_lit / object_lit / shorthand / set_lit /
                tuple / fnself / paren
  fnself     <- 'fn' kw_end                                 { no_ast_opt }
  array_lit  <- '[' nl (aitem (nl ',' nl aitem)* (nl ',')?)? nl ']' _ { no_ast_opt }
  aitem      <- spread / expr
  spread     <- '...' _ expr                                { no_ast_opt }
  shorthand  <- '{' nl ident (nl ',' nl ident)* (nl ',')? nl '}' _ { no_ast_opt }
  object_lit <- '{' nl (obj_pair (nl ',' nl obj_pair)* (nl ',')?)? nl '}' _ { no_ast_opt }
  obj_pair   <- mut_pair / plain_pair / ospread
  ospread    <- '...' _ expr                                { no_ast_opt }
  mut_pair   <- 'mut' __ okey ':' nl expr                   { no_ast_opt }
  plain_pair <- okey ':' nl expr                            { no_ast_opt }
  okey       <- pname / str_sq / dq_key / nskey
  dq_key     <- '"' < [^"{\\]* > '"' _
  nskey      <- float / number / true_l / false_l / nil_l / tuple
  set_lit    <- '{' nl expr (nl ',' nl expr)+ (nl ',')? nl '}' _ /
                '{' nl expr nl ',' nl '}' _                 { no_ast_opt }
  tuple      <- '(' nl expr (nl ',' nl expr)+ (nl ',')? nl ')' _ /
                '(' nl expr nl ',' nl ')' _                 { no_ast_opt }
  lambda     <- '|' _ params '|' nl expr                    { no_ast_opt }
  paren      <- '(' nl expr nl ')' _
  closure    <- 'fn' _ '(' nl fparams nl ')' _ ret_ann? nl block
  call       <- ident '(' nl args nl ')' _
  args       <- (argx (nl ',' nl argx)* (nl ',')?)?         { no_ast_opt }
  argx       <- kwsplat / kwarg / expr
  kwsplat    <- '**' _ expr                                 { no_ast_opt }
  kwarg      <- ident ':' !':' nl expr                      { no_ast_opt }

  true_l     <- 'true' kw_end                               { no_ast_opt }
  false_l    <- 'false' kw_end                              { no_ast_opt }
  nil_l      <- 'nil' kw_end                                { no_ast_opt }
  str_sq     <- "'" < [^']* > "'" _
  str_dq     <- '"' dq_part* '"' _                          { no_ast_opt }
  dq_part    <- interp / dq_chars
  interp     <- '{' nl expr (nl ':' fspec)? nl '}'          { no_ast_opt }
  fspec      <- (spec_arg / spec_text)+                     { no_ast_opt }
  spec_arg   <- '{' nl expr nl '}'                          { no_ast_opt }
  spec_text  <- < (![{}] .)+ >
  dq_chars   <- < ('\\' . / [^"{\\])+ >

  keyword    <- ('let' / 'mut' / 'fn' / 'if' / 'else' / 'while' / 'for' /
                 'in' / 'try' / 'catch' / 'return' / 'break' / 'continue' /
                 'throw' / 'defer' / 'true' / 'false' / 'nil' / 'match' /
                 'class' / 'trait') ![a-zA-Z0-9_]
  ident      <- !keyword < [a-zA-Z_] [a-zA-Z0-9_]* > _
  pname      <- < [a-zA-Z_] [a-zA-Z0-9_]* > _
  float      <- < [0-9]+ ('.' [0-9]+ ([eE] [+-]? [0-9]+)? /
                          [eE] [+-]? [0-9]+) > _
  number     <- < '0x' [0-9a-fA-F]+ / '0b' [01]+ / '0o' [0-7]+ / [0-9]+ > _
  ~kw_end    <- ![a-zA-Z0-9_] _

  ~_         <- (comment / [ \t])*
  ~__        <- ![a-zA-Z0-9_] _
  ~nl        <- (comment / [ \t\r\n] / ';')*
  comment    <- '#' [^\r\n]* / '//' [^\r\n]* / '/*' (!'*/' .)* '*/'
`

fn fail(node, msg) {
  throw {kind: 'MiniError', message: msg, line: node.line, col: node.column}
}

# The prelude and the user program are separate parse trees whose line/col
# coordinates overlap, so every position-keyed side table gets a unit
# prefix.
fn pkey(node) {
  cond {
    node.key != nil => node.key,
    in_prelude => "p{node.line}:{node.column}",
    _ => "u{node.line}:{node.column}",
  }
}

# --- The prelude --------------------------------------------------------------
#
# culebra's operator semantics, written in the same subset and compiled in
# front of every program. Prelude bodies compile with raw operators (the
# VM's own nodes, no wrapping) and may call the intrinsic builtins
# (__typeof, __tostr, ...) that user code cannot name. `__error` builds a
# culebra-shaped error object; user code reads it back through `.kind` etc.
# Line/col arguments thread the user program's positions into the error
# objects, so a caught error reports where the operator was, not where the
# prelude is.

let prelude_src = `
fn __raise(kind, msg, line, col) {
  throw __error(kind, msg, line, col)
}

fn __type_name(v) {
  let t = __typeof(v)
  if t == 'int' { return 'Long' }
  if t == 'double' { return 'Float' }
  if t == 'string' { return 'String' }
  if t == 'bool' { return 'Bool' }
  if t == 'nil' { return 'Nil' }
  if t == 'function' { return 'Function' }
  if t == 'array' { return 'Array' }
  if __is_set(v) { return 'Set' }
  if __is_tuple(v) { return 'Tuple' }
  if __is_marker(v) { return 'Function' }
  if __is_family(v) { return 'Function' }
  'Object'
}

fn __truthy(v, line, col) {
  let t = __typeof(v)
  if t == 'bool' { return v }
  if t == 'int' { return v != 0 }
  if t == 'double' { return v != 0.0 }
  __raise('TypeError', 'type error: expected Bool, Long, or Float, got ' +
          __type_name(v), line, col)
}

fn __expect_num(v, line, col) {
  let t = __typeof(v)
  if t != 'int' {
    if t != 'double' {
      __raise('TypeError', 'type error: expected Long or Float, got ' +
              __type_name(v), line, col)
    }
  }
  nil
}

fn __num2(a, b, line, col) {
  __expect_num(a, line, col)
  __expect_num(b, line, col)
  nil
}

fn __scalar_eq(a, b) {
  let t = __typeof(a)
  if t == 'function' { return false }
  if t == 'array' { return false }
  if t == 'object' { return false }
  a == b
}

fn __cmp_ok(a, b, line, col) {
  let ta = __typeof(a)
  let tb = __typeof(b)
  if ta == 'string' {
    if tb == 'string' { return nil }
  }
  if ta == 'bool' {
    if tb == 'bool' { return nil }
  }
  if __is_num(a) {
    if __is_num(b) { return nil }
  }
  __raise('TypeError', 'type error: cannot compare ' + __type_name(a) +
          ' and ' + __type_name(b), line, col)
}

fn __cmpv(v) {
  if __typeof(v) == 'bool' {
    if v { return 1 }
    return 0
  }
  v
}

fn __lt(a, b, line, col) {
  if __inst_dunder(a, '__lt__') {
    return __truthy(__dunder2(a, '__lt__', b, line, col), line, col)
  }
  let o = __order(a, b, line, col)
  if __typeof(o) == 'nil' { return false }
  o < 0
}
fn __le(a, b, line, col) {
  let o = __order(a, b, line, col)
  if __typeof(o) == 'nil' { return false }
  o <= 0
}
fn __gt(a, b, line, col) {
  let o = __order(a, b, line, col)
  if __typeof(o) == 'nil' { return false }
  o > 0
}
fn __ge(a, b, line, col) {
  let o = __order(a, b, line, col)
  if __typeof(o) == 'nil' { return false }
  o >= 0
}

fn __add(a, b, line, col) {
  if __inst_dunder(a, '__add__') { return __dunder2(a, '__add__', b, line, col) }
  # commutative reflection: a right-hand instance answers for a plain left
  if __inst_dunder(b, '__add__') { return __dunder2(b, '__add__', a, line, col) }
  let ta = __typeof(a)
  let tb = __typeof(b)
  if ta == 'string' {
    if tb == 'string' { return a + b }
  }
  if ta == 'array' {
    if tb == 'array' { return __concat(a, b) }
  }
  __arith_ok('+', a, b, line, col)
  a + b
}

fn __is_num(v) {
  let t = __typeof(v)
  if t == 'int' { return true }
  t == 'double'
}

fn __arith_ok(op, a, b, line, col) {
  if __is_num(a) {
    if __is_num(b) { return nil }
  }
  __raise('TypeError', "type error: cannot apply '" + op + "' to " +
          __type_name(a) + ' and ' + __type_name(b), line, col)
}

fn __concat(a, b) {
  let out = __copy_arr(a)
  mut j = 0
  while j < __len(b) {
    __arraypush(out, b[j])
    j = j + 1
  }
  out
}

fn __sub(a, b, line, col) {
  if __inst_dunder(a, '__sub__') { return __dunder2(a, '__sub__', b, line, col) }
  __arith_ok('-', a, b, line, col)
  a - b
}

fn __mul(a, b, line, col) {
  if __inst_dunder(a, '__mul__') { return __dunder2(a, '__mul__', b, line, col) }
  if __inst_dunder(b, '__mul__') { return __dunder2(b, '__mul__', a, line, col) }
  __arith_ok('*', a, b, line, col)
  a * b
}

fn __zero(b) {
  if __typeof(b) == 'int' { return b == 0 }
  b == 0.0
}

fn __both_int(a, b) {
  if __typeof(a) == 'int' {
    if __typeof(b) == 'int' { return true }
  }
  false
}

fn __div(a, b, line, col) {
  if __inst_dunder(a, '__div__') { return __dunder2(a, '__div__', b, line, col) }
  __arith_ok('/', a, b, line, col)
  if __zero(b) { __raise('ZeroDivisionError', 'divide by 0 error', line, col) }
  if __both_int(a, b) {
    if a == (1 << 63) {
      if b == -1 { return 1 << 63 }
    }
  }
  a / b
}

fn __mod(a, b, line, col) {
  if __inst_dunder(a, '__mod__') { return __dunder2(a, '__mod__', b, line, col) }
  __arith_ok('%', a, b, line, col)
  if __zero(b) { __raise('ZeroDivisionError', 'divide by 0 error', line, col) }
  if __both_int(a, b) {
    if a == (1 << 63) {
      if b == -1 { return 0 }
    }
    return a % b
  }
  __fmod(a, b)
}

fn __ipow(base, exp) {
  mut r = 1
  mut b = base
  mut e = exp
  while e > 0 {
    if (e & 1) == 1 { r = r * b }
    b = b * b
    e = e >> 1
  }
  r
}

fn __pow(a, b, line, col) {
  if __inst_dunder(a, '__pow__') { return __dunder2(a, '__pow__', b, line, col) }
  __arith_ok('**', a, b, line, col)
  if __both_int(a, b) {
    if b >= 0 { return __ipow(a, b) }
    if a == 0 { __raise('ZeroDivisionError', 'divide by 0 error', line, col) }
    return __fpow(__todouble(a), __todouble(b))
  }
  __fpow(__todouble(a), __todouble(b))
}

fn __neg(v, line, col) {
  if __inst_dunder(v, '__neg__') { return __dunder1(v, '__neg__', line, col) }
  __expect_num(v, line, col)
  return -v
}

fn __long2(a, b, line, col) {
  if __typeof(a) != 'int' {
    __raise('TypeError', 'type error: expected Long, got ' +
            __type_name(a), line, col)
  }
  if __typeof(b) != 'int' {
    __raise('TypeError', 'type error: expected Long, got ' +
            __type_name(b), line, col)
  }
  nil
}

fn __band(a, b, line, col) {
  __long2(a, b, line, col)
  a & b
}
fn __bor(a, b, line, col) {
  __long2(a, b, line, col)
  a | b
}
fn __bxor(a, b, line, col) {
  __long2(a, b, line, col)
  a ^ b
}
fn __shl(a, b, line, col) {
  __long2(a, b, line, col)
  a << b
}
fn __shr(a, b, line, col) {
  __long2(a, b, line, col)
  a >> b
}
fn __bnot(v, line, col) {
  if __typeof(v) != 'int' {
    __raise('TypeError', 'type error: expected Long, got ' +
            __type_name(v), line, col)
  }
  ~v
}

fn __display(v) {
  let t = __typeof(v)
  if t == 'string' { return v }
  if t == 'array' { return __repr(v) }
  if t == 'object' { return __repr(v) }
  if t == 'function' { return '[function]' }
  __scalar_display(v)
}

fn __getprop(v, name, line, col) {
  if __typeof(v) != 'object' {
    # a String, Array, or Function has no such property (nil); a scalar
    # cannot be read through at all
    let t = __typeof(v)
    if t == 'string' || t == 'array' || t == 'function' { return nil }
    __raise('TypeError', 'type error: expected Object, Array, or Tensor, got ' +
            __type_name(v), line, col)
  }
  if __is_instance(v) {
    if __objecthas(v, name) { return __bind(v[name], v) }
    let cls = v["\zc"]
    let ms = cls['methods']
    if __objecthas(cls, 'getters') {
      if __objecthas(cls['getters'], name) {
        return __call_self(ms[name], v, [], line, col)
      }
    }
    if __objecthas(ms, name) { return __bind(__mk_selfc(ms[name]), v) }
    return nil
  }
  # a class's new read as a value constructs when called
  if name == 'new' && __is_class(v) { return __class_fn(v, line, col) }
  if !__objecthas(v, name) { __ns_missing(v, name, line, col) }
  __bind(v[name], v)
}

fn __is_class(v) {
  if __typeof(v) != 'object' { return false }
  if !__objecthas(v, "\zk") { return false }
  v["\zk"] == 'class'
}

fn __is_instance(v) {
  if __typeof(v) != 'object' { return false }
  __objecthas(v, "\zc")
}

fn __inst_class_is(v, cname) {
  if !__is_instance(v) { return false }
  v["\zc"]['name'] == cname
}

fn __inst_conf(v, tname) {
  if !__is_instance(v) { return false }
  __objecthas(v["\zc"]['conf'], tname)
}

fn __construct(cls, pos, kws, apos, line, col) {
  if !__is_class(cls) {
    __raise('TypeError', 'type error: expected Function, got ' +
            __type_name(cls), line, col)
  }
  mut inst = {}
  inst['class'] = cls['name']
  inst["\zc"] = cls
  # the constructor is picked before anything runs: a dispatch miss builds
  # nothing, and the declared field initializers run once per success
  let picked = __resolve_call(cls['new'], pos, kws, apos, line, col)
  if __objecthas(cls, 'fields') {
    let fs = cls['fields']
    mut i = 0
    while i < __len(fs) {
      let init = fs[i][1]
      if __typeof(init) == 'nil' { inst[fs[i][0]] = nil } else {
        inst[fs[i][0]] = init()
      }
      i = i + 1
    }
  }
  # the VM's drop contract: a "\zd" prefix cannot be spelled by programs,
  # and the executor calls the stored method with the instance when its
  # refcount hits zero
  if __objecthas(cls['methods'], 'drop') {
    let dm = cls['methods']['drop']
    inst["\zdrop"] = fn (o) { __drop_once(o, dm) }
  }
  __spread_self(picked[0], inst, picked[1], line, col)
  # a @value instance is frozen the moment new() returns
  if __objecthas(cls, 'value') { inst["\zv"] = true }
  inst
}

# --- Calls with a shape: positional values, keywords, argument positions --
#
# A class stores each method (and new) as a family: {"\zf": name, ov: [[closure,
# spec], ...]} ordered most-typed-first, where a spec lists the declared
# parameters as [name, runtime type check, type name, has default, is rest].
# Binding a call shape against a spec is culebra's own rule: a lone overload
# binds strictly (TypeError / ArityError naming the parameter), a family
# takes the first overload that fits and raises DispatchError otherwise.
# kws is nil or [names, values]; apos is nil or the flat [line, col, ...]
# of the positional arguments, for the errors culebra reports at the argument.

fn __is_family(v) {
  if __typeof(v) != 'object' { return false }
  __objecthas(v, "\zf")
}

# the i-th positional's line (k = 0) or column (k = 1), else the call's
fn __apos(apos, i, k, dflt) {
  if __typeof(apos) == 'nil' { return dflt }
  if i * 2 + 1 >= __len(apos) { return dflt }
  apos[i * 2 + k]
}

# What a type annotation means at run time (the compiler spells it).
fn __str_starts_with(s, p) { __str_index_of(s, p, 0) == 0 }

fn __ty_ok(v, tc) {
  if __typeof(tc) == 'nil' { return true }
  if tc == '@tuple' { return __is_tuple(v) }
  if tc == '@fn' { return __is_callable(v) }
  if tc[0] == '@' {
    if __str_starts_with(tc, '@trait:') {
      return __inst_conf(v, __str_slice(tc, 7, __len(tc)))
    }
    return __inst_class_is(v, __str_slice(tc, 5, __len(tc)))
  }
  __typeof(v) == tc
}

fn __index_of_str(xs, s) {
  mut i = 0
  while i < __len(xs) {
    if xs[i] == s { return i }
    i = i + 1
  }
  0 - 1
}

fn __bind_args(spec2, pos, kws, strict, apos, line, col) {
  let spec = spec2[0]
  let cap = spec2[1]
  mut kwn = []
  mut kwv = []
  if __typeof(kws) != 'nil' {
    kwn = kws[0]
    kwv = kws[1]
  }
  # a bare * caps the positional count, checked before anything binds
  if cap >= 0 && __len(pos) > cap {
    if !strict { return nil }
    mut word = ' positional arguments but '
    if cap == 1 { word = ' positional argument but ' }
    __raise('TypeError', 'takes ' + __tostr(cap) + word + __tostr(__len(pos)) + ' given',
            line, col)
  }
  mut args = []
  mut pi = 0
  mut used = 0
  mut kwrest_at = 0 - 1
  mut i = 0
  while i < __len(spec) {
    let rec = spec[i]
    let pname = rec[0]
    let kind = rec[4]
    let ki = __index_of_str(kwn, pname)
    if kind == 'r' {
      # *rest packs whatever positionals remain (marked, so the callee's
      # prologue knows it is already packed)
      mut xs = []
      while pi < __len(pos) {
        __arraypush(xs, pos[pi])
        pi = pi + 1
      }
      __arraypush(args, __mk_rest(xs))
    } else if kind == 'kr' {
      # **rest: the keywords nobody else claims, filled in after the loop
      kwrest_at = __len(args)
      __arraypush(args, nil)
    } else if kind == 'p' && pi < __len(pos) {
      if ki >= 0 {
        if !strict { return nil }
        __raise('TypeError', "got argument '" + pname +
                "' both positionally and as a keyword", line, col)
      }
      let v = pos[pi]
      if !__ty_ok(v, rec[1]) {
        # a positional type is what dispatch selects on; a Function
        # parameter is checked after selection, like the keywords below
        if !strict && rec[1] != '@fn' { return nil }
        __raise('TypeError', "type error: parameter '" + pname + "' expects " + rec[2],
                __apos(apos, pi, 0, line), __apos(apos, pi, 1, col))
      }
      __arraypush(args, v)
      pi = pi + 1
    } else if ki >= 0 {
      let v = kwv[ki]
      if !__ty_ok(v, rec[1]) {
        __raise('TypeError', "type error: parameter '" + pname + "' expects " + rec[2],
                line, col)
      }
      __arraypush(args, v)
      used = used + 1
    } else if rec[3] {
      __arraypush(args, "\zmissing")   # the callee's prologue evaluates the default
    } else {
      if !strict { return nil }
      __raise('ArityError', "missing required argument '" + pname + "'", line, col)
    }
    i = i + 1
  }
  if pi < __len(pos) {
    # surplus positionals: a family member simply does not fit; a lone
    # overload passes them on (its __ARGS__ may want them, else they drop)
    if !strict { return nil }
    while pi < __len(pos) {
      __arraypush(args, pos[pi])
      pi = pi + 1
    }
  }
  if used != __len(kwn) {
    # the keywords no parameter claimed: **rest takes them, else refused
    mut extra_n = []
    mut extra_v = []
    mut k = 0
    while k < __len(kwn) {
      mut known = false
      mut j = 0
      while j < __len(spec) {
        if spec[j][0] == kwn[k] && spec[j][4] != 'kr' { known = true }
        j = j + 1
      }
      if !known {
        __arraypush(extra_n, kwn[k])
        __arraypush(extra_v, kwv[k])
      }
      k = k + 1
    }
    if kwrest_at < 0 && __len(extra_n) > 0 {
      if !strict { return nil }
      __raise('TypeError', "unknown keyword argument '" + extra_n[0] + "'", line, col)
    }
    if kwrest_at >= 0 {
      mut o = {}
      mut e = 0
      while e < __len(extra_n) {
        o[extra_n[e]] = extra_v[e]
        e = e + 1
      }
      args[kwrest_at] = o
    }
  }
  if kwrest_at >= 0 {
    if __typeof(args[kwrest_at]) == 'nil' {
      mut empty = {}
      args[kwrest_at] = empty
    }
  }
  args
}

# --- Format specs: {expr:[[fill]align][sign][#][0][width][.precision][type]}
#
# The std::format mini-language culebra follows, over the types the
# corpus uses: d x X b o for integers (a Float is truncated), f e g for
# floats (a Long is widened), s / none for anything (its display form),
# with fill, alignment, sign, the # prefix, zero padding and width.

fn __spec_arg(v, line, col) {
  if __typeof(v) != 'int' {
    __raise('TypeError', 'type error: expected Long, got ' + __type_name(v), line, col)
  }
  __tostr(v)
}

fn __is_align_ch(c) { c == '<' || c == '>' || c == '^' }
fn __is_digit_ch(c) { c >= '0' && c <= '9' }

fn __format(v, spec, line, col) {
  let n = __len(spec)
  mut i = 0
  mut fill = ' '
  mut align = ''
  if n >= 2 && __is_align_ch(spec[1]) {
    fill = spec[0]
    align = spec[1]
    i = 2
  } else if n >= 1 && __is_align_ch(spec[0]) {
    align = spec[0]
    i = 1
  }
  mut sign = '-'
  if i < n && (spec[i] == '+' || spec[i] == '-' || spec[i] == ' ') {
    sign = spec[i]
    i = i + 1
  }
  mut alt = false
  if i < n && spec[i] == '#' {
    alt = true
    i = i + 1
  }
  mut zero = false
  if i < n && spec[i] == '0' {
    zero = true
    i = i + 1
  }
  mut width = 0
  while i < n && __is_digit_ch(spec[i]) {
    width = width * 10 + __digit(spec[i])
    i = i + 1
  }
  mut prec = 0 - 1
  if i < n && spec[i] == '.' {
    i = i + 1
    prec = 0
    while i < n && __is_digit_ch(spec[i]) {
      prec = prec * 10 + __digit(spec[i])
      i = i + 1
    }
  }
  mut ty = ''
  if i < n {
    ty = spec[i]
    i = i + 1
  }
  if i < n {
    __raise('ValueError', "invalid format spec '" + spec + "'", line, col)
  }
  let t = __typeof(v)
  let int_ty = ty == 'd' || ty == 'x' || ty == 'X' || ty == 'b' || ty == 'o'
  let flt_ty = ty == 'f' || ty == 'e' || ty == 'g'
  let numeric = t == 'int' || t == 'double'
  if (int_ty || flt_ty) && !numeric {
    __raise('ValueError', "invalid format spec '" + ty + "' for " + __type_name(v), line, col)
  }
  mut body = ''
  mut neg = false
  mut prefix = ''
  if numeric && ty != 's' {
    cond {
      int_ty || (ty == '' && t == 'int') => {
        mut iv = v
        if t == 'double' { iv = __toint(v) }
        if iv < 0 {
          neg = true
          iv = 0 - iv
        }
        let base = cond { ty == 'x' || ty == 'X' => 16, ty == 'b' => 2, ty == 'o' => 8, _ => 10 }
        body = __int_base(iv, base, ty == 'X')
        if alt {
          prefix = cond { ty == 'x' => '0x', ty == 'X' => '0X', ty == 'b' => '0b', ty == 'o' => '0', _ => '' }
        }
      },
      _ => {
        mut x = v
        if t == 'int' { x = __todouble(v) }
        if x < 0.0 {
          neg = true
          x = 0.0 - x
        }
        body = cond {
          ty == 'f' => __fixed(x, cond { prec < 0 => 6, _ => prec }),
          ty == 'e' => __sci(x, cond { prec < 0 => 6, _ => prec }),
          _ => __general(x),
        }
      },
    }
    let sgn = cond { neg => '-', sign == '+' => '+', sign == ' ' => ' ', _ => '' }
    if zero && align == '' {
      # zero padding sits between the sign / prefix and the digits
      body = __pad(body, width - __len(sgn) - __len(prefix), '0', '>')
    }
    body = sgn + prefix + body
    if align == '' { align = '>' }
  } else {
    body = __display(v)
    if align == '' { align = '<' }
  }
  __pad(body, width, fill, align)
}

fn __pad(body, width, fill, align) {
  let room = width - __str_cp_len(body)
  if room <= 0 { return body }
  mut left = 0
  if align == '>' { left = room }
  if align == '^' { left = room / 2 }
  let right = room - left
  mut out = ''
  mut k = 0
  while k < left {
    out = out + fill
    k = k + 1
  }
  out = out + body
  k = 0
  while k < right {
    out = out + fill
    k = k + 1
  }
  out
}

fn __str_cp_len(s) { __len(__cps(s)) }

fn __int_base(iv, base, upper) {
  if iv == 0 { return '0' }
  let digits = cond { upper => '0123456789ABCDEF', _ => '0123456789abcdef' }
  mut out = ''
  mut x = iv
  while x > 0 {
    out = digits[x % base] + out
    x = x / base
  }
  out
}

# x >= 0 to prec decimals, rounded half up on the scaled value
fn __fixed(x, prec) {
  mut scale = 1.0
  mut p = 0
  while p < prec {
    scale = scale * 10.0
    p = p + 1
  }
  let ip = __toint(x)
  mut fr = __toint((x - __todouble(ip)) * scale + 0.5)
  mut whole = ip
  if __todouble(fr) >= scale {
    whole = whole + 1
    fr = 0
  }
  if prec == 0 { return __tostr(whole) }
  mut fs = __tostr(fr)
  fs = __pad(fs, prec, '0', '>')
  __tostr(whole) + '.' + fs
}

fn __sci(x, prec) {
  if x == 0.0 { return __fixed(0.0, prec) + 'e+00' }
  mut m = x
  mut e = 0
  while m >= 10.0 {
    m = m / 10.0
    e = e + 1
  }
  while m < 1.0 {
    m = m * 10.0
    e = e - 1
  }
  mut mant = __fixed(m, prec)
  if __str_starts_with(mant, '10') {
    mant = __fixed(1.0, prec)
    e = e + 1
  }
  mut es = __tostr(cond { e < 0 => 0 - e, _ => e })
  es = __pad(es, 2, '0', '>')
  mant + 'e' + cond { e < 0 => '-', _ => '+' } + es
}

# the shortest form: a whole value shows as an integer
fn __general(x) {
  if x < 1.0e15 {
    let w = __toint(x)
    if __todouble(w) == x { return __tostr(w) }
  }
  __scalar_display(x)
}

# The keywords of a call with a **splat: items are [name, value] for an
# explicit keyword and [nil, object, line, col] for a splat, in source
# order; a later item overrides an earlier one of the same name.
fn __merge_kws(items) {
  mut names = []
  mut values = []
  mut i = 0
  while i < __len(items) {
    let it = items[i]
    if __typeof(it[0]) == 'nil' {
      let o = it[1]
      if __typeof(o) != 'object' || __is_tuple(o) || __is_set(o) {
        __raise('TypeError', '**: splat operand must be Object, got ' + __type_name(o),
                it[2], it[3])
      }
      let ks = __visible_keys(o)
      mut k = 0
      while k < __len(ks) {
        __kw_put(names, values, ks[k], o[ks[k]])
        k = k + 1
      }
    } else {
      __kw_put(names, values, it[0], it[1])
    }
    i = i + 1
  }
  [names, values]
}

fn __kw_put(names, values, name, v) {
  let at = __index_of_str(names, name)
  if at >= 0 {
    values[at] = v
    return nil
  }
  __arraypush(names, name)
  __arraypush(values, v)
  nil
}

# Keyword values fall in behind the positionals for a callee without a
# spec (a plain closure, a built-in method): the positional fallback.
fn __with_kw_values(pos, kws) {
  if __typeof(kws) == 'nil' { return pos }
  __concat(pos, kws[1])
}

# A *rest argument the binder already packed travels under a mark, so a
# callee's prologue can tell it from a positional value landing in the
# rest slot of a plain call.
fn __mk_rest(xs) {
  mut o = {}
  o["\zR"] = xs
  o
}

fn __is_rest(v) {
  if __typeof(v) != 'object' { return false }
  __objecthas(v, "\zR")
}

# What the rest slot holds on entry: a packed mark opens; otherwise, for
# a closure called with n arguments at or past the slot, the slot's value
# and the hidden trailing ones pack into an Array (a named fn's rest is
# already an Array from its dispatch).
fn __rest_fix(v, extra, n, is_closure) {
  if __is_rest(v) { return v["\zR"] }
  if !is_closure { return v }
  __first_n(__concat([v], extra), n)
}

fn __first_n(xs, n) { __slice_arr(xs, 0, n) }

# Apply a method-like callable to (self, args...): a marker opens to its
# closure and receiver, a family binds the shape, a plain closure takes
# the values positionally.
fn __call_self(f, self_v, args, line, col) {
  __call_selfk(f, self_v, args, nil, nil, line, col)
}

fn __call_selfk(f, self_v, pos, kws, apos, line, col) {
  if __is_marker(f) {
    let raw = f["\zb"]
    let sv = __marker_self(f, self_v)
    if __objecthas(f, "\zspec") {
      let spec2 = f["\zspec"]
      let args = __bind_args(spec2, pos, kws, true, apos, line, col)
      return __call_bound(raw, sv, args, spec2, __objecthas(f, "\zns"), line, col)
    }
    return __call_selfk(raw, sv, pos, kws, apos, line, col)
  }
  if __is_family(f) {
    let picked = __resolve_call(f, pos, kws, apos, line, col)
    return __call_bound(picked[0], self_v, picked[1], picked[2], __objecthas(f, 'free'),
                        line, col)
  }
  __spread_self(f, self_v, __with_kw_values(pos, kws), line, col)
}

# Apply a callee to its bound arguments, without a receiver when it takes
# none (ns). A callee whose spec has a typed default can raise a fixable
# error from its prologue, relayed to this call's position.
fn __call_bound(raw, sv, args, spec2, ns, line, col) {
  if spec2[2] {
    if ns { return __run_fixed(fn () { __call_n(raw, args, line, col) }, line, col) }
    return __run_fixed(fn () { __spread_self(raw, sv, args, line, col) }, line, col)
  }
  if ns { return __call_n(raw, args, line, col) }
  __spread_self(raw, sv, args, line, col)
}

# An error a callee's prologue raises about its own parameters (a typed
# default that does not fit) belongs at the call: it carries a mark the
# caller replaces with its position.
fn __raise_fixable(kind, msg) {
  mut e = {kind: kind, message: msg, line: 0, col: 0}
  e["\zfix"] = true
  throw e
}

fn __run_fixed(thunk, line, col) {
  try {
    thunk()
  } catch e {
    if __typeof(e) == 'object' {
      if __objecthas(e, "\zfix") {
        __raise(e['kind'], e['message'], line, col)
      }
    }
    throw e
  }
}

# The overload a family binds this shape to, the bound arguments and the
# overload's spec: [closure, args, spec]. A plain closure binds positionally.
fn __resolve_call(f, pos, kws, apos, line, col) {
  if !__is_family(f) { return [f, __with_kw_values(pos, kws), nil] }
  let ovs = f['ov']
  let strict = __len(ovs) == 1
  mut i = 0
  while i < __len(ovs) {
    let args = __bind_args(ovs[i][1], pos, kws, strict, apos, line, col)
    if __typeof(args) != 'nil' { return [ovs[i][0], args, ovs[i][1]] }
    i = i + 1
  }
  __family_miss(f, ovs, kws, strict, line, col)
}

# No overload fit: a keyword no overload of a multi-definition family
# declares is refused by name (a lone overload already bound strictly),
# else it is a DispatchError.
fn __family_miss(f, ovs, kws, strict, line, col) {
  if !strict && __typeof(kws) != 'nil' {
    let kwn = kws[0]
    mut k = 0
    while k < __len(kwn) {
      mut known = false
      mut j = 0
      while j < __len(ovs) {
        let spec = ovs[j][1][0]
        mut p = 0
        while p < __len(spec) {
          if spec[p][0] == kwn[k] || spec[p][4] == 'kr' { known = true }
          p = p + 1
        }
        j = j + 1
      }
      if !known {
        __raise('TypeError', "unknown keyword argument '" + kwn[k] + "'", line, col)
      }
      k = k + 1
    }
  }
  __raise('DispatchError', "no matching method for \q" + f["\zf"] + "\q", line, col)
}

fn __spread_self(f, s, a, line, col) {
  let n = __len(a)
  if n == 0 { return f(s) }
  if n == 1 { return f(s, a[0]) }
  if n == 2 { return f(s, a[0], a[1]) }
  if n == 3 { return f(s, a[0], a[1], a[2]) }
  if n == 4 { return f(s, a[0], a[1], a[2], a[3]) }
  if n == 5 { return f(s, a[0], a[1], a[2], a[3], a[4]) }
  if n == 6 { return f(s, a[0], a[1], a[2], a[3], a[4], a[5]) }
  if n == 7 { return f(s, a[0], a[1], a[2], a[3], a[4], a[5], a[6]) }
  if n == 8 { return f(s, a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]) }
  __too_many(line, col)
}

# A call through a value with a shape: what f(a, k: v) compiles to when
# f is not a name the compiler can bind itself.
fn __call_nk(v, pos, kws, apos, line, col) {
  if __is_marker(v) || __is_family(v) { return __call_selfk(v, nil, pos, kws, apos, line, col) }
  if __is_class(v) { return __construct(v, pos, kws, apos, line, col) }
  if __inst_dunder(v, '__call__') {
    return __call_selfk(v["\zc"]['methods']['__call__'], v, pos, kws, apos, line, col)
  }
  if __typeof(v) != 'function' {
    __raise('TypeError', 'type error: expected Function, got ' +
            __type_name(v), line, col)
  }
  __call_n(v, __with_kw_values(pos, kws), line, col)
}

# [items](n) / [items](n, fill): the literal grown to n slots, the new
# ones all the one fill value (nil when absent); a longer literal is kept.
fn __array_sized(items, args, line, col) {
  if __len(args) < 1 || __len(args) > 2 {
    __raise('TypeError', 'type error: expected Function, got Array', line, col)
  }
  let n = args[0]
  if __typeof(n) != 'int' {
    __raise('TypeError', 'type error: expected Long, got ' + __type_name(n),
            line, col)
  }
  if n < 0 { __raise('ValueError', 'array size must not be negative', line, col) }
  mut fill = nil
  if __len(args) == 2 { fill = args[1] }
  mut out = __copy_arr(items)
  mut i = __len(out)
  while i < n {
    __arraypush(out, fill)
    i = i + 1
  }
  out
}

# A binding a closure named before its declaration ran: reading it while
# it still holds the unbound mark is culebra's NameError.
fn __fwd_read(v, name, line, col) {
  if __typeof(v) == 'string' {
    if v == "\zunbound" {
      __raise('NameError', "undefined variable '" + name + "'", line, col)
    }
  }
  v
}

# A declared return type: the value must satisfy one of the alternatives
# (nil is one when the annotation ends in ?).
fn __ret_check(v, tcs, opt, text, line, col) {
  if opt && __typeof(v) == 'nil' { return v }
  mut i = 0
  while i < __len(tcs) {
    if __ty_ok(v, tcs[i]) { return v }
    i = i + 1
  }
  __raise('TypeError', 'type error: return value expects ' + text, line, col)
}

# An object that a call site accepts besides a function: a class, or an
# instance whose class defines __call__.
fn __callable_obj(v) {
  if __is_class(v) { return true }
  __inst_dunder(v, '__call__')
}

# What a Function annotation accepts: a function, a bound method, or an
# instance whose class defines __call__ (a class object does not qualify).
fn __is_callable(v) {
  if __is_fn(v) { return true }
  __inst_dunder(v, '__call__')
}

# UFCS through a callable value: the receiver is the first positional,
# reported at the method name (rl:rc).
fn __ufcs_call(fnv, recv, rl, rc, pos, kws, apos, line, col) {
  mut apos2 = [rl, rc]
  if __typeof(apos) != 'nil' { apos2 = __concat(apos2, apos) }
  __call_nk(fnv, __concat([recv], pos), kws, apos2, line, col)
}

# A class object called as a function constructs, at the call's own shape.
fn __class_fn(cls, line, col) {
  fn (a = nil, b = nil, c = nil, d = nil) {
    __construct(cls, __argv4(__argcount(), a, b, c, d), nil, nil, line, col)
  }
}

# The first n of four forwarded arguments
fn __argv4(n, a, b, c, d) {
  if n == 0 { return [] }
  if n == 1 { return [a] }
  if n == 2 { return [a, b] }
  if n == 3 { return [a, b, c] }
  [a, b, c, d]
}

# an instance's visible keys without its class link
fn __inst_fields(v) {
  let ks = __visible_keys(v)
  mut out = []
  mut i = 0
  while i < __len(ks) {
    if ks[i] != 'class' { __arraypush(out, ks[i]) }
    i = i + 1
  }
  out
}

fn __is_frozen_inst(v) { __objecthas(v["\zc"], 'value') }

fn __inst_dunder(v, name) {
  if !__is_instance(v) { return false }
  __objecthas(v["\zc"]['methods'], name)
}

# @derive(Name) on the instance's class
fn __derived(cls, name) {
  if !__objecthas(cls, 'derive') { return false }
  __objecthas(cls['derive'], name)
}

fn __inst_derived(v, name) {
  if !__is_instance(v) { return false }
  __derived(v["\zc"], name)
}

# The trait-method fallbacks of the operators: eq(other) behind == / !=,
# cmp(other) behind the orderings, when no dunder is defined. Derived
# Comparable orders by the fields in declaration order; a derived
# comparison against anything else is simply false.
fn __order(a, b, line, col) {
  if __inst_dunder(a, 'cmp') {
    let r = __call_self(a["\zc"]['methods']['cmp'], a, [b], line, col)
    if __typeof(r) != 'int' {
      __raise('TypeError', 'type error: cannot compare ' + __type_name(a) +
              ' and ' + __type_name(b), line, col)
    }
    return r
  }
  if __inst_derived(a, 'Comparable') {
    if !__is_instance(b) { return nil }
    if a["\zc"]['name'] != b["\zc"]['name'] { return nil }
    let ks = __inst_fields(a)
    mut i = 0
    while i < __len(ks) {
      if __lt(a[ks[i]], b[ks[i]], line, col) { return 0 - 1 }
      if __lt(b[ks[i]], a[ks[i]], line, col) { return 1 }
      i = i + 1
    }
    return 0
  }
  __cmp_ok(a, b, line, col)
  if __cmpv(a) < __cmpv(b) { return 0 - 1 }
  if __cmpv(b) < __cmpv(a) { return 1 }
  0
}

fn __dunder1(v, name, line, col) {
  __call_self(v["\zc"]['methods'][name], v, [], line, col)
}

fn __dunder2(v, name, o, line, col) {
  __call_self(v["\zc"]['methods'][name], v, [o], line, col)
}

# A user call site accepts what a built-in's callback slot does not: a
# class object (culebra constructs through it, but map(Cls) is a TypeError).
fn __callee_check(v, line, col) {
  if __is_class(v) { return __class_fn(v, line, col) }
  __check_fn(v, line, col)
}

fn __mk_tuple(items) {
  mut o = {}
  o["\zt"] = items
  o
}

fn __is_tuple(v) {
  if __typeof(v) != 'object' { return false }
  __objecthas(v, "\zt")
}

fn __titems(t) { t["\zt"] }


# Pattern assignment: match the whole pattern first, collecting the leaf
# values in order; a mismatch anywhere is one ValueError and no target is
# written. Spec nodes: ['v'] leaf, ['lit', x], ['ty', check], ['rest'],
# ['seq', [subs]], ['obj', [[key, sub], ...]].
fn __destr_pat(v, spec, line, col) {
  mut out = []
  if !__match_pat(v, spec, out) {
    __raise('ValueError', 'destructure pattern did not match value', line, col)
  }
  out
}

fn __match_pat(v, spec, out) {
  let kind = spec[0]
  if kind == 'v' {
    __arraypush(out, v)
    return true
  }
  if kind == 'lit' { return __eq(v, spec[1]) }
  if kind == 'ty' {
    if !__ty_ok(v, spec[1]) { return false }
    __arraypush(out, v)
    return true
  }
  if kind == 'seq' {
    mut items = nil
    if __typeof(v) == 'array' { items = v }
    if __is_tuple(v) { items = __titems(v) }
    if __typeof(items) == 'nil' { return false }
    let subs = spec[1]
    mut i = 0
    while i < __len(subs) {
      if subs[i][0] == 'rest' {
        # the tail, however long, as an Array
        __arraypush(out, __slice_arr(items, i, __len(items)))
        return true
      }
      if i >= __len(items) { return false }
      if !__match_pat(items[i], subs[i], out) { return false }
      i = i + 1
    }
    __len(items) == __len(subs)
  } else if kind == 'obj' {
    if __typeof(v) != 'object' { return false }
    if __is_tuple(v) || __is_set(v) { return false }
    let entries = spec[1]
    mut i = 0
    while i < __len(entries) {
      let key = entries[i][0]
      if !__objecthas(v, key) { return false }
      if !__match_pat(v[key], entries[i][1], out) { return false }
      i = i + 1
    }
    true
  } else {
    false
  }
}

fn __destr(v, n, line, col) {
  let t = __typeof(v)
  mut items = []
  mut found = false
  if t == 'array' {
    items = v
    found = true
  }
  if __is_tuple(v) {
    items = __titems(v)
    found = true
  }
  if !found {
    __raise('ValueError', 'destructure pattern did not match value', line, col)
  }
  if __len(items) != n {
    __raise('ValueError', 'destructure pattern did not match value', line, col)
  }
  items
}

fn __type_of(v, line, col) {
  if __is_tuple(v) { return 'Tuple' }
  __type_name(v)
}

fn __eq_list(xs, ys) {
  if __len(xs) != __len(ys) { return false }
  mut i = 0
  while i < __len(xs) {
    if !__truthy(__eq(xs[i], ys[i]), 0, 0) { return false }
    i = i + 1
  }
  true
}

fn __eq_inst_fields(a, b) {
  let ka = __objectkeys(a)
  mut i = 0
  while i < __len(ka) {
    let k = ka[i]
    if k != 'class' {
      if !__objecthas(b, k) { return false }
      if !__truthy(__eq(a[k], b[k]), 0, 0) { return false }
    }
    i = i + 1
  }
  __len(ka) == __len(__objectkeys(b))
}

fn __eq_obj(a, b) {
  let ka = __visible_keys(a)
  mut i = 0
  while i < __len(ka) {
    let k = ka[i]
    if !__objecthas(b, k) { return false }
    if !__truthy(__eq(a[k], b[k]), 0, 0) { return false }
    i = i + 1
  }
  __len(ka) == __obj_visible_size(b)
}

fn __eq(a, b) {
  # an instance's own __eq__ answers for any other operand, on either side
  if __inst_dunder(a, '__eq__') {
    return __truthy(__dunder2(a, '__eq__', b, 0, 0), 0, 0)
  }
  if __inst_dunder(b, '__eq__') {
    return __truthy(__dunder2(b, '__eq__', a, 0, 0), 0, 0)
  }
  # the Eq trait's eq(other) is the next answer
  if __inst_dunder(a, 'eq') {
    if !__is_instance(b) { return false }
    return __truthy(__call_self(a["\zc"]['methods']['eq'], a, [b], 0, 0), 0, 0)
  }
  let ta = __typeof(a)
  let tb = __typeof(b)
  if ta == tb {
    if ta == 'function' { return __same(a, b) }
    if ta == 'array' {
      if __same(a, b) { return true }
      if tb == 'array' { return __eq_list(a, b) }
    }
    if ta == 'object' {
      if __same(a, b) { return true }
      if __is_marker(a) {
        if !__is_marker(b) { return false }
        # every dot read is a fresh bound wrapper: only the same one is equal
        return __same(a, b)
      }
      if __is_marker(b) { return false }
      let at = __is_tuple(a)
      let bt = __is_tuple(b)
      if at {
        if bt { return __eq_list(__titems(a), __titems(b)) }
        return false
      }
      if bt { return false }
      let asx = __is_set(a)
      let bsx = __is_set(b)
      if asx {
        if bsx { return __set_eq(a, b) }
        return false
      }
      if bsx { return false }
      let ai = __is_instance(a)
      let bi = __is_instance(b)
      if ai {
        if !bi { return false }
        if a["\zc"]['name'] != b["\zc"]['name'] { return false }
        if __inst_dunder(a, '__eq__') {
          return __truthy(__dunder2(a, '__eq__', b, 0, 0), 0, 0)
        }
        return __eq_inst_fields(a, b)
      }
      if bi { return false }
      return __eq_obj(a, b)
    }
    return a == b
  }
  if ta == 'int' {
    if tb == 'double' { return a == b }
  }
  if ta == 'double' {
    if tb == 'int' { return a == b }
  }
  false
}

fn __repr(v) {
  let t = __typeof(v)
  if t == 'string' { return "'" + v + "'" }
  if t == 'function' { return '[function]' }
  if t == 'array' {
    mut out = '['
    mut i = 0
    while i < __len(v) {
      if i > 0 { out = out + ', ' }
      out = out + __repr(v[i])
      i = i + 1
    }
    return out + ']'
  }
  if t == 'object' {
    if __is_marker(v) { return '[function]' }
    if __is_family(v) { return '[function]' }
    if __is_tuple(v) {
      let items = __titems(v)
      mut out = '('
      mut i = 0
      while i < __len(items) {
        if i > 0 { out = out + ', ' }
        out = out + __repr(items[i])
        i = i + 1
      }
      if __len(items) == 1 { out = out + ',' }
      return out + ')'
    }
    if __is_instance(v) {
      if __inst_dunder(v, '__str__') {
        return __dunder1(v, '__str__', 0, 0)
      }
      let ks = __objectkeys(v)
      mut out = v["\zc"]['name'] + ' {'
      mut first = true
      mut i = 0
      while i < __len(ks) {
        let k = ks[i]
        if k != 'class' {
          if !__hidden_key(k) {
            if !first { out = out + ', ' }
            first = false
            # a @value instance's fields are frozen, so they show without mut
            if !__is_frozen_inst(v) { out = out + 'mut ' }
            out = out + k + ': ' + __repr(v[k])
          }
        }
        i = i + 1
      }
      return out + '}'
    }
    if __is_set(v) { return __set_repr(v) }
    if __is_range(v) { return __range_repr(v) }
    mut muts = {}
    mut has_muts = false
    if __objecthas(v, "\zm") {
      muts = v["\zm"]
      has_muts = true
    }
    let ks = __objectkeys(v)
    # a plain object whose class key names a String displays like an
    # instance of that name
    mut named = false
    mut out = '{'
    if __objecthas(v, 'class') {
      if __typeof(v['class']) == 'string' {
        named = true
        out = v['class'] + ' {'
      }
    }
    mut first = true
    mut i = 0
    while i < __len(ks) {
      let k = ks[i]
      if !__hidden_key(k) && !(named && k == 'class') {
        if !first { out = out + ', ' }
        first = false
        if has_muts {
          if __objecthas(muts, k) { out = out + 'mut ' }
        }
        out = out + __key_repr(v, k) + ': ' + __repr(v[k])
      }
      i = i + 1
    }
    return out + '}'
  }
  __scalar_display(v)
}

fn __scalar_display(v) {
  if __typeof(v) == 'double' {
    let s = __tostr(v)
    mut i = 0
    mut plain = true
    while i < __len(s) {
      let ch = s[i]
      if ch == '.' { plain = false }
      if ch == 'e' { plain = false }
      if ch == 'n' { plain = false }
      if ch == 'f' { plain = false }
      i = i + 1
    }
    if plain { return s + '.0' }
    return s
  }
  __tostr(v)
}

fn __obj_visible_size(v) {
  let ks = __objectkeys(v)
  mut n = 0
  mut i = 0
  while i < __len(ks) {
    if !__hidden_key(ks[i]) { n = n + 1 }
    i = i + 1
  }
  n
}

fn __setindex(recv, key, val, is_prop, line, col) {
  let t = __typeof(recv)
  if t == 'array' {
    if __typeof(key) != 'int' {
      __raise('TypeError', 'type error: expected Long, got ' +
              __type_name(key), line, col)
    }
    if key < 0 { __raise('IndexError', 'index out of range', line, col) }
    if key >= __len(recv) {
      __raise('IndexError', 'index out of range', line, col)
    }
    recv[key] = val
    return nil
  }
  if t == 'object' {
    if __is_tuple(recv) {
      __raise('TypeError', 'type error: expected Object, Array, or Tensor, got Tuple',
              line, col)
    }
    if __is_set(recv) {
      __raise('TypeError', 'type error: expected Object, Array, or Tensor, got Set',
              line, col)
    }
    let pk = __hkey(key, line, col)
    if __is_instance(recv) {
      if is_prop == 0 {
        if __inst_dunder(recv, '__setindex__') {
          __call_selfk(recv["\zc"]['methods']['__setindex__'], recv, [key, val],
                       nil, nil, line, col)
          return nil
        }
      }
      # instance fields are all mutable, dot and bracket alike -- except on a
      # @value instance, whose field set is closed from the start and whose
      # fields freeze once new() returns
      if __is_frozen_inst(recv) {
        if __objecthas(recv, "\zv") {
          if __objecthas(recv, pk) {
            __raise('ImmutableError', "immutable property '" + pk + "'", line, col)
          }
        }
        if !__objecthas(recv, pk) {
          if __is_nsk(pk) {
            __raise('ImmutableError', 'cannot add an entry to a @value instance',
                    line, col)
          }
          __raise('ImmutableError', "cannot add property '" + pk +
                  "' to a @value instance", line, col)
        }
      }
      recv[pk] = val
      __record_key(recv, pk, key)
      return nil
    }
    # a class object is an object whose declared statics are literal keys:
    # a new property may be added through the dot form too
    if __is_class(recv) { return __obj_put(recv, pk, key, val, 0, line, col) }
    return __obj_put(recv, pk, key, val, is_prop, line, col)
  }
  __raise('TypeError', 'type error: expected Object, Array, or Tensor, got ' +
          __type_name(recv), line, col)
}

# A plain object's store: a literal key is immutable, an added one (dot or
# bracket) is mutable.
fn __obj_put(recv, pk, key, val, is_prop, line, col) {
  if __objecthas(recv, pk) {
    mut ok = false
    if __objecthas(recv, "\zm") {
      if __objecthas(recv["\zm"], pk) { ok = true }
    }
    if !ok {
      if __is_nsk(pk) {
        __raise('ImmutableError', 'immutable entry on non-String key',
                line, col)
      }
      __raise('ImmutableError', "immutable property '" + pk + "'",
              line, col)
    }
    recv[pk] = val
    return nil
  }
  # a key that is not there yet is added as a mutable one, through the
  # dot form as well as the bracket form
  if !__objecthas(recv, "\zm") {
    mut fresh = {}
    recv["\zm"] = fresh
  }
  let muts = recv["\zm"]
  muts[pk] = true
  recv[pk] = val
  __record_key(recv, pk, key)
  if __is_protocol_key(pk) { __bind_contract(recv, pk, val, line, col) }
  nil
}

# A range is recognized structurally, as culebra does: a plain object
# whose class is "Range", start / end Long or nil, inclusive Bool, and
# step absent or Long. A..b builds exactly that shape, and a hand-built
# one is indistinguishable from it.
fn __is_range(v) {
  if __typeof(v) != 'object' { return false }
  if __is_instance(v) || __is_tuple(v) || __is_set(v) { return false }
  if !__objecthas(v, 'class') { return false }
  if __typeof(v['class']) != 'string' { return false }
  if v['class'] != 'Range' { return false }
  if !__objecthas(v, 'start') || !__objecthas(v, 'end') || !__objecthas(v, 'inclusive') {
    return false
  }
  let ts = __typeof(v['start'])
  let te = __typeof(v['end'])
  if ts != 'int' && ts != 'nil' { return false }
  if te != 'int' && te != 'nil' { return false }
  if __typeof(v['inclusive']) != 'bool' { return false }
  if __objecthas(v, 'step') {
    if __typeof(v['step']) != 'int' { return false }
  }
  true
}

fn __range_step(r) {
  if __objecthas(r, 'step') { return r['step'] }
  1
}

# The iterator over a range's integers.
fn __range_iter_of(r) {
  mut a = r['start']
  if __typeof(a) == 'nil' { a = 0 }
  mut hi = r['end']
  mut inclusive = r['inclusive']
  if __typeof(hi) == 'nil' {
    hi = 9223372036854775807
    inclusive = true
  }
  __range_iter3(a, hi, __range_step(r), inclusive)
}

fn __range_repr(r) {
  mut out = ''
  if __typeof(r['start']) != 'nil' { out = out + __tostr(r['start']) }
  out = out + '..'
  if r['inclusive'] { out = out + '=' }
  if __typeof(r['end']) != 'nil' { out = out + __tostr(r['end']) }
  if __range_step(r) != 1 { out = out + ' by ' + __tostr(__range_step(r)) }
  out
}

# Half-open slice bounds for a range key against a length-n sequence.
fn __range_bounds(r, n) {
  mut lo = r['start']
  if __typeof(lo) == 'nil' { lo = 0 }
  mut hi = r['end']
  if __typeof(hi) == 'nil' { hi = n } else {
    # a negative end counts from the back before the inclusive step, and
    # an inclusive end past the length clamps (no overflow at Long max)
    if hi < 0 { hi = hi + n }
    if r['inclusive'] {
      if hi >= n { hi = n } else { hi = hi + 1 }
    }
  }
  if lo < 0 { lo = lo + n }
  if hi < 0 { hi = hi + n }
  if lo < 0 { lo = 0 }
  if hi > n { hi = n }
  if hi < lo { hi = lo }
  [lo, hi]
}

fn __getindex(v, k, line, col) {
  let t = __typeof(v)
  if t == 'array' {
    if __is_range(k) {
      let b = __range_bounds(k, __len(v))
      return __slice_arr(v, b[0], b[1])
    }
    if __typeof(k) != 'int' {
      __raise('TypeError', 'type error: expected Long, got ' +
              __type_name(k), line, col)
    }
    mut i = k
    if i < 0 { i = i + __len(v) }
    if i < 0 { __raise('IndexError', 'index out of range', line, col) }
    if i >= __len(v) { __raise('IndexError', 'index out of range', line, col) }
    return v[i]
  }
  if t == 'object' {
    if __is_tuple(v) {
      # a range slices a tuple into a tuple
      if __is_range(k) {
        let b = __range_bounds(k, __len(__titems(v)))
        return __mk_tuple(__slice_arr(__titems(v), b[0], b[1]))
      }
      if __typeof(k) != 'int' {
        __raise('TypeError', 'type error: expected Long, got ' +
                __type_name(k), line, col)
      }
      let items = __titems(v)
      mut i = k
      if i < 0 { i = i + __len(items) }
      if i < 0 { __raise('IndexError', 'index out of range', line, col) }
      if i >= __len(items) {
        __raise('IndexError', 'index out of range', line, col)
      }
      return items[i]
    }
    if __is_instance(v) {
      if __inst_dunder(v, '__index__') {
        return __dunder2(v, '__index__', k, line, col)
      }
    }
    if __is_set(v) {
      __raise('TypeError', 'type error: expected Array, got Set', line, col)
    }
    let pk = __hkey(k, line, col)
    if !__objecthas(v, pk) {
      __raise('KeyError', 'key not present', line, col)
    }
    return v[pk]
  }
  if t == 'string' {
    if __is_range(k) {
      let b = __range_bounds(k, __len(v))
      return __str_slice(v, b[0], b[1])
    }
  }
  __raise('TypeError', 'type error: expected Object, Array, or Tensor, got ' +
          __type_name(v), line, col)
}

# The read side of ??=: an object key that is not there reads as nil (the
# store then adds it); everything else reads as the plain form does.
fn __nilco_read(recv, key, is_prop, line, col) {
  if __typeof(recv) == 'object' {
    if !__is_tuple(recv) && !__is_set(recv) && !__inst_dunder(recv, '__index__') {
      if !__objecthas(recv, __hkey(key, line, col)) { return nil }
    }
  }
  __getindex_or_prop(recv, key, is_prop, line, col)
}

fn __getindex_or_prop(recv, key, is_prop, line, col) {
  if is_prop == 1 { return __getprop(recv, key, line, col) }
  __getindex(recv, key, line, col)
}

fn __cp_len(c) {
  mut l = 1
  if c >= "\y" { l = 2 }
  if c >= "\x" { l = 3 }
  if c >= "\w" { l = 4 }
  l
}




fn __gen_wrap(raw) {
  mut la = nil
  mut has_la = false
  mut done = false
  mut disposed = false
  mut obj = {}
  fn advance() {
    let r = __genresume(raw, nil)
    let v = r['value']
    cond {
      r['done'] => { done = true },
      __typeof(v) == 'string' && v == "\zgend" => { done = true },
      _ => {
        la = v
        has_la = true
      },
    }
  }
  obj['iter'] = fn () { obj }
  obj['has_next'] = fn () {
    if !has_la {
      if !done { advance() }
    }
    has_la
  }
  obj['next'] = fn () {
    if !has_la {
      if !done { advance() }
    }
    cond {
      has_la => {
        has_la = false
        let v = la
        la = nil
        v
      },
      _ => nil,
    }
  }
  obj['dispose'] = fn () {
    if !disposed {
      disposed = true
      __genreturn(raw, nil)
      nil
    }
  }
  obj
}

# dispose runs at most once per iterator (the loop's quiet close on the
# unwind path and its defer would otherwise both reach it)
fn __iter_close(it) {
  if __typeof(it) == 'object' {
    if __objecthas(it, "\zclosed") { return nil }
    it["\zclosed"] = true
  }
  if __has_proto(it, 'dispose') { __invoke(it, 'dispose', [], 0, 0) }
  nil
}

fn __iter_close_quiet(it) {
  try {
    __iter_close(it)
  } catch e {
    nil
  }
  nil
}

fn __closer(it) {
  fn () { __iter_close(it) }
}



fn __range2(a, b, line, col) {
  let base = __range_iter(a, b)
  {iter: fn () { __range_iter(a, b) },
   has_next: base['has_next'],
   next: base['next']}
}

fn __range1(n, line, col) { __range2(0, n, line, col) }

fn __iota2(a, b, line, col) {
  mut out = []
  mut i = a
  while i < b {
    __arraypush(out, i)
    i = i + 1
  }
  out
}

fn __iota1(n, line, col) { __iota2(0, n, line, col) }

fn __inspect(v, line, col) {
  println(__repr(v))
  nil
}

fn __to_string(v, line, col) { __display(v) }

fn __to_long(v, line, col) {
  let t = __typeof(v)
  if t == 'int' { return v }
  if t == 'double' { return __toint(v) }
  if t == 'string' {
    mut i = 0
    mut sign = 1
    if __len(v) > 0 {
      if v[0] == '-' {
        sign = 0 - 1
        i = 1
      }
    }
    if i >= __len(v) { __raise('TypeError', 'type error', line, col) }
    mut out = 0
    while i < __len(v) {
      let c = v[i]
      if c < '0' { __raise('TypeError', 'type error', line, col) }
      if c > '9' { __raise('TypeError', 'type error', line, col) }
      out = out * 10 + __digit(c)
      i = i + 1
    }
    return sign * out
  }
  __raise('TypeError', 'type error', line, col)
}

fn __digit(c) {
  if c == '0' { return 0 }
  if c == '1' { return 1 }
  if c == '2' { return 2 }
  if c == '3' { return 3 }
  if c == '4' { return 4 }
  if c == '5' { return 5 }
  if c == '6' { return 6 }
  if c == '7' { return 7 }
  if c == '8' { return 8 }
  9
}

fn __to_float(v, line, col) {
  let t = __typeof(v)
  if t == 'int' { return __todouble(v) }
  if t == 'double' { return v }
  if t == 'string' { return __parse_float(v, line, col) }
  __raise('TypeError', 'type error', line, col)
}

fn __parse_float(v, line, col) {
  let n = __len(v)
  mut i = 0
  mut sign = 1.0
  if n > 0 {
    if v[0] == '-' {
      sign = 0.0 - 1.0
      i = 1
    }
  }
  mut mant = 0.0
  mut digits = 0
  while i < n && v[i] >= '0' && v[i] <= '9' {
    mant = mant * 10.0 + __todouble(__digit(v[i]))
    digits = digits + 1
    i = i + 1
  }
  if i < n && v[i] == '.' {
    i = i + 1
    mut scale = 0.1
    while i < n && v[i] >= '0' && v[i] <= '9' {
      mant = mant + __todouble(__digit(v[i])) * scale
      scale = scale / 10.0
      digits = digits + 1
      i = i + 1
    }
  }
  if digits == 0 { __raise('TypeError', 'type error', line, col) }
  if i < n && (v[i] == 'e' || v[i] == 'E') {
    i = i + 1
    mut esign = 1
    if i < n && (v[i] == '-' || v[i] == '+') {
      if v[i] == '-' { esign = 0 - 1 }
      i = i + 1
    }
    mut e = 0
    mut ed = 0
    while i < n && v[i] >= '0' && v[i] <= '9' {
      e = e * 10 + __digit(v[i])
      ed = ed + 1
      i = i + 1
    }
    if ed == 0 { __raise('TypeError', 'type error', line, col) }
    mant = mant * __fpow(10.0, __todouble(esign * e))
  }
  if i != n { __raise('TypeError', 'type error', line, col) }
  sign * mant
}

# An assert's optional label follows "failed:" in the message.
fn __lbl(label) {
  if label == '' { return '' }
  ' ' + label
}

fn __assert_eq(a, b, label, line, col) {
  if __truthy(__eq(a, b), line, col) { return nil }
  __raise('AssertionError',
          "assert_eq failed:" + __lbl(label) + "\n  left:  " + __display(a) +
          "\n  right: " + __display(b),
          line, col)
}

fn __assert_true(v, label, line, col) {
  if __truthy(v, line, col) { return nil }
  __raise('AssertionError', "assert_true failed:" + __lbl(label) + "\n  value: " + __display(v),
          line, col)
}

fn __assert_false(v, label, line, col) {
  if __truthy(v, line, col) {
    __raise('AssertionError', "assert_false failed:" + __lbl(label) + "\n  value: " + __display(v),
            line, col)
  }
  nil
}

# Apply f to an argument array. The IR's CallValue is fixed-arity, so the
# spread is a size switch.
fn __call_n(f0, a, line, col) {
  let f = __as_fn(f0, line, col)
  let n = __len(a)
  if n == 0 { return f() }
  if n == 1 { return f(a[0]) }
  if n == 2 { return f(a[0], a[1]) }
  if n == 3 { return f(a[0], a[1], a[2]) }
  if n == 4 { return f(a[0], a[1], a[2], a[3]) }
  if n == 5 { return f(a[0], a[1], a[2], a[3], a[4]) }
  if n == 6 { return f(a[0], a[1], a[2], a[3], a[4], a[5]) }
  if n == 7 { return f(a[0], a[1], a[2], a[3], a[4], a[5], a[6]) }
  if n == 8 { return f(a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]) }
  __too_many(line, col)
}

fn __too_many(line, col) {
  __raise('TypeError', 'type error: too many arguments', line, col)
}

fn __check_fn(v, line, col) {
  if __is_marker(v) { return __as_fn(v, line, col) }
  if __is_family(v) { return __as_fn(v, line, col) }
  if __inst_dunder(v, '__call__') {
    return __bindn(v["\zc"]['methods']['__call__'], v, line, col)
  }
  if __typeof(v) != 'function' {
    __raise('TypeError', 'type error: expected Function, got ' +
            __type_name(v), line, col)
  }
  v
}

fn __str_index_of(s, sub, from) {
  let n = __len(s)
  let m = __len(sub)
  mut i = from
  while i + m <= n {
    mut j = 0
    mut hit = true
    while j < m {
      if s[i + j] != sub[j] { hit = false }
      j = j + 1
    }
    if hit { return i }
    i = i + 1
  }
  0 - 1
}

fn __str_slice(s, a, b) {
  mut lo = a
  mut hi = b
  if lo < 0 { lo = 0 }
  if hi > __len(s) { hi = __len(s) }
  mut out = ''
  mut i = lo
  while i < hi {
    out = out + s[i]
    i = i + 1
  }
  out
}

fn __is_space(c) {
  if c == ' ' { return true }
  if c == "\t" { return true }
  if c == "\n" { return true }
  if c == "\r" { return true }
  false
}

fn __method(recv, name, pos, kws, apos, line, col) {
  let t = __typeof(recv)
  # the global built-ins double as methods on anything that has no own
  # method of the name
  if name == 'drop' || name == 'to_string' || name == 'inspect' ||
     name == 'type_of' || name == 'to_long' || name == 'to_float' ||
     name == 'hash' {
    if !__inst_dunder(recv, name) {
      if name == 'drop' {
        # an explicit drop() on a plain resource runs its body once
        if !__is_instance(recv) {
          if __typeof(recv) == 'object' && __objecthas(recv, "\zdrop") {
            __drop_once(recv, recv['drop'])
          }
          return nil
        }
      }
      if name == 'to_string' { return __to_string(recv, line, col) }
      if name == 'inspect' { return __inspect(recv, line, col) }
      if name == 'type_of' { return __type_of(recv, line, col) }
      if name == 'to_long' { return __to_long(recv, line, col) }
      if name == 'to_float' { return __to_float(recv, line, col) }
      if name == 'hash' { return __hash_of(recv, line, col) }
    }
  }
  # a built-in method takes keyword values positionally
  let args = __with_kw_values(pos, kws)
  if t == 'array' {
    # the sorters take their reverse flag by keyword only
    if name == 'sort_by' || name == 'sorted_by' || name == 'sorted' || name == 'sort' {
      let cap = cond { name == 'sort_by' || name == 'sorted_by' => 1, _ => 0 }
      if __len(pos) > cap {
        mut word = ' positional arguments but '
        if cap == 1 { word = ' positional argument but ' }
        __raise('TypeError', 'takes ' + __tostr(cap) + word + __tostr(__len(pos)) + ' given',
                line, col)
      }
    }
    return __array_method(recv, name, args, line, col)
  }
  if t == 'string' {
    # the String methods that take a String: the parameter type is
    # reported at the argument
    if name == 'contains' || name == 'index_of' || name == 'starts_with' ||
       name == 'ends_with' {
      if __len(args) >= 1 {
        if __typeof(args[0]) != 'string' {
          let pn = cond { name == 'starts_with' => 'prefix', name == 'ends_with' => 'suffix', _ => 'sub' }
          __raise('TypeError', "type error: parameter '" + pn + "' expects StringLike",
                  __apos(apos, 0, 0, line), __apos(apos, 0, 1, col))
        }
      }
    }
    return __string_method(recv, name, args, line, col)
  }
  if t == 'object' {
    if __is_tuple(recv) { return __tuple_method(recv, name, args, line, col) }
    if __is_set(recv) { return __set_method(recv, name, args, line, col) }
    # a range answers iter() with its integers; anything else it is asked
    # is the plain object underneath (no iterator method set)
    if name == 'iter' && __is_range(recv) { return __range_iter_of(recv) }
    if __is_instance(recv) {
      let cls = recv["\zc"]
      let ms = cls['methods']
      if __objecthas(ms, name) {
        if name == 'drop' {
          __drop_once(recv, ms[name])
          return nil
        }
        return __call_selfk(ms[name], recv, pos, kws, apos, line, col)
      }
      if __objecthas(recv, name) {
        if __is_fn(recv[name]) { return __invokek(recv, name, pos, kws, apos, line, col) }
        if __callable_obj(recv[name]) {
          return __call_nk(recv[name], pos, kws, apos, line, col)
        }
      }
      if name == 'parameters' { return __parameters(recv) }
      if name == 'to_s' {
        if __derived(cls, 'Show') { return __derive_show(recv) }
      }
      return __object_method(recv, name, args, line, col)
    }
    if __is_class(recv) {
      if name == 'new' { return __construct(recv, pos, kws, apos, line, col) }
      if __objecthas(recv, name) {
        # a static method (or a callable static field)
        if __is_fn(recv[name]) {
          return __call_nk(recv[name], pos, kws, apos, line, col)
        }
      }
      __raise('TypeError', 'type error: expected Function, got Nil',
              line, col)
    }
    if !__objecthas(recv, name) { __ns_missing(recv, name, line, col) }
    if __objecthas(recv, name) {
      # a stored closure called as a method; a self-closure gets the receiver;
      # a stored class or callable instance is called with the shape
      if __callable_obj(recv[name]) {
        return __call_nk(recv[name], pos, kws, apos, line, col)
      }
      return __invokek(recv, name, pos, kws, apos, line, col)
    }
    return __object_method(recv, name, args, line, col)
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

fn __array_method(a, name, args, line, col) {
  if name == 'size' { return __len(a) }
  if name == 'empty' { return __len(a) == 0 }
  if name == 'presence' {
    if __len(a) == 0 { return nil }
    return a
  }
  if name == 'iter' { return __arr_iter(a) }
  if name == 'enumerate' { return __it_enumerate(__arr_iter(a)) }
  if name == 'to_set' { return __mk_set(a, line, col) }
  if name == 'push' {
    __arraypush(a, args[0])
    return nil
  }
  if name == 'pop' {
    if __len(a) == 0 { return nil }
    return __arraypop(a)
  }
  if name == 'get' {
    mut i = args[0]
    if i < 0 { i = i + __len(a) }
    if i < 0 { return args[1] }
    if i >= __len(a) { return args[1] }
    return a[i]
  }
  if name == 'slice' {
    __nargs(name, args, 2, line, col)
    mut lo = args[0]
    mut hi = args[1]
    if lo < 0 { lo = lo + __len(a) }
    if hi < 0 { hi = hi + __len(a) }
    if lo < 0 { lo = 0 }
    if hi > __len(a) { hi = __len(a) }
    mut out = []
    mut i = lo
    while i < hi {
      __arraypush(out, a[i])
      i = i + 1
    }
    return out
  }
  if name == 'join' {
    mut out = ''
    mut i = 0
    while i < __len(a) {
      if i > 0 { out = out + args[0] }
      out = out + __display(a[i])
      i = i + 1
    }
    return out
  }
  if name == 'contains' {
    mut i = 0
    while i < __len(a) {
      if __truthy(__eq(a[i], args[0]), line, col) { return true }
      i = i + 1
    }
    return false
  }
  if name == 'index_of' {
    mut i = 0
    while i < __len(a) {
      if __truthy(__eq(a[i], args[0]), line, col) { return i }
      i = i + 1
    }
    return 0 - 1
  }
  if name == 'map' {
    let f = __cb(args[0], name, line, col)
    mut out = []
    mut i = 0
    while i < __len(a) {
      __arraypush(out, f(a[i]))
      i = i + 1
    }
    return out
  }
  if name == 'filter' {
    let f = __cb(args[0], name, line, col)
    mut out = []
    mut i = 0
    while i < __len(a) {
      if __truthy(f(a[i]), line, col) { __arraypush(out, a[i]) }
      i = i + 1
    }
    return out
  }
  if name == 'for_each' {
    let f = __cb(args[0], name, line, col)
    mut i = 0
    while i < __len(a) {
      f(a[i])
      i = i + 1
    }
    return nil
  }
  if name == 'reduce' {
    let f = __cb(args[1], name, line, col)
    mut acc = args[0]
    mut i = 0
    while i < __len(a) {
      acc = f(acc, a[i])
      i = i + 1
    }
    return acc
  }
  if name == 'find' {
    let f = __cb(args[0], name, line, col)
    mut i = 0
    while i < __len(a) {
      if __truthy(f(a[i]), line, col) { return a[i] }
      i = i + 1
    }
    return nil
  }
  if name == 'any' {
    let f = __cb(args[0], name, line, col)
    mut i = 0
    while i < __len(a) {
      if __truthy(f(a[i]), line, col) { return true }
      i = i + 1
    }
    return false
  }
  if name == 'all' {
    let f = __cb(args[0], name, line, col)
    mut i = 0
    while i < __len(a) {
      if !__truthy(f(a[i]), line, col) { return false }
      i = i + 1
    }
    return true
  }
  if name == 'sum' {
    mut acc = 0
    mut i = 0
    while i < __len(a) {
      __expect_num(a[i], line, col)
      acc = acc + a[i]
      i = i + 1
    }
    return acc
  }
  if name == 'reverse' {
    mut i = 0
    mut j = __len(a) - 1
    while i < j {
      let tmp = a[i]
      a[i] = a[j]
      a[j] = tmp
      i = i + 1
      j = j - 1
    }
    return nil
  }
  if name == 'extend' {
    __nargs(name, args, 1, line, col)
    if __typeof(args[0]) != 'array' {
      __raise('TypeError', "type error: parameter 'other' expects Array", line, col)
    }
    let other = args[0]
    let n = __len(other)
    mut i = 0
    while i < n {
      __arraypush(a, other[i])
      i = i + 1
    }
    return nil
  }
  if name == 'insert' {
    __nargs(name, args, 2, line, col)
    mut i = args[0]
    if i < 0 { i = i + __len(a) }
    if i < 0 || i > __len(a) {
      __raise('IndexError', 'index out of range', line, col)
    }
    __arraypush(a, nil)
    mut j = __len(a) - 1
    while j > i {
      a[j] = a[j - 1]
      j = j - 1
    }
    a[i] = args[1]
    return nil
  }
  if name == 'remove_at' {
    __nargs(name, args, 1, line, col)
    mut i = args[0]
    if i < 0 { i = i + __len(a) }
    if i < 0 || i >= __len(a) {
      __raise('IndexError', 'index out of range', line, col)
    }
    let v = a[i]
    mut j = i
    while j < __len(a) - 1 {
      a[j] = a[j + 1]
      j = j + 1
    }
    __arraypop(a)
    return v
  }
  if name == 'sort' || name == 'sorted' {
    __nargs_range(name, args, 0, 1, 'reverse', line, col)
    mut rev = false
    if __len(args) == 1 { rev = __truthy(args[0], line, col) }
    let out = __sort_copy(a, fn (x) { x }, rev, line, col)
    if name == 'sorted' { return out }
    __write_back(a, out)
    return nil
  }
  if name == 'sort_by' || name == 'sorted_by' {
    __nargs_range(name, args, 1, 2, 'key', line, col)
    let f = __cb(args[0], name, line, col)
    mut rev = false
    if __len(args) == 2 { rev = __truthy(args[1], line, col) }
    let out = __sort_copy(a, f, rev, line, col)
    if name == 'sorted_by' { return out }
    __write_back(a, out)
    return nil
  }
  if name == 'min' || name == 'max' {
    __nargs(name, args, 0, line, col)
    return __it_min_max(__arr_iter(a), name, 'Array', name == 'min', line, col)
  }
  if name == 'min_by' || name == 'max_by' {
    __nargs(name, args, 1, line, col)
    return __it_min_max_by(__arr_iter(a), name, 'Array',
                           __cb(args[0], name, line, col), name == 'min_by',
                           line, col)
  }
  if name == 'flat_map' {
    __nargs(name, args, 1, line, col)
    let f = __cb(args[0], name, line, col)
    mut out = []
    mut i = 0
    while i < __len(a) {
      let r = f(a[i])
      if __typeof(r) != 'array' {
        __raise('TypeError', 'type error: flat_map callback must return an Array',
                line, col)
      }
      mut j = 0
      while j < __len(r) {
        __arraypush(out, r[j])
        j = j + 1
      }
      i = i + 1
    }
    return out
  }
  if name == 'product' || name == 'group_by' || name == 'partition' ||
      name == 'to_object' || name == 'unzip' {
    return __iter_method(__arr_iter(a), name, args, line, col)
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

# A stable insertion sort of a copy, keyed once per element; a key that
# does not compare leaves the receiver untouched, since the copy is what
# was being ordered.
fn __sort_copy(a, keyf, rev, line, col) {
  mut keys = []
  mut out = []
  mut i = 0
  while i < __len(a) {
    __arraypush(keys, keyf(a[i]))
    __arraypush(out, a[i])
    i = i + 1
  }
  mut k = 1
  while k < __len(out) {
    let v = out[k]
    let kv = keys[k]
    mut j = k - 1
    mut go = true
    while go {
      if j < 0 { go = false }
      if go {
        mut before = false
        if rev { before = __lt(keys[j], kv, line, col) } else {
          before = __lt(kv, keys[j], line, col)
        }
        if before {
          out[j + 1] = out[j]
          keys[j + 1] = keys[j]
          j = j - 1
        } else { go = false }
      }
    }
    out[j + 1] = v
    keys[j + 1] = kv
    k = k + 1
  }
  out
}

fn __write_back(a, out) {
  mut i = 0
  while i < __len(a) {
    a[i] = out[i]
    i = i + 1
  }
  nil
}

fn __string_method(s, name, args, line, col) {
  if name == 'size' { return __len(s) }
  if name == 'empty' { return __len(s) == 0 }
  if name == 'presence' {
    if __len(s) == 0 { return nil }
    return s
  }
  if name == 'iter' { return __str_iter(s) }
  if name == 'contains' { return __str_index_of(s, args[0], 0) >= 0 }
  if name == 'starts_with' {
    let m = __len(args[0])
    if m > __len(s) { return false }
    return __str_slice(s, 0, m) == args[0]
  }
  if name == 'ends_with' {
    let m = __len(args[0])
    if m > __len(s) { return false }
    return __str_slice(s, __len(s) - m, __len(s)) == args[0]
  }
  if name == 'index_of' {
    __nargs_range(name, args, 1, 2, 'sub', line, col)
    mut start = 0
    if __len(args) == 2 { start = args[1] }
    if start < 0 { start = start + __len(s) }
    if start < 0 { start = 0 }
    return __str_index_of(s, __str_arg(args[0], line, col), start)
  }
  if name == 'slice' { return __str_slice(s, args[0], args[1]) }
  if name == 'split' {
    __nargs_range(name, args, 1, 2, 'sep', line, col)
    mut limit = 0
    if __len(args) == 2 { limit = args[1] }
    return __str_split(s, __str_arg(args[0], line, col), limit, line, col)
  }
  if name == 'trim' {
    __nargs(name, args, 0, line, col)
    return __trim_side(s, '', true, true)
  }
  if name == 'repeat' {
    mut out = ''
    mut i = 0
    while i < args[0] {
      out = out + s
      i = i + 1
    }
    return out
  }
  let r = __string_method2(s, name, args, line, col)
  if __nomethod(r) {
    __raise('TypeError', 'type error: expected Function, got Nil', line, col)
  }
  r
}

# A table's "no such method" answer, distinct from every real result.
fn __nomethod(r) {
  if __typeof(r) != 'string' { return false }
  r == "\znomethod"
}

fn __object_method(o, name, args, line, col) {
  # anything with has_next/next picks up the lazy iterator set first
  if __is_iterator(o) {
    let r = __iter_method(__norm_iter(o), name, args, line, col)
    if !__nomethod(r) { return r }
  } else if __has_proto(o, 'iter') {
    # an iterable: the chain builds now and asks for the iterator at the
    # first pull, which is where a broken protocol is reported
    let r = __iter_method(__lazy_src(o, line, col), name, args, line, col)
    if !__nomethod(r) { return r }
  }
  if name == 'size' { return __obj_visible_size(o) }
  if name == 'empty' { return __obj_visible_size(o) == 0 }
  if name == 'presence' {
    if __obj_visible_size(o) == 0 { return nil }
    return o
  }
  if name == 'keys' {
    let ks = __visible_keys(o)
    mut out = []
    mut i = 0
    while i < __len(ks) {
      __arraypush(out, __key_val(o, ks[i]))
      i = i + 1
    }
    return out
  }
  if name == 'values' {
    let ks = __visible_keys(o)
    mut vis = []
    mut i = 0
    while i < __len(ks) {
      __arraypush(vis, o[ks[i]])
      i = i + 1
    }
    return __arr_iter(vis)
  }
  if name == 'iter' { return __entries_iter(o) }
  if name == 'has' { return __objecthas(o, __hkey(args[0], line, col)) }
  if name == 'get' {
    let pk = __hkey(args[0], line, col)
    if __objecthas(o, pk) { return o[pk] }
    return args[1]
  }
  if name == 'get_or_put' {
    let pk = __hkey(args[0], line, col)
    if __objecthas(o, pk) { return o[pk] }
    mut val = args[1]
    # init is a zero-argument thunk: a marker binds strictly, so a thunk
    # that needs an argument is the ArityError culebra raises
    if __is_fn(val) { val = __call_n(__check_fn(val, line, col), [], line, col) }
    __setindex(o, args[0], val, 0, line, col)
    return val
  }
  if name == 'remove' {
    let pk = __hkey(args[0], line, col)
    if __is_instance(o) {
      if __is_frozen_inst(o) {
        if __objecthas(o, "\zv") {
          __raise('ImmutableError', "cannot remove property '" + pk +
                  "' from a @value instance", line, col)
        }
      }
    }
    if __objecthas(o, pk) { __drop_key(o, pk) }
    return nil
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

# The synthesized parameters(): every class instance reachable from the
# fields, descending arrays and plain objects, instances themselves being
# leaves; a field whose name starts with '_' is private state and skipped.
fn __parameters(o) {
  mut out = []
  __params_walk_fields(o, out)
  out
}

fn __params_walk_fields(o, out) {
  let ks = __inst_fields(o)
  mut i = 0
  while i < __len(ks) {
    if ks[i][0] != '_' { __params_walk(o[ks[i]], out) }
    i = i + 1
  }
  nil
}

fn __params_walk(v, out) {
  if __is_instance(v) {
    __arraypush(out, v)
    return nil
  }
  let t = __typeof(v)
  if t == 'array' {
    mut i = 0
    while i < __len(v) {
      __params_walk(v[i], out)
      i = i + 1
    }
    return nil
  }
  if t == 'object' {
    if __is_tuple(v) || __is_set(v) || __is_fn(v) || __is_class(v) { return nil }
    __params_walk_fields(v, out)
  }
  nil
}

# @derive(Show): Name(field, field) over the fields' inspect forms.
fn __derive_show(o) {
  let ks = __inst_fields(o)
  mut out = o["\zc"]['name'] + '('
  mut first = true
  mut i = 0
  while i < __len(ks) {
    if !first { out = out + ', ' }
    first = false
    out = out + __repr(o[ks[i]])
    i = i + 1
  }
  out + ')'
}

# --- Hashable keys: non-String Object keys and Set members ------------------
#
# A non-String key lives under a physical key spelled "\zh" + tag + text
# (type-strict, so 1 / 1.0 / true are three keys); the original value sits
# in the hidden "\zK" table for keys() / iteration / display. The "\zh"
# prefix is the one \z-prefixed key that is *visible*.

fn __hidden_key(k) {
  if k[0] != "\z" { return false }
  k[1] != 'h'
}

fn __is_nsk(pk) { pk[0] == "\z" }

fn __hash_name(v) { __type_name(v) }

fn __hkey(v, line, col) {
  let t = __typeof(v)
  if t == 'string' { return v }
  if t == 'int' { return "\zhi" + __tostr(v) }
  if t == 'double' { return "\zhd" + __scalar_display(v) }
  if t == 'bool' {
    if v { return "\zhb1" }
    return "\zhb0"
  }
  if t == 'nil' { return "\zhn" }
  if __is_tuple(v) {
    let items = __titems(v)
    mut out = "\zht"
    mut i = 0
    while i < __len(items) {
      let hk = __hkey(items[i], line, col)
      out = out + __tostr(__len(hk)) + ':' + hk
      i = i + 1
    }
    return out
  }
  if __is_instance(v) {
    # an instance is a key when it hashes: derived Hash or a hash() method
    # (a @value class derives both). Equal keys need equality too: with a
    # derived Eq the key is structural, with an eq() method it is the
    # hash value, and with a hash but no equality every instance is its
    # own key.
    let has_hash = __is_value_inst(v) || __inst_derived(v, 'Hash') ||
                   __inst_dunder(v, 'hash')
    if !has_hash { __raise('TypeError', __unhashable_msg(v), line, col) }
    if __inst_dunder(v, 'hash') {
      if __inst_dunder(v, 'eq') || __inst_dunder(v, '__eq__') {
        return "\zhH" + __tostr(__hash_of(v, line, col))
      }
      return "\zhI" + __tostr(__identity(v))
    }
    if __is_value_inst(v) || __inst_derived(v, 'Eq') {
      let ks = __inst_fields(v)
      mut out = "\zhv" + v["\zc"]['name'] + '('
      mut i = 0
      while i < __len(ks) {
        let hk = __hkey(v[ks[i]], line, col)
        out = out + __tostr(__len(hk)) + ':' + hk
        i = i + 1
      }
      return out
    }
    return "\zhI" + __tostr(__identity(v))
  }
  __raise('TypeError', __unhashable_msg(v), line, col)
}

# A per-object number, given on first use, for keys that must not merge
# (counted on the class object: the prelude has no globals of its own).
fn __identity(o) {
  if !__objecthas(o, "\zi") {
    let cls = o["\zc"]
    mut n = 0
    if __objecthas(cls, "\zi") { n = cls["\zi"] }
    n = n + 1
    cls["\zi"] = n
    o["\zi"] = cls['name'] + ':' + __tostr(n)
  }
  o["\zi"]
}

fn __unhashable_msg(v) {
  let hn = __hash_name(v)
  mut msg = "unhashable type: '" + hn + "'"
  if hn == 'Object' { msg = msg + ' (no hash() method)' }
  msg
}

# A @value instance that keeps the derived equality (no __eq__ of its own)
# also gets the derived hash; one that writes __eq__ opts out of both.
fn __is_value_inst(v) {
  if !__is_instance(v) { return false }
  if !__is_frozen_inst(v) { return false }
  !__inst_dunder(v, '__eq__')
}

# hash(): a Long, equal for equal values. The scalar rules are culebra's
# (a Long is its own hash); strings and non-whole floats use FNV-1a over
# their bytes, which only needs to agree with itself.
fn __hash_of(v, line, col) {
  let t = __typeof(v)
  if t == 'int' { return v }
  if t == 'bool' {
    if v { return 1 }
    return 0
  }
  if t == 'nil' { return 0 }
  if t == 'double' {
    if v > 0.0 - 9.0e18 && v < 9.0e18 {
      let w = __toint(v)
      if __todouble(w) == v { return w }
    }
    return __str_hash(__scalar_display(v))
  }
  if t == 'string' { return __str_hash(v) }
  if __is_tuple(v) { return __hash_items(__titems(v), line, col) }
  if __inst_dunder(v, 'hash') {
    let h = __call_self(v["\zc"]['methods']['hash'], v, [], line, col)
    if __typeof(h) != 'int' {
      __raise('TypeError', 'type error: hash() must return Long', line, col)
    }
    return h
  }
  if __is_value_inst(v) || __inst_derived(v, 'Hash') {
    let ks = __inst_fields(v)
    mut items = [v["\zc"]['name']]
    mut i = 0
    while i < __len(ks) {
      __arraypush(items, v[ks[i]])
      i = i + 1
    }
    return __hash_items(items, line, col)
  }
  __raise('TypeError', __unhashable_msg(v), line, col)
}

fn __hash_items(items, line, col) {
  mut h = 7
  mut i = 0
  while i < __len(items) {
    h = h * 31 + __hash_of(items[i], line, col)
    i = i + 1
  }
  h
}

fn __str_hash(s) {
  mut h = 0 - 3750763034362895579
  mut tbl = {}
  mut i = 0
  while i < __len(s) {
    h = (h ^ __byte_memo(s[i], tbl)) * 1099511628211
    i = i + 1
  }
  h
}

fn __key_val(o, pk) {
  if __is_nsk(pk) { return o["\zK"][pk] }
  pk
}

fn __key_repr(o, pk) {
  if __is_nsk(pk) { return __repr(o["\zK"][pk]) }
  pk
}

fn __record_key(o, pk, key) {
  if !__is_nsk(pk) { return nil }
  if !__objecthas(o, "\zK") {
    mut fresh = {}
    o["\zK"] = fresh
  }
  let tbl = o["\zK"]
  tbl[pk] = key
  nil
}


fn __olit_mut(o, pks) {
  if !__objecthas(o, "\zm") {
    mut fresh = {}
    o["\zm"] = fresh
  }
  let muts = o["\zm"]
  mut i = 0
  while i < __len(pks) {
    muts[pks[i]] = true
    i = i + 1
  }
  o
}

fn __drop_key(o, pk) {
  __objectremove(o, pk)
  if __is_nsk(pk) {
    if __objecthas(o, "\zK") { __objectremove(o["\zK"], pk) }
  }
  if __objecthas(o, "\zm") {
    if __objecthas(o["\zm"], pk) { __objectremove(o["\zm"], pk) }
  }
  nil
}

fn __visible_keys(o) {
  let ks = __objectkeys(o)
  mut out = []
  mut i = 0
  while i < __len(ks) {
    if !__hidden_key(ks[i]) { __arraypush(out, ks[i]) }
    i = i + 1
  }
  out
}

fn __nargs(name, args, n, line, col) {
  if __len(args) == n { return nil }
  mut word = ' arguments but '
  if n == 1 { word = ' argument but ' }
  __raise('ArityError', "'" + name + "' takes " + __tostr(n) + word +
          __tostr(__len(args)) + ' given', line, col)
}

# --- Set: an Object carrying its members under the hidden "\zs" table -----

fn __is_set(v) {
  if __typeof(v) != 'object' { return false }
  __objecthas(v, "\zs")
}

fn __new_set() {
  mut s = {}
  mut members = {}
  s["\zs"] = members
  s
}

fn __set_add(s, v, line, col) {
  let pk = __hkey(v, line, col)
  let ms = s["\zs"]
  if __objecthas(ms, pk) { return false }
  ms[pk] = v
  true
}

fn __mk_set(items, line, col) {
  let s = __new_set()
  mut i = 0
  while i < __len(items) {
    __set_add(s, items[i], line, col)
    i = i + 1
  }
  s
}

fn __set_items(s) {
  let ms = s["\zs"]
  let ks = __objectkeys(ms)
  mut out = []
  mut i = 0
  while i < __len(ks) {
    __arraypush(out, ms[ks[i]])
    i = i + 1
  }
  out
}

fn __set_has(s, v, line, col) { __objecthas(s["\zs"], __hkey(v, line, col)) }

fn __set_size(s) { __len(__objectkeys(s["\zs"])) }

fn __set_repr(s) {
  let items = __set_items(s)
  mut out = '{'
  mut i = 0
  while i < __len(items) {
    if i > 0 { out = out + ', ' }
    out = out + __repr(items[i])
    i = i + 1
  }
  out + '}'
}

fn __set_eq(a, b) {
  if __set_size(a) != __set_size(b) { return false }
  let items = __set_items(a)
  mut i = 0
  while i < __len(items) {
    if !__set_has(b, items[i], 0, 0) { return false }
    i = i + 1
  }
  true
}

# The members of a that are (want_in) or are not in b, as a new Set.
fn __set_filter(a, b, want_in, line, col) {
  let out = __new_set()
  let xs = __set_items(a)
  mut i = 0
  while i < __len(xs) {
    if __set_has(b, xs[i], line, col) == want_in { __set_add(out, xs[i], line, col) }
    i = i + 1
  }
  out
}

fn __set_union_into(out, b, line, col) {
  let bs = __set_items(b)
  mut i = 0
  while i < __len(bs) {
    __set_add(out, bs[i], line, col)
    i = i + 1
  }
  out
}

fn __set_all_in(a, b, line, col) {
  let xs = __set_items(a)
  mut i = 0
  while i < __len(xs) {
    if !__set_has(b, xs[i], line, col) { return false }
    i = i + 1
  }
  true
}

fn __set_arg(v, line, col) {
  if !__is_set(v) {
    __raise('TypeError', "type error: parameter 'other' expects Set", line, col)
  }
  v
}

fn __set_method(s, name, args, line, col) {
  if name == 'size' {
    __nargs(name, args, 0, line, col)
    return __set_size(s)
  }
  if name == 'empty' {
    __nargs(name, args, 0, line, col)
    return __set_size(s) == 0
  }
  if name == 'presence' {
    __nargs(name, args, 0, line, col)
    if __set_size(s) == 0 { return nil }
    return s
  }
  if name == 'contains' {
    __nargs(name, args, 1, line, col)
    return __set_has(s, args[0], line, col)
  }
  if name == 'to_array' {
    __nargs(name, args, 0, line, col)
    return __set_items(s)
  }
  if name == 'iter' {
    __nargs(name, args, 0, line, col)
    return __arr_iter(__set_items(s))
  }
  if name == 'add' {
    __nargs(name, args, 1, line, col)
    return __set_add(s, args[0], line, col)
  }
  if name == 'remove' {
    __nargs(name, args, 1, line, col)
    let pk = __hkey(args[0], line, col)
    if !__objecthas(s["\zs"], pk) { return false }
    __objectremove(s["\zs"], pk)
    return true
  }
  if name == 'union' {
    __nargs(name, args, 1, line, col)
    let b = __set_arg(args[0], line, col)
    return __set_union_into(__mk_set(__set_items(s), line, col), b, line, col)
  }
  if name == 'intersect' || name == 'diff' || name == 'sym_diff' {
    __nargs(name, args, 1, line, col)
    let b = __set_arg(args[0], line, col)
    if name == 'intersect' { return __set_filter(s, b, true, line, col) }
    let out = __set_filter(s, b, false, line, col)
    if name == 'diff' { return out }
    return __set_union_into(out, __set_filter(b, s, false, line, col), line, col)
  }
  if name == 'subset' || name == 'superset' {
    __nargs(name, args, 1, line, col)
    let b = __set_arg(args[0], line, col)
    if name == 'subset' { return __set_all_in(s, b, line, col) }
    return __set_all_in(b, s, line, col)
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

fn __tuple_method(t, name, args, line, col) {
  let items = __titems(t)
  if name == 'size' {
    __nargs(name, args, 0, line, col)
    return __len(items)
  }
  if name == 'empty' {
    __nargs(name, args, 0, line, col)
    return __len(items) == 0
  }
  if name == 'presence' {
    __nargs(name, args, 0, line, col)
    if __len(items) == 0 { return nil }
    return t
  }
  if name == 'contains' {
    __nargs(name, args, 1, line, col)
    mut i = 0
    while i < __len(items) {
      if __truthy(__eq(items[i], args[0]), line, col) { return true }
      i = i + 1
    }
    return false
  }
  if name == 'to_array' {
    __nargs(name, args, 0, line, col)
    return __copy_arr(items)
  }
  if name == 'iter' {
    __nargs(name, args, 0, line, col)
    return __arr_iter(items)
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

# --- Iterators -------------------------------------------------------------
#
# Every built-in iterator is {iter, has_next, next} (plus dispose when a
# source it pulls from has one). Adapters are built on __lazy: a pull
# function fills a one-element lookahead, so has_next() is idempotent and
# next() past the end yields nil, the way culebra's do.

# iter() answers the receiver it is called on (no back-reference held: the
# wrapper must reach refcount zero when the loop lets go of it).
fn __mk_iter(hn, nx) {
  {iter: fn () { self }, has_next: hn, next: nx}
}

fn __mk_iter_d(hn, nx, srcs) {
  {iter: fn () { self }, has_next: hn, next: nx,
   dispose: fn () { __close_all(srcs) }}
}

# An iterable as a lazy source: iter() is asked for at the first pull.
fn __lazy_src(o, line, col) {
  mut it = nil
  let srcs = []
  fn ensure() {
    if __typeof(it) == 'nil' {
      it = __iter(o, line, col)
      __arraypush(srcs, it)
    }
    it
  }
  __mk_iter_d(fn () { ensure()['has_next']() },
              fn () { ensure()['next']() },
              srcs)
}

fn __has_dispose(it) { __has_proto(it, 'dispose') }

fn __any_dispose(srcs) {
  mut i = 0
  while i < __len(srcs) {
    if __has_dispose(srcs[i]) { return true }
    i = i + 1
  }
  false
}

fn __close_all(srcs) {
  mut i = 0
  while i < __len(srcs) {
    __iter_close(srcs[i])
    i = i + 1
  }
  nil
}

fn __is_iterator(v) {
  if !__has_proto(v, 'has_next') { return false }
  __has_proto(v, 'next')
}

fn __lazy(srcs, pull) {
  mut la = nil
  mut has_la = false
  mut done = false
  mut slot = [nil]
  fn fill() {
    if has_la { return nil }
    if done { return nil }
    if pull(slot) {
      la = slot[0]
      has_la = true
    } else {
      done = true
    }
    nil
  }
  let hn = fn () {
    fill()
    has_la
  }
  let nx = fn () {
    fill()
    if !has_la { return nil }
    has_la = false
    let v = la
    la = nil
    v
  }
  if __any_dispose(srcs) { return __mk_iter_d(hn, nx, srcs) }
  __mk_iter(hn, nx)
}

fn __arr_iter(items) {
  mut i = 0
  __mk_iter(fn () { i < __len(items) },
            fn () {
              if i >= __len(items) { return nil }
              let v = items[i]
              i = i + 1
              v
            })
}

fn __str_iter(s) {
  mut i = 0
  __mk_iter(fn () { i < __len(s) },
            fn () {
              if i >= __len(s) { return nil }
              let l = __cp_len(s[i])
              mut out = ''
              mut j = 0
              while j < l {
                if i + j < __len(s) {
                  out = out + s[i + j]
                }
                j = j + 1
              }
              i = i + l
              out
            })
}

fn __entries_iter(o) {
  # a snapshot of the keys; one removed before its turn is skipped, and
  # each value is read live at its step
  let vis = __visible_keys(o)
  mut j = 0
  fn settle() {
    while j < __len(vis) && !__objecthas(o, vis[j]) { j = j + 1 }
    nil
  }
  __mk_iter(fn () {
              settle()
              j < __len(vis)
            },
            fn () {
              settle()
              if j >= __len(vis) { return nil }
              let k = vis[j]
              j = j + 1
              __mk_tuple([__key_val(o, k), o[k]])
            })
}

fn __range_iter(a, b) {
  mut i = a
  __mk_iter(fn () { i < b },
            fn () {
              if i >= b { return nil }
              let v = i
              i = i + 1
              v
            })
}

fn __iter_or_nil(v, line, col) {
  let t = __typeof(v)
  if t == 'array' { return __arr_iter(v) }
  if t == 'string' { return __str_iter(v) }
  if t == 'object' {
    if __is_tuple(v) { return __arr_iter(__titems(v)) }
    if __is_set(v) { return __arr_iter(__set_items(v)) }
    if __is_range(v) { return __range_iter_of(v) }
    if __has_proto(v, 'iter') {
      let it = __invoke(v, 'iter', [], line, col)
      if __typeof(it) != 'object' {
        __raise('TypeError', 'type error: iter() did not return an Object',
                line, col)
      }
      if !__is_iterator(it) {
        __raise('TypeError', 'type error: iterator missing has_next()/next()',
                line, col)
      }
      return __norm_iter(it)
    }
    return __entries_iter(v)
  }
  nil
}

fn __iter(v, line, col) {
  let it = __iter_or_nil(v, line, col)
  if __typeof(it) == 'nil' {
    __raise('TypeError', 'type error: expected an iterable, got ' +
            __type_name(v), line, col)
  }
  it
}

# flatten / flat_map coerce their inner values with a different message
fn __iter_coerce(v, line, col) {
  let it = __iter_or_nil(v, line, col)
  if __typeof(it) == 'nil' {
    __raise('TypeError',
            'type error: expected Array, Tuple, Set, Object, or String, got ' +
            __type_name(v), line, col)
  }
  it
}

fn __copy_arr(xs) { __slice_arr(xs, 0, __len(xs)) }

fn __it_map(src, f) {
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    slot[0] = f(src.next())
    true
  })
}

fn __it_filter(src, p, line, col) {
  __lazy([src], fn (slot) {
    while src.has_next() {
      let v = src.next()
      if __truthy(p(v), line, col) {
        slot[0] = v
        return true
      }
    }
    false
  })
}

fn __it_take(src, n) {
  mut left = n
  __lazy([src], fn (slot) {
    if left <= 0 { return false }
    if !src.has_next() { return false }
    slot[0] = src.next()
    left = left - 1
    true
  })
}

fn __it_skip(src, n) {
  mut pending = n
  __lazy([src], fn (slot) {
    while pending > 0 {
      if !src.has_next() { return false }
      src.next()
      pending = pending - 1
    }
    if !src.has_next() { return false }
    slot[0] = src.next()
    true
  })
}

fn __it_take_while(src, p, line, col) {
  # once pull says no, __lazy never asks again
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    let v = src.next()
    if !__truthy(p(v), line, col) { return false }
    slot[0] = v
    true
  })
}

fn __it_skip_while(src, p, line, col) {
  mut skipping = true
  __lazy([src], fn (slot) {
    while skipping {
      if !src.has_next() { return false }
      let v = src.next()
      if !__truthy(p(v), line, col) {
        skipping = false
        slot[0] = v
        return true
      }
    }
    if !src.has_next() { return false }
    slot[0] = src.next()
    true
  })
}

fn __it_step_by(src, n) {
  mut first = true
  __lazy([src], fn (slot) {
    if !first {
      mut k = 1
      while k < n {
        if !src.has_next() { return false }
        src.next()
        k = k + 1
      }
    }
    first = false
    if !src.has_next() { return false }
    slot[0] = src.next()
    true
  })
}

fn __it_distinct(src, line, col) {
  mut seen = {}
  __lazy([src], fn (slot) {
    while src.has_next() {
      let v = src.next()
      let pk = __hkey(v, line, col)
      if !__objecthas(seen, pk) {
        seen[pk] = true
        slot[0] = v
        return true
      }
    }
    false
  })
}

fn __it_tap(src, f) {
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    let v = src.next()
    f(v)
    slot[0] = v
    true
  })
}

fn __it_scan(src, init, f) {
  mut acc = init
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    acc = f(acc, src.next())
    slot[0] = acc
    true
  })
}

# flatten and flat_map share one shape: an inner iterator drained before
# the next outer element is coerced
fn __it_flat(src, f, line, col) {
  mut inner = nil
  mut has_inner = false
  __lazy([src], fn (slot) {
    mut go = true
    while go {
      if has_inner {
        if inner.has_next() {
          slot[0] = inner.next()
          return true
        }
        __iter_close(inner)
        has_inner = false
      }
      if !src.has_next() { go = false } else {
        inner = __iter_coerce(f(src.next()), line, col)
        has_inner = true
      }
    }
    false
  })
}

fn __it_chunk_by(src, f, line, col) {
  mut pend = nil
  mut has_pend = false
  __lazy([src], fn (slot) {
    if !has_pend {
      if !src.has_next() { return false }
      pend = src.next()
      has_pend = true
    }
    let key = f(pend)
    mut group = [pend]
    has_pend = false
    mut go = true
    while go {
      if !src.has_next() { go = false } else {
        let v = src.next()
        if __truthy(__eq(f(v), key), line, col) {
          __arraypush(group, v)
        } else {
          pend = v
          has_pend = true
          go = false
        }
      }
    }
    slot[0] = group
    true
  })
}

fn __it_chunks(src, n) {
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    mut group = []
    while __len(group) < n && src.has_next() {
      __arraypush(group, src.next())
    }
    slot[0] = group
    true
  })
}

fn __it_windows(src, n) {
  mut buf = []
  mut primed = false
  __lazy([src], fn (slot) {
    if !primed {
      primed = true
      while __len(buf) < n && src.has_next() {
        __arraypush(buf, src.next())
      }
      if __len(buf) < n { return false }
      slot[0] = __copy_arr(buf)
      return true
    }
    if !src.has_next() { return false }
    buf = __slice_arr(buf, 1, __len(buf))
    __arraypush(buf, src.next())
    slot[0] = __copy_arr(buf)
    true
  })
}

fn __it_chain(src, other, line, col) {
  let o2 = __iter_coerce(other, line, col)
  mut first_done = false
  __lazy([src, o2], fn (slot) {
    if !first_done {
      if src.has_next() {
        slot[0] = src.next()
        return true
      }
      first_done = true
    }
    if !o2.has_next() { return false }
    slot[0] = o2.next()
    true
  })
}

fn __it_zip(src, other, line, col) {
  let o2 = __iter_coerce(other, line, col)
  __lazy([src, o2], fn (slot) {
    if !src.has_next() { return false }
    if !o2.has_next() { return false }
    let a = src.next()
    let b = o2.next()
    slot[0] = {first: a, second: b}
    true
  })
}

fn __it_enumerate(src) {
  mut i = 0
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    let v = src.next()
    slot[0] = __mk_tuple([i, v])
    i = i + 1
    true
  })
}

# A terminal closes its source exactly once: after the result on success,
# before rethrowing on failure (a dispose that throws while unwinding is
# swallowed so the original error is the one that escapes).
fn __term(src, body) {
  mut failed = false
  mut err = nil
  mut r = nil
  try {
    r = body()
  } catch e {
    failed = true
    err = e
  }
  if failed {
    try {
      __iter_close(src)
    } catch e2 {
      nil
    }
    throw err
  }
  __iter_close(src)
  r
}

fn __it_min_max(src, name, owner, want_lt, line, col) {
  __it_min_max_by(src, name, owner, fn (x) { x }, want_lt, line, col)
}

fn __it_min_max_by(src, name, owner, f, want_lt, line, col) {
  __term(src, fn () {
    if !src.has_next() {
      __raise('ValueError', name + ' of empty ' + owner, line, col)
    }
    mut best = src.next()
    mut bk = f(best)
    __expect_num(bk, line, col)
    while src.has_next() {
      let v = src.next()
      let k = f(v)
      __expect_num(k, line, col)
      mut better = false
      if want_lt {
        if k < bk { better = true }
      } else {
        if k > bk { better = true }
      }
      if better {
        best = v
        bk = k
      }
    }
    best
  })
}

fn __pair_of(v, line, col) {
  if __is_tuple(v) {
    let items = __titems(v)
    if __len(items) == 2 { return items }
  } else {
    if __typeof(v) == 'object' {
      if !__is_set(v) {
        if __objecthas(v, 'first') {
          if __objecthas(v, 'second') { return [v['first'], v['second']] }
        }
      }
    }
  }
  __raise('TypeError',
          'type error: unzip expects (a, b) tuples or {first, second} objects',
          line, col)
}

fn __iter_method(src, name, args, line, col) {
  if name == 'map' {
    __nargs(name, args, 1, line, col)
    return __it_map(src, __cb(args[0], name, line, col))
  }
  if name == 'filter' {
    __nargs(name, args, 1, line, col)
    return __it_filter(src, __cb(args[0], name, line, col), line, col)
  }
  if name == 'take' {
    __nargs(name, args, 1, line, col)
    return __it_take(src, args[0])
  }
  if name == 'skip' {
    __nargs(name, args, 1, line, col)
    return __it_skip(src, args[0])
  }
  if name == 'take_while' {
    __nargs(name, args, 1, line, col)
    return __it_take_while(src, __cb(args[0], name, line, col), line, col)
  }
  if name == 'skip_while' {
    __nargs(name, args, 1, line, col)
    return __it_skip_while(src, __cb(args[0], name, line, col), line, col)
  }
  if name == 'step_by' {
    __nargs(name, args, 1, line, col)
    if args[0] < 1 {
      __raise('ValueError', 'step_by() n must be at least 1', line, col)
    }
    return __it_step_by(src, args[0])
  }
  if name == 'distinct' {
    __nargs(name, args, 0, line, col)
    return __it_distinct(src, line, col)
  }
  if name == 'tap' {
    __nargs(name, args, 1, line, col)
    return __it_tap(src, __cb(args[0], name, line, col))
  }
  if name == 'scan' {
    __nargs(name, args, 2, line, col)
    return __it_scan(src, args[0], __cb(args[1], name, line, col))
  }
  if name == 'flatten' {
    __nargs(name, args, 0, line, col)
    return __it_flat(src, fn (v) { v }, line, col)
  }
  if name == 'flat_map' {
    __nargs(name, args, 1, line, col)
    return __it_flat(src, __cb(args[0], name, line, col), line, col)
  }
  if name == 'chunk_by' {
    __nargs(name, args, 1, line, col)
    return __it_chunk_by(src, __cb(args[0], name, line, col), line, col)
  }
  if name == 'chunks' {
    __nargs(name, args, 1, line, col)
    if args[0] < 1 {
      __raise('ValueError', 'chunks() n must be at least 1', line, col)
    }
    return __it_chunks(src, args[0])
  }
  if name == 'windows' {
    __nargs(name, args, 1, line, col)
    if args[0] < 1 {
      __raise('ValueError', 'windows() n must be at least 1', line, col)
    }
    return __it_windows(src, args[0])
  }
  if name == 'chain' {
    __nargs(name, args, 1, line, col)
    return __it_chain(src, args[0], line, col)
  }
  if name == 'zip' {
    __nargs(name, args, 1, line, col)
    return __it_zip(src, args[0], line, col)
  }
  if name == 'enumerate' {
    __nargs(name, args, 0, line, col)
    return __it_enumerate(src)
  }
  if name == 'collect' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut out = []
      while src.has_next() { __arraypush(out, src.next()) }
      out
    })
  }
  if name == 'join' {
    __nargs(name, args, 1, line, col)
    let sep = args[0]
    return __term(src, fn () {
      mut out = ''
      mut first = true
      while src.has_next() {
        if !first { out = out + sep }
        first = false
        out = out + __display(src.next())
      }
      out
    })
  }
  if name == 'for_each' {
    __nargs(name, args, 1, line, col)
    let f = __cb(args[0], name, line, col)
    return __term(src, fn () {
      while src.has_next() { f(src.next()) }
      nil
    })
  }
  if name == 'reduce' {
    __nargs(name, args, 2, line, col)
    let f = __cb(args[1], name, line, col)
    mut acc = args[0]
    return __term(src, fn () {
      while src.has_next() { acc = f(acc, src.next()) }
      acc
    })
  }
  if name == 'find' {
    __nargs(name, args, 1, line, col)
    let p = __cb(args[0], name, line, col)
    return __term(src, fn () {
      while src.has_next() {
        let v = src.next()
        if __truthy(p(v), line, col) { return v }
      }
      nil
    })
  }
  if name == 'any' {
    __nargs(name, args, 1, line, col)
    let p = __cb(args[0], name, line, col)
    return __term(src, fn () {
      while src.has_next() {
        if __truthy(p(src.next()), line, col) { return true }
      }
      false
    })
  }
  if name == 'all' {
    __nargs(name, args, 1, line, col)
    let p = __cb(args[0], name, line, col)
    return __term(src, fn () {
      while src.has_next() {
        if !__truthy(p(src.next()), line, col) { return false }
      }
      true
    })
  }
  if name == 'count' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut n = 0
      while src.has_next() {
        src.next()
        n = n + 1
      }
      n
    })
  }
  if name == 'first' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      if !src.has_next() { return nil }
      src.next()
    })
  }
  if name == 'last' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut v = nil
      while src.has_next() { v = src.next() }
      v
    })
  }
  if name == 'nth' {
    __nargs(name, args, 1, line, col)
    let n = args[0]
    if n < 0 {
      __raise('ValueError', 'nth() n must not be negative', line, col)
    }
    return __term(src, fn () {
      mut i = 0
      while i < n {
        if !src.has_next() { return nil }
        src.next()
        i = i + 1
      }
      if !src.has_next() { return nil }
      src.next()
    })
  }
  if name == 'position' {
    __nargs(name, args, 1, line, col)
    let p = __cb(args[0], name, line, col)
    return __term(src, fn () {
      mut i = 0
      while src.has_next() {
        if __truthy(p(src.next()), line, col) { return i }
        i = i + 1
      }
      nil
    })
  }
  if name == 'contains' {
    __nargs(name, args, 1, line, col)
    let want = args[0]
    return __term(src, fn () {
      while src.has_next() {
        if __truthy(__eq(src.next(), want), line, col) { return true }
      }
      false
    })
  }
  if name == 'sum' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut acc = 0
      while src.has_next() {
        let v = src.next()
        __expect_num(v, line, col)
        acc = acc + v
      }
      acc
    })
  }
  if name == 'product' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut acc = 1
      while src.has_next() {
        let v = src.next()
        __expect_num(v, line, col)
        acc = acc * v
      }
      acc
    })
  }
  if name == 'min' {
    __nargs(name, args, 0, line, col)
    return __it_min_max(src, name, 'Iterator', true, line, col)
  }
  if name == 'max' {
    __nargs(name, args, 0, line, col)
    return __it_min_max(src, name, 'Iterator', false, line, col)
  }
  if name == 'min_by' {
    __nargs(name, args, 1, line, col)
    return __it_min_max_by(src, name, 'Iterator', __cb(args[0], name, line, col), true,
                           line, col)
  }
  if name == 'max_by' {
    __nargs(name, args, 1, line, col)
    return __it_min_max_by(src, name, 'Iterator', __cb(args[0], name, line, col), false,
                           line, col)
  }
  if name == 'to_set' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      let s = __new_set()
      while src.has_next() { __set_add(s, src.next(), line, col) }
      s
    })
  }
  if name == 'to_object' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut o = {}
      while src.has_next() {
        let v = src.next()
        mut ok = false
        if __is_tuple(v) {
          if __len(__titems(v)) == 2 { ok = true }
        }
        if !ok {
          __raise('TypeError', 'type error: to_object expects (key, value) tuples',
                  line, col)
        }
        let kv = __titems(v)
        __setindex(o, kv[0], kv[1], 0, line, col)
      }
      o
    })
  }
  if name == 'group_by' {
    __nargs(name, args, 1, line, col)
    let f = __cb(args[0], name, line, col)
    return __term(src, fn () {
      mut o = {}
      while src.has_next() {
        let v = src.next()
        let key = f(v)
        let pk = __hkey(key, line, col)
        if !__objecthas(o, pk) {
          mut bucket = []
          __setindex(o, key, bucket, 0, line, col)
        }
        __arraypush(o[pk], v)
      }
      o
    })
  }
  if name == 'partition' {
    __nargs(name, args, 1, line, col)
    let p = __cb(args[0], name, line, col)
    return __term(src, fn () {
      mut yes = []
      mut no = []
      while src.has_next() {
        let v = src.next()
        if __truthy(p(v), line, col) { __arraypush(yes, v) } else { __arraypush(no, v) }
      }
      __mk_tuple([yes, no])
    })
  }
  if name == 'unzip' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut xs = []
      mut ys = []
      while src.has_next() {
        let pr = __pair_of(src.next(), line, col)
        __arraypush(xs, pr[0])
        __arraypush(ys, pr[1])
      }
      __mk_tuple([xs, ys])
    })
  }
  "\znomethod"
}

# --- Bound methods and self in closures ----------------------------------
#
# A closure that mentions self compiles with a hidden receiver parameter
# in front of its declared ones and is carried as a marker object
# {"\zb": raw[, "\zspec": its parameter list][, "\zns": no receiver slot]
# [, "\zS": bound receiver]}. A method call
# supplies the receiver, a dot read binds it (an already-bound marker keeps
# its receiver), and a plain call passes nil -- which the body's prologue
# replaces with the receiver of the enclosing method, if any, so a closure
# built inside a method still sees self when called on its own.

fn __is_marker(v) {
  if __typeof(v) != 'object' { return false }
  __objecthas(v, "\zb")
}

fn __is_fn(v) {
  if __typeof(v) == 'function' { return true }
  if __is_marker(v) { return true }
  __is_family(v)
}

fn __mk_selfc(raw) {
  mut o = {}
  o["\zb"] = raw
  o
}

# A closure with parameters: the marker carries its spec ("\zspec"); one
# that does not mention self is flagged ("\zns") so no receiver is
# prepended when it runs.
fn __mk_specc(raw, spec, has_self) {
  mut o = {}
  o["\zb"] = raw
  o["\zspec"] = spec
  if !has_self { o["\zns"] = true }
  o
}

fn __bind(v, recv) {
  if !__is_marker(v) { return v }
  if __objecthas(v, "\zS") { return v }
  mut o = {}
  o["\zb"] = v["\zb"]
  o["\zS"] = recv
  if __objecthas(v, "\zspec") { o["\zspec"] = v["\zspec"] }
  if __objecthas(v, "\zns") { o["\zns"] = true }
  o
}

fn __self_pick(sp, outer) {
  if __typeof(sp) == 'nil' { return outer }
  sp
}

fn __self_use(v, line, col) {
  if __typeof(v) == 'nil' {
    __raise('NameError', "undefined variable 'self'", line, col)
  }
  v
}

fn __marker_self(mk, fallback) {
  if __objecthas(mk, "\zS") { return mk["\zS"] }
  fallback
}

# The closure a marker or family stands for, with its receiver fixed: what
# a callback slot or a plain call site can invoke directly. It forwards the
# count it was called with, so the callee's own arity rules still apply.
fn __bindn(raw, selfv, line, col) {
  fn (a = nil, b = nil, c = nil, d = nil) {
    __call_selfk(raw, selfv, __argv4(__argcount(), a, b, c, d), nil, nil, line, col)
  }
}

fn __as_fn(v, line, col) {
  # the marker itself goes in, so a spec it carries still binds the call
  if __is_marker(v) { return __bindn(v, nil, line, col) }
  # a free multimethod family dispatches per call
  if __is_family(v) { return __bindn(v, nil, line, col) }
  v
}

# Whether a .name(...) on this receiver is the receiver's own method (an
# instance's class method or stored closure, a class's static or new), as
# opposed to a UFCS call of a free function of that name.
fn __has_method(v, name) {
  if __is_instance(v) {
    if __objecthas(v["\zc"]['methods'], name) { return true }
    if name == 'parameters' || name == 'hash' { return true }
    return __callable_prop(v, name)
  }
  if __is_class(v) {
    if name == 'new' { return true }
    return __callable_prop(v, name)
  }
  if __typeof(v) != 'object' { return false }
  if __is_tuple(v) || __is_set(v) { return false }
  __callable_prop(v, name)
}

fn __callable_prop(v, name) {
  __objecthas(v, name) && (__is_fn(v[name]) || __callable_obj(v[name]))
}

# Calls a callable-looking property with a receiver: a class method, a
# self-closure marker, or a plain closure (which takes no receiver).
fn __invoke(o, name, args, line, col) {
  __invokek(o, name, args, nil, nil, line, col)
}

fn __invokek(o, name, pos, kws, apos, line, col) {
  if __inst_dunder(o, name) {
    return __call_selfk(o["\zc"]['methods'][name], o, pos, kws, apos, line, col)
  }
  if !__objecthas(o, name) {
    __raise('TypeError', 'type error: iterator missing has_next()/next()',
            line, col)
  }
  let f = o[name]
  if __is_marker(f) { return __call_selfk(f, o, pos, kws, apos, line, col) }
  __call_n(__check_fn(f, line, col), __with_kw_values(pos, kws), line, col)
}

fn __has_proto(o, name) {
  if __typeof(o) != 'object' { return false }
  if __inst_dunder(o, name) { return true }
  if !__objecthas(o, name) { return false }
  __is_fn(o[name])
}

# The adapters drive their source with raw protocol calls, which only a
# plain object holding plain closures answers; anything else (an instance,
# a marker-holding object) is wrapped so those calls go through __invoke.
fn __norm_iter(it) {
  if !__is_instance(it) {
    mut plain = true
    if __typeof(it['has_next']) != 'function' { plain = false }
    if __typeof(it['next']) != 'function' { plain = false }
    if __objecthas(it, 'dispose') {
      if __typeof(it['dispose']) != 'function' { plain = false }
    }
    if plain { return it }
  }
  let hn = fn () { __invoke(it, 'has_next', [], 0, 0) }
  let nx = fn () { __invoke(it, 'next', [], 0, 0) }
  if __has_proto(it, 'dispose') { return __mk_iter_d(hn, nx, [it]) }
  __mk_iter(hn, nx)
}

# --- UTF-8 and the small Unicode tables the String methods need -----------
#
# Strings are bytes (culebra's own model); these walk them by code point.
# Two properties are carried as exact range tables (White_Space, Nd); case
# mapping covers ASCII, Latin-1, Greek, and Cyrillic; Alphabetic is the
# major letter blocks. Normalization, graphemes, and full case folding
# would need the Unicode database and are approximated -- see the header.

fn __bchr(n) { __allbytes()[n] }

fn __byte(c) {
  # a one-byte string's value, 0..255, via its position in the byte order
  # (strings compare bytewise, so a binary search over the range works)
  mut lo = 0
  mut hi = 255
  while lo < hi {
    let mid = (lo + hi) / 2
    if c > __bchr(mid) { lo = mid + 1 } else { hi = mid }
  }
  lo
}

# The value of a one-byte string, remembered in tbl across one walk so a
# byte is searched for at most once per string.
fn __byte_memo(c, tbl) {
  if __objecthas(tbl, c) { return tbl[c] }
  let v = __byte(c)
  tbl[c] = v
  v
}

fn __decode_cp(s, i, tbl) {
  # -> [code point, byte length]; an invalid sequence is U+FFFD over 1 byte
  let n = __len(s)
  let b0 = __byte_memo(s[i], tbl)
  if b0 < 128 { return [b0, 1] }
  mut need = 0
  mut cp = 0
  if b0 >= 194 && b0 <= 223 {
    need = 1
    cp = b0 - 192
  }
  if b0 >= 224 && b0 <= 239 {
    need = 2
    cp = b0 - 224
  }
  if b0 >= 240 && b0 <= 244 {
    need = 3
    cp = b0 - 240
  }
  if need == 0 { return [65533, 1] }
  mut k = 1
  while k <= need {
    if i + k >= n { return [65533, 1] }
    let b = __byte_memo(s[i + k], tbl)
    if b < 128 || b > 191 { return [65533, 1] }
    cp = cp * 64 + (b - 128)
    k = k + 1
  }
  if cp >= 55296 && cp <= 57343 { return [65533, 1] }
  if cp > 1114111 { return [65533, 1] }
  [cp, need + 1]
}

fn __cps(s) {
  let tbl = {}
  mut out = []
  mut i = 0
  while i < __len(s) {
    let d = __decode_cp(s, i, tbl)
    __arraypush(out, d[0])
    i = i + d[1]
  }
  out
}

fn __cp_str(cp) {
  if cp < 128 { return __bchr(cp) }
  if cp < 2048 {
    return __bchr(192 + cp / 64) + __bchr(128 + cp % 64)
  }
  if cp < 65536 {
    return __bchr(224 + cp / 4096) + __bchr(128 + (cp / 64) % 64) +
           __bchr(128 + cp % 64)
  }
  __bchr(240 + cp / 262144) + __bchr(128 + (cp / 4096) % 64) +
      __bchr(128 + (cp / 64) % 64) + __bchr(128 + cp % 64)
}

fn __cps_str(cps) {
  mut out = ''
  mut i = 0
  while i < __len(cps) {
    out = out + __cp_str(cps[i])
    i = i + 1
  }
  out
}

fn __in_ranges(cp, tbl) {
  mut i = 0
  while i < __len(tbl) {
    if cp >= tbl[i] {
      if cp <= tbl[i + 1] { return true }
    }
    i = i + 2
  }
  false
}

fn __ws_table() {
  [9, 13, 32, 32, 133, 133, 160, 160, 5760, 5760, 8192, 8202, 8232, 8233,
   8239, 8239, 8287, 8287, 12288, 12288]
}

fn __nd_table() {
  [48, 57, 1632, 1641, 1776, 1785, 1984, 1993, 2406, 2415, 2534, 2543,
   2662, 2671, 2790, 2799, 2918, 2927, 3046, 3055, 3174, 3183, 3302, 3311,
   3430, 3439, 3558, 3567, 3664, 3673, 3792, 3801, 3872, 3881, 4160, 4169,
   4240, 4249, 6112, 6121, 6160, 6169, 6470, 6479, 6608, 6617, 6784, 6793,
   6800, 6809, 6992, 7001, 7088, 7097, 7232, 7241, 7248, 7257, 42528, 42537,
   43216, 43225, 43264, 43273, 43472, 43481, 43504, 43513, 43600, 43609,
   44016, 44025, 65296, 65305, 66720, 66729, 68912, 68921, 69734, 69743,
   69872, 69881, 69942, 69951, 70096, 70105, 70384, 70393, 70736, 70745,
   70864, 70873, 71248, 71257, 71360, 71369, 71472, 71481, 71904, 71913,
   72016, 72025, 72784, 72793, 73040, 73049, 73120, 73129, 73552, 73561,
   92768, 92777, 92864, 92873, 93008, 93017, 120782, 120831, 123200, 123209,
   123632, 123641, 124144, 124153, 125264, 125273, 130032, 130041]
}

fn __alpha_table() {
  [65, 90, 97, 122, 170, 170, 181, 181, 186, 186, 192, 214, 216, 246,
   248, 705, 710, 721, 736, 740, 748, 748, 750, 750, 880, 884, 886, 887,
   890, 893, 895, 895, 902, 902, 904, 906, 908, 908, 910, 929, 931, 1013,
   1015, 1153, 1162, 1327, 1329, 1366, 1369, 1369, 1376, 1416, 1488, 1514,
   1519, 1522, 1568, 1610, 1646, 1647, 1649, 1747, 2308, 2361, 2365, 2365,
   2384, 2384, 2392, 2401, 12353, 12438, 12449, 12538, 12549, 12591,
   13312, 19903, 19968, 40959, 44032, 55203, 65313, 65338, 65345, 65370]
}

fn __is_ws_cp(cp) { __in_ranges(cp, __ws_table()) }

fn __all_cps(s, pred) {
  # non-empty and every code point satisfies pred
  if __len(s) == 0 { return false }
  let cps = __cps(s)
  mut i = 0
  while i < __len(cps) {
    if !pred(cps[i]) { return false }
    i = i + 1
  }
  true
}

fn __upper_cp(cp) {
  if cp >= 97 && cp <= 122 { return cp - 32 }
  if cp < 128 { return cp }
  if cp == 255 { return 376 }
  if cp >= 224 && cp <= 254 && cp != 247 { return cp - 32 }
  if cp >= 945 && cp <= 969 && cp != 962 { return cp - 32 }
  if cp >= 1072 && cp <= 1103 { return cp - 32 }
  if cp >= 1104 && cp <= 1119 { return cp - 80 }
  cp
}

fn __lower_cp(cp) {
  if cp >= 65 && cp <= 90 { return cp + 32 }
  if cp < 128 { return cp }
  if cp == 376 { return 255 }
  if cp >= 192 && cp <= 222 && cp != 215 { return cp + 32 }
  if cp >= 913 && cp <= 937 { return cp + 32 }
  if cp >= 1040 && cp <= 1071 { return cp + 32 }
  if cp >= 1024 && cp <= 1039 { return cp + 80 }
  cp
}

fn __upper_str(s) {
  let cps = __cps(s)
  mut out = ''
  mut i = 0
  while i < __len(cps) {
    if cps[i] == 223 { out = out + 'SS' } else {
      out = out + __cp_str(__upper_cp(cps[i]))
    }
    i = i + 1
  }
  out
}

fn __lower_str(s) {
  let cps = __cps(s)
  mut out = ''
  mut i = 0
  while i < __len(cps) {
    out = out + __cp_str(__lower_cp(cps[i]))
    i = i + 1
  }
  out
}

fn __fold_str(s) { __lower_str(__upper_str(s)) }

fn __title_str(s, every_word) {
  let cps = __cps(s)
  let alpha = __alpha_table()
  let nd = __nd_table()
  mut out = ''
  mut at_start = true
  mut i = 0
  while i < __len(cps) {
    let cp = cps[i]
    mut is_word = false
    if __in_ranges(cp, alpha) { is_word = true }
    if __in_ranges(cp, nd) { is_word = true }
    if cp == 39 { is_word = true }
    cond {
      !is_word => {
        out = out + __cp_str(cp)
        at_start = every_word
      },
      at_start => {
        out = out + __cp_str(__upper_cp(cp))
        at_start = false
      },
      _ => { out = out + __cp_str(__lower_cp(cp)) },
    }
    i = i + 1
  }
  out
}

fn __str_rfind(s, sub) {
  let n = __len(s)
  let m = __len(sub)
  if m > n { return 0 - 1 }
  mut i = n - m
  while i >= 0 {
    mut j = 0
    mut hit = true
    while j < m {
      if s[i + j] != sub[j] { hit = false }
      j = j + 1
    }
    if hit { return i }
    i = i - 1
  }
  0 - 1
}

fn __str_count(s, sub) {
  if __len(sub) == 0 { return 0 }
  mut n = 0
  mut from = 0
  mut go = true
  while go {
    let hit = __str_index_of(s, sub, from)
    if hit < 0 { go = false } else {
      n = n + 1
      from = hit + __len(sub)
    }
  }
  n
}

fn __str_replace(s, pat, repl, only_first) {
  if __len(pat) == 0 { return s }
  mut out = ''
  mut from = 0
  mut go = true
  while go {
    let hit = __str_index_of(s, pat, from)
    if hit < 0 {
      out = out + __str_slice(s, from, __len(s))
      go = false
    } else {
      out = out + __str_slice(s, from, hit) + repl
      from = hit + __len(pat)
      if only_first {
        out = out + __str_slice(s, from, __len(s))
        go = false
      }
    }
  }
  out
}

fn __str_split(s, sep, limit, line, col) {
  if limit < 0 {
    __raise('ValueError', 'split() limit must not be negative', line, col)
  }
  mut out = []
  if __len(sep) == 0 {
    __arraypush(out, s)
    return out
  }
  mut from = 0
  mut go = true
  while go {
    mut hit = __str_index_of(s, sep, from)
    if limit > 0 {
      if __len(out) == limit - 1 { hit = 0 - 1 }
    }
    if hit < 0 {
      __arraypush(out, __str_slice(s, from, __len(s)))
      go = false
    } else {
      __arraypush(out, __str_slice(s, from, hit))
      from = hit + __len(sep)
    }
  }
  out
}

fn __str_rsplit(s, sep, limit, line, col) {
  if limit < 0 {
    __raise('ValueError', 'split() limit must not be negative', line, col)
  }
  if limit == 0 { return __str_split(s, sep, 0, line, col) }
  mut pieces = []
  mut rest = s
  mut go = true
  while go {
    mut hit = 0 - 1
    if __len(sep) > 0 { hit = __str_rfind(rest, sep) }
    if __len(pieces) == limit - 1 { hit = 0 - 1 }
    if hit < 0 {
      __arraypush(pieces, rest)
      go = false
    } else {
      __arraypush(pieces, __str_slice(rest, hit + __len(sep), __len(rest)))
      rest = __str_slice(rest, 0, hit)
    }
  }
  mut out = []
  mut i = __len(pieces) - 1
  while i >= 0 {
    __arraypush(out, pieces[i])
    i = i - 1
  }
  out
}

fn __str_lines(s) {
  mut out = []
  mut cur = ''
  mut i = 0
  let n = __len(s)
  while i < n {
    let c = s[i]
    cond {
      c == "\n" => {
        __arraypush(out, cur)
        cur = ''
      },
      c == "\r" => {
        __arraypush(out, cur)
        cur = ''
        if i + 1 < n {
          if s[i + 1] == "\n" { i = i + 1 }
        }
      },
      _ => { cur = cur + c },
    }
    i = i + 1
  }
  if __len(cur) > 0 { __arraypush(out, cur) }
  out
}

fn __cp_in(cp, cps) {
  mut i = 0
  while i < __len(cps) {
    if cps[i] == cp { return true }
    i = i + 1
  }
  false
}

fn __trim_side(s, chars, from_start, from_end) {
  # each code point's byte offset rides along, so the answer is one slice
  let use_ws = __len(chars) == 0
  let set = __cps(chars)
  let ws = __ws_table()
  let tbl = {}
  mut cps = []
  mut offs = []
  mut i = 0
  while i < __len(s) {
    let d = __decode_cp(s, i, tbl)
    __arraypush(cps, d[0])
    __arraypush(offs, i)
    i = i + d[1]
  }
  __arraypush(offs, __len(s))
  fn strip(cp) {
    if use_ws { return __in_ranges(cp, ws) }
    __cp_in(cp, set)
  }
  mut lo = 0
  mut hi = __len(cps)
  if from_start {
    while lo < hi && strip(cps[lo]) { lo = lo + 1 }
  }
  if from_end {
    while hi > lo && strip(cps[hi - 1]) { hi = hi - 1 }
  }
  __str_slice(s, offs[lo], offs[hi])
}

fn __split_ws(s) {
  let cps = __cps(s)
  let ws = __ws_table()
  mut out = []
  mut cur = []
  mut i = 0
  while i < __len(cps) {
    if __in_ranges(cps[i], ws) {
      if __len(cur) > 0 {
        __arraypush(out, __cps_str(cur))
        cur = []
      }
    } else {
      __arraypush(cur, cps[i])
    }
    i = i + 1
  }
  if __len(cur) > 0 { __arraypush(out, __cps_str(cur)) }
  out
}

fn __str_tr(s, from, to) {
  let fc = __cps(from)
  let tc = __cps(to)
  let cps = __cps(s)
  mut out = []
  mut i = 0
  while i < __len(cps) {
    let cp = cps[i]
    mut j = 0
    mut hit = 0 - 1
    while j < __len(fc) {
      if hit < 0 {
        if fc[j] == cp { hit = j }
      }
      j = j + 1
    }
    cond {
      hit < 0 => __arraypush(out, cp),
      __len(tc) == 0 => nil,
      hit < __len(tc) => __arraypush(out, tc[hit]),
      _ => __arraypush(out, tc[__len(tc) - 1]),
    }
    i = i + 1
  }
  __cps_str(out)
}

fn __split_iter(s, sep) {
  mut from = 0
  mut done = false
  __lazy([], fn (slot) {
    if done { return false }
    if __len(sep) == 0 {
      done = true
      slot[0] = s
      return true
    }
    let hit = __str_index_of(s, sep, from)
    if hit < 0 {
      done = true
      slot[0] = __str_slice(s, from, __len(s))
      return true
    }
    slot[0] = __str_slice(s, from, hit)
    from = hit + __len(sep)
    true
  })
}

fn __string_ns() {
  {from_code_point: fn (cp) { __from_cp(cp, 0, 0) },
   from_code_points: fn (cps) { __from_cps(cps, 0, 0) },
   from_bytes: fn (bs) { __from_bytes(bs, 0, 0) }}
}

# GC.stat(): a full collection, then the live heap. A closed namespace: any
# other member is culebra's AttributeError.
fn __gc_ns() {
  mut ns = {stat: fn () {
    __collect()
    let s = __heapstats()
    {live_objects: s['live_objects'], rc_objects: s['live_objects'],
     heap_bytes: s['heap_bytes']}
  }}
  ns["\zN"] = 'GC'
  ns
}

fn __ns_missing(o, name, line, col) {
  if __typeof(o) == 'object' {
    if __objecthas(o, "\zN") {
      __raise('AttributeError', "namespace '" + o["\zN"] + "' has no member '" + name + "'",
              line, col)
    }
  }
  nil
}

fn __from_cp(cp, line, col) {
  if __typeof(cp) != 'int' {
    __raise('TypeError', 'type error: expected Long, got ' + __type_name(cp),
            line, col)
  }
  if cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343) {
    __raise('ValueError', 'String.from_code_point: ' + __tostr(cp) +
            ' is not a Unicode scalar value.', line, col)
  }
  __cp_str(cp)
}

fn __from_cps(cps, line, col) {
  if __typeof(cps) != 'array' {
    __raise('TypeError', 'type error', line, col)
  }
  mut out = ''
  mut i = 0
  while i < __len(cps) {
    if __typeof(cps[i]) != 'int' {
      __raise('TypeError', 'type error', line, col)
    }
    out = out + __from_cp(cps[i], line, col)
    i = i + 1
  }
  out
}

fn __from_bytes(bs, line, col) {
  if __typeof(bs) != 'array' {
    __raise('TypeError', 'type error', line, col)
  }
  mut out = ''
  mut i = 0
  while i < __len(bs) {
    let b = bs[i]
    if __typeof(b) != 'int' {
      __raise('TypeError', 'type error', line, col)
    }
    if b < 0 || b > 255 {
      __raise('ValueError', 'String.from_bytes: ' + __tostr(b) +
              ' is not a byte (0-255).', line, col)
    }
    out = out + __bchr(b)
    i = i + 1
  }
  out
}

fn __nargs_range(name, args, lo, hi, pname, line, col) {
  let n = __len(args)
  if n >= lo && n <= hi { return nil }
  if n < lo {
    __raise('ArityError', "missing required argument '" + pname + "'",
            line, col)
  }
  __raise('TypeError', 'takes ' + __tostr(hi) + ' positional arguments but ' +
          __tostr(n) + ' given', line, col)
}

fn __str_arg(v, line, col) {
  if __typeof(v) != 'string' {
    __raise('TypeError', 'type error: expected String, got ' +
            __type_name(v), line, col)
  }
  v
}

fn __string_method2(s, name, args, line, col) {
  if name == 'count' {
    __nargs(name, args, 1, line, col)
    return __str_count(s, __str_arg(args[0], line, col))
  }
  if name == 'last_index_of' {
    __nargs(name, args, 1, line, col)
    return __str_rfind(s, __str_arg(args[0], line, col))
  }
  if name == 'lines' {
    __nargs(name, args, 0, line, col)
    return __str_lines(s)
  }
  if name == 'replace' {
    __nargs(name, args, 2, line, col)
    return __str_replace(s, __str_arg(args[0], line, col),
                         __str_arg(args[1], line, col), false)
  }
  if name == 'replace_first' {
    __nargs(name, args, 2, line, col)
    return __str_replace(s, __str_arg(args[0], line, col),
                         __str_arg(args[1], line, col), true)
  }
  if name == 'rsplit' {
    __nargs_range(name, args, 1, 2, 'sep', line, col)
    mut limit = 0
    if __len(args) == 2 { limit = args[1] }
    return __str_rsplit(s, __str_arg(args[0], line, col), limit, line, col)
  }
  if name == 'split_once' || name == 'rsplit_once' {
    __nargs(name, args, 1, line, col)
    let sep = __str_arg(args[0], line, col)
    if __len(sep) == 0 { return nil }
    mut hit = 0
    if name == 'split_once' { hit = __str_index_of(s, sep, 0) } else {
      hit = __str_rfind(s, sep)
    }
    if hit < 0 { return nil }
    return __mk_tuple([__str_slice(s, 0, hit),
                       __str_slice(s, hit + __len(sep), __len(s))])
  }
  if name == 'split_iter' {
    __nargs(name, args, 1, line, col)
    return __split_iter(s, __str_arg(args[0], line, col))
  }
  if name == 'split_whitespace' {
    __nargs(name, args, 0, line, col)
    return __split_ws(s)
  }
  if name == 'strip_prefix' {
    __nargs(name, args, 1, line, col)
    let p = __str_arg(args[0], line, col)
    if __len(p) <= __len(s) {
      if __str_slice(s, 0, __len(p)) == p { return __str_slice(s, __len(p), __len(s)) }
    }
    return s
  }
  if name == 'strip_suffix' {
    __nargs(name, args, 1, line, col)
    let p = __str_arg(args[0], line, col)
    if __len(p) <= __len(s) {
      if __str_slice(s, __len(s) - __len(p), __len(s)) == p {
        return __str_slice(s, 0, __len(s) - __len(p))
      }
    }
    return s
  }
  if name == 'trim_start' || name == 'trim_end' {
    __nargs_range(name, args, 0, 1, 'chars', line, col)
    mut chars = ''
    if __len(args) == 1 { chars = __str_arg(args[0], line, col) }
    return __trim_side(s, chars, name == 'trim_start', name == 'trim_end')
  }
  if name == 'truncate' {
    __nargs_range(name, args, 1, 2, 'max', line, col)
    let mx = args[0]
    mut ell = '...'
    if __len(args) == 2 { ell = __str_arg(args[1], line, col) }
    if mx < 0 {
      __raise('ValueError', 'truncate() max must not be negative', line, col)
    }
    if __len(s) <= mx { return s }
    if mx < __len(ell) {
      __raise('ValueError', 'truncate() max must be at least ' +
              __tostr(__len(ell)), line, col)
    }
    return __str_slice(s, 0, mx - __len(ell)) + ell
  }
  if name == 'tr' {
    __nargs(name, args, 2, line, col)
    return __str_tr(s, __str_arg(args[0], line, col),
                    __str_arg(args[1], line, col))
  }
  if name == 'bytes' {
    __nargs(name, args, 0, line, col)
    let tbl = {}
    mut out = []
    mut i = 0
    while i < __len(s) {
      __arraypush(out, __byte_memo(s[i], tbl))
      i = i + 1
    }
    return __arr_iter(out)
  }
  if name == 'code_points' || name == 'graphemes' {
    __nargs(name, args, 0, line, col)
    if name == 'code_points' { return __arr_iter(__cps(s)) }
    # clusters: a zero-width joiner glues the next scalar on, and a
    # variation selector, an emoji modifier, or a combining mark attaches
    # to what came before (the small rules; no full Unicode database)
    let cps = __cps(s)
    mut out = []
    mut cur = ''
    mut i = 0
    while i < __len(cps) {
      let cp = cps[i]
      let attaches = (cp >= 768 && cp <= 879) || cp == 65038 || cp == 65039 ||
                     (cp >= 127995 && cp <= 127999) || cp == 8205
      if cur != '' && !attaches {
        if cps[i - 1] != 8205 {
          __arraypush(out, cur)
          cur = ''
        }
      }
      cur = cur + __cp_str(cp)
      i = i + 1
    }
    if cur != '' { __arraypush(out, cur) }
    return __arr_iter(out)
  }
  if name == 'is_digit' || name == 'is_alpha' || name == 'is_alnum' ||
     name == 'is_space' {
    __nargs(name, args, 0, line, col)
    let nd = __nd_table()
    let alpha = __alpha_table()
    let ws = __ws_table()
    if name == 'is_digit' { return __all_cps(s, fn (cp) { __in_ranges(cp, nd) }) }
    if name == 'is_alpha' { return __all_cps(s, fn (cp) { __in_ranges(cp, alpha) }) }
    if name == 'is_space' { return __all_cps(s, fn (cp) { __in_ranges(cp, ws) }) }
    return __all_cps(s, fn (cp) {
      if __in_ranges(cp, alpha) { return true }
      __in_ranges(cp, nd)
    })
  }
  if name == 'is_ascii' {
    __nargs(name, args, 0, line, col)
    return __all_cps(s, fn (cp) { cp < 128 })
  }
  if name == 'reverse' {
    __nargs(name, args, 0, line, col)
    let cps = __cps(s)
    mut out = []
    mut i = __len(cps) - 1
    while i >= 0 {
      __arraypush(out, cps[i])
      i = i - 1
    }
    return __cps_str(out)
  }
  if name == 'upper' {
    __nargs(name, args, 0, line, col)
    return __upper_str(s)
  }
  if name == 'lower' {
    __nargs(name, args, 0, line, col)
    return __lower_str(s)
  }
  if name == 'capitalize' {
    __nargs(name, args, 0, line, col)
    return __title_str(s, false)
  }
  if name == 'title' {
    __nargs(name, args, 0, line, col)
    return __title_str(s, true)
  }
  if name == 'eq_ignore_case' {
    __nargs(name, args, 1, line, col)
    return __fold_str(s) == __fold_str(__str_arg(args[0], line, col))
  }
  if name == 'normalize' {
    __nargs_range(name, args, 0, 1, 'form', line, col)
    mut form = 'NFC'
    if __len(args) == 1 { form = __str_arg(args[0], line, col) }
    if form != 'NFC' && form != 'NFD' && form != 'NFKC' && form != 'NFKD' {
      __raise('ValueError', "normalize() form must be 'NFC', 'NFD', 'NFKC', or 'NFKD', got '" +
              form + "'", line, col)
    }
    return s
  }
  if name == 'to_string' || name == 'view' {
    __nargs(name, args, 0, line, col)
    return s
  }
  "\znomethod"
}


# items[lo, hi), the end clamped to the length (as __str_slice clamps)
fn __slice_arr(items, lo, hi) {
  mut out = []
  mut i = lo
  mut end = hi
  if end > __len(items) { end = __len(items) }
  while i < end {
    __arraypush(out, items[i])
    i = i + 1
  }
  out
}

fn __spread_items(v, line, col) {
  let t = __typeof(v)
  if t == 'array' { return __copy_arr(v) }
  if t == 'object' {
    if __is_tuple(v) { return __copy_arr(__titems(v)) }
    if __is_set(v) { return __set_items(v) }
  }
  let it = __iter(v, line, col)
  mut out = []
  while it.has_next() { __arraypush(out, it.next()) }
  out
}

# name: Type in a pattern: a scalar type name, a class, or a trait.
fn __pat_type(v, tname) {
  let t = __typeof(v)
  if tname == 'Long' { return t == 'int' }
  if tname == 'Float' { return t == 'double' }
  if tname == 'String' { return t == 'string' }
  if tname == 'Bool' { return t == 'bool' }
  if tname == 'Nil' { return t == 'nil' }
  if tname == 'Array' { return t == 'array' }
  if tname == 'Function' { return __is_fn(v) }
  if tname == 'Tuple' { return __is_tuple(v) }
  if tname == 'Set' { return __is_set(v) }
  if tname == 'Object' { return t == 'object' }
  if !__is_instance(v) { return false }
  let cls = v["\zc"]
  if cls['name'] == tname { return true }
  if __objecthas(cls, 'conf') {
    if __objecthas(cls['conf'], tname) { return true }
  }
  false
}


# The bound is compared directly (inclusive or not) and the advance is
# overflow-checked, so a range that reaches the Long boundary ends there
# instead of wrapping.
fn __range_iter3(a, b, step, incl) {
  mut i = a
  mut done = false
  __mk_iter(fn () {
              if done { return false }
              if step > 0 {
                if incl { return i <= b }
                return i < b
              }
              if incl { return i >= b }
              i > b
            },
            fn () {
              let v = i
              let nx = i + step
              if step > 0 && nx < i { done = true }
              if step < 0 && nx > i { done = true }
              i = nx
              v
            })
}

# a..b / a..=b / a.. (open, for slicing) / ..b / by step: the plain object
# __is_range recognizes
fn __mk_range(a, b, incl, step, line, col) {
  if __typeof(a) != 'int' && __typeof(a) != 'nil' {
    __raise('TypeError', 'type error: expected Long, got ' + __type_name(a),
            line, col)
  }
  mut st = 1
  if __typeof(step) != 'nil' { st = step }
  if st == 0 { __raise('ValueError', 'range step must not be zero', line, col) }
  if __typeof(b) != 'nil' {
    if __typeof(b) != 'int' {
      __raise('TypeError', 'type error: expected Long, got ' + __type_name(b),
              line, col)
    }
  }
  {class: 'Range', start: a, end: b, inclusive: incl == 1, step: st}
}

# What escapes main: culebra's own one-line report, then a marker throw
# the driver turns into the exit status.
# The executor's own failures are {message, line, col}; culebra's carry a
# kind, so one is read off the message before a handler sees the value.
fn __fix_trap(e) {
  if __typeof(e) != 'object' { return e }
  if __objecthas(e, 'kind') { return e }
  if !__objecthas(e, 'message') { return e }
  if !__objecthas(e, 'line') { return e }
  let msg = e['message']
  mut kind = 'TypeError'
  if __str_index_of(msg, 'index out of range', 0) >= 0 { kind = 'IndexError' }
  if __str_index_of(msg, 'divide', 0) >= 0 { kind = 'ZeroDivisionError' }
  if __str_index_of(msg, 'argument(s)', 0) >= 0 { kind = 'ArityError' }
  if __str_index_of(msg, 'before', 0) >= 0 { kind = 'NameError' }
  if __str_index_of(msg, 'uninitialized', 0) >= 0 { kind = 'NameError' }
  if __str_index_of(msg, 'recursion', 0) >= 0 { kind = 'RecursionError' }
  {kind: kind, message: msg, line: e['line'], col: e['col']}
}

fn __report_uncaught(e0) {
  let e = __fix_trap(e0)
  if __typeof(e) == 'object' {
    if __objecthas(e, 'message') && __objecthas(e, 'line') && __objecthas(e, 'col') {
      mut head = ''
      if __objecthas(e, 'kind') {
        if __typeof(e['kind']) == 'string' { head = e['kind'] + ': ' }
      }
      println(head + e['message'] + ' at ' + __tostr(e['line']) + ':' +
              __tostr(e['col']) + '.')
      throw "\zexit"
    }
  }
  println('uncaught: ' + __display(e) + '.')
  throw "\zexit"
}

# Built-in functions carried as values.
fn __fnval_iota() {
  fn (a, b = nil) {
    if __typeof(b) == 'nil' { return __iota1(a, 0, 0) }
    __iota2(a, b, 0, 0)
  }
}
fn __fnval_range() {
  fn (a, b = nil, step = nil) {
    if __typeof(b) == 'nil' { return __range1(a, 0, 0) }
    if __typeof(step) == 'nil' { return __range2(a, b, 0, 0) }
    __range3(a, b, step, 0, 0)
  }
}
# A built-in carried as a value keeps the built-in's own arity error.
fn __need_args(got, want) {
  if got >= want { return nil }
  mut word = ' positional arguments, got '
  if want == 1 { word = ' positional argument, got ' }
  __raise('ArityError', 'expected ' + __tostr(want) + word + __tostr(got), 0, 0)
}
# A built-in of one or two positionals carried as a value; f takes the
# arguments and a position.
fn __fnval1(f) { fn (v = nil) { __need_args(__argcount(), 1); f(v, 0, 0) } }
fn __fnval2(f) { fn (a = nil, b = nil) { __need_args(__argcount(), 2); f(a, b, 0, 0) } }
fn __fnval_grid() { __fnval2(__grid) }
fn __fnval_inspect() { __fnval1(__inspect) }

# grid(x_range, y_range): the (x, y) tuples of two bounded ranges, x
# varying fastest.
fn __grid(xr, yr, line, col) {
  if !__is_range(xr) {
    __raise('TypeError', "type error: parameter 'x_range' expects Range", line, col)
  }
  if !__is_range(yr) {
    __raise('TypeError', "type error: parameter 'y_range' expects Range", line, col)
  }
  mut i = 0
  while i < 2 {
    let r = [xr, yr][i]
    if __typeof(r['start']) == 'nil' || __typeof(r['end']) == 'nil' {
      __raise('TypeError', 'cannot iterate an unbounded range', line, col)
    }
    if __range_step(r) == 0 {
      __raise('ValueError', 'range() step must not be zero', line, col)
    }
    i = i + 1
  }
  let ys = __range_iter_of(yr)
  mut xs = __range_iter_of(xr)
  mut y = nil
  mut have_y = false
  fn advance() {
    # move to the next y that has an x; false at the end
    while true {
      if have_y {
        if xs['has_next']() { return true }
      }
      if !ys['has_next']() { return false }
      y = ys['next']()
      have_y = true
      xs = __range_iter_of(xr)
    }
  }
  __mk_iter(fn () { advance() },
            fn () {
              if !advance() { return nil }
              __mk_tuple([xs['next'](), y])
            })
}
fn __fnval_type_of() { __fnval1(__type_of) }
fn __fnval_to_string() { __fnval1(__to_string) }
fn __fnval_to_long() { __fnval1(__to_long) }
fn __fnval_to_float() { __fnval1(__to_float) }
fn __fnval_assert_eq() { __fnval2(fn (a = nil, b = nil, l = 0, c = 0) { __assert_eq(a, b, '', l, c) }) }
fn __fnval_assert_true() { __fnval1(fn (v = nil, l = 0, c = 0) { __assert_true(v, '', l, c) }) }
fn __fnval_assert_false() { __fnval1(fn (v = nil, l = 0, c = 0) { __assert_false(v, '', l, c) }) }
fn __fnval_println() { fn (v) { println(v) } }
fn __fnval_print() { fn (v) { print(v) } }


fn __drop_once(o, dm) {
  if __objecthas(o, "\zdd") { return nil }
  o["\zdd"] = true
  __call_self(dm, o, [], 0, 0)
  nil
}

# One literal entry by its key value: hashed once, recorded for display
# when the key is not a String, marked mutable on request.
fn __olit_put(o, key, v, is_mut, line, col) {
  let pk = __hkey(key, line, col)
  o[pk] = v
  __record_key(o, pk, key)
  if is_mut == 1 { __olit_mut(o, [pk]) }
  if __is_protocol_key(pk) { __bind_contract(o, pk, v, line, col) }
  o
}

# The well-known keys a literal may bind: drop installs the hook, and
# iter / has_next / next must be zero-argument functions where bound.
fn __with_contract(o, line, col) {
  let keys = ['drop', 'iter', 'has_next', 'next']
  mut i = 0
  while i < 4 {
    if __objecthas(o, keys[i]) { __bind_contract(o, keys[i], o[keys[i]], line, col) }
    i = i + 1
  }
  o
}

fn __is_protocol_key(pk) {
  pk == 'drop' || pk == 'iter' || pk == 'has_next' || pk == 'next'
}

fn __bind_contract(o, key, f, line, col) {
  mut ok = __is_fn(f)
  if ok && __is_marker(f) {
    if __objecthas(f, "\zspec") {
      if __len(f["\zspec"][0]) > 0 { ok = false }
    }
  }
  if !ok {
    __raise('DropContractError',
            "type error: '" + key + "' must be a Function taking no arguments.", line, col)
  }
  if key == 'drop' { o["\zdrop"] = fn (o2) { __drop_once(o2, f) } }
  nil
}

# --- Callback arity: a higher-order method calls its callback with a
# fixed count, and culebra checks the callback can take exactly that
# (a *rest callback only needs its required ones) before the first call.

fn __cb_arity(name) {
  if name == 'reduce' || name == 'scan' { return 2 }
  if name == 'map' || name == 'filter' || name == 'for_each' || name == 'find' ||
     name == 'any' || name == 'all' || name == 'flat_map' || name == 'take_while' ||
     name == 'skip_while' || name == 'sort_by' || name == 'sorted_by' ||
     name == 'min_by' || name == 'max_by' || name == 'group_by' ||
     name == 'partition' || name == 'chunk_by' || name == 'tap' ||
     name == 'position' || name == 'count' { return 1 }
  0 - 1
}

# [required, total] regular positional parameters of a callable; total is
# -1 with a *rest. A family accepts through any overload.
fn __cb_bounds(v) {
  if __is_marker(v) {
    if !__objecthas(v, "\zspec") {
      # a bound method (its family answers) or a zero-parameter self
      # closure (its hidden receiver slot does not count)
      let raw = v["\zb"]
      if __is_family(raw) { return nil }
      mut n = __fnarity(raw)
      if !__objecthas(v, "\zns") { n = n - 1 }
      return [n, n]
    }
    let recs = v["\zspec"][0]
    mut lo = 0
    mut hi = 0
    mut i = 0
    while i < __len(recs) {
      let kind = recs[i][4]
      if kind == 'r' { return [lo, 0 - 1] }
      if kind == 'p' {
        hi = hi + 1
        if !recs[i][3] { lo = lo + 1 }
      }
      i = i + 1
    }
    return [lo, hi]
  }
  if __typeof(v) == 'function' {
    let n = __fnarity(v)
    return [n, n]
  }
  nil
}

fn __cb_accepts(v, expected) {
  if __is_family(v) {
    let ovs = v['ov']
    mut i = 0
    while i < __len(ovs) {
      if __cb_accepts(__mk_specc(ovs[i][0], ovs[i][1], !__objecthas(v, 'free')), expected) {
        return true
      }
      i = i + 1
    }
    return false
  }
  if __inst_dunder(v, '__call__') {
    return __cb_accepts(v["\zc"]['methods']['__call__'], expected)
  }
  if __is_marker(v) && !__objecthas(v, "\zspec") && __is_family(v["\zb"]) {
    return __cb_accepts(v["\zb"], expected)
  }
  let b = __cb_bounds(v)
  if __typeof(b) == 'nil' { return true }
  if b[1] < 0 { return expected >= b[0] }
  expected == b[1]
}

fn __cb(v, name, line, col) {
  let n = __cb_arity(name)
  if n >= 0 && __is_callable(v) {
    if !__cb_accepts(v, n) {
      __raise('TypeError', 'type error: ' + name + ' expects a ' + __tostr(n) +
              '-parameter function', line, col)
    }
  }
  __check_fn(v, line, col)
}

# A plain object whose drop key holds a function is a resource like a
# class instance: the VM runs the hidden hook when its refcount hits
# zero. The contract is culebra's: a Function taking no arguments.
fn __obj_spread(o, src, line, col) {
  if __typeof(src) != 'object' {
    __raise('TypeError', 'type error: expected Object, got ' + __type_name(src),
            line, col)
  }
  let ks = __visible_keys(src)
  mut i = 0
  while i < __len(ks) {
    let k = ks[i]
    o[k] = src[k]
    __olit_mut(o, [k])
    if __is_nsk(k) { __record_key(o, k, __key_val(src, k)) }
    i = i + 1
  }
  o
}

fn __assert_lt(a, b, label, line, col) {
  if __lt(a, b, line, col) { return nil }
  __raise('AssertionError', "assert_lt failed:" + __lbl(label) + "\n  left:  " + __display(a) +
          "\n  right: " + __display(b), line, col)
}

fn __assert_ge(a, b, label, line, col) {
  if __ge(a, b, line, col) { return nil }
  __raise('AssertionError', "assert_ge failed:" + __lbl(label) + "\n  left:  " + __display(a) +
          "\n  right: " + __display(b), line, col)
}

fn __fnval_assert_lt() { __fnval2(fn (a = nil, b = nil, l = 0, c = 0) { __assert_lt(a, b, '', l, c) }) }
fn __fnval_assert_ge() { __fnval2(fn (a = nil, b = nil, l = 0, c = 0) { __assert_ge(a, b, '', l, c) }) }

fn __assert_throws(kind, f, label, line, col) {
  mut threw = false
  mut got = nil
  try {
    f()
  } catch e {
    threw = true
    got = __fix_trap(e)
  }
  if !threw {
    __raise('AssertionError', "assert_throws('" + kind + "', fn): expected throw but fn returned normally",
            line, col)
  }
  mut gk = ''
  if __typeof(got) == 'object' {
    if __objecthas(got, 'kind') { gk = __display(got['kind']) }
  }
  if gk != kind {
    __raise('AssertionError', "assert_throws: expected kind '" + kind + "' but got '" + gk + "'",
            line, col)
  }
  nil
}


fn __range3(a0, b0, step, line, col) {
  if __typeof(step) != 'int' {
    __raise('TypeError', 'type error: expected Long, got ' + __type_name(step),
            line, col)
  }
  if step == 0 { __raise('ValueError', 'range step must not be zero', line, col) }
  # range(n, step: s) counts from 0
  mut a = a0
  mut b = b0
  if __typeof(b) == 'nil' {
    b = a
    a = 0
  }
  let base = __range_iter3(a, b, step, false)
  {iter: fn () { __range_iter3(a, b, step, false) },
   has_next: base['has_next'],
   next: base['next']}
}

`

# --- Function records and scopes ---------------------------------------------
#
# One record per function: func 0 is the top level ("main"); every named
# `fn`, closure literal, and defer body gets its own. Within a function,
# variables live in a stack of block scopes; the scan stores every
# resolution (keyed by the ident node's position, which is unique) so the
# emitter never re-resolves. Slots are never reused -- a captured
# variable's identity is (function, slot), and reuse would alias two
# variables through one cell -- so a block's Scope range is
# [its first slot, the function's watermark when it closed]; an inner
# block's slots fall inside that range and are released again, which is a
# no-op the second time.

mut funcs = []          # {parent, name, params, named, stmts, body_key, is_prelude}
mut frames = nil        # Frames: per func, what it captures and which slots are cells
mut ir = nil            # the Emitter over the program's Module
mut nslots = []         # per func: named local slots (params + decls)
mut nscratch = []       # per func: lowering-temp slots, appended after
mut closure_of = {}     # "line:col" of a closure/defer body -> func index
mut resolved = {}       # "line:col" of an ident use/decl -> resolution
mut scratch_of = {}     # "line:col" of an op token -> scratch index
mut block_info = {}     # "line:col" of a block -> {base, wrap}
mut prelude_named = {}  # prelude fn name -> func index
# closure literals that mention `self`: func -> how `self` resolves in the
# enclosing function (kind 'var' record, or 'none'), plus the closure's own
# `self` slot and definition position for its prologue diagnostics
mut self_closure = {}
mut self_slot = {}
mut fn_pos = {}
mut own_binding = {}    # letrec closure func -> the variable holding it
mut pending_own = nil   # the binding the closure about to be scanned is let-bound to
mut fwd_slots = {}      # "owner/slot" -> name, for bindings a closure named before they ran
mut args_info = {}      # func -> {slot, first, count}: where its __ARGS__ live
mut rest_info = {}      # func -> {slot, first, count}: its *rest slot and hidden overflow
mut predeclared = {}    # "f/scope/name" slots taken by a forward reference
mut runtime_immut = {}  # assignments that raise ImmutableError when run
mut bare_init = {}      # "f/slot" bare bindings still awaiting their first write
mut uncaught_slot = 0   # main's local for the value an uncaught throw carries
mut pat_mut = false     # whether a `let mut <pattern>` is being scanned
mut in_prelude = false
mut ret_specs = {}    # func -> parsed return annotation
mut scope_stack = []  # per func: [{map: {name: (slot, is_mut)}}...]
mut loop_depth = {}   # func -> depth (scan-time)

# The culebra type-annotation names, as the typeof vocabulary the emitted
# checks compare against. Tuple is special-cased (a marked object).
let type_map = {
  Long: 'int',
  Float: 'double',
  String: 'string',
  Bool: 'bool',
  Nil: 'nil',
  Array: 'array',
  Object: 'object',
  Function: 'function',
}

# Method names the built-in dispatcher owns; a .name(...) outside this set
# falls back to UFCS when a function of that name is in scope.
let builtin_methods = [
  'size',
  'empty',
  'push',
  'pop',
  'get',
  'slice',
  'join',
  'contains',
  'index_of',
  'map',
  'filter',
  'for_each',
  'reduce',
  'find',
  'any',
  'all',
  'sum',
  'reverse',
  'sorted',
  'starts_with',
  'ends_with',
  'split',
  'trim',
  'repeat',
  'keys',
  'values',
  'has',
  'remove',
  'presence',
  'iter',
  'enumerate',
  'to_set',
  'get_or_put',
  'to_array',
  'union',
  'intersect',
  'diff',
  'sym_diff',
  'subset',
  'superset',
  'add',
  'take',
  'skip',
  'take_while',
  'skip_while',
  'step_by',
  'distinct',
  'tap',
  'scan',
  'flatten',
  'chunk_by',
  'chunks',
  'windows',
  'flat_map',
  'chain',
  'zip',
  'collect',
  'count',
  'first',
  'last',
  'nth',
  'position',
  'product',
  'min',
  'max',
  'min_by',
  'max_by',
  'to_object',
  'group_by',
  'partition',
  'unzip',
  'last_index_of',
  'lines',
  'replace',
  'replace_first',
  'rsplit',
  'split_once',
  'rsplit_once',
  'split_iter',
  'split_whitespace',
  'strip_prefix',
  'strip_suffix',
  'trim_start',
  'trim_end',
  'truncate',
  'tr',
  'bytes',
  'code_points',
  'graphemes',
  'is_digit',
  'is_alpha',
  'is_alnum',
  'is_space',
  'is_ascii',
  'upper',
  'lower',
  'capitalize',
  'title',
  'eq_ignore_case',
  'normalize',
  'to_string',
  'view',
  'extend',
  'insert',
  'remove_at',
  'sort',
  'sort_by',
  'sorted_by',
  'hash',
  'parameters',
  'to_s',
]

let missing_marker = String.from_code_point(1) + 'missing'
# every byte value in order: the prelude's byte<->string conversions index it
let allbytes_str = String.from_bytes(range(256).collect())
# What a raw generator yields instead of ever completing: culebra runs a
# generator body's defers only through dispose, never at the body's own
# end, so the raw frame must stay suspended -- pending defers intact --
# until a genreturn (or never). The wrapper treats this value as "done".
let gen_end_marker = String.from_code_point(1) + 'gend'
let exit_marker = String.from_code_point(1) + 'exit'
let class_marker = String.from_code_point(1) + 'k'
let family_marker = String.from_code_point(1) + 'f'
let unbound_marker = String.from_code_point(1) + 'unbound'

let intrinsics = {
  __typeof: ('typeof', 1),
  __tostr: ('tostr', 1),
  __len: ('len', 1),
  __toint: ('toint', 1),
  __todouble: ('todouble', 1),
  __fmod: ('fmod', 2),
  __fpow: ('pow', 2),
  __arraypush: ('arraypush', 2),
  __arraypop: ('arraypop', 1),
  __objecthas: ('objecthas', 2),
  __objectkeys: ('objectkeys', 1),
  __objectremove: ('objectremove', 2),
  __genresume: ('genresume', 2),
  __genreturn: ('genreturn', 2),
  __same: ('same', 2),
  __argcount: ('argcount', 0),
  __fnarity: ('fnarity', 1),
  __collect: ('collect', 0),
  __heapstats: ('heapstats', 0),
}

# Global builtins user code calls by name; each lowers to the prelude
# function of the same table entry, with the call's position appended.
let builtins = {
  inspect: ('__inspect', 1),
  type_of: ('__type_of', 1),
  to_string: ('__to_string', 1),
  to_long: ('__to_long', 1),
  to_float: ('__to_float', 1),
  iota: nil,
  range: nil,
  assert_eq: ('__assert_eq', 2),
  assert_true: ('__assert_true', 1),
  assert_throws: ('__assert_throws', 2),
  assert_false: ('__assert_false', 1),
  grid: ('__grid', 2),
  assert_lt: ('__assert_lt', 2),
  assert_ge: ('__assert_ge', 2),
}

fn new_func(parent, name, stmts, body_key) {
  let f = funcs.size()
  funcs.push({
    parent: parent,
    name: name,
    params: [],
    pspecs: [],
    named: {},
    stmts: stmts,
    body_key: body_key,
    is_prelude: in_prelude,
    is_named: name != 'main' && !name.contains('.') && !name.contains('@'),
  })
  frames.add(parent)
  nslots.push(0)
  nscratch.push(0)
  scope_stack.push([])
  loop_depth[f] = 0
  f
}

# A parameter node in any of its five shapes, normalized.
# A dispatch type name; a function type or a union has none.
fn ty_name(ty) {
  cond {
    ty.name == 'ident' => ty.token,
    # Box<Long> checks the outer name, as culebra does
    ty.name == 'gen_ty' => ty.nodes[0].token,
    _ => nil,
  }
}

# The type parameters in scope while a class's or fn's parameters are
# walked: an annotation naming one is Any at run time.
mut cur_tparams = []
# A *rest parameter: a closure packs it from the supplied count (eight
# hidden trailing parameters catch the overflow); every function opens
# the mark a binder packed it under.
fn push_hidden(f, hn, at) {
  declare_var(f, hn, false, at)
  funcs[f].params.push(hn)
  funcs[f].pspecs.push({
    pname: hn,
    ty: nil,
    dflt: nil,
    rest: false,
    id: nil,
    hidden: true,
  })
}

fn setup_rest(f) {
  for k in range(funcs[f].pspecs.size()) {
    let rec = funcs[f].pspecs[k]
    if rec.rest && rec.hidden != true && !rest_info.has(f) {
      mut count = 0
      if fn_pos.has(f) {
        let at = rec.id
        for h in range(8) {
          push_hidden(f, "\x01r{h}", at)
        }
        count = 8
      }
      rest_info[f] = {
        slot: k,
        first: funcs[f].pspecs.size() - count,
        count: count,
      }
    }
  }
}

fn erase_tparams(g) {
  funcs[g]['tparams'] = cur_tparams
  let specs = funcs[g].pspecs
  for i in range(specs.size()) {
    let rec = specs[i]
    if rec.ty != nil && cur_tparams.contains(rec.ty) {
      specs[i] = {...rec, ty: nil}
    }
  }
}

fn param_record(node) {
  match node {
    {
      name: 'rest_p',
      nodes: [id],
    } => {pname: id.token, ty: nil, dflt: nil, rest: true, id: id},
    # **opts collects the keywords no parameter claims; a bare * is not a
    # parameter but the keyword-only boundary
    {
      name: 'kwrest_p',
      nodes: [id],
    } => {
      pname: id.token,
      ty: nil,
      dflt: nil,
      rest: false,
      id: id,
      kwrest: true,
    },
    {name: 'kwonly_p'} => {
      pname: nil,
      ty: nil,
      dflt: nil,
      rest: false,
      id: nil,
      marker: 'kwonly',
    },
    {
      name: 'tydef_p',
      nodes: [id, ty, dflt],
    } => {pname: id.token, ty: ty_name(ty), dflt: dflt, rest: false, id: id},
    {
      name: 'typed_p',
      nodes: [id, ty],
    } => {pname: id.token, ty: ty_name(ty), dflt: nil, rest: false, id: id},
    {
      name: 'def_p',
      nodes: [id, dflt],
    } => {pname: id.token, ty: nil, dflt: dflt, rest: false, id: id},
    {name: 'dparam', nodes: [tp]} => {
      let id = synth('ident', [], tp)
      id['token'] = "\x01d" + id.key
      {pname: id.token, ty: nil, dflt: nil, rest: false, id: id, destr: tp}
    },
    _ => {pname: node.token, ty: nil, dflt: nil, rest: false, id: node},
  }
}

# Whether a statement declares `name`; the declaring node and mutability.
fn decl_of(st, name) {
  if st.name == 'decl' {
    let [kw, pat, _] = st.nodes
    if pat.name == 'ident' {
      if pat.token == name {
        return {is_mut: is_mut_kw(kw.token), id: pat}
      }
      return nil
    }
    for id in pat.nodes {
      if id.token == name {
        return {is_mut: is_mut_kw(kw.token), id: id}
      }
    }
    return nil
  }
  if st.name == 'pdecl' {
    let [kw, pat, _] = st.nodes
    let id = pat_binder(pat, name)
    if id != nil {
      return {is_mut: is_mut_kw(kw.token), id: id}
    }
  }
  nil
}

fn pat_binder(pat, name) {
  if pat.name == 'bind_p' || pat.name == 'typed_pt' || pat.name == 'rest_pt' {
    if pat.nodes[0].token == name {
      return pat.nodes[0]
    }
    return nil
  }
  if pat.name == 'obj_p' {
    for op in pat.nodes {
      cond {
        op.nodes.size() == 2 => {
          let r = pat_binder(op.nodes[1], name)
          if r != nil {
            return r
          }
        },
        op.nodes[0].token == name => {
          return op.nodes[0]
        },
        _ => nil,
      }
    }
    return nil
  }
  if pat.name == 'arr_p' || pat.name == 'tup_p' {
    for sp in pat.nodes {
      let r = pat_binder(sp, name)
      if r != nil {
        return r
      }
    }
  }
  nil
}

# A free name in function g that an enclosing function declares later in
# a scope still being walked: declare it there now, and let the eventual
# `let` reuse the slot.
fn forward_declare(g, name) {
  mut h = funcs[g].parent
  while h != nil {
    let fr = forward_declare_in(h, name)
    if fr != nil {
      return fr
    }
    h = funcs[h].parent
  }
  nil
}

# The later declaration of `name` in one of h's open scopes, if any,
# given its slot now.
fn forward_declare_in(h, name) {
  let scopes = scope_stack[h]
  mut i = scopes.size() - 1
  while i >= 0 {
    let cur = scopes[i].cur
    if cur[0] != nil {
      # the statement being walked counts: a closure inside a let's own
      # initializer names the binding that let declares
      mut j = cur[1]
      while j < cur[0].size() {
        let d = decl_of(cur[0][j], name)
        if d != nil {
          let slot = nslots[h]
          nslots[h] = slot + 1
          scopes[i].map[name] = (slot, d.is_mut)
          predeclared["{h}/{i}/{name}"] = true
          # until the declaration runs the binding holds the unbound mark,
          # which a read through the capture reports as culebra's NameError
          fwd_slots["{h}/{slot}"] = name
          return {kind: 'var', owner: h, slot: slot, is_mut: d.is_mut}
        }
        j = j + 1
      }
    }
    i = i - 1
  }
  nil
}

fn declare_var(f, name, is_mut, at) {
  let scopes = scope_stack[f]
  let top = scopes[scopes.size() - 1]
  if top.map.has(name) {
    let pk = "{f}/{scopes.size() - 1}/{name}"
    if predeclared.has(pk) {
      # a forward reference already took the slot
      predeclared.remove(pk)
    }
    # declared again in the same list: culebra rebinds the same binding
    # (a closure built before the redeclaration follows it), so the slot
    # is reused and only the mutability is updated
    let (slot, _) = top.map[name]
    top.map[name] = (slot, is_mut)
    resolved[pkey(at)] = {kind: 'var', owner: f, slot: slot, is_mut: is_mut}
    return slot
  }
  # culebra's shadow rule is static: a name that any enclosing function
  # (the top level excepted -- its names act as globals) binds anywhere in
  # its body cannot be bound again inside a nested function, captured or
  # not, textually before or after (`self` is the receiver, redeclared per
  # function on purpose)
  if !funcs[f].is_prelude &&
      name != 'self' &&
      name != '__selfp' &&
      name != '_' {
    mut h = funcs[f].parent
    while h != nil {
      # a raw generator redeclares its wrapper's parameters by construction
      if funcs[h].parent != nil && funcs[h].gen_raw != f {
        if local_names(h).has(name) {
          fail(
            at,
            "cannot shadow outer variable '{name}' (declared in an enclosing function)",
          )
        }
      }
      h = funcs[h].parent
    }
  }
  let slot = nslots[f]
  nslots[f] = slot + 1
  top.map[name] = (slot, is_mut)
  resolved[pkey(at)] = {kind: 'var', owner: f, slot: slot, is_mut: is_mut}
  slot
}

# Every name function g binds anywhere in its own body (parameters, let /
# mut and pattern declarations, for and catch variables, match bindings,
# bare bindings, nested fn and class names), nested functions excluded:
# the set culebra's shadow check reads. Collected once per function.
mut local_name_sets = {}
fn local_names(g) {
  let key = "{g}"
  if local_name_sets.has(key) {
    return local_name_sets[key]
  }
  mut names = {}
  for p in funcs[g].params {
    names[p] = true
  }
  for st in funcs[g].stmts {
    collect_binders(st, names, g)
  }
  local_name_sets[key] = names
  names
}

# Whether an enclosing function (the top level included) binds name.
fn bound_outside(g, name) {
  mut h = funcs[g].parent
  while h != nil {
    if local_names(h).has(name) {
      return true
    }
    h = funcs[h].parent
  }
  false
}

fn collect_binders(node, names, g) {
  if node.nodes == nil {
    return nil
  }
  if is_fn_boundary(node.name) {
    return nil
  }
  let n = node.name
  cond {
    n == 'decl' => pat_names(node.nodes[1], names),
    n == 'pdecl' => pat_names(node.nodes[1], names),
    # a for variable is block-scoped and deliberately left out; a bare
    # assignment binds locally only when no outer scope has the name
    n == 'try' => names[node.nodes[1].token] = true,
    n == 'assign' => {
      let lhs = node.nodes[0]
      if lhs.name == 'ident' && node.nodes[1].token == '=' {
        if !bound_outside(g, lhs.token) {
          names[lhs.token] = true
        }
      }
    },
    n == 'fn_decl' => names[fn_decl_parts(node).id.token] = true,
    n == 'class_d' => names[class_parts(node).id.token] = true,
    n == 'arm' => pat_names(node.nodes[0], names),
    _ => nil,
  }
  for c in node.nodes {
    collect_binders(c, names, g)
  }
  nil
}

# The identifiers a declaration / for / match pattern binds.
fn pat_names(pat, names) {
  cond {
    pat.name == 'ident' => names[pat.token] = true,
    pat.name == 'typed_pat' ||
      pat.name == 'typed_pt' ||
      pat.name == 'bind_p' ||
      pat.name == 'rest_pt' => names[pat.nodes[0].token] = true,
    pat.name == 'tup_pat' ||
      pat.name == 'arr_pat' ||
      pat.name == 'bare_tup' ||
      pat.name == 'arr_p' ||
      pat.name == 'tup_p' => {
      for sp in pat.nodes {
        pat_names(sp, names)
      }
    },
    pat.name == 'obj_p' => {
      for op in pat.nodes {
        cond {
          op.nodes.size() == 2 => pat_names(op.nodes[1], names),
          _ => names[op.nodes[0].token] = true,
        }
      }
    },
    _ => nil,
  }
  nil
}

fn new_scratch(f, at) {
  let k = nscratch[f]
  nscratch[f] = k + 1
  scratch_of[pkey(at)] = k
  k
}

fn resolve(f, name) {
  mut h = f
  while h != nil {
    if classes.has("{h}/{name}") {
      # the class binding is also a plain variable (the class object); the
      # kind lets a call site construct directly
      let scopes2 = scope_stack[h]
      mut j = scopes2.size() - 1
      mut slot = nil
      mut going = true
      while going {
        cond {
          j < 0 => going = false,
          scopes2[j].map.has(name) => {
            let (sl, _) = scopes2[j].map[name]
            slot = sl
            going = false
          },
          _ => j = j - 1,
        }
      }
      if slot != nil {
        return {kind: 'class', owner: h, slot: slot, cls: "{h}/{name}"}
      }
    }
    let scopes = scope_stack[h]
    mut i = scopes.size() - 1
    while i >= 0 {
      if scopes[i].map.has(name) {
        let (slot, is_mut) = scopes[i].map[name]
        return {kind: 'var', owner: h, slot: slot, is_mut: is_mut}
      }
      i = i - 1
    }
    if funcs[h].named.has(name) {
      return {kind: 'fn', funcs: funcs[h].named[name]}
    }
    if funcs[h].is_prelude && prelude_named.has(name) {
      return {kind: 'fn', funcs: [prelude_named[name]]}
    }
    # an enclosing function's later declaration outranks anything further
    # out (culebra binds a nested function's free name at call time, when
    # that declaration has run); a function's own later declarations do
    # not count for its own direct reads
    if h != f {
      let fr = forward_declare_in(h, name)
      if fr != nil {
        return fr
      }
    }
    h = funcs[h].parent
  }
  {kind: 'none'}
}

fn note_use(node, f, r) {
  resolved[pkey(node)] = r
  if r.kind == 'var' {
    frames.use(f, r.owner, r.slot)
  }
}

# --- Pass A: collect + scan ---------------------------------------------------
#
# Sibling named fns register before any sibling body is walked, so mutual
# recursion resolves; everything else binds in textual order.

fn enter_scope(f) {
  scope_stack[f].push({map: {}, cur: [nil, 0]})
}

# The statement list a scope is walking, and how far it got: what lets a
# nested function's free name find a declaration that comes later in an
# enclosing scope (culebra binds those at call time).
fn scope_cursor(f) {
  let scopes = scope_stack[f]
  scopes[scopes.size() - 1].cur
}
fn leave_scope(f) {
  scope_stack[f].pop()
}

# A fn_decl's pieces: [deco..., ident, fparams, block]. Decorated functions
# are not multimethods -- they become a let-bound closure wrapped by the
# decorators, applied innermost-first.
fn fn_decl_parts(s) {
  mut decos = []
  mut i = 0
  while s.nodes[i].name == 'deco' {
    decos.push(s.nodes[i])
    i = i + 1
  }
  mut tparams = []
  mut j = i + 1
  if s.nodes[j].name == 'tparams' {
    for tp in s.nodes[j].nodes {
      tparams.push(tp.nodes[0].token)
    }
    j = j + 1
  }
  let prms = s.nodes[j]
  mut blk = s.nodes[j + 1]
  mut ret = nil
  if blk.name == 'ret_ann' {
    ret = blk
    blk = s.nodes[j + 2]
  }
  {
    decos: decos,
    id: s.nodes[i],
    prms: prms,
    blk: blk,
    ret: ret,
    tparams: tparams,
  }
}

# a method/titem node: [ident, fparams, ret_ann?, block?]
fn method_parts(n) {
  mut blk = nil
  mut ret = nil
  mut i = 2
  while i < n.nodes.size() {
    if n.nodes[i].name == 'block' {
      blk = n.nodes[i]
    }
    if n.nodes[i].name == 'ret_ann' {
      ret = n.nodes[i]
    }
    i = i + 1
  }
  {id: n.nodes[0], prms: n.nodes[1], blk: blk, ret: ret}
}

# A declared return type, as the runtime check reads it: the type checks
# of its alternatives, whether nil is allowed, and the annotation's text
# for the error; nil when the annotation is a function type (unchecked).
fn ret_spec(ann) {
  let ty = ann.nodes[0]
  mut checks = []
  mut names = []
  mut opt = false
  fn take(atom) {
    if atom.name != 'ident' {
      return false
    }
    checks.push(ty_check_of(atom.token))
    names.push(atom.token)
    true
  }
  cond {
    ty.name == 'ident' => {
      if !take(ty) {
        return nil
      }
    },
    ty.name == 'tyexpr' => {
      for c in ty.nodes {
        cond {
          c.name == 'tyor' => {
            if !take(c.nodes[0]) {
              return nil
            }
          },
          c.name == 'tyopt' => opt = true,
          _ => {
            if !take(c) {
              return nil
            }
          },
        }
      }
    },
    _ => return nil,
  }
  mut text = names.join(' | ')
  if opt {
    text = text + '?'
  }
  {checks: checks, opt: opt, text: text, names: names}
}

# Whether a statement's emitted node carries the value the enclosing
# function falls off with (a declaration, loop, or control transfer does
# not).
fn is_value_stmt(node) {
  let n = node.name
  !(n == 'decl' ||
    n == 'pdecl' ||
    n == 'assign' ||
    n == 'while' ||
    n == 'for' ||
    n == 'return_s' ||
    n == 'break_s' ||
    n == 'continue_s' ||
    n == 'throw_s' ||
    n == 'defer_s' ||
    n == 'yield_v' ||
    n == 'yield_f' ||
    n == 'class_d' ||
    n == 'trait_d' ||
    n == 'fn_decl' ||
    n == 'mod_stmt')
}

# Wrap a value leaving function f in its declared return-type check.
fn emit_ret_check(m, f, v, at) {
  if !funcs[f].has('ret') {
    return v
  }
  if !ret_specs.has(f) {
    ret_specs[f] = ret_spec(funcs[f].ret)
  }
  let spec = ret_specs[f]
  if spec == nil {
    return v
  }
  # a type parameter in the annotation makes it Any
  if funcs[f].has('tparams') {
    for tn in spec.names {
      if funcs[f].tparams.contains(tn) {
        return v
      }
    }
  }
  mut cs = []
  for tc in spec.checks {
    cs.push(ir.str_literal(tc, at))
  }
  let (pl, pc) = cond {
    fn_pos.has(f) => (
      ir.literal(fn_pos[f][0], at),
      ir.literal(fn_pos[f][1], at),
    ),
    _ => pos_args(m, {line: at.line, column: at.column}),
  }
  call_pre(
    m,
    f,
    '__ret_check',
    [
      v,
      ir.array_lit(cs, at),
      ir.bool_literal(spec.opt, at),
      ir.str_literal(spec.text, at),
      pl,
      pc,
    ],
    at,
  )
}

# Whether a statement subtree contains a yield of its own -- not one hidden
# inside a nested function body, which belongs to that function.
fn has_yield_node(n) {
  if n.name == 'yield_v' || n.name == 'yield_f' {
    return true
  }
  if n.name == 'closure' ||
      n.name == 'lambda' ||
      n.name == 'defer_s' ||
      n.name == 'fn_decl' ||
      n.name == 'class_d' ||
      n.name == 'trait_d' {
    return false
  }
  for c in n.nodes {
    if has_yield_node(c) {
      return true
    }
  }
  false
}

fn has_yield_stmts(blk) {
  for st in blk.nodes {
    if has_yield_node(st) {
      return true
    }
  }
  false
}

fn scan_body_stmts(f, stmts, blk_key) {
  mut has_defer = false
  for s in stmts {
    if s.name == 'trait_d' {
      let tname = s.nodes[0].token
      mut req = []
      mut dfl = {}
      mut dar = {}
      mut i = 1
      while i < s.nodes.size() {
        let it = method_parts(s.nodes[i])
        cond {
          it.blk == nil => req.push((it.id.token, it.prms.nodes.size())),
          _ => {
            # a default method: its own function, self as the first param
            let g = new_func(
              f,
              "{tname}.{it.id.token}",
              it.blk.nodes,
              pkey(it.blk),
            )
            dfl['m:' + it.id.token] = g
            dar['m:' + it.id.token] = it.prms.nodes.size()
            closure_of[pkey(s.nodes[i])] = g
          },
        }
        i = i + 1
      }
      traits[tname] = {required: req, defaults: dfl, darities: dar}
    }
    if s.name == 'class_d' {
      let d = class_parts(s)
      declare_var(f, d.id.token, false, d.id)
      # every method name maps to its overloads in declaration order; keys
      # carry an 'm:' prefix so a method named `drop` cannot trip the host's
      # own auto-drop contract on this compiler map
      mut methods = {}
      mut ctors = []
      for mn in d.methods {
        let it = method_parts(mn)
        let g = new_func(
          f,
          "{d.id.token}.{it.id.token}",
          it.blk.nodes,
          pkey(it.blk),
        )
        closure_of[pkey(mn)] = g
        if it.ret != nil {
          funcs[g]['ret'] = it.ret
        }
        cond {
          it.id.token == 'new' => ctors.push(g),
          _ => {
            let mk = 'm:' + it.id.token
            if !methods.has(mk) {
              methods[mk] = []
            }
            methods[mk].push(g)
          },
        }
      }
      mut synth = nil
      if ctors.size() == 0 {
        # a class without new() accepts no arguments
        synth = new_func(f, "{d.id.token}.new", [], 'c:' + pkey(d.id))
        ctors.push(synth)
      }
      # the built-in decorators are flags; the rest are applied to the class
      # object like a function's
      mut is_value = false
      mut derives = {}
      mut decos = []
      for dn in d.decos {
        let dname = dn.nodes[0].token
        cond {
          dname == 'value' => is_value = true,
          dname == 'packable' => nil,  # a layout hint; no behaviour here
          dname == 'derive' => {
            if dn.nodes.size() == 2 {
              for a in dn.nodes[1].nodes {
                if a.name == 'ident' {
                  derives[a.token] = true
                }
              }
            }
          },
          _ => decos.push(dn),
        }
      }
      mut smeths = {}
      for mn in d.smethods {
        let it = method_parts(mn)
        let g = new_func(
          f,
          "{d.id.token}.{it.id.token}",
          it.blk.nodes,
          pkey(it.blk),
        )
        closure_of[pkey(mn)] = g
        if it.ret != nil {
          funcs[g]['ret'] = it.ret
        }
        smeths[it.id.token] = g
      }
      mut finits = {}
      for fd in d.fields {
        cond {
          fd.init != nil => {
            let g = new_func(
              f,
              "{d.id.token}.{fd.id.token}",
              [fd.init],
              pkey(fd.init),
            )
            finits[fd.id.token] = g
          },
          _ => finits[fd.id.token] = nil,
        }
      }
      classes["{f}/{d.id.token}"] = {
        name: d.id.token,
        ctors: ctors,
        methods: methods,
        synth: synth,
        smeths: smeths,
        finits: finits,
        fields: d.fields,
        getters: d.getters,
        sfields: d.sfields,
        is_value: is_value,
        derives: derives,
        decos: decos,
        tparams: d.tparams,
      }
    }
    if s.name == 'fn_decl' {
      let d = fn_decl_parts(s)
      if d.decos.size() > 0 {
        # a decorated fn is a value binding; handled in order below
      } else {
        if scope_stack[f][scope_stack[f].size() - 1].map.has(d.id.token) {
          fail(d.id, "'{d.id.token}' is already defined")
        }
        let is_gen = has_yield_stmts(d.blk)
        if is_gen && funcs[f].named.has(d.id.token) {
          fail(
            d.id,
            "generator fn '{d.id.token}' cannot have multiple definitions",
          )
        }
        if funcs[f].named.has(d.id.token) {
          let fam = funcs[f].named[d.id.token]
          if funcs[fam[0]].gen_raw != nil {
            fail(
              d.id,
              "generator fn '{d.id.token}' cannot have multiple definitions",
            )
          }
        }
        # A generator declaration becomes two functions: the visible one
        # keeps the name, the params, and every dispatch behavior, and its
        # (synthesized) body just calls the hidden raw generator -- a child
        # function holding the real statements -- and wraps the activation
        # in the iterator-protocol object. Every existing call and
        # fn-as-value site then works untouched.
        cond {
          is_gen => {
            let g = new_func(f, d.id.token, [], 'w:' + pkey(d.blk))
            let rw = new_func(g, d.id.token, d.blk.nodes, pkey(d.blk))
            funcs[g]['gen_raw'] = rw
            funcs[rw]['is_gen'] = true
            funcs[f].named[d.id.token] = [g]
          },
          _ => {
            let g = new_func(f, d.id.token, d.blk.nodes, pkey(d.blk))
            if d.ret != nil {
              funcs[g]['ret'] = d.ret
            }
            cond {
              funcs[f].named.has(d.id.token) => funcs[f].named[d.id.token].push(g),
              _ => funcs[f].named[d.id.token] = [g],
            }
          },
        }
      }
    }
  }
  let cur = scope_cursor(f)
  cur[0] = stmts
  mut si = 0
  while si < stmts.size() {
    let s = stmts[si]
    cur[1] = si
    cond {
      s.name == 'trait_d' => {
        mut i = 1
        while i < s.nodes.size() {
          let it = method_parts(s.nodes[i])
          if it.blk != nil {
            let g = closure_of[pkey(s.nodes[i])]
            walk_method(g, it.prms.nodes)
          }
          i = i + 1
        }
      },
      s.name == 'class_d' => {
        let d = class_parts(s)
        let ci = classes["{f}/{d.id.token}"]
        cur_tparams = ci.tparams
        for mn in d.methods {
          let it = method_parts(mn)
          walk_method(closure_of[pkey(mn)], it.prms.nodes)
        }
        if ci.synth != nil {
          walk_method(ci.synth, [])
        }
        for mn in d.smethods {
          let it = method_parts(mn)
          walk_fn(closure_of[pkey(mn)], it.prms.nodes)
        }
        cur_tparams = []
        for fd in d.fields {
          if fd.init != nil {
            walk_fn(ci.finits[fd.id.token], [])
          }
        }
        for sf in d.sfields {
          scan_expr(sf.nodes[1], f)
        }
        for dn in ci.decos {
          let r = resolve(f, dn.nodes[0].token)
          if r.kind == 'none' {
            fail(dn.nodes[0], "undefined name '{dn.nodes[0].token}'")
          }
          note_deco(dn, f, r)
          if dn.nodes.size() == 2 {
            for a in dn.nodes[1].nodes {
              scan_expr(arg_val(a), f)
            }
          }
        }
      },
      s.name == 'fn_decl' => {
        let d = fn_decl_parts(s)
        cond {
          d.decos.size() > 0 => scan_decorated(s, d, f),
          _ => {
            # walk each overload exactly once, in registration order
            let lst = funcs[f].named[d.id.token]
            let g = lst[deco_walked_index(f, d.id.token)]
            cur_tparams = d.tparams
            walk_fn(g, d.prms.nodes)
            cur_tparams = []
            # the raw generator walks after its wrapper: the wrapper's own
            # scopes are closed by then, so the raw's params -- the same
            # names -- do not trip the cross-function shadow check
            let rw = funcs[g].gen_raw
            if rw != nil {
              walk_gen_raw(rw, d.prms.nodes)
            }
          },
        }
      },
      _ => {
        if s.name == 'defer_s' {
          has_defer = true
        }
        scan_stmt(s, f)
      },
    }
    si = si + 1
  }
  has_defer
}

# Which overload of `name` in `f` walks next: a cursor per (f, name).
# class registry: "f/Name" -> {name, ctor: func idx, methods: {name: idx},
# marities: {name: arity}}; traits: "Name" -> {required: [(name, arity)],
# defaults: {name: func idx}, darities: {name: arity}} (traits are global --
# culebra's are file-scope declarations)
mut classes = {}
mut traits = {}

mut walk_cursor = {}
fn deco_walked_index(f, name) {
  let k = "{f}/{name}"
  let i = walk_cursor.get(k, 0)
  walk_cursor[k] = i + 1
  i
}

# The literal a typed field without an initializer starts from.
fn type_zero(tname, at) {
  fn leaf(name, token) {
    let n = synth(name, [], at)
    n['token'] = token
    n
  }
  cond {
    tname == 'Long' => leaf('number', '0'),
    tname == 'Float' => leaf('float', '0.0'),
    tname == 'String' => leaf('str_sq', ''),
    tname == 'Bool' => synth('false_l', [], at),
    tname == 'Array' => synth('array_lit', [], at),
    tname == 'Object' => synth('object_lit', [], at),
    _ => nil,
  }
}

fn class_parts(s) {
  mut i = 0
  mut decos = []
  while s.nodes[i].name == 'deco' {
    decos.push(s.nodes[i])
    i = i + 1
  }
  mut methods = []
  mut getters = []
  mut smethods = []
  mut sfields = []
  mut fields = []
  mut tparams = []
  mut j = i + 1
  while j < s.nodes.size() {
    let mem = s.nodes[j]
    cond {
      # type parameters are documentation: the runtime sees them as Any
      mem.name == 'tparams' => {
        for tp in mem.nodes {
          tparams.push(tp.nodes[0].token)
        }
      },
      mem.name == 'method' => methods.push(mem),
      mem.name == 'getter' => {
        methods.push(mem.nodes[0])
        getters.push(mem.nodes[0].nodes[0].token)
      },
      mem.name == 'static_m' => smethods.push(mem.nodes[0]),
      mem.name == 'static_f' => sfields.push(mem),
      mem.name == 'field' => {
        mut init = nil
        mut ty = nil
        for part in mem.nodes {
          if part.name == 'finit' {
            init = part.nodes[0]
          }
          if part.name == 'ftype' {
            ty = part.nodes[0]
          }
        }
        if init == nil && ty != nil && ty.name == 'ident' {
          init = type_zero(ty.token, mem.nodes[0])
        }
        fields.push({id: mem.nodes[0], init: init})
      },
      _ => fail(mem, 'unsupported class member'),
    }
    j = j + 1
  }
  {
    id: s.nodes[i],
    methods: methods,
    getters: getters,
    smethods: smethods,
    sfields: sfields,
    fields: fields,
    decos: decos,
    tparams: tparams,
  }
}

# A method walks like a function whose first parameter is `self`.
fn walk_method(g, param_nodes) {
  enter_scope(g)
  declare_self(g)
  for pn in param_nodes {
    let rec = param_record(pn)
    if rec.marker == 'kwonly' {
      funcs[g]['kwonly_from'] = funcs[g].pspecs.size()
      continue
    }
    declare_var(g, rec.pname, false, rec.id)
    funcs[g].params.push(rec.pname)
    funcs[g].pspecs.push(rec)
  }
  erase_tparams(g)
  setup_rest(g)
  for rec in funcs[g].pspecs {
    if rec.dflt != nil {
      scan_expr(rec.dflt, g)
    }
  }
  hoist_bare(g, funcs[g].stmts)
  let base = nslots[g]
  let has_defer = scan_body_stmts(g, funcs[g].stmts, funcs[g].body_key)
  leave_scope(g)
  block_info[funcs[g].body_key] = {base: base, high: nslots[g]}
}

fn declare_self(g) {
  let scopes = scope_stack[g]
  scopes[scopes.size() - 1].map['self'] = (nslots[g], false)
  resolved["self/{g}"] = {kind: 'var', owner: g, slot: nslots[g], is_mut: false}
  nslots[g] = nslots[g] + 1
  funcs[g].params.push('self')
  funcs[g].pspecs.push({
    pname: 'self',
    ty: nil,
    dflt: nil,
    rest: false,
    id: nil,
  })
}

fn scan_decorated(s, d, f) {
  # each decorator must resolve to something callable
  for dn in d.decos {
    let r = resolve(f, dn.nodes[0].token)
    if r.kind == 'none' {
      fail(dn.nodes[0], "undefined name '{dn.nodes[0].token}'")
    }
    note_deco(dn, f, r)
    if dn.nodes.size() == 2 {
      for a in dn.nodes[1].nodes {
        scan_expr(arg_val(a), f)
      }
    }
  }
  # the wrapped closure: letrec -- the body may name itself
  declare_var(f, d.id.token, false, d.id)
  let g = new_func(f, d.id.token, d.blk.nodes, pkey(d.blk))
  closure_of[pkey(s)] = g
  walk_fn(g, d.prms.nodes)
}

fn note_deco(dn, f, r) {
  resolved[pkey(dn.nodes[0])] = r
  if r.kind == 'var' {
    frames.use(f, r.owner, r.slot)
  }
  if r.kind == 'fn' {
    for g in r.funcs {
      frames.note_call(f, g)
    }
  }
}

# The function's own top scope: params, then its body statements. The body
# block wraps in a Scope when it declares anything beyond the params or
# registers defers (params stay outside the range -- they live as long as
# the frame).
# Whether a subtree names `self` anywhere -- nested closures included,
# since an inner closure's `self` falls back to the enclosing one's.
# Whether a statement list names `name` directly (nested functions have
# their own).
fn mentions_name(stmts, name) {
  for st in stmts {
    if mentions_name_in(st, name) {
      return true
    }
  }
  false
}

fn mentions_name_in(node, name) {
  if node.name == 'ident' && node.token == name {
    return true
  }
  if node.nodes == nil {
    return false
  }
  if is_fn_boundary(node.name) {
    return false
  }
  for c in node.nodes {
    if mentions_name_in(c, name) {
      return true
    }
  }
  false
}

fn mentions_self(node) {
  if node.name == 'ident' {
    if node.token == 'self' {
      return true
    }
  }
  if node.nodes != nil {
    for c in node.nodes {
      if mentions_self(c) {
        return true
      }
    }
  }
  false
}

fn walk_fn(f, param_nodes) {
  enter_scope(f)
  if self_closure.has(f) {
    # the hidden receiver parameter sits in front of the declared ones
    declare_var(f, '__selfp', false, synth('ident', [], funcs[f].stmts[0]))
    funcs[f].params.push('__selfp')
    funcs[f].pspecs.push({
      pname: '__selfp',
      ty: nil,
      dflt: nil,
      rest: false,
      id: nil,
    })
  }
  for p in param_nodes {
    let rec = param_record(p)
    if rec.marker == 'kwonly' {
      funcs[f]['kwonly_from'] = funcs[f].pspecs.size()
      continue
    }
    declare_var(f, rec.pname, false, rec.id)
    funcs[f].params.push(rec.pname)
    funcs[f].pspecs.push(rec)
  }
  erase_tparams(f)
  # a closure body naming __ARGS__ takes eight hidden trailing parameters,
  # which the prologue trims to the positionals that overflowed
  if fn_pos.has(f) && mentions_name(funcs[f].stmts, '__ARGS__') {
    let at = synth('ident', [], funcs[f].stmts[0])
    let first = funcs[f].params.size()
    for k in range(8) {
      push_hidden(f, "\x01a{k}", at)
    }
    let slot = declare_var(f, '__ARGS__', false, at)
    args_info[f] = {slot: slot, first: first, count: 8}
  }
  setup_rest(f)
  # a default's expression binds in the callee, after the params before it
  for rec in funcs[f].pspecs {
    if rec.dflt != nil {
      scan_expr(rec.dflt, f)
    }
    if rec.destr != nil {
      for id in rec.destr.nodes {
        declare_var(f, id.token, false, id)
      }
    }
  }
  if self_closure.has(f) {
    # `self` is a local the prologue fills: the supplied receiver, or the
    # enclosing function's `self` when the call supplied none
    self_slot[f] = declare_var(
      f,
      'self',
      false,
      synth('ident', [], funcs[f].stmts[0]),
    )
    let outer = self_closure[f]
    if outer.kind == 'var' {
      frames.use(f, outer.owner, outer.slot)
    }
  }
  hoist_bare(f, funcs[f].stmts)
  let base = nslots[f]
  let has_defer = scan_body_stmts(f, funcs[f].stmts, funcs[f].body_key)
  leave_scope(f)
  block_info[funcs[f].body_key] = {base: base, high: nslots[f]}
}

# The raw generator's walk: params redeclare by name only (the wrapper
# already owns the default expressions and the dispatch surface; the raw
# body receives every argument resolved), then the body as usual.
fn walk_gen_raw(f2, param_nodes) {
  enter_scope(f2)
  for p in param_nodes {
    let rec = param_record(p)
    if rec.marker == 'kwonly' {
      continue
    }
    declare_var(f2, rec.pname, false, rec.id)
    funcs[f2].params.push(rec.pname)
    funcs[f2].pspecs.push({
      pname: rec.pname,
      ty: nil,
      dflt: nil,
      rest: false,
      id: rec.id,
    })
  }
  hoist_bare(f2, funcs[f2].stmts)
  let base = nslots[f2]
  let has_defer = scan_body_stmts(f2, funcs[f2].stmts, funcs[f2].body_key)
  leave_scope(f2)
  block_info[funcs[f2].body_key] = {base: base, high: nslots[f2]}
}

# A block's statements in order, the scope cursor following along so a
# nested function can find a later declaration; answers whether a defer
# was registered.
fn scan_stmts_tracked(stmts, f) {
  mut has_defer = false
  let cur = scope_cursor(f)
  cur[0] = stmts
  mut si = 0
  while si < stmts.size() {
    mut s = stmts[si]
    cur[1] = si
    if s.name == 'fn_decl' {
      # a fn declared inside a block is that block's binding of a closure
      # literal (culebra scopes it to the block); the statement list keeps
      # the desugared form for the emitter
      let d = fn_decl_parts(s)
      if d.decos.size() > 0 {
        fail(
          s,
          "a decorated fn declaration is only allowed at a function's top level",
        )
      }
      mut cn = [d.prms]
      if d.ret != nil {
        cn.push(d.ret)
      }
      cn.push(d.blk)
      let clo = {
        name: 'closure',
        nodes: cn,
        line: s.line,
        column: s.column,
        key: pkey(s),
      }
      s = {
        name: 'decl',
        nodes: [
          {
            name: 'decl_kw',
            token: 'let',
            line: s.line,
            column: s.column,
            key: pkey(s) + '/k',
          },
          d.id,
          clo,
        ],
        line: s.line,
        column: s.column,
        key: pkey(s) + '/d',
      }
      stmts[si] = s
    }
    if s.name == 'defer_s' {
      has_defer = true
    }
    scan_stmt(s, f)
    si = si + 1
  }
  has_defer
}

fn scan_block(blk, f) {
  enter_scope(f)
  let base = nslots[f]
  mut has_defer = false
  has_defer = scan_stmts_tracked(blk.nodes, f)
  leave_scope(f)
  block_info[pkey(blk)] = {base: base, high: nslots[f]}
}

fn is_mut_kw(tok) {
  tok != 'let'
}

# `x = v` with no binding in sight declares x in the function's own
# scope (immutably); every such name is declared at function entry so the
# slot lives outside any block's range.
# Node kinds that begin another function's body: a walk of "this
# function's own statements" stops at them.
fn is_fn_boundary(n) {
  n == 'closure' ||
    n == 'lambda' ||
    n == 'fn_decl' ||
    n == 'class_d' ||
    n == 'trait_d' ||
    n == 'defer_s' ||
    n == 'method'
}

fn collect_bare(node, out) {
  if node.nodes == nil {
    return nil
  }
  if is_fn_boundary(node.name) {
    return nil
  }
  let n = node.name
  if n == 'assign' {
    let lhs = node.nodes[0]
    if lhs.name == 'ident' && node.nodes[1].token == '=' {
      out.push(lhs)
    }
  }
  # a pattern assignment's plain names bind the same way
  if n == 'passign' && node.nodes[1].token == '=' {
    tpat_idents(node.nodes[0], out)
  }
  for c in node.nodes {
    collect_bare(c, out)
  }
  nil
}

fn tpat_idents(p, out) {
  cond {
    p.name == 'arr_t' || p.name == 'tup_t' => {
      for e in p.nodes {
        tpat_idents(e, out)
      }
    },
    p.name == 'obj_t' => {
      for e in p.nodes {
        cond {
          e.nodes.size() == 2 => tpat_idents(e.nodes[1], out),
          _ => out.push(e.nodes[0]),
        }
      }
    },
    p.name == 'rest_pt' || p.name == 'typed_t' => out.push(p.nodes[0]),
    p.name == 'ident' => out.push(p),
    _ => nil,
  }
  nil
}

fn declares_name(node, name) {
  if node.nodes == nil {
    return false
  }
  if is_fn_boundary(node.name) {
    return false
  }
  let n = node.name
  if n == 'decl' || n == 'pdecl' {
    if decl_of(node, name) != nil {
      return true
    }
  }
  for c in node.nodes {
    if declares_name(c, name) {
      return true
    }
  }
  false
}

fn hoist_bare(f, stmts) {
  mut out = []
  for st in stmts {
    collect_bare(st, out)
  }
  for lhs in out {
    mut r = resolve(f, lhs.token)
    # a name an enclosing scope declares further on is that binding
    # (culebra resolves the assignment when the closure runs)
    if r.kind == 'none' {
      let fr = forward_declare(f, lhs.token)
      if fr != nil {
        r = fr
      }
    }
    if r.kind == 'none' {
      mut later = false
      for st in stmts {
        if declares_name(st, lhs.token) {
          later = true
        }
      }
      let scopes = scope_stack[f]
      if !later && !scopes[scopes.size() - 1].map.has(lhs.token) {
        let slot = declare_var(f, lhs.token, false, synth('ident', [], lhs))
        bare_init["{f}/{slot}"] = true
      }
    }
  }
  nil
}

fn is_str_key(k) {
  k.name == 'ident' ||
    k.name == 'pname' ||
    k.name == 'str_sq' ||
    k.name == 'dq_key'
}

fn scan_target(t, f) {
  cond {
    t.name == 'ident' => {
      let r = resolve(f, t.token)
      if r.kind == 'none' {
        fail(t, "undefined variable '{t.token}'")
      }
      if r.kind != 'var' {
        fail(t, "cannot assign to '{t.token}'")
      }
      if !r.is_mut {
        let bk = "{r.owner}/{r.slot}"
        cond {
          bare_init.has(bk) => bare_init.remove(bk),
          # a captured immutable is refused when the write runs
          r.owner != f => runtime_immut[pkey(t)] = true,
          _ => fail(t, "cannot assign to immutable '{t.token}'"),
        }
      }
      note_use(t, f, r)
    },
    t.name == 'postfix' => {
      scan_expr(t.nodes[0], f)
      mut i = 1
      while i < t.nodes.size() {
        let step = t.nodes[i]
        if step.name == 'subscript' {
          scan_expr(step.nodes[0], f)
        }
        if step.name == 'mcall' {
          fail(step, 'cannot assign to a call')
        }
        i = i + 1
      }
    },
    _ => fail(t, 'cannot assign to this expression'),
  }
}

fn scan_stmt(node, f) {
  match node {
    {name: 'fn_decl'} => fail(
      node,
      "fn declarations are only allowed at a function's top level",
    ),
    {name: 'decl', nodes: [kw, pat, value]} => {
      # a closure initializer sees its own binding (culebra's letrec shape;
      # the cell->closure->cell cycle it can build now falls to the
      # backstop); everything else binds after its initializer
      let letrec = pat.name == 'ident' &&
        (value.name == 'closure' || value.name == 'lambda')
      if letrec {
        declare_var(f, pat.token, is_mut_kw(kw.token), pat)
        # the closure may name itself through `fn`: its scan picks the
        # binding up before walking the body
        pending_own = resolved[pkey(pat)]
        scan_expr(value, f)
        pending_own = nil
      } else {
        scan_expr(value, f)
        cond {
          pat.name == 'tup_pat' || pat.name == 'arr_pat' => {
            new_scratch(f, pat)
            for id in pat.nodes {
              declare_var(f, id.token, is_mut_kw(kw.token), id)
            }
          },
          _ => declare_var(f, pat.token, is_mut_kw(kw.token), pat),
        }
      }
    },
    {name: 'pdecl', nodes: [kw, pat, value]} => {
      scan_expr(value, f)
      new_scratch(f, node)
      pat_mut = is_mut_kw(kw.token)
      scan_pattern(pat, f)
      pat_mut = false
    },
    # an assignment used as an expression, and the `mut o[k] = v` store:
    # the same assignment, scanned through a stand-in node that shares the
    # original's position key (its result slot is keyed separately)
    {name: 'assign_e'} => {
      scan_stmt(synth_assign(node, false), f)
      new_scratch_key(f, pkey(node) + '/r')
    },
    {name: 'mut_store'} => scan_stmt(synth_assign(node, true), f),
    {name: 'passign'} => scan_passign(node, f),
    {name: 'assign', nodes: [lhs, op, value]} => {
      scan_expr(value, f)
      cond {
        lhs.name == 'ident' => {
          let r = resolve(f, lhs.token)
          if r.kind == 'none' {
            fail(lhs, "undefined variable '{lhs.token}'")
          }
          if r.kind == 'class' {
            fail(lhs, "cannot assign to class '{lhs.token}'")
          }
          if r.kind == 'fn' {
            fail(lhs, "cannot assign to fn '{lhs.token}'")
          }
          if !r.is_mut {
            let bk = "{r.owner}/{r.slot}"
            cond {
              # a bare binding's first write is its initialization
              bare_init.has(bk) && op.token == '=' => bare_init.remove(bk),
              # culebra reports a write to a captured immutable, or to
              # self, when it runs
              r.owner != f ||
                lhs.token == 'self' => runtime_immut[pkey(lhs)] = true,
              _ => fail(lhs, "cannot assign to immutable '{lhs.token}'"),
            }
          }
          note_use(lhs, f, r)
        },
        # (a, b) = ..., [p, q] = ..., {g, h} = ...: every target as it
        # would be on its own, written after the whole right side
        lhs.name == 'tuple' ||
          lhs.name == 'array_lit' ||
          lhs.name == 'shorthand' => {
          new_scratch(f, node)
          for t in lhs.nodes {
            scan_target(t, f)
          }
        },
        # a[k] = v / o.k = v: the receiver chain is an expression; the last
        # step is the write target
        lhs.name == 'postfix' => {
          let last = lhs.nodes[lhs.nodes.size() - 1]
          if last.name == 'mcall' {
            fail(last, 'cannot assign to a call')
          }
          if op.token != '=' {
            new_scratch(f, op)   # holds the receiver
            new_scratch(f, lhs)  # holds the key
            # ??= reads once: the current value decides whether to store
            if op.token == '??=' {
              new_scratch_key(f, pkey(op) + '/n')
            }
          }
          scan_expr(lhs.nodes[0], f)
          mut i = 1
          while i < lhs.nodes.size() {
            let step = lhs.nodes[i]
            if step.name == 'subscript' {
              scan_expr(step.nodes[0], f)
            }
            if step.name == 'mcall' {
              if i < lhs.nodes.size() - 1 {
                for a in step.nodes[1].nodes {
                  scan_expr(a, f)
                }
              }
            }
            i = i + 1
          }
        },
        _ => fail(lhs, 'cannot assign to this expression'),
      }
    },
    {name: 'for', nodes: [pat, iterable, body]} => {
      scan_expr(iterable, f)
      # the iterable and the iterator live across the loop in two adjacent
      # slots (released in that order at the statement's end); a third
      # holds an error while the iterator is closed on the way out
      new_scratch_key(f, pkey(node) + '/src')
      new_scratch(f, node)
      new_scratch_key(f, pkey(node) + '/e')
      enter_scope(f)
      let base = nslots[f]
      cond {
        pat.name == 'tup_pat' || pat.name == 'arr_pat' => for id in pat.nodes {
          declare_var(f, id.token, false, id)
        },
        _ => declare_var(f, pat.token, false, pat),
      }
      loop_depth[f] = loop_depth[f] + 1
      mut has_defer = false
      has_defer = scan_stmts_tracked(body.nodes, f)
      loop_depth[f] = loop_depth[f] - 1
      leave_scope(f)
      block_info[pkey(body)] = {base: base, high: nslots[f]}
    },
    {name: 'while', nodes: [cnd, body]} => {
      scan_expr(cnd, f)
      loop_depth[f] = loop_depth[f] + 1
      scan_block(body, f)
      loop_depth[f] = loop_depth[f] - 1
    },
    {name: 'yield_v', nodes: [e]} => {
      if funcs[f].is_gen != true {
        fail(
          node,
          "yield can only appear inside a named fn declaration (a lambda, closure, method, or defer body cannot be a generator)",
        )
      }
      scan_expr(e, f)
    },
    {name: 'yield_f', nodes: [e]} => {
      if funcs[f].is_gen != true {
        fail(
          node,
          "yield can only appear inside a named fn declaration (a lambda, closure, method, or defer body cannot be a generator)",
        )
      }
      scan_expr(e, f)
      new_scratch(f, node)  # the delegated-to iterator lives across the loop
    },
    {name: 'break_s'} => {
      if loop_depth[f] == 0 {
        fail(node, "'break' outside a loop")
      }
    },
    {name: 'continue_s'} => {
      if loop_depth[f] == 0 {
        fail(node, "'continue' outside a loop")
      }
    },
    {name: 'return_s'} => {
      if node.nodes.size() == 1 {
        scan_expr(node.nodes[0], f)
      }
    },
    {name: 'throw_s', nodes: [value]} => scan_expr(value, f),
    {name: 'defer_s', nodes: [blk]} => {
      let g = new_func(
        f,
        "defer@{node.line}:{node.column}",
        blk.nodes,
        pkey(blk),
      )
      closure_of[pkey(node)] = g
      let saved = loop_depth[f]
      walk_fn(g, [])
      loop_depth[f] = saved
    },
    {name: 'bare_block', nodes: [blk]} => scan_block(blk, f),
    _ => scan_expr(node, f),
  }
}

fn scan_if(node, f) {
  scan_expr(node.nodes[0], f)
  scan_block(node.nodes[1], f)
  if node.nodes.size() == 3 {
    let alt = node.nodes[2]
    if alt.name == 'if' {
      scan_if(alt, f)
    } else {
      scan_block(alt, f)
    }
  }
}

fn scan_try(node, f) {
  let [body, id, handler] = node.nodes
  scan_block(body, f)
  enter_scope(f)
  let caught = declare_var(f, id.token, false, id)
  mut has_defer = false
  for s in handler.nodes {
    if s.name == 'fn_decl' {
      fail(s, "fn declarations are only allowed at a function's top level")
    }
    if s.name == 'defer_s' {
      has_defer = true
    }
    scan_stmt(s, f)
  }
  leave_scope(f)
  block_info[pkey(handler)] = {base: caught, high: nslots[f]}  # owns the caught slot
}

fn scan_call(node, f) {
  let [id, args] = node.nodes
  for a in args.nodes {
    scan_expr(arg_val(a), f)
  }
  if id.token == 'println' || id.token == 'print' {
    if args.nodes.size() != 1 {
      fail(id, "{id.token} takes 1 argument")
    }
    return nil
  }
  # a built-in's arity is checked when the call runs (culebra's ArityError
  # is catchable), so the scan only notes the arguments
  if !in_prelude && builtins.has(id.token) {
    return nil
  }
  if in_prelude {
    if intrinsics.has(id.token) {
      let (_, arity) = intrinsics[id.token]
      if args.nodes.size() != arity {
        fail(id, "{id.token} takes {arity} argument(s)")
      }
      return nil
    }
    if id.token == '__error' {
      if args.nodes.size() != 4 {
        fail(id, '__error takes 4 arguments')
      }
      return nil
    }
    if id.token == '__allbytes' {
      if args.nodes.size() != 0 {
        fail(id, '__allbytes takes no arguments')
      }
      return nil
    }
  }
  let r = resolve(f, id.token)
  cond {
    r.kind == 'none' => {
      let fr = forward_declare(f, id.token)
      if fr == nil {
        fail(id, "undefined name '{id.token}'")
      }
      note_use(id, f, fr)
    },
    r.kind == 'class' => {
      resolved[pkey(id)] = r
      frames.use(f, r.owner, r.slot)
    },
    r.kind == 'fn' => {
      resolved[pkey(id)] = r
      for g in r.funcs {
        frames.note_call(f, g)
      }
      # multimethod / kwargs / defaults sites hold each argument in its own
      # slot while the dispatch tests run
      if needs_dispatch(r.funcs, args) {
        for a in args.nodes {
          new_scratch(f, arg_val(a))
        }
      }
    },
    _ => note_use(id, f, r),  # a closure value being called
  }
}

fn arg_val(a) {
  cond {
    a.name == 'kwarg' => a.nodes[1],
    a.name == 'kwsplat' => a.nodes[0],
    _ => a,
  }
}

fn kwarg_name(a) {
  cond {
    a.name == 'kwarg' => a.nodes[0].token,
    _ => nil,
  }
}

# The old direct emission survives for the plain shape: one overload, no
# types, defaults, or rest, all-positional call at exact arity.
fn needs_dispatch(fns, args) {
  if fns.size() != 1 {
    return true
  }
  let specs = funcs[fns[0]].pspecs
  for a in args.nodes {
    if a.name == 'kwarg' {
      return true
    }
  }
  for rec in specs {
    if rec.ty != nil {
      return true
    }
    if rec.dflt != nil {
      return true
    }
    if rec.rest {
      return true
    }
  }
  args.nodes.size() != specs.size()
}

# Chained comparisons: every middle operand is held in a scratch slot while
# the rest of the chain evaluates. Short-circuit || and &&: the left value
# is held across the decision. Each op token gets its own slot -- a few
# extra locals beat a lifetime analysis.
# match: three slots per site (subject, matched, result); each arm opens a
# scope for its bindings, whose block_info drives the emitter like any
# other block.
fn scan_match(node, f) {
  scan_expr(node.nodes[0], f)
  new_scratch(f, node)           # subject
  new_scratch(f, node.nodes[0])  # matched flag
  new_scratch(f, node.nodes[1])  # result
  mut i = 1
  while i < node.nodes.size() {
    scan_arm(node.nodes[i], f)
    i = i + 1
  }
}

fn scan_arm(arm, f) {
  enter_scope(f)
  let base = nslots[f]
  scan_pattern(arm.nodes[0], f)
  mut i = 1
  while i < arm.nodes.size() {
    let piece = arm.nodes[i]
    cond {
      piece.name == 'guard' => scan_expr(piece.nodes[0], f),
      piece.name == 'block' => {
        # the arm body block scans inside the arm scope so bindings resolve;
        # it wraps itself as usual
        scan_block(piece, f)
      },
      _ => scan_expr(piece, f),
    }
    i = i + 1
  }
  leave_scope(f)
  block_info[pkey(arm)] = {base: base, high: nslots[f]}
}

fn scan_pattern(pat, f) {
  match pat {
    {name: 'bind_p', nodes: [id]} => declare_var(f, id.token, pat_mut, id),
    {
      name: 'typed_pt',
      nodes: [id, ty],
    } => declare_var(f, id.token, pat_mut, id),
    {name: 'rest_pt', nodes: [id]} => declare_var(f, id.token, pat_mut, id),
    {name: 'obj_p'} => {
      for op in pat.nodes {
        cond {
          op.nodes.size() == 2 => scan_pattern(op.nodes[1], f),
          _ => declare_var(f, op.nodes[0].token, pat_mut, op.nodes[0]),
        }
      }
    },
    {name: 'arr_p'} => {
      for sp in pat.nodes {
        scan_pattern(sp, f)
      }
    },
    {name: 'tup_p'} => {
      for sp in pat.nodes {
        scan_pattern(sp, f)
      }
    },
    _ => nil,
  }
}

fn scan_cond(node, f) {
  new_scratch(f, node)           # matched flag
  new_scratch(f, node.nodes[0])  # result
  for carm in node.nodes {
    let head = carm.nodes[0]
    if head.name != 'wild_p' {
      scan_expr(head, f)
    }
    let body = carm.nodes[1]
    cond {
      body.name == 'block' => scan_block(body, f),
      _ => scan_expr(body, f),
    }
  }
}

fn scan_chain_ops(node, f, give_scratch) {
  let nodes = node.nodes
  scan_expr(nodes[0], f)
  mut i = 1
  while i < nodes.size() {
    if give_scratch {
      new_scratch(f, nodes[i])
    }
    scan_expr(nodes[i + 1], f)
    i = i + 2
  }
}

# UFCS: a .name(...) whose name is not a built-in method falls back to a
# free function in scope; note the resolution (and its scratches) now.
fn scan_mcall_target(step, f) {
  let name = step.nodes[0]
  if builtin_methods.contains(name.token) {
    return nil
  }
  # a global built-in (range, inspect, ...) takes the receiver as its first
  # argument, like any free function
  if !in_prelude && builtins.has(name.token) {
    resolved[pkey(name)] = {kind: 'bval', name: name.token}
    new_scratch(f, name)
    return nil
  }
  let r = resolve(f, name.token)
  if r.kind == 'fn' {
    resolved[pkey(name)] = r
    for g in r.funcs {
      frames.note_call(f, g)
    }
    # the receiver + each argument each hold a slot across dispatch
    new_scratch(f, name)
    for a in step.nodes[1].nodes {
      new_scratch(f, arg_val(a))
    }
  }
  # a variable holding a callable serves UFCS too; the receiver holds a
  # slot across the own-method test
  if r.kind == 'var' {
    note_use(name, f, r)
    new_scratch(f, name)
  }
}

fn scan_expr(node, f) {
  match node {
    {name: 'number'} => nil,
    {name: 'float'} => nil,
    {name: 'str_sq'} => nil,
    {name: 'str_dq'} => {
      for part in node.nodes {
        if part.name == 'interp' {
          scan_expr(part.nodes[0], f)
          # a format spec's own {field}s are expressions too
          if part.nodes.size() == 2 {
            for sp in part.nodes[1].nodes {
              if sp.name == 'spec_arg' {
                scan_expr(sp.nodes[0], f)
              }
            }
          }
        }
      }
    },
    {name: 'true_l'} => nil,
    {name: 'false_l'} => nil,
    {name: 'nil_l'} => nil,
    {name: 'ident', token} => {
      let r = resolve(f, token)
      # `String` names the namespace holding from_code_point & co
      if r.kind == 'none' && token == 'String' {
        resolved[pkey(node)] = {kind: 'strns'}
        return nil
      }
      # `GC` is the heap-introspection namespace (stat only)
      if r.kind == 'none' && token == 'GC' {
        resolved[pkey(node)] = {kind: 'gcns'}
        return nil
      }
      if r.kind == 'none' &&
          !in_prelude &&
          (builtins.has(token) || token == 'println' || token == 'print') {
        resolved[pkey(node)] = {kind: 'bval', name: token}
        return nil
      }
      if r.kind == 'none' {
        let fr = forward_declare(f, token)
        if fr != nil {
          note_use(node, f, fr)
          return nil
        }
      }
      if r.kind == 'none' {
        fail(node, "undefined variable '{token}'")
      }
      if r.kind == 'class' {
        resolved[pkey(node)] = {
          kind: 'var',
          owner: r.owner,
          slot: r.slot,
          is_mut: false,
        }
        frames.use(f, r.owner, r.slot)
        return nil
      }
      if r.kind == 'fn' {
        # a named fn used as a value closes over its captures here (the
        # self-cycle this can build now falls to the backstop); a whole
        # multimethod family travels as a family record that dispatches
        # when called
        resolved[pkey(node)] = r
        for g in r.funcs {
          frames.note_call(f, g)
        }
        return nil
      }
      note_use(node, f, r)
    },
    {name: 'call'} => scan_call(node, f),
    {name: 'assign_e'} => scan_stmt(node, f),
    {name: 'array_lit'} => {
      for e in node.nodes {
        cond {
          e.name == 'spread' => scan_expr(e.nodes[0], f),
          _ => scan_expr(e, f),
        }
      }
    },
    {name: 'spread'} => fail(
      node,
      'spread is only allowed inside an array literal',
    ),
    {name: 'range_lit', nodes} => {
      for c in nodes {
        cond {
          c.name == 'range_op' => nil,
          c.name == 'step' => scan_expr(c.nodes[0], f),
          _ => scan_expr(c, f),
        }
      }
    },
    {name: 'tuple'} => {
      for e in node.nodes {
        scan_expr(e, f)
      }
    },
    {name: 'shorthand'} => {
      for e in node.nodes {
        scan_expr(e, f)
      }
    },
    {name: 'fnself'} => {
      cond {
        own_binding.has(f) => note_use(node, f, own_binding[f]),
        funcs[f].is_named == true => {
          resolved[pkey(node)] = {kind: 'fn', funcs: [f]}
          frames.note_call(f, f)
        },
        _ => resolved[pkey(node)] = {kind: 'selfclosure'},
      }
    },
    {name: 'object_lit'} => {
      for pair in node.nodes {
        cond {
          pair.name == 'ospread' => scan_expr(pair.nodes[0], f),
          _ => {
            let k = pair.nodes[0]
            if !is_str_key(k) {
              scan_expr(k, f)
            }
            scan_expr(pair.nodes[1], f)
          },
        }
      }
    },
    {name: 'set_lit'} => {
      for e in node.nodes {
        scan_expr(e, f)
      }
    },
    {name: 'lambda', nodes: [prms, bodye]} => {
      let g = new_func(f, "fn@{node.line}:{node.column}", [bodye], pkey(node))
      closure_of[pkey(node)] = g
      fn_pos[g] = (node.line, node.column)
      if pending_own != nil {
        own_binding[g] = pending_own
        pending_own = nil
      }
      if mentions_self(bodye) {
        self_closure[g] = resolve(f, 'self')
      }
      let saved = loop_depth[f]
      walk_fn(g, prms.nodes)
      loop_depth[f] = saved
    },
    {name: 'closure', nodes} => {
      let prms = nodes[0]
      let blk = nodes[nodes.size() - 1]
      let g = new_func(f, "fn@{node.line}:{node.column}", blk.nodes, pkey(blk))
      closure_of[pkey(node)] = g
      fn_pos[g] = (node.line, node.column)
      if nodes.size() == 3 {
        funcs[g]['ret'] = nodes[1]
      }
      if pending_own != nil {
        own_binding[g] = pending_own
        pending_own = nil
      }
      if mentions_self(blk) {
        self_closure[g] = resolve(f, 'self')
      }
      let saved = loop_depth[f]
      walk_fn(g, prms.nodes)
      loop_depth[f] = saved
    },
    {name: 'if'} => scan_if(node, f),
    {name: 'try'} => scan_try(node, f),
    {name: 'neg', nodes: [operand]} => scan_expr(operand, f),
    {name: 'lnot', nodes: [operand]} => scan_expr(operand, f),
    {name: 'bnot', nodes: [operand]} => scan_expr(operand, f),
    {name: 'power', nodes} => {
      scan_expr(nodes[0], f)
      if nodes.size() == 3 {
        scan_expr(nodes[2], f)
      }
    },
    {name: 'postfix', nodes} => {
      scan_expr(nodes[0], f)
      mut i = 1
      while i < nodes.size() {
        let step = nodes[i]
        if step.name == 'subscript' {
          scan_expr(step.nodes[0], f)
        }
        if step.name == 'mcall' || step.name == 'nmcall' {
          for a in step.nodes[1].nodes {
            scan_expr(arg_val(a), f)
          }
          scan_mcall_target(step, f)
        }
        if step.name == 'nprop' || step.name == 'nmcall' {
          new_scratch(f, step)
        }
        if step.name == 'pcall' {
          for a in step.nodes[0].nodes {
            scan_expr(arg_val(a), f)
          }
        }
        i = i + 1
      }
    },
    {name: 'match'} => scan_match(node, f),
    {name: 'cond_e'} => scan_cond(node, f),
    {name: 'ternary', nodes} => {
      scan_expr(nodes[0], f)
      new_scratch(f, node)
      scan_expr(nodes[1], f)
      scan_expr(nodes[2], f)
    },
    {name: 'nilco'} => scan_chain_ops(node, f, true),
    {name: 'cmp'} => scan_chain_ops(node, f, true),
    {name: 'lor'} => scan_chain_ops(node, f, true),
    {name: 'land'} => scan_chain_ops(node, f, true),
    {name: 'bor'} => scan_chain_ops(node, f, false),
    {name: 'bxor'} => scan_chain_ops(node, f, false),
    {name: 'band'} => scan_chain_ops(node, f, false),
    {name: 'shift'} => scan_chain_ops(node, f, false),
    {name: 'add'} => scan_chain_ops(node, f, false),
    {name: 'mul'} => scan_chain_ops(node, f, false),
    _ => fail(node, "cannot evaluate {node.name}"),
  }
}

# --- Pass B: solve ------------------------------------------------------------
#
# Frames.solve (front.cul): a call from f to a named fn g builds g's capture
# map in f's frame; a function nested in p resolves its own map in p's frame.
# Whatever anyone captures, its owner keeps in a cell.

# A scratch slot's local index: appended after the named slots.
fn scratch_slot(f, k) {
  nslots[f] + k
}

# --- Pass C: emit -------------------------------------------------------------

# Raw IR fragments the lowering composes without prelude round-trips: the
# checks below only ever compare typeof (a string) against a literal, which
# the VM's own eq handles.
fn ir_typeof(m, v, at) {
  ir.intrinsic('typeof', [v], at)
}

fn ir_bool(m, v, at) {
  ir.bool_literal(v, at)
}

fn ir_and(m, a, b, at) {
  ir.land(a, b, at)
}

# A call to a prelude helper, with the user-site position threaded in. Pass C
# discovers prelude calls the scan didn't see (they come from the lowering
# itself); the prelude captures nothing, so no fixpoint re-run is needed.
fn call_pre(m, f, name, arg_ids, at) {
  ir.call(f, prelude_named[name], arg_ids, at)
}

# The prelude-only marks give the prelude bytes the surface language cannot
# spell: \z is 0x01 (the tuple/mut-metadata key prefix -- no user string can
# collide with it), \y/\x/\w are the UTF-8 lead-byte thresholds 0xC0 /
# 0xE0 / 0xF0 its code-point iterator compares against, and \q is the
# backtick (which would end the prelude's own raw string).
fn unescape(s) {
  mut out = ''
  mut i = 0
  while i < s.size() {
    let c = s.slice(i, i + 1)
    cond {
      c == "\\" && i + 1 < s.size() => {
        let d = s.slice(i + 1, i + 2)
        out = out + cond {
          d == 'n' => "\n",
          d == 't' => "\t",
          d == 'r' => "\r",
          in_prelude && d == 'z' => String.from_code_point(1),
          in_prelude && d == 'y' => String.from_bytes([192]),
          in_prelude && d == 'x' => String.from_bytes([224]),
          in_prelude && d == 'w' => String.from_bytes([240]),
          in_prelude && d == 'q' => String.from_code_point(96),
          _ => d,  # backslash, brace, quotes: the char itself
        }
        i = i + 2
      },
      _ => {
        out = out + c
        i = i + 1
      },
    }
  }
  out
}

fn parse_int_token(tok) {
  cond {
    tok.starts_with('0x') => to_long(tok.slice(2, tok.size()), base: 16),
    tok.starts_with('0b') => to_long(tok.slice(2, tok.size()), base: 2),
    tok.starts_with('0o') => to_long(tok.slice(2, tok.size()), base: 8),
    _ => to_long(tok),
  }
}

fn binop_prelude(tok) {
  cond {
    tok == '+' => '__add',
    tok == '-' => '__sub',
    tok == '*' => '__mul',
    tok == '/' => '__div',
    tok == '%' => '__mod',
    tok == '<' => '__lt',
    tok == '<=' => '__le',
    tok == '>' => '__gt',
    tok == '>=' => '__ge',
    tok == '&' => '__band',
    tok == '|' => '__bor',
    tok == '^' => '__bxor',
    tok == '<<' => '__shl',
    tok == '>>' => '__shr',
    tok == '**' => '__pow',
    _ => nil,
  }
}

fn binop_raw(tok) {
  cond {
    tok == '+' => 'add',
    tok == '-' => 'sub',
    tok == '*' => 'mul',
    tok == '/' => 'div',
    tok == '%' => 'mod',
    tok == '==' => 'eq',
    tok == '!=' => 'ne',
    tok == '<' => 'lt',
    tok == '<=' => 'le',
    tok == '>' => 'gt',
    tok == '>=' => 'ge',
    tok == '&' => 'bitand',
    tok == '|' => 'bitor',
    tok == '^' => 'bitxor',
    tok == '<<' => 'shl',
    _ => 'shr',
  }
}

fn pos_args(m, node) {
  (ir.literal(node.line, node), ir.literal(node.column, node))
}

# One binary application, per dialect: the prelude compiles the raw VM
# node; user code calls the prelude wrapper that implements culebra's rule.
# `at` is the operand chain's first node: culebra reports an operator's
# error at the expression's start, not at the operator.
fn emit_binop(m, f, tok, lhs_id, rhs_id, op_node, at) {
  if in_prelude || binop_prelude(tok) == nil {
    if tok == '==' || tok == '!=' {
      if !in_prelude {
        let e = call_pre(m, f, '__eq', [lhs_id, rhs_id], op_node)
        if tok == '==' {
          return e
        }
        return ir.make_if_else(
          e,
          ir.bool_literal(false, op_node),
          ir.bool_literal(true, op_node),
          op_node,
        )
      }
    }
    return ir.binary(binop_raw(tok), lhs_id, rhs_id, op_node)
  }
  let (ln, cl) = pos_args(m, at)
  call_pre(m, f, binop_prelude(tok), [lhs_id, rhs_id, ln, cl], op_node)
}

fn emit_left_chain(m, node, f) {
  let [head, ...pairs] = node.nodes
  mut value = emit_expr(m, head, f)
  for [op, rn] in pairs.iter().chunks(2) {
    let rhs = emit_expr(m, rn, f)
    value = emit_binop(m, f, op.token, value, rhs, op, head)
  }
  value
}

# a OP b OP c ...: strictly culebra -- each middle evaluates once, the
# chain short-circuits left to right. Lowered as nested ifs over scratch
# slots. Comparison results are real Bools, so the condition needs no
# truthiness call.
fn emit_cmp_chain(m, node, f) {
  let nodes = node.nodes
  if nodes.size() == 3 {
    let l = emit_expr(m, nodes[0], f)
    let r = emit_expr(m, nodes[2], f)
    return emit_cmp_one(m, f, nodes[1], l, r, nodes[0])
  }
  emit_cmp_rest(m, node, f, emit_expr(m, nodes[0], f), 1)
}

fn emit_cmp_rest(m, node, f, lhs_id, i) {
  let nodes = node.nodes
  let op = nodes[i]
  if i + 2 >= nodes.size() {
    let r = emit_expr(m, nodes[i + 1], f)
    return emit_cmp_one(m, f, op, lhs_id, r, nodes[0])
  }
  # middle operand: hold it, compare, and only then continue the chain
  let slot = scratch_slot(f, scratch_of[pkey(op)])
  let store = ir.store_local(slot, emit_expr(m, nodes[i + 1], f), op)
  let first = emit_cmp_one(m, f, op, lhs_id, ir.local(slot, op), nodes[0])
  let rest = emit_cmp_rest(m, node, f, ir.local(slot, op), i + 2)
  # block: [store]; value: if first { rest } else { false }
  let seq = ir.block([store], op)
  let cond_v = ir.make_if_else(first, rest, ir.bool_literal(false, op), op)
  ir.seq([seq], cond_v, op)
}

fn emit_cmp_one(m, f, op, l, r, at) {
  emit_binop(m, f, op.token, l, r, op, at)
}

# a && b  ->  t = a; if truthy(t) { b } else { t }
# a || b  ->  t = a; if truthy(t) { t } else { b }
fn emit_shortcircuit(m, node, f) {
  let [head, ...pairs] = node.nodes
  mut value = emit_expr(m, head, f)
  for [op, rn] in pairs.iter().chunks(2) {
    let slot = scratch_slot(f, scratch_of[pkey(op)])
    let store = ir.store_local(slot, value, op)
    let t = fn () {
      ir.local(slot, op)
    }
    let (pl, pc) = pos_args(m, op)
    let c = call_pre(m, f, '__truthy', [t(), pl, pc], op)
    let rhs = emit_expr(m, rn, f)
    let picked = cond {
      op.token == '&&' => ir.make_if_else(c, rhs, t(), op),
      _ => ir.make_if_else(c, t(), rhs, op),
    }
    value = ir.seq([store], picked, op)
  }
  value
}

# a ?? b: keep a unless it is nil. The slot is the op's scratch.
fn emit_nilco(m, node, f) {
  let [head, ...pairs] = node.nodes
  mut value = emit_expr(m, head, f)
  for [op, rn] in pairs.iter().chunks(2) {
    let slot = scratch_slot(f, scratch_of[pkey(op)])
    let store = ir.store_local(slot, value, op)
    fn tref() {
      ir.local(slot, op)
    }
    let isnil = ir.binary(
      'eq',
      ir_typeof(m, tref(), op),
      ir.str_literal('nil', op),
      op,
    )
    let picked = ir.make_if_else(isnil, emit_expr(m, rn, f), tref(), op)
    value = ir.seq([store], picked, op)
  }
  value
}

# One pattern, compiled to a test over `subj()` (a fresh reference each
# call) plus binding assignments run when the arm is taken. Sub-values are
# re-read through index chains -- pure reads, so repetition is safe.
fn emit_pat_test(m, f, pat, subj, at) {
  match pat {
    {name: 'wild_p'} => ir_bool(m, true, at),
    {name: 'bind_p'} => ir_bool(m, true, at),
    {name: 'rest_pt'} => ir_bool(m, true, at),
    {
      name: 'typed_pt',
      nodes: [id, ty],
    } => call_pre(
      m,
      f,
      '__pat_type',
      [subj(), ir.str_literal(ty.token, at)],
      at,
    ),
    {name: 'nil_p'} => ir.binary(
      'eq',
      ir_typeof(m, subj(), at),
      ir.str_literal('nil', at),
      at,
    ),
    {name: 'true_p'} => emit_pat_eq(m, f, subj, ir.bool_literal(true, at), at),
    {name: 'false_p'} => emit_pat_eq(
      m,
      f,
      subj,
      ir.bool_literal(false, at),
      at,
    ),
    {name: 'num_p'} => emit_pat_eq(
      m,
      f,
      subj,
      ir.literal(parse_int_token(pat.nodes[0].token), at),
      at,
    ),
    {name: 'float_p'} => emit_pat_eq(
      m,
      f,
      subj,
      ir.double_literal(to_float(pat.nodes[0].token), at),
      at,
    ),
    {name: 'str_p'} => emit_pat_eq(
      m,
      f,
      subj,
      ir.str_literal(pat.nodes[0].token, at),
      at,
    ),
    {name: 'obj_p'} => {
      mut t = ir.binary(
        'eq',
        ir_typeof(m, subj(), at),
        ir.str_literal('object', at),
        at,
      )
      for op in pat.nodes {
        let key = op.nodes[0].token
        let ha = []
        ha.push(subj())
        ha.push(ir.str_literal(key, at))
        let haskey = ir.intrinsic('objecthas', ha, at)
        t = ir_and(m, t, haskey, at)
        if op.nodes.size() == 2 {
          fn sub() {
            ir.index(subj(), ir.str_literal(key, at), at)
          }
          t = ir_and(m, t, emit_pat_test(m, f, op.nodes[1], sub, at), at)
        }
      }
      t
    },
    {name: 'arr_p'} => emit_seq_pat(m, f, pat, subj, 'array', at),
    {name: 'tup_p'} => {
      let items = fn () {
        call_pre(m, f, '__titems', [subj()], at)
      }
      let ist = call_pre(m, f, '__is_tuple', [subj()], at)
      ir_and(m, ist, emit_seq_items(m, f, pat, items, at), at)
    },
    _ => fail(pat, "unsupported pattern {pat.name}"),
  }
}

fn emit_pat_eq(m, f, subj, lit, at) {
  call_pre(m, f, '__eq', [subj(), lit], at)
}

fn emit_seq_pat(m, f, pat, subj, tyname, at) {
  let t = ir.binary(
    'eq',
    ir_typeof(m, subj(), at),
    ir.str_literal(tyname, at),
    at,
  )
  ir_and(m, t, emit_seq_items(m, f, pat, subj, at), at)
}

fn rest_index(pat) {
  mut i = 0
  while i < pat.nodes.size() {
    if pat.nodes[i].name == 'rest_pt' {
      return i
    }
    i = i + 1
  }
  0 - 1
}

fn seq_len(m, items, at) {
  let la = []
  la.push(items())
  ir.intrinsic('len', la, at)
}

# The item an element pattern reads: a fixed index before a rest, an
# index counted from the end after it.
fn seq_item(m, pat, items, idx, at) {
  let ri = rest_index(pat)
  let n = pat.nodes.size()
  cond {
    ri < 0 || idx < ri => ir.index(items(), ir.literal(idx, at), at),
    _ => ir.index(
      items(),
      ir.binary('sub', seq_len(m, items, at), ir.literal(n - idx, at), at),
      at,
    ),
  }
}

fn emit_seq_items(m, f, pat, items, at) {
  let n = pat.nodes.size()
  let ri = rest_index(pat)
  mut t = cond {
    ri < 0 => ir.binary('eq', seq_len(m, items, at), ir.literal(n, at), at),
    _ => ir.binary('ge', seq_len(m, items, at), ir.literal(n - 1, at), at),
  }
  mut i = 0
  while i < n {
    let idx = i
    if idx != ri {
      fn sub() {
        seq_item(m, pat, items, idx, at)
      }
      t = ir_and(m, t, emit_pat_test(m, f, pat.nodes[idx], sub, at), at)
    }
    i = i + 1
  }
  t
}

# Binding assignments for a taken arm, in pattern order.
fn emit_pat_binds(m, f, pat, subj, ids, at) {
  match pat {
    {name: 'bind_p', nodes: [id]} => {
      let r = resolved[pkey(id)]
      ids.push(ir.write(f, f, r.slot, subj(), id))
    },
    {name: 'typed_pt', nodes: [id, ty]} => {
      let r = resolved[pkey(id)]
      ids.push(ir.write(f, f, r.slot, subj(), id))
    },
    {name: 'obj_p'} => {
      for op in pat.nodes {
        let key = op.nodes[0].token
        fn sub() {
          ir.index(subj(), ir.str_literal(key, at), at)
        }
        cond {
          op.nodes.size() ==
            2 => emit_pat_binds(m, f, op.nodes[1], sub, ids, at),
          _ => {
            let r = resolved[pkey(op.nodes[0])]
            ids.push(ir.write(f, f, r.slot, sub(), at))
          },
        }
      }
    },
    {name: 'arr_p'} => emit_seq_binds(m, f, pat, subj, ids, at),
    {name: 'tup_p'} => {
      let items = fn () {
        call_pre(m, f, '__titems', [subj()], at)
      }
      emit_seq_binds(m, f, pat, items, ids, at)
    },
    _ => nil,
  }
}

fn emit_seq_binds(m, f, pat, items, ids, at) {
  let ri = rest_index(pat)
  let n = pat.nodes.size()
  mut i = 0
  while i < n {
    let idx = i
    cond {
      idx == ri => {
        let id = pat.nodes[idx].nodes[0]
        let r = resolved[pkey(id)]
        let rest = call_pre(
          m,
          f,
          '__slice_arr',
          [
            items(),
            ir.literal(idx, at),
            ir.binary(
              'sub',
              seq_len(m, items, at),
              ir.literal(n - 1 - idx, at),
              at,
            ),
          ],
          at,
        )
        ids.push(ir.write(f, f, r.slot, rest, id))
      },
      _ => {
        fn sub() {
          seq_item(m, pat, items, idx, at)
        }
        emit_pat_binds(m, f, pat.nodes[idx], sub, ids, at)
      },
    }
    i = i + 1
  }
}

fn emit_match(m, node, f) {
  let subj_slot = scratch_slot(f, scratch_of[pkey(node)])
  let flag_slot = scratch_slot(f, scratch_of[pkey(node.nodes[0])])
  let res_slot = scratch_slot(f, scratch_of[pkey(node.nodes[1])])
  fn subj() {
    ir.local(subj_slot, node)
  }
  mut ids = [
    ir.store_local(subj_slot, emit_expr(m, node.nodes[0], f), node),
    ir.store_local(flag_slot, ir_bool(m, false, node), node),
    ir.store_local(res_slot, ir.nil_literal(node), node),
  ]
  mut i = 1
  while i < node.nodes.size() {
    let arm = node.nodes[i]
    let pat = arm.nodes[0]
    mut guard = nil
    mut body = arm.nodes[arm.nodes.size() - 1]
    if arm.nodes.size() == 3 {
      guard = arm.nodes[1]
    }
    let notyet = ir.make_if_else(
      ir.local(flag_slot, node),
      ir_bool(m, false, node),
      emit_pat_test(m, f, pat, subj, node),
      node,
    )
    # taken: bindings, then guard, then body into the result
    mut arm_ids = []
    emit_pat_binds(m, f, pat, subj, arm_ids, node)
    let bodyv = cond {
      body.name == 'block' => emit_block(m, body, f),
      _ => emit_expr(m, body, f),
    }
    let take = ir.block(
      [
        ir.store_local(flag_slot, ir_bool(m, true, node), node),
        ir.store_local(res_slot, bodyv, node),
      ],
      node,
    )
    let guarded = cond {
      guard == nil => take,
      _ => {
        let (pl, pc) = pos_args(m, guard)
        let g0 = emit_expr(m, guard.nodes[0], f)
        let g = call_pre(m, f, '__truthy', [g0, pl, pc], node)
        ir.make_if(g, take, node)
      },
    }
    let info = block_info[pkey(arm)]
    let pre = fresh_cells(m, f, info.base, info.high, arm)
    let inner = ir.block(pre + arm_ids + [guarded], arm)
    let scoped = emit_scope_of(m, f, info.base, info.high, inner, arm)
    ids.push(ir.make_if(notyet, scoped, node))
    i = i + 1
  }
  ids.push(ir.local(res_slot, node))
  ir.block(ids, node)
}

fn emit_cond(m, node, f) {
  let flag_slot = scratch_slot(f, scratch_of[pkey(node)])
  let res_slot = scratch_slot(f, scratch_of[pkey(node.nodes[0])])
  mut ids = [
    ir.store_local(flag_slot, ir_bool(m, false, node), node),
    ir.store_local(res_slot, ir.nil_literal(node), node),
  ]
  for carm in node.nodes {
    let head = carm.nodes[0]
    let body = carm.nodes[1]
    let ctest = cond {
      head.name == 'wild_p' => ir_bool(m, true, node),
      _ => {
        let (pl, pc) = pos_args(m, head)
        call_pre(m, f, '__truthy', [emit_expr(m, head, f), pl, pc], head)
      },
    }
    let notyet = ir.make_if_else(
      ir.local(flag_slot, node),
      ir_bool(m, false, node),
      ctest,
      node,
    )
    let bodyv = cond {
      body.name == 'block' => emit_block(m, body, f),
      _ => emit_expr(m, body, f),
    }
    let take = ir.block(
      [
        ir.store_local(flag_slot, ir_bool(m, true, node), node),
        ir.store_local(res_slot, bodyv, node),
      ],
      node,
    )
    ids.push(ir.make_if(notyet, take, node))
  }
  ids.push(ir.local(res_slot, node))
  ir.block(ids, node)
}

fn emit_interp(m, node, f) {
  mut value = nil
  for part in node.nodes {
    let piece = cond {
      # {expr:spec}: the spec's own {field}s are Longs spliced in as digits
      part.name == 'interp' && part.nodes.size() == 2 => {
        let v = emit_expr(m, part.nodes[0], f)
        mut specv = nil
        for sp in part.nodes[1].nodes {
          let sv = cond {
            sp.name == 'spec_arg' => {
              let (al, ac) = pos_args(m, sp)
              call_pre(
                m,
                f,
                '__spec_arg',
                [emit_expr(m, sp.nodes[0], f), al, ac],
                sp,
              )
            },
            _ => ir.str_literal(sp.token, sp),
          }
          specv = cond {
            specv == nil => sv,
            _ => ir.binary('add', specv, sv, part),
          }
        }
        let (pl, pc) = pos_args(m, part)
        call_pre(m, f, '__format', [v, specv, pl, pc], part)
      },
      part.name ==
        'interp' => call_pre(
        m,
        f,
        '__display',
        [emit_expr(m, part.nodes[0], f)],
        part,
      ),
      _ => ir.str_literal(unescape(part.token), part),
    }
    value = cond {
      value == nil => piece,
      _ => ir.binary('add', value, piece, node),
    }
  }
  if value == nil {
    return ir.str_literal('', node)
  }
  value
}

fn emit_call(m, node, f) {
  let [id, args] = node.nodes
  if id.token == 'println' || id.token == 'print' {
    let v = emit_expr(m, args.nodes[0], f)
    let shown = cond {
      in_prelude => v,  # the prelude prints strings it already formatted
      _ => call_pre(m, f, '__display', [v], node),
    }
    let iname = cond {
      id.token == 'println' => 'print',
      _ => 'printraw',
    }
    return ir.intrinsic(iname, [shown], node)
  }
  if !in_prelude && builtins.has(id.token) {
    # a built-in takes keyword arguments positionally
    mut arg_ids = []
    for a in args.nodes {
      arg_ids.push(emit_expr(m, arg_val(a), f))
    }
    let (pl, pc) = pos_args(m, id)
    # the wrong count is culebra's runtime ArityError, in its two wordings
    let n = args.nodes.size()
    let bad = cond {
      id.token == 'range' || id.token == 'iota' => cond {
        n < 1 ||
          n > 3 => "'" + id.token + "' takes 1 to 2 arguments but {n} given",
        _ => nil,
      },
      id.token == 'grid' => cond {
        n != 2 => "'grid' takes 2 arguments but {n} given",
        _ => nil,
      },
      _ => {
        let (_, arity) = builtins[id.token]
        # an assert takes an optional trailing label
        let labeled = id.token.starts_with('assert_') && n == arity + 1
        cond {
          n != arity &&
            !labeled => "expected {arity} positional argument" + cond {
            arity == 1 => '',
            _ => 's',
          } + ", got {n}",
          _ => nil,
        }
      },
    }
    if bad != nil {
      let ids2 = arg_ids
      ids2.push(call_pre(
        m,
        f,
        '__raise',
        [ir.str_literal('ArityError', node), ir.str_literal(bad, node), pl, pc],
        node,
      ))
      return ir.block(ids2, node)
    }
    # range's step is keyword-only: the positionals pick start/end, and a
    # step keyword selects the stepped form with the end left nil for one
    # positional
    mut npos = 0
    mut stepv = nil
    mut posv = []
    if id.token == 'range' || id.token == 'iota' {
      for i in range(args.nodes.size()) {
        let a = args.nodes[i]
        cond {
          a.name == 'kwarg' &&
            a.nodes[0].token == 'step' &&
            id.token == 'range' => stepv = arg_ids[i],
          a.name == 'kwarg' => nil,
          _ => {
            npos = npos + 1
            posv.push(arg_ids[i])
          },
        }
      }
    }
    if id.token == 'range' && stepv != nil {
      if posv.size() == 1 {
        posv.push(ir.nil_literal(node))
      }
      posv.push(stepv)
      arg_ids = posv
    }
    let target = cond {
      id.token == 'range' => cond {
        stepv != nil => '__range3',
        npos == 1 => '__range1',
        npos == 2 => '__range2',
        _ => '__range3',
      },
      id.token == 'iota' => cond {
        args.nodes.size() == 1 => '__iota1',
        _ => '__iota2',
      },
      _ => {
        let (t, arity) = builtins[id.token]
        # an assert's label defaults to ''
        if id.token.starts_with('assert_') && n == arity {
          arg_ids.push(ir.str_literal('', node))
        }
        t
      },
    }
    arg_ids.push(pl)
    arg_ids.push(pc)
    return call_pre(m, f, target, arg_ids, node)
  }
  if in_prelude {
    if intrinsics.has(id.token) {
      let (iname, _) = intrinsics[id.token]
      mut arg_ids = []
      for a in args.nodes {
        arg_ids.push(emit_expr(m, a, f))
      }
      return ir.intrinsic(iname, arg_ids, node)
    }
    if id.token == '__error' {
      let kv = []
      let keys = ['kind', 'message', 'line', 'col']
      mut i = 0
      while i < 4 {
        kv.push(ir.str_literal(keys[i], node))
        kv.push(emit_expr(m, args.nodes[i], f))
        i = i + 1
      }
      return ir.object_lit(kv, node)
    }
    if id.token == '__allbytes' {
      return ir.str_literal(allbytes_str, node)
    }
  }
  let r = resolved[pkey(id)]
  if r.kind == 'class' {
    let clsv = ir.read(f, r.owner, r.slot, id)
    let [posv, kwsv, aposv] = emit_call_shape(m, f, args.nodes, node)
    let (pl, pc) = pos_args(m, id)
    return call_pre(
      m,
      f,
      '__construct',
      [clsv, posv, kwsv, aposv, pl, pc],
      node,
    )
  }
  if r.kind == 'fn' {
    # a **splat makes the keyword set dynamic: bind at run time through
    # the family record instead of the compile-time dispatch chain
    if has_splat(args.nodes) {
      let [posv, kwsv, aposv] = emit_call_shape(m, f, args.nodes, node)
      let (pl, pc) = pos_args(m, id)
      return call_pre(
        m,
        f,
        '__call_nk',
        [
          emit_family(m, f, id.token, r.funcs, 0, node),
          posv,
          kwsv,
          aposv,
          pl,
          pc,
        ],
        node,
      )
    }
    if !needs_dispatch(r.funcs, args) {
      # the plain shape keeps the direct emission: one overload, exact
      # positional arity, no types/defaults/rest
      mut arg_ids = []
      for a in args.nodes {
        arg_ids.push(emit_expr(m, a, f))
      }
      let g = r.funcs[0]
      let callee = ir.closure(f, g, node)
      return ir.call_value(callee, arg_ids, node)
    }
    return emit_dispatch(m, f, id.token, r.funcs, args.nodes, nil, node)
  }
  let cv = ir.read(f, r.owner, r.slot, id)
  # a call through a value carries its shape, so a closure's parameter
  # list binds it and a type error lands on the argument
  if !in_prelude {
    let [posv, kwsv, aposv] = emit_call_shape(m, f, args.nodes, node)
    let (pl, pc) = pos_args(m, id)
    return call_pre(m, f, '__call_nk', [cv, posv, kwsv, aposv, pl, pc], node)
  }
  mut arg_ids = []
  for a in args.nodes {
    arg_ids.push(emit_expr(m, a, f))
  }
  ir.call_value(cv, arg_ids, node)
}

# Overloads ordered most-typed-first (approximating "most specific"),
# declaration order among equals.
fn order_most_typed(fns) {
  mut order = []
  for g in fns {
    order.push(g)
  }
  mut oi = 1
  while oi < order.size() {
    let g = order[oi]
    mut oj = oi - 1
    mut going = true
    while going {
      cond {
        oj < 0 => going = false,
        typed_count(order[oj]) < typed_count(g) => {
          order[oj + 1] = order[oj]
          oj = oj - 1
        },
        _ => going = false,
      }
    }
    order[oj + 1] = g
    oi = oi + 1
  }
  order
}

fn has_kwargs(arg_nodes) {
  for a in arg_nodes {
    if a.name == 'kwarg' || a.name == 'kwsplat' {
      return true
    }
  }
  false
}

fn has_splat(arg_nodes) {
  for a in arg_nodes {
    if a.name == 'kwsplat' {
      return true
    }
  }
  false
}

# A call's shape for the prelude's runtime binder: the positional values,
# nil or [names, values] for the keywords, and the positionals' [line, col,
# ...] so a type error can point at the argument. With a **splat the
# keywords are merged at run time, in source order, later ones winning.
fn emit_call_shape(m, f, arg_nodes, at) {
  mut pos = []
  mut kwn = []
  mut kwv = []
  mut items = []
  mut apos = []
  let splat = has_splat(arg_nodes)
  for a in arg_nodes {
    let vn = arg_val(a)
    let v = emit_expr(m, vn, f)
    cond {
      a.name == 'kwarg' => {
        let namev = ir.str_literal(a.nodes[0].token, a)
        kwn.push(namev)
        kwv.push(v)
        items.push(ir.array_lit([namev, v], at))
      },
      a.name == 'kwsplat' => {
        # a bad splat operand is reported at the call
        items.push(ir.array_lit(
          [
            ir.nil_literal(at),
            v,
            ir.literal(at.line, at),
            ir.literal(at.column, at),
          ],
          at,
        ))
      },
      _ => {
        pos.push(v)
        apos.push(ir.literal(vn.line, vn))
        apos.push(ir.literal(vn.column, vn))
      },
    }
  }
  let posv = ir.array_lit(pos, at)
  let kwsv = cond {
    splat => call_pre(m, f, '__merge_kws', [ir.array_lit(items, at)], at),
    kwn.size() == 0 => ir.nil_literal(at),
    _ => ir.array_lit([ir.array_lit(kwn, at), ir.array_lit(kwv, at)], at),
  }
  let aposv = cond {
    apos.size() == 0 => ir.nil_literal(at),
    _ => ir.array_lit(apos, at),
  }
  [posv, kwsv, aposv]
}

# A function's declared parameters as the runtime binder reads them:
# [[name, type check, type name, has default, kind] ..., cap, fixable],
# skipping the first `skip` (a method's self). kind is 'p' (positional or
# keyword), 'k' (keyword-only, after a bare *), 'r' (*rest) or 'kr'
# (**rest); cap is the positional count a bare * caps the call at, or -1
# without one; fixable says a typed default can fail in the prologue.
fn emit_spec(m, g, skip, at) {
  mut recs = []
  let specs = funcs[g].pspecs
  let kfrom = cond {
    funcs[g].has('kwonly_from') => funcs[g].kwonly_from,
    _ => -1,
  }
  mut npos = 0
  mut fix = false
  mut i = skip
  while i < specs.size() {
    let rec = specs[i]
    # hidden slots and a self-closure's receiver slot are the caller's
    # business, not the binder's
    if rec.hidden == true || rec.pname == '__selfp' {
      i = i + 1
      continue
    }
    let tc = cond {
      rec.ty == nil => ir.nil_literal(at),
      _ => ir.str_literal(ty_check_of(rec.ty), at),
    }
    let tyname = cond {
      rec.ty == nil => '',
      _ => rec.ty,
    }
    let kind = cond {
      rec.rest => 'r',
      rec.kwrest == true => 'kr',
      kfrom >= 0 && i >= kfrom => 'k',
      _ => 'p',
    }
    if kind == 'p' {
      npos = npos + 1
    }
    if rec.ty != nil && rec.dflt != nil {
      fix = true
    }
    recs.push(ir.array_lit(
      [
        ir.str_literal(rec.pname, at),
        tc,
        ir.str_literal(tyname, at),
        ir.bool_literal(rec.dflt != nil, at),
        ir.str_literal(kind, at),
      ],
      at,
    ))
    i = i + 1
  }
  let cap = cond {
    kfrom >= 0 => npos,
    _ => -1,
  }
  ir.array_lit(
    [ir.array_lit(recs, at), ir.literal(cap, at), ir.bool_literal(fix, at)],
    at,
  )
}

# A family: {"\zf": name, ov: [[closure, spec], ...]}, most-typed overload
# first. `skip` is 1 for a class's methods (their first parameter is self)
# and 0 for a free multimethod, which the record marks as such.
fn emit_family(m, f, name, gs, skip, at) {
  mut ovs = []
  for g in order_most_typed(gs) {
    ovs.push(ir.array_lit(
      [ir.closure(f, g, at), emit_spec(m, g, skip, at)],
      at,
    ))
  }
  let kv = []
  kv.push(ir.str_literal(family_marker, at))
  kv.push(ir.str_literal(name, at))
  kv.push(ir.str_literal('ov', at))
  kv.push(ir.array_lit(ovs, at))
  if skip == 0 {
    kv.push(ir.str_literal('free', at))
    kv.push(ir.bool_literal(true, at))
  }
  ir.object_lit(kv, at)
}

# deco1(deco2(v)) for a decorator list, innermost (last written) first; a
# factory form @deco(args) applies deco(args) to the value.
fn emit_decorated(m, f, decos, v0) {
  mut v = v0
  mut i = decos.size() - 1
  while i >= 0 {
    let dn = decos[i].nodes[0]
    let r = resolved[pkey(dn)]
    mut callee = cond {
      r.kind == 'fn' => ir.closure(f, r.funcs[0], dn),
      _ => {
        # a decorator held in a variable may be a closure marker
        let (pl, pc) = pos_args(m, dn)
        call_pre(
          m,
          f,
          '__callee_check',
          [ir.read(f, r.owner, r.slot, dn), pl, pc],
          dn,
        )
      },
    }
    if decos[i].nodes.size() == 2 {
      mut fargs = []
      for a in decos[i].nodes[1].nodes {
        fargs.push(emit_expr(m, arg_val(a), f))
      }
      let (pl, pc) = pos_args(m, dn)
      callee = call_pre(
        m,
        f,
        '__callee_check',
        [ir.call_value(callee, fargs, dn), pl, pc],
        dn,
      )
    }
    v = ir.call_value(callee, [v], dn)
    i = i - 1
  }
  v
}

# The multimethod / kwargs / defaults call: evaluate every argument once
# into its slot, then try each overload -- most-typed first -- with the
# static shape check done here at compile time and only the type tests
# left for run time. `recv_extra` (UFCS) prepends one already-emitted
# receiver value as the first positional argument.
fn emit_dispatch(m, f, name, fns, arg_nodes, recv_extra, at) {
  mut ids = []
  mut pos_slots = []  # positional argument slots, in order
  mut kw_slots = {}   # kwarg name -> slot
  if recv_extra != nil {
    pos_slots.push(recv_extra.slot)
    ids.push(ir.store_local(recv_extra.slot, recv_extra.value, at))
  }
  for a in arg_nodes {
    let slot = scratch_slot(f, scratch_of[pkey(arg_val(a))])
    ids.push(ir.store_local(slot, emit_expr(m, arg_val(a), f), at))
    cond {
      a.name == 'kwarg' => kw_slots[a.nodes[0].token] = slot,
      _ => pos_slots.push(slot),
    }
  }

  mut chain = []
  for g in order_most_typed(fns) {
    let plan = overload_plan(g, pos_slots, kw_slots)
    if plan != nil {
      chain.push((g, plan))
    }
  }
  let (pl, pc) = pos_args(m, at)
  # innermost alternative: no overload matched -- a keyword no overload of
  # a multi-definition family declares is refused by name instead
  mut alt = nil
  for a in arg_nodes {
    if a.name == 'kwarg' && alt == nil && fns.size() > 1 {
      mut known = false
      for g in fns {
        for rec in funcs[g].pspecs {
          if rec.pname == a.nodes[0].token {
            known = true
          }
        }
      }
      if !known {
        alt = call_pre(
          m,
          f,
          '__raise',
          [
            ir.str_literal('TypeError', at),
            ir.str_literal(
              "unknown keyword argument '" + a.nodes[0].token + "'",
              at,
            ),
            pl,
            pc,
          ],
          at,
        )
      }
    }
  }
  if alt == nil {
    alt = call_pre(
      m,
      f,
      '__raise',
      [
        ir.str_literal('DispatchError', at),
        ir.str_literal('no matching method for `' + name + '`', at),
        pl,
        pc,
      ],
      at,
    )
  }
  mut ci = chain.size() - 1
  while ci >= 0 {
    let (g, plan) = chain[ci]
    mut test = ir_bool(m, true, at)
    for tc in plan.checks {
      let (slot, tyname) = tc
      test = ir_and(m, test, emit_ty_test(m, f, slot, tyname, at), at)
    }
    mut call_args = []
    for item in plan.args {
      let (akind, aval) = item
      call_args.push(cond {
        akind == 'slot' => ir.local(aval, at),
        akind == 'missing' => ir.str_literal(missing_marker, at),
        akind == 'kwrest' => {
          # **rest: the unclaimed keywords as an object
          let kv = []
          for name in aval {
            kv.push(ir.str_literal(name, at))
            kv.push(ir.local(kw_slots[name], at))
          }
          ir.object_lit(kv, at)
        },
        _ => {
          # rest: pack the listed slots
          mut xs = []
          for sl in aval {
            xs.push(ir.local(sl, at))
          }
          ir.array_lit(xs, at)
        },
      })
    }
    mut callv = ir.call_value(ir.closure(f, g, at), call_args, at)
    # the chosen overload still refuses a keyword of the wrong type, or a
    # non-callable where Function was declared
    mut si = plan.strict.size() - 1
    while si >= 0 {
      let (slot, tyname, pname, ty) = plan.strict[si]
      let bad = call_pre(
        m,
        f,
        '__raise',
        [
          ir.str_literal('TypeError', at),
          ir.str_literal(
            "type error: parameter '" + pname + "' expects " + ty,
            at,
          ),
          pl,
          pc,
        ],
        at,
      )
      callv = ir.make_if_else(
        emit_ty_test(m, f, slot, tyname, at),
        callv,
        bad,
        at,
      )
      si = si - 1
    }
    alt = ir.make_if_else(test, callv, alt, at)
    ci = ci - 1
  }
  ids.push(alt)
  ir.block(ids, at)
}

fn typed_count(g) {
  mut n = 0
  for rec in funcs[g].pspecs {
    if rec.ty != nil {
      n = n + 1
    }
  }
  n
}

# Can this overload take this call shape at all? nil when it cannot;
# otherwise {args: [per-param ('slot', i) / ('missing', 0) / ('rest', [..])],
# checks: [(slot, typeof-name)] -- the positional types dispatch selects
# on -- and strict: [(slot, typeof-name, param, type)], checked once the
# overload is chosen (a keyword's type, and Function anywhere), the way
# culebra reports those as a TypeError naming the parameter.
fn overload_plan(g, pos_slots, kw_slots) {
  let specs = funcs[g].pspecs
  let kfrom = cond {
    funcs[g].has('kwonly_from') => funcs[g].kwonly_from,
    _ => -1,
  }
  mut args = []
  mut checks = []
  mut strict = []
  mut pi = 0
  mut used_kw = 0
  mut used_names = []
  mut kwrest_i = -1
  mut i = 0
  while i < specs.size() {
    let rec = specs[i]
    let kw_only = kfrom >= 0 && i >= kfrom
    cond {
      rec.rest => {
        mut extra = []
        while pi < pos_slots.size() {
          extra.push(pos_slots[pi])
          pi = pi + 1
        }
        args.push(('rest', extra))
      },
      rec.kwrest == true => {
        # **rest: the keyword slots no parameter claims, packed below
        kwrest_i = args.size()
        args.push(('kwrest', []))
      },
      !kw_only && pi < pos_slots.size() => {
        args.push(('slot', pos_slots[pi]))
        if rec.ty != nil {
          let tc = ty_check_of(rec.ty)
          cond {
            tc == '@fn' => strict.push((pos_slots[pi], tc, rec.pname, rec.ty)),
            _ => checks.push((pos_slots[pi], tc)),
          }
        }
        pi = pi + 1
      },
      kw_slots.has(rec.pname) => {
        args.push(('slot', kw_slots[rec.pname]))
        used_kw = used_kw + 1
        used_names.push(rec.pname)
        if rec.ty != nil {
          strict.push((
            kw_slots[rec.pname],
            ty_check_of(rec.ty),
            rec.pname,
            rec.ty,
          ))
        }
      },
      rec.dflt != nil => args.push(('missing', 0)),
      _ => return nil,  # a required param nobody supplied
    }
    i = i + 1
  }
  if pi < pos_slots.size() {
    return nil
  }  # extra positionals
  if used_kw != kw_slots.size() {
    # an unknown kwarg: **rest packs the unclaimed ones, else no fit
    if kwrest_i < 0 {
      return nil
    }
    mut leftover = []
    for name in kw_slots.keys() {
      if !used_names.contains(name) {
        leftover.push(name)
      }
    }
    args[kwrest_i] = ('kwrest', leftover)
  }
  {args: args, checks: checks, strict: strict}
}

# The IR test for one (slot, check) pair.
fn emit_ty_test(m, f, slot, tyname, at) {
  call_pre(
    m,
    f,
    '__ty_ok',
    [ir.local(slot, at), ir.str_literal(tyname, at)],
    at,
  )
}

# What a type annotation means at run time: a typeof name, the tuple mark,
# a trait conformance check, or an instance-of-class check (any name that
# is neither scalar nor a declared trait).
fn ty_check_of(ty) {
  cond {
    ty == 'Tuple' => '@tuple',
    ty == 'Function' => '@fn',
    type_map.has(ty) => type_map[ty],
    traits.has(ty) => '@trait:' + ty,
    _ => '@cls:' + ty,
  }
}

# A closure value; one that mentions `self` travels as a marker carrying
# its declared arity, so a method call or dot read can supply the receiver.
fn emit_closure_value(m, node, f) {
  let g = closure_of[pkey(node)]
  let c = ir.closure(f, g, node)
  # a closure with parameters travels with its parameter list, so any
  # call site -- a property call, a callback slot, a keyword call --
  # binds by name and type the way culebra does; one that mentions self
  # also carries the receiver slot
  let has_spec = !in_prelude && closure_needs_spec(g)
  cond {
    has_spec => call_pre(
      m,
      f,
      '__mk_specc',
      [c, emit_spec(m, g, 0, node), ir.bool_literal(self_closure.has(g), node)],
      node,
    ),
    self_closure.has(g) => call_pre(m, f, '__mk_selfc', [c], node),
    _ => c,
  }
}

fn closure_needs_spec(g) {
  for rec in funcs[g].pspecs {
    if rec.hidden != true && rec.pname != '__selfp' {
      return true
    }
  }
  false
}

fn emit_postfix_step(m, f, value, step, at) {
  let (pl, pc) = pos_args(m, at)
  cond {
    step.name == 'pcall' && !in_prelude => {
      let [posv, kwsv, aposv] = emit_call_shape(m, f, step.nodes[0].nodes, step)
      call_pre(m, f, '__call_nk', [value, posv, kwsv, aposv, pl, pc], step)
    },
    step.name == 'pcall' => {
      mut arg_ids = []
      for a in step.nodes[0].nodes {
        arg_ids.push(emit_expr(m, a, f))
      }
      let callee = cond {
        in_prelude => value,
        _ => call_pre(m, f, '__callee_check', [value, pl, pc], step),
      }
      ir.call_value(callee, arg_ids, step)
    },
    step.name == 'mcall' => {
      let name = step.nodes[0]
      cond {
        # inside the prelude a .name(...) is a protocol call: read the
        # property, call what it holds (used for user iterators)
        in_prelude => {
          mut arg_ids = []
          for a in step.nodes[1].nodes {
            arg_ids.push(emit_expr(m, a, f))
          }
          ir.call_value(
            ir.index(value, ir.str_literal(name.token, name), step),
            arg_ids,
            step,
          )
        },
        # UFCS: a name outside the built-in method set that resolves to a
        # function in scope is a free call with the receiver first -- unless
        # the receiver turns out to have a method of that name, which wins
        !builtin_methods.contains(name.token) && resolved.has(pkey(name)) => {
          let r = resolved[pkey(name)]
          let slot = scratch_slot(f, scratch_of[pkey(name)])
          fn sref() {
            ir.local(slot, step)
          }
          let store = ir.store_local(slot, value, step)
          let own = call_pre(
            m,
            f,
            '__has_method',
            [sref(), ir.str_literal(name.token, name)],
            step,
          )
          let [
            posv,
            kwsv,
            aposv,
          ] = emit_call_shape(m, f, step.nodes[1].nodes, step)
          let nl_ = ir.literal(name.line, step)
          let nc_ = ir.literal(name.column, step)
          let via_method = call_pre(
            m,
            f,
            '__method',
            [
              sref(),
              ir.str_literal(name.token, name),
              posv,
              kwsv,
              aposv,
              pl,
              pc,
            ],
            step,
          )
          let via_ufcs = cond {
            r.kind == 'fn' &&
              !has_splat(step.nodes[1].nodes) => emit_dispatch(
              m,
              f,
              name.token,
              r.funcs,
              step.nodes[1].nodes,
              {slot: slot, value: sref()},
              step,
            ),
            r.kind ==
              'fn' => call_pre(
              m,
              f,
              '__ufcs_call',
              [
                emit_family(m, f, name.token, r.funcs, 0, step),
                sref(),
                nl_,
                nc_,
                posv,
                kwsv,
                aposv,
                pl,
                pc,
              ],
              step,
            ),
            r.kind ==
              'bval' => call_pre(
              m,
              f,
              '__ufcs_call',
              [
                call_pre(m, f, '__fnval_' + r.name, [], name),
                sref(),
                nl_,
                nc_,
                posv,
                kwsv,
                aposv,
                pl,
                pc,
              ],
              step,
            ),
            _ => {
              # a callable variable: the receiver goes first
              call_pre(
                m,
                f,
                '__ufcs_call',
                [
                  ir.read(f, r.owner, r.slot, name),
                  sref(),
                  nl_,
                  nc_,
                  posv,
                  kwsv,
                  aposv,
                  pl,
                  pc,
                ],
                step,
              )
            },
          }
          ir.block(
            [store, ir.make_if_else(own, via_method, via_ufcs, step)],
            step,
          )
        },
        _ => {
          let [
            posv,
            kwsv,
            aposv,
          ] = emit_call_shape(m, f, step.nodes[1].nodes, step)
          call_pre(
            m,
            f,
            '__method',
            [
              value,
              ir.str_literal(name.token, name),
              posv,
              kwsv,
              aposv,
              pl,
              pc,
            ],
            step,
          )
        },
      }
    },
    step.name == 'prop' => cond {
      in_prelude => ir.index(
        value,
        ir.str_literal(step.nodes[0].token, step),
        step,
      ),
      _ => call_pre(
        m,
        f,
        '__getprop',
        [value, ir.str_literal(step.nodes[0].token, step), pl, pc],
        step,
      ),
    },
    _ => cond {
      # subscript
      in_prelude => ir.index(value, emit_expr(m, step.nodes[0], f), step),
      _ => call_pre(
        m,
        f,
        '__getindex',
        [value, emit_expr(m, step.nodes[0], f), pl, pc],
        step,
      ),
    },
  }
}

fn emit_postfix(m, node, f) {
  let head = node.nodes[0]
  let v0 = emit_expr(m, head, f)
  # `[items](n, fill)` is the sized-array form, not a call
  if head.name == 'array_lit' && node.nodes.size() > 1 && !in_prelude {
    let step = node.nodes[1]
    if step.name == 'pcall' {
      mut arg_ids = []
      for a in step.nodes[0].nodes {
        arg_ids.push(emit_expr(m, arg_val(a), f))
      }
      let (pl, pc) = pos_args(m, step)
      let sized = call_pre(
        m,
        f,
        '__array_sized',
        [v0, ir.array_lit(arg_ids, step), pl, pc],
        step,
      )
      return emit_postfix_from(m, node, f, sized, 2)
    }
  }
  emit_postfix_from(m, node, f, v0, 1)
}

# `?.` short-circuits the rest of the chain: the receiver is parked in a
# scratch slot, and every later step runs only when it is not nil.
fn emit_postfix_from(m, node, f, value, i) {
  let nodes = node.nodes
  if i >= nodes.size() {
    return value
  }
  let step = nodes[i]
  cond {
    step.name == 'nprop' || step.name == 'nmcall' => {
      let slot = scratch_slot(f, scratch_of[pkey(step)])
      fn sref() {
        ir.local(slot, step)
      }
      let store = ir.store_local(slot, value, step)
      let plain = {
        name: cond {
          step.name == 'nprop' => 'prop',
          _ => 'mcall',
        },
        nodes: step.nodes,
        line: step.line,
        column: step.column,
      }
      let rest = emit_postfix_from(
        m,
        node,
        f,
        emit_postfix_step(m, f, sref(), plain, node.nodes[0]),
        i + 1,
      )
      let guarded = ir.make_if_else(
        ir.binary(
          'eq',
          ir_typeof(m, sref(), step),
          ir.str_literal('nil', step),
          step,
        ),
        ir.nil_literal(step),
        rest,
        step,
      )
      ir.block([store, guarded], step)
    },
    _ => emit_postfix_from(
      m,
      node,
      f,
      emit_postfix_step(m, f, value, step, node.nodes[0]),
      i + 1,
    ),
  }
}

fn emit_unary(m, node, f, which) {
  let e = emit_expr(m, node.nodes[0], f)
  if in_prelude {
    return cond {
      which == 'neg' => ir.unary('neg', e, node),
      which == 'bnot' => ir.unary('bitnot', e, node),
      # ! on a value the prelude already knows is a Bool
      _ => ir.make_if_else(
        e,
        ir.bool_literal(false, node),
        ir.bool_literal(true, node),
        node,
      ),
    }
  }
  let (pl, pc) = pos_args(m, node)
  cond {
    which == 'neg' => call_pre(m, f, '__neg', [e, pl, pc], node),
    which == 'bnot' => call_pre(m, f, '__bnot', [e, pl, pc], node),
    _ => {
      let c = call_pre(m, f, '__truthy', [e, pl, pc], node)
      ir.make_if_else(
        c,
        ir.bool_literal(false, node),
        ir.bool_literal(true, node),
        node,
      )
    },
  }
}

fn emit_if(m, node, f, at) {
  let c0 = emit_expr(m, node.nodes[0], f)
  let c = cond {
    in_prelude => c0,
    _ => {
      let (pl, pc) = pos_args(m, node)
      call_pre(m, f, '__truthy', [c0, pl, pc], node)
    },
  }
  let t = emit_block(m, node.nodes[1], f)
  cond {
    node.nodes.size() == 3 => {
      let alt = node.nodes[2]
      let e = cond {
        alt.name == 'if' => emit_if(m, alt, f, alt),
        _ => emit_block(m, alt, f),
      }
      ir.make_if_else(c, t, e, node)
    },
    _ => ir.make_if(c, t, node),
  }
}

fn emit_try(m, node, f) {
  let [body, id, handler] = node.nodes
  let b = emit_block(m, body, f)
  let r = resolved[pkey(id)]
  let info = block_info[pkey(handler)]
  mut ids = []
  # an executor trap gets its kind first, in the local slot the VM filled
  ids.push(ir.store_local(
    r.slot,
    call_pre(m, f, '__fix_trap', [ir.local(r.slot, id)], id),
    id,
  ))
  # a captured caught variable arrives in its local slot and moves into the
  # cell every other reference resolves to (same shape as parameters)
  if frames.in_cell(f, r.slot) {
    let src = ir.local(r.slot, id)
    ids.push(ir.store_cell(frames.cell_of(f, r.slot), src, id))
  }
  for s in handler.nodes {
    let e = emit_stmt(m, s, f)
    if e != nil {
      ids.push(e)
    }
  }
  let hb = ir.block(ids, handler)
  let wrapped = emit_scope_of(m, f, info.base, info.high, hb, handler)
  ir.make_try(r.slot, b, wrapped, node)
}

fn emit_expr(m, node, f) {
  match node {
    {name: 'number'} => ir.literal(parse_int_token(node.token), node),
    {name: 'float'} => ir.double_literal(to_float(node.token), node),
    {name: 'str_sq'} => ir.str_literal(node.token, node),
    {name: 'str_dq'} => emit_interp(m, node, f),
    {name: 'true_l'} => ir.bool_literal(true, node),
    {name: 'false_l'} => ir.bool_literal(false, node),
    {name: 'nil_l'} => ir.nil_literal(node),
    {name: 'ident', token} => {
      if !resolved.has(pkey(node)) {
        fail(node, "DEBUG unresolved ident '{token}' key={pkey(node)} f={f}")
      }
      let r = resolved[pkey(node)]
      cond {
        r.kind == 'strns' => call_pre(m, f, '__string_ns', [], node),
        r.kind == 'gcns' => call_pre(m, f, '__gc_ns', [], node),
        r.kind == 'bval' => call_pre(m, f, '__fnval_' + r.name, [], node),
        r.kind == 'fn' &&
          r.funcs.size() == 1 => ir.closure(f, r.funcs[0], node),
        r.kind == 'fn' => emit_family(m, f, token, r.funcs, 0, node),
        _ => {
          let ref = ir.read(f, r.owner, r.slot, node)
          cond {
            # a closure's `self` may be unbound: nil until a receiver arrives
            token == 'self' &&
              self_slot.has(r.owner) &&
              self_slot[r.owner] == r.slot => {
              let (pl, pc) = pos_args(m, node)
              call_pre(m, f, '__self_use', [ref, pl, pc], node)
            },
            # a binding named before its declaration ran is still unbound
            # (read through a capture or directly, ahead of the let)
            fwd_slots.has("{r.owner}/{r.slot}") => {
              let (pl, pc) = pos_args(m, node)
              call_pre(
                m,
                f,
                '__fwd_read',
                [ref, ir.str_literal(token, node), pl, pc],
                node,
              )
            },
            _ => ref,
          }
        },
      }
    },
    {name: 'call'} => emit_call(m, node, f),
    {name: 'assign_e'} => emit_assign_expr(m, node, f),
    {name: 'array_lit'} => {
      # runs of plain items become literals; each spread appends its
      # source's items, so [a, ...xs, b] is concat(concat([a], xs), [b])
      let (pl, pc) = pos_args(m, node)
      mut acc = nil
      mut run = []
      fn flush() {
        if run.size() > 0 || acc == nil {
          let lit = ir.array_lit(run, node)
          acc = cond {
            acc == nil => lit,
            _ => call_pre(m, f, '__concat', [acc, lit], node),
          }
          run = []
        }
      }
      for e in node.nodes {
        cond {
          e.name == 'spread' => {
            flush()
            acc = call_pre(
              m,
              f,
              '__concat',
              [
                acc,
                call_pre(
                  m,
                  f,
                  '__spread_items',
                  [emit_expr(m, e.nodes[0], f), pl, pc],
                  e,
                ),
              ],
              node,
            )
          },
          _ => run.push(emit_expr(m, e, f)),
        }
      }
      flush()
      acc
    },
    {name: 'range_lit', nodes} => {
      let (pl, pc) = pos_args(m, node)
      let open_start = nodes[0].name == 'range_op'
      let a = nodes[0]
      let op = cond {
        open_start => nodes[0],
        _ => nodes[1],
      }
      mut hi = ir.nil_literal(node)
      mut st = ir.nil_literal(node)
      mut i = cond {
        open_start => 1,
        _ => 2,
      }
      while i < nodes.size() {
        cond {
          nodes[i].name == 'step' => st = emit_expr(m, nodes[i].nodes[0], f),
          _ => hi = emit_expr(m, nodes[i], f),
        }
        i = i + 1
      }
      let incl = cond {
        op.token == '..=' => 1,
        _ => 0,
      }
      let lo = cond {
        open_start => ir.nil_literal(node),
        _ => emit_expr(m, a, f),
      }
      call_pre(
        m,
        f,
        '__mk_range',
        [lo, hi, ir.literal(incl, node), st, pl, pc],
        node,
      )
    },
    {name: 'shorthand'} => {
      let kv = []
      for id in node.nodes {
        kv.push(ir.str_literal(id.token, id))
        kv.push(emit_expr(m, id, f))
      }
      ir.object_lit(kv, node)
    },
    {name: 'fnself'} => {
      let r = resolved[pkey(node)]
      cond {
        r.kind == 'var' => {
          ir.read(f, r.owner, r.slot, node)
        },
        _ => ir.closure(f, f, node),
      }
    },
    {name: 'tuple'} => {
      mut ids = []
      for e in node.nodes {
        ids.push(emit_expr(m, e, f))
      }
      let items = ir.array_lit(ids, node)
      call_pre(m, f, '__mk_tuple', [items], node)
    },
    {name: 'object_lit'} => {
      let kv = []
      mut muts = []
      let (pl, pc) = pos_args(m, node)
      fn key_node(kn) {
        cond {
          is_str_key(kn) => ir.str_literal(kn.token, kn),
          # a non-String key is stored under its hash spelling; the
          # original value is recorded afterwards for keys() and display
          _ => call_pre(m, f, '__hkey', [emit_expr(m, kn, f), pl, pc], kn),
        }
      }
      mut incremental = false
      for pair in node.nodes {
        if pair.name == 'ospread' || !is_str_key(pair.nodes[0]) {
          incremental = true
        }
      }
      if incremental {
        # built entry by entry: a spread lands in sequence with the pairs,
        # and a non-String key's expression runs exactly once
        mut obj2 = ir.object_lit([], node)
        for pair in node.nodes {
          cond {
            pair.name ==
              'ospread' => obj2 = call_pre(
              m,
              f,
              '__obj_spread',
              [obj2, emit_expr(m, pair.nodes[0], f), pl, pc],
              pair,
            ),
            _ => {
              let k = pair.nodes[0]
              let is_mut = cond {
                pair.name == 'mut_pair' => 1,
                _ => 0,
              }
              let kexpr = cond {
                is_str_key(k) => ir.str_literal(k.token, k),
                _ => emit_expr(m, k, f),
              }
              obj2 = call_pre(
                m,
                f,
                '__olit_put',
                [
                  obj2,
                  kexpr,
                  emit_expr(m, pair.nodes[1], f),
                  ir.literal(is_mut, k),
                  pl,
                  pc,
                ],
                k,
              )
            },
          }
        }
        return obj2
      }
      for pair in node.nodes {
        let k = pair.nodes[0]
        kv.push(key_node(k))
        if pair.name == 'mut_pair' {
          muts.push(k)
        }
        kv.push(emit_expr(m, pair.nodes[1], f))
      }
      mut obj = ir.object_lit(kv, node)
      if muts.size() > 0 {
        mut ids2 = []
        for k in muts {
          ids2.push(key_node(k))
        }
        obj = call_pre(
          m,
          f,
          '__olit_mut',
          [obj, ir.array_lit(ids2, node)],
          node,
        )
      }
      # a literal binding a well-known key (drop, iter, has_next, next) is
      # checked against the protocol contract, and a drop hook installed
      mut has_proto = false
      for pair in node.nodes {
        let pkn = pair.nodes[0]
        if is_str_key(pkn) &&
            (pkn.token == 'drop' ||
              pkn.token == 'iter' ||
              pkn.token == 'has_next' ||
              pkn.token == 'next') {
          has_proto = true
        }
      }
      if has_proto && !in_prelude {
        obj = call_pre(m, f, '__with_contract', [obj, pl, pc], node)
      }
      obj
    },
    {name: 'set_lit'} => {
      let (pl, pc) = pos_args(m, node)
      mut ids = []
      for e in node.nodes {
        ids.push(emit_expr(m, e, f))
      }
      call_pre(m, f, '__mk_set', [ir.array_lit(ids, node), pl, pc], node)
    },
    {name: 'lambda'} => emit_closure_value(m, node, f),
    {name: 'closure'} => emit_closure_value(m, node, f),
    {name: 'if'} => emit_if(m, node, f, node),
    {name: 'try'} => emit_try(m, node, f),
    {name: 'neg'} => emit_unary(m, node, f, 'neg'),
    {name: 'lnot'} => emit_unary(m, node, f, 'lnot'),
    {name: 'bnot'} => emit_unary(m, node, f, 'bnot'),
    {name: 'power', nodes} => {
      cond {
        nodes.size() == 3 => {
          let l = emit_expr(m, nodes[0], f)
          let r = emit_expr(m, nodes[2], f)
          emit_binop(m, f, '**', l, r, nodes[1], nodes[0])
        },
        _ => emit_expr(m, nodes[0], f),
      }
    },
    {name: 'postfix'} => emit_postfix(m, node, f),
    {name: 'ternary', nodes} => {
      let c0 = emit_expr(m, nodes[0], f)
      let (pl, pc) = pos_args(m, node)
      let c = call_pre(m, f, '__truthy', [c0, pl, pc], node)
      ir.make_if_else(
        c,
        emit_expr(m, nodes[1], f),
        emit_expr(m, nodes[2], f),
        node,
      )
    },
    {name: 'nilco'} => emit_nilco(m, node, f),
    {name: 'match'} => emit_match(m, node, f),
    {name: 'cond_e'} => emit_cond(m, node, f),
    {name: 'cmp'} => emit_cmp_chain(m, node, f),
    {name: 'lor'} => emit_shortcircuit(m, node, f),
    {name: 'land'} => emit_shortcircuit(m, node, f),
    {name: 'bor'} => emit_left_chain(m, node, f),
    {name: 'bxor'} => emit_left_chain(m, node, f),
    {name: 'band'} => emit_left_chain(m, node, f),
    {name: 'shift'} => emit_left_chain(m, node, f),
    {name: 'add'} => emit_left_chain(m, node, f),
    {name: 'mul'} => emit_left_chain(m, node, f),
    _ => fail(node, "cannot evaluate {node.name}"),
  }
}

# a = v, a op= v, recv[k] = v, recv.k = v (and their op= forms). The
# compound forms re-emit the read; the receiver chain is evaluated twice,
# which for the sample programs (variables and fields) is indistinguishable
# from once.
# One assignment target -- a variable or an index/property chain -- written
# with an already-evaluated value.
fn emit_target_write(m, f, t, item, mut_add) {
  cond {
    t.name == 'ident' && runtime_immut.has(pkey(t)) => {
      let (pl, pc) = pos_args(m, t)
      call_pre(
        m,
        f,
        '__raise',
        [
          ir.str_literal('ImmutableError', t),
          ir.str_literal(
            "cannot reassign '" + t.token + "' (declared without 'mut')",
            t,
          ),
          pl,
          pc,
        ],
        t,
      )
    },
    t.name == 'ident' => {
      let r = resolved[pkey(t)]
      ir.write(f, r.owner, r.slot, item, t)
    },
    _ => {
      let steps = t.nodes
      let last = steps[steps.size() - 1]
      mut recv = emit_expr(m, steps[0], f)
      mut i = 1
      while i < steps.size() - 1 {
        recv = emit_postfix_step(m, f, recv, steps[i], steps[0])
        i = i + 1
      }
      let (pl, pc) = pos_args(m, steps[0])
      let key = cond {
        last.name == 'prop' => ir.str_literal(last.nodes[0].token, last),
        _ => emit_expr(m, last.nodes[0], f),
      }
      let is_prop = cond {
        mut_add => 0,
        last.name == 'prop' => 1,
        _ => 0,
      }
      call_pre(
        m,
        f,
        '__setindex',
        [recv, key, item, ir.literal(is_prop, last), pl, pc],
        t,
      )
    },
  }
}

# A stand-in 'assign' node for the expression form and the mut store: the
# same children and position key, so every side table lines up.
fn synth_assign(node, mut_add) {
  {
    name: 'assign',
    nodes: node.nodes,
    line: node.line,
    column: node.column,
    key: pkey(node),
    mut_add: mut_add,
  }
}

fn new_scratch_key(f, key) {
  let k = nscratch[f]
  nscratch[f] = k + 1
  scratch_of[key] = k
  k
}

# An assignment as an expression: its value is what was stored.
fn emit_assign_expr(m, node, f) {
  let res = scratch_slot(f, scratch_of[pkey(node) + '/r'])
  let store = emit_assign(m, synth_assign(node, false), f, res)
  ir.block([store, ir.local(res, node)], node)
}

# Pattern assignment `[a, b: Long, ...rest] = v` / `(a, b) = v` /
# `{k: a, b} = v`: the whole pattern is matched first (a mismatch writes
# nothing), then each leaf target is written in order.
fn scan_passign(node, f) {
  let [pat, op, value] = node.nodes
  scan_expr(value, f)
  new_scratch(f, node)
  scan_tpat(pat, f)
}

fn scan_tpat(p, f) {
  cond {
    p.name == 'arr_t' || p.name == 'tup_t' => {
      for e in p.nodes {
        scan_tpat(e, f)
      }
    },
    p.name == 'obj_t' => {
      for e in p.nodes {
        cond {
          e.nodes.size() == 2 => scan_tpat(e.nodes[1], f),
          _ => scan_target(e.nodes[0], f),
        }
      }
    },
    p.name == 'rest_pt' => scan_target(p.nodes[0], f),
    p.name == 'typed_t' => scan_target(p.nodes[0], f),
    p.name == 'ident' || p.name == 'postfix' => scan_target(p, f),
    _ => scan_expr(p, f),  # a literal to compare against
  }
}

# The pattern as the runtime matcher reads it, and the leaf targets in
# the order their values come back.
fn tpat_spec(m, f, p, targets) {
  fn strs(xs) {
    mut ids = []
    for s in xs {
      ids.push(ir.str_literal(s, p))
    }
    ids
  }
  fn arr(items) {
    ir.array_lit(items, p)
  }
  cond {
    p.name == 'arr_t' || p.name == 'tup_t' => {
      mut subs = []
      for e in p.nodes {
        subs.push(tpat_spec(m, f, e, targets))
      }
      arr([ir.str_literal('seq', p), arr(subs)])
    },
    p.name == 'obj_t' => {
      mut entries = []
      for e in p.nodes {
        cond {
          e.nodes.size() ==
            2 => entries.push(arr([
            ir.str_literal(e.nodes[0].token, p),
            tpat_spec(m, f, e.nodes[1], targets),
          ])),
          _ => {
            targets.push(e.nodes[0])
            entries.push(arr([
              ir.str_literal(e.nodes[0].token, p),
              arr(strs(['v'])),
            ]))
          },
        }
      }
      arr([ir.str_literal('obj', p), arr(entries)])
    },
    p.name == 'rest_pt' => {
      targets.push(p.nodes[0])
      arr(strs(['rest']))
    },
    p.name == 'typed_t' => {
      targets.push(p.nodes[0])
      let tn = ty_name(p.nodes[1])
      cond {
        tn == nil => arr(strs(['v'])),
        _ => arr(strs(['ty', ty_check_of(tn)])),
      }
    },
    p.name == 'ident' || p.name == 'postfix' => {
      targets.push(p)
      arr(strs(['v']))
    },
    _ => arr([ir.str_literal('lit', p), emit_expr(m, p, f)]),
  }
}

fn emit_passign(m, node, f) {
  let [pat, op, value] = node.nodes
  let tmp = scratch_slot(f, scratch_of[pkey(node)])
  mut targets = []
  let spec = tpat_spec(m, f, pat, targets)
  let (pl, pc) = pos_args(m, pat)
  fn tref() {
    ir.local(tmp, node)
  }
  mut ids = [ir.store_local(
    tmp,
    call_pre(m, f, '__destr_pat', [emit_expr(m, value, f), spec, pl, pc], node),
    node,
  )]
  for k in range(targets.size()) {
    let item = ir.index(tref(), ir.literal(k, node), node)
    ids.push(emit_target_write(m, f, targets[k], item, false))
  }
  ir.block(ids, node)
}

fn emit_assign(m, node, f, res) {
  let [lhs, op, value] = node.nodes
  let mut_add = node.mut_add == true
  if in_prelude && lhs.name == 'postfix' {
    # the prelude mutates arrays and objects directly; its stores are the
    # raw node (it is type-correct by construction)
    let steps = lhs.nodes
    let last = steps[steps.size() - 1]
    mut recv = emit_expr(m, steps[0], f)
    mut i = 1
    while i < steps.size() - 1 {
      recv = emit_postfix_step(m, f, recv, steps[i], steps[0])
      i = i + 1
    }
    let key = cond {
      last.name == 'prop' => ir.str_literal(last.nodes[0].token, last),
      _ => emit_expr(m, last.nodes[0], f),
    }
    return ir.set_index(recv, key, emit_expr(m, value, f), node)
  }
  # the value stored; with `res` (the expression form) it also lands in
  # that slot for the expression's own value
  fn rhs_of(read_back) {
    let stored = rhs_value(read_back)
    cond {
      res == nil => stored,
      _ => ir.block(
        [ir.store_local(res, stored, node), ir.local(res, node)],
        node,
      ),
    }
  }
  fn rhs_value(read_back) {
    let v = emit_expr(m, value, f)
    cond {
      op.token == '=' => v,
      read_back == nil => v,
      _ => {
        let (pl, pc) = pos_args(m, op)
        cond {
          op.token ==
            '??=' => ir.make_if_else(
            ir.binary(
              'eq',
              ir_typeof(m, read_back(), op),
              ir.str_literal('nil', op),
              op,
            ),
            v,
            read_back(),
            op,
          ),
          _ => {
            let name = cond {
              op.token == '+=' => '__add',
              op.token == '-=' => '__sub',
              op.token == '*=' => '__mul',
              op.token == '/=' => '__div',
              op.token == '**=' => '__pow',
              _ => '__mod',
            }
            call_pre(m, f, name, [read_back(), v, pl, pc], op)
          },
        }
      },
    }
  }
  cond {
    lhs.name == 'ident' && runtime_immut.has(pkey(lhs)) => {
      let (pl, pc) = pos_args(m, lhs)
      call_pre(
        m,
        f,
        '__raise',
        [
          ir.str_literal('ImmutableError', node),
          ir.str_literal(
            "cannot reassign '" + lhs.token + "' (declared without 'mut')",
            node,
          ),
          pl,
          pc,
        ],
        node,
      )
    },
    lhs.name == 'ident' => {
      let r = resolved[pkey(lhs)]
      let cur_var = fn () {
        ir.read(f, r.owner, r.slot, lhs)
      }
      ir.write(f, r.owner, r.slot, rhs_of(cur_var), node)
    },
    lhs.name == 'tuple' ||
      lhs.name == 'array_lit' ||
      lhs.name == 'shorthand' => {
      let tmp = scratch_slot(f, scratch_of[pkey(node)])
      let (pl, pc) = pos_args(m, lhs)
      let n = lhs.nodes.size()
      fn tref() {
        ir.local(tmp, node)
      }
      let src_v = cond {
        lhs.name == 'shorthand' => emit_expr(m, value, f),
        _ => call_pre(
          m,
          f,
          '__destr',
          [emit_expr(m, value, f), ir.literal(n, node), pl, pc],
          node,
        ),
      }
      mut ids = [ir.store_local(tmp, src_v, node)]
      for k in range(n) {
        let t = lhs.nodes[k]
        let item = cond {
          lhs.name ==
            'shorthand' => call_pre(
            m,
            f,
            '__getprop',
            [tref(), ir.str_literal(t.token, t), pl, pc],
            t,
          ),
          _ => ir.index(tref(), ir.literal(k, node), node),
        }
        ids.push(emit_target_write(m, f, t, item, false))
      }
      ir.block(ids, node)
    },
    _ => {
      # postfix: everything up to the last step is the receiver expression
      let steps = lhs.nodes
      let last = steps[steps.size() - 1]
      mut recv = emit_expr(m, steps[0], f)
      mut i = 1
      while i < steps.size() - 1 {
        recv = emit_postfix_step(m, f, recv, steps[i], steps[0])
        i = i + 1
      }
      let (pl, pc) = pos_args(m, steps[0])
      let key = cond {
        last.name == 'prop' => ir.str_literal(last.nodes[0].token, last),
        _ => emit_expr(m, last.nodes[0], f),
      }
      let is_prop = cond {
        mut_add => 0,
        last.name == 'prop' => 1,
        _ => 0,
      }
      cond {
        op.token == '=' => emit_target_write(m, f, lhs, rhs_of(nil), mut_add),
        _ => {
          # receiver and key evaluate once, into scratch slots the read and
          # the write both reference
          let rslot = scratch_slot(f, scratch_of[pkey(op)])
          let kslot = scratch_slot(f, scratch_of[pkey(lhs)])
          let stores = [
            ir.store_local(rslot, recv, node),
            ir.store_local(kslot, key, node),
          ]
          fn rref() {
            ir.local(rslot, node)
          }
          fn kref() {
            ir.local(kslot, node)
          }
          let cur_read = fn () {
            call_pre(
              m,
              f,
              '__getindex_or_prop',
              [rref(), kref(), ir.literal(is_prop, last), pl, pc],
              last,
            )
          }
          mut ids = stores
          cond {
            # ??= reads once (a missing key reads as nil) and stores only
            # when that read is nil; the expression's value is either
            op.token == '??=' => {
              let nslot = scratch_slot(f, scratch_of[pkey(op) + '/n'])
              fn nref() {
                ir.local(nslot, node)
              }
              ids.push(ir.store_local(
                nslot,
                call_pre(
                  m,
                  f,
                  '__nilco_read',
                  [rref(), kref(), ir.literal(is_prop, node), pl, pc],
                  node,
                ),
                node,
              ))
              let store = call_pre(
                m,
                f,
                '__setindex',
                [
                  rref(),
                  kref(),
                  rhs_of(nil),
                  ir.literal(is_prop, last),
                  pl,
                  pc,
                ],
                node,
              )
              let keep = cond {
                res == nil => ir.nil_literal(node),
                _ => ir.store_local(res, nref(), node),
              }
              ids.push(ir.make_if_else(
                ir.binary(
                  'eq',
                  ir_typeof(m, nref(), node),
                  ir.str_literal('nil', node),
                  node,
                ),
                store,
                keep,
                node,
              ))
            },
            _ => ids.push(call_pre(
              m,
              f,
              '__setindex',
              [
                rref(),
                kref(),
                rhs_of(cur_read),
                ir.literal(is_prop, last),
                pl,
                pc,
              ],
              node,
            )),
          }
          ir.block(ids, node)
        },
      }
    },
  }
}

# The class statement builds the class object -- name, ctor and method
# closures (self as their first parameter), the trait-conformance flags and
# any conforming trait's default methods -- and binds it to the class name.
fn emit_class(m, node, f) {
  let d = class_parts(node)
  let ck = "{f}/{d.id.token}"
  let ci = classes[ck]
  let kv = []
  kv.push(ir.str_literal(class_marker, node))
  kv.push(ir.str_literal('class', node))
  kv.push(ir.str_literal('name', node))
  kv.push(ir.str_literal(d.id.token, node))
  kv.push(ir.str_literal('new', node))
  kv.push(emit_family(m, f, 'new', ci.ctors, 1, node))
  let mkv = []
  for name in ci.methods.keys() {
    let plain = name.slice(2, name.size()).to_string()
    mkv.push(ir.str_literal(plain, node))
    mkv.push(emit_family(m, f, plain, ci.methods[name], 1, node))
  }
  # conforming traits contribute their defaults (never overriding) and a
  # flag the typed-dispatch check reads
  let confkv = []
  for tname in traits.keys() {
    let tr = traits[tname]
    mut ok = true
    for req in tr.required {
      let (rname, rar) = req
      cond {
        ci.methods.has('m:' + rname) => {
          mut fits = false
          for g in ci.methods['m:' + rname] {
            if funcs[g].params.size() - 1 == rar {
              fits = true
            }
          }
          if !fits {
            ok = false
          }
        },
        _ => ok = false,
      }
    }
    if ok {
      confkv.push(ir.str_literal(tname, node))
      confkv.push(ir.bool_literal(true, node))
      for dname in tr.defaults.keys() {
        if !ci.methods.has(dname) {
          let plain = dname.slice(2, dname.size()).to_string()
          mkv.push(ir.str_literal(plain, node))
          mkv.push(emit_family(m, f, plain, [tr.defaults[dname]], 1, node))
        }
      }
    }
  }
  kv.push(ir.str_literal('methods', node))
  kv.push(ir.object_lit(mkv, node))
  if ci.is_value {
    kv.push(ir.str_literal('value', node))
    kv.push(ir.bool_literal(true, node))
  }
  # @derive(...) flags: Eq / Hash / Comparable / Show, read by the operators
  let dkv = []
  for dname in ci.derives.keys() {
    dkv.push(ir.str_literal(dname, node))
    dkv.push(ir.bool_literal(true, node))
  }
  kv.push(ir.str_literal('derive', node))
  kv.push(ir.object_lit(dkv, node))
  # declared fields, written before new() runs; getters; statics
  let fl = []
  for fd in ci.fields {
    let g = ci.finits[fd.id.token]
    let init = cond {
      g == nil => ir.nil_literal(node),
      _ => ir.closure(f, g, node),
    }
    fl.push(ir.array_lit([ir.str_literal(fd.id.token, node), init], node))
  }
  kv.push(ir.str_literal('fields', node))
  kv.push(ir.array_lit(fl, node))
  let gkv = []
  for gname in ci.getters {
    gkv.push(ir.str_literal(gname, node))
    gkv.push(ir.bool_literal(true, node))
  }
  kv.push(ir.str_literal('getters', node))
  kv.push(ir.object_lit(gkv, node))
  for sname in ci.smeths.keys() {
    let g = ci.smeths[sname]
    kv.push(ir.str_literal(sname, node))
    kv.push(ir.closure(f, g, node))
  }
  for sf in ci.sfields {
    kv.push(ir.str_literal(sf.nodes[0].token, node))
    kv.push(emit_expr(m, sf.nodes[1], f))
  }
  kv.push(ir.str_literal('conf', node))
  kv.push(ir.object_lit(confkv, node))
  let clsobj = emit_decorated(m, f, ci.decos, ir.object_lit(kv, node))
  let r = resolved[pkey(d.id)]
  ir.write(f, f, r.slot, clsobj, node)
}

fn emit_stmt(m, node, f) {
  match node {
    {name: 'class_d'} => emit_class(m, node, f),
    {name: 'trait_d'} => nil,
    {name: 'fn_decl'} => {
      # plain declarations emit nothing here (bodies are per-function);
      # a decorated one is a value binding: deco1(deco2(closure))
      let d = fn_decl_parts(node)
      if d.decos.size() == 0 {
        return nil
      }
      let g = closure_of[pkey(node)]
      let v = emit_decorated(m, f, d.decos, ir.closure(f, g, node))
      let rb = resolved[pkey(d.id)]
      ir.write(f, f, rb.slot, v, node)
    },
    {name: 'decl', nodes: [kw, pat, value]} => {
      let v = emit_expr(m, value, f)
      cond {
        pat.name == 'tup_pat' || pat.name == 'arr_pat' => {
          let tmp = scratch_slot(f, scratch_of[pkey(pat)])
          let n = pat.nodes.size()
          let (pl, pc) = pos_args(m, pat)
          let checked = call_pre(
            m,
            f,
            '__destr',
            [v, ir.literal(n, pat), pl, pc],
            pat,
          )
          mut ids = [ir.store_local(tmp, checked, pat)]
          mut i = 0
          while i < n {
            let id = pat.nodes[i]
            let r = resolved[pkey(id)]
            let item = ir.index(ir.local(tmp, id), ir.literal(i, id), id)
            ids.push(ir.write(f, f, r.slot, item, id))
            i = i + 1
          }
          ir.block(ids, node)
        },
        _ => {
          let r = resolved[pkey(pat)]
          let st = ir.write(f, f, r.slot, v, node)
          # a `let` yields its value when it ends a block
          ir.seq([st], ir.read(f, f, r.slot, node), node)
        },
      }
    },
    {name: 'assign', nodes: [lhs, op, value]} => emit_assign(m, node, f, nil),
    {name: 'assign_e'} => emit_assign_expr(m, node, f),
    {name: 'mut_store'} => emit_assign(m, synth_assign(node, true), f, nil),
    {name: 'passign'} => emit_passign(m, node, f),
    {name: 'pdecl', nodes: [kw, pat, value]} => {
      let tmp = scratch_slot(f, scratch_of[pkey(node)])
      fn subj() {
        ir.local(tmp, node)
      }
      let (pl, pc) = pos_args(m, pat)
      mut ids = [ir.store_local(tmp, emit_expr(m, value, f), node)]
      let fail_v = call_pre(
        m,
        f,
        '__raise',
        [
          ir.str_literal('ValueError', node),
          ir.str_literal('destructure pattern did not match value', node),
          pl,
          pc,
        ],
        node,
      )
      ids.push(ir.make_if_else(
        emit_pat_test(m, f, pat, subj, node),
        ir.nil_literal(node),
        fail_v,
        node,
      ))
      emit_pat_binds(m, f, pat, subj, ids, node)
      ir.block(ids, node)
    },
    {name: 'for', nodes: [pat, iterable, body]} => {
      let itv = emit_expr(m, iterable, f)
      let (pl, pc) = pos_args(m, node)
      let srcslot = scratch_slot(f, scratch_of[pkey(node) + '/src'])
      let itslot = scratch_slot(f, scratch_of[pkey(node)])
      let eslot = scratch_slot(f, scratch_of[pkey(node) + '/e'])
      let store_src = ir.store_local(srcslot, itv, node)
      let store_it = ir.store_local(
        itslot,
        call_pre(m, f, '__iter', [ir.local(srcslot, node), pl, pc], node),
        node,
      )
      fn itref() {
        ir.local(itslot, node)
      }
      let has = ir.call_value(
        ir.index(itref(), ir.str_literal('has_next', node), node),
        [],
        node,
      )
      let nextv = ir.call_value(
        ir.index(itref(), ir.str_literal('next', node), node),
        [],
        node,
      )
      let info = block_info[pkey(body)]
      mut pre = fresh_cells(m, f, info.base, info.high, body)
      cond {
        pat.name == 'tup_pat' || pat.name == 'arr_pat' => {
          # (k, v) in ...: next() yields a pair; unpack via its items. The
          # first slot temporarily holds the items array and is overwritten
          # last.
          let n = pat.nodes.size()
          let first = pat.nodes[0]
          let r0 = resolved[pkey(first)]
          pre.push(ir.write(
            f,
            f,
            r0.slot,
            call_pre(
              m,
              f,
              '__destr',
              [nextv, ir.literal(n, node), pl, pc],
              node,
            ),
            first,
          ))
          mut i = n - 1
          while i >= 1 {
            let id = pat.nodes[i]
            let r = resolved[pkey(id)]
            pre.push(ir.write(
              f,
              f,
              r.slot,
              ir.index(ir.read(f, f, r0.slot, id), ir.literal(i, id), id),
              id,
            ))
            i = i - 1
          }
          pre.push(ir.write(
            f,
            f,
            r0.slot,
            ir.index(
              ir.read(f, f, r0.slot, first),
              ir.literal(0, first),
              first,
            ),
            first,
          ))
        },
        _ => {
          let r = resolved[pkey(pat)]
          pre.push(ir.write(f, f, r.slot, nextv, pat))
        },
      }
      let b = emit_block_stmts(m, body, f, pre)
      let wrapped = emit_scope_of(m, f, info.base, info.high, b, body)
      let loop = ir.make_while(has, wrapped, node)
      # The iterator is disposed on every exit path -- drain, break, an
      # early return, or a throw -- via a defer over the whole statement
      # (culebra's optional-dispose contract; a no-op for iterators
      # without one).
      let closer = ir.make_defer(
        call_pre(m, f, '__closer', [itref()], node),
        node,
      )
      # While an error is already unwinding the iterator is closed quietly
      # (a throwing dispose is swallowed then) and the error goes on. The
      # scope over the two slots then releases the iterator, then the
      # iterable -- culebra's order on every exit.
      let guarded = ir.make_try(
        eslot,
        loop,
        ir.block(
          [
            call_pre(m, f, '__iter_close_quiet', [itref()], node),
            ir.make_throw(ir.local(eslot, node), node),
          ],
          node,
        ),
        node,
      )
      ir.scope(
        srcslot,
        itslot + 1,
        ir.block([store_src, store_it, closer, guarded], node),
        node,
      )
    },
    {name: 'while', nodes: [cnd, body]} => {
      let c0 = emit_expr(m, cnd, f)
      let c = cond {
        in_prelude => c0,
        _ => {
          let (pl, pc) = pos_args(m, cnd)
          call_pre(m, f, '__truthy', [c0, pl, pc], cnd)
        },
      }
      let b = emit_block(m, body, f)
      ir.make_while(c, b, node)
    },
    {name: 'return_s'} => {
      cond {
        # In a raw generator body a return finishes the iteration without
        # running the frame's defers (culebra's rule: only dispose runs
        # them), so it suspends at the end sentinel instead of returning.
        # The returned expression still evaluates; its value is discarded,
        # as culebra discards it.
        funcs[f].is_gen == true => {
          mut ids = []
          if node.nodes.size() == 1 {
            ids.push(emit_expr(m, node.nodes[0], f))
          }
          ids.push(ir.make_yield(ir.str_literal(gen_end_marker, node), node))
          ir.block(ids, node)
        },
        _ => {
          let v = cond {
            node.nodes.size() == 1 => emit_expr(m, node.nodes[0], f),
            _ => ir.nil_literal(node),
          }
          ir.make_return(emit_ret_check(m, f, v, node), node)
        },
      }
    },
    {name: 'break_s'} => ir.make_break(node),
    {name: 'continue_s'} => ir.make_continue(node),
    {name: 'throw_s', nodes: [value]} => {
      let v = emit_expr(m, value, f)
      ir.make_throw(v, node)
    },
    {name: 'yield_v', nodes: [e]} => {
      let v = emit_expr(m, e, f)
      ir.make_yield(v, node)
    },
    {name: 'yield_f', nodes: [e]} => {
      # yield from: drive the delegated iterator inline (Yield must sit in
      # the generator function itself), disposing it however this region
      # exits -- an early close of the outer generator runs the defer.
      let itv = emit_expr(m, e, f)
      let (pl, pc) = pos_args(m, node)
      let itslot = scratch_slot(f, scratch_of[pkey(node)])
      let store = ir.store_local(
        itslot,
        call_pre(m, f, '__iter', [itv, pl, pc], node),
        node,
      )
      fn itref() {
        ir.local(itslot, node)
      }
      let closer = ir.make_defer(
        call_pre(m, f, '__closer', [itref()], node),
        node,
      )
      let has = ir.call_value(
        ir.index(itref(), ir.str_literal('has_next', node), node),
        [],
        node,
      )
      let nextv = ir.call_value(
        ir.index(itref(), ir.str_literal('next', node), node),
        [],
        node,
      )
      let body = ir.block([ir.make_yield(nextv, node)], node)
      let loop = ir.make_while(has, body, node)
      ir.scope(0, 0, ir.block([store, closer, loop], node), node)
    },
    {name: 'defer_s'} => {
      let g = closure_of[pkey(node)]
      let c = ir.closure(f, g, node)
      ir.make_defer(c, node)
    },
    {name: 'bare_block', nodes: [blk]} => emit_block(m, blk, f),
    _ => emit_expr(m, node, f),
  }
}

# A scope over [base, nslots) with its release order spelled out: last
# slot first, a captured slot named through its cell -- culebra releases
# in reverse declaration order whether or not a closure holds the binding.
fn emit_scope_of(m, f, base, high, body, at) {
  let rl = []
  mut s = high - 1
  while s >= base {
    cond {
      frames.in_cell(f, s) => rl.push(ir.cell(frames.cell_of(f, s), at)),
      _ => rl.push(ir.local(s, at)),
    }
    s = s - 1
  }
  ir.scope_release(base, high, body, rl, at)
}

# Cell refreshes for a scope's own captured slots: entering the region is
# declaring anew, so closures from earlier entries keep the old box.
fn fresh_cells(m, f, base, high, at) {
  mut ids = []
  mut s = base
  while s < high {
    if frames.in_cell(f, s) {
      ids.push(ir.cell_fresh(frames.cell_of(f, s), at))
      if fwd_slots.has("{f}/{s}") {
        ids.push(ir.store_cell(
          frames.cell_of(f, s),
          ir.str_literal(unbound_marker, at),
          at,
        ))
      }
    }
    s = s + 1
  }
  ids
}

fn emit_block_stmts(m, blk, f, pre_ids) {
  mut ids = pre_ids
  for s in blk.nodes {
    let e = emit_stmt(m, s, f)
    if e != nil {
      ids.push(e)
    }
  }
  ir.block(ids, blk)
}

# Every block is a scope, whether or not it declares anything: its exit is
# where the VM resolves the drop-bearing cycles built inside it.
fn emit_block(m, blk, f) {
  let info = block_info[pkey(blk)]
  let pre = fresh_cells(m, f, info.base, info.high, blk)
  let b = emit_block_stmts(m, blk, f, pre)
  emit_scope_of(m, f, info.base, info.high, b, blk)
}

# --- Driver -------------------------------------------------------------------

fn emit_funcs(m) {
  # Records and add_func calls share indices by construction: the loop adds
  # in array order, so make_closure's func index means the same thing on
  # both sides.
  for f in range(funcs.size()) {
    let fi = funcs[f]
    in_prelude = fi.is_prelude
    mut ids = []
    # Prologue, in order: a defaulted parameter that received the missing
    # marker evaluates its default -- in this scope, so it can name earlier
    # params -- and only then is a captured parameter copied into its cell.
    let is_closure = fn_pos.has(f)
    for pi in range(fi.pspecs.size()) {
      let rec = fi.pspecs[pi]
      fn pref() {
        ir.local(pi, front.ORIGIN)
      }
      # a closure is called through call_value with whatever count the
      # caller had (lenient arity), so a parameter nothing arrived for is
      # detected by the supplied count
      fn absent() {
        ir.binary(
          'le',
          ir.intrinsic('argcount', [], front.ORIGIN),
          ir.literal(pi, front.ORIGIN),
          front.ORIGIN,
        )
      }
      cond {
        rec.dflt != nil => {
          let is_marker = ir_and(
            m,
            ir.binary(
              'eq',
              ir_typeof(m, pref(), front.ORIGIN),
              ir.str_literal('string', front.ORIGIN),
              front.ORIGIN,
            ),
            ir.binary(
              'eq',
              pref(),
              ir.str_literal(missing_marker, front.ORIGIN),
              front.ORIGIN,
            ),
            front.ORIGIN,
          )
          let missing = cond {
            is_closure => ir.make_if_else(
              absent(),
              ir_bool(m, true, front.ORIGIN),
              is_marker,
              front.ORIGIN,
            ),
            _ => is_marker,
          }
          let fill0 = ir.store_local(
            pi,
            emit_expr(m, rec.dflt, f),
            front.ORIGIN,
          )
          # a typed parameter's default is checked too; the caller places
          # the error at the call
          let fill = cond {
            rec.ty !=
              nil => ir.block(
              [
                fill0,
                ir.make_if(
                  ir.make_if_else(
                    call_pre(
                      m,
                      f,
                      '__ty_ok',
                      [
                        pref(),
                        ir.str_literal(ty_check_of(rec.ty), front.ORIGIN),
                      ],
                      front.ORIGIN,
                    ),
                    ir_bool(m, false, front.ORIGIN),
                    ir_bool(m, true, front.ORIGIN),
                    front.ORIGIN,
                  ),
                  call_pre(
                    m,
                    f,
                    '__raise_fixable',
                    [
                      ir.str_literal('TypeError', front.ORIGIN),
                      ir.str_literal(
                        "type error: parameter '" +
                          rec.pname +
                          "' expects " +
                          rec.ty,
                        front.ORIGIN,
                      ),
                    ],
                    front.ORIGIN,
                  ),
                  front.ORIGIN,
                ),
              ],
              front.ORIGIN,
            ),
            _ => fill0,
          }
          ids.push(ir.make_if(missing, fill, front.ORIGIN))
        },
        is_closure &&
          rec.pname != '__selfp' &&
          !rec.rest &&
          rec.hidden != true => {
          let (dl, dc) = fn_pos[f]
          let raise = call_pre(
            m,
            f,
            '__raise',
            [
              ir.str_literal('ArityError', front.ORIGIN),
              ir.str_literal(
                "missing required argument '" + rec.pname + "'",
                front.ORIGIN,
              ),
              ir.literal(dl, front.ORIGIN),
              ir.literal(dc, front.ORIGIN),
            ],
            front.ORIGIN,
          )
          ids.push(ir.make_if(absent(), raise, front.ORIGIN))
        },
        _ => nil,
      }
    }
    for pi in range(fi.pspecs.size()) {
      let rec = fi.pspecs[pi]
      if rec.destr != nil {
        # a destructuring parameter: unpack the hidden slot into its names
        let tp = rec.destr
        let n = tp.nodes.size()
        let (pl, pc) = pos_args(m, tp)
        ids.push(ir.store_local(
          pi,
          call_pre(
            m,
            f,
            '__destr',
            [ir.local(pi, front.ORIGIN), ir.literal(n, front.ORIGIN), pl, pc],
            front.ORIGIN,
          ),
          front.ORIGIN,
        ))
        for k in range(n) {
          let id = tp.nodes[k]
          let r = resolved[pkey(id)]
          ids.push(ir.write(
            f,
            f,
            r.slot,
            ir.index(
              ir.local(pi, front.ORIGIN),
              ir.literal(k, front.ORIGIN),
              front.ORIGIN,
            ),
            front.ORIGIN,
          ))
        }
      }
    }
    for p in range(fi.params.size()) {
      if frames.in_cell(f, p) {
        let src = ir.local(p, front.ORIGIN)
        ids.push(ir.store_cell(frames.cell_of(f, p), src, front.ORIGIN))
      }
    }
    # a binding some closure named before its declaration starts unbound
    for s in range(nslots[f]) {
      if fwd_slots.has("{f}/{s}") && frames.in_cell(f, s) {
        ids.push(ir.store_cell(
          frames.cell_of(f, s),
          ir.str_literal(unbound_marker, front.ORIGIN),
          front.ORIGIN,
        ))
      }
    }
    # __ARGS__: the positionals that overflowed the declared parameters,
    # read off the hidden trailing slots by the supplied count
    if args_info.has(f) {
      let ai = args_info[f]
      mut hidden = []
      for k in range(ai.count) {
        hidden.push(ir.local(ai.first + k, front.ORIGIN))
      }
      let overflow = ir.binary(
        'sub',
        ir.intrinsic('argcount', [], front.ORIGIN),
        ir.literal(ai.first, front.ORIGIN),
        front.ORIGIN,
      )
      ids.push(ir.write(
        f,
        f,
        ai.slot,
        call_pre(
          m,
          f,
          '__first_n',
          [ir.array_lit(hidden, front.ORIGIN), overflow],
          front.ORIGIN,
        ),
        front.ORIGIN,
      ))
    }
    # a *rest slot: open the binder's mark, or (a closure) pack the slot
    # and the hidden overflow by the supplied count
    if rest_info.has(f) {
      let ri = rest_info[f]
      mut hidden = []
      for k in range(ri.count) {
        hidden.push(ir.local(ri.first + k, front.ORIGIN))
      }
      let n = ir.binary(
        'sub',
        ir.intrinsic('argcount', [], front.ORIGIN),
        ir.literal(ri.slot, front.ORIGIN),
        front.ORIGIN,
      )
      ids.push(ir.write(
        f,
        f,
        ri.slot,
        call_pre(
          m,
          f,
          '__rest_fix',
          [
            ir.local(ri.slot, front.ORIGIN),
            ir.array_lit(hidden, front.ORIGIN),
            n,
            ir.bool_literal(ri.count > 0, front.ORIGIN),
          ],
          front.ORIGIN,
        ),
        front.ORIGIN,
      ))
    }
    let rw = fi.gen_raw
    if rw != nil {
      # The wrapper's whole body: call the raw generator (its closure built
      # here, so the capture chain resolves in this frame) with every
      # parameter slot as-is -- defaults are already filled by the prologue
      # above -- and hand back the protocol object over the activation.
      mut cargs = []
      for pi2 in range(fi.params.size()) {
        cargs.push(ir.local(pi2, front.ORIGIN))
      }
      let rc = ir.call_value(
        ir.closure(f, rw, front.ORIGIN),
        cargs,
        front.ORIGIN,
      )
      ids.push(ir.make_return(
        call_pre(m, f, '__gen_wrap', [rc], front.ORIGIN),
        front.ORIGIN,
      ))
    }
    if self_closure.has(f) {
      let outer = self_closure[f]
      let outer_ref = cond {
        outer.kind == 'var' => {
          ir.read(f, outer.owner, outer.slot, front.ORIGIN)
        },
        _ => ir.nil_literal(front.ORIGIN),
      }
      let picked = call_pre(
        m,
        f,
        '__self_pick',
        [ir.local(0, front.ORIGIN), outer_ref],
        front.ORIGIN,
      )
      ids.push(ir.write(f, f, self_slot[f], picked, front.ORIGIN))
    }
    for s in fi.stmts {
      let e = emit_stmt(m, s, f)
      if e != nil {
        ids.push(e)
      }
    }
    # a declared return type also covers the value the body falls off with
    if fi.has('ret') && fi.is_gen != true && fi.stmts.size() > 0 {
      let last = fi.stmts[fi.stmts.size() - 1]
      cond {
        is_value_stmt(last) &&
          ids.size() >
            0 => ids[ids.size() -
          1] = emit_ret_check(m, f, ids[ids.size() - 1], last),
        _ => ids.push(emit_ret_check(m, f, ir.nil_literal(front.ORIGIN), last)),
      }
    }
    if fi.is_gen == true {
      # The end sentinel: falling off the body suspends here forever
      # instead of returning, keeping the frame's defers pending for a
      # dispose. It sits inside the body's own Scope, so nothing has run
      # its exit yet.
      ids.push(ir.make_yield(
        ir.str_literal(gen_end_marker, front.ORIGIN),
        front.ORIGIN,
      ))
    }
    mut body = ir.block(ids, front.ORIGIN)
    let info = block_info[fi.body_key]
    # every function body is a scope, locals or not: its exit is where the
    # VM resolves the drop-bearing cycles the body (or its callees) built.
    # The entry function's own bindings are never released by its scope
    # (culebra keeps top-level bindings to the end, without drop); the
    # empty range still gives its defers a scope to run at
    body = cond {
      f == 0 => ir.scope(0, 0, body, front.ORIGIN),
      _ => emit_scope_of(m, f, info.base, info.high, body, front.ORIGIN),
    }
    if f == 0 {
      # whatever escapes the program is reported the way culebra reports it
      let caught = ir.local(uncaught_slot, front.ORIGIN)
      body = ir.make_try(
        uncaught_slot,
        body,
        call_pre(m, f, '__report_uncaught', [caught], front.ORIGIN),
        front.ORIGIN,
      )
    }
    let func = ir.add_func(
      fi.name,
      f,
      nslots[f] + nscratch[f],
      fi.params.size(),
      body,
    )
    if fi.is_gen == true {
      m.set_generator(func: func)
    }
    m.set_lenient_arity(func: func)
    # a prelude helper's closure has no identity the program can see, so
    # every call site shares one instead of building its own
    if fi.is_prelude && ir.frames.num_captures(f) == 0 {
      m.set_singleton(func: func)
    }
    ir.name_captures(func, f, |i, _o, _s| "cap{i}")
  }
  in_prelude = false
}

# A node the binder invents: it carries its own position key, so it can
# never alias a parsed node's line:column in the side tables.
mut synth_count = 0
fn synth(name, nodes, at) {
  synth_count = synth_count + 1
  {
    name: name,
    nodes: nodes,
    line: at.line,
    column: at.column,
    key: "s{synth_count}",
  }
}

# Surface forms the binder never sees: a statement modifier becomes the
# `if` it stands for, a comma-separated for target becomes the tuple
# pattern, and a typed `let` drops its annotation.
fn desugar(node) {
  if node.nodes == nil {
    return nil
  }
  mut i = 0
  while i < node.nodes.size() {
    let c = node.nodes[i]
    cond {
      c.name == 'mod_stmt' => {
        let [stmt, kw, cnd] = c.nodes
        let test = cond {
          kw.token ==
            'unless' => {
            name: 'lnot',
            nodes: [cnd],
            line: cnd.line,
            column: cnd.column,
          },
          _ => cnd,
        }
        node.nodes[i] = synth('if', [test, synth('block', [stmt], stmt)], c)
      },
      c.name ==
        'bare_tup' => node.nodes[i] = {
        name: 'tup_pat',
        nodes: c.nodes,
        line: c.line,
        column: c.column,
      },
      c.name == 'typed_pat' => node.nodes[i] = c.nodes[0],
      _ => nil,
    }
    desugar(node.nodes[i])
    i = i + 1
  }
  nil
}

fn build(m, prelude_tree, root) {
  desugar(root)
  # main is funcs[0]; the prelude's functions follow; then the program's.
  let main = new_func(nil, 'main', root.nodes, "0:0")

  in_prelude = true
  for s in prelude_tree.nodes {
    let [id, prms, blk] = s.nodes
    prelude_named[id.token] = new_func(nil, id.token, blk.nodes, pkey(blk))
  }
  for s in prelude_tree.nodes {
    let g = prelude_named[s.nodes[0].token]
    walk_fn(g, s.nodes[1].nodes)
  }
  in_prelude = false

  enter_scope(main)
  hoist_bare(main, root.nodes)
  let has_defer = scan_body_stmts(main, root.nodes, "0:0")
  leave_scope(main)
  uncaught_slot = nslots[main]
  nslots[main] = uncaught_slot + 1
  block_info["0:0"] = {base: 0, high: nslots[main]}

  frames.solve()
  emit_funcs(m)
}

let want_ir = Sys.argv.contains('--ir')
let want_bc = Sys.argv.contains('--bc')
let cli = Sys.argv.filter(|a| a != '--ir' && a != '--bc')
if cli.empty() {
  println("usage: culebra mini_culebra.cul [--ir | --bc] PROGRAM.cul...")
  Sys.exit(1)
}

# The grammar and the prelude parse once; every program after the first
# reuses both, which is what makes a many-program batch cheap.
let prelude_tree = PEG.parse(grammar, prelude_src, path: '<prelude>')

mut had_err = false
for path in cli {
  if cli.size() > 1 {
    # Batch mode: a marker line before each program so a driver script can
    # split the concatenated output back into per-program chunks.
    println('-----8<----- ' + path.split('/')[-1])
  }
  # Positions repeat across programs, so nothing keyed by position -- and
  # no per-function table -- may survive from one compile into the next.
  funcs = []
  frames = front.Frames.new()
  nslots = []
  nscratch = []
  closure_of = {}
  resolved = {}
  scratch_of = {}
  block_info = {}
  prelude_named = {}
  self_closure = {}
  self_slot = {}
  fn_pos = {}
  own_binding = {}
  pending_own = nil
  local_name_sets = {}
  fwd_slots = {}
  args_info = {}
  ret_specs = {}
  rest_info = {}
  synth_count = 0
  predeclared = {}
  runtime_immut = {}
  bare_init = {}
  uncaught_slot = 0
  pat_mut = false
  in_prelude = false
  scope_stack = []
  loop_depth = {}
  walk_cursor = {}
  classes = {}
  traits = {}
  try {
    let tree = PEG.parse(grammar, FS.read(path), path: path)
    let m = CodeGen.Module.new()
    ir = front.Emitter.new(m, frames)
    build(m, prelude_tree, tree)
    m.verify()
    if want_ir {
      print(m.dump_ir())
    } else if want_bc {
      print(m.dump_bc())
    } else {
      # culebra releases its top-level bindings without running drop
      m.set_entry_frame_drops(on: false)
      m.run()
    }
  } catch e {
    match e {
      {kind: 'MiniError'} => println("{path}:{e.line}:{e.col}: {e.message}"),
      {kind: 'PEGError'} => println(e.message),
      {kind: 'IrError'} => {
        # the program's own uncaught report already printed; only the
        # exit status is left to mirror
        cond {
          e.message.contains(exit_marker) => {
            if cli.size() == 1 {
              Sys.exit(255)
            }
          },
          _ => println("{path}:{e.line}:{e.col}: {e.message}"),
        }
      },
      _ => throw e,
    }
    had_err = true
  }
}
if had_err {
  Sys.exit(1)
}
