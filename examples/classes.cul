class Vec2 {
  new(x, y)  { self.x = x; self.y = y }
  __add__(o) { Vec2.new(self.x + o.x, self.y + o.y) }
  __mul__(k) { Vec2.new(self.x * k, self.y * k) }
  __str__()  { "({self.x}, {self.y})" }       # how the value prints
  get len()  { Math.sqrt(to_float(self.x * self.x + self.y * self.y)) }
}

let a = Vec2.new(1, 2)
let b = Vec2.new(3, 4)
println("a + b   = {a + b}")
println("a * 10  = {a * 10}")
println("|b|     = {b.len}")                  # getter: reads like a field
