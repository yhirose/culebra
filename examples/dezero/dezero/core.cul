# dezero/core.cul — the autodiff engine: Variable, Function application,
# and the arithmetic operators. Ported from the "DeZero" framework taught in
# oreilly-japan/deep-learning-from-scratch-3 (MIT license, Koki Saitoh).
#
# Variable.data holds a Tensor. A scalar is a 1-element [1] Tensor rather
# than numpy's 0-d array — Tensor has no 0-d form, and Tensor.item()/
# Tensor.from([x]) give the same round trip a 0-d ndarray would.
#
# There is no class inheritance in Culebra, so this port departs from the
# original's class hierarchy in three deliberate ways:
#   - `Function` is not a base class; every op is its own class with
#     `forward`/`backward` methods, and the shared bookkeeping (generation
#     tracking, creator wiring) lives in the free functions `apply1`/`apply2`
#     below instead of in `__call__`.
#   - `Parameter` is not a Variable subclass, just `Variable` itself under a
#     second name — its only job upstream was an `isinstance` marker for
#     auto-registering fields in `Layer.__setattr__`, which this port's
#     `layers.cul` does explicitly instead of by type-sniffing.
#   - Every function here produces exactly one output Variable (nothing in
#     this port needs the general multi-output case), so weakref-guarded
#     output *lists* collapse to a single plain `output` field.

# --- global backprop switch ---------------------------------------------

mut enable_backprop = true
mut training = true

# Bumped once per top-level `Variable.backward()` call and stamped onto
# each visited Function's `seen` field, so "already queued" is scoped to
# *this* sweep rather than remembered forever — a persistent flag would
# stay latched from an op's first backward() and silently skip it on
# every later one, which double-backprop relies on revisiting (the
# backward pass's own ops form a new graph that can lead back into nodes
# a *previous* backward() call already walked).
mut backward_epoch = 0

fn no_grad(body) {
  saved = enable_backprop
  enable_backprop = false
  defer {
    enable_backprop = saved
  }
  body()
}

fn test_mode(body) {
  saved = training
  training = false
  defer {
    training = saved
  }
  body()
}

fn is_training() {
  training
}

# --- Variable -------------------------------------------------------------

fn as_array(x) {
  match x {
    t: Tensor => t,
    n: Long => Tensor.from([to_float(n)]),
    f: Float => Tensor.from([f]),
    _ => x,
  }
}

fn as_variable(x) {
  match x {
    v: Variable => v,
    _ => Variable(as_array(x)),
  }
}

# Reinserts a size-1 dim at `axis` — the shape an axis-reducing op's output
# would have under `keepdims=true`, needed wherever a reduced gradient must
# be reshaped before it can broadcast back against the pre-reduction shape.
fn insert_axis(shape, axis) {
  shape.slice(0, axis) + [1] + shape.slice(axis + 1, shape.size())
}

fn raw_elementwise(t, f) {
  # `Tensor.to_array()` refuses rank > 2 (needed by e.g. a conv/pooling
  # activation on a [N,C,H,W] tensor), so flatten to 1-D first — a plain
  # `map` over that also puts every element at the same depth.
  shape = t.shape()
  flat = t.reshape([shape.product()]).to_array()
  Tensor.from(flat.map(f)).reshape(shape)
}

class Variable {
  data = nil
  name = nil
  grad = nil
  creator = nil
  generation = 0

  new(data, name = nil) {
    self.data = data
    self.name = name
  }

  get shape() {
    self.data.shape()
  }

  get ndim() {
    self.shape.size()
  }

  get size() {
    self.shape.product()
  }

  __str__() {
    if self.data == nil {
      "variable(None)"
    } else {
      "variable({self.data.to_array()})"
    }
  }

  set_creator(f) {
    self.creator = f
    self.generation = f.generation + 1
  }

  unchain() {
    self.creator = nil
  }

  cleargrad() {
    self.grad = nil
  }

  # Reverse-mode sweep in generation order, so a diamond in the graph is
  # never processed before every path into it has contributed its share.
  backward(retain_grad = false, create_graph = false) {
    if self.grad == nil {
      self.grad = Variable(Tensor.ones(self.shape))
    }

    backward_epoch += 1
    my_epoch = backward_epoch

    mut funcs = []
    fn add_func(node) {
      if node.seen != my_epoch {
        node.seen = my_epoch
        funcs.push(node)
        funcs.sort_by(|n| n.generation)
      }
    }
    add_func(self.creator) if self.creator != nil

    while !funcs.empty() {
      f = funcs.pop()
      gy = f.output.grad

      # Upstream's `with using_config('enable_backprop', create_graph)` spans
      # the accumulation below as well, not just `f.backward` -- with
      # create_graph off, `x.grad + gx` must not record a graph of its own.
      saved = enable_backprop
      enable_backprop = create_graph
      defer {
        enable_backprop = saved
      }

      gxs = f.backward(gy)
      gxs_list = if f.inputs.size() == 1 {
        [gxs]
      } else {
        gxs.to_array()
      }

      for i in range(f.inputs.size()) {
        x = f.inputs[i]
        gx = gxs_list[i]
        x.grad = if x.grad == nil {
          gx
        } else {
          x.grad + gx
        }
        add_func(x.creator) if x.creator != nil
      }

      # Upstream keeps `Function.outputs` as weakrefs, so the graph is acyclic
      # and refcounting frees it as soon as the caller drops the output.
      # Culebra has no weak reference, so the strong back-edge is dropped here
      # instead: `!create_graph` already declares this graph spent (the line
      # above discards its gradients for the same reason).
      f.output.grad = nil if !retain_grad
      f.output = nil if !create_graph
    }
  }

  unchain_backward() {
    if self.creator != nil {
      mut funcs = [self.creator]
      while !funcs.empty() {
        f = funcs.pop()
        for x in f.inputs {
          if x.creator != nil {
            funcs.push(x.creator)
            x.unchain()
          }
        }
      }
    }
  }

  __add__(other) {
    add(self, other)
  }
  __mul__(other) {
    mul(self, other)
  }
  __neg__() {
    neg(self)
  }
  __sub__(other) {
    sub(self, other)
  }
  __div__(other) {
    div(self, other)
  }
  __pow__(c) {
    pow_(self, c)
  }

  reshape(shape) {
    reshape(self, shape)
  }
  transpose(axes = nil) {
    transpose(self, axes)
  }
  get T() {
    transpose(self, nil)
  }
  sum(axis = nil, keepdims = false) {
    sum(self, axis, keepdims)
  }
  matmul(other) {
    matmul(self, other)
  }
  dot(other) {
    matmul(self, other)
  }
  max(axis = nil, keepdims = false) {
    max_(self, axis, keepdims)
  }
  min(axis = nil, keepdims = false) {
    min_(self, axis, keepdims)
  }
}

let Parameter = Variable

# --- applying a Function to Variables --------------------------------------
#
# Every op class below carries its own `forward`/`backward` plus three
# bookkeeping fields (`generation`, `inputs`, `output`, `seen`) that these
# two helpers attach after calling `forward`. Mirrors `Function.__call__`
# in the original, minus the weakref plumbing Culebra's cycle collector
# makes unnecessary.

fn apply1(f, x0) {
  v0 = as_variable(x0)
  y = f.forward(v0.data)
  out = Variable(as_array(y))
  if enable_backprop {
    f.generation = v0.generation
    f.inputs = [v0]
    f.output = out
    f.seen = -1
    out.set_creator(f)
  }
  out
}

fn apply2(f, x0, x1) {
  v0 = as_variable(x0)
  v1 = as_variable(x1)
  y = f.forward(v0.data, v1.data)
  out = Variable(as_array(y))
  if enable_backprop {
    f.generation = Math.max(v0.generation, v1.generation)
    f.inputs = [v0, v1]
    f.output = out
    f.seen = -1
    out.set_creator(f)
  }
  out
}

# --- shape reduction / broadcasting -----------------------------------------
#
# `sum_to`/`broadcast_to` invert each other and are needed by the four
# arithmetic ops' backward passes to un-broadcast a gradient, so they live
# here rather than in functions.cul (which would make the two files import
# each other — not allowed).

fn raw_sum_to(x, shape) {
  mut t = x
  while t.shape().size() > shape.size() {
    t = t.sum(0)
  }
  for i in range(shape.size()) {
    if shape[i] == 1 && t.shape()[i] != 1 {
      reduced = t.shape().slice(0, i) +
        [1] +
        t.shape().slice(i + 1, t.shape().size())
      t = t.sum(i).reshape(reduced)
    }
  }
  t
}

fn raw_broadcast_to(x, shape) {
  x * Tensor.ones(shape)
}

class SumTo {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(shape) {
    self.shape = shape
  }

  forward(x) {
    self.x_shape = x.shape()
    raw_sum_to(x, self.shape)
  }

  backward(gy) {
    broadcast_to(gy, self.x_shape)
  }
}

fn sum_to(x, shape) {
  if x.shape == shape {
    as_variable(x)
  } else {
    apply1(SumTo(shape), x)
  }
}

class BroadcastTo {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(shape) {
    self.shape = shape
  }

  forward(x) {
    self.x_shape = x.shape()
    raw_broadcast_to(x, self.shape)
  }

  backward(gy) {
    sum_to(gy, self.x_shape)
  }
}

fn broadcast_to(x, shape) {
  if x.shape == shape {
    as_variable(x)
  } else {
    apply1(BroadcastTo(shape), x)
  }
}

class Sum {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(axis = nil, keepdims = false) {
    self.axis = axis
    self.keepdims = keepdims
  }

  forward(x) {
    self.x_shape = x.shape()
    mut y = if self.axis == nil {
      Tensor.from([x.sum()])
    } else {
      x.sum(self.axis)
    }
    if self.keepdims && self.axis != nil {
      y = y.reshape(insert_axis(self.x_shape, self.axis))
    }
    y
  }

  backward(gy) {
    # `gy`'s shape lost the reduced axis (unless keepdims already kept a 1
    # there); reinsert it as a size-1 dim so broadcast_to can align the
    # remaining axes against x_shape instead of the numpy trailing-axis
    # broadcast rule picking the wrong one.
    gy_r = if self.axis == nil || self.keepdims {
      gy
    } else {
      reshape(gy, insert_axis(self.x_shape, self.axis))
    }
    broadcast_to(gy_r, self.x_shape)
  }
}

fn sum(x, axis = nil, keepdims = false) {
  apply1(Sum(axis, keepdims), x)
}

# --- four arithmetic operators + power --------------------------------------

class Add {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x0, x1) {
    self.x0_shape = x0.shape()
    self.x1_shape = x1.shape()
    x0 + x1
  }

  backward(gy) {
    if self.x0_shape == self.x1_shape {
      (gy, gy)
    } else {
      (sum_to(gy, self.x0_shape), sum_to(gy, self.x1_shape))
    }
  }
}

fn add(x0, x1) {
  apply2(Add(), x0, x1)
}

class Mul {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x0, x1) {
    x0 * x1
  }

  backward(gy) {
    (x0, x1) = (self.inputs[0], self.inputs[1])
    gx0 = gy * x1
    gx1 = gy * x0
    if x0.shape == x1.shape {
      (gx0, gx1)
    } else {
      (sum_to(gx0, x0.shape), sum_to(gx1, x1.shape))
    }
  }
}

fn mul(x0, x1) {
  apply2(Mul(), x0, x1)
}

class Neg {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x) {
    raw_neg(x)
  }

  backward(gy) {
    neg(gy)
  }
}

fn raw_neg(x) {
  x * -1.0
}

fn neg(x) {
  apply1(Neg(), x)
}

class Sub {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x0, x1) {
    self.x0_shape = x0.shape()
    self.x1_shape = x1.shape()
    x0 - x1
  }

  backward(gy) {
    gx0 = gy
    gx1 = neg(gy)
    if self.x0_shape == self.x1_shape {
      (gx0, gx1)
    } else {
      (sum_to(gx0, self.x0_shape), sum_to(gx1, self.x1_shape))
    }
  }
}

fn sub(x0, x1) {
  apply2(Sub(), x0, x1)
}

class Div {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x0, x1) {
    x0 / x1
  }

  backward(gy) {
    (x0, x1) = (self.inputs[0], self.inputs[1])
    gx0 = gy / x1
    gx1 = gy * raw_neg(x0 / (x1 * x1))
    if x0.shape == x1.shape {
      (gx0, gx1)
    } else {
      (sum_to(gx0, x0.shape), sum_to(gx1, x1.shape))
    }
  }
}

fn div(x0, x1) {
  apply2(Div(), x0, x1)
}

class Pow {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(c) {
    self.c = c
  }

  forward(x) {
    x.pow(self.c)
  }

  backward(gy) {
    x = self.inputs[0]
    c = self.c
    mul(mul(c, pow_(x, c - 1)), gy)
  }
}

fn pow_(x, c) {
  apply1(Pow(c), x)
}

# --- reshape / transpose ----------------------------------------------------

class Reshape {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(shape) {
    self.shape = shape
  }

  forward(x) {
    self.x_shape = x.shape()
    x.reshape(self.shape)
  }

  backward(gy) {
    reshape(gy, self.x_shape)
  }
}

fn reshape(x, shape) {
  v = as_variable(x)
  if v.shape == shape {
    v
  } else {
    apply1(Reshape(shape), v)
  }
}

fn raw_transpose(x, axes) {
  axes == nil ? x.transpose() : x.permute(axes)
}

# `axes[i]` names which input axis becomes output axis `i`; the inverse
# permutation (needed to route `gy` back to input-axis order in
# `Transpose.backward`) sends that same axis the other way: `inv[axes[i]] = i`.
fn invert_permutation(axes) {
  n = axes.size()
  mut inv = range(n).map(|_| 0).collect()
  for i in 0..n {
    inv[axes[i]] = i
  }
  inv
}

class Transpose {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(axes = nil) {
    self.axes = axes
  }

  forward(x) {
    raw_transpose(x, self.axes)
  }

  backward(gy) {
    transpose(gy, self.axes == nil ? nil : invert_permutation(self.axes))
  }
}

fn transpose(x, axes = nil) {
  apply1(Transpose(axes), x)
}

# --- matrix multiply ---------------------------------------------------------

# matmul's VJP needs the *matrix* transpose of an operand: only the last two
# axes swap, the batch axes stay put. `transpose(v)` with no axes reverses
# every axis, which coincides with that at rank 2 and not above it -- a
# batched `[B, T, D]` operand came back as `[D, T, B]`, so `Tensor.dot`
# rejected the shapes and batched attention could not backprop at all.
fn swap_last_two_axes(v) {
  n = as_variable(v).ndim
  if n <= 2 {
    transpose(v)
  } else {
    transpose(v, range(n - 2).collect() + [n - 1, n - 2])
  }
}

class MatMul {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x, w) {
    x.dot(w)
  }

  backward(gy) {
    (x, w) = (self.inputs[0], self.inputs[1])
    (matmul(gy, swap_last_two_axes(w)), matmul(swap_last_two_axes(x), gy))
  }
}

fn matmul(x, w) {
  apply2(MatMul(), x, w)
}

# --- max / min --------------------------------------------------------------
#
# The backward mask rides `Tensor.eq()`, which broadcasts `b` against `a` on
# its own. Ties (more than one element equal to the max) split the incoming
# gradient across every tied position, same as upstream.

# `Max`/`Min` share everything but which Tensor reduction `forward` calls —
# both route their (identical) backward math through this one function,
# keyed off `f`'s own stored `axis`/`x_shape`/`y_data`.
fn arg_reduce_backward(f, gy) {
  x = f.inputs[0]
  shape = if f.axis == nil {
    f.x_shape.map(|_| 1)
  } else {
    insert_axis(f.x_shape, f.axis)
  }
  gy_r = reshape(gy, shape)
  y_r = Variable(f.y_data.reshape(shape))
  cond = x.data.eq(y_r.data)
  broadcast_to(gy_r, f.x_shape) * as_variable(cond)
}

class Max {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(axis = nil, keepdims = false) {
    self.axis = axis
    self.keepdims = keepdims
  }

  forward(x) {
    self.x_shape = x.shape()
    y = if self.axis == nil {
      Tensor.from([x.max()])
    } else {
      x.max(self.axis)
    }
    self.y_data = y
    y
  }

  backward(gy) {
    arg_reduce_backward(self, gy)
  }
}

fn max_(x, axis = nil, keepdims = false) {
  apply1(Max(axis, keepdims), x)
}

class Min {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(axis = nil, keepdims = false) {
    self.axis = axis
    self.keepdims = keepdims
  }

  # Tensor has `.max()` but no `.min()`.
  forward(x) {
    self.x_shape = x.shape()
    neg_x = x * -1.0
    y = if self.axis == nil {
      Tensor.from([neg_x.max()]) * -1.0
    } else {
      neg_x.max(self.axis) * -1.0
    }
    self.y_data = y
    y
  }

  backward(gy) {
    arg_reduce_backward(self, gy)
  }
}

fn min_(x, axis = nil, keepdims = false) {
  apply1(Min(axis, keepdims), x)
}

# --- narrow (any-axis slice) -------------------------------------------------
#
# `.slice()` (axis 0 only) already has a native VJP; `.narrow()` (any axis)
# doesn't (see stdlib.md's forward-only list), so this hand-derives one.
# The gradient scatters gy back into a zero buffer of the input's own shape
# at the same window -- exactly `.pad()`'s job. `.pad()` is itself
# forward-only, but that's fine here: backward only needs to produce a raw
# gradient *value*, not a further differentiable node, same reasoning as
# Max/Min's backward above calling raw Tensor ops directly.

class Narrow {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(axis, start, end) {
    self.axis = axis
    self.start = start
    self.end = end
  }

  forward(x) {
    self.x_len = x.shape()[self.axis]
    x.narrow([self.axis, self.start, self.end])
  }

  backward(gy) {
    after = self.x_len - self.end
    as_variable(gy.data.pad([self.axis, self.start, after]))
  }
}

fn narrow(x, axis, start, end) {
  apply1(Narrow(axis, start, end), x)
}

# --- concat (narrow's inverse) -----------------------------------------------
#
# Two operands only (mirrors matmul/add's own apply2 arity) -- fold
# pairwise for more than two parts. Backward slices gy back into each
# part's own window along `axis`, raw (same reasoning as Narrow's own
# backward above).

class Concat {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(axis) {
    self.axis = axis
  }

  forward(a, b) {
    self.a_len = a.shape()[self.axis]
    self.b_len = b.shape()[self.axis]
    Tensor.concat([a, b], self.axis)
  }

  backward(gy) {
    axis = self.axis
    ga = as_variable(gy.data.narrow([axis, 0, self.a_len]))
    gb = as_variable(gy.data.narrow([
      axis,
      self.a_len,
      self.a_len + self.b_len,
    ]))
    (ga, gb)
  }
}

fn concat2(a, b, axis = 0) {
  apply2(Concat(axis), a, b)
}

# --- elementwise select (Tensor.where) ---------------------------------------
#
# `cond` gets no gradient (matches numpy/PyTorch's own where()), so it
# rides as a plain field on the Function instance rather than a tracked
# apply2 input -- only `a`/`b` go through the graph.

class Where {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(cond) {
    self.cond = cond
  }

  forward(a, b) {
    Tensor.where(self.cond, a, b)
  }

  backward(gy) {
    da = gy * as_variable(self.cond)
    db = gy * as_variable(Tensor.ones(self.cond.shape()) - self.cond)
    (da, db)
  }
}

fn where_(cond, a, b) {
  apply2(Where(cond), a, b)
}

export {Variable, Parameter, as_array, as_variable, no_grad, test_mode, is_training, apply1, apply2, add, sub, mul, neg, div, pow_, reshape, transpose, sum, sum_to, broadcast_to, matmul, max_, min_, narrow, concat2, where_, raw_sum_to, raw_broadcast_to, raw_elementwise, insert_axis}
