# dezero/layers.cul — parameterized building blocks (Linear, RNN, LSTM,
# EmbedID, BatchNorm) on top of core.cul/functions.cul. Ported from the
# "DeZero" framework taught in oreilly-japan/deep-learning-from-scratch-3
# (MIT license, Koki Saitoh).
#
# Upstream's `Layer` base class exists only to give every layer a shared
# `params()`/`cleargrads()`/`__call__` for free via inheritance, plus a
# `__setattr__` hook that auto-registers any field holding a `Parameter` or
# a nested `Layer`. Culebra has neither inheritance nor attribute hooks, so
# each class here just writes its own three-line `params()` explicitly, and
# `__call__` is Culebra's own operator-overload mechanism (a class with
# `__call__` is invocable — `layer(x)` — no base class involved).

import dz from './core.cul'
import F from './functions.cul'

fn cleargrads(target) {
  for p in target.params() {
    p.cleargrad()
  }
}

# --- Linear ------------------------------------------------------------

class Linear {
  w = nil
  b = nil
  out_size = 0
  nobias = false

  new(out_size, nobias = false, in_size = nil) {
    self.out_size = out_size
    self.nobias = nobias
    self.b = nobias ? nil : dz.Parameter(Tensor.zeros(1, out_size))
    if in_size != nil {
      self.init_w(in_size)
    }
  }

  init_w(in_size) {
    scale = Math.sqrt(1.0 / to_float(in_size))
    self.w = dz.Parameter(Tensor.randn(in_size, self.out_size) * scale)
  }

  forward(x) {
    if self.w == nil {
      self.init_w(dz.as_variable(x).shape[1])
    }
    F.linear(x, self.w, self.b)
  }

  __call__(x) {
    self.forward(x)
  }

  params() {
    self.b == nil ? [self.w] : [self.w, self.b]
  }
}

# --- RNN (Elman, tanh) ---------------------------------------------------

class RNN {
  h = nil

  new(hidden_size, in_size = nil) {
    self.x2h = Linear(hidden_size, false, in_size)
    self.h2h = Linear(hidden_size, true, hidden_size)
  }

  reset_state() {
    self.h = nil
  }

  forward(x) {
    pre = self.h == nil ? self.x2h(x) : self.x2h(x) + self.h2h(self.h)
    h_new = F.tanh(pre)
    self.h = h_new
    h_new
  }

  __call__(x) {
    self.forward(x)
  }

  params() {
    self.x2h.params() + self.h2h.params()
  }
}

# --- LSTM ----------------------------------------------------------------

class LSTM {
  h = nil
  c = nil

  new(hidden_size, in_size = nil) {
    self.x2f = Linear(hidden_size, false, in_size)
    self.x2i = Linear(hidden_size, false, in_size)
    self.x2o = Linear(hidden_size, false, in_size)
    self.x2u = Linear(hidden_size, false, in_size)
    self.h2f = Linear(hidden_size, true, hidden_size)
    self.h2i = Linear(hidden_size, true, hidden_size)
    self.h2o = Linear(hidden_size, true, hidden_size)
    self.h2u = Linear(hidden_size, true, hidden_size)
  }

  reset_state() {
    self.h = nil
    self.c = nil
  }

  forward(x) {
    (f, i, o, u) = if self.h == nil {
      (
        F.sigmoid(self.x2f(x)),
        F.sigmoid(self.x2i(x)),
        F.sigmoid(self.x2o(x)),
        F.tanh(self.x2u(x)),
      )
    } else {
      (
        F.sigmoid(self.x2f(x) + self.h2f(self.h)),
        F.sigmoid(self.x2i(x) + self.h2i(self.h)),
        F.sigmoid(self.x2o(x) + self.h2o(self.h)),
        F.tanh(self.x2u(x) + self.h2u(self.h)),
      )
    }

    c_new = self.c == nil ? i * u : f * self.c + i * u
    h_new = o * F.tanh(c_new)
    self.h = h_new
    self.c = c_new
    h_new
  }

  __call__(x) {
    self.forward(x)
  }

  params() {
    self.x2f.params() +
      self.x2i.params() +
      self.x2o.params() +
      self.x2u.params() +
      self.h2f.params() +
      self.h2i.params() +
      self.h2o.params() +
      self.h2u.params()
  }
}

# --- embedding lookup ------------------------------------------------------

class EmbedID {
  new(in_size, out_size) {
    self.w = dz.Parameter(Tensor.randn(in_size, out_size))
  }

  forward(idx) {
    F.embed_id(idx, self.w)
  }

  __call__(idx) {
    self.forward(idx)
  }

  params() {
    [self.w]
  }
}

# --- batch normalization ---------------------------------------------------
#
# Weight shape follows this port's `[1, D]` row-vector convention (matches
# `Linear`'s bias), so the running stats broadcast against a `[N, D]` batch
# the same way a bias does.

class BatchNorm {
  gamma = nil
  beta = nil
  avg_mean = nil
  avg_var = nil
  decay = 0.9
  eps = 2.0e-5

  init_params(d) {
    self.gamma = dz.Parameter(Tensor.ones(1, d))
    self.beta = dz.Parameter(Tensor.zeros(1, d))
    self.avg_mean = dz.Variable(Tensor.zeros(1, d))
    self.avg_var = dz.Variable(Tensor.ones(1, d))
  }

  forward(x) {
    v = dz.as_variable(x)
    if self.gamma == nil {
      self.init_params(v.shape[1])
    }

    (mean, var) = if dz.is_training() {
      n = to_float(v.shape[0])
      batch_mean = dz.reshape(v.sum(0) * (1.0 / n), [1, v.shape[1]])
      centered = v - batch_mean
      batch_var = dz.reshape(
        (centered * centered).sum(0) * (1.0 / n),
        [1, v.shape[1]],
      )
      # `Tensor.eval` here is load-bearing, not a style choice: combining a
      # tensor straight out of `.reshape()` with further arithmetic before
      # it has been forced once produces a wrong result (silently drops the
      # `* decay` term) — reproduced with plain Tensor code with no
      # Variable/autograd involved. Evaluating right after reshape, before
      # folding it into the running average, sidesteps it.
      Tensor.eval(batch_mean.data, batch_var.data)
      self.avg_mean.data = self.avg_mean.data * self.decay +
        batch_mean.data * (1.0 - self.decay)
      self.avg_var.data = self.avg_var.data * self.decay +
        batch_var.data * (1.0 - self.decay)
      Tensor.eval(self.avg_mean.data, self.avg_var.data)
      (batch_mean, batch_var)
    } else {
      (self.avg_mean, self.avg_var)
    }

    std = dz.pow_(var + self.eps, 0.5)
    xhat = (v - mean) / std
    self.gamma * xhat + self.beta
  }

  __call__(x) {
    self.forward(x)
  }

  params() {
    self.gamma == nil ? [] : [self.gamma, self.beta]
  }
}

# --- layer normalization -----------------------------------------------
#
# Normalizes each sample independently over its own last (feature) axis,
# unlike BatchNorm which normalizes each feature over the batch axis --
# so there are no running stats to track, and train/eval do the same
# computation. This is the normalization Transformer blocks use. gamma/
# beta keep BatchNorm's `[1, D]` row-vector convention: broadcasting
# right-aligns trailing dims, so `[1, D]` matches a `[..., D]` input of
# any rank (verified against `[N, S, D]`, the shape a Transformer block
# feeds it).

class LayerNorm {
  gamma = nil
  beta = nil
  eps = 2.0e-5

  init_params(d) {
    self.gamma = dz.Parameter(Tensor.ones(1, d))
    self.beta = dz.Parameter(Tensor.zeros(1, d))
  }

  forward(x) {
    v = dz.as_variable(x)
    last = v.ndim - 1
    d = v.shape[last]
    if self.gamma == nil {
      self.init_params(d)
    }

    n = to_float(d)
    kd = v.shape.slice(0, last) + [1]
    mean = dz.reshape(v.sum(last) * (1.0 / n), kd)
    centered = v - mean
    var = dz.reshape((centered * centered).sum(last) * (1.0 / n), kd)
    # See BatchNorm.forward for why this Tensor.eval is load-bearing.
    Tensor.eval(mean.data, var.data)
    std = dz.pow_(var + self.eps, 0.5)
    xhat = centered / std
    self.gamma * xhat + self.beta
  }

  __call__(x) {
    self.forward(x)
  }

  params() {
    self.gamma == nil ? [] : [self.gamma, self.beta]
  }
}

# --- causal multi-head self-attention + GPT decoder block ------------------
#
# A from-scratch GPT block: no encoder cross-attention, single sequence at
# a time (`x` is `[T, n_embd]`, no leading batch axis -- `LayerNorm` above
# already generalizes to `[N, T, D]`, but batching the attention itself
# needs a per-(batch,head) transpose of only the last two axes, which
# `dz.transpose(x, axes)` doesn't actually implement yet: `raw_transpose`
# ignores any `axes` other than `nil`/`[1, 0]` and silently no-ops instead
# -- a latent gap in core.cul, not something this block works around).
#
# `causal_mask(t)`: 1.0 where key position j <= query position i, else 0.0
# -- `Tensor.where(mask, scores, -1e9)` before softmax is the masking idiom
# examples/dezero/examples/gpu_kernels_bench.cul already benchmarks
# (`where_nd`'s own concrete caller).
fn causal_mask(t) {
  Tensor.from(range(t)
    .map(|i| range(t).map(|j| j <= i ? 1.0 : 0.0).collect())
    .collect())
}

class MultiHeadAttention {
  new(n_embd, n_head, rope_base = 10000.0) {
    self.n_head = n_head
    self.head_dim = n_embd / n_head
    self.scale = 1.0 / Math.sqrt(to_float(self.head_dim))
    self.rope_base = rope_base
    self.wq = Linear(n_embd, true, n_embd)
    self.wk = Linear(n_embd, true, n_embd)
    self.wv = Linear(n_embd, true, n_embd)
    self.wo = Linear(n_embd, true, n_embd)
  }

  forward(x) {
    v = dz.as_variable(x)
    t = v.shape[0]
    q = self.wq(v)
    k = self.wk(v)
    val = self.wv(v)
    mask = causal_mask(t)

    mut head_outs = []
    for h in 0..self.n_head {
      hs = h * self.head_dim
      he = hs + self.head_dim
      q_h = F.rope(dz.narrow(q, 1, hs, he), 0, self.rope_base)
      k_h = F.rope(dz.narrow(k, 1, hs, he), 0, self.rope_base)
      v_h = dz.narrow(val, 1, hs, he)

      scores = dz.matmul(q_h, dz.transpose(k_h)) * self.scale  # [T, T]
      weights = F.softmax(dz.where_(mask, scores, -1.0e9), 1)
      head_outs.push(dz.matmul(weights, v_h))  # [T, head_dim]
    }

    mut x_attn = head_outs[0]
    for i in 1..self.n_head {
      x_attn = dz.concat2(x_attn, head_outs[i], 1)
    }
    self.wo(x_attn)
  }

  __call__(x) {
    self.forward(x)
  }

  params() {
    self.wq.params() + self.wk.params() + self.wv.params() + self.wo.params()
  }
}

class GPTBlock {
  new(n_embd, n_head, mlp_ratio = 4, rope_base = 10000.0) {
    self.ln1 = LayerNorm()
    self.attn = MultiHeadAttention(n_embd, n_head, rope_base)
    self.ln2 = LayerNorm()
    self.fc1 = Linear(mlp_ratio * n_embd)
    self.fc2 = Linear(n_embd)
  }

  forward(x) {
    v = dz.as_variable(x)
    x1 = v + self.attn(self.ln1(v))
    h = F.gelu(self.fc1(self.ln2(x1)))
    x1 + self.fc2(h)
  }

  __call__(x) {
    self.forward(x)
  }

  params() {
    self.ln1.params() +
      self.attn.params() +
      self.ln2.params() +
      self.fc1.params() +
      self.fc2.params()
  }

  cleargrads() {
    cleargrads(self)
  }
}

export {cleargrads, Linear, RNN, LSTM, EmbedID, BatchNorm, LayerNorm, MultiHeadAttention, GPTBlock}
