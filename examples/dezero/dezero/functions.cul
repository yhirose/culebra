# dezero/functions.cul — elementwise math, activations, and losses built on
# top of core.cul's autodiff engine. Ported from the "DeZero" framework
# taught in oreilly-japan/deep-learning-from-scratch-3 (MIT license).
#
# Everything elementwise here (sin/cos/tanh/exp/log/pow/sigmoid/relu/the
# comparisons/clamp) rides a native Tensor op — no `dz.raw_elementwise`
# host loop left in this file except LeakyReLU's own piecewise forward
# (its "1x or slope*x" isn't a single native op). Label arguments (`t`
# below) are plain Culebra Arrays of Long/Float, never Variables — nothing
# in this port back-propagates into a dataset's labels, matching upstream.
#
# softmax_cross_entropy and sigmoid_cross_entropy are fused single ops here
# (closed-form gradient) rather than composed from smaller pieces, same as
# upstream's own choice — the composed form is what `log_softmax` below is,
# kept only because a handful of call sites want it directly.

import dz from './core.cul'

# --- elementwise trig / exp / log ------------------------------------------

class Sin {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x) {
    x.sin()
  }

  backward(gy) {
    gy * cos(self.inputs[0])
  }
}

fn sin(x) {
  dz.apply1(Sin(), x)
}

class Cos {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x) {
    x.cos()
  }

  backward(gy) {
    gy * -sin(self.inputs[0])
  }
}

fn cos(x) {
  dz.apply1(Cos(), x)
}

class Tanh {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x) {
    x.tanh()
  }

  backward(gy) {
    y = self.output
    gy * dz.sub(1.0, y * y)
  }
}

fn tanh(x) {
  dz.apply1(Tanh(), x)
}

class Exp {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x) {
    dz.raw_elementwise(x, Math.exp)
  }

  backward(gy) {
    gy * self.output
  }
}

fn exp(x) {
  dz.apply1(Exp(), x)
}

class Log {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x) {
    x.log()
  }

  backward(gy) {
    gy / self.inputs[0]
  }
}

fn log(x) {
  dz.apply1(Log(), x)
}

# --- shape helpers built on dz.reshape --------------------------------------

fn expand_dims(x, axis) {
  v = dz.as_variable(x)
  shape = v.shape.slice(0, axis) + [1] + v.shape.slice(axis, v.shape.size())
  dz.reshape(v, shape)
}

fn flatten(x) {
  v = dz.as_variable(x)
  dz.reshape(v, [v.size])
}

fn average(x, axis = nil, keepdims = false) {
  v = dz.as_variable(x)
  n = if axis == nil {
    v.size
  } else {
    v.shape[axis]
  }
  dz.sum(v, axis, keepdims) * (1.0 / to_float(n))
}

# --- linear / activations ----------------------------------------------------
#
# `linear` composes matmul + add rather than fusing them into one Function
# (upstream's `linear_simple`, kept over the fused `Linear` — the fusion
# there only exists to free an intermediate ndarray sooner, which Culebra's
# GC already does for a dead local).

fn linear(x, w, b = nil) {
  y = dz.matmul(x, w)
  if b == nil {
    y
  } else {
    dz.add(y, b)
  }
}

class Sigmoid {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x) {
    x.sigmoid()
  }

  backward(gy) {
    y = self.output
    gy * y * dz.sub(1.0, y)
  }
}

fn sigmoid(x) {
  dz.apply1(Sigmoid(), x)
}

# GELU, sigmoid approximation: `x * sigmoid(1.702x)` (within ~0.02 of the
# exact erf-based GELU over the usual activation range) rather than the tanh
# approximation BERT/GPT-2 use — Tensor has neither `erf` nor `tanh` as a
# native op (`tanh` above is `raw_elementwise`, forward-only w.r.t. dezero's
# own autograd), while `.sigmoid()` already is one. No new Function class:
# `*` and `sigmoid()` are both already-differentiable dz ops, so this is a
# plain composition and backward falls out of their existing chain rule —
# unlike unfold/pad/fold/permute, which needed a genuinely new native op.
fn gelu(x) {
  xv = dz.as_variable(x)
  xv * sigmoid(xv * 1.702)
}

# Shared by ReLU/LeakyReLU/Clip below: each backward is "scale `gy` by a
# per-element 0/1-or-slope factor decided by the forward input" — only
# `gate` (a native Tensor, built from Tensor.gt/ge/le/where — no host loop)
# differs between the three.
fn masked_gate(gy, gate) {
  gy * dz.as_variable(gate)
}

class ReLU {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x) {
    x.relu()
  }

  backward(gy) {
    masked_gate(gy, self.inputs[0].data.gt(0.0))
  }
}

fn relu(x) {
  dz.apply1(ReLU(), x)
}

class LeakyReLU {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(slope = 0.2) {
    self.slope = slope
  }

  forward(x) {
    dz.raw_elementwise(x, |v| if v > 0.0 {
      v
    } else {
      v * self.slope
    })
  }

  backward(gy) {
    masked_gate(
      gy,
      Tensor.where(self.inputs[0].data.gt(0.0), 1.0, self.slope),
    )
  }
}

fn leaky_relu(x, slope = 0.2) {
  dz.apply1(LeakyReLU(slope), x)
}

class Softmax {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(axis = 1) {
    self.axis = axis
  }

  forward(x) {
    x.softmax()
  }

  backward(gy) {
    y = self.output
    gx = y * gy
    s = dz.sum(gx, self.axis, true)
    gx - y * s
  }
}

fn softmax(x, axis = 1) {
  dz.apply1(Softmax(axis), x)
}

# Composed rather than a fused stable kernel — `log(softmax(x))` is exactly
# how this codebase's own native-Tensor MNIST trainer computes the same
# quantity (examples/tensor/mnist/train.cul), so it carries the same
# numerical behavior as an already-proven idiom.
fn log_softmax(x, axis = 1) {
  log(softmax(x, axis))
}

fn clip(x, x_min, x_max) {
  dz.apply1(Clip(x_min, x_max), x)
}

class Clip {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(x_min, x_max) {
    self.x_min = x_min
    self.x_max = x_max
  }

  forward(x) {
    x.clamp(self.x_min, self.x_max)
  }

  backward(gy) {
    x_data = self.inputs[0].data
    masked_gate(gy, x_data.ge(self.x_min) * x_data.le(self.x_max))
  }
}

# --- losses -------------------------------------------------------------

class MeanSquaredError {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  forward(x0, x1) {
    diff = x0 - x1
    n = to_float(x0.shape()[0])
    Tensor.from([(diff * diff).sum() / n])
  }

  backward(gy) {
    (x0, x1) = (self.inputs[0], self.inputs[1])
    diff = x0 - x1
    n = to_float(x0.shape[0])
    gy_bc = dz.broadcast_to(gy, diff.shape)
    gx0 = gy_bc * diff * (2.0 / n)
    (gx0, -gx0)
  }
}

fn mean_squared_error(x0, x1) {
  dz.apply2(MeanSquaredError(), x0, x1)
}

# `t` is one Long class id per row (sparse labels), not one-hot — same
# calling convention as upstream. Fused forward+backward: the softmax and
# the cross-entropy are one Function, so backward is the closed-form
# `(softmax(x) - one_hot(t)) / N` rather than composed sub-gradients. The
# one-hot and the per-row gather are both native Tensor ops (scatter_to_axis
# + a masked sum), not a Culebra loop over rows/classes — that loop used to
# force a host round-trip (`.to_array()`) every call, which is the whole
# tensor for a batch-sized cross entropy in a training loop.
class SoftmaxCrossEntropy {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(t) {
    self.t = t
  }

  forward(x) {
    probs = x.softmax()
    self.probs = probs
    n = x.shape()[0]
    c = x.shape()[1]
    self.n = n
    onehot = Tensor.scatter_to_axis(Tensor.from(self.t), Tensor.ones(n), c)
    self.onehot = onehot
    # Clamping the whole row (not just the selected class) matters here:
    # unlike the old per-selected-element clamp, every class's log feeds the
    # masked sum below, so an unclamped near-zero probability elsewhere in
    # the row would turn a 0-mask entry into 0 * -inf = NaN.
    picked = (onehot * probs.clamp(1.0e-15, 1.0).log()).sum(1)
    picked.sum(0).reshape([1]) * (-1.0 / to_float(n))
  }

  backward(gy) {
    diff = (self.probs - self.onehot) * (1.0 / to_float(self.n))
    dz.as_variable(diff) * gy
  }
}

fn softmax_cross_entropy(x, t) {
  dz.apply1(SoftmaxCrossEntropy(t), x)
}

# `t` is one 0.0/1.0 label per row and `x` must be shape [N, 1] (a single
# logit per example) — this port's binary counterpart to
# softmax_cross_entropy above, scoped to that one shape rather than
# upstream's broadcasting-friendly version.
class SigmoidCrossEntropy {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(t) {
    self.t = t
  }

  forward(x) {
    p = x.sigmoid()
    self.p = p
    n = self.t.size()
    rows = p.to_array()  # forces eval, so no separate Tensor.eval needed
    mut total = 0.0
    for i in range(n) {
      pi = Math.clamp(rows[i][0], 1.0e-7, 1.0 - 1.0e-7)
      ti = self.t[i]
      total -= ti * Math.log(pi) + (1.0 - ti) * Math.log(1.0 - pi)
    }
    Tensor.from([total / to_float(n)])
  }

  backward(gy) {
    n = self.t.size()
    tcol = Tensor.from(self.t.map(|v| [v]))
    diff = (self.p - tcol) * (1.0 / to_float(n))
    dz.as_variable(diff) * gy
  }
}

fn sigmoid_cross_entropy(x, t) {
  dz.apply1(SigmoidCrossEntropy(t), x)
}

# No gradient path — `y` is model output, `t` is the raw label Array. Meant
# for reporting inside `dz.no_grad`, same as upstream.
fn accuracy(y, t) {
  v = dz.as_variable(y)
  preds = v.data.argmax(1)
  parr = preds.to_array()  # forces eval, so no separate Tensor.eval needed
  n = t.size()
  mut correct = 0
  for i in range(n) {
    correct += 1 if to_long(parr[i]) == t[i]
  }
  dz.Variable(Tensor.from([to_float(correct) / to_float(n)]))
}

fn random_mask_like(shape, keep_prob, scale) {
  if shape.empty() {
    if Random.uniform(0.0, 1.0) < keep_prob {
      scale
    } else {
      0.0
    }
  } else {
    range(shape[0])
      .map(|_| random_mask_like(shape.slice(1, shape.size()), keep_prob, scale))
      .collect()
  }
}

class Dropout {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(dropout_ratio = 0.5) {
    self.dropout_ratio = dropout_ratio
  }

  forward(x) {
    if dz.is_training() {
      self.mask = Tensor.from(random_mask_like(
        x.shape(),
        1.0 - self.dropout_ratio,
        1.0 / (1.0 - self.dropout_ratio),
      ))
      x * self.mask
    } else {
      self.mask = nil
      x
    }
  }

  backward(gy) {
    if self.mask == nil {
      gy
    } else {
      gy * dz.as_variable(self.mask)
    }
  }
}

fn dropout(x, dropout_ratio = 0.5) {
  dz.apply1(Dropout(dropout_ratio), x)
}

# --- embedding lookup ---------------------------------------------------
#
# `idx` is a plain Array of Long row indices (not a Variable). Backward is a
# scatter-add into a zero table the size of `w`, accumulating repeated
# indices exactly like upstream's `np.add.at`.

class EmbedID {
  generation = 0
  inputs = nil
  output = nil
  seen = -1

  new(idx) {
    self.idx = idx
    self.idx_tensor = Tensor.from(idx.map(to_float))
  }

  forward(w) {
    w.index_select(self.idx_tensor)
  }

  backward(gy) {
    w = self.inputs[0]
    dz.as_variable(Tensor.index_add(self.idx_tensor, gy.data, w.shape))
  }
}

fn embed_id(idx, w) {
  dz.apply1(EmbedID(idx), w)
}

# --- rotary position embedding (RoPE) ---------------------------------------
#
# Half-split (GPT-NeoX / HF-llama) convention, matching Tensor.rope's own
# native kernel exactly -- but composed from narrow/concat/mul/sub/add
# instead of calling that fused op, since Tensor.rope has no VJP (see its
# own doc comment in tensor.h): a training-time RoPE needs gradients to
# flow back through Q/K's own projection weights, which falls out for free
# here since every op this uses already has one (unlike narrow/concat
# themselves, which core.cul had to hand-derive). `x` is [T, d] (d even),
# one sequence -- row r sits at position `pos + r`, T = x.shape[0]. This
# differs from Tensor.rope's own convention for a rank-2 input ([H, D],
# T=1 -- every row a different *head* at the *same* time step, the
# decode-time shape); a training-time forward here processes a whole
# sequence per head instead, so row r genuinely is a different position.
# `pos` is row 0's absolute position (a KV-cache decode step passes its
# own cache length). Tensor.rope itself is still the right call for an
# inference-only decode step with nothing to backprop through -- the same
# native-fast-path-under-Tensor.no_grad pattern microgpt_tensor.cul's own
# sampling loop already uses for softmax.
fn rope_freqs(pos, seq_len, half, d, base) {
  pos_vals = range(seq_len).map(|i| to_float(pos + i)).collect()
  positions = Tensor.from(pos_vals).reshape([seq_len, 1])
  freq_vals = range(half).map(|j| base ** (-2.0 * to_float(j) / to_float(d)))
  freqs = Tensor.from(freq_vals.collect()).reshape([1, half])
  angle = positions * freqs  # [seq_len, half], outer product via broadcast
  (angle.cos(), angle.sin())
}

fn rope(x, pos, base = 10000.0) {
  v = dz.as_variable(x)
  seq_len = v.shape[0]
  d = v.shape[1]
  half = d / 2
  (cos_t, sin_t) = rope_freqs(pos, seq_len, half, d, base)
  cos_v = dz.as_variable(cos_t)
  sin_v = dz.as_variable(sin_t)
  x1 = dz.narrow(v, 1, 0, half)
  x2 = dz.narrow(v, 1, half, d)
  out1 = x1 * cos_v - x2 * sin_v
  out2 = x1 * sin_v + x2 * cos_v
  dz.concat2(out1, out2, 1)
}

export {sin, cos, tanh, exp, log, expand_dims, flatten, average, linear, sigmoid, gelu, relu, leaky_relu, softmax, log_softmax, clip, mean_squared_error, softmax_cross_entropy, sigmoid_cross_entropy, accuracy, dropout, embed_id, rope}
