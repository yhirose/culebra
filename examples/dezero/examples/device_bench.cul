# CPU vs GPU for dezero's own from-scratch autodiff, across the two shapes
# of work this port does. `Variable.data` is always a Tensor, so whichever
# device `Tensor.use_cpu()`/`use_gpu()` selects is what every dezero op
# below runs on — no dezero-side code change needed to switch.
#
#   Linear/MLP (and by extension RNN/LSTM, which are built out of Linear)
#   ride `Tensor.dot()` directly, so a big enough matmul should favor the
#   GPU the same way examples/tensor/tensors_gpu.cul's own benchmark shows.
#
#   Conv2d's im2col padding/window-gather/axis-move now all ride
#   `Tensor.pad()`/`.unfold()`/`.permute()` (GPU-dispatched, or a free view
#   for `.permute()`) instead of host-side Culebra-Array loops — only the
#   pad-strip crop after col2im's fold is still a host pass (see
#   functions_conv.cul's header comment for why). Both the window-gather and
#   the GEMM inside it can now ride whichever device is selected.
#
#   Multi-head attention's own shape ([batch,heads,seq,dim] Q/K/V) needs a
#   batched `.dot()` (rank >= 3) and `.permute()` for the K^T transpose —
#   neither existed before this session. `.dot()`'s GPU dispatch is a
#   per-slice loop over the same single-matmul kernel MLP's `.dot()` uses
#   (gpu_bdot_ in cpp-tensorlib), so this measures whether that per-slice
#   dispatch still beats CPU once there are `batch*heads` of them rather
#   than one. Forward-only (no dezero Function wraps `.permute()`/batched
#   `.dot()` yet, and native `.backward()` doesn't reach through `.permute()`
#   itself — see docs/stdlib.md's autograd section).
#
#   culebra --jit examples/dezero/examples/device_bench.cul

import dz from '../dezero/core.cul'
import L from '../dezero/layers.cul'
import LC from '../dezero/layers_conv.cul'
import M from '../dezero/models.cul'

# Evaluating the *deepest* parameter's gradient forces the whole lazy
# graph in one dispatch — it depends transitively on every layer's
# forward activations and every later layer's backward, so this is
# equivalent to (and much cheaper than) evaluating every parameter
# individually. Matches the one sync-point-per-step a cupy benchmark
# would use, rather than one dispatch per parameter.

fn bench_mlp(label, batch, width, iters = 5) {
  model = M.MLP([width, width, 10])
  x = dz.Variable(Tensor.randn(batch, width))

  fn step() {
    out = model(x)
    out.sum().backward()
    Tensor.eval(model.layers[0].w.grad.data)
    model.cleargrads()
  }

  step()  # warm up: lazy weight init + first-dispatch cost, not timed
  t0 = Time.monotonic()
  for _ in range(iters) {
    step()
  }
  ms = (Time.monotonic() - t0) * 1000.0 / to_float(iters)
  println("{label} MLP    batch={batch} width={width}: {ms} ms/iter")
}

fn bench_conv(label, batch, size, iters = 5) {
  layer = LC.Conv2d(8, 3, 1, 1)
  x = dz.Variable(Tensor.randn(batch, 1, size, size))

  fn step() {
    out = layer(x)
    out.sum().backward()
    Tensor.eval(layer.w.grad.data)
    L.cleargrads(layer)
  }

  step()  # warm up
  t0 = Time.monotonic()
  for _ in range(iters) {
    step()
  }
  ms = (Time.monotonic() - t0) * 1000.0 / to_float(iters)
  println("{label} Conv2d batch={batch} size={size}x{size}: {ms} ms/iter")
}

fn bench_attn(label, batch, heads, seq, dim, iters = 5) {
  q = Tensor.randn(batch, heads, seq, dim)
  k = Tensor.randn(batch, heads, seq, dim)
  v = Tensor.randn(batch, heads, seq, dim)

  fn step() {
    scores = q.dot(k.permute([0, 1, 3, 2]))
    attn = scores.softmax()
    out = attn.dot(v)
    Tensor.eval(out)
  }

  step()  # warm up
  t0 = Time.monotonic()
  for _ in range(iters) {
    step()
  }
  ms = (Time.monotonic() - t0) * 1000.0 / to_float(iters)
  println(
    "{label} Attn   batch={batch} heads={heads} seq={seq} dim={dim}: {ms} ms/iter",
  )
}

println("GPU available: {Tensor.gpu_available()}\n")

println("-- matmul-heavy: Linear/MLP (RNN/LSTM ride the same path) --")
for cfg in [{batch: 64, width: 128}, {batch: 256, width: 1024}] {
  Tensor.use_cpu()
  bench_mlp("cpu ", cfg.batch, cfg.width)
  Tensor.use_gpu()
  bench_mlp("gpu ", cfg.batch, cfg.width)
  println("")
}

println("-- data-movement-heavy: Conv2d's im2col window-gather --")
for cfg in [{batch: 8, size: 28}, {batch: 32, size: 28}] {
  Tensor.use_cpu()
  bench_conv("cpu ", cfg.batch, cfg.size)
  Tensor.use_gpu()
  bench_conv("gpu ", cfg.batch, cfg.size)
  println("")
}

println("-- batch-heavy: multi-head attention's batched dot + permute --")
for cfg in [
  {batch: 2, heads: 4, seq: 64, dim: 32},
  {batch: 8, heads: 8, seq: 128, dim: 64},
] {
  Tensor.use_cpu()
  bench_attn("cpu ", cfg.batch, cfg.heads, cfg.seq, cfg.dim)
  Tensor.use_gpu()
  bench_attn("gpu ", cfg.batch, cfg.heads, cfg.seq, cfg.dim)
  println("")
}

Tensor.use_auto()
