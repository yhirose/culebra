# An alto saxophone for Audio.Kauai.load's `voices:`, `external Sax`, playing
# a phrase at a time: the tongue starts it, a breath carries it through every
# note a slur joins, and the tongue or the breath ends it. Under the slur a
# fingering change lands fast, and the wider the interval the deeper the
# tone dips and the more air is heard in it. The bass is guitar.cul's and the
# drums kit.cul's.

import wave from './wave.cul'
import guitar from './guitar.cul'
import kit from './kit.cul'

let RATE = wave.RATE

# The bore and the bell give back these bands of partials most.
let PEAKS = [
  {at: 650.0, width: 450.0, gain: 1.0},
  {at: 1700.0, width: 700.0, gain: 0.55},
  {at: 3000.0, width: 1000.0, gain: 0.3},
]
let PARTIALS = 24
# The air heard through a held note, against the tone's level.
let AIR = 0.008

fn body(f) {
  PEAKS.reduce(
    0.2,
    |sum, p| sum + p.gain * Math.exp(-((f - p.at) / p.width) ** 2),
  )
}

# The partials of `pitch` at `level`. A conical bore sounds them all, and a
# harder breath brightens a reed far more than a bow brightens a string.
fn spectrum(pitch, level) {
  let f = wave.hz(pitch)
  let count = Math.max(1, Math.min(PARTIALS, Math.floor(RATE * 0.45 / f)))
  let tilt = 2.2 - 1.2 * level
  let amps = iota(count).map(|k| body(f * (k + 1)) / (k + 1) ** tilt)
  let norm = 0.5 * level / amps.sum()
  iota(PARTIALS).map(|k| k < count ? amps[k] * norm : 0.0)
}

# The jazz articulations as bends of the pitch, in semitones, `u` from 0 to 1
# through the time each takes: a scoop and a plop at the start of the note,
# into it from below and above, and a doit and a fall at its end, out of it
# upward and down as the breath gives out.
let SCOOP = 0.12
let PLOP = 0.09
let DOIT = 0.18
let FALL = 0.3
let BENDS = ["scoop", "plop", "doit", "fall"]

fn bend(marks, since, left) {
  mut semis = 0.0
  mut gain = 1.0
  if marks.contains("scoop") && since < SCOOP {
    semis -= 1.5 * (1.0 - since / SCOOP) ** 2
  }
  if marks.contains("plop") && since < PLOP {
    let u = since / PLOP
    semis += 4.0 * (1.0 - u) ** 2
    gain *= 0.4 + 0.6 * u
  }
  if marks.contains("doit") && left < DOIT {
    let u = 1.0 - left / DOIT
    semis += 5.0 * u * u
    gain *= 1.0 - 0.7 * u * u
  }
  if marks.contains("fall") && left < FALL {
    let u = 1.0 - left / FALL
    semis -= 9.0 * u * u
    gain *= 1.0 - 0.85 * u * u
  }
  (semis, gain)
}

# The air's band, between the two one-pole filters it passes (about the
# reed's own noise, low and high).
let AIR_LOW = 286.5
let AIR_HIGH = 2503.4

# One phrase `notes` ([{pitch, at, len, level, level_end, marks, next}]) as
# samples. The phrase stops by the time the voice plays next.
fn blow(notes) {
  let specs = notes.map(|n| spectrum(n.pitch, n.level))
  let freqs = notes.map(|n| wave.hz(n.pitch))
  # Each change of fingering: the log ratio of its pitches, how long the pitch
  # takes to settle, and how deep and how long the tone dips.
  let changes = iota(notes.size()).map(fn (k) {
    let step = k == 0 ? 0 : Math.abs(notes[k].pitch - notes[k - 1].pitch)
    {
      ratio: k == 0 ? 0.0 : Math.log(freqs[k] / freqs[k - 1]),
      settle: Math.min(0.012, 0.004 + 0.001 * step),
      dip: k == 0 ? 0.0 : Math.min(0.5, 0.22 + 0.02 * step),
      dip_len: 0.03 + 0.002 * step,
    }
  })
  let last = notes[notes.size() - 1]
  let attack = 0.035
  let deadline = last.get("next", nil) ?? 1.0e9
  let held = Math.min(last.at + Math.max(last.len, attack), deadline)
  let release = Math.clamp(deadline - held, 0.005, 0.05)
  let seconds = held + release
  # Where each note ends: the next one, or for the last, where the breath stops.
  let ends = iota(notes.size()).map(|k| k + 1 < notes.size()
    ? notes[k + 1].at
    : held)
  let marked = notes.map(|n| n.get("marks", []).filter(|m| BENDS.contains(m)))
  # The note sounding at `t`.
  let sounding = fn (t) {
    mut at = 0
    while at + 1 < notes.size() && t >= notes[at + 1].at {
      at += 1
    }
    at
  }
  # Note `at` at `t`: how far into it, the one before, and how far its
  # slurred change has settled.
  let state = fn (t, at) {
    let since = t - notes[at].at
    # A slurred change settles within a few milliseconds.
    let x = at == 0 ? 1.0 : Math.min(1.0, since / changes[at].settle)
    {at: at, since: since, was: Math.max(0, at - 1), x: x}
  }
  # At the tongue's release the upper partials come in a moment late.
  let opened = 0.01 + 0.003 * PARTIALS
  let amps_at = fn (t) {
    let s = state(t, sounding(t))
    iota(PARTIALS).map(fn (k) {
      let a = specs[s.was][k] + (specs[s.at][k] - specs[s.was][k]) * s.x
      k > 0 && t < opened ? a * Math.min(1.0, t / (0.01 + 0.003 * k)) : a
    })
  }
  # The spectrum where it bends: as the partials open, and as each change
  # starts and settles; straight between.
  let turns = [
    ...iota(PARTIALS).map(|k| k == 0 ? 0.0 : 0.01 + 0.003 * k),
    ...iota(1, notes.size()).flat_map(|k| [notes[k].at, notes[k].at + changes[k].settle]),
  ]
  let bends = turns.filter(|t| t < seconds).sorted()
  # The rest of the controls, worked out often, at each corner one turns
  # (the breath's rise and fall, each change's settling and dip), and on
  # both sides of each note's start, where a bend jumps.
  let corners = [
    attack,
    held,
    ...iota(1, notes.size()).flat_map(|k| [notes[k].at + changes[k].settle, notes[k].at + changes[k].dip_len]),
  ]
  let starts = iota(1, notes.size()).map(|k| (notes[k].at, k))
  let times = wave.control_times(seconds, starts, corners)
  let controls = times.map(fn ((t, note)) {
    let s = state(t, note ?? sounding(t))
    let ch = changes[s.at]
    # A tongued start speaks a little flat and comes up to pitch.
    let speak = s.at == 0 && s.since < 0.15
      ? 1.0 - 0.015 * Math.exp(-s.since / 0.025)
      : 1.0
    let marks = marked[s.at]
    let (
      semis,
      bent,
    ) = marks.empty() ? (0.0, 1.0) : bend(marks, s.since, ends[s.at] - t)
    let depth = 0.005 * Math.max(0.0, Math.min(1.0, (s.since - 0.3) / 0.4))
    let wobble = Math.sin(2.0 * Math.pi * 5.2 * t)
    let fingered = s.x < 1.0
      ? freqs[s.was] * Math.exp(s.x * ch.ratio)
      : freqs[s.at]
    let f = fingered * speak * 2.0 ** (semis / 12.0)
    let dip = s.since < ch.dip_len
      ? 1.0 - ch.dip * Math.sin(Math.pi * s.since / ch.dip_len)
      : 1.0
    let rise = Math.min(1.0, t / attack)
    let fall = t <= held ? 1.0 : Math.max(0.0, 1.0 - (t - held) / release)
    let whole = wave.swell(notes[s.at], s.since) * rise * fall
    # Air through the reed: a band of noise that passes as the reed opens on
    # each cycle, so it is heard in the tone rather than beside it; strongest
    # as the tongue lets go and through a change of fingering.
    let tongue = t < 0.2 ? Math.exp(-t / 0.03) : 0.0
    let burst = tongue +
      (s.since < 0.15 ? ch.dip * 2.0 * Math.exp(-s.since / 0.02) : 0.0)
    let level = notes[s.at].level * whole
    {
      freq: (t, f * (1.0 + depth * wobble)),
      gain: (t, dip * bent * (1.0 + 1.5 * depth * wobble) * whole),
      steady: (t, level * 0.25 * burst),
      pulsed: (t, level * AIR),
    }
  })
  Audio.partials(
    seconds,
    controls.map(|c| c.freq),
    bends.map(|t| (t, amps_at(t))),
    gain: controls.map(|c| c.gain),
    noise: {
      low: AIR_LOW,
      high: AIR_HIGH,
      seed: notes[0].pitch * 7919 + 17,
      steady: controls.map(|c| c.steady),
      pulsed: controls.map(|c| c.pulsed),
    },
  )
}

let sounds = {sax: |notes, params| blow(notes), bass: guitar.sounds.bass}
let voices = {sax: wave.voice(sounds.sax, wave.HEARS), bass: guitar.voices.bass}

let drums = kit.drums

export {voices, drums, sounds}
