# A jazz kit for Audio.Kauai.load's `drums:`: `external Ride`, `external Hat`,
# `external OpenHat` and `external Crash`. A cymbal is six square waves at
# frequencies no harmonic series holds, with some noise, through two
# high-pass stages: the ride rings on, the hat closed by the pedal is the
# same metal cut short, the open hat rings until the next hit of its choke
# group closes it, and the crash rings on unless the band's hit is short (a
# staccato or a marcato), when the hand catches it.

import wave from './wave.cul'

let RATE = wave.RATE
let METAL = [205.3, 304.4, 369.6, 522.7, 540.0, 800.0].map(|f| f * 2.4)

fn metal(seconds, decay, cutoff, noisy, seed) {
  let white = wave.noise(seed)
  let a = 1.0 / (1.0 + 2.0 * Math.pi * cutoff / RATE)
  mut x1 = 0.0
  mut y1 = 0.0
  mut x2 = 0.0
  mut y2 = 0.0
  iota(Math.round(seconds * RATE)).map(fn (i) {
    let t = i.to_float() / RATE
    let squares = METAL.reduce(
      0.0,
      |sum, f| sum + (Math.sin(2.0 * Math.pi * f * t) >= 0.0 ? 1.0 : -1.0),
    )
    let x = squares / METAL.size() * (1.0 - noisy) + white() * noisy
    y1 = a * (y1 + x - x1)
    x1 = x
    y2 = a * (y2 + y1 - x2)
    x2 = y1
    y2 * Math.exp(-t / decay)
  })
}

let RIDE = metal(2.0, 0.7, 3500.0, 0.3, 11).map(|s| s * 0.6)
let HAT = metal(0.15, 0.03, 6000.0, 0.5, 23).map(|s| s * 0.7)
let OPEN = metal(1.0, 0.35, 6000.0, 0.5, 29).map(|s| s * 0.6)
let CRASH = metal(2.5, 0.9, 4000.0, 0.5, 31).map(|s| s * 0.6)

# `samples` stopped `seconds` in (nil: rung out), fading over `fade` seconds.
fn stopped(samples, seconds, fade) {
  return samples if seconds == nil
  let end = Math.round((seconds + fade) * RATE)
  Audio.envelope(
    samples[..end],
    [(seconds, 1.0), (seconds + fade, 0.0)],
    rate: RATE,
  )
}

# The open hat, closed `n.next` seconds on if its choke group hits again.
fn open_hat(n) {
  stopped(OPEN, n.next, 0.01)
}

# The crash, caught by the hand a moment after a short hit of the band's.
fn crash(n) {
  let short = n.marks.contains("staccato") || n.marks.contains("marcato")
  stopped(CRASH, short ? 0.12 : nil, 0.05)
}

let sounds = {
  ride: |n, params| RIDE,
  hat: |n, params| HAT,
  openhat: |n, params| open_hat(n),
  crash: |n, params| crash(n),
}
let HEARS = {ride: [], hat: [], openhat: ["next"], crash: ["marks"]}
let drums = sounds
  .keys()
  .map(|k| (
    k,
    {
      hit: |n, params| Audio.Sound(sounds[k](n, params), rate: wave.RATE),
      hears: HEARS[k],
    },
  ))
  .to_object()

export {drums, sounds, HEARS}
