# A jazz kit for Audio.Kauai.load's `drums:`: `host Ride`, `host Hat` and
# `host OpenHat`. A cymbal is six square waves at frequencies no harmonic
# series holds, with some noise, through two high-pass stages: the ride rings
# on, the hat closed by the pedal is the same metal cut short, and the open
# hat rings until the next hit of its choke group closes it.

import wave from './wave.cul'

let RATE = wave.RATE
let METAL = [205.3, 304.4, 369.6, 522.7, 540.0, 800.0].map(|f| f * 2.4)

fn metal(seconds, decay, cutoff, noisy, seed) {
  let white = wave.noise(seed)
  let a = 1.0 / (1.0 + 2.0 * Math.pi * cutoff / RATE)
  mut x1 = 0.0
  mut y1 = 0.0
  mut x2 = 0.0
  mut y2 = 0.0
  iota(Math.round(seconds * RATE)).map(fn (i) {
    let t = i.to_float() / RATE
    let squares = METAL.reduce(
      0.0,
      |sum, f| sum + (Math.sin(2.0 * Math.pi * f * t) >= 0.0 ? 1.0 : -1.0),
    )
    let x = squares / METAL.size() * (1.0 - noisy) + white() * noisy
    y1 = a * (y1 + x - x1)
    x1 = x
    y2 = a * (y2 + y1 - x2)
    x2 = y1
    y2 * Math.exp(-t / decay)
  })
}

let RIDE = metal(2.0, 0.7, 3500.0, 0.3, 11).map(|s| s * 0.6)
let HAT = metal(0.15, 0.03, 6000.0, 0.5, 23).map(|s| s * 0.7)
let OPEN = metal(1.0, 0.35, 6000.0, 0.5, 29).map(|s| s * 0.6)

# The open hat, closed `n.next` seconds on if its choke group hits again.
fn open_hat(n) {
  let fade = Math.round(0.01 * RATE)
  let stop = n.next == nil
    ? OPEN.size()
    : Math.min(OPEN.size(), Math.round(n.next * RATE))
  iota(Math.min(
    OPEN.size(),
    stop + fade,
  )).map(|i| OPEN[i] * (i < stop ? 1.0 : 1.0 - (i - stop) / fade))
}

let sounds = {
  ride: |n, params| RIDE,
  hat: |n, params| HAT,
  openhat: |n, params| open_hat(n),
}
let HEARS = {ride: [], hat: [], openhat: ["next"]}
let drums = sounds
  .keys()
  .map(|k| (
    k,
    {
      hit: |n, params| Audio.Sound(wave.wav(wave.room(sounds[k](n, params)))),
      hears: HEARS[k],
    },
  ))
  .to_object()

export {drums, sounds, HEARS}
