# Play a song written in Kauai (docs/kauai/language.md):
#
#   culebra examples/kauai/play.cul examples/kauai/songs/first.kau
#
# songs/ holds the spec's first song (first.kau), a string trio with its
# parts written out (trio.kau), a tour of the notation (features.kau), and Je
# te veux (Erik Satie, 1897) as the spec prints it (jetveux.kau) and with its
# piano written out (jetveux_piano.kau); retro-run's music is in
# examples/games/retro-run/assets.
#
# The song is read and checked, then handed to the runtime whole, which keeps
# time on the audio stream's own clock: this script only waits for the end
# (Ctrl+C stops a song that loops).
#
# A band that plays `host` instruments names sounds that sounds.cul
# synthesises; jukebox.cul plays the same songs from a window, and
# xml2kau.cul makes a song from a MusicXML score.

import sounds from './sounds.cul'

fn clock(secs) {
  let s = Math.round(secs)
  "{s / 60}:{s % 60 < 10 ? "0" : ""}{s % 60}"
}

if Sys.argv.empty() {
  println("usage: culebra examples/kauai/play.cul <song.kau>")
  Sys.exit(2)
}
let path = Sys.argv[0]
let song = try {
  Audio.Kauai.load(path, voices: sounds.voices, drums: sounds.drums)
} catch e {
  println("{e.kind}: {e.message}")
  Sys.exit(1)
}
if !Audio.available() {
  println("{path}: no audio device, so nothing plays")
  Sys.exit(1)
}
# Build the host sounds first, saying how far along it is: play() would build
# them all the same, only in silence.
mut left = song.prepare()
while left > 0 {
  print("\rpreparing sounds: {left} left ")
  left = song.prepare()
}
println("\rplaying {path} ({clock(song.length())} once through)")
song.play()
while song.playing() {
  Time.sleep(0.1)
}
