# What the instruments beside it share: the sample rate, a pitch's frequency,
# a noise source that sounds the same every time, when to work out a
# phrase's controls, and a voice for Audio.Kauai made from a function that
# plays a phrase. The room they sound in is the song's own (`room 90%`), not
# theirs.

let RATE = 44100

fn hz(pitch) {
  440.0 * Math.exp((pitch - 69) / 12.0 * Math.log(2.0))
}

# White noise, -1.0..1.0, the same from the same seed: a song is the same
# song every time it is read.
fn noise(seed) {
  mut x = seed
  fn () {
    x = (x * 1103515245 + 12345) % 2147483648
    x / 1073741824.0 - 1.0
  }
}

# A phrase as the lines that move through it, from the lowest, as Kauai
# numbers each note's `line`. One line is the phrase.
fn lines(notes) {
  let by = notes.group_by(|n| n.line)
  iota(notes.map(|n| n.line).max() + 1).filter(|k| by.has(k)).map(|k| by[k])
}

# `play(line)` for each line of `notes` (which hear `line`), each line `spread` seconds after the
# one below it (a strum, from the lowest string), added together: a chord's
# tones each on a string or a bow of their own. A line starts from its first
# note, its `at` and `next` counted from there.
fn by_line(notes, spread, play) {
  let parts = lines(notes).map(fn (line) {
    let t0 = line[0].at
    let next = line[0].get("next", nil)
    {
      t0: t0,
      s: play(line.map(|n| {
        ...n,
        at: n.at - t0,
        next: next == nil ? nil : next - t0,
      })),
    }
  })
  Audio.mix(
    iota(parts.size()).map(|k| {
      samples: parts[k].s,
      at: parts[k].t0 + k * spread,
    }),
    rate: RATE,
  )
}

# How much louder than its start a note `n` ({len, level, level_end}) is
# `since` seconds into it, through a crescendo or a diminuendo.
fn swell(n, since) {
  1.0 +
    (n.level_end / n.level - 1.0) *
      Math.min(1.0, since / Math.max(n.len, 0.001))
}

# How often an instrument works out its controls for Audio.partials, which
# moves in straight lines between them sample by sample.
let CONTROL = 0.001

# When a phrase `seconds` long works out its controls: every CONTROL, at
# each of `corners` (where a control turns), and at each of `starts`, (at,
# note), twice: as the note before it at that instant, then as that note,
# for a control that jumps there. Each is (t, note), the note nil where it is
# the one sounding.
fn control_times(seconds, starts, corners) {
  let steps = starts.flat_map(|(at, k)| [(at, 0, k - 1), (at, 2, k)])
  let grid = iota(Math.ceil(seconds / CONTROL) + 1)
    .map(|j| (j * CONTROL, 1, nil))
    .filter(|(t, _, _)| !steps.any(|(at, _, _)| Math.abs(at - t) < 1.0e-9))
  let turns = corners.filter(|t| t < seconds).map(|t| (t, 1, nil))
  [...grid, ...turns, ...steps]
    .sorted_by(|(t, order, _)| (t, order))
    .map(|(t, _, note)| (t, note))
}

# All a phrase instrument can hear of a note.
let HEARS = ["len", "level", "line", "marks", "next"]

# `voices:`'s instrument for `play(notes, params)`, which answers a phrase's
# samples: it hears what `hears` names of each note.
fn voice(play, hears) {
  {
    phrase: |notes, params| Audio.Sound(play(notes, params), rate: RATE),
    hears: hears,
  }
}

export {RATE, HEARS, CONTROL, hz, noise, by_line, swell, control_times, voice}
