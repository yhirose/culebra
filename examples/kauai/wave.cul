# What the instruments beside it share: the sample rate, a pitch's frequency,
# a noise source that sounds the same every time, a room to play in, samples
# as WAV bytes, and a voice for Audio.Kauai made from a function that plays a
# phrase.

let RATE = 44100

fn hz(pitch) {
  440.0 * Math.exp((pitch - 69) / 12.0 * Math.log(2.0))
}

# White noise, -1.0..1.0, the same from the same seed: a song is the same
# song every time it is read.
fn noise(seed) {
  mut x = seed
  fn () {
    x = (x * 1103515245 + 12345) % 2147483648
    x / 1073741824.0 - 1.0
  }
}

# The room (Freeverb: eight damped combs in parallel, then four allpasses in
# series), at Jezar's delays for 44.1 kHz. A song's sounds add, and so do
# their echoes, so each sound carrying its own tail is the song in the room.
let COMBS = [
  1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617,
].map(|d| Math.round(d * RATE / 44100.0))
let PASSES = [556, 441, 341, 225].map(|d| Math.round(d * RATE / 44100.0))
let FEEDBACK = 0.86
let DAMP = 0.25
let WET = 0.9
let TAIL = 1.5

# `samples` as heard in the room: themselves, then their echoes TAIL seconds on.
fn room(samples) {
  mut combs = COMBS.map(|d| repeat(d, 0.0))
  mut damped = repeat(COMBS.size(), 0.0)
  mut passes = PASSES.map(|d| repeat(d, 0.0))
  mut at = 0
  let n = samples.size()
  iota(n + Math.round(TAIL * RATE)).map(fn (i) {
    let x = i < n ? samples[i] : 0.0
    let into = x * 0.015
    mut echo = 0.0
    for k in 0..COMBS.size() {
      let buf = combs[k]
      let j = at % COMBS[k]
      let y = buf[j]
      damped[k] = y * (1.0 - DAMP) + damped[k] * DAMP
      buf[j] = into + damped[k] * FEEDBACK
      echo += y
    }
    for k in 0..PASSES.size() {
      let buf = passes[k]
      let j = at % PASSES[k]
      let held = buf[j]
      buf[j] = echo + held * 0.5
      echo = held - echo
    }
    at += 1
    x + echo * WET
  })
}

# 16-bit mono samples (-1.0..1.0) as a WAV file's bytes.
fn wav(samples) {
  let data = String.pack(
    "i16",
    samples.map(|s| Math.round(Math.clamp(s, -1.0, 1.0) * 32000)),
  )
  let n = samples.size() * 2
  String.pack("u32", [0x46464952, 36 + n, 0x45564157, 0x20746d66, 16]) +
    String.pack("u16", [1, 1]) +
    String.pack("u32", [RATE, RATE * 2]) +
    String.pack("u16", [2, 16]) +
    String.pack("u32", [0x61746164, n]) +
    data
}

# A phrase as the lines that move through it: the notes struck together
# from the lowest, the k-th of each onset in line k. One line is the phrase.
fn lines(notes) {
  mut onsets = []
  for n in notes {
    if onsets.empty() || onsets[onsets.size() - 1][0].at != n.at {
      onsets.push([n])
    } else {
      onsets[onsets.size() - 1].push(n)
    }
  }
  let width = onsets.map(|o| o.size()).max()
  iota(width).map(|k| onsets.filter(|o| o.size() > k).map(|o| o[k]))
}

# `play(line)` for each line of `notes`, each line `spread` seconds after the
# one below it (a strum, from the lowest string), added together: a chord's
# tones each on a string or a bow of their own. A line starts from its first
# note, its `at` and `next` counted from there.
fn by_line(notes, spread, play) {
  let parts = lines(notes).map(fn (line) {
    let t0 = line[0].at
    let since = |t| t == nil ? nil : t - t0
    {
      t0: t0,
      s: play(line.map(|n| {
        ...n,
        at: n.at - t0,
        next: since(n.get("next", nil)),
      })),
    }
  })
  let starts = iota(parts.size()).map(|k| Math.round((parts[k].t0 +
    k * spread) *
    RATE))
  mut out = repeat(
    iota(parts.size()).map(|k| starts[k] + parts[k].s.size()).max(),
    0.0,
  )
  for k in 0..parts.size() {
    let s = parts[k].s
    for i in 0..s.size() {
      out[starts[k] + i] += s[i]
    }
  }
  out
}

# `voices:`'s instrument for `play(notes, params)`, which answers a phrase's
# samples: it hears what `hears` names of each note, and sounds in the room.
fn voice(play, hears) {
  {
    phrase: |notes, params| Audio.Sound(wav(room(play(notes, params)))),
    hears: hears,
  }
}

export {RATE, hz, noise, room, wav, lines, by_line, voice}
