about {
  title  Blue phrase
  note   a blues in F for an alto saxophone, a walking bass, a ride cymbal and a hi-hat, swung, with scoops, plops, doits and falls, on host instruments that play a phrase at a time
}

band Quartet {
  voice Sax   host Sax   plays melody            vol 70%
  voice Bass  host Bass  plays roots in E2..D#3  vol 75%

  drum Ride     host Ride     vol 45%
  drum Hat      host Hat      vol 35%  choke Hats
  drum OpenHat  host OpenHat  vol 25%  choke Hats
}

groove Walk {
  Bass     1 3 5 >
  Ride     x . x x x . x x
  Hat      . . x . . . x .
  OpenHat  . . . . . x . . | . . . . . . . .
}

song Blue {
  tempo 132
  swing 8
  band Quartet
  groove Walk
  melody in C4..B4

  Head x2
  Tag
}

section Head {
  F7       r8 (c d f) \scoop !a4 .g8 f
  Bb7      (ab4 f8 d) f4 r
  F7       r8 (c d f a c' eb' d')
  Cm7 F7   c'4 .bb8 .a \fall ab4 r
  Bb7      (bb8 c' d' f' ab'4) .f'8 .d'
  Bdim7    (b4 d'8 f') \doit ab'2
  F7       \f \plop !f'4. d'8 (c' a f d)
  Am7 D7   c4 e8 g (c' b) a f#
  Gm7      \mf (g8 bb d' f' e' d' bb g)
  C7       (e8 g bb d' db'4) c'
  F7 D7    (a4 c'8 f') .eb'4 .d'
  Gm7 C7   (c'8 bb a g) e4 r
}

section Tag {
  F6       \fall !f'2 r
}
