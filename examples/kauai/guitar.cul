# Plucked strings for Audio.Kauai.load's `voices:`: `host Guitar` (nylon
# strings on a wooden body), `host Steel` (bright strings and no body) and
# `host Bass`, playing a phrase at a time. A string is Audio.pluck's, a loop
# of delay that loses a little of its brightness on every pass
# (Karplus-Strong): a pluck fills it with the shape the string is let go
# from, and it rings down by itself. A finger draws a nylon string aside to a point, a triangle whose
# upper harmonics are weak; a pick's scrape is noise, bright in all of them.
# A voice's `pluck=` says how far along the string from the bridge it is
# plucked (`host Guitar pluck=0.3`, over the soundhole and mellow). Under a slur the string
# is not plucked again: a finger hammers on or pulls off, the loop changes
# length with the string still moving, and only a little energy is added.
# The string rings on until the hand moves to what the voice plays next, and
# a staccato is damped where it ends. A chord is a string for each of its
# tones, strummed from the lowest. A guitar's body
# rings with the string at its own resonances, which is most of why it does
# not sound like a koto or a harp.

import wave from './wave.cul'

let RATE = wave.RATE

# Seconds for a string at `f` Hz to ring down by 60 dB: longer low.
fn ring_time(f, sustain) {
  Math.clamp(sustain * Math.sqrt(110.0 / f), 0.4, 10.0)
}

# What the pluck leaves on the string, one period long: the string drawn
# aside to a point `kind.position` along it (a triangle, its harmonics falling
# as 1/k²), roughened by noise as much as `kind.shape` falls short of 1, and
# softened for a soft note.
fn burst(n, period, strength, kind, seed) {
  let white = wave.noise(seed)
  let soft = 0.15 + 0.6 * Math.min(1.0, n.level * kind.bright)
  let gap = Math.max(1, Math.round(kind.position * period))
  let tri = iota(period).map(|i| i < gap
    ? i.to_float() / gap
    : (period - i).to_float() / (period - gap))
  let mean = tri.sum() / period
  let raw = iota(period).map(|i| white())
  let combed = iota(period).map(|i| raw[i] - (i >= gap ? raw[i - gap] : 0.0))
  mut lp = 0.0
  iota(period).map(fn (i) {
    let v = kind.shape * (tri[i] - mean) + (1.0 - kind.shape) * combed[i]
    lp += soft * (v - lp)
    lp * strength * n.level
  })
}

# One string's phrase `notes` ([{pitch, at, len, level}]), each starting
# after the one before it: Audio.pluck's string, tuned to each note as it
# comes, and let go where the hand leaves it.
fn string(notes, kind) {
  let last = notes[notes.size() - 1]
  let end = last.at + last.len
  let next = last.get("next", nil)
  # Rung out, the last string fades below hearing in half its ring time.
  let rung = end + 0.5 * ring_time(wave.hz(last.pitch), kind.sustain)
  let held = last.get("marks", []).contains("staccato")
    ? Math.min(end, next ?? end)
    : Math.min(next ?? rung, rung)
  let tunings = [
    ...notes.map(|n| {
      at: n.at,
      freq: wave.hz(n.pitch),
      ring: ring_time(wave.hz(n.pitch), kind.sustain),
    }),
    {at: held, freq: wave.hz(last.pitch), ring: kind.let_go},
  ]
  # The pluck, then a hammer-on (up) or a pull-off (down) for each note after,
  # each a period of the string long (the loop's whole samples).
  let strikes = iota(notes.size()).map(fn (k) {
    let strength = cond {
      k == 0 => 0.5,
      notes[k].pitch > notes[k - 1].pitch => 0.125,
      _ => 0.225,
    }
    let period = Math.floor(RATE / wave.hz(notes[k].pitch) - 0.6)
    {at: notes[k].at, samples: burst(notes[k], period, strength, kind, notes[k].pitch * 7919 + k)}
  })
  Audio.pluck(held + 0.3, tunings, strikes)
}

# A phrase, each of its lines on a string of its own.
fn pluck(notes, kind) {
  wave.by_line(notes, kind.strum, |line| string(line, kind))
}

# The body's resonances for Audio.resonate: the air inside, the top plate
# and the modes above them. The body passes some of the string straight.
let WOOD = [
  {freq: 98.0, width: 10.0, gain: 0.9},
  {freq: 204.0, width: 16.0, gain: 1.0},
  {freq: 390.0, width: 35.0, gain: 0.5},
  {freq: 560.0, width: 50.0, gain: 0.35},
  {freq: 1100.0, width: 200.0, gain: 0.25},
  {freq: 2600.0, width: 800.0, gain: 0.15},
]
let STRAIGHT = 0.4

let NYLON = {
  sustain: 6.0,
  bright: 0.4,
  position: 0.18,
  strum: 0.008,
  shape: 0.85,
  let_go: 0.6,
}
let STEEL = {
  sustain: 7.0,
  bright: 0.8,
  position: 0.13,
  strum: 0.015,
  shape: 0.0,
  let_go: 0.2,
}
let BASS = {
  sustain: 6.0,
  bright: 0.35,
  position: 0.2,
  strum: 0.0,
  shape: 0.0,
  let_go: 0.2,
}

# `kind` as a voice's `pluck=` asks: plucked that far along the string from
# the bridge, 0.3 over the soundhole and mellow, 0.1 by the bridge and bright.
fn played(kind, params) {
  let at = params.get("pluck", nil)
  at == nil ? kind : {...kind, position: Math.clamp(at, 0.05, 0.5)}
}

let sounds = {
  guitar: |notes, params| Audio.resonate(pluck(notes, played(NYLON, params)), WOOD, dry: STRAIGHT),
  steel: |notes, params| pluck(notes, played(STEEL, params)),
  bass: |notes, params| pluck(notes, played(BASS, params)),
}
let voices = sounds
  .keys()
  .map(|k| (k, wave.voice(sounds[k], wave.HEARS)))
  .to_object()

export {voices, sounds}
