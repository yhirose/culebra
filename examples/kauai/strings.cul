# Bowed strings for Audio.Kauai.load's `voices:`: `host Violin`, `host Viola`
# and `host Cello`. Each is an instrument that plays a phrase at a time, the
# notes a slur joins under one bow: the bow takes hold, a note swells into its
# vibrato, a finger stops the next note with the bow still moving, and the
# phrase fades when the bow leaves. A louder note is a brighter one.

import wave from './wave.cul'

let RATE = wave.RATE

# How strongly the instrument's body gives back a partial at `f` Hz: a floor,
# and its resonances {at, width, gain}.
fn body(f, peaks) {
  peaks.reduce(
    0.15,
    |sum, p| sum + p.gain * Math.exp(-((f - p.at) / p.width) ** 2),
  )
}

let PARTIALS = 16

# The partials of `pitch` at `level`: a sawtooth's (the bow's stick and
# slip), tilted darker as the note grows softer and coloured by the body.
fn spectrum(pitch, level, peaks) {
  let f = wave.hz(pitch)
  let count = Math.max(1, Math.min(PARTIALS, Math.floor(RATE * 0.45 / f)))
  let tilt = 1.5 - 0.5 * level
  let amps = iota(count).map(|k| body(f * (k + 1), peaks) / (k + 1) ** tilt)
  let norm = 0.45 * level / amps.sum()
  iota(PARTIALS).map(|k| k < count ? amps[k] * norm : 0.0)
}

# A slurred note's pitch is stopped, not slid to, and the tone dips as the
# finger lands.
let CHANGE = 0.003
let DIP = 0.35
let DIP_LEN = 0.02

# One phrase `notes` ([{pitch, at, len, level}]) on an instrument shaped by
# `peaks`, as one sound whose phase never restarts; sin(k·x) comes from the
# two before it, so the partials cost one sin and one cos a sample.
fn bowed(notes, peaks) {
  let specs = notes.map(|n| spectrum(n.pitch, n.level, peaks))
  let freqs = notes.map(|n| wave.hz(n.pitch))
  # How far each note's pitch is from the one before, as a log ratio.
  let steps = iota(notes.size()).map(|k| k == 0
    ? 0.0
    : Math.log(freqs[k] / freqs[k - 1]))
  let last = notes[notes.size() - 1]
  let attack = 0.08
  let release = 0.15
  let held = last.at + Math.max(last.len, attack)
  let total = Math.round((held + release) * RATE)
  let limit = RATE * 0.45
  mut phase = 0.0
  mut at = 0
  iota(total).map(fn (i) {
    let t = i.to_float() / RATE
    while at + 1 < notes.size() && t >= notes[at + 1].at {
      at += 1
    }
    let since = t - notes[at].at
    let was = Math.max(0, at - 1)
    let x = at == 0 ? 1.0 : Math.min(1.0, since / CHANGE)
    let f = x < 1.0 ? freqs[was] * Math.exp(x * steps[at]) : freqs[at]
    let dip = at == 0 || since >= DIP_LEN
      ? 1.0
      : 1.0 - DIP * Math.sin(Math.pi * since / DIP_LEN)
    # Vibrato that grows in after each note has settled.
    let depth = 0.004 * Math.max(0.0, Math.min(1.0, (since - 0.2) / 0.3))
    let wobble = Math.sin(2.0 * Math.pi * 5.6 * t)
    phase += 2.0 * Math.pi * f / RATE * (1.0 + depth * wobble)
    let s1 = Math.sin(phase)
    let c2 = 2.0 * Math.cos(phase)
    let a0 = specs[was]
    let a1 = specs[at]
    mut prev = 0.0
    mut cur = s1
    mut sum = (a0[0] + (a1[0] - a0[0]) * x) * s1
    for k in 1..PARTIALS {
      break if (k + 1) * f > limit
      let next = c2 * cur - prev
      prev = cur
      cur = next
      sum += (a0[k] + (a1[k] - a0[k]) * x) * cur
    }
    let rise = Math.min(1.0, t / attack)
    let fall = t <= held ? 1.0 : Math.max(0.0, 1.0 - (t - held) / release)
    # A crescendo or a diminuendo through the note, from its dynamic to the
    # one it ends at.
    let n = notes[at]
    let swell = 1.0 +
      (n.level_end / n.level - 1.0) *
        Math.min(1.0, since / Math.max(n.len, 0.001))
    sum * dip * swell * rise * rise * fall * (1.0 + 2.0 * depth * wobble)
  })
}

let VIOLIN = [
  {at: 280.0, width: 80.0, gain: 0.8},
  {at: 460.0, width: 150.0, gain: 1.0},
  {at: 2800.0, width: 900.0, gain: 0.9},
]
let VIOLA = [
  {at: 230.0, width: 70.0, gain: 0.8},
  {at: 380.0, width: 130.0, gain: 1.0},
  {at: 2200.0, width: 800.0, gain: 0.7},
]
let CELLO = [
  {at: 110.0, width: 40.0, gain: 0.9},
  {at: 200.0, width: 80.0, gain: 1.0},
  {at: 1200.0, width: 500.0, gain: 0.6},
]

# A chord is a bow on each string at once.
let sounds = {
  violin: |notes, params| wave.by_line(notes, 0.0, |line| bowed(line, VIOLIN)),
  viola: |notes, params| wave.by_line(notes, 0.0, |line| bowed(line, VIOLA)),
  cello: |notes, params| wave.by_line(notes, 0.0, |line| bowed(line, CELLO)),
}
let voices = sounds
  .keys()
  .map(|k| (k, wave.voice(sounds[k], ["len", "level"])))
  .to_object()

export {voices, sounds}
