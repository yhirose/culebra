# Spike 0 — a web-tech GUI window driven entirely from culebra.
#
# Build the extended binary first (see webview_binding.cpp), then:
#   ./webview-culebra examples/webview/hello.cul
#   ./webview-culebra --jit examples/webview/hello.cul
#
# No HTTP server yet: the UI is an inline HTML string handed straight to
# the native WebView via set_html. The local-server + embedded-assets
# layers (the Tauri-shaped single binary) land in later spikes.

let html = """
<!doctype html>
<html>
  <head><meta charset="utf-8"></head>
  <body style="font-family: system-ui, sans-serif; margin: 0; height: 100vh;
               display: grid; place-items: center;
               background: #0b1020; color: #e8ecff;">
    <main style="text-align: center;">
      <h1 style="font-size: 3rem; margin: 0;">It works 🛸</h1>
      <p style="opacity: .7;">culebra → native WebView</p>
    </main>
  </body>
</html>
"""

let w = Webview.Window.new()
w.set_title("Hello from culebra")
w.set_size(640, 480)
w.set_html(html)
w.run()
