# A Tauri-shaped desktop facade: local HTTP server + native WebView + assets,
# in one call. Import it and run:
#
#   import Desktop from './desktop.cul'
#   Desktop.run({
#     title:  "My App",
#     size:   [720, 560],
#     assets: Embed.dir("dist"),     # dev: live disk / AOT: baked into the binary
#     routes: fn(srv) {              # your API; handlers must be Sendable
#       srv.get("/api/hello", fn(req) { ... })
#     }
#   })
#
# `run` hides the boilerplate: it starts the server with listen_async (which
# binds synchronously and serves on a background thread), opens the window on the
# main thread, and stops the server when the window closes. It also registers a
# built-in `POST /__quit` route, so a UI button can close the app over the HTTP
# bridge — `Webview.Window.quit()` terminates the running window and is safe to
# call from the server's worker thread (it never touches the window handle).

fn run(config) {
  let port = config.get("port", 8731)
  let base = "http://127.0.0.1:" + port.to_string()

  let srv = Http.server()
  if config.has("assets") { srv.static("/", config["assets"]) }
  if config.has("routes") { config["routes"](srv) }
  # Built-in quit endpoint: a UI button does `fetch("/__quit", {method:"POST"})`.
  srv.post("/__quit", fn(req) { Webview.Window.quit(); "" })
  # A browser loads the page over several parallel connections; cpp-httplib holds
  # each keep-alive connection on a worker for up to 5s, so a single worker would
  # serialize the load and leave the window blank for seconds. Default to a small
  # pool (override with `workers:` in the config).
  srv.listen_async(port, workers: config.get("workers", 4))   # returns immediately

  let w = Webview.Window.new()
  w.set_title(config.get("title", "culebra"))
  if config.has("size") {
    let size = config["size"]
    w.set_size(size[0], size[1])
  }
  w.navigate(base + "/")
  w.run()                            # blocks the main thread until the window closes
  srv.stop()                         # stop the server and join its thread
}

# Close the running window from anywhere (e.g. inside a custom route handler).
fn quit() { Webview.Window.quit() }

export { run, quit }
