# Non-blocking binding smoke test (no run() == no event loop == no hang).
# Exercises ctor -> setters -> deterministic drop on every backend, so it
# can run in CI / headless without opening a lasting window.

let w = Webview.Window.new()
w.set_title("smoke")
w.set_size(320, 240)
w.set_html("<h1>hi</h1>")
w.navigate("about:blank")
puts("created + configured ok")
w.drop()
puts("dropped ok")
