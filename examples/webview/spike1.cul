# Spike 1 — a Tauri-shaped desktop app, driven entirely from culebra.
#
# A local HTTP server (on its own thread) serves the UI and a small JSON API;
# a native WebView (the main thread) navigates to it, and the page talks back
# over fetch(). The only bridge across the thread boundary is loopback HTTP —
# no shared culebra heap crosses it, so the concurrency model stays intact:
# the server isolate has its own heap, the WebView parks the main thread, and
# the two never touch the same values.
#
# Build the extended binary (Http.server is built in; Webview.Window is wrapped):
#   CULEBRA_HOME=. culebra wrap examples/webview/webview_binding.cpp \
#       --link "-framework WebKit -ldl" -o webview-culebra
# then:
#   ./webview-culebra examples/webview/spike1.cul          # interpreter
#   ./webview-culebra --jit examples/webview/spike1.cul    # JIT

PORT = 8731
BASE = "http://127.0.0.1:" + PORT.to_string()

# The whole UI as one raw ('...') string so its CSS/JS braces are literal —
# the """ lane interpolates {expr}. Keep every quote inside a double quote.
PAGE = '<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>culebra desktop</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; min-height: 100vh;
           display: grid; place-items: center;
           background: #0b1020; color: #e8ecff; }
    main { text-align: center; max-width: 30rem; padding: 2rem; }
    h1 { font-size: 2.5rem; margin: 0 0 .25rem; }
    .msg { opacity: .8; min-height: 1.4em; }
    .row { margin-top: 1.5rem; display: flex; gap: .5rem; }
    input { flex: 1; padding: .6rem .8rem; border-radius: .5rem;
            border: 1px solid #2a3358; background: #131a33; color: inherit; }
    button { padding: .6rem 1rem; border-radius: .5rem; border: 0;
             background: #4f6dff; color: white; cursor: pointer; }
    .reply { margin-top: 1rem; opacity: .9; min-height: 1.4em; color: #9ad0ff; }
  </style>
</head>
<body>
  <main>
    <h1>It works 🛸</h1>
    <p class="msg" id="msg">contacting local server...</p>
    <div class="row">
      <input id="text" placeholder="type something" value="hello server">
      <button id="send">Send</button>
    </div>
    <p class="reply" id="reply"></p>
  </main>
  <script>
    async function load() {
      const r = await fetch("/api/hello");
      const d = await r.json();
      document.getElementById("msg").textContent = d.message;
    }
    async function send() {
      const text = document.getElementById("text").value;
      const r = await fetch("/api/echo", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text: text })
      });
      const d = await r.json();
      document.getElementById("reply").textContent = d.reply;
    }
    document.getElementById("send").addEventListener("click", send);
    load();
  </script>
</body>
</html>'

# The server runs in its own isolate (separate thread + heap). It blocks in
# listen(); dropping the isolate handle later sets its interrupt flag, which
# the accept loop polls and stops on — a clean cross-thread shutdown.
server = Isolate.spawn(fn() {
  let srv = Http.server()
  srv.get("/", fn(req) {
    { body: PAGE, content_type: "text/html; charset=utf-8" }
  })
  srv.get("/api/hello", fn(req) {
    { content_type: "application/json",
      body: JSON.stringify({ message: "Hello from culebra's local server 🛸" }) }
  })
  srv.post("/api/echo", fn(req) {
    let input = JSON.parse(req.body)
    { content_type: "application/json",
      body: JSON.stringify({ reply: "You said: " + input["text"] }) }
  })
  srv.listen(PORT)
})

# Wait until the server thread has bound the port before opening the window
# (the spawn returns immediately; the bind happens a beat later on its thread).
# Poll every 20ms up to ~5s. The sleep isn't about CPU — each Http.get blocks
# in a connect() syscall that yields — it's about a predictable bound: without
# it the loop's wall time is just "250 connection-refused latencies", which on
# a fast idle machine can burn through before the server thread is scheduled.
fn wait_ready() {
  mut n = 0
  while n < 250 {
    try { Http.get(BASE + "/api/hello"); return true } catch e { }
    Time.sleep(0.02)
    n = n + 1
  }
  return false
}

if wait_ready() {
  let w = Webview.Window.new()
  w.set_title("culebra desktop — Spike 1")
  w.set_size(720, 560)
  w.navigate(BASE + "/")
  w.run()              # blocks the main thread until the window is closed
  server.drop()        # interrupt flag -> server's poll -> clean stop
  puts("window closed; server stopped")
} else {
  server.drop()
  puts("server did not start in time")
}
