# --- Compiler tables ------------------------------------------------------------

fn fail(node, msg) {
  throw {kind: 'MiniError', message: msg, line: node.line, col: node.column}
}

# The prelude and the user program are separate parse trees whose line/col
# ranges overlap, so position keys carry which side they are from.
mut in_prelude = false
fn pkey(node) {
  cond {
    node.key != nil => node.key,
    in_prelude => "p{node.line}:{node.column}",
    _ => "u{node.line}:{node.column}",
  }
}

mut synth_count = 0
fn synth(name, nodes, at) {
  synth_count = synth_count + 1
  {
    name: name,
    nodes: nodes,
    token: '',
    line: at.line,
    column: at.column,
    key: "s{synth_count}",
  }
}

mut funcs = []          # {parent, name, params, stmts, body_expr, is_prelude, is_arrow, ...}
mut free = []           # per func: {"owner:slot": (owner, slot)}
mut calls = []          # per func: [callee func index...]
mut capture_index = []  # per func: {"owner:slot": capture index}
mut cell_index = []     # per func (the owner): {slot: cell index}
mut nslots = []         # per func: named local slots
mut nscratch = []       # per func: lowering temps, appended after the named slots
mut scope_stack = []    # per func: [{map: {name: slot}, slots: [slot...]}]
mut closure_of = {}     # pkey of a function node -> func index
mut resolved = {}       # pkey of an ident -> {kind: 'var', owner, slot} | {kind: 'global', name}
mut block_slots = {}    # pkey of a block -> the slots it declares
mut prelude_named = {}  # prelude fn name -> func index
mut g_slot = 0          # main's slot holding __G
mut this_slot = 0       # main's `this`
mut loop_ctx = []       # per func (emit time): [{step: fn(m) -> [ids]}...]

# Prelude names that are VM intrinsics, with their arities.
let intrinsics = {
  __typeof: ('typeof', 1),
  __tostr: ('tostr', 1),
  __len: ('len', 1),
  __toint: ('toint', 1),
  __todouble: ('todouble', 1),
  __fmod: ('fmod', 2),
  __pow: ('pow', 2),
  __arraypush: ('arraypush', 2),
  __arraypop: ('arraypop', 1),
  __objecthas: ('objecthas', 2),
  __objectkeys: ('objectkeys', 1),
  __objectremove: ('objectremove', 2),
  __same: ('same', 2),
  __argcount: ('argcount', 0),
  __print: ('print', 1),
  __genresume: ('genresume', 2),
  __genreturn: ('genreturn', 2),
}
# Prelude names that are raw VM binary / unary operations over Longs.
let raw_binops = {
  __bitand: 'bitand',
  __bitor: 'bitor',
  __bitxor: 'bitxor',
  __ishl: 'shl',
  __ishr: 'shr',
  __idiv: 'div',
  __imod: 'mod',
  __bitnot: 'bitnot',
}

fn new_func(parent, name, stmts, body_expr, is_arrow) {
  let f = funcs.size()
  funcs.push({
    parent: parent,
    name: name,
    params: [],
    dflts: [],
    stmts: stmts,
    body_expr: body_expr,
    is_prelude: in_prelude,
    is_arrow: is_arrow,
    var_names: [],
  })
  free.push({})
  calls.push([])
  capture_index.push({})
  cell_index.push({})
  nslots.push(0)
  nscratch.push(0)
  scope_stack.push([])
  loop_ctx.push([])
  # every function reaches the global table through main's cell
  if f != 0 {
    free[f]["0:{g_slot}"] = (0, g_slot)
  }
  f
}

# --- Pass A: bind ---------------------------------------------------------------

fn enter_scope(f) {
  scope_stack[f].push({map: {}, slots: []})
}
fn leave_scope(f) {
  scope_stack[f].pop()
}

fn declare_var(f, name, at) {
  let scopes = scope_stack[f]
  let top = scopes[scopes.size() - 1]
  if top.map.has(name) {
    let slot = top.map[name]
    if at != nil {
      resolved[pkey(at)] = {kind: 'var', owner: f, slot: slot}
    }
    return slot
  }
  let slot = nslots[f]
  nslots[f] = slot + 1
  top.map[name] = slot
  top.slots.push(slot)
  if at != nil {
    resolved[pkey(at)] = {kind: 'var', owner: f, slot: slot}
  }
  slot
}

# `var` binds at the function's outermost scope wherever it appears
fn declare_fn_var(f, name, at) {
  let scopes = scope_stack[f]
  # already visible (a parameter, or declared before)? keep that slot
  mut i = scopes.size() - 1
  while i >= 0 {
    if scopes[i].map.has(name) {
      let slot = scopes[i].map[name]
      if at != nil {
        resolved[pkey(at)] = {kind: 'var', owner: f, slot: slot}
      }
      return slot
    }
    i = i - 1
  }
  let slot = nslots[f]
  nslots[f] = slot + 1
  scopes[0].map[name] = slot
  scopes[0].slots.push(slot)
  funcs[f].var_names.push(slot)
  if at != nil {
    resolved[pkey(at)] = {kind: 'var', owner: f, slot: slot}
  }
  slot
}

fn resolve(f, name) {
  if name == '__G' {
    return {kind: 'var', owner: 0, slot: g_slot}
  }
  mut h = f
  while h != nil {
    let scopes = scope_stack[h]
    mut i = scopes.size() - 1
    while i >= 0 {
      if scopes[i].map.has(name) {
        return {kind: 'var', owner: h, slot: scopes[i].map[name]}
      }
      i = i - 1
    }
    h = funcs[h].parent
  }
  if in_prelude && prelude_named.has(name) {
    return {kind: 'fn', func: prelude_named[name]}
  }
  if in_prelude && intrinsics.has(name) {
    return {kind: 'intrinsic', name: name}
  }
  if in_prelude && raw_binops.has(name) {
    return {kind: 'rawop', name: name}
  }
  if in_prelude && name == '__allchars' {
    return {kind: 'const'}
  }
  {kind: 'global', name: name}
}

fn use_var(f, owner, slot) {
  if owner != f {
    free[f]["{owner}:{slot}"] = (owner, slot)
  }
}

fn note_use(node, f) {
  let r = resolve(f, node.token)
  resolved[pkey(node)] = r
  if r.kind == 'var' {
    use_var(f, r.owner, r.slot)
  }
  r
}

# Names a statement list declares at its own level (hoisted to the block
# start): let/const/function. `var` names go to the function.
fn hoist_block(stmts, f) {
  mut fn_nodes = []
  for st in stmts {
    cond {
      st.name == 'var_decl' || st.name == 'var_decl_ns' => {
        let kw = st.nodes[0].token
        mut i = 1
        while i < st.nodes.size() {
          declare_pattern(f, st.nodes[i].nodes[0], kw)
          i = i + 1
        }
      },
      st.name == 'fn_decl' => {
        declare_var(f, st.nodes[0].token, st.nodes[0])
        fn_nodes.push(st)
      },
      _ => nil,
    }
  }
  fn_nodes
}

fn collect_vars(node, f) {
  if node.nodes == nil {
    return nil
  }
  if node.name == 'fn_decl' || node.name == 'fn_expr' || node.name == 'arrow' || node.name == 'method_p' || node.name == 'getter_p' || node.name == 'setter_p' {
    return nil
  }
  if (node.name == 'var_decl' || node.name == 'var_decl_ns') && node.nodes[0].token == 'var' {
    mut i = 1
    while i < node.nodes.size() {
      for id in pattern_idents(node.nodes[i].nodes[0], []) {
        declare_fn_var(f, id.token, nil)
      }
      i = i + 1
    }
  }
  if (node.name == 'for_of' || node.name == 'for_in') && node.nodes[0].token == 'var' {
    for id in pattern_idents(node.nodes[1], []) {
      declare_fn_var(f, id.token, nil)
    }
  }
  for c in node.nodes {
    collect_vars(c, f)
  }
  nil
}

fn param_parts(p) {
  cond {
    p.name == 'rest_p' => {id: p.nodes[0], dflt: nil, rest: true},
    p.name == 'dflt_p' => {id: p.nodes[0], dflt: p.nodes[1], rest: false},
    _ => {id: p, dflt: nil, rest: false},
  }
}

# The identifiers a binding pattern introduces, in source order.
fn pattern_idents(pat, out) {
  cond {
    pat.name == 'ident' => out.push(pat),
    pat.name == 'arr_pat' || pat.name == 'obj_pat' => {
      for el in pat.nodes {
        pattern_idents(el, out)
      }
    },
    pat.name == 'pat_dflt' ||
      pat.name == 'rest_b' => pattern_idents(pat.nodes[0], out),
    pat.name == 'opat_kv' => pattern_idents(pat.nodes[1], out),
    pat.name == 'opat_short' => out.push(pat.nodes[0]),
    _ => nil,
  }
  out
}

# The member-expression targets a pattern assigns to (assignment only).
fn pattern_targets(pat, out) {
  cond {
    pat.name == 'postfix' || pat.name == 'paren' => out.push(pat),
    pat.name == 'arr_pat' || pat.name == 'obj_pat' => {
      for el in pat.nodes {
        pattern_targets(el, out)
      }
    },
    pat.name == 'pat_dflt' ||
      pat.name == 'rest_b' => pattern_targets(pat.nodes[0], out),
    pat.name == 'opat_kv' => pattern_targets(pat.nodes[1], out),
    _ => nil,
  }
  out
}

# The default expressions inside a pattern (scanned in the pattern's scope).
fn pattern_dflts(pat, out) {
  cond {
    pat.name == 'arr_pat' || pat.name == 'obj_pat' => {
      for el in pat.nodes {
        pattern_dflts(el, out)
      }
    },
    pat.name == 'pat_dflt' || pat.name == 'opat_short' => {
      if pat.nodes.size() > 1 {
        out.push(pat.nodes[1])
      }
      if pat.name == 'pat_dflt' {
        pattern_dflts(pat.nodes[0], out)
      }
    },
    pat.name == 'rest_b' => pattern_dflts(pat.nodes[0], out),
    pat.name == 'opat_kv' => pattern_dflts(pat.nodes[1], out),
    _ => nil,
  }
  out
}

fn declare_pattern(f, pat, kw) {
  for id in pattern_idents(pat, []) {
    cond {
      kw == 'var' => declare_fn_var(f, id.token, id),
      _ => declare_var(f, id.token, id),
    }
  }
}

fn scan_pattern_dflts(pat, f) {
  for d in pattern_dflts(pat, []) {
    scan_expr(d, f)
  }
}

fn walk_fn(f, param_nodes, this_node) {
  enter_scope(f)
  let fi = funcs[f]
  cond {
    # the prelude spells its receiver parameter itself (a helper has none)
    fi.is_prelude => nil,
    fi.is_arrow => {
      declare_var(f, "\x01this", nil)
      fi.params.push("\x01this")
    },
    _ => {
      declare_var(f, 'this', nil)
      fi.params.push('this')
    },
  }
  # parameters take the first slots; a pattern parameter lands in a hidden
  # one and is unpacked by the prologue
  mut pat_params = []
  for p in param_nodes {
    let pp = param_parts(p)
    cond {
      pp.rest => {
        fi['rest'] = pp.id.token
        mut k = 0
        while k < 8 {
          declare_var(f, "\x01r{k}", nil)
          fi.params.push("\x01r{k}")
          k = k + 1
        }
        declare_var(f, pp.id.token, pp.id)
      },
      pp.id.name == 'ident' => {
        declare_var(f, pp.id.token, pp.id)
        fi.params.push(pp.id.token)
        fi.dflts.push(pp.dflt)
      },
      _ => {
        let hn = "\x01p{fi.params.size()}"
        let slot = declare_var(f, hn, nil)
        fi.params.push(hn)
        fi.dflts.push(pp.dflt)
        pat_params.push((slot, pp.id))
      },
    }
  }
  fi['pat_params'] = pat_params
  for pp in pat_params {
    let (slot, pat) = pp
    declare_pattern(f, pat, 'let')
  }
  if fi.self_name != nil {
    fi['self_slot'] = declare_var(f, fi.self_name, fi.self_node)
  }
  for pp in fi.dflts {
    if pp != nil {
      scan_expr(pp, f)
    }
  }
  for pp in pat_params {
    let (slot, pat) = pp
    scan_pattern_dflts(pat, f)
  }
  cond {
    fi.body_expr != nil => scan_expr(fi.body_expr, f),
    _ => {
      for st in fi.stmts {
        collect_vars(st, f)
      }
      scan_stmts(fi.stmts, f)
    },
  }
  leave_scope(f)
}

fn scan_stmts(stmts, f) {
  let fn_nodes = hoist_block(stmts, f)
  for s in fn_nodes {
    let id = s.nodes[0]
    let g = new_func(f, id.token, s.nodes[2].nodes, nil, false)
    closure_of[pkey(s)] = g
    calls[f].push(g)
    walk_fn(g, s.nodes[1].nodes, nil)
  }
  for s in stmts {
    scan_stmt(s, f)
  }
}

fn scan_block(blk, f) {
  enter_scope(f)
  scan_stmts(blk.nodes, f)
  let scopes = scope_stack[f]
  block_slots[pkey(blk)] = scopes[scopes.size() - 1].slots
  leave_scope(f)
}

# a statement in a position that is not a block still gets its own scope
fn scan_sub(st, f) {
  cond {
    st.name == 'block' => scan_block(st, f),
    _ => {
      enter_scope(f)
      scan_stmts([st], f)
      leave_scope(f)
    },
  }
}

fn scan_stmt(node, f) {
  match node {
    {name: 'var_decl'} => scan_decl(node, f),
    {name: 'var_decl_ns'} => scan_decl(node, f),
    {name: 'fn_decl'} => nil,  # hoisted by scan_stmts
    {name: 'if_s'} => {
      scan_expr(node.nodes[0], f)
      scan_sub(node.nodes[1], f)
      if node.nodes.size() > 2 {
        scan_sub(node.nodes[2].nodes[0], f)
      }
    },
    {name: 'while_s'} => {
      scan_expr(node.nodes[0], f)
      scan_sub(node.nodes[1], f)
    },
    {name: 'do_s'} => {
      scan_sub(node.nodes[0], f)
      scan_expr(node.nodes[1], f)
    },
    {name: 'for_of'} => scan_for_each(node, f),
    {name: 'for_in'} => scan_for_each(node, f),
    {name: 'switch_s'} => {
      scan_expr(node.nodes[0], f)
      # the cases share one block scope
      enter_scope(f)
      mut all = []
      mut i = 1
      while i < node.nodes.size() {
        let c = node.nodes[i]
        let body = c.nodes[c.nodes.size() - 1]
        if c.name == 'case_c' {
          scan_expr(c.nodes[0], f)
        }
        for st in body.nodes {
          all.push(st)
        }
        i = i + 1
      }
      scan_stmts(all, f)
      let scopes = scope_stack[f]
      block_slots[pkey(node)] = scopes[scopes.size() - 1].slots
      leave_scope(f)
    },
    {name: 'for_s'} => {
      let [init, cnd, step, body] = node.nodes
      enter_scope(f)
      if init.nodes.size() > 0 {
        let i0 = init.nodes[0]
        cond {
          i0.name == 'var_decl_ns' => scan_decl(i0, f),
          _ => scan_expr(i0, f),
        }
      }
      if cnd.nodes.size() > 0 {
        scan_expr(cnd.nodes[0], f)
      }
      if step.nodes.size() > 0 {
        scan_expr(step.nodes[0], f)
      }
      scan_sub(body, f)
      let scopes = scope_stack[f]
      block_slots[pkey(node)] = scopes[scopes.size() - 1].slots
      leave_scope(f)
    },
    {name: 'return_s'} => {
      if node.nodes[0].nodes.size() > 0 {
        scan_expr(node.nodes[0].nodes[0], f)
      }
    },
    {name: 'break_s'} => nil,
    {name: 'continue_s'} => nil,
    {name: 'throw_s'} => scan_expr(node.nodes[0], f),
    {name: 'try_s'} => {
      scan_block(node.nodes[0], f)
      mut i = 1
      while i < node.nodes.size() {
        let c = node.nodes[i]
        cond {
          c.name == 'catch_c' => {
            enter_scope(f)
            let cp = c.nodes[0]
            # the caught value always has a slot, named or not
            let slot = cond {
              cp.nodes.size() >
                0 => declare_var(f, cp.nodes[0].token, cp.nodes[0]),
              _ => declare_var(f, "\x01caught", nil),
            }
            resolved[pkey(c)] = {kind: 'var', owner: f, slot: slot}
            scan_block(c.nodes[1], f)
            leave_scope(f)
          },
          _ => {
            let g = new_func(f, 'finally', c.nodes[0].nodes, nil, true)
            closure_of[pkey(c)] = g
            calls[f].push(g)
            walk_fn(g, [], nil)
          },
        }
        i = i + 1
      }
    },
    {name: 'block'} => scan_block(node, f),
    {name: 'empty_s'} => nil,
    {name: 'expr_s'} => scan_expr(node.nodes[0], f),
    _ => scan_expr(node, f),
  }
}

# for-of / for-in: the head's binding lives in the loop's own scope
fn scan_for_each(node, f) {
  let [kw, pat, src, body] = node.nodes
  scan_expr(src, f)
  enter_scope(f)
  declare_pattern(f, pat, kw.token)
  scan_pattern_dflts(pat, f)
  scan_sub(body, f)
  let scopes = scope_stack[f]
  block_slots[pkey(node)] = scopes[scopes.size() - 1].slots
  leave_scope(f)
}

fn scan_decl(node, f) {
  let kw = node.nodes[0].token
  mut i = 1
  while i < node.nodes.size() {
    let d = node.nodes[i]
    let pat = d.nodes[0]
    # hoist_block declared the names when the block was entered; a for-init
    # or a var is declared here
    for id in pattern_idents(pat, []) {
      cond {
        kw == 'var' => declare_fn_var(f, id.token, id),
        resolved.has(pkey(id)) => nil,
        _ => declare_var(f, id.token, id),
      }
    }
    scan_pattern_dflts(pat, f)
    if d.nodes.size() > 1 {
      scan_expr(d.nodes[1], f)
    }
    i = i + 1
  }
}

fn scan_fn_value(node, f, param_nodes, body, is_arrow, name) {
  let stmts = cond {
    body.name == 'block' => body.nodes,
    _ => nil,
  }
  let body_expr = cond {
    body.name == 'block' => nil,
    _ => body,
  }
  let g = new_func(f, name, stmts, body_expr, is_arrow)
  closure_of[pkey(node)] = g
  calls[f].push(g)
  walk_fn(g, param_nodes, nil)
  g
}

fn scan_expr(node, f) {
  match node {
    {name: 'ident'} => note_use(node, f),
    {name: 'number'} => nil,
    {name: 'string'} => nil,
    {name: 'true_l'} => nil,
    {name: 'false_l'} => nil,
    {name: 'null_l'} => nil,
    {name: 'this_e'} => {
      let r = resolve(f, 'this')
      resolved[pkey(node)] = r
      if r.kind == 'var' {
        use_var(f, r.owner, r.slot)
      }
    },
    {name: 'template'} => {
      for p in node.nodes {
        if p.name == 'tsub' {
          scan_expr(p.nodes[0], f)
        }
      }
    },
    {name: 'arrow'} => {
      let [ap, body] = node.nodes
      let params = cond {
        ap.name == 'arrow_one' => [ap.nodes[0]],
        _ => ap.nodes,
      }
      scan_fn_value(node, f, params, body, true, '')
    },
    {name: 'fn_expr'} => {
      let [fname, prms, blk] = node.nodes
      let name = cond {
        fname.nodes.size() > 0 => fname.nodes[0].token,
        _ => '',
      }
      cond {
        name != '' => {
          # a named function expression sees its own name inside
          let g = new_func(f, name, blk.nodes, nil, false)
          closure_of[pkey(node)] = g
          calls[f].push(g)
          funcs[g]['self_name'] = name
          funcs[g]['self_node'] = fname.nodes[0]
          walk_fn(g, prms.nodes, nil)
        },
        _ => scan_fn_value(node, f, prms.nodes, blk, false, ''),
      }
    },
    {name: 'assign_e'} => {
      scan_target(node.nodes[0], f)
      scan_expr(node.nodes[2], f)
    },
    {name: 'seq_e'} => {
      for c in node.nodes {
        scan_expr(c, f)
      }
    },
    {name: 'pre_inc'} => scan_target(node.nodes[1], f),
    {name: 'post_inc'} => scan_target(node.nodes[0], f),
    {name: 'unary'} => {
      for c in node.nodes {
        if c.name != 'unary_op' {
          scan_expr(c, f)
        }
      }
    },
    {name: 'postfix'} => {
      scan_expr(node.nodes[0], f)
      mut i = 1
      while i < node.nodes.size() {
        let step = node.nodes[i]
        cond {
          step.name == 'call_p' ||
            step.name == 'opt_call' => scan_args(step.nodes[0], f),
          step.name == 'index_p' ||
            step.name == 'opt_index' => scan_expr(step.nodes[0], f),
          _ => nil,
        }
        i = i + 1
      }
    },
    {name: 'new_e'} => {
      for c in node.nodes {
        cond {
          c.name == 'new_args' => {
            if c.nodes.size() > 0 {
              scan_args(c.nodes[0], f)
            }
          },
          c.name == 'call_p' => scan_args(c.nodes[0], f),
          c.name == 'index_p' => scan_expr(c.nodes[0], f),
          c.name == 'member_p' => nil,
          _ => scan_expr(c, f),
        }
      }
    },
    {name: 'array_lit'} => {
      for c in node.nodes {
        scan_expr(arg_val(c), f)
      }
    },
    {name: 'object_lit'} => {
      for p in node.nodes {
        match p {
          {name: 'kv_p'} => scan_expr(p.nodes[1], f),
          {name: 'computed_p'} => {
            scan_expr(p.nodes[0], f)
            scan_expr(p.nodes[1], f)
          },
          {name: 'method_p'} => scan_fn_value(
            p,
            f,
            p.nodes[1].nodes,
            p.nodes[2],
            false,
            p.nodes[0].token,
          ),
          {name: 'short_p'} => note_use(p.nodes[0], f),
          {name: 'ospread'} => scan_expr(p.nodes[0], f),
          {name: 'getter_p'} => scan_fn_value(
            p,
            f,
            [],
            p.nodes[1],
            false,
            p.nodes[0].token,
          ),
          {name: 'setter_p'} => scan_fn_value(
            p,
            f,
            [p.nodes[1]],
            p.nodes[2],
            false,
            p.nodes[0].token,
          ),
          _ => nil,
        }
      }
    },
    {name: 'paren'} => scan_expr(node.nodes[0], f),
    {name: 'spread'} => scan_expr(node.nodes[0], f),
    {name: 'ternary'} => {
      for c in node.nodes {
        scan_expr(c, f)
      }
    },
    {name: 'exp_e'} => {
      for c in node.nodes {
        scan_expr(c, f)
      }
    },
    _ => {
      # a binary chain: operands interleaved with op tokens
      if node.nodes != nil {
        for c in node.nodes {
          if !c.name.ends_with('_op') {
            scan_expr(c, f)
          }
        }
      }
    },
  }
  nil
}

fn arg_val(a) {
  cond {
    a.name == 'spread' => a.nodes[0],
    _ => a,
  }
}

fn scan_args(args, f) {
  for a in args.nodes {
    scan_expr(arg_val(a), f)
  }
}

fn scan_target(t, f) {
  cond {
    t.name == 'ident' => note_use(t, f),
    t.name == 'postfix' => scan_expr(t, f),
    t.name == 'paren' => scan_target(t.nodes[0], f),
    t.name == 'arr_pat' || t.name == 'obj_pat' => {
      for id in pattern_idents(t, []) {
        note_use(id, f)
      }
      for tt in pattern_targets(t, []) {
        scan_target(tt, f)
      }
      scan_pattern_dflts(t, f)
    },
    _ => fail(t, 'Invalid left-hand side in assignment'),
  }
}

# --- Pass B: captures -------------------------------------------------------------

fn solve() {
  mut changed = true
  while changed {
    changed = false
    for f in range(funcs.size()) {
      for g in calls[f] {
        for v in free[g].values() {
          let (o, s) = v
          if o != f {
            let key = "{o}:{s}"
            if !free[f].has(key) {
              free[f][key] = v
              changed = true
            }
          }
        }
      }
      let p = funcs[f].parent
      if p != nil {
        for v in free[f].values() {
          let (o, s) = v
          if o != p {
            let key = "{o}:{s}"
            if !free[p].has(key) {
              free[p][key] = v
              changed = true
            }
          }
        }
      }
    }
  }
  for f in range(funcs.size()) {
    mut i = 0
    for v in free[f].values() {
      let (o, s) = v
      capture_index[f]["{o}:{s}"] = i
      i = i + 1
      if !cell_index[o].has(s) {
        cell_index[o][s] = cell_index[o].size()
      }
    }
  }
}

fn access_from(f, v) {
  let (o, s) = v
  cond {
    o == f => cond {
      cell_index[f].has(s) => {kind: 'cell', index: cell_index[f][s]},
      _ => {kind: 'local', index: s},
    },
    _ => {kind: 'capture', index: capture_index[f]["{o}:{s}"]},
  }
}

# --- Pass C: emit ------------------------------------------------------------------

fn make_list(m, ids) {
  let list = m.list_new()
  for x in ids {
    m.list_push(list, x)
  }
  list
}

fn cmap_for(m, f, g) {
  let cmap = m.capture_map_new()
  for v in free[g].values() {
    let a = access_from(f, v)
    m.capture_map_push(cmap, kind: a.kind, index: a.index)
  }
  m.add_capture_map(cmap)
}

fn call_pre(m, f, name, arg_ids, ln, cl) {
  let g = prelude_named[name]
  let callee = m.make_closure(
    func: g,
    cmap: cmap_for(m, f, g),
    line: ln,
    col: cl,
  )
  m.call_value(
    callee: callee,
    args_list: make_list(m, arg_ids),
    line: ln,
    col: cl,
  )
}

fn var_read(m, f, r, ln, cl) {
  let a = access_from(f, (r.owner, r.slot))
  m.var_ref(kind: a.kind, index: a.index, line: ln, col: cl)
}

fn var_write(m, f, r, v, ln, cl) {
  let a = access_from(f, (r.owner, r.slot))
  m.assign(kind: a.kind, index: a.index, value: v, line: ln, col: cl)
}

fn gref(m, f, ln, cl) {
  var_read(m, f, {owner: 0, slot: g_slot}, ln, cl)
}

fn nil_l(m, ln, cl) {
  m.nil_literal(line: ln, col: cl)
}
fn str_l(m, s, ln, cl) {
  m.str_literal(s: s, line: ln, col: cl)
}
fn dbl_l(m, v, ln, cl) {
  m.double_literal(v: v, line: ln, col: cl)
}

fn new_scratch(f) {
  let k = nscratch[f]
  nscratch[f] = k + 1
  nslots[f] + k
}

fn scratch_ref(m, slot, ln, cl) {
  m.var_ref(kind: 'local', index: slot, line: ln, col: cl)
}

# a user-mode value's truthiness, or the raw VM test inside the prelude
fn emit_test(m, f, v, ln, cl) {
  cond {
    in_prelude => v,
    _ => call_pre(m, f, '__truthy', [v], ln, cl),
  }
}

fn unescape(s) {
  mut out = ''
  mut i = 0
  while i < s.size() {
    let c = s.slice(i, i + 1)
    cond {
      c == "\\" && i + 1 < s.size() => {
        let d = s.slice(i + 1, i + 2)
        cond {
          d == 'n' => {
            out = out + "\n"
            i = i + 2
          },
          d == 't' => {
            out = out + "\t"
            i = i + 2
          },
          d == 'r' => {
            out = out + "\r"
            i = i + 2
          },
          d == '0' => {
            out = out + String.from_code_point(0)
            i = i + 2
          },
          d == 'x' && i + 3 < s.size() => {
            out = out +
              String.from_code_point(to_long(s.slice(i + 2, i + 4), base: 16))
            i = i + 4
          },
          d == 'u' && i + 5 < s.size() => {
            out = out +
              String.from_code_point(to_long(s.slice(i + 2, i + 6), base: 16))
            i = i + 6
          },
          d == "\n" => i = i + 2,  # a line continuation
          _ => {
            out = out + d
            i = i + 2
          },
        }
      },
      _ => {
        out = out + c
        i = i + 1
      },
    }
  }
  out
}

fn number_value(tok) {
  cond {
    tok.starts_with('0x') ||
      tok.starts_with('0X') => to_float(to_long(
      tok.slice(2, tok.size()),
      base: 16,
    )),
    tok.starts_with('0b') ||
      tok.starts_with('0B') => to_float(to_long(
      tok.slice(2, tok.size()),
      base: 2,
    )),
    tok.starts_with('0o') ||
      tok.starts_with('0O') => to_float(to_long(
      tok.slice(2, tok.size()),
      base: 8,
    )),
    tok.starts_with('.') => to_float('0' + tok),
    tok.ends_with('.') => to_float(tok + '0'),
    _ => to_float(tok),
  }
}

let binop_pre = {
  '+': '__add',
  '-': '__sub',
  '*': '__mul',
  '/': '__div',
  '%': '__mod',
  '**': '__powop',
  '<': '__lt',
  '<=': '__le',
  '>': '__gt',
  '>=': '__ge',
  '===': '__seq',
  '==': '__eq',
  '&': '__band',
  '|': '__bor',
  '^': '__bxor',
  '<<': '__shl',
  '>>': '__shr',
  '>>>': '__ushr',
  'instanceof': '__instanceof',
  'in': '__in',
}
let binop_raw = {
  '+': 'add',
  '-': 'sub',
  '*': 'mul',
  '/': 'div',
  '%': 'mod',
  '<': 'lt',
  '<=': 'le',
  '>': 'gt',
  '>=': 'ge',
  '===': 'eq',
  '==': 'eq',
  '!==': 'ne',
  '!=': 'ne',
  '&': 'bitand',
  '|': 'bitor',
  '^': 'bitxor',
  '<<': 'shl',
  '>>': 'shr',
}

fn emit_binop(m, f, tok, l, r, ln, cl) {
  cond {
    in_prelude => cond {
      tok ==
        '**' => m.intrinsic(
        name: 'pow',
        args_list: make_list(m, [l, r]),
        line: ln,
        col: cl,
      ),
      tok ==
        '%' => m.intrinsic(
        name: 'fmod',
        args_list: make_list(m, [l, r]),
        line: ln,
        col: cl,
      ),
      _ => m.binary(op: binop_raw[tok], lhs: l, rhs: r, line: ln, col: cl),
    },
    tok == '!==' => ir_not(m, call_pre(m, f, '__seq', [l, r], ln, cl), ln, cl),
    tok == '!=' => ir_not(m, call_pre(m, f, '__eq', [l, r], ln, cl), ln, cl),
    _ => call_pre(m, f, binop_pre[tok], [l, r], ln, cl),
  }
}

fn ir_not(m, v, ln, cl) {
  m.make_if_else(
    cond: v,
    then_branch: m.bool_literal(v: false, line: ln, col: cl),
    else_branch: m.bool_literal(v: true, line: ln, col: cl),
    line: ln,
    col: cl,
  )
}

fn is_undefined_node(n) {
  n.name == 'ident' && n.token == 'undefined'
}

# a left-associative operator chain: [operand, op, operand, op, ...]
fn emit_chain(m, node, f) {
  mut acc = emit_expr(m, node.nodes[0], f)
  mut i = 1
  while i + 1 < node.nodes.size() {
    let op = node.nodes[i]
    let rn = node.nodes[i + 1]
    let tok = op.token
    # in the prelude a comparison against undefined is a tag test: the VM's
    # eq refuses two different tags
    cond {
      in_prelude &&
        (tok == '===' || tok == '!==' || tok == '==' || tok == '!=') &&
        (is_undefined_node(rn) ||
          i == 1 && is_undefined_node(node.nodes[0])) => {
        let subject = cond {
          is_undefined_node(rn) => acc,
          _ => emit_expr(m, rn, f),
        }
        let test = m.binary(
          op: 'eq',
          lhs: m.intrinsic(name: 'typeof', args_list: make_list(m, [subject]), line: op.line, col: op.column),
          rhs: str_l(m, 'nil', op.line, op.column),
          line: op.line,
          col: op.column,
        )
        acc = cond {
          tok == '===' || tok == '==' => test,
          _ => ir_not(m, test, op.line, op.column),
        }
      },
      _ => {
        let rhs = emit_expr(m, rn, f)
        acc = emit_binop(m, f, tok, acc, rhs, op.line, op.column)
      },
    }
    i = i + 2
  }
  acc
}

# && / || / ??: the left operand is kept in a temp and is the result when
# the test says so
fn emit_shortcircuit(m, node, f) {
  let n = node.name
  mut acc = emit_expr(m, node.nodes[0], f)
  mut i = 1
  while i + 1 < node.nodes.size() {
    let op = node.nodes[i]
    let ln = op.line
    let cl = op.column
    let tmp = new_scratch(f)
    let store = m.assign(
      kind: 'local',
      index: tmp,
      value: acc,
      line: ln,
      col: cl,
    )
    let rhs = emit_expr(m, node.nodes[i + 1], f)
    let test = cond {
      n == 'nullish' => cond {
        in_prelude => m.binary(
          op: 'eq',
          lhs: scratch_ref(m, tmp, ln, cl),
          rhs: nil_l(m, ln, cl),
          line: ln,
          col: cl,
        ),
        _ => call_pre(
          m,
          f,
          '__isnullish',
          [scratch_ref(m, tmp, ln, cl)],
          ln,
          cl,
        ),
      },
      _ => emit_test(m, f, scratch_ref(m, tmp, ln, cl), ln, cl),
    }
    let pick = cond {
      n ==
        'lor' => m.make_if_else(
        cond: test,
        then_branch: scratch_ref(m, tmp, ln, cl),
        else_branch: rhs,
        line: ln,
        col: cl,
      ),
      n ==
        'land' => m.make_if_else(
        cond: test,
        then_branch: rhs,
        else_branch: scratch_ref(m, tmp, ln, cl),
        line: ln,
        col: cl,
      ),
      _ => m.make_if_else(
        cond: test,
        then_branch: rhs,
        else_branch: scratch_ref(m, tmp, ln, cl),
        line: ln,
        col: cl,
      ),
    }
    acc = m.block(stmts_list: make_list(m, [store, pick]), line: ln, col: cl)
    i = i + 2
  }
  acc
}

fn emit_string(m, node) {
  let tok = node.token
  str_l(m, unescape(tok.slice(1, tok.size() - 1)), node.line, node.column)
}

# The literal's text between substitutions is read back from the source
# (the parser skips whitespace before each part, so a chunk node has lost
# its leading spaces); a substitution's value goes through ToString.
fn emit_template(m, node, f) {
  let ln = node.line
  let cl = node.column
  let src = cond {
    in_prelude => prelude_src,
    _ => cur_src,
  }
  mut acc = str_l(m, '', ln, cl)
  mut cursor = node.position + 1
  fn chunk(upto) {
    if upto > cursor {
      acc = m.binary(
        op: 'add',
        lhs: acc,
        rhs: str_l(m, unescape(src.slice(cursor, upto).to_string()), ln, cl),
        line: ln,
        col: cl,
      )
    }
  }
  for p in node.nodes {
    if p.name == 'tsub' {
      chunk(p.position)
      let v = emit_expr(m, p.nodes[0], f)
      let sv = cond {
        in_prelude => v,
        _ => call_pre(m, f, '__str', [v], p.line, p.column),
      }
      acc = m.binary(op: 'add', lhs: acc, rhs: sv, line: ln, col: cl)
      # the node's length runs past the whitespace the parser skipped after
      # the closing brace; back up to the brace itself
      mut end = p.position + p.length
      while src.slice(end - 1, end) != '}' {
        end = end - 1
      }
      cursor = end
    }
  }
  chunk(node.position + node.length - 1)
  acc
}

# JS's Function.length: the parameters before the first default or rest
fn fn_length(g) {
  let ds = funcs[g].dflts
  for i in range(ds.size()) {
    if ds[i] != nil {
      return i
    }
  }
  ds.size()
}

fn emit_fn_value(m, node, f, name, is_arrow) {
  let g = closure_of[pkey(node)]
  let c = m.make_closure(
    func: g,
    cmap: cmap_for(m, f, g),
    line: node.line,
    col: node.column,
  )
  cond {
    # a prelude helper referenced as a value is the raw closure; a prelude
    # function expression is a JS function like any other
    in_prelude => c,
    _ => call_pre(
      m,
      f,
      '__mkfn',
      [
        c,
        str_l(m, name, node.line, node.column),
        m.bool_literal(v: is_arrow, line: node.line, col: node.column),
        dbl_l(m, to_float(fn_length(g)), node.line, node.column),
      ],
      node.line,
      node.column,
    ),
  }
}

# [values...] with spreads expanded: an array literal when there is no
# spread, else built by __spread_into
fn emit_arg_array(m, f, arg_nodes, ln, cl) {
  mut has_spread = false
  for a in arg_nodes {
    if a.name == 'spread' {
      has_spread = true
    }
  }
  cond {
    !has_spread => {
      mut ids = []
      for a in arg_nodes {
        ids.push(emit_expr(m, a, f))
      }
      m.array_lit(items_list: make_list(m, ids), line: ln, col: cl)
    },
    _ => {
      let tmp = new_scratch(f)
      mut ids = [m.assign(
        kind: 'local',
        index: tmp,
        value: m.array_lit(items_list: m.list_new(), line: ln, col: cl),
        line: ln,
        col: cl,
      )]
      for a in arg_nodes {
        cond {
          a.name ==
            'spread' => ids.push(call_pre(
            m,
            f,
            '__spread_into',
            [scratch_ref(m, tmp, ln, cl), emit_expr(m, a.nodes[0], f)],
            a.line,
            a.column,
          )),
          _ => ids.push(m.intrinsic(
            name: 'arraypush',
            args_list: make_list(m, [scratch_ref(m, tmp, ln, cl), emit_expr(m, a, f)]),
            line: a.line,
            col: a.column,
          )),
        }
      }
      ids.push(scratch_ref(m, tmp, ln, cl))
      m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
    },
  }
}

fn emit_get(m, f, obj, key, ln, cl) {
  cond {
    in_prelude => m.index(recv: obj, key: key, line: ln, col: cl),
    _ => call_pre(m, f, '__get', [obj, key], ln, cl),
  }
}

fn emit_set(m, f, obj, key, v, ln, cl) {
  cond {
    in_prelude => m.set_index(recv: obj, key: key, value: v, line: ln, col: cl),
    _ => call_pre(m, f, '__set', [obj, key, v], ln, cl),
  }
}

# a call of a raw prelude closure (no receiver)
fn emit_raw_call(m, f, callee, arg_nodes, ln, cl) {
  mut ids = []
  for a in arg_nodes {
    ids.push(emit_expr(m, a, f))
  }
  m.call_value(callee: callee, args_list: make_list(m, ids), line: ln, col: cl)
}

fn emit_postfix(m, node, f) {
  let head = node.nodes[0]
  let steps = node.nodes.slice(1, node.nodes.size())
  # an intrinsic or raw op in the prelude is spelled as a call
  if in_prelude && head.name == 'ident' && steps.size() == 1 && steps[0].name == 'call_p' {
    let r = resolved[pkey(head)]
    if r.kind == 'intrinsic' {
      let (iname, _) = intrinsics[head.token]
      mut ids = []
      for a in steps[0].nodes[0].nodes {
        ids.push(emit_expr(m, a, f))
      }
      return m.intrinsic(
        name: iname,
        args_list: make_list(m, ids),
        line: node.line,
        col: node.column,
      )
    }
    if r.kind == 'const' {
      # the 128 ASCII characters, which the prelude cannot spell itself
      return str_l(
        m,
        String.from_bytes(range(128).collect()),
        node.line,
        node.column,
      )
    }
    if r.kind == 'rawop' {
      let args = steps[0].nodes[0].nodes
      let op = raw_binops[head.token]
      let l = emit_expr(m, args[0], f)
      cond {
        args.size() ==
          1 => return m.unary(
          op: 'bitnot',
          operand: l,
          line: node.line,
          col: node.column,
        ),
        _ => return m.binary(
          op: op,
          lhs: l,
          rhs: emit_expr(m, args[1], f),
          line: node.line,
          col: node.column,
        ),
      }
    }
  }
  emit_steps(m, f, emit_expr(m, head, f), steps, 0)
}

# an optional step, as the plain step it stands for
fn plain_step(step) {
  let name = cond {
    step.name == 'opt_member' => 'member_p',
    step.name == 'opt_index' => 'index_p',
    _ => 'call_p',
  }
  synth(name, step.nodes, step)
}

fn emit_steps(m, f, value0, steps, start) {
  mut value = value0
  mut i = start
  while i < steps.size() {
    let step = steps[i]
    let ln = step.line
    let cl = step.column
    if step.name.starts_with('opt_') {
      # a?.b: the rest of the chain runs only when a is not nullish
      let tmp = new_scratch(f)
      let store = m.assign(
        kind: 'local',
        index: tmp,
        value: value,
        line: ln,
        col: cl,
      )
      mut rest = [plain_step(step)]
      for k in range(i + 1, steps.size()) {
        rest.push(steps[k])
      }
      let rest_v = emit_steps(m, f, scratch_ref(m, tmp, ln, cl), rest, 0)
      let pick = m.make_if_else(
        cond: call_pre(m, f, '__isnullish', [scratch_ref(m, tmp, ln, cl)], ln, cl),
        then_branch: nil_l(m, ln, cl),
        else_branch: rest_v,
        line: ln,
        col: cl,
      )
      return m.block(stmts_list: make_list(m, [store, pick]), line: ln, col: cl)
    }
    cond {
      step.name == 'call_p' => {
        cond {
          in_prelude => value = emit_raw_call(
            m,
            f,
            value,
            step.nodes[0].nodes,
            ln,
            cl,
          ),
          _ => value = call_pre(
            m,
            f,
            '__call',
            [
              value,
              nil_l(m, ln, cl),
              emit_arg_array(m, f, step.nodes[0].nodes, ln, cl),
            ],
            ln,
            cl,
          ),
        }
      },
      step.name == 'member_p' || step.name == 'index_p' => {
        let key = cond {
          step.name == 'member_p' => str_l(m, step.nodes[0].token, ln, cl),
          _ => emit_expr(m, step.nodes[0], f),
        }
        # a method call keeps the receiver: o.m(args)
        cond {
          !in_prelude &&
            i + 1 < steps.size() &&
            steps[i + 1].name == 'call_p' => {
            let cp = steps[i + 1]
            value = call_pre(
              m,
              f,
              '__callm',
              [
                value,
                key,
                emit_arg_array(m, f, cp.nodes[0].nodes, cp.line, cp.column),
              ],
              cp.line,
              cp.column,
            )
            i = i + 1
          },
          !in_prelude &&
            i + 1 < steps.size() &&
            steps[i + 1].name == 'opt_call' => {
            # o.m?.(args): the receiver is kept, and the rest of the chain
            # runs only when the method is there
            let cp = steps[i + 1]
            let recv = new_scratch(f)
            let fnv = new_scratch(f)
            let store_r = m.assign(
              kind: 'local',
              index: recv,
              value: value,
              line: ln,
              col: cl,
            )
            let store_f = m.assign(
              kind: 'local',
              index: fnv,
              value: emit_get(m, f, scratch_ref(m, recv, ln, cl), key, ln, cl),
              line: ln,
              col: cl,
            )
            let called = call_pre(
              m,
              f,
              '__call',
              [
                scratch_ref(m, fnv, ln, cl),
                scratch_ref(m, recv, ln, cl),
                emit_arg_array(m, f, cp.nodes[0].nodes, cp.line, cp.column),
              ],
              cp.line,
              cp.column,
            )
            mut rest = []
            for k in range(i + 2, steps.size()) {
              rest.push(steps[k])
            }
            let rest_v = emit_steps(m, f, called, rest, 0)
            let pick = m.make_if_else(
              cond: call_pre(m, f, '__isnullish', [scratch_ref(m, fnv, ln, cl)], ln, cl),
              then_branch: nil_l(m, ln, cl),
              else_branch: rest_v,
              line: ln,
              col: cl,
            )
            return m.block(
              stmts_list: make_list(m, [store_r, store_f, pick]),
              line: ln,
              col: cl,
            )
          },
          _ => value = emit_get(m, f, value, key, ln, cl),
        }
      },
      _ => fail(step, 'unexpected postfix'),
    }
    i = i + 1
  }
  value
}

fn emit_new(m, node, f) {
  let ln = node.line
  let cl = node.column
  mut value = emit_expr(m, node.nodes[0], f)
  mut i = 1
  while i < node.nodes.size() {
    let step = node.nodes[i]
    cond {
      step.name == 'new_args' => {
        let arg_nodes = cond {
          step.nodes.size() > 0 => step.nodes[0].nodes,
          _ => [],
        }
        value = call_pre(
          m,
          f,
          '__new',
          [value, emit_arg_array(m, f, arg_nodes, ln, cl)],
          ln,
          cl,
        )
      },
      step.name ==
        'call_p' => value = call_pre(
        m,
        f,
        '__call',
        [
          value,
          nil_l(m, step.line, step.column),
          emit_arg_array(m, f, step.nodes[0].nodes, step.line, step.column),
        ],
        step.line,
        step.column,
      ),
      _ => {
        let key = cond {
          step.name ==
            'member_p' => str_l(m, step.nodes[0].token, step.line, step.column),
          _ => emit_expr(m, step.nodes[0], f),
        }
        cond {
          i + 1 < node.nodes.size() && node.nodes[i + 1].name == 'call_p' => {
            let cp = node.nodes[i + 1]
            value = call_pre(
              m,
              f,
              '__callm',
              [
                value,
                key,
                emit_arg_array(m, f, cp.nodes[0].nodes, cp.line, cp.column),
              ],
              cp.line,
              cp.column,
            )
            i = i + 1
          },
          _ => value = emit_get(m, f, value, key, step.line, step.column),
        }
      },
    }
    i = i + 1
  }
  value
}

# --- assignment targets ---

# {kind: 'var', r} | {kind: 'global', name} | {kind: 'prop', obj_id, key_id}
# with the object and key already evaluated into temps
fn emit_target(m, f, t) {
  cond {
    t.name == 'paren' => emit_target(m, f, t.nodes[0]),
    t.name == 'ident' => {
      let r = resolved[pkey(t)]
      cond {
        r.kind == 'var' => {kind: 'var', r: r, pre: []},
        r.kind == 'global' => {kind: 'global', name: t.token, pre: []},
        _ => fail(t, 'Invalid assignment target'),
      }
    },
    t.name == 'postfix' => {
      let last = t.nodes[t.nodes.size() - 1]
      if last.name != 'member_p' && last.name != 'index_p' {
        fail(t, 'Invalid assignment target')
      }
      let base = cond {
        t.nodes.size() == 2 => t.nodes[0],
        _ => synth('postfix', t.nodes.slice(0, t.nodes.size() - 1), t),
      }
      let ln = last.line
      let cl = last.column
      let ot = new_scratch(f)
      let kt = new_scratch(f)
      let key = cond {
        last.name == 'member_p' => str_l(m, last.nodes[0].token, ln, cl),
        _ => emit_expr(m, last.nodes[0], f),
      }
      let pre = [
        m.assign(
          kind: 'local',
          index: ot,
          value: emit_expr(m, base, f),
          line: ln,
          col: cl,
        ),
        m.assign(kind: 'local', index: kt, value: key, line: ln, col: cl),
      ]
      {kind: 'prop', ot: ot, kt: kt, pre: pre, ln: ln, cl: cl}
    },
    _ => fail(t, 'Invalid assignment target'),
  }
}

fn target_read(m, f, tg, ln, cl) {
  cond {
    tg.kind == 'var' => var_read(m, f, tg.r, ln, cl),
    tg.kind ==
      'global' => call_pre(m, f, '__gget', [str_l(m, tg.name, ln, cl)], ln, cl),
    _ => emit_get(
      m,
      f,
      scratch_ref(m, tg.ot, ln, cl),
      scratch_ref(m, tg.kt, ln, cl),
      ln,
      cl,
    ),
  }
}

# the write, as a node whose value is the stored value
fn target_write(m, f, tg, v, ln, cl) {
  cond {
    tg.kind == 'var' => {
      let st = var_write(m, f, tg.r, v, ln, cl)
      m.block(
        stmts_list: make_list(m, [st, var_read(m, f, tg.r, ln, cl)]),
        line: ln,
        col: cl,
      )
    },
    tg.kind == 'global' => cond {
      in_prelude => m.set_index(
        recv: gref(m, f, ln, cl),
        key: str_l(m, tg.name, ln, cl),
        value: v,
        line: ln,
        col: cl,
      ),
      _ => call_pre(m, f, '__gset', [str_l(m, tg.name, ln, cl), v], ln, cl),
    },
    _ => emit_set(
      m,
      f,
      scratch_ref(m, tg.ot, ln, cl),
      scratch_ref(m, tg.kt, ln, cl),
      v,
      ln,
      cl,
    ),
  }
}

fn with_pre(m, pre, v, ln, cl) {
  cond {
    pre.size() == 0 => v,
    _ => {
      mut ids = pre
      ids.push(v)
      m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
    },
  }
}

fn emit_assign(m, node, f) {
  let [lhs, op, rhs] = node.nodes
  let ln = op.line
  let cl = op.column
  if lhs.name == 'arr_pat' || lhs.name == 'obj_pat' {
    # [a, b] = v: the value is the expression's own
    let tmp = new_scratch(f)
    mut ids = [m.assign(
      kind: 'local',
      index: tmp,
      value: emit_expr(m, rhs, f),
      line: ln,
      col: cl,
    )]
    for x in emit_bind(m, f, lhs, scratch_ref(m, tmp, ln, cl), ln, cl) {
      ids.push(x)
    }
    ids.push(scratch_ref(m, tmp, ln, cl))
    return m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
  }
  let tg = emit_target(m, f, lhs)
  cond {
    op.token ==
      '=' => with_pre(
      m,
      tg.pre,
      target_write(m, f, tg, emit_expr(m, rhs, f), ln, cl),
      ln,
      cl,
    ),
    op.token == '||=' || op.token == '&&=' || op.token == '??=' => {
      let cur = target_read(m, f, tg, ln, cl)
      let tmp = new_scratch(f)
      let store = m.assign(
        kind: 'local',
        index: tmp,
        value: cur,
        line: ln,
        col: cl,
      )
      let test = cond {
        op.token ==
          '??=' => call_pre(
          m,
          f,
          '__isnullish',
          [scratch_ref(m, tmp, ln, cl)],
          ln,
          cl,
        ),
        _ => emit_test(m, f, scratch_ref(m, tmp, ln, cl), ln, cl),
      }
      let write = target_write(m, f, tg, emit_expr(m, rhs, f), ln, cl)
      let pick = cond {
        op.token ==
          '||=' => m.make_if_else(
          cond: test,
          then_branch: scratch_ref(m, tmp, ln, cl),
          else_branch: write,
          line: ln,
          col: cl,
        ),
        op.token ==
          '&&=' => m.make_if_else(
          cond: test,
          then_branch: write,
          else_branch: scratch_ref(m, tmp, ln, cl),
          line: ln,
          col: cl,
        ),
        _ => m.make_if_else(
          cond: test,
          then_branch: write,
          else_branch: scratch_ref(m, tmp, ln, cl),
          line: ln,
          col: cl,
        ),
      }
      mut ids = tg.pre
      ids.push(store)
      ids.push(pick)
      m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
    },
    _ => {
      let bop = op.token.slice(0, op.token.size() - 1).to_string()
      let cur = target_read(m, f, tg, ln, cl)
      let v = emit_binop(m, f, bop, cur, emit_expr(m, rhs, f), ln, cl)
      with_pre(m, tg.pre, target_write(m, f, tg, v, ln, cl), ln, cl)
    },
  }
}

fn emit_update(m, node, f, prefix) {
  let (op, t) = cond {
    prefix => (node.nodes[0], node.nodes[1]),
    _ => (node.nodes[1], node.nodes[0]),
  }
  let ln = op.line
  let cl = op.column
  let tg = emit_target(m, f, t)
  let tmp = new_scratch(f)
  let old = cond {
    in_prelude => target_read(m, f, tg, ln, cl),
    _ => call_pre(m, f, '__tonum', [target_read(m, f, tg, ln, cl)], ln, cl),
  }
  let store = m.assign(kind: 'local', index: tmp, value: old, line: ln, col: cl)
  let delta = cond {
    in_prelude => m.literal(v: 1, line: ln, col: cl),
    _ => dbl_l(m, 1.0, ln, cl),
  }
  let nv = m.binary(
    op: cond { op.token == '++' => 'add', _ => 'sub' },
    lhs: scratch_ref(m, tmp, ln, cl),
    rhs: delta,
    line: ln,
    col: cl,
  )
  let write = target_write(m, f, tg, nv, ln, cl)
  mut ids = tg.pre
  ids.push(store)
  cond {
    prefix => ids.push(write),
    _ => {
      ids.push(write)
      ids.push(scratch_ref(m, tmp, ln, cl))
    },
  }
  m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
}

fn emit_unary(m, node, f) {
  if node.nodes.size() == 1 {
    return emit_expr(m, node.nodes[0], f)
  }
  let [op, operand] = node.nodes
  let ln = op.line
  let cl = op.column
  let tok = op.token
  cond {
    tok == 'typeof' => {
      # typeof of an unbound name is 'undefined', not a ReferenceError
      let v = cond {
        !in_prelude &&
          operand.name == 'ident' &&
          resolved[pkey(operand)].kind ==
            'global' => m.index(
          recv: gref(m, f, ln, cl),
          key: str_l(m, operand.token, ln, cl),
          line: ln,
          col: cl,
        ),
        _ => emit_expr(m, operand, f),
      }
      cond {
        in_prelude => m.intrinsic(
          name: 'typeof',
          args_list: make_list(m, [v]),
          line: ln,
          col: cl,
        ),
        _ => call_pre(m, f, '__typeof_js', [v], ln, cl),
      }
    },
    tok ==
      'void' => m.block(
      stmts_list: make_list(m, [emit_expr(m, operand, f), nil_l(m, ln, cl)]),
      line: ln,
      col: cl,
    ),
    tok == 'delete' => {
      let tg = emit_target(m, f, operand)
      cond {
        tg.kind ==
          'prop' => with_pre(
          m,
          tg.pre,
          call_pre(
            m,
            f,
            '__delete',
            [scratch_ref(m, tg.ot, ln, cl), scratch_ref(m, tg.kt, ln, cl)],
            ln,
            cl,
          ),
          ln,
          cl,
        ),
        _ => m.bool_literal(v: true, line: ln, col: cl),
      }
    },
    in_prelude => {
      let v = emit_expr(m, operand, f)
      cond {
        tok == '!' => ir_not(m, v, ln, cl),
        tok == '-' => m.unary(op: 'neg', operand: v, line: ln, col: cl),
        tok == '+' => v,
        _ => m.unary(op: 'bitnot', operand: v, line: ln, col: cl),
      }
    },
    _ => {
      let v = emit_expr(m, operand, f)
      let name = cond {
        tok == '!' => '__not',
        tok == '-' => '__neg',
        tok == '+' => '__tonum',
        _ => '__bnot',
      }
      call_pre(m, f, name, [v], ln, cl)
    },
  }
}

fn emit_object(m, node, f) {
  let ln = node.line
  let cl = node.column
  let tmp = new_scratch(f)
  mut ids = [m.assign(
    kind: 'local',
    index: tmp,
    value: m.object_lit(kv_list: m.list_new(), line: ln, col: cl),
    line: ln,
    col: cl,
  )]
  fn put(pk, pv, pl, pc) {
    ids.push(m.set_index(
      recv: scratch_ref(m, tmp, pl, pc),
      key: pk,
      value: pv,
      line: pl,
      col: pc,
    ))
  }
  for p in node.nodes {
    match p {
      {name: 'kv_p'} => {
        let k = p.nodes[0]
        let kstr = cond {
          k.name == 'string' => unescape(k.token.slice(1, k.token.size() - 1)),
          k.name == 'number' => number_key(k.token),
          _ => k.token,
        }
        put(
          str_l(m, kstr, p.line, p.column),
          emit_expr(m, p.nodes[1], f),
          p.line,
          p.column,
        )
      },
      {name: 'computed_p'} => {
        let kstr = cond {
          in_prelude => emit_expr(m, p.nodes[0], f),
          _ => call_pre(
            m,
            f,
            '__key',
            [emit_expr(m, p.nodes[0], f)],
            p.line,
            p.column,
          ),
        }
        put(kstr, emit_expr(m, p.nodes[1], f), p.line, p.column)
      },
      {name: 'method_p'} => put(
        str_l(m, p.nodes[0].token, p.line, p.column),
        emit_fn_value(m, p, f, p.nodes[0].token, false),
        p.line,
        p.column,
      ),
      {name: 'short_p'} => put(
        str_l(m, p.nodes[0].token, p.line, p.column),
        emit_expr(m, p.nodes[0], f),
        p.line,
        p.column,
      ),
      {name: 'getter_p'} => put(
        str_l(m, "\x01get:" + p.nodes[0].token, p.line, p.column),
        emit_fn_value(m, p, f, p.nodes[0].token, false),
        p.line,
        p.column,
      ),
      {name: 'setter_p'} => put(
        str_l(m, "\x01set:" + p.nodes[0].token, p.line, p.column),
        emit_fn_value(m, p, f, p.nodes[0].token, false),
        p.line,
        p.column,
      ),
      {name: 'ospread'} => ids.push(call_pre(
        m,
        f,
        '__obj_spread',
        [scratch_ref(m, tmp, p.line, p.column), emit_expr(m, p.nodes[0], f)],
        p.line,
        p.column,
      )),
      _ => nil,
    }
  }
  ids.push(scratch_ref(m, tmp, ln, cl))
  m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
}

# a numeric literal key, spelled the way ToString would
fn number_key(tok) {
  let v = number_value(tok)
  cond {
    v == to_float(to_long(v)) && v < 1.0e21 && v > -1.0e21 => "{to_long(v)}",
    _ => "{v}",
  }
}

fn emit_expr(m, node, f) {
  let ln = node.line
  let cl = node.column
  match node {
    {name: 'number'} => cond {
      in_prelude &&
        !node.token.contains('.') &&
        !node.token.contains('e') &&
        !node.token.contains('E') => m.literal(
        v: to_long(node.token),
        line: ln,
        col: cl,
      ),
      _ => dbl_l(m, number_value(node.token), ln, cl),
    },
    {name: 'string'} => emit_string(m, node),
    {name: 'template'} => emit_template(m, node, f),
    {name: 'true_l'} => m.bool_literal(v: true, line: ln, col: cl),
    {name: 'false_l'} => m.bool_literal(v: false, line: ln, col: cl),
    {name: 'null_l'} => m.index(
      recv: gref(m, f, ln, cl),
      key: str_l(m, 'null', ln, cl),
      line: ln,
      col: cl,
    ),
    {name: 'this_e'} => {
      let r = resolved[pkey(node)]
      cond {
        r.kind == 'var' => var_read(m, f, r, ln, cl),
        _ => nil_l(m, ln, cl),
      }
    },
    {name: 'ident'} => {
      let r = resolved[pkey(node)]
      cond {
        r.kind == 'var' => var_read(m, f, r, ln, cl),
        r.kind ==
          'fn' => m.make_closure(
          func: r.func,
          cmap: cmap_for(m, f, r.func),
          line: ln,
          col: cl,
        ),
        r.kind == 'global' => cond {
          node.token == 'undefined' => nil_l(m, ln, cl),
          in_prelude => m.index(
            recv: gref(m, f, ln, cl),
            key: str_l(m, node.token, ln, cl),
            line: ln,
            col: cl,
          ),
          _ => call_pre(m, f, '__gget', [str_l(m, node.token, ln, cl)], ln, cl),
        },
        _ => fail(node, "cannot use '{node.token}' as a value"),
      }
    },
    {name: 'paren'} => emit_expr(m, node.nodes[0], f),
    {name: 'arrow'} => emit_fn_value(m, node, f, '', true),
    {name: 'fn_expr'} => {
      let fname = node.nodes[0]
      let name = cond {
        fname.nodes.size() > 0 => fname.nodes[0].token,
        _ => '',
      }
      let v = emit_fn_value(m, node, f, name, false)
      cond {
        # a named function expression binds its own name in its scope: the
        # closure is stored into that slot the first time it runs (below,
        # in the prologue), so the value here is just the function
        _ => v,
      }
    },
    {name: 'assign_e'} => emit_assign(m, node, f),
    {name: 'pre_inc'} => emit_update(m, node, f, true),
    {name: 'post_inc'} => emit_update(m, node, f, false),
    {name: 'unary'} => emit_unary(m, node, f),
    {name: 'postfix'} => emit_postfix(m, node, f),
    {name: 'new_e'} => emit_new(m, node, f),
    {name: 'array_lit'} => emit_arg_array(m, f, node.nodes, ln, cl),
    {name: 'object_lit'} => emit_object(m, node, f),
    {name: 'ternary'} => {
      let [c, a, b] = node.nodes
      m.make_if_else(
        cond: emit_test(m, f, emit_expr(m, c, f), ln, cl),
        then_branch: emit_expr(m, a, f),
        else_branch: emit_expr(m, b, f),
        line: ln,
        col: cl,
      )
    },
    {name: 'exp_e'} => {
      let l = emit_expr(m, node.nodes[0], f)
      let r = emit_expr(m, node.nodes[1], f)
      emit_binop(m, f, '**', l, r, ln, cl)
    },
    {name: 'seq_e'} => {
      mut ids = []
      for c in node.nodes {
        ids.push(emit_expr(m, c, f))
      }
      m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
    },
    {name: 'lor'} => emit_shortcircuit(m, node, f),
    {name: 'land'} => emit_shortcircuit(m, node, f),
    {name: 'nullish'} => emit_shortcircuit(m, node, f),
    {name: 'spread'} => fail(node, 'unexpected spread'),
    _ => cond {
      node.nodes != nil && node.nodes.size() >= 3 => emit_chain(m, node, f),
      node.nodes != nil &&
        node.nodes.size() == 1 => emit_expr(m, node.nodes[0], f),
      _ => fail(node, "unexpected expression '{node.name}'"),
    },
  }
}

# --- statements ---

fn emit_block(m, blk, f) {
  let slots = block_slots[pkey(blk)]
  mut ids = fresh_slots(m, f, slots, blk.line, blk.column)
  emit_stmts_into(m, blk.nodes, f, ids)
  m.block(stmts_list: make_list(m, ids), line: blk.line, col: blk.column)
}

# a block's own bindings start out undefined on every entry; a captured
# one gets a fresh cell so earlier closures keep theirs
fn fresh_slots(m, f, slots, ln, cl) {
  mut ids = []
  for s in slots {
    cond {
      cell_index[f].has(s) => {
        ids.push(m.cell_fresh(cell: cell_index[f][s], line: ln, col: cl))
        ids.push(m.assign(
          kind: 'cell',
          index: cell_index[f][s],
          value: nil_l(m, ln, cl),
          line: ln,
          col: cl,
        ))
      },
      _ => ids.push(m.assign(
        kind: 'local',
        index: s,
        value: nil_l(m, ln, cl),
        line: ln,
        col: cl,
      )),
    }
  }
  ids
}

fn emit_stmts_into(m, stmts, f, ids) {
  # hoisted function declarations come first
  for s in stmts {
    if s.name == 'fn_decl' {
      let r = resolved[pkey(s.nodes[0])]
      ids.push(var_write(
        m,
        f,
        r,
        emit_fn_value(m, s, f, s.nodes[0].token, false),
        s.line,
        s.column,
      ))
    }
  }
  for s in stmts {
    if s.name != 'fn_decl' {
      let e = emit_stmt(m, s, f)
      if e != nil {
        ids.push(e)
      }
    }
  }
  nil
}

fn emit_sub(m, st, f) {
  cond {
    st.name == 'block' => emit_block(m, st, f),
    _ => {
      let e = emit_stmt(m, st, f)
      cond {
        e ==
          nil => m.block(
          stmts_list: m.list_new(),
          line: st.line,
          col: st.column,
        ),
        _ => e,
      }
    },
  }
}

# Bind a pattern to a value: the statements that store it, in order. An
# identifier writes its binding (a declaration's, or an assignment's
# target: a global when nothing declares it).
fn write_ident(m, f, id, v, ln, cl) {
  let r = resolved[pkey(id)]
  cond {
    r.kind == 'var' => var_write(m, f, r, v, ln, cl),
    r.kind ==
      'global' => call_pre(
      m,
      f,
      '__gset',
      [str_l(m, id.token, ln, cl), v],
      ln,
      cl,
    ),
    _ => fail(id, 'Invalid assignment target'),
  }
}

fn emit_bind(m, f, pat, v, ln, cl) {
  cond {
    pat.name == 'ident' => [write_ident(m, f, pat, v, ln, cl)],
    pat.name == 'postfix' || pat.name == 'paren' => {
      let tg = emit_target(m, f, pat)
      [with_pre(m, tg.pre, target_write(m, f, tg, v, ln, cl), ln, cl)]
    },
    pat.name == 'pat_dflt' || pat.name == 'opat_short' => cond {
      pat.nodes.size() > 1 => {
        # the default applies when the value is undefined
        let tmp = new_scratch(f)
        let store = m.assign(
          kind: 'local',
          index: tmp,
          value: v,
          line: ln,
          col: cl,
        )
        let test = m.binary(
          op: 'eq',
          lhs: m.intrinsic(name: 'typeof', args_list: make_list(m, [scratch_ref(m, tmp, ln, cl)]), line: ln, col: cl),
          rhs: str_l(m, 'nil', ln, cl),
          line: ln,
          col: cl,
        )
        let picked = m.make_if_else(
          cond: test,
          then_branch: emit_expr(m, pat.nodes[1], f),
          else_branch: scratch_ref(m, tmp, ln, cl),
          line: ln,
          col: cl,
        )
        mut ids = [store]
        for x in emit_bind(m, f, pat.nodes[0], picked, ln, cl) {
          ids.push(x)
        }
        ids
      },
      _ => emit_bind(m, f, pat.nodes[0], v, ln, cl),
    },
    pat.name == 'arr_pat' => {
      let tmp = new_scratch(f)
      mut ids = [m.assign(
        kind: 'local',
        index: tmp,
        value: call_pre(m, f, '__destr_arr', [v], ln, cl),
        line: ln,
        col: cl,
      )]
      mut i = 0
      for el in pat.nodes {
        cond {
          el.name == 'pat_hole' => nil,
          el.name == 'rest_b' => {
            let rest = call_pre(
              m,
              f,
              '__slice_from',
              [scratch_ref(m, tmp, ln, cl), m.literal(v: i, line: ln, col: cl)],
              ln,
              cl,
            )
            for x in emit_bind(m, f, el.nodes[0], rest, ln, cl) {
              ids.push(x)
            }
          },
          _ => {
            let item = call_pre(
              m,
              f,
              '__at',
              [scratch_ref(m, tmp, ln, cl), m.literal(v: i, line: ln, col: cl)],
              ln,
              cl,
            )
            for x in emit_bind(m, f, el, item, ln, cl) {
              ids.push(x)
            }
          },
        }
        i = i + 1
      }
      ids
    },
    pat.name == 'obj_pat' => {
      let tmp = new_scratch(f)
      mut ids = [m.assign(
        kind: 'local',
        index: tmp,
        value: call_pre(m, f, '__destr_obj', [v], ln, cl),
        line: ln,
        col: cl,
      )]
      mut keys = []
      for el in pat.nodes {
        cond {
          el.name == 'rest_b' => {
            mut kids = []
            for k in keys {
              kids.push(str_l(m, k, ln, cl))
            }
            let rest = call_pre(
              m,
              f,
              '__obj_rest',
              [
                scratch_ref(m, tmp, ln, cl),
                m.array_lit(items_list: make_list(m, kids), line: ln, col: cl),
              ],
              ln,
              cl,
            )
            for x in emit_bind(m, f, el.nodes[0], rest, ln, cl) {
              ids.push(x)
            }
          },
          _ => {
            let (key, target) = cond {
              el.name == 'opat_kv' => (prop_key_text(el.nodes[0]), el.nodes[1]),
              _ => (el.nodes[0].token, el),
            }
            keys.push(key)
            let item = call_pre(
              m,
              f,
              '__get',
              [scratch_ref(m, tmp, ln, cl), str_l(m, key, ln, cl)],
              ln,
              cl,
            )
            for x in emit_bind(m, f, target, item, ln, cl) {
              ids.push(x)
            }
          },
        }
      }
      ids
    },
    _ => fail(pat, "unexpected pattern '{pat.name}'"),
  }
}

# a literal property key's text: a name, a string, or a number
fn prop_key_text(k) {
  cond {
    k.name == 'string' => unescape(k.token.slice(1, k.token.size() - 1)),
    k.name == 'number' => number_key(k.token),
    _ => k.token,
  }
}

fn emit_decl(m, node, f) {
  mut ids = []
  mut i = 1
  while i < node.nodes.size() {
    let d = node.nodes[i]
    let pat = d.nodes[0]
    cond {
      d.nodes.size() > 1 => {
        for x in emit_bind(m, f, pat, emit_expr(m, d.nodes[1], f), pat.line, pat.column) {
          ids.push(x)
        }
      },
      node.nodes[0].token == 'var' => nil,  # `var x;` leaves the binding alone
      pat.name ==
        'ident' => ids.push(write_ident(
        m,
        f,
        pat,
        nil_l(m, pat.line, pat.column),
        pat.line,
        pat.column,
      )),
      _ => fail(pat, 'Missing initializer in destructuring declaration'),
    }
    i = i + 1
  }
  cond {
    ids.size() == 0 => nil,
    ids.size() == 1 => ids[0],
    _ => m.block(
      stmts_list: make_list(m, ids),
      line: node.line,
      col: node.column,
    ),
  }
}

fn for_step_ids(m, f, slots, step_node, ln, cl) {
  mut ids = []
  for s in slots {
    if cell_index[f].has(s) {
      let tmp = new_scratch(f)
      let ci = cell_index[f][s]
      ids.push(m.assign(
        kind: 'local',
        index: tmp,
        value: m.var_ref(kind: 'cell', index: ci, line: ln, col: cl),
        line: ln,
        col: cl,
      ))
      ids.push(m.cell_fresh(cell: ci, line: ln, col: cl))
      ids.push(m.assign(
        kind: 'cell',
        index: ci,
        value: scratch_ref(m, tmp, ln, cl),
        line: ln,
        col: cl,
      ))
    }
  }
  if step_node != nil {
    ids.push(emit_expr(m, step_node, f))
  }
  ids
}

fn emit_stmt(m, node, f) {
  let ln = node.line
  let cl = node.column
  match node {
    {name: 'var_decl'} => emit_decl(m, node, f),
    {name: 'var_decl_ns'} => emit_decl(m, node, f),
    {name: 'fn_decl'} => nil,
    {name: 'if_s'} => {
      let c = emit_test(m, f, emit_expr(m, node.nodes[0], f), ln, cl)
      let t = emit_sub(m, node.nodes[1], f)
      cond {
        node.nodes.size() >
          2 => m.make_if_else(
          cond: c,
          then_branch: t,
          else_branch: emit_sub(m, node.nodes[2].nodes[0], f),
          line: ln,
          col: cl,
        ),
        _ => m.make_if(cond: c, then_branch: t, line: ln, col: cl),
      }
    },
    {name: 'while_s'} => {
      loop_ctx[f].push({step: nil})
      let body = emit_sub(m, node.nodes[1], f)
      loop_ctx[f].pop()
      m.make_while(
        cond: emit_test(m, f, emit_expr(m, node.nodes[0], f), ln, cl),
        body: body,
        line: ln,
        col: cl,
      )
    },
    {name: 'do_s'} => {
      # first = true; while (first || cond) { first = false; body }
      let flag = new_scratch(f)
      loop_ctx[f].push({step: nil})
      let body = emit_sub(m, node.nodes[0], f)
      loop_ctx[f].pop()
      let test = m.make_if_else(
        cond: scratch_ref(m, flag, ln, cl),
        then_branch: m.bool_literal(v: true, line: ln, col: cl),
        else_branch: emit_test(m, f, emit_expr(m, node.nodes[1], f), ln, cl),
        line: ln,
        col: cl,
      )
      let clear = m.assign(
        kind: 'local',
        index: flag,
        value: m.bool_literal(v: false, line: ln, col: cl),
        line: ln,
        col: cl,
      )
      m.block(
        stmts_list: make_list(m, [
          m.assign(kind: 'local', index: flag, value: m.bool_literal(v: true, line: ln, col: cl), line: ln, col: cl),
          m.make_while(cond: test, body: m.block(stmts_list: make_list(m, [clear, body]), line: ln, col: cl), line: ln, col: cl)]),
        line: ln,
        col: cl,
      )
    },
    {name: 'for_s'} => {
      let [init, cnd, step, body] = node.nodes
      let slots = block_slots[pkey(node)]
      mut ids = fresh_slots(m, f, slots, ln, cl)
      if init.nodes.size() > 0 {
        let i0 = init.nodes[0]
        let e = cond {
          i0.name == 'var_decl_ns' => emit_decl(m, i0, f),
          _ => emit_expr(m, i0, f),
        }
        if e != nil {
          ids.push(e)
        }
      }
      let step_node = cond {
        step.nodes.size() > 0 => step.nodes[0],
        _ => nil,
      }
      loop_ctx[f].push({step: fn (m2) {
        for_step_ids(m2, f, slots, step_node, ln, cl)
      }})
      let b = emit_sub(m, body, f)
      loop_ctx[f].pop()
      mut body_ids = [b]
      for s in for_step_ids(m, f, slots, step_node, ln, cl) {
        body_ids.push(s)
      }
      let test = cond {
        cnd.nodes.size() >
          0 => emit_test(m, f, emit_expr(m, cnd.nodes[0], f), ln, cl),
        _ => m.bool_literal(v: true, line: ln, col: cl),
      }
      ids.push(m.make_while(
        cond: test,
        body: m.block(stmts_list: make_list(m, body_ids), line: ln, col: cl),
        line: ln,
        col: cl,
      ))
      m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
    },
    {name: 'for_of'} => emit_for_each(m, node, f, '__iter'),
    {name: 'for_in'} => emit_for_each(m, node, f, '__forin_iter'),
    {name: 'switch_s'} => emit_switch(m, node, f),
    {name: 'return_s'} => {
      let rv = node.nodes[0]
      let v = cond {
        rv.nodes.size() > 0 => emit_expr(m, rv.nodes[0], f),
        _ => nil_l(m, ln, cl),
      }
      m.make_return(value: v, line: ln, col: cl)
    },
    {name: 'break_s'} => m.make_break(line: ln, col: cl),
    {name: 'continue_s'} => {
      let ctx = loop_ctx[f]
      if ctx.size() == 0 {
        fail(node, 'Illegal continue statement')
      }
      let top = ctx[ctx.size() - 1]
      cond {
        # inside a switch: leave it with the flag set; the enclosing loop
        # continues after the switch
        top.cont !=
          nil => m.block(
          stmts_list: make_list(m, [
            m.assign(kind: 'local', index: top.cont, value: m.bool_literal(v: true, line: ln, col: cl), line: ln, col: cl),
            m.make_break(line: ln, col: cl)]),
          line: ln,
          col: cl,
        ),
        top.step == nil => m.make_continue(line: ln, col: cl),
        _ => {
          mut ids = top.step(m)
          ids.push(m.make_continue(line: ln, col: cl))
          m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
        },
      }
    },
    {name: 'throw_s'} => m.make_throw(
      value: emit_expr(m, node.nodes[0], f),
      line: ln,
      col: cl,
    ),
    {name: 'try_s'} => emit_try(m, node, f),
    {name: 'block'} => emit_block(m, node, f),
    {name: 'empty_s'} => nil,
    {name: 'expr_s'} => emit_expr(m, node.nodes[0], f),
    _ => emit_expr(m, node, f),
  }
}

# for (pat of/in src) body: the source's iterator (for-in walks its key
# list), each step binding the pattern anew
fn emit_for_each(m, node, f, iter_fn) {
  let ln = node.line
  let cl = node.column
  let [kw, pat, src, body] = node.nodes
  let slots = block_slots[pkey(node)]
  let it = new_scratch(f)
  let cur = new_scratch(f)
  mut ids = [m.assign(
    kind: 'local',
    index: it,
    value: call_pre(m, f, iter_fn, [emit_expr(m, src, f)], ln, cl),
    line: ln,
    col: cl,
  )]
  fn advance(m2) {
    [m2.assign(
      kind: 'local',
      index: cur,
      value: call_pre(m2, f, '__iter_step', [scratch_ref(m2, it, ln, cl)], ln, cl),
      line: ln,
      col: cl,
    )]
  }
  ids.push(advance(m)[0])
  loop_ctx[f].push({step: advance})
  let b = emit_sub(m, body, f)
  loop_ctx[f].pop()
  mut body_ids = fresh_slots(m, f, slots, ln, cl)
  let item = m.index(
    recv: scratch_ref(m, cur, ln, cl),
    key: m.literal(v: 0, line: ln, col: cl),
    line: ln,
    col: cl,
  )
  for x in emit_bind(m, f, pat, item, ln, cl) {
    body_ids.push(x)
  }
  body_ids.push(b)
  body_ids.push(advance(m)[0])
  let test = m.make_if_else(
    cond: m.binary(op: 'eq',
                   lhs: m.intrinsic(name: 'typeof', args_list: make_list(m, [scratch_ref(m, cur, ln, cl)]), line: ln, col: cl),
                   rhs: str_l(m, 'nil', ln, cl), line: ln, col: cl),
    then_branch: m.bool_literal(v: false, line: ln, col: cl),
    else_branch: m.bool_literal(v: true, line: ln, col: cl),
    line: ln,
    col: cl,
  )
  ids.push(m.make_while(
    cond: test,
    body: m.block(stmts_list: make_list(m, body_ids), line: ln, col: cl),
    line: ln,
    col: cl,
  ))
  m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
}

# switch: pick the first case whose value is === the subject (else the
# default), then run every case body from there on -- fall-through -- in a
# loop a break leaves.
fn emit_switch(m, node, f) {
  let ln = node.line
  let cl = node.column
  let cases = node.nodes.slice(1, node.nodes.size())
  let slots = block_slots[pkey(node)]
  let subj = new_scratch(f)
  let idx = new_scratch(f)
  let cont = new_scratch(f)
  let none = 1000000
  mut ids = fresh_slots(m, f, slots, ln, cl)
  ids.push(m.assign(
    kind: 'local',
    index: subj,
    value: emit_expr(m, node.nodes[0], f),
    line: ln,
    col: cl,
  ))
  ids.push(m.assign(
    kind: 'local',
    index: idx,
    value: m.literal(v: none, line: ln, col: cl),
    line: ln,
    col: cl,
  ))
  ids.push(m.assign(
    kind: 'local',
    index: cont,
    value: m.bool_literal(v: false, line: ln, col: cl),
    line: ln,
    col: cl,
  ))
  # the tests, in order, each stopping the search
  mut default_i = nil
  mut chain = m.block(stmts_list: m.list_new(), line: ln, col: cl)
  mut k = cases.size() - 1
  while k >= 0 {
    let c = cases[k]
    cond {
      c.name == 'default_c' => default_i = k,
      _ => {
        let test = call_pre(
          m,
          f,
          '__seq',
          [scratch_ref(m, subj, ln, cl), emit_expr(m, c.nodes[0], f)],
          c.line,
          c.column,
        )
        chain = m.make_if_else(
          cond: test,
          then_branch: m.assign(kind: 'local', index: idx, value: m.literal(v: k, line: ln, col: cl), line: ln, col: cl),
          else_branch: chain,
          line: c.line,
          col: c.column,
        )
      },
    }
    k = k - 1
  }
  ids.push(chain)
  if default_i != nil {
    ids.push(m.make_if(
      cond: m.binary(op: 'eq', lhs: scratch_ref(m, idx, ln, cl), rhs: m.literal(v: none, line: ln, col: cl), line: ln, col: cl),
      then_branch: m.assign(kind: 'local', index: idx, value: m.literal(v: default_i, line: ln, col: cl), line: ln, col: cl),
      line: ln,
      col: cl,
    ))
  }
  loop_ctx[f].push({step: nil, cont: cont})
  mut body_ids = []
  for k2 in range(cases.size()) {
    let c = cases[k2]
    let body = c.nodes[c.nodes.size() - 1]
    mut stmt_ids = []
    emit_stmts_into(m, body.nodes, f, stmt_ids)
    body_ids.push(m.make_if(
      cond: m.binary(op: 'le', lhs: scratch_ref(m, idx, ln, cl), rhs: m.literal(v: k2, line: ln, col: cl), line: ln, col: cl),
      then_branch: m.block(stmts_list: make_list(m, stmt_ids), line: c.line, col: c.column),
      line: c.line,
      col: c.column,
    ))
  }
  loop_ctx[f].pop()
  body_ids.push(m.make_break(line: ln, col: cl))
  ids.push(m.make_while(
    cond: m.bool_literal(v: true, line: ln, col: cl),
    body: m.block(stmts_list: make_list(m, body_ids), line: ln, col: cl),
    line: ln,
    col: cl,
  ))
  # a continue inside targeted the loop around the switch
  let outer = loop_ctx[f]
  if outer.size() > 0 {
    let top = outer[outer.size() - 1]
    mut cids = cond {
      top.step != nil => top.step(m),
      _ => [],
    }
    cids.push(cond {
      top.cont !=
        nil => m.block(
        stmts_list: make_list(m, [
          m.assign(kind: 'local', index: top.cont, value: m.bool_literal(v: true, line: ln, col: cl), line: ln, col: cl),
          m.make_break(line: ln, col: cl)]),
        line: ln,
        col: cl,
      ),
      _ => m.make_continue(line: ln, col: cl),
    })
    ids.push(m.make_if(
      cond: scratch_ref(m, cont, ln, cl),
      then_branch: m.block(stmts_list: make_list(m, cids), line: ln, col: cl),
      line: ln,
      col: cl,
    ))
  }
  m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
}

fn emit_try(m, node, f) {
  let ln = node.line
  let cl = node.column
  mut body = emit_block(m, node.nodes[0], f)
  mut catch_c = nil
  mut finally_c = nil
  mut i = 1
  while i < node.nodes.size() {
    let c = node.nodes[i]
    cond {
      c.name == 'catch_c' => catch_c = c,
      _ => finally_c = c,
    }
    i = i + 1
  }
  if catch_c != nil {
    let r = resolved[pkey(catch_c)]
    let a = access_from(f, (f, r.slot))
    # the VM lands the value in a plain local; a captured binding is copied
    # into its cell after the trap-to-error fix
    let slot = cond {
      a.kind == 'local' => a.index,
      _ => new_scratch(f),
    }
    let fixed = cond {
      in_prelude => scratch_ref(m, slot, ln, cl),
      _ => call_pre(
        m,
        f,
        '__catch_fix',
        [scratch_ref(m, slot, ln, cl)],
        ln,
        cl,
      ),
    }
    let bind = cond {
      a.kind ==
        'local' => m.assign(
        kind: 'local',
        index: slot,
        value: fixed,
        line: ln,
        col: cl,
      ),
      _ => m.block(
        stmts_list: make_list(m, [m.cell_fresh(cell: a.index, line: ln, col: cl),
                                             m.assign(kind: 'cell', index: a.index, value: fixed, line: ln, col: cl)]),
        line: ln,
        col: cl,
      ),
    }
    let handler = m.block(
      stmts_list: make_list(m, [bind, emit_block(m, catch_c.nodes[1], f)]),
      line: ln,
      col: cl,
    )
    body = m.make_try(
      caught_local: slot,
      body: body,
      handler: handler,
      line: ln,
      col: cl,
    )
  }
  if finally_c != nil {
    # finally runs on every way out: as a defer in a scope around the try
    let g = closure_of[pkey(finally_c)]
    let d = m.make_defer(
      value: m.make_closure(func: g, cmap: cmap_for(m, f, g), line: ln, col: cl),
      line: ln,
      col: cl,
    )
    body = m.scope(
      first_local: 0,
      end_local: 0,
      body: m.block(stmts_list: make_list(m, [d, body]), line: ln, col: cl),
      line: ln,
      col: cl,
    )
  }
  body
}

# --- functions and the driver ---

fn emit_funcs(m) {
  for f in range(funcs.size()) {
    let fi = funcs[f]
    in_prelude = fi.is_prelude
    mut ids = []
    # defaults: a parameter that arrived undefined takes its default
    for pi in range(fi.dflts.size()) {
      let d = fi.dflts[pi]
      if d != nil {
        let slot = pi + cond {
          fi.params.size() > fi.dflts.size() => 1,
          _ => 0,
        }
        let test = m.binary(
          op: 'eq',
          lhs: m.intrinsic(name: 'typeof', args_list: make_list(m, [m.var_ref(kind: 'local', index: slot, line: 1, col: 1)]), line: 1, col: 1),
          rhs: str_l(m, 'nil', 1, 1),
          line: 1,
          col: 1,
        )
        ids.push(m.make_if(
          cond: test,
          then_branch: m.assign(kind: 'local', index: slot, value: emit_expr(m, d, f), line: 1, col: 1),
          line: 1,
          col: 1,
        ))
      }
    }
    # a rest parameter: pack the hidden trailing slots by the supplied count
    if fi.rest != nil {
      let first = fi.params.size() - 8
      mut hidden = []
      for k in range(8) {
        hidden.push(m.var_ref(kind: 'local', index: first + k, line: 1, col: 1))
      }
      let n = m.binary(
        op: 'sub',
        lhs: m.intrinsic(name: 'argcount', args_list: m.list_new(), line: 1, col: 1),
        rhs: m.literal(v: first, line: 1, col: 1),
        line: 1,
        col: 1,
      )
      let rslot = fi.params.size()
      let a = access_from(f, (f, rslot))
      ids.push(m.assign(
        kind: a.kind,
        index: a.index,
        value: call_pre(m, f, '__rest_pack',
                                        [m.array_lit(items_list: make_list(m, hidden), line: 1, col: 1), n], 1, 1),
        line: 1,
        col: 1,
      ))
    }
    # pattern parameters unpack from their hidden slots
    if fi.pat_params != nil {
      for pp in fi.pat_params {
        let (slot, pat) = pp
        for x in emit_bind(m, f, pat, m.var_ref(kind: 'local', index: slot, line: 1, col: 1), 1, 1) {
          ids.push(x)
        }
      }
    }
    # captured parameters move into their cells
    for p in range(fi.params.size()) {
      if cell_index[f].has(p) {
        ids.push(m.assign(
          kind: 'cell',
          index: cell_index[f][p],
          value: m.var_ref(kind: 'local', index: p, line: 1, col: 1),
          line: 1,
          col: 1,
        ))
      }
    }
    # a named function expression's own name
    if fi.self_slot != nil {
      let a = access_from(f, (f, fi.self_slot))
      ids.push(m.assign(
        kind: a.kind,
        index: a.index,
        value: call_pre(m, f, '__mkfn',
                                        [m.make_closure(func: f, cmap: cmap_for(m, f, f), line: 1, col: 1),
                                         str_l(m, fi.name, 1, 1), m.bool_literal(v: false, line: 1, col: 1)], 1, 1),
        line: 1,
        col: 1,
      ))
    }
    # the function's vars start out undefined
    for s in fi.var_names {
      let a = access_from(f, (f, s))
      ids.push(m.assign(
        kind: a.kind,
        index: a.index,
        value: nil_l(m, 1, 1),
        line: 1,
        col: 1,
      ))
    }
    if f == 0 {
      ids.push(m.assign(
        kind: 'cell',
        index: cell_index[0][g_slot],
        value: call_pre(m, 0, '__init_globals', [], 1, 1),
        line: 1,
        col: 1,
      ))
      let ta = access_from(0, (0, this_slot))
      ids.push(m.assign(
        kind: ta.kind,
        index: ta.index,
        value: m.object_lit(kv_list: m.list_new(), line: 1, col: 1),
        line: 1,
        col: 1,
      ))
    }
    cond {
      fi.body_expr !=
        nil => ids.push(m.make_return(
        value: emit_expr(m, fi.body_expr, f),
        line: 1,
        col: 1,
      )),
      _ => {
        emit_stmts_into(m, fi.stmts, f, ids)
        ids.push(m.make_return(value: nil_l(m, 1, 1), line: 1, col: 1))
      },
    }
    mut body = m.block(stmts_list: make_list(m, ids), line: 1, col: 1)
    if f == 0 {
      # whatever escapes the program is reported the way Node reports it
      let slot = new_scratch(0)
      let caught = m.var_ref(kind: 'local', index: slot, line: 1, col: 1)
      body = m.make_try(
        caught_local: slot,
        body: body,
        handler: m.make_throw(value: call_pre(m, 0, '__uncaught_text', [caught], 1, 1), line: 1, col: 1),
        line: 1,
        col: 1,
      )
    }
    let func = m.add_func(
      name: fi.name,
      num_locals: nslots[f] + nscratch[f],
      num_captures: free[f].size(),
      num_cells: cell_index[f].size(),
      num_params: fi.params.size(),
      body: body,
    )
    m.set_lenient_arity(func: func)
  }
  in_prelude = false
}

fn build(m, prelude_tree, root) {
  let main = new_func(nil, 'main', root.nodes, nil, false)
  enter_scope(main)
  g_slot = declare_var(main, '__G', nil)
  this_slot = declare_var(main, 'this', nil)

  in_prelude = true
  # prelude helpers are parentless raw closures; each is registered before
  # any body is walked so they can call each other in any order
  for s in prelude_tree.nodes {
    if s.name != 'fn_decl' {
      fail(s, 'the prelude holds function declarations only')
    }
    let id = s.nodes[0]
    prelude_named[id.token] = new_func(
      nil,
      id.token,
      s.nodes[2].nodes,
      nil,
      false,
    )
  }
  for s in prelude_tree.nodes {
    let g = prelude_named[s.nodes[0].token]
    walk_fn(g, s.nodes[1].nodes, nil)
  }
  in_prelude = false

  # main's body: the program's statements, in main's own scope
  for s in root.nodes {
    collect_vars(s, main)
  }
  scan_stmts(root.nodes, main)
  let scopes = scope_stack[main]
  block_slots["0:0"] = scopes[0].slots
  leave_scope(main)

  solve()
  emit_funcs(m)
}

let want_ir = Sys.argv.contains('--ir')
let want_bc = Sys.argv.contains('--bc')
let want_ast = Sys.argv.contains('--ast')
mut lib_src = ''
mut cli = []
mut skip = false
for i in range(Sys.argv.size()) {
  let a = Sys.argv[i]
  cond {
    skip => skip = false,
    a == '--lib' => {
      lib_src = lib_src + FS.read(Sys.argv[i + 1]) + "\n"
      skip = true
    },
    a == '--ir' || a == '--bc' || a == '--ast' => nil,
    _ => cli.push(a),
  }
}
if cli.empty() {
  println("usage: culebra mini_js.cul [--lib FILE.js] [--ir | --bc] PROGRAM.js...")
  Sys.exit(1)
}

let prelude_tree = Peg.parse(grammar, prelude_src, path: '<prelude>')

mut cur_src = ''
mut had_err = false
for path in cli {
  if cli.size() > 1 {
    println('-----8<----- ' + path.split('/')[-1])
  }
  funcs = []
  free = []
  calls = []
  capture_index = []
  cell_index = []
  nslots = []
  nscratch = []
  scope_stack = []
  closure_of = {}
  resolved = {}
  block_slots = {}
  prelude_named = {}
  loop_ctx = []
  synth_count = 0
  in_prelude = false
  try {
    cur_src = lib_src + FS.read(path)
    let tree = Peg.parse(grammar, cur_src, path: path)
    if want_ast {
      inspect(tree)
      continue
    }
    let m = CodeGen.Module.new()
    build(m, prelude_tree, tree)
    m.verify()
    if want_ir {
      print(m.dump_ir())
    } else if want_bc {
      print(m.dump_bc())
    } else {
      m.run()
    }
  } catch e {
    match e {
      {kind: 'MiniError'} => {
        IO.eprintln("{path}:{e.line}:{e.col}: SyntaxError: {e.message}")
        had_err = true
      },
      {kind: 'PegError'} => {
        IO.eprintln(e.message)
        had_err = true
      },
      {kind: 'IrError'} => {
        cond {
          e.message.starts_with('uncaught: ') => IO.eprintln(e
            .message
            .slice(10, e.message.size())
            .to_string()),
          _ => IO.eprintln("{path}:{e.line}:{e.col}: {e.message}"),
        }
        had_err = true
      },
      _ => throw e,
    }
  }
}
if had_err {
  Sys.exit(1)
}
