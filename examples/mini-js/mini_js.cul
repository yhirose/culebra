# mini-js: an ES6 subset, compiled to CodeGen (cpp-vmlib's Core-IR) and run
# on its bytecode executor. Where mini-culebra proves the backend carries
# culebra, this proves it carries a language with different rules for
# everything the VM leaves to the language: coercing operators, prototype
# delegation, functions as objects, a job queue.
#
# The oracle is Node: tests/mini_js_test.sh runs every samples/*.js under
# both and diffs stdout. Programs print through console.log; the shared
# samples/fmt.js formats values the same way under both (Node's own
# console.log formatting of objects is an implementation detail, not the
# language), and an error is compared by its constructor's name only.
#
# The value model, on the VM's own values: a JS number is a Double (so
# integer arithmetic is exact to 2^53, like JS); a string is the VM's
# byte string (length and indexing count bytes -- a known difference for
# non-ASCII text); undefined is nil; null is one object the runtime keeps;
# an array is a VM array; an object is a VM object with a hidden
# "\x01proto" key for its prototype; a function is an object carrying its
# closure under "\x01fn", so it can hold properties (prototype, name) like
# any other. Every JS function's closure takes `this` as its first
# parameter, arrows included (theirs is unused: `this` binds lexically).
#
# Batches: J1 -- scalars and their operators, var/let/const,
# if/while/do/for/for-of/break/continue, functions and closures, arrows,
# template literals, objects and arrays with the first methods, new,
# try/catch/throw, the Error classes. J2 -- destructuring (declarations,
# parameters, for-of heads, assignment), switch, for-in, optional
# chaining, accessors in object literals, the comma operator, JSON.
#
# Known differences: string length/indexing by byte; no TDZ for a captured
# let (read before its declaration it is undefined); arrays have no holes
# (a gap reads as undefined and prints as one); ToPrimitive on objects is
# fixed ('[object Object]', arrays join); a function's name is only the
# declared one (no inference from `let f = function () {}`); at most 8 call
# arguments; sloppy mode only (a receiver-less call sees the global object
# as `this`, as Node's CommonJS modules do; the program's own `this` is an
# empty object, like module.exports).

let bt = String.from_code_point(96)
let q = String.from_code_point(39)

let grammar = `
  program    <- stmt*                                          { no_ast_opt }
  stmt       <- var_decl / fn_decl / if_s / while_s / do_s / for_of / for_in /
                for_s / switch_s / return_s / break_s / continue_s / throw_s /
                try_s / block / empty_s / expr_s
  var_decl   <- decl_kw declr (',' declr)* ';'?                  { no_ast_opt }
  decl_kw    <- < 'var' / 'let' / 'const' >
  declr      <- binding ('=' !'=' expr)?                         { no_ast_opt }
  fn_decl    <- 'function' ident '(' params ')' block             { no_ast_opt }
  params     <- (param (',' param)*)? ','?                        { no_ast_opt }
  param      <- rest_p / dflt_p / binding
  rest_p     <- '...' ident                                      { no_ast_opt }
  dflt_p     <- binding '=' !'=' expr                            { no_ast_opt }
  if_s       <- 'if' '(' expr ')' stmt else_c?                   { no_ast_opt }
  else_c     <- 'else' stmt                                      { no_ast_opt }
  while_s    <- 'while' '(' expr ')' stmt                        { no_ast_opt }
  do_s       <- 'do' stmt 'while' '(' expr ')' ';'?              { no_ast_opt }
  for_of     <- 'for' '(' decl_kw binding 'of' expr ')' stmt     { no_ast_opt }
  for_in     <- 'for' '(' decl_kw binding 'in' expr ')' stmt     { no_ast_opt }
  for_s      <- 'for' '(' for_init ';' for_cond ';' for_step ')' stmt { no_ast_opt }
  for_init   <- (var_decl_ns / seq_e)?                           { no_ast_opt }
  var_decl_ns <- decl_kw declr (',' declr)*                      { no_ast_opt }
  for_cond   <- expr?                                            { no_ast_opt }
  for_step   <- seq_e?                                           { no_ast_opt }
  return_s   <- 'return' ret_val ';'?                            { no_ast_opt }
  ret_val    <- expr?                                            { no_ast_opt }
  break_s    <- 'break' ';'?                                     { no_ast_opt }
  continue_s <- 'continue' ';'?                                  { no_ast_opt }
  throw_s    <- 'throw' expr ';'?                                { no_ast_opt }
  try_s      <- 'try' block catch_c? finally_c?                  { no_ast_opt }
  catch_c    <- 'catch' catch_p block                            { no_ast_opt }
  catch_p    <- ('(' ident ')')?                                 { no_ast_opt }
  finally_c  <- 'finally' block                                  { no_ast_opt }
  block      <- '{' stmt* '}'                                    { no_ast_opt }
  empty_s    <- ';'                                              { no_ast_opt }
  expr_s     <- expr ';'?                                        { no_ast_opt }
  switch_s   <- 'switch' '(' expr ')' '{' (case_c / default_c)* '}' { no_ast_opt }
  case_c     <- 'case' expr ':' case_body                         { no_ast_opt }
  default_c  <- 'default' ':' case_body                           { no_ast_opt }
  case_body  <- (!('case' / 'default') stmt)*                     { no_ast_opt }

  binding    <- arr_pat / obj_pat / ident
  arr_pat    <- '[' (pat_el (',' pat_el)*)? ','? ']'             { no_ast_opt }
  pat_el     <- rest_b / pat_dflt / pat_hole
  pat_dflt   <- (arr_pat / obj_pat / postfix) ('=' !'=' expr)?  { no_ast_opt }
  pat_hole   <- &','                                             { no_ast_opt }
  rest_b     <- '...' binding                                    { no_ast_opt }
  obj_pat    <- '{' (opat_el (',' opat_el)*)? ','? '}'           { no_ast_opt }
  opat_el    <- rest_b / opat_kv / opat_short
  opat_kv    <- pkey ':' pat_dflt                                { no_ast_opt }
  opat_short <- ident ('=' !'=' expr)?                           { no_ast_opt }
  seq_e      <- expr (',' expr)*

  expr       <- arrow / assign_e / ternary
  arrow      <- arrow_p '=>' arrow_body                          { no_ast_opt }
  arrow_p    <- '(' params ')' / arrow_one
  arrow_one  <- ident                                            { no_ast_opt }
  arrow_body <- block / expr
  assign_e   <- (arr_pat / obj_pat / postfix) assign_op expr     { no_ast_opt }
  assign_op  <- < '=' !'=' / '+=' / '-=' / '*=' / '/=' / '%=' / '**=' / '??=' / '||=' / '&&=' >
  ternary    <- nullish ('?' expr ':' expr)?
  nullish    <- lor (nullish_op lor)*
  nullish_op <- < '??' >
  lor        <- land (lor_op land)*
  lor_op     <- < '||' > !'='
  land       <- bor (land_op bor)*
  land_op    <- < '&&' > !'='
  bor        <- bxor (bor_op bxor)*
  bor_op     <- < '|' > ![|=]
  bxor       <- band (bxor_op band)*
  bxor_op    <- < '^' > !'='
  band       <- eq (band_op eq)*
  band_op    <- < '&' > ![&=]
  eq         <- rel (eq_op rel)*
  eq_op      <- < '===' / '!==' / '==' / '!=' >
  rel        <- shift (rel_op shift)*
  rel_op     <- < '<=' / '>=' / '<' !'<' / '>' !'>' / 'instanceof' / 'in' >
  shift      <- add (shift_op add)*
  shift_op   <- < '<<' / '>>>' / '>>' > !'='
  add        <- mul (add_op mul)*
  add_op     <- < '+' > ![+=] / < '-' > ![-=]
  mul        <- exp_e (mul_op exp_e)*
  mul_op     <- < [*/%] > ![*=]
  exp_e      <- unary ('**' !'=' exp_e)?
  unary      <- unary_op unary / update
  unary_op   <- < '!' !'=' / '-' ![-=] / '+' ![+=] / '~' / 'typeof' / 'void' / 'delete' >
  update     <- pre_inc / post_inc / postfix
  pre_inc    <- inc_op postfix                                   { no_ast_opt }
  post_inc   <- postfix inc_op                                   { no_ast_opt }
  inc_op     <- < '++' / '--' >
  postfix    <- new_e / primary (call_p / index_p / member_p / opt_call / opt_index / opt_member)*
  opt_member <- '?.' pname                                       { no_ast_opt }
  opt_index  <- '?.' '[' expr ']'                                { no_ast_opt }
  opt_call   <- '?.' '(' args ')'                                { no_ast_opt }
  new_e      <- 'new' primary (index_p / member_p)* new_args (call_p / index_p / member_p)* { no_ast_opt }
  new_args   <- ('(' args ')')?                                  { no_ast_opt }
  call_p     <- '(' args ')'                                     { no_ast_opt }
  args       <- (arg (',' arg)*)? ','?                           { no_ast_opt }
  arg        <- spread / expr
  spread     <- '...' expr                                       { no_ast_opt }
  index_p    <- '[' expr ']'                                     { no_ast_opt }
  member_p   <- '.' pname                                        { no_ast_opt }
  pname      <- < [a-zA-Z_$][a-zA-Z0-9_$]* >
  primary    <- number / string / template / true_l / false_l / null_l /
                this_e / array_lit / object_lit / fn_expr / paren / ident
  true_l     <- 'true'                                           { no_ast_opt }
  false_l    <- 'false'                                          { no_ast_opt }
  null_l     <- 'null'                                           { no_ast_opt }
  this_e     <- 'this'                                           { no_ast_opt }
  number     <- < '0x' [0-9a-fA-F]+ / '0b' [01]+ / '0o' [0-7]+ /
                  [0-9]+ ('.' [0-9]*)? exp? / '.' [0-9]+ exp? >
  exp        <- [eE] [-+]? [0-9]+
  string     <- < ['] (!['\\] . / '\\' .)* ['] > / < ["] (!["\\] . / '\\' .)* ["] >
  array_lit  <- '[' (arg (',' arg)*)? ','? ']'                   { no_ast_opt }
  object_lit <- '{' (oprop (',' oprop)*)? ','? '}'               { no_ast_opt }
  oprop      <- getter_p / setter_p / method_p / kv_p / computed_p / ospread / short_p
  getter_p   <- 'get' pname '(' ')' block                        { no_ast_opt }
  setter_p   <- 'set' pname '(' ident ')' block                  { no_ast_opt }
  kv_p       <- pkey ':' expr                                    { no_ast_opt }
  pkey       <- pname / string / number
  computed_p <- '[' expr ']' ':' expr                            { no_ast_opt }
  method_p   <- pname '(' params ')' block                       { no_ast_opt }
  short_p    <- ident                                            { no_ast_opt }
  ospread    <- '...' expr                                       { no_ast_opt }
  fn_expr    <- 'function' fn_name '(' params ')' block          { no_ast_opt }
  fn_name    <- ident?                                           { no_ast_opt }
  paren      <- '(' seq_e ')'                                    { no_ast_opt }
  ident      <- !keyword < [a-zA-Z_$][a-zA-Z0-9_$]* >
  keyword    <- ('if' / 'else' / 'while' / 'for' / 'function' / 'return' /
                 'let' / 'const' / 'var' / 'true' / 'false' / 'null' / 'this' /
                 'new' / 'typeof' / 'instanceof' / 'in' / 'class' / 'extends' /
                 'super' / 'throw' / 'try' / 'catch' / 'finally' / 'break' /
                 'continue' / 'do' / 'void' / 'delete' / 'yield' / 'await' /
                 'switch' / 'case' / 'default') ![a-zA-Z0-9_$]

  %whitespace <- ([ \t\r\n]+ / '//' [^\n]* / '/*' (!'*/' .)* '*/')*
  %word       <- [a-zA-Z0-9_$]
` +
  '  template   <- ' +
  q +
  bt +
  q +
  ' tpart* ' +
  q +
  bt +
  q +
  '   { no_ast_opt }' +
  "\n" +
  '  tpart      <- tsub / tchunk' +
  "\n" +
  '  tsub       <- ' +
  q +
  '$' +
  q +
  ' ' +
  q +
  '{' +
  q +
  ' expr ' +
  q +
  '}' +
  q +
  '   { no_ast_opt }' +
  "\n" +
  '  tchunk     <- < (!(' +
  q +
  bt +
  q +
  ' / ' +
  q +
  '$' +
  q +
  ' ' +
  q +
  '{' +
  q +
  ' / ' +
  q +
  '\\' +
  q +
  ') . / ' +
  q +
  '\\' +
  q +
  ' .)+ >' +
  "\n"

# --- The runtime, in JS --------------------------------------------------------
#
# Compiled in prelude mode, where the language is the VM's: operators are
# the raw VM operations over the value tags they accept, a property read
# is a raw index, and a call of a declared helper is a raw call (no
# `this`). Only a function *expression* here is a JS function -- the ones
# stored in the prototypes -- and calls of JS function values go through
# __call. Names of the form __xxx that match the intrinsic table are VM
# intrinsics. __G is the global table (built by __init_globals, held by
# the entry frame, captured by every function).

let prelude_src = `
function __nan() { return 0.0 / 0.0; }
function __inf() { return 1.0 / 0.0; }

function __is_null(v) { return __typeof(v) === 'object' && __same(v, __G.null); }
function __is_fnobj(v) { return __typeof(v) === 'object' && __objecthas(v, '\x01fn'); }
function __is_err(v) { return __typeof(v) === 'object' && __objecthas(v, '\x01msg'); }
function __proto_of(v) {
  var t = __typeof(v);
  if (t === 'object') {
    if (__objecthas(v, '\x01proto')) { var q = v['\x01proto']; return __is_null(q) ? undefined : q; }
    if (__is_fnobj(v)) return __G.Function_proto;
    return __G.Object_proto;
  }
  if (t === 'array') return __G.Array_proto;
  if (t === 'string') return __G.String_proto;
  if (t === 'double') return __G.Number_proto;
  if (t === 'bool') return __G.Boolean_proto;
  return undefined;
}

// typeof, as JS spells it
function __typeof_js(v) {
  var t = __typeof(v);
  if (t === 'nil') return 'undefined';
  if (t === 'bool') return 'boolean';
  if (t === 'double') return 'number';
  if (t === 'string') return 'string';
  if (t === 'object') { if (__is_fnobj(v)) return 'function'; }
  return 'object';
}

function __truthy(v) {
  var t = __typeof(v);
  if (t === 'nil') return false;
  if (t === 'bool') return v;
  if (t === 'double') return v === v && v !== 0.0;
  if (t === 'string') return __len(v) !== 0;
  if (t === 'object') return !__is_null(v);
  return true;
}
function __not(v) { return !__truthy(v); }
function __isnullish(v) { return __typeof(v) === 'nil' || __is_null(v); }

// --- strings ---------------------------------------------------------------
function __substr(s, a, b) {
  var out = '';
  var i = a;
  while (i < b) { out = out + s[i]; i = i + 1; }
  return out;
}
function __str_index_of(s, needle, from) {
  var n = __len(s);
  var m = __len(needle);
  var i = from;
  while (i + m <= n) {
    var j = 0;
    var ok = true;
    while (j < m) {
      if (s[i + j] !== needle[j]) { ok = false; j = m; } else { j = j + 1; }
    }
    if (ok) return i;
    i = i + 1;
  }
  return -1;
}
function __is_digit(c) { return c >= '0' && c <= '9'; }
function __digit(c) { return __toint(__todouble(__G.digits[c])); }
function __repeat(s, n) { var out = ''; var i = 0; while (i < n) { out = out + s; i = i + 1; } return out; }

// Number::toString: the VM's shortest form, reshaped to JS's rules for
// when the exponent appears (>= 1e21, < 1e-6) and how it is spelled.
function __numstr(d) {
  if (d !== d) return 'NaN';
  if (d === __inf()) return 'Infinity';
  if (d === 0.0 - __inf()) return '-Infinity';
  if (d === 0.0) return '0';
  var neg = d < 0.0;
  var s = __tostr(neg ? 0.0 - d : d);
  var epos = __str_index_of(s, 'e', 0);
  var mant = s;
  var e = 0;
  if (epos >= 0) {
    mant = __substr(s, 0, epos);
    var es = __substr(s, epos + 1, __len(s));
    var esign = 1;
    if (es[0] === '-') { esign = -1; es = __substr(es, 1, __len(es)); }
    else if (es[0] === '+') { es = __substr(es, 1, __len(es)); }
    e = esign * __toint(__todouble(__parse_digits(es)));
  }
  var dot = __str_index_of(mant, '.', 0);
  if (epos < 0 && dot < 0 && __len(mant) > 17) {
    // an integer past 2^53 comes out fully expanded; JS wants the shortest
    // digit string that still reads back as this double
    mant = __shortest_int(mant, neg ? 0.0 - d : d);
  }
  var ip = dot >= 0 ? __substr(mant, 0, dot) : mant;
  var fp = dot >= 0 ? __substr(mant, dot + 1, __len(mant)) : '';
  var digits = '';
  var n = 0;
  if (ip === '0') {
    var z = 0;
    while (z < __len(fp) && fp[z] === '0') z = z + 1;
    digits = __substr(fp, z, __len(fp));
    n = 0 - z;
  } else {
    var lead = 0;
    while (lead + 1 < __len(ip) && ip[lead] === '0') lead = lead + 1;
    ip = __substr(ip, lead, __len(ip));
    digits = ip + fp;
    n = __len(ip);
  }
  n = n + e;
  var k = __len(digits);
  while (k > 1 && digits[k - 1] === '0') { k = k - 1; }
  digits = __substr(digits, 0, k);
  var out = '';
  if (k <= n && n <= 21) {
    out = digits + __repeat('0', n - k);
  } else if (0 < n && n <= 21) {
    out = __substr(digits, 0, n) + '.' + __substr(digits, n, k);
  } else if (-6 < n && n <= 0) {
    out = '0.' + __repeat('0', 0 - n) + digits;
  } else {
    var ex = n - 1;
    var m = k === 1 ? digits : digits[0] + '.' + __substr(digits, 1, k);
    out = m + 'e' + (ex >= 0 ? '+' : '-') + __numstr(__todouble(ex >= 0 ? ex : 0 - ex));
  }
  return neg ? '-' + out : out;
}

// The shortest prefix of the exact expansion E (rounded) that lies within
// half an ulp of d, padded back to E's length. Exact decimal string
// arithmetic: the values are past 2^53, where doubles cannot carry them.
function __shortest_int(E, d) {
  var x = d;
  var e2 = 0;
  while (x >= 2.0) { x = x / 2.0; e2 = e2 + 1; }
  var half = __tostr(__pow(2.0, __todouble(e2 - 53)));
  var p = 1;
  while (p < __len(E)) {
    var C = __dstr_round(E, p);
    var diff = __dstr_cmp(C, E) >= 0 ? __dstr_sub(C, E) : __dstr_sub(E, C);
    if (__dstr_cmp(diff, half) < 0) return C;
    p = p + 1;
  }
  return E;
}
function __dstr_strip(a) {
  var i = 0;
  while (i + 1 < __len(a) && a[i] === '0') i = i + 1;
  return __substr(a, i, __len(a));
}
function __dstr_cmp(a, b) {
  var x = __dstr_strip(a);
  var y = __dstr_strip(b);
  if (__len(x) !== __len(y)) return __len(x) < __len(y) ? -1 : 1;
  if (x < y) return -1;
  if (x > y) return 1;
  return 0;
}
function __dstr_sub(a, b) {
  var out = '';
  var borrow = 0;
  var i = __len(a) - 1;
  var j = __len(b) - 1;
  while (i >= 0) {
    var v = __digit(a[i]) - borrow - (j >= 0 ? __digit(b[j]) : 0);
    if (v < 0) { v = v + 10; borrow = 1; } else { borrow = 0; }
    out = __G.chars[v + 48] + out;
    i = i - 1;
    j = j - 1;
  }
  return __dstr_strip(out);
}
function __dstr_inc(a) {
  var out = '';
  var carry = 1;
  var i = __len(a) - 1;
  while (i >= 0) {
    var v = __digit(a[i]) + carry;
    if (v >= 10) { v = v - 10; carry = 1; } else { carry = 0; }
    out = __G.chars[v + 48] + out;
    i = i - 1;
  }
  return carry === 1 ? '1' + out : out;
}
function __dstr_round(E, p) {
  var head = __substr(E, 0, p);
  if (__digit(E[p]) >= 5) head = __dstr_inc(head);
  return head + __repeat('0', __len(E) - p);
}

// digits only -> the number they spell (as a string of digits, no sign)
function __parse_digits(s) {
  var v = 0.0;
  var i = 0;
  while (i < __len(s)) { v = v * 10.0 + __todouble(__digit(s[i])); i = i + 1; }
  return v;
}
function __trim(s) {
  var a = 0;
  var b = __len(s);
  while (a < b && (s[a] === ' ' || s[a] === '\t' || s[a] === '\n' || s[a] === '\r')) a = a + 1;
  while (b > a && (s[b - 1] === ' ' || s[b - 1] === '\t' || s[b - 1] === '\n' || s[b - 1] === '\r')) b = b - 1;
  return __substr(s, a, b);
}
// StringToNumber: decimal with fraction and exponent, hex, Infinity, else NaN
function __str_to_num(s0) {
  var s = __trim(s0);
  var n = __len(s);
  if (n === 0) return 0.0;
  var sign = 1.0;
  var i = 0;
  if (s[0] === '-') { sign = -1.0; i = 1; } else if (s[0] === '+') { i = 1; }
  if (__substr(s, i, n) === 'Infinity') return sign * __inf();
  if (i + 1 < n && s[i] === '0' && (s[i + 1] === 'x' || s[i + 1] === 'X')) {
    var hv = 0.0;
    var j = i + 2;
    if (j >= n) return __nan();
    while (j < n) {
      var hd = __hexval(s[j]);
      if (hd < 0) return __nan();
      hv = hv * 16.0 + __todouble(hd);
      j = j + 1;
    }
    return sign * hv;
  }
  var ipart = 0.0;
  var seen = false;
  while (i < n && __is_digit(s[i])) { ipart = ipart * 10.0 + __todouble(__digit(s[i])); i = i + 1; seen = true; }
  var fpart = 0.0;
  var fscale = 1.0;
  if (i < n && s[i] === '.') {
    i = i + 1;
    while (i < n && __is_digit(s[i])) { fpart = fpart * 10.0 + __todouble(__digit(s[i])); fscale = fscale * 10.0; i = i + 1; seen = true; }
  }
  if (!seen) return __nan();
  var v = (ipart * fscale + fpart) / fscale;
  if (i < n && (s[i] === 'e' || s[i] === 'E')) {
    i = i + 1;
    var esign = 1.0;
    if (i < n && s[i] === '-') { esign = -1.0; i = i + 1; } else if (i < n && s[i] === '+') { i = i + 1; }
    var ev = 0.0;
    var eseen = false;
    while (i < n && __is_digit(s[i])) { ev = ev * 10.0 + __todouble(__digit(s[i])); i = i + 1; eseen = true; }
    if (!eseen) return __nan();
    v = v * __pow(10.0, esign * ev);
  }
  if (i !== n) return __nan();
  return sign * v;
}
function __hexval(c) {
  if (__objecthas(__G.hexdigits, c)) return __toint(__todouble(__G.hexdigits[c]));
  return -1;
}

// --- conversions -----------------------------------------------------------
function __tonum(v) {
  var t = __typeof(v);
  if (t === 'double') return v;
