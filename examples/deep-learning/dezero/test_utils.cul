# Regression tests for dezero/utils.cul.

import dz from './dezero/core.cul'
import F from './dezero/functions.cul'
import conv from './dezero/functions_conv.cul'
import LC from './dezero/layers_conv.cul'
import U from './dezero/utils.cul'

@test
fn numerical_grad_matches_the_analytic_gradient_of_sin_times_x() {
  x = dz.Variable(Tensor.from([1.2]))
  y = F.sin(x) * x
  y.backward()
  num = U.numerical_grad_flat(fn (v) {
    F.sin(v) * v
  }, dz.Variable(Tensor.from([1.2])))
  Tensor.eval(num)
  assert_close(x.grad.data.to_array()[0], num.to_array()[0], 1.0e-3)
}

@test
fn gradient_check_passes_through_a_conv_relu_pool_chain() {
  # Regression test for the `raw_elementwise`/rank>2 bug this port hit
  # while training a real CNN: ReLU's backward mask used to call
  # `.to_array()` directly on a 4-D tensor, which Tensor refuses.
  #
  # ReLU and max pooling have kinks, and at a kink a central difference is
  # not the gradient. So the weights and the input are spelled out rather
  # than drawn: every pre-activation is at least 0.06 from zero, and every
  # pooling window either has a winner that leads by 0.13 or is negative
  # throughout (flat zero after ReLU, so both gradients are 0), against a
  # step of 0.001. Drawn from `randn`, the point landed within the step of
  # a kink in 4 seeds of 300, and the check failed there.
  layer = LC.Conv2d(2, 3, 1, 1, false, 1)
  weights = range(18).map(|j| to_float(j * 5 % 18) / 9.0 - 0.95).collect()
  layer.w = dz.Parameter(Tensor.from(weights).reshape([2, 1, 3, 3]))
  fn net(x) {
    conv.pooling(F.relu(layer(x)), 2, 2, 0).sum()
  }
  point = range(36).map(|i| to_float(i * 5 % 36) / 12.0 - 1.45).collect()
  x0 = dz.Variable(Tensor.from(point).reshape([1, 1, 6, 6]))
  assert_true(U.gradient_check(net, x0))
}

@test
fn dot_graph_text_has_one_node_line_per_variable_and_function() {
  a = dz.Variable(Tensor.from([2.0]), 'a')
  b = dz.Variable(Tensor.from([3.0]), 'b')
  y = dz.add(a.__pow__(2), b)
  dot = U.get_dot_graph(y)
  assert_true(dot.starts_with('digraph g {'))
  edges = dot.split("\n").filter(|line| line.contains('->'))
  # y <- Add <- (a^2, b), a^2 <- Pow <- a: five edges wiring four
  # Variables through two Functions.
  assert_eq(edges.size(), 5)
}
