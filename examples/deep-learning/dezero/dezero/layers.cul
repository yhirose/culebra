# dezero/layers.cul — parameterized building blocks (Linear, RNN, LSTM,
# EmbedID, BatchNorm) on top of core.cul/functions.cul. Ported from the
# "DeZero" framework taught in oreilly-japan/deep-learning-from-scratch-3
# (MIT license, Koki Saitoh).
#
# Upstream's `Layer` base class exists only to give every layer a shared
# `params()`/`cleargrads()`/`__call__` for free via inheritance, plus a
# `__setattr__` hook that auto-registers any field holding a `Parameter` or
# a nested `Layer`. Culebra has neither inheritance nor attribute hooks, so
# each class here just writes its own three-line `params()` explicitly, and
# `__call__` is Culebra's own operator-overload mechanism (a class with
# `__call__` is invocable — `layer(x)` — no base class involved).

import dz from './core.cul'
import F from './functions.cul'

fn cleargrads(target) {
  for p in target.params() {
    p.cleargrad()
  }
}

# --- Linear ------------------------------------------------------------

class Linear {
  w = nil
  b = nil
  out_size = 0
  nobias = false

  new(out_size, nobias = false, in_size = nil) {
    @out_size = out_size
    @nobias = nobias
    @b = nobias ? nil : dz.Parameter(Tensor.zeros(1, out_size))
    if in_size != nil {
      @init_w(in_size)
    }
  }

  init_w(in_size) {
    scale = Math.sqrt(1.0 / to_float(in_size))
    @w = dz.Parameter(Tensor.randn(in_size, @out_size) * scale)
  }

  forward(x) {
    if @w == nil {
      @init_w(dz.as_variable(x).shape[1])
    }
    F.linear(x, @w, @b)
  }

  __call__(x) {
    @forward(x)
  }

  params() {
    @b == nil ? [@w] : [@w, @b]
  }
}

# --- RNN (Elman, tanh) ---------------------------------------------------

class RNN {
  h = nil

  new(hidden_size, in_size = nil) {
    @x2h = Linear(hidden_size, false, in_size)
    @h2h = Linear(hidden_size, true, hidden_size)
  }

  reset_state() {
    @h = nil
  }

  forward(x) {
    pre = @h == nil ? @x2h(x) : @x2h(x) + @h2h(@h)
    h_new = F.tanh(pre)
    @h = h_new
    h_new
  }

  __call__(x) {
    @forward(x)
  }

  params() {
    @x2h.params() + @h2h.params()
  }
}

# --- LSTM ----------------------------------------------------------------

class LSTM {
  h = nil
  c = nil

  new(hidden_size, in_size = nil) {
    @x2f = Linear(hidden_size, false, in_size)
    @x2i = Linear(hidden_size, false, in_size)
    @x2o = Linear(hidden_size, false, in_size)
    @x2u = Linear(hidden_size, false, in_size)
    @h2f = Linear(hidden_size, true, hidden_size)
    @h2i = Linear(hidden_size, true, hidden_size)
    @h2o = Linear(hidden_size, true, hidden_size)
    @h2u = Linear(hidden_size, true, hidden_size)
  }

  reset_state() {
    @h = nil
    @c = nil
  }

  forward(x) {
    (f, i, o, u) = if @h == nil {
      (
        F.sigmoid(@x2f(x)),
        F.sigmoid(@x2i(x)),
        F.sigmoid(@x2o(x)),
        F.tanh(@x2u(x)),
      )
    } else {
      (
        F.sigmoid(@x2f(x) + @h2f(@h)),
        F.sigmoid(@x2i(x) + @h2i(@h)),
        F.sigmoid(@x2o(x) + @h2o(@h)),
        F.tanh(@x2u(x) + @h2u(@h)),
      )
    }

    c_new = @c == nil ? i * u : f * @c + i * u
    h_new = o * F.tanh(c_new)
    @h = h_new
    @c = c_new
    h_new
  }

  __call__(x) {
    @forward(x)
  }

  params() {
    @x2f.params() +
      @x2i.params() +
      @x2o.params() +
      @x2u.params() +
      @h2f.params() +
      @h2i.params() +
      @h2o.params() +
      @h2u.params()
  }
}

# --- embedding lookup ------------------------------------------------------

class EmbedID {
  new(in_size, out_size) {
    @w = dz.Parameter(Tensor.randn(in_size, out_size))
  }

  forward(idx) {
    F.embed_id(idx, @w)
  }

  __call__(idx) {
    @forward(idx)
  }

  params() {
    [@w]
  }
}

# --- batch normalization ---------------------------------------------------
#
# Weight shape follows this port's `[1, D]` row-vector convention (matches
# `Linear`'s bias), so the running stats broadcast against a `[N, D]` batch
# the same way a bias does.

class BatchNorm {
  gamma = nil
  beta = nil
  avg_mean = nil
  avg_var = nil
  decay = 0.9
  eps = 2.0e-5

  init_params(d) {
    @gamma = dz.Parameter(Tensor.ones(1, d))
    @beta = dz.Parameter(Tensor.zeros(1, d))
    @avg_mean = dz.Variable(Tensor.zeros(1, d))
    @avg_var = dz.Variable(Tensor.ones(1, d))
  }

  forward(x) {
    v = dz.as_variable(x)
    if @gamma == nil {
      @init_params(v.shape[1])
    }

    (mean, var) = if dz.is_training() {
      n = to_float(v.shape[0])
      batch_mean = dz.reshape(v.sum(0) * (1.0 / n), [1, v.shape[1]])
      centered = v - batch_mean
      batch_var = dz.reshape(
        (centered * centered).sum(0) * (1.0 / n),
        [1, v.shape[1]],
      )
      # `Tensor.eval` here is load-bearing, not a style choice: combining a
      # tensor straight out of `.reshape()` with further arithmetic before
      # it has been forced once produces a wrong result (silently drops the
      # `* decay` term) — reproduced with plain Tensor code with no
      # Variable/autograd involved. Evaluating right after reshape, before
      # folding it into the running average, sidesteps it.
      Tensor.eval(batch_mean.data, batch_var.data)
      @avg_mean.data = @avg_mean.data * @decay +
        batch_mean.data * (1.0 - @decay)
      @avg_var.data = @avg_var.data * @decay +
        batch_var.data * (1.0 - @decay)
      Tensor.eval(@avg_mean.data, @avg_var.data)
      (batch_mean, batch_var)
    } else {
      (@avg_mean, @avg_var)
    }

    std = dz.pow_(var + @eps, 0.5)
    xhat = (v - mean) / std
    @gamma * xhat + @beta
  }

  __call__(x) {
    @forward(x)
  }

  params() {
    @gamma == nil ? [] : [@gamma, @beta]
  }
}

# --- layer normalization -----------------------------------------------
#
# Normalizes each sample independently over its own last (feature) axis,
# unlike BatchNorm which normalizes each feature over the batch axis --
# so there are no running stats to track, and train/eval do the same
# computation. This is the normalization Transformer blocks use. gamma/
# beta keep BatchNorm's `[1, D]` row-vector convention: broadcasting
# right-aligns trailing dims, so `[1, D]` matches a `[..., D]` input of
# any rank (verified against `[N, S, D]`, the shape a Transformer block
# feeds it).

class LayerNorm {
  gamma = nil
  beta = nil
  eps = 2.0e-5

  init_params(d) {
    @gamma = dz.Parameter(Tensor.ones(1, d))
    @beta = dz.Parameter(Tensor.zeros(1, d))
  }

  forward(x) {
    v = dz.as_variable(x)
    last = v.ndim - 1
    d = v.shape[last]
    if @gamma == nil {
      @init_params(d)
    }

    n = to_float(d)
    kd = v.shape.slice(0, last) + [1]
    mean = dz.reshape(v.sum(last) * (1.0 / n), kd)
    centered = v - mean
    var = dz.reshape((centered * centered).sum(last) * (1.0 / n), kd)
    # See BatchNorm.forward for why this Tensor.eval is load-bearing.
    Tensor.eval(mean.data, var.data)
    std = dz.pow_(var + @eps, 0.5)
    xhat = centered / std
    @gamma * xhat + @beta
  }

  __call__(x) {
    @forward(x)
  }

  params() {
    @gamma == nil ? [] : [@gamma, @beta]
  }
}

# --- causal multi-head self-attention + GPT decoder block ------------------
#
# A from-scratch GPT block: no encoder cross-attention, single sequence at
# a time (`x` is `[T, n_embd]`, no leading batch axis -- `LayerNorm` above
# already generalizes to `[N, T, D]`, but batching the attention itself
# needs a per-(batch,head) transpose of only the last two axes -- not
# something this block does yet, though `dz.transpose(x, axes)` now
# supports arbitrary axes via `Tensor.permute`).
#
# `causal_mask(t)`: 1.0 where key position j <= query position i, else 0.0
# -- `Tensor.where(mask, scores, -1e9)` before softmax is the masking idiom
# examples/dezero/examples/gpu_kernels_bench.cul already benchmarks
# (`where_nd`'s own concrete caller).
fn causal_mask(t) {
  Tensor.from(range(t)
    .map(|i| range(t).map(|j| j <= i ? 1.0 : 0.0).collect())
    .collect())
}

class MultiHeadAttention {
  new(n_embd, @n_head, @rope_base = 10000.0) {
    @head_dim = n_embd / n_head
    @scale = 1.0 / Math.sqrt(to_float(@head_dim))
    @wq = Linear(n_embd, true, n_embd)
    @wk = Linear(n_embd, true, n_embd)
    @wv = Linear(n_embd, true, n_embd)
    @wo = Linear(n_embd, true, n_embd)
  }

  forward(x) {
    v = dz.as_variable(x)
    t = v.shape[0]
    q = @wq(v)
    k = @wk(v)
    val = @wv(v)
    mask = causal_mask(t)

    mut head_outs = []
    for h in 0..@n_head {
      hs = h * @head_dim
      he = hs + @head_dim
      q_h = F.rope(dz.narrow(q, 1, hs, he), 0, @rope_base)
      k_h = F.rope(dz.narrow(k, 1, hs, he), 0, @rope_base)
      v_h = dz.narrow(val, 1, hs, he)

      scores = dz.matmul(q_h, dz.transpose(k_h)) * @scale  # [T, T]
      weights = F.softmax(dz.where_(mask, scores, -1.0e9), 1)
      head_outs.push(dz.matmul(weights, v_h))  # [T, head_dim]
    }

    mut x_attn = head_outs[0]
    for i in 1..@n_head {
      x_attn = dz.concat2(x_attn, head_outs[i], 1)
    }
    @wo(x_attn)
  }

  __call__(x) {
    @forward(x)
  }

  params() {
    @wq.params() + @wk.params() + @wv.params() + @wo.params()
  }
}

class GPTBlock {
  new(n_embd, n_head, mlp_ratio = 4, rope_base = 10000.0) {
    @ln1 = LayerNorm()
    @attn = MultiHeadAttention(n_embd, n_head, rope_base)
    @ln2 = LayerNorm()
    @fc1 = Linear(mlp_ratio * n_embd)
    @fc2 = Linear(n_embd)
  }

  forward(x) {
    v = dz.as_variable(x)
    x1 = v + @attn(@ln1(v))
    h = F.gelu(@fc1(@ln2(x1)))
    x1 + @fc2(h)
  }

  __call__(x) {
    @forward(x)
  }

  params() {
    @ln1.params() +
      @attn.params() +
      @ln2.params() +
      @fc1.params() +
      @fc2.params()
  }

  cleargrads() {
    cleargrads(self)
  }
}

export {cleargrads, Linear, RNN, LSTM, EmbedID, BatchNorm, LayerNorm, MultiHeadAttention, GPTBlock}
