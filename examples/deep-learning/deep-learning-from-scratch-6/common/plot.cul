# Curves and histograms, drawn in text.
#
# Upstream reaches for matplotlib. Everything it plots in this book is a
# one-dimensional curve or a histogram, and both read fine as characters,
# so the port draws them here rather than dropping the figures.

let MARKS = ['*', 'o', '+', 'x', '#']

# `series` is `[[label, ys], ...]`, all sharing `xs`.
fn plot_curves(xs, series, width = 64, height = 18) {
  let ys = series.iter().flat_map(|s| s[1]).collect()
  let lo = ys.min()
  let hi = ys.max()
  let span = hi - lo == 0.0 ? 1.0 : hi - lo

  # One column per x, sampled evenly across the input.
  mut grid = range(height)
    .map(|_| range(width).map(|_| ' ').collect())
    .collect()
  for si, s in series.enumerate() {
    let mark = MARKS[si % MARKS.size()]
    for col in 0..width {
      let i = col * (xs.size() - 1) / (width - 1)
      let row = height -
        1 -
        Math.round((s[1][i] - lo) / span * to_float(height - 1))
      grid[Math.clamp(row, 0, height - 1)][col] = mark
    }
  }

  # The bounds are width-padded so every row of the chart shares a left
  # edge; an unpadded float label shifts its row by however long it printed.
  inspect("{hi:>8.4}{grid[0].join('')}")
  for row in 1..height - 1 {
    inspect("        {grid[row].join('')}")
  }
  inspect("{lo:>8.4}{grid[height - 1].join('')}")
  inspect("        x from {xs[0]} to {xs[xs.size() - 1]}")
  for si, s in series.enumerate() {
    inspect("        {MARKS[si % MARKS.size()]} {s[0]}")
  }
}

# A histogram of `values` in `bins` buckets, drawn as rows of `#`.
fn plot_histogram(label, values, bins = 20, width = 50) {
  let lo = values.min()
  let hi = values.max()
  let span = hi - lo == 0.0 ? 1.0 : hi - lo

  mut counts = range(bins).map(|_| 0).collect()
  for v in values {
    let b = Math.clamp(
      Math.floor((v - lo) / span * to_float(bins)),
      0,
      bins - 1,
    )
    counts[b] += 1
  }
  let peak = counts.max()

  inspect(label)
  for b in 0..bins {
    let edge = lo + span * to_float(b) / to_float(bins)
    let bar = '#'.repeat(counts[b] * width / peak)
    inspect("  {edge:>10.4} | {bar}")
  }
}

export {plot_curves, plot_histogram}
