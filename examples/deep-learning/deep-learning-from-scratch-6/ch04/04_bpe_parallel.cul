# Optimization 4: count the chunks in parallel.
#
# Pre-tokenizing is the one embarrassingly parallel part of training: each
# chunk's census is independent, and the tallies just add up at the end.
# Upstream reaches for `multiprocessing.Pool`; culebra's `Parallel.map`
# runs the same shape over a pool of isolates.
#
# One constraint shapes the worker: it sees its own module's globals --
# including the compiled `Regex` -- but a value read off an *imported*
# module is a capture, and a module object is not Sendable. That is why
# `storybot/tokenizer.cul` stands alone rather than importing `codebot`.
#
# Fewer, larger chunks win. Merging the per-chunk tallies is serial, and
# its cost grows with the number of chunks, so that merge -- not the isolate
# boundary -- is what bounds the speedup.
#
# `--full` is the run that produces `data/merge_rules_1000.json`, the
# vocabulary every later chapter loads -- upstream's `ch04/04` ends by
# saving its merge rules the same way.
#
#   culebra ch04/04_bpe_parallel.cul
#   culebra ch04/04_bpe_parallel.cul --full   # needs `just fetch-llm-data`

import P from '../common/paths.cul'
import T from '../codebot/tokenizer.cul'
import S from '../storybot/tokenizer.cul'

let full = Sys.argv.contains('--full')
let corpus = full
  ? P.require_data('tiny_codes.txt')
  : P.data('tiny_codes_sample.txt')
let text = FS.read(corpus)
let num_chunks = 8

let t0 = Sys.time()
mut serial = {}
for chunk in S.chunks(text, num_chunks) {
  S.count_pretokens(chunk, serial)
}
let serial_time = Sys.time() - t0

let t1 = Sys.time()
let parallel = S.count_pretokens_parallel(text, num_chunks, 4)
let parallel_time = Sys.time() - t1

inspect("serial:   {serial_time}s")
inspect("parallel: {parallel_time}s ({num_chunks} chunks, 4 isolates)")
inspect("speedup: {serial_time / parallel_time}x")
inspect("same census: {serial == parallel}")

# End to end, that census feeds the same merge loop as before.
let t2 = Sys.time()
let rules = S.train_bpe(text, 1000, S.END_TOKEN, num_chunks, 4)
inspect("train_bpe end to end: {rules.size()} rules in {Sys.time() - t2}s")

if full {
  let out = P.data('merge_rules_1000.json')
  T.save_merge_rules(rules, out)
  inspect("saved {FS.basename(out)}")
}
