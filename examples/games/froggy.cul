# Hungry Froggy 🐸 — a port of froggy.py (Python + curses) to culebra + Term.
#
# A tiny arcade game: steer the frog with the arrow keys (or h/j/k/l) to eat
# wandering fruit 🍓 and desserts 🍦 while dodging the eagle 🦅 and snake 🐍.
# Eating a dessert grants a bonus; getting caught drains energy. Clear the
# board or run out the clock.
#
# Exercises the full Term stack: Term.app (raw mode + alternate screen +
# guaranteed restore via defer), Screen frame buffering, emoji output, and
# non-blocking key polling. The food/enemies wander with 1-D gradient noise
# implemented below (Python's froggy uses the `noise` library).
#
# Run it:  culebra examples/froggy.cul          (play; q to quit)
#          culebra examples/froggy.cul 60 < /dev/null   (auto-demo, 60 ticks)

let ROWS = 16
let COLS = 16

# Optional tick budget so the demo terminates under a smoke test.
let MAX_TICKS = Sys.argv.size() > 0 ? to_long(Sys.argv[0]) : -1
# When stdin is not a tty there is nobody to press keys: auto-start and let
# the world animate on its own until the tick budget runs out.
let INTERACTIVE = IO.stdin_is_terminal()

# --- 1-D gradient noise (stand-in for Python's noise.pnoise1) --------------
fn build_perm(seed) {
  mut p = iota(256)
  mut st = seed
  for i in 255..0 by -1 {
    st = (st * 1103515245 + 12345) % 2147483648
    let j = st % (i + 1)
    let tmp = p[i]
    p[i] = p[j]
    p[j] = tmp
  }
  p
}
fn fade(t) { t * t * t * (t * (t * 6.0 - 15.0) + 10.0) }
fn lerp(a, b, t) { a + t * (b - a) }
fn grad(h, x) { h % 2 == 0 ? x : -x }
fn pnoise1(perm, x) {
  let fl = to_float(to_long(x))          # floor (x is always >= 0 here)
  let xi = to_long(x) % 256
  let xf = x - fl
  let u = fade(xf)
  let a = perm[xi]
  let b = perm[(xi + 1) % 256]
  lerp(grad(a, xf), grad(b, xf - 1.0), u)
}
let PERM = build_perm(to_long(Time.now().unix()) % 2000000000)
fn noise_pos(base, a) {
  let x = to_long((pnoise1(PERM, base * a) + 1.0) / 2.0 * to_float(ROWS))
  let y = to_long((pnoise1(PERM, (base + 10000.0) * a) + 1.0) / 2.0 * to_float(COLS))
  (Math.clamp(x, 0, ROWS - 1), Math.clamp(y, 0, COLS - 1))
}

# Walk the noise base until the position sits at least `margin` away from the
# board centre (where the frog starts), and report where it settled.
fn settle(start, speed, margin) {
  mut base = start
  mut (x, y) = noise_pos(base, speed)
  mut tries = 0
  while ((Math.abs(to_float(x) - to_float(ROWS) / 2.0) < margin
       || Math.abs(to_float(y) - to_float(COLS) / 2.0) < margin)
      && tries < 300) {
    base += 1.0
    (x, y) = noise_pos(base, speed)
    tries += 1
  }
  (base, x, y)
}

# --- centred placement: the ROWSxCOLS board sits in the middle of the term -
# Each board cell is two terminal columns wide (emoji are double-width), so
# the horizontal coordinate is doubled — mirroring froggy.py's `* 2`.
fn offsets(s) {
  let cols = (s.cols() - 1) / 2
  let offx = (cols - COLS) / 2
  let offy = (s.rows() - ROWS) / 2
  (offx, offy)
}
fn output(s, off, y, x, str) { s.put((x + off[0]) * 2, y + off[1], str) }

# --- entities --------------------------------------------------------------
class Frog {
  x = COLS / 2 - 1
  y = ROWS / 2 - 1
  bonus = 0
  energy = -1

  draw(s, off) {
    if self.energy > 0 {
      output(s, off, self.y, self.x, "😱")
      self.energy -= 1
    } else if self.bonus > 0 {
      output(s, off, self.y, self.x, "👀")
      self.bonus -= 1
    } else {
      output(s, off, self.y, self.x, "🐸")
    }
  }
  move(dx, dy) {
    self.x = Math.clamp(self.x + dx, 0, COLS - 1)
    self.y = Math.clamp(self.y + dy, 0, ROWS - 1)
  }
  move_by_key(key) {
    let (dx, dy) = match key {
      "left"  | "h" => (-1, 0),
      "right" | "l" => (1, 0),
      "up"    | "k" => (0, -1),
      "down"  | "j" => (0, 1),
      _             => (0, 0),
    }
    self.move(dx, dy)
  }
  eat() {
    if self.energy == -1 {
      if self.bonus == 0 { self.bonus = 50 }
    } else {
      self.bonus = 0
      self.energy = -1
    }
  }
  eaten() { if self.energy == -1 { self.energy = 50 } }
  alive() { self.energy != 0 }
}

class Food {
  food_index = 0

  new(foods, speed, score) {
    self.foods = foods
    self.speed = speed
    self.score = score
    # `self` is immutable inside a constructor, so settle away from the board
    # centre first and assign each field once.
    let (base, x, y) = settle(to_float(to_long(Time.now().unix()) % 1000 * 10000), speed, 4.0)
    self.base = base
    self.x = x
    self.y = y
  }
  draw(s, off) { output(s, off, self.y, self.x, self.foods[self.food_index]) }
  move(s) {
    let (x, y) = self.next_pos()
    self.x = x
    self.y = y
    self.base += 1.0
  }
  eaten() {
    if self.food_index < self.foods.size() {
      self.food_index += 1
      self.base += 100000.0
    }
  }
  remaining() { self.foods.size() - self.food_index }
  next_pos() { noise_pos(self.base, self.speed) }
}

class Enemy {
  new(emoji, speed) {
    self.emoji = emoji
    self.speed = speed
    let (base, x, y) = settle(to_float(to_long(Time.now().unix()) % 1000), speed, 6.0)
    self.base = base
    self.x = x
    self.y = y
  }
  draw(s, off) { output(s, off, self.y, self.x, self.emoji) }
  move(s) {
    let (x, y) = self.next_pos()
    self.x = x
    self.y = y
    self.base += 1.0
  }
  next_pos() { noise_pos(self.base, self.speed) }
}

# --- collisions / scoring --------------------------------------------------
fn check(frog, foods, enemies, score) {
  mut s = score
  for food in foods {
    if food.remaining() > 0 && frog.x == food.x && frog.y == food.y {
      s += food.score * (frog.bonus > 0 ? 2 : 1)
      frog.eat()
      food.eaten()
    }
  }
  for enemy in enemies {
    if frog.x == enemy.x && frog.y == enemy.y { frog.eaten() }
  }
  s
}

# --- rendering -------------------------------------------------------------
fn draw_status(s, off, score, time) {
  output(s, off, 1, 1, "SCORE: {score}")
  output(s, off, 1, COLS - 5, "TIME: {time}")
}
fn draw_food_count(s, off, fruit, dessert) {
  output(s, off, ROWS - 1, COLS - 5, "FOOD: {fruit.remaining() + dessert.remaining()}")
}

fn draw_screen(s, frog, fruit, dessert, eagle, snake, score, time) {
  s.clear()
  let off = offsets(s)
  draw_status(s, off, score, time)
  draw_food_count(s, off, fruit, dessert)
  if frog.energy > 0 {
    output(s, off, ROWS - 1, 1, "ENERGY: {frog.energy}")
  } else if frog.bonus > 0 {
    output(s, off, ROWS - 1, 1, "BONUS: {frog.bonus}")
  }
  frog.draw(s, off)
  for food in [fruit, dessert] {
    if food.remaining() > 0 { food.draw(s, off) }
  }
  for enemy in [eagle, snake] { enemy.draw(s, off) }
  s.flush()
}

fn draw_opening(s, time) {
  s.clear()
  let off = offsets(s)
  draw_status(s, off, 0, time)
  output(s, off, ROWS / 2 - 1, COLS / 2 - 4, "🐸 Hungry Froggy 🍓")
  output(s, off, ROWS - 2, COLS / 2 - 5, "Hit Space to start")
  s.flush()
}

fn draw_game_over(s, score, time, frog, fruit, dessert) {
  s.clear()
  let off = offsets(s)
  draw_status(s, off, score, time)
  draw_food_count(s, off, fruit, dessert)
  if !frog.alive() {
    output(s, off, 6, COLS / 2 - 3, "GAME OVER 😱")
  } else if time > 0 {
    output(s, off, 6, COLS / 2 - 5, "🎉 Congratulations 🎊")
  } else {
    output(s, off, 6, COLS / 2 - 2, "TIME UP ⏱")
  }
  output(s, off, 10, COLS / 2 - 3, "Hit Space")
  s.flush()
}

# Block until one of `chars` is pressed; auto-return the first when there is
# no tty (demo mode).
fn wait_key(s, chars) {
  if !INTERACTIVE { return chars[0] }
  while true {
    let ev = s.poll(0.1)
    if ev?.kind == "key" && chars.contains(ev.key) { return ev.key }
  }
}

# A single round. Returns true to play again, false to quit.
fn run(s) {
  mut time = 99
  draw_opening(s, time)
  if wait_key(s, [" ", "q"]) == "q" { return false }

  mut score = 0
  mut tic = 0
  let frog = Frog.new()
  let fruit = Food.new("🍓🍌🍎🍑🍇🍉🍐🍊🍋🍒🍍🥝🍏🍅🥑🥕🥔🍆🍠🌽".graphemes().collect(), 0.01, 1)
  let dessert = Food.new("🍦🍩🍧🧁🍨🍪🍫🍰🍮🍭🍿🥛🍷🍶🍹🍼🍵".graphemes().collect(), 0.02, 2)
  let eagle = Enemy.new("🦅", 0.03)
  let snake = Enemy.new("🐍", 0.02)

  while (time > 0 && frog.alive()
      && (fruit.remaining() > 0 || dessert.remaining() > 0)
      && (MAX_TICKS < 0 || tic < MAX_TICKS)) {
    let ev = s.poll(0.1)
    let key = ev?.kind == "key" ? ev.key : ""
    if key == "q" { time = 0; break }
    frog.move_by_key(key)
    fruit.move(s)
    dessert.move(s)
    eagle.move(s)
    snake.move(s)
    score = check(frog, [fruit, dessert], [eagle, snake], score)
    draw_screen(s, frog, fruit, dessert, eagle, snake, score, time)
    if tic % 10 == 0 { time -= 1 }
    tic += 1
  }

  if frog.alive() { score += time }
  if !INTERACTIVE { return false }
  Time.sleep(1.2)
  draw_game_over(s, score, time, frog, fruit, dessert)
  wait_key(s, [" ", "q"]) != "q"
}

Term.app(fn (s) { while run(s) {} })
