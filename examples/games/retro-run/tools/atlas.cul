}
let SPRITE_W = 1492
let SPRITE_H = 1487

# Three 1280x480 layers. Each scrolls horizontally at its own rate and wraps,
# so every shape's horizontal period must divide the layer width exactly —
# otherwise the wrap shows a seam.
let BACKGROUND = {
  HILLS: [5, 5, 1280, 480],
  SKY: [5, 495, 1280, 480],
  TREES: [5, 985, 1280, 480]
}
let BG_W = 1290
let BG_H = 1470

export { SPRITES, SPRITE_W, SPRITE_H, BACKGROUND, BG_W, BG_H }
