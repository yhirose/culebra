# The atlas rectangles, verbatim from the upstream javascript-racer's
# common.js. These numbers are the contract between the art and the game:
# SPRITES.w drives collision (Util.overlap) and the world scale
# (SPRITES.SCALE = 0.3 / PLAYER_STRAIGHT.w), so the pictures may be redrawn
# but the rectangles may not move.
#
# gen_assets.cul draws into them and gen_templates.cul borders them, so they
# are declared once here rather than in each. `check_assets.cul` deliberately
# keeps its own copy — a checker that imported these could not catch an error
# in them.

let SPRITES = {
  PALM_TREE: [5, 5, 215, 540],
  BILLBOARD08: [230, 5, 385, 265],
  TREE1: [625, 5, 360, 360],
