# Cycled one per lap, in this order.
let SCENES = [
  ("asayake", ASAYAKE),
  ("hiru", HIRU),
  ("yuugure", YUUGURE),
  ("twilight", TWILIGHT),
]

# --- colour space ------------------------------------------------------------
# The saturation boost and the pair narrowing below both work in HSV (via
# Canvas.rgb_to_hsv / hsv_to_rgb), which is the whole reason the palette reads
# as one set of colours rather than nineteen unrelated ones.
fn boost(c, k) {
  let (h, s, v) = Canvas.rgb_to_hsv(c[0], c[1], c[2])
  let (r, g, b) = Canvas.hsv_to_rgb(h, Math.min(1.0, s * (1 + k) + 0.02), v)
  [r, g, b]
}

fn narrow_toward(light_c, dark_c, amount) {
  let (lh, ls, lv) = Canvas.rgb_to_hsv(light_c[0], light_c[1], light_c[2])
  let (_, ds, dv) = Canvas.rgb_to_hsv(dark_c[0], dark_c[1], dark_c[2])
  let (
    r,
    g,
    b,
  ) = Canvas.hsv_to_rgb(
    lh,
    Math.min(1.0, ls + (ds - ls) * amount),
    lv + (dv - lv) * amount * 0.6,
  )
  [r, g, b]
}

# Base colours -> the final RGB the art is baked with.
fn palette_for(scene) {
  mut pal = {...COMMON, ...scene}
  for n, c in pal {
    pal[n] = NO_BOOST.contains(n) ? c : boost(c, SAT_K)
  }
  for (dark, light) in PAIRS {
    if pal.has(dark) && pal.has(light) {
      pal[light] = narrow_toward(pal[light], pal[dark], NARROW)
    }
  }
  pal
}

# Key 0 is transparent; the rest index this list. Drawing code names keys,
# never colours, which is what keeps the four scenes geometry-identical.
let KEYS = [""]
  .iter()
  .chain(COMMON.keys().to_set().union(HIRU.keys().to_set()).to_array().sorted())
  .collect()
let KEY_ID = KEYS.enumerate().map(|(i, name)| (name, i)).to_object()

# A scene's palette as the packed-RGBA array `Canvas.Sprite` indexes with the
# key buffer. Slot 0 stays 0 — fully transparent, the shape mask.
fn palette_colors(scene) {
  let pal = palette_for(scene)
  KEYS.map(|name| name == ""
    ? 0
    : Canvas.rgba(pal[name][0], pal[name][1], pal[name][2]))
}

# --- canvas ------------------------------------------------------------------
# A grid of palette keys. Everything is drawn here, in chunky cells, and
# expanded to pixels at the end — that is where the coarse pixel-art grid
# comes from.
class Cells {
  new(w, h) {
    self.w = w
    self.h = h
    self.k = iota(w * h).map(|_| 0)
  }

  get(x, y) {
    x >= 0 && x < self.w && y >= 0 && y < self.h ? self.k[y * self.w + x] : 0
  }

  set(x, y, key) {
    let xi = x.to_long()
    let yi = y.to_long()
    if xi >= 0 && xi < self.w && yi >= 0 && yi < self.h {
      self.k[yi * self.w + xi] = type_of(key) == "String" ? KEY_ID[key] : key
    }
  }

  rect(x, y, w, h, key) {
    for yy in y.to_long()..(y + h).to_long() {
      for xx in x.to_long()..(x + w).to_long() {
        self.set(xx, yy, key)
      }
    }
  }

  # Checkerboard between two keys — how shading is done, since the palette has
  # no in-between tones.
  dither(x, y, w, h, key_a, key_b, size = 1) {
    for yy in y.to_long()..(y + h).to_long() {
      for xx in x.to_long()..(x + w).to_long() {
        self.set(xx, yy, (xx / size + yy / size) % 2 == 0 ? key_a : key_b)
      }
    }
  }

  ellipse(cx, cy, rx, ry, key) {
    if rx <= 0 || ry <= 0 {
      return nil
    }
    for yy in (cy - ry).to_long()..=(cy + ry).to_long() {
      # `.to_float()`: callers pass Longs as often as Floats, and `/` on two
      # Longs truncates — which would flatten the ellipse into a rectangle.
      let dy = (yy - cy).to_float() / ry
      if Math.abs(dy) > 1 {
        continue
      }
      let half = rx * Math.sqrt(1 - dy * dy)
      for xx in (cx - half).to_long()..=(cx + half).to_long() {
        self.set(xx, yy, key)
      }
    }
  }

  # One-cell ink border around everything drawn so far. Runs on a copy so the
  # border doesn't grow into itself.
  outline(key = "INK") {
    let src = self.k.slice(0, self.k.size())
    let kid = KEY_ID[key]
    for y in 0..self.h {
      for x in 0..self.w {
        if src[y * self.w + x] != 0 {
          continue
        }
        mut touching = false
        for (dx, dy) in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
          let nx = x + dx
          let ny = y + dy
          if nx >= 0 && nx < self.w && ny >= 0 && ny < self.h {
            let v = src[ny * self.w + nx]
            if v != 0 && v != kid {
              touching = true
              break
            }
          }
        }
        if touching {
          self.k[y * self.w + x] = kid
        }
      }
    }
  }

  # Dither the lower part of every filled column toward `key_dark` — a cheap,
  # consistent ambient occlusion for the plants and boulders.
  shade_bottom(key_dark, frac = 0.35) {
    let ink = KEY_ID["INK"]
    for x in 0..self.w {
      let col = iota(self.h).filter(fn (y) {
        let v = self.get(x, y)
        v != 0 && v != ink
      })
      if col.empty() {
        continue
      }
      let start = (col.min() + (col.max() - col.min()) * (1 - frac)).to_long()
      for y in col {
        if y >= start && (x + y) % 2 == 0 {
          self.set(x, y, key_dark)
        }
      }
    }
  }
}

# A full-resolution buffer of palette keys — the atlas under construction.
class KeyImage {
  new(w, h) {
    self.w = w
    self.h = h
    self.k = iota(w * h).map(|_| 0)
  }

  # Expand `cells` by `scale` and drop it at (x, y), cropped to w x h.
  blit_cells(cells, x, y, w, h, scale) {
    for py in 0..h {
      let cy = py / scale
      if cy >= cells.h {
        break
      }
      let row = cy * cells.w
      let base = (y + py) * self.w + x
      for px in 0..w {
        let cx = px / scale
        if cx >= cells.w {
          break
        }
        let v = cells.k[row + cx]
        if v != 0 {
          self.k[base + px] = v
        }
      }
    }
  }
}

# --- deterministic noise -----------------------------------------------------
# A hash, not an RNG: the same input always gives the same value, so nothing in
# the output depends on evaluation order or on how many shapes came before.
fn noise(*args) {
  mut h = 2166136261
  for a in args {
    h = (h ^ a.to_long() & 0xFFFFFFFF) * 16777619 & 0xFFFFFFFF
  }
  h.to_float() / 4294967295.0
}

# --- background --------------------------------------------------------------
# Three 1280x480 layers at the atlas rectangles common.js names. Each scrolls
# horizontally at its own rate and wraps, so every shape's horizontal period
# must divide the layer width exactly — otherwise the wrap shows a seam.
let BG_CELL = 4          # one drawn cell = 4x4 pixels
let LW = 1280 / BG_CELL  # 320 cells across
let LH = 480 / BG_CELL   # 120 cells down

# A sine whose period divides the layer width, so it wraps exactly.
fn wave(x, period, amp, phase = 0.0) {
  if LW % period != 0 {
    throw {
      kind: "ValueError",
      message: "period {period} does not divide the layer width",
    }
  }
  amp * Math.sin(2 * Math.pi * (x.to_float() / period + phase))
}

fn draw_sky(c) {
  # Three bands, dithered where they meet so the gradient reads as pixel art
  # rather than a smooth ramp.
  let top = (LH * 0.40).to_long()
  let mid = (LH * 0.72).to_long()
  c.rect(0, 0, LW, top, "SKY_TOP")
  c.rect(0, top, LW, mid - top, "SKY_MID")
  c.rect(0, mid, LW, LH - mid, "SKY_LOW")
  for y in top - 4..top + 4 {
    for x in 0..LW {
      if (x + y) % 2 == 0 {
        c.set(x, y, y < top ? "SKY_TOP" : "SKY_MID")
      }
    }
  }
  for y in mid - 4..mid + 4 {
    for x in 0..LW {
      if (x + y) % 2 == 0 {
        c.set(x, y, y < mid ? "SKY_MID" : "SKY_LOW")
      }
    }
  }

  # The sun sits well inside the layer, so it never straddles the wrap.
  c.ellipse(LW * 0.72, LH * 0.30, 13, 13, "SUN")

  # Clouds: horizontal periods chosen to divide LW, drawn wrapped so a cloud
  # that runs off the right edge continues on the left.
  for i in 0..7 {
    let cx = i * LW / 7 + (noise(i, 11) * 20).to_long()
    let cy = (LH * (0.10 + 0.22 * noise(i, 3))).to_long()
    for j in 0..3 {
      let rx = 9 + (noise(i, j, 5) * 11).to_long()
      let ry = Math.max(2, rx / 3)
      let ox = cx + (j - 1) * rx
      for yy in cy - ry..=cy + ry {
        let dy = (yy - cy).to_float() / ry
        if Math.abs(dy) > 1 {
          continue
        }
        let half = rx * Math.sqrt(1 - dy * dy)
        for xx in (ox - half).to_long()..=(ox + half).to_long() {
          c.set(Math.wrap(xx, LW), yy, "CLOUD")
        }
      }
    }
  }
}

fn draw_hills(c) {
  # Two ridges. Each is a sum of sines whose periods divide LW, so the
  # silhouette meets itself at the wrap.
  for x in 0..LW {
    let far = LH * 0.62 + wave(x, 160, 9) + wave(x, 64, 4, 0.3)
    let near = LH * 0.74 + wave(x, 80, 11, 0.15) + wave(x, 40, 5, 0.6)
    c.rect(x, far.to_long(), 1, LH - far.to_long(), "HILL_FAR")
    c.rect(x, near.to_long(), 1, LH - near.to_long(), "HILL_NEAR")
    # A dithered band where the near ridge starts, so the two read apart.
    for y in near.to_long()..Math.min(LH, near.to_long() + 6) {
      if (x + y) % 2 == 0 {
        c.set(x, y, "HILL_FAR")
      }
    }
  }
}

# One row of alternating conifer / round crowns, wrapped at the layer edge.
# `step` must divide LW so the row meets itself.
fn tree_row(c, base, step, seed, key, scale) {
  if LW % step != 0 {
    throw {
      kind: "ValueError",
      message: "tree spacing {step} does not divide the layer width",
    }
  }
  for i in 0..LW / step {
    let x = i * step + (noise(i, seed, 7) * step / 2).to_long()
    let hgt = ((12 + noise(i, seed, 2) * 16) * scale).to_long()
    let top = base - hgt
    if noise(i, seed, 9) < 0.5 {
      # conifer
      for y in top..base {
        let half = Math.max(
          1,
          ((y - top).to_float() / Math.max(1, hgt) * 6 * scale).to_long() + 1,
        )
        for xx in x - half..=x + half {
          c.set(Math.wrap(xx, LW), y, key)
        }
      }
    } else {
      # round crown, on a trunk
      let r = Math.max(2, ((4 + noise(i, seed, 4) * 4) * scale).to_long())
      c.ellipse(x, top + r, r, r, key)
      for y in top + r..base {
        c.set(Math.wrap(x, LW), y, key)
        c.set(Math.wrap(x + 1, LW), y, key)
      }
    }
  }
}

fn draw_trees(c) {
  # Two rows: a far row in the hill colour, then the treeline proper. The far
  # row fills the gaps between near crowns, so the layer reads as depth
  # instead of as slits of sky.
  let base = (LH * 0.84).to_long()
  c.rect(0, base, LW, LH - base, "TREELINE")
  tree_row(c, base - 2, 10, 31, "HILL_NEAR", 0.8)
  tree_row(c, base, 8, 17, "TREELINE", 1.0)
}

# A scrolling layer meets its own left edge. Column 0 and column LW-1 are
# neighbours once it wraps, so a shape that changes abruptly across that join
# is a seam. Allow a little change — real detail differs column to column —
# but not more than two neighbouring interior columns do.
fn check_wraps(name, cells) {
  let diff = fn (a, b) {
    iota(cells.h).filter(|y| cells.get(a, y) != cells.get(b, y)).size()
  }
  let seam = diff(LW - 1, 0)
  let interior = iota(1, LW - 2).map(|x| diff(x, x + 1)).max()
  if seam > interior {
    throw {
      kind: "ValueError",
      message: "{name} does not wrap: {seam} cells change across the " +
        "seam, at most {interior} change between interior columns",
    }
  }
}

# Draw all three layers once, into keys. Returns the atlas.
fn build_background() {
  mut img = KeyImage(atlas.BG_W, atlas.BG_H)
  for (
    name,
    draw,
  ) in [("SKY", draw_sky), ("HILLS", draw_hills), ("TREES", draw_trees)] {
    mut cells = Cells(LW, LH)
    draw(cells)
    check_wraps(name, cells)
    let [x, y, w, h] = atlas.BACKGROUND[name]
    img.blit_cells(cells, x, y, w, h, BG_CELL)
  }
  img
}

# --- sprites -----------------------------------------------------------------
# The atlas rectangles are the contract (see atlas.cul); this file only draws
# inside them.

# Pixels per drawn cell — the coarse grid the whole sheet shares. Sprites
# already at pixel-art size (the cars) draw one cell per pixel; the large
# scenery is drawn coarse so it reads at the same chunkiness.
fn cell_scale(w, h) {
  Math.max(w, h) <= 130 ? 1 : Math.max(2, Math.round(Math.max(w, h) / 60.0))
}

# Rear three-quarter view — what the player sees of traffic ahead. `kind` picks
# the silhouette family; the parts are the same everywhere.
fn draw_vehicle(c, w, h, kind, seed, body = ("CORAL", "CORAL_D", "CORAL_L")) {
  let (mid, lo, hi) = body
  let roof = {wedge: 0.30, beetle: 0.40, suv: 0.52, van: 0.58}[kind]
  let waist = {wedge: 0.94, beetle: 0.82, suv: 0.88, van: 0.90}[kind]
  let top = (h * (1 - roof - 0.28)).to_long()
  let body_y = (h * 0.42).to_long()
  let floor = (h * 0.86).to_long()
  let bw = (w * waist).to_long()
  let bx = (w - bw) / 2

  c.ellipse(w / 2.0, floor + 1, bw * 0.55, Math.max(1, h * 0.06), "SHADOW")  # contact
  let tyre_w = Math.max(2, (w * 0.13).to_long())
  for tx in [bx - 1, bx + bw - tyre_w + 1] {
    # tyres
    c.rect(
      tx,
      floor - (h * 0.16).to_long(),
      tyre_w,
      (h * 0.18).to_long(),
      "TYRE",
    )
    c.rect(
      tx,
      floor - (h * 0.06).to_long(),
      tyre_w,
      (h * 0.08).to_long(),
      "TYRE_D",
    )
  }

  let cabin_w = (bw * (kind == "wedge" ? 0.62 : 0.78)).to_long()
  let cabin_x = (w - cabin_w) / 2
  c.rect(cabin_x, top, cabin_w, body_y - top, mid)  # cabin
  c.rect(
    cabin_x + 2,
    top + 1,
    cabin_w - 4,
    Math.max(1, body_y - top - 3),
    "GLASS",
  )
  c.dither(
    cabin_x + 2,
    top + 1,
    cabin_w - 4,
    Math.max(1, (body_y - top) / 3),
    "GLASS",
    "GLASS_D",
  )
  c.rect(bx, body_y, bw, floor - body_y, mid)                                    # body
  c.dither(bx, floor - (h * 0.10).to_long(), bw, (h * 0.10).to_long(), mid, lo)  # skirt
  c.rect(bx + 1, body_y, bw - 2, Math.max(1, (h * 0.05).to_long()), hi)          # top edge
  c.rect(cabin_x, top, cabin_w, Math.max(1, (h * 0.04).to_long()), hi)           # roof

  let lamp_w = Math.max(2, (bw * 0.16).to_long())
  let ly = (h * 0.60).to_long()
  c.rect(bx + 2, ly, lamp_w, Math.max(2, (h * 0.10).to_long()), "LAMP")
  c.rect(
    bx + bw - lamp_w - 2,
    ly,
    lamp_w,
    Math.max(2, (h * 0.10).to_long()),
    "LAMP",
  )
  let pw = Math.max(3, (bw * 0.26).to_long())
  c.rect(
    (w - pw) / 2,
    floor - (h * 0.14).to_long(),
    pw,
    Math.max(2, (h * 0.08).to_long()),
    "PLATE",
  )
  c.outline()
}

# A trailer: tall box on a cab, seen from behind.
fn draw_semi(c, w, h, seed) {
  let box_h = (h * 0.62).to_long()
  c.rect(
    (w * 0.06).to_long(),
    (h * 0.04).to_long(),
    (w * 0.88).to_long(),
    box_h,
    "CREAM",
  )
  c.rect(
    (w * 0.10).to_long(),
    (h * 0.10).to_long(),
    (w * 0.80).to_long(),
    (box_h * 0.5).to_long(),
    "PLATE",
  )
  c.dither(
    (w * 0.06).to_long(),
    (h * 0.04).to_long() + box_h - (h * 0.08).to_long(),
    (w * 0.88).to_long(),
    (h * 0.08).to_long(),
    "CREAM",
    "SHADOW",
  )
  c.rect(
    (w * 0.12).to_long(),
    (h * 0.04).to_long() + box_h,
    (w * 0.76).to_long(),
    (h * 0.16).to_long(),
    "CORAL_D",
  )
  let floor = (h * 0.92).to_long()
  c.ellipse(w / 2.0, floor, w * 0.46, Math.max(1, h * 0.04), "SHADOW")
  for tx in [(w * 0.10).to_long(), (w * 0.74).to_long()] {
    c.rect(
      tx,
      floor - (h * 0.12).to_long(),
      (w * 0.16).to_long(),
      (h * 0.13).to_long(),
      "TYRE",
    )
    c.rect(
      tx,
      floor - (h * 0.04).to_long(),
      (w * 0.16).to_long(),
      (h * 0.05).to_long(),
      "TYRE_D",
    )
  }
  c.rect(
    (w * 0.20).to_long(),
    floor - (h * 0.10).to_long(),
    (w * 0.12).to_long(),
    (h * 0.05).to_long(),
    "LAMP",
  )
  c.rect(
    (w * 0.68).to_long(),
    floor - (h * 0.10).to_long(),
    (w * 0.12).to_long(),
    (h * 0.05).to_long(),
    "LAMP",
  )
  c.outline()
}

# Overlapping crown blobs on a trunk — TREE1 / TREE2.
fn draw_round_tree(c, w, h, seed, leaf = ("LEAF_D", "LEAF_M", "LEAF_L")) {
  let (d, m, l) = leaf
  let trunk_w = Math.max(2, (w * 0.12).to_long())
  c.rect(
    (w - trunk_w) / 2,
    (h * 0.60).to_long(),
    trunk_w,
    (h * 0.42).to_long(),
    "WOOD_M",
  )
  c.dither(
    (w - trunk_w) / 2,
    (h * 0.60).to_long(),
    Math.max(1, trunk_w / 2),
    (h * 0.42).to_long(),
    "WOOD_D",
    "WOOD_M",
  )
  let cy = h * 0.36
  let cr = Math.min(w, h) * 0.40
  for i in 0..6 {
    let a = i / 6.0 * 6.28318
    let ox = w / 2.0 + Math.cos(a) * cr * 0.45
    let oy = cy + Math.sin(a) * cr * 0.34
    c.ellipse(
      ox,
      oy,
      cr * (0.42 + noise(seed, i) * 0.18),
      cr * (0.36 + noise(seed, i, 2) * 0.16),
      d,
    )
  }
  c.ellipse(w / 2.0, cy, cr * 0.86, cr * 0.72, m)
  c.ellipse(w / 2.0 - cr * 0.22, cy - cr * 0.22, cr * 0.44, cr * 0.34, l)
  c.shade_bottom("LEAF_D", 0.45)
  c.outline()
}

# Bare branching trunk.
fn draw_dead_tree(c, w, h, seed) {
  let trunk_w = Math.max(2, (w * 0.16).to_long())
  c.rect(
    (w - trunk_w) / 2,
    (h * 0.20).to_long(),
    trunk_w,
    (h * 0.82).to_long(),
    "WOOD_D",
  )
  for i in 0..5 {
    let y = (h * (0.22 + 0.14 * i)).to_long()
    let side = i % 2 == 0 ? 1 : -1
    let length = (w * (0.42 - 0.05 * i)).to_long()
    for j in 0..length {
      c.set(w / 2.0 + side * j, y - j * 0.6, "WOOD_D")
      c.set(w / 2.0 + side * j, y - j * 0.6 + 1, "WOOD_M")
    }
  }
  c.outline()
}

# Curved tapering trunk under a crown of drooping fronds.
fn draw_palm(c, w, h, seed) {
  let top = h * 0.30
  for y in top.to_long()..h {
    let t = (y - top) / (h - top)
    let x = w / 2.0 + Math.sin(t * 1.1) * w * 0.14
    let half = Math.max(1, w * 0.06 * (0.6 + 0.6 * t))
    c.rect(x - half, y, half * 2, 1, "WOOD_M")
    c.rect(x - half, y, Math.max(1, half * 0.7), 1, "WOOD_D")
  }
  let cx = w / 2.0
  let cy = top
  for i in 0..8 {
    let a = Math.pi + (i + 0.5) / 8.0 * Math.pi  # fan out sideways and up
    let length = w * (0.40 + 0.14 * noise(seed, i))
    for j in 0..length.to_long() {
      let t = j / length
      let fx = cx + Math.cos(a) * j
      let fy = cy + Math.sin(a) * j * 0.5 + t * t * length * 0.55  # droop
      let thick = Math.max(1, ((1 - t) * w * 0.05).to_long())
      c.rect(fx - thick / 2.0, fy, thick, 1, "LEAF_M")
      c.rect(fx - thick / 2.0, fy + 1, thick, 1, "LEAF_D")
    }
  }
  c.ellipse(cx, cy + 1, Math.max(2, w * 0.07), Math.max(2, w * 0.05), "LEAF_D")
  c.outline()
}

fn draw_bush(c, w, h, seed) {
  for i in 0..5 {
    c.ellipse(
      w * (0.18 + 0.16 * i),
      h * (0.62 - 0.10 * noise(seed, i)),
      w * 0.18,
      h * 0.30,
      "LEAF_D",
    )
  }
  c.ellipse(w * 0.46, h * 0.58, w * 0.30, h * 0.28, "LEAF_M")
  c.ellipse(w * 0.36, h * 0.46, w * 0.16, h * 0.14, "LEAF_L")
  c.shade_bottom("LEAF_D", 0.4)
  c.outline()
}

# Saguaro: a stem with two arms that run out level, then turn up.
fn draw_cactus(c, w, h, seed) {
  let stem_w = Math.max(3, (w * 0.13).to_long())
  let stem_x = (w - stem_w) / 2
  c.rect(
    stem_x,
    (h * 0.10).to_long(),
    stem_w,
    h - (h * 0.10).to_long(),
    "LEAF_M",
  )
  for (side, elbow, rise) in [(-1, 0.52, 0.30), (1, 0.64, 0.22)] {
    let reach = (w * 0.22).to_long()
    let arm_y = (h * elbow).to_long()
    let x0 = side < 0 ? stem_x : stem_x + stem_w - 1
    # the level run, from the stem out to the elbow
    c.rect(Math.min(x0, x0 + side * reach), arm_y, reach, stem_w, "LEAF_M")
    # the upturn, overlapping the run so the joint is solid
    c.rect(
      x0 + side * reach - (side > 0 ? stem_w : 0),
      (h * (elbow - rise)).to_long(),
      stem_w,
      (h * rise).to_long() + stem_w,
      "LEAF_M",
    )
  }
  c.dither(
    stem_x,
    (h * 0.10).to_long(),
    Math.max(1, stem_w / 3),
    h - (h * 0.10).to_long(),
    "LEAF_D",
    "LEAF_M",
  )
  c.outline()
}

fn draw_stump(c, w, h, seed) {
  c.rect(
    (w * 0.24).to_long(),
    (h * 0.34).to_long(),
    (w * 0.52).to_long(),
    (h * 0.62).to_long(),
    "WOOD_D",
  )
  c.ellipse(w / 2.0, h * 0.36, w * 0.28, h * 0.16, "WOOD_M")
  c.ellipse(w / 2.0, h * 0.36, w * 0.16, h * 0.09, "WOOD_L")
  c.outline()
}

# A rounded rock: lit cap, dithered flank, darker base.
fn draw_boulder(c, w, h, seed) {
  c.ellipse(w * 0.50, h * 0.64, w * 0.46, h * 0.38, "SHADOW")
  c.ellipse(w * 0.44, h * 0.52, w * 0.30, h * 0.22, "SHADOW")
  c.ellipse(w * 0.40, h * 0.46, w * 0.18, h * 0.12, "PLATE")  # small highlight
  for y in (h * 0.62).to_long()..h {
    for x in 0..w {
      if c.get(x, y) != 0 && (x + y) % 2 == 0 {
        c.set(x, y, "INK2")
      }
    }
  }
  c.outline()
}

# A sign panel on two posts; the face carries flat bands so each board reads
# differently without needing type.
fn draw_billboard(c, w, h, seed) {
  let post_w = Math.max(2, (w * 0.06).to_long())
  for px in [(w * 0.22).to_long(), (w * 0.72).to_long()] {
    c.rect(px, (h * 0.52).to_long(), post_w, (h * 0.50).to_long(), "WOOD_D")
  }
  c.rect(
    (w * 0.04).to_long(),
    (h * 0.06).to_long(),
    (w * 0.92).to_long(),
    (h * 0.52).to_long(),
    "CREAM",
  )
  let face_x = (w * 0.08).to_long()
  let face_y = (h * 0.10).to_long()
  let face_w = (w * 0.84).to_long()
  let face_h = (h * 0.44).to_long()
  let bands = 2 + (noise(seed, 1) * 3).to_long()
  for i in 0..bands {
    let key = [
      "CORAL",
      "GLASS",
      "LAMP",
      "LEAF_M",
      "CORAL_D",
    ][(noise(seed, i, 5) * 5).to_long()]
    let by = face_y + face_h * i / bands
    c.rect(face_x, by, face_w, Math.max(1, face_h / bands), key)
  }
  c.dither(
    face_x,
    face_y + face_h - Math.max(1, face_h / 5),
    face_w,
    Math.max(1, face_h / 5),
    "SHADOW",
    "PLATE",
  )
  c.outline()
}

fn draw_column(c, w, h, seed) {
  let shaft = (w * 0.44).to_long()
  c.rect(
    (w - shaft) / 2,
    (h * 0.10).to_long(),
    shaft,
    (h * 0.80).to_long(),
    "PLATE",
  )
  c.dither(
    (w - shaft) / 2,
    (h * 0.10).to_long(),
    Math.max(1, shaft / 3),
    (h * 0.80).to_long(),
    "SHADOW",
    "PLATE",
  )
  for (y, ww) in [(0.04, 0.66), (0.86, 0.72)] {
    c.rect(
      (w * (1 - ww) / 2).to_long(),
      (h * y).to_long(),
      (w * ww).to_long(),
      (h * 0.10).to_long(),
      "CREAM",
    )
  }
  c.outline()
}

# Which routine draws what. One table, so adding a sprite is one line.
mut DRAW = {
  CAR01: |c, w, h| draw_vehicle(c, w, h, "wedge", 1),
  CAR02: |c, w, h| draw_vehicle(
    c,
    w,
    h,
    "beetle",
    2,
    ("GLASS", "GLASS_D", "CREAM"),
  ),
  CAR03: |c, w, h| draw_vehicle(
    c,
    w,
    h,
    "suv",
    3,
    ("LEAF_M", "LEAF_D", "LEAF_L"),
  ),
  CAR04: |c, w, h| draw_vehicle(
    c,
    w,
    h,
    "van",
    4,
    ("LAMP", "CORAL_D", "LAMP_L"),
  ),
  TRUCK: |c, w, h| draw_vehicle(
    c,
    w,
    h,
    "van",
    5,
    ("CREAM", "SHADOW", "PLATE"),
  ),
  SEMI: |c, w, h| draw_semi(c, w, h, 6),
  PLAYER_STRAIGHT: |c, w, h| draw_vehicle(c, w, h, "wedge", 10),
  PLAYER_LEFT: |c, w, h| draw_vehicle(c, w, h, "wedge", 11),
  PLAYER_RIGHT: |c, w, h| draw_vehicle(c, w, h, "wedge", 12),
  PLAYER_UPHILL_STRAIGHT: |c, w, h| draw_vehicle(c, w, h, "wedge", 13),
  PLAYER_UPHILL_LEFT: |c, w, h| draw_vehicle(c, w, h, "wedge", 14),
  PLAYER_UPHILL_RIGHT: |c, w, h| draw_vehicle(c, w, h, "wedge", 15),
  TREE1: |c, w, h| draw_round_tree(c, w, h, 20),
  TREE2: |c, w, h| draw_round_tree(c, w, h, 21),
  DEAD_TREE1: |c, w, h| draw_dead_tree(c, w, h, 22),
  DEAD_TREE2: |c, w, h| draw_dead_tree(c, w, h, 23),
  PALM_TREE: |c, w, h| draw_palm(c, w, h, 24),
  BUSH1: |c, w, h| draw_bush(c, w, h, 25),
  BUSH2: |c, w, h| draw_bush(c, w, h, 26),
  CACTUS: |c, w, h| draw_cactus(c, w, h, 27),
  STUMP: |c, w, h| draw_stump(c, w, h, 28),
  BOULDER1: |c, w, h| draw_boulder(c, w, h, 29),
  BOULDER2: |c, w, h| draw_boulder(c, w, h, 30),
  BOULDER3: |c, w, h| draw_boulder(c, w, h, 31),
  COLUMN: |c, w, h| draw_column(c, w, h, 32),
}
for i in 1..10 {
  DRAW["BILLBOARD{i:02}"] = |c, w, h| draw_billboard(c, w, h, 40 + i)
}

# One sheet. Sprites are not recoloured per scene (only the backgrounds are),
# so the sheet is baked with the day palette.
fn build_sprites() {
  mut img = KeyImage(atlas.SPRITE_W, atlas.SPRITE_H)
  let missing = atlas.SPRITES.keys().filter(|n| !DRAW.has(n))
  if !missing.empty() {
    throw {
      kind: "ValueError",
      message: "no draw routine for {missing.sorted()}",
    }
  }
  for name, r in atlas.SPRITES {
    let [x, y, w, h] = r
    let s = cell_scale(w, h)
    let cw = (w + s - 1) / s  # ceil, then crop back to w x h
    let ch = (h + s - 1) / s
    mut cells = Cells(cw, ch)
    DRAW[name](cells, cw, ch)
    img.blit_cells(cells, x, y, w, h, s)
  }
  img
}

# --- main --------------------------------------------------------------------
let outdir = !Sys.argv.empty()
  ? Sys.argv[0]
  : FS.join(FS.dirname(FS.dirname(Sys.script)), "assets")
FS.mkdir(outdir)
mut written = []

let bg = build_background()
for (name, scene) in SCENES {
  let path = FS.join(outdir, "background_{name}.png")
  let png = Canvas.Sprite.new(bg.k, bg.w, bg.h, palette_colors(scene)).to_png()
  FS.write(path, png)
  written.push((path, png.size()))
}

let sp = build_sprites()
let sprite_path = FS.join(outdir, "sprites.png")
let sprite_png = Canvas
  .Sprite
  .new(sp.k, sp.w, sp.h, palette_colors(HIRU))
  .to_png()
FS.write(sprite_path, sprite_png)
written.push((sprite_path, sprite_png.size()))

for (path, n) in written {
  println("{FS.basename(path):<28} {n:>8} bytes")
}
