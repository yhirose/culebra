# A sign panel in a metal frame on two posts, with lamps over the top.
fn draw_billboard(c, w, h, seed, design) {
  let post_w = Math.max(3, (w * 0.05).to_long())
  let panel_y = h * 0.06
  let panel_h = h * 0.6
  for px in [w * 0.2, w * 0.8 - post_w] {
    c.rect(px, panel_y + panel_h - 2, post_w, h - panel_y - panel_h + 2, "POST")
    c.rect(
      px + post_w - 1,
      panel_y + panel_h - 2,
      1,
      h - panel_y - panel_h + 2,
      "INK",
    )
    c.rect(px - post_w, h * 0.97, post_w * 3, h * 0.03, "POST")
  }
  c.rect(w * 0.03, panel_y, w * 0.94, panel_h, "FRAME")
  c.rect(w * 0.03, panel_y + panel_h - 2, w * 0.94, 2, "POST")
  c.rect(w * 0.03, panel_y, 2, panel_h, "P_WHITE")
  for lx in [w * 0.3, w * 0.7] {
    c.rect(lx - 1, 0, 2, panel_y + 1, "POST")
    c.rect(lx - w * 0.04, 0, w * 0.08, Math.max(2.0, h * 0.03), "LAMP_W")
  }
  let inset = Math.max(3.0, w * 0.03)
  poster(
    c,
    w * 0.03 + inset,
    panel_y + inset,
    w * 0.94 - inset * 2,
    panel_h - inset * 2 - 2,
    design.bg,
    design.lines,
    ICONS[design.icon],
    design.get("shadow", nil),
  )
  c.outline()
}

# --- vehicles ----------------------------------------------------------------
# Rear view, one cell per pixel. `style` picks the silhouette family and the
# paint; `steer` leans the cabin into a turn; `hill` is how many extra rows
# of the rear face show when the car is climbing.

# The wheels: a pair of tyres with tread, wider apart than the body's waist
# so their outer halves show.
fn wheels(c, w, floor, tyre_w, tyre_h, inset) {
  for tx in [inset, w - inset - tyre_w] {
    c.rect(tx, floor - tyre_h, tyre_w, tyre_h, "TYRE0")
    for (
      x,
      y,
    ) in [(tx, floor - tyre_h), (tx + tyre_w - 1, floor - tyre_h), (tx, floor - 1), (tx + tyre_w - 1, floor - 1)] {
      c.set(x, y, 0)
    }
    c.rect(tx + 2, floor - tyre_h + 1, tyre_w - 4, 1, "TYRE1")
    for y in floor - tyre_h + 3..floor - 1 by 2 {
      c.set(tx, y, "TYRE1")
      c.set(tx + tyre_w - 1, y, "TYRE1")
    }
  }
}

# Half-width of a body at row `y`, from control points `[[y, half], ...]`
# (ascending y), smoothed between them so the flanks curve rather than step.
fn profile(points, y) {
  return points[0][1] if y <= points[0][0]
  let last = points[points.size() - 1]
  return last[1] if y >= last[0]
  mut i = 0
  while points[i + 1][0] < y {
    i += 1
  }
  let [y0, h0] = points[i]
  let [y1, h1] = points[i + 1]
  let t = (y - y0).to_float() / (y1 - y0)
  h0 + (h1 - h0) * t * t * (3 - 2 * t)
}

# Fill a profile's rows: the flanks shade toward the dark tone where the
# surface turns away, the first `top_light` rows toward the light one.
fn shell(c, cx, points, tones, top_light) {
  let (d, m, l) = tones
  let y0 = points[0][0].to_long()
  let y1 = points[points.size() - 1][0].to_long()
  for y in y0..=y1 {
    let half = profile(points, y)
    for x in (cx - half).to_long()..=(cx + half).to_long() {
      let u = Math.abs(x - cx) / Math.max(1.0, half)
      cond {
        u > 0.92 => c.set(x, y, d),
        u > 0.78 => c.mix(x, y, m, d, (u - 0.78) / 0.14),
        y <
          y0 +
            top_light => c.mix(
          x,
          y,
          l,
          m,
          (y - y0).to_float() / top_light * 0.8 + u * 0.4,
        ),
        _ => c.set(x, y, m),
      }
    }
  }
}

# Glass inside a cabin profile, `inset` cells in from the pillars: dark tint
# with a lighter band low down and two highlight strokes upper left.
fn glass(c, cx, points, inset) {
  let y0 = points[0][0].to_long() + inset
  let y1 = points[points.size() - 1][0].to_long() - inset
  for y in y0..=y1 {
    let half = profile(points, y) - inset - 1
    continue if half < 1
    let t = (y - y0).to_float() / Math.max(1, y1 - y0)
    for x in (cx - half).to_long()..=(cx + half).to_long() {
      c.set(x, y, t > 0.7 ? "GLASS1" : "GLASS0")
    }
  }
  let hw = profile(points, y0 + 2)
  c.line(cx - hw * 0.55, y1 - 1, cx - hw * 0.2, y0 + 1, "GLASS2", 1)
  c.line(cx - hw * 0.75, y1 - 1, cx - hw * 0.45, y0 + 2, "GLASS2", 1)
}

fn plate(c, cx, y, pw) {
  c.rect(cx - pw / 2.0, y, pw, 4, "PLATE")
  for x in (cx - pw / 2.0 + 2).to_long()..(cx + pw / 2.0 - 2).to_long() by 2 {
    c.set(x, y + 2, "INK")
  }
}

# A pair of tail lamps that follow the body's curve: each row starts at the
# flank, so a lamp wraps round the corner the way the profile does. The
# lower part is the red lens, the top the lit strip, the inner end amber.
fn wrap_lamps(c, cx, body, y, lamp_h, lw) {
  for i in 0..lamp_h {
    let half = profile(body, y + i) - 2
    for (x0, dir) in [(cx - half, 1), (cx + half - lw, 1)] {
      c.rect(x0, y + i, lw, 1, i < 2 ? "LAMP_RL" : "LAMP_R")
      let amber = x0 < cx ? x0 + lw - 2 : x0
      c.rect(amber, y + i, 2, 1, "LAMP_A") if i >= 1
    }
  }
}

# Two riders in an open cabin: seats, shoulders, heads with hair.
fn riders(c, cx, top, spacing) {
  for (
    dx,
    hair,
    shirt,
  ) in [(-spacing, "HAIR_BROWN", "SHIRT_A"), (spacing, "HAIR_BLOND", "SHIRT_B")] {
    let x = cx + dx
    c.rect(x - 6, top + 7, 12, 6, "TYRE1")   # seat back
    c.rect(x - 5, top + 5, 10, 4, shirt)     # shoulders
    c.circle(x, top + 3, 3.4, "SKIN")        # head
    c.ellipse(x, top + 1.5, 3.6, 2.2, hair)  # hair
    c.rect(x - 4, top + 1, 8, 1, hair)
    c.set(x + (hair == "HAIR_BLOND" ? 3 : -3), top + 4, hair)
  }
}

# The player's car, after the mid-engined coupés of the early nineties: low
# and wide, a slim glass canopy over a broad tail, a lamp bar the width of
# the car under a lip spoiler, a black lower bumper. The roof is off, so the
# two riders sit up through the canopy. `hill` adds rows to the tail and
# moves everything above it down with them.
fn draw_sports_car(c, w, h, steer, hill) {
  let cx = w / 2.0
  let floor = h - 1
  let top = 3 + hill
  let deck = 17 + hill
  wheels(c, w, floor, 13, 15, 0)
  let body = [
    [deck, w * 0.40],
    [deck + 2, w * 0.47],
    [deck + 6, w * 0.5],
    [floor - 8, w * 0.5],
    [floor - 4, w * 0.48],
    [floor - 2, w * 0.44],
  ]
  shell(c, cx, body, ("RED0", "RED1", "RED2"), 3)
  # The lip spoiler along the deck's trailing edge, the lamp bar under it.
  c.rect(cx - w * 0.42, deck - 1, w * 0.84, 2, "RED0")
  c.rect(cx - w * 0.40, deck - 2, w * 0.80, 1, "RED2")
  let bar_y = deck + 3
  let bar_half = profile(body, bar_y) - 2
  c.rect(cx - bar_half, bar_y, bar_half * 2, 5, "LAMP_R")
  c.rect(cx - bar_half + 1, bar_y, bar_half * 2 - 2, 2, "LAMP_RL")
  for (
    x,
    y,
  ) in [(cx - bar_half, bar_y), (cx + bar_half - 1, bar_y), (cx - bar_half, bar_y + 4), (cx + bar_half - 1, bar_y + 4)] {
    c.set(x, y, "RED1")
  }
  for x in (cx - bar_half + 7).to_long()..(cx + bar_half).to_long() by 8 {
    c.rect(x, bar_y, 1, 5, "INK")
  }
  # The black lower bumper, darkening toward the ground, with the plate and
  # the pipes.
  let low = floor - 9
  for y in low..floor - 1 {
    let half = profile(body, y) - 1
    for x in (cx - half).to_long()..=(cx + half).to_long() {
      c.mix(x, y, "TYRE1", "TYRE0", (y - low).to_float() / (floor - 1 - low))
    }
  }
  plate(c, cx, low + 2, 14)
  for ex in [cx - w * 0.3, cx + w * 0.3 - 6] {
    c.rect(ex, floor - 4, 6, 2, "CHROME")  # exhausts
    c.rect(ex + 1, floor - 4, 4, 1, "TYRE1")
  }
  # The canopy: pillars in body colour, glass between, the riders through it.
  let canopy = [
    [top, w * 0.2],
    [top + 3, w * 0.3],
    [top + 8, w * 0.35],
    [deck, w * 0.39],
  ]
  shell(c, cx, canopy, ("RED0", "RED1", "RED2"), 0)
  glass(c, cx, canopy, 2)
  c.rect(cx - w * 0.2, top, w * 0.4, 1, "INK")  # the roof hoop
  riders(c, cx, top, 8)
  c.ellipse(cx - w * 0.43, top + 8, 3, 2, "RED1")  # mirrors
  c.ellipse(cx + w * 0.43, top + 8, 3, 2, "RED1")
  c.outline()
  c.shear(deck, -steer * 0.2) if steer != 0
  ground_shadow(c, w / 2, floor, w * 0.48, 1)
}

# Traffic: hardtops of four silhouettes, each a cabin profile over a body
# profile. The proportions are fractions of the box, so an 80x56 coupe and
# an 88x55 pickup share the routine.
fn draw_hardtop(c, w, h, kind, body, seed) {
  let (d, m, l) = body
  let cx = w / 2.0
  let floor = h - 1
  let roof = (h * 0.06).to_long()
  let deck = (h * cond {
    kind == "beetle" => 0.46,
    kind == "pickup" => 0.32,
    _ => 0.42,
  }).to_long()
  wheels(
    c,
    w,
    floor,
    Math.max(9, (w * 0.14).to_long()),
    (h * 0.24).to_long(),
    1,
  )
  # The lower body: shoulders that swell over the wheels, tucking in at the sill.
  let lower = match kind {
    "sedan" => [
      [deck, w * 0.43],
      [deck + 3, w * 0.485],
      [deck + 9, w * 0.495],
      [floor - 9, w * 0.49],
      [floor - 5, w * 0.46],
      [floor - 2, w * 0.4],
    ],
    "beetle" => [
      [deck, w * 0.36],
      [deck + 3, w * 0.44],
      [deck + 8, w * 0.48],
      [floor - 9, w * 0.485],
      [floor - 5, w * 0.45],
      [floor - 2, w * 0.38],
    ],
    _ => [
      [deck, w * 0.40],
      [deck + 3, w * 0.47],
      [deck + 8, w * 0.49],
      [floor - 9, w * 0.485],
      [floor - 5, w * 0.46],
      [floor - 2, w * 0.4],
    ],
  }
  # The cabin: a fastback for the coupe, a dome for the beetle, a notchback
  # otherwise.
  let cabin = match kind {
    "coupe" => [
      [roof, w * 0.2],
      [roof + 2, w * 0.3],
      [roof + 6, w * 0.35],
      [deck, w * 0.41],
    ],
    "beetle" => [
      [roof, w * 0.05],
      [roof + 3, w * 0.22],
      [roof + 8, w * 0.31],
      [deck, w * 0.36],
    ],
    "pickup" => [
      [roof, w * 0.22],
      [roof + 2, w * 0.29],
      [roof + 5, w * 0.31],
      [deck, w * 0.32],
    ],
    _ => [
      [roof, w * 0.27],
      [roof + 2, w * 0.34],
      [roof + 6, w * 0.37],
      [deck, w * 0.41],
    ],
  }
  shell(c, cx, cabin, body, 3)
  glass(c, cx, cabin, kind == "beetle" ? 4 : 3)
  shell(c, cx, lower, body, kind == "pickup" ? 2 : 4)
  let crease = deck + (h * 0.1).to_long()
  if kind == "pickup" {
    # The bed: its rim, the dark inside, and a tailgate with a handle.
    c.rect(
      cx - profile(lower, deck + 1) + 2,
      deck + 1,
      profile(lower, deck + 1) * 2 - 4,
      crease - deck - 1,
      d,
    )
    c.rect(
      cx - profile(lower, deck) + 1,
      deck,
      profile(lower, deck) * 2 - 2,
      1,
      l,
    )
    c.rect(cx - 4, crease + 2, 8, 2, "CHROME")
  } else {
    c.rect(
      cx - profile(lower, crease) + 2,
      crease,
      profile(lower, crease) * 2 - 4,
      1,
      d,
    )
  }
  c.rect(
    cx - profile(lower, floor - 4) + 1,
    floor - 5,
    profile(lower, floor - 4) * 2 - 2,
    3,
    kind == "beetle" ? "CHROME" : d,
  )
  match kind {
    "beetle" => {
      for sx in [cx - w * 0.36, cx + w * 0.36] {
        c.ellipse(sx, crease + 5, 3.5, 3.5, "LAMP_R")
        c.ellipse(sx, crease + 4, 2, 1.5, "LAMP_RL")
      }
      for y in crease + 2..crease + 10 by 2 {
        c.rect(cx - 9, y, 18, 1, d)  # engine-lid slats
      }
      plate(c, cx, floor - 10, 12)
    },
    "sedan" => {
      wrap_lamps(c, cx, lower, crease + 2, 5, (w * 0.28).to_long())
      c.rect(cx - w * 0.2, crease + 4, w * 0.4, 1, "CHROME")  # the strip that joins them
      plate(c, cx, floor - 10, 14)
    },
    "pickup" => {
      for sx in [cx - profile(lower, crease + 2) + 2, cx + profile(lower, crease + 2) - 6] {
        c.rect(sx, crease + 1, 4, 10, "LAMP_R")
        c.rect(sx, crease + 1, 4, 3, "LAMP_RL")
      }
      plate(c, cx, floor - 10, 12)
    },
    _ => {
      wrap_lamps(c, cx, lower, crease + 2, 5, (w * 0.22).to_long())
      plate(c, cx, floor - 10, 14)
    },
  }
  let my = roof + (deck - roof) * 0.72
  c.ellipse(cx - profile(cabin, my) - 3, my, 3, 1.6, m)  # mirrors
  c.ellipse(cx + profile(cabin, my) + 3, my, 3, 1.6, m)
  c.rect(cx + w * 0.22, floor - 2, 5, 2, "CHROME") if kind != "beetle"  # exhaust
  c.outline()
  ground_shadow(c, w / 2, floor, w * 0.46, 1)
}

# A box body on twin wheels — the truck, and the trailer of the semi. The
# box carries a stripe and a name; the doors meet at a seam down the middle.
fn draw_box_truck(c, w, h, seed, name, band) {
  let floor = h - 2
  let box_x = (w * 0.05).to_long()
  let box_w = w - box_x * 2
  let box_top = 2
  let box_bottom = floor - (h * 0.16).to_long()
  let tw = Math.max(8, (w * 0.12).to_long())
  wheels(c, w, floor, tw, (h * 0.13).to_long(), box_x + 2)
  wheels(c, w, floor, tw, (h * 0.13).to_long(), box_x + 2 + tw + 1)
  c.rect(box_x, box_top, box_w, box_bottom - box_top, "WHITE1")
  c.rect(box_x, box_top, box_w, 2, "WHITE2")
  c.rect(box_x, box_top, 2, box_bottom - box_top, "WHITE2")
  c.dither(
    box_x + box_w - 4,
    box_top,
    4,
    box_bottom - box_top,
    "WHITE0",
    "WHITE1",
  )
  c.dither(box_x, box_bottom - 5, box_w, 5, "WHITE0", "WHITE1")
  let band_y = box_top + ((box_bottom - box_top) * 0.42).to_long()
  let band_h = Math.max(6, ((box_bottom - box_top) * 0.22).to_long())
  c.rect(box_x, band_y, box_w, band_h, band)
  c.rect(box_x, band_y + band_h, box_w, 1, "INK")
  let s = fit_scale([(name, "")], box_w - 8, band_h - 2)
  c.text(
    name,
    w / 2 - Canvas.text_width(name, s) / 2,
    band_y + (band_h - 8 * s) / 2,
    "WHITE2",
    s,
  )
  c.rect(w / 2, box_top, 1, box_bottom - box_top, "WHITE0")  # door seam
  for y in [box_top + 6, box_bottom - 8] {
    c.rect(w / 2 - 4, y, 3, 3, "TYRE1")
    c.rect(w / 2 + 2, y, 3, 3, "TYRE1")
  }
  c.rect(box_x, box_bottom, box_w, 3, "TYRE1")  # sill
  for x in box_x..box_x + box_w by 6 {
    c.rect(x, box_bottom, 3, 3, "P_YELLOW")
  }
  c.rect(box_x + 2, box_bottom + 4, box_w - 4, 3, "TYRE0")  # underride bar
  for lx in [box_x + 2, box_x + box_w - 8] {
    c.rect(lx, box_bottom + 4, 6, 3, "LAMP_R")
    c.rect(lx, box_bottom + 4, 6, 1, "LAMP_RL")
  }
  c.rect(w / 2 - 6, box_bottom + 4, 12, 3, "PLATE")
  for tx in [box_x, box_x + box_w - tw - 2] {
    c.rect(tx, box_bottom + 7, tw + 2, (h * 0.07).to_long(), "TYRE1")  # mudflaps
  }
  c.outline()
  ground_shadow(c, w / 2, floor + 1, w * 0.48, 1)
}

# Which routine draws what. One table, so adding a sprite is one line.
mut DRAW = {
  CAR01: |c, w, h| draw_hardtop(
    c,
    w,
    h,
    "coupe",
    ("BLUE0", "BLUE1", "BLUE2"),
    1,
  ),
  CAR02: |c, w, h| draw_hardtop(
    c,
    w,
    h,
    "beetle",
    ("YELLOW0", "YELLOW1", "YELLOW2"),
    2,
  ),
  CAR03: |c, w, h| draw_hardtop(
    c,
    w,
    h,
    "pickup",
    ("GREEN0", "GREEN1", "GREEN2"),
    3,
  ),
  CAR04: |c, w, h| draw_hardtop(
    c,
    w,
    h,
    "sedan",
    ("WHITE0", "WHITE1", "WHITE2"),
    4,
  ),
  TRUCK: |c, w, h| draw_box_truck(c, w, h, 5, "FRESH", "P_GREEN"),
  SEMI: |c, w, h| draw_box_truck(c, w, h, 6, "CULEBRA", "P_BLUE"),
  PLAYER_STRAIGHT: |c, w, h| draw_sports_car(c, w, h, 0, 0),
  PLAYER_LEFT: |c, w, h| draw_sports_car(c, w, h, -1, 0),
  PLAYER_RIGHT: |c, w, h| draw_sports_car(c, w, h, 1, 0),
  PLAYER_UPHILL_STRAIGHT: |c, w, h| draw_sports_car(c, w, h, 0, 4),
  PLAYER_UPHILL_LEFT: |c, w, h| draw_sports_car(c, w, h, -1, 4),
  PLAYER_UPHILL_RIGHT: |c, w, h| draw_sports_car(c, w, h, 1, 4),
  TREE1: |c, w, h| draw_birch(c, w, h, 20),
  TREE2: |c, w, h| draw_cherry(c, w, h, 21),
  DEAD_TREE1: |c, w, h| draw_dead_tree(c, w, h, 22),
  DEAD_TREE2: |c, w, h| draw_dead_tree(c, w, h, 23),
  PALM_TREE: |c, w, h| draw_palm_sprite(c, w, h, 24),
  BUSH1: |c, w, h| draw_bush(c, w, h, 25),
  BUSH2: |c, w, h| draw_bush(c, w, h, 26, true),
  CACTUS: |c, w, h| draw_cactus(c, w, h, 27),
  STUMP: |c, w, h| draw_stump(c, w, h, 28),
  BOULDER1: |c, w, h| draw_boulder(c, w, h, 29),
  BOULDER2: |c, w, h| draw_boulder(c, w, h, 30),
  BOULDER3: |c, w, h| draw_boulder(c, w, h, 31),
  COLUMN: |c, w, h| draw_column(c, w, h, 32),
}
for i in 1..10 {
  DRAW["BILLBOARD{i:02}"] = |c, w, h| draw_billboard(
    c,
    w,
    h,
    40 + i,
    POSTERS[i - 1],
  )
}

# One sheet. Sprites are not recoloured per scene (only the backgrounds are),
# so the sheet is baked with the day palette.
fn build_sprites() {
  mut img = KeyImage(atlas.SPRITE_W, atlas.SPRITE_H)
  let missing = atlas.SPRITES.keys().filter(|n| !DRAW.has(n))
  if !missing.empty() {
    throw {
      kind: "ValueError",
      message: "no draw routine for {missing.sorted()}",
    }
  }
  for name, r in atlas.SPRITES {
    let [x, y, w, h] = r
    let s = cell_scale(w, h)
    let cw = (w + s - 1) / s  # ceil, then crop back to w x h
    let ch = (h + s - 1) / s
    mut cells = Cells(cw, ch)
    DRAW[name](cells, cw, ch)
    img.blit_cells(cells, x, y, w, h, s)
  }
  img
}

# --- main --------------------------------------------------------------------
let outdir = !Sys.argv.empty()
  ? Sys.argv[0]
  : FS.join(FS.dirname(FS.dirname(Sys.script)), "assets")
let what = Sys.argv.get(1, "all")
FS.mkdir(outdir)
Canvas.init(1, 1)
mut written = []

if what != "sprites" {
  let bg = build_background()
  for (name, scene) in SCENES {
    let path = FS.join(outdir, "background_{name}.png")
    let png = Canvas
      .Sprite
      .new(bg.k, bg.w, bg.h, palette_colors(scene))
      .to_png()
    FS.write(path, png)
    written.push((path, png.size()))
  }
}

if what != "backgrounds" {
  let sp = build_sprites()
  let sprite_path = FS.join(outdir, "sprites.png")
  let sprite_png = Canvas
    .Sprite
    .new(sp.k, sp.w, sp.h, palette_colors(HIRU))
    .to_png()
  FS.write(sprite_path, sprite_png)
  written.push((sprite_path, sprite_png.size()))
}

for (path, n) in written {
  println("{FS.basename(path):<28} {n:>8} bytes")
}

# The road-side colours retro-run.cul lerps between, in its SCENE_COLORS
# order: grass dark/light, road dark/light, rumble dark/light, fog, sky.
println()
println("SCENE_COLORS for retro-run.cul:")
for (name, scene) in SCENES {
  let pal = {...COMMON, ...scene}
  let row = [
    "GRASS_D",
    "GRASS_L",
    "ROAD_D",
    "ROAD_L",
    "RUMBLE_D",
    "RUMBLE_L",
    "FOG",
    "SKY0",
  ].flat_map(|k| pal[k])
  println("  # {name}")
  println("  [{row.slice(0, 12).join(", ")},")
  println("   {row.slice(12, 24).join(", ")}],")
}
