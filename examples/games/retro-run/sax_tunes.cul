# The laps' songs with a saxophone leading, an octave under the chip: a
# soprano for the first lap and an alto for the second, each with the band of
# its own file in place of run.kau's, and each phrase it plays made beforehand
# from the songs (tools/gen_music.cul, by kauai/tools/make_sounds.cul and
# kauai/sounds/soprano_sax and alto_sax in this repository). NAME.json says
# what the saxophone hears and, by the JSON of what Kauai hands it, where in
# NAME.bin each phrase's bytes are: Ogg, but for the note Kauai weighs the
# voice by, a WAV, whose loudness it reads on every backend.

# Each lap's saxophone: the band that has it lead, the phrases made for it
# (`made`.json and .bin), its key under the band's `external`, and the
# instrument under kauai/sounds/ the phrases are made with.
let LEADS = {
  "cruise.kau": {band: "run_soprano_sax.kau", made: "soprano_sax", voice: "sopranosax", package: "soprano_sax"},
  "sprint.kau": {band: "run_alto_sax.kau", made: "alto_sax", voice: "altosax", package: "alto_sax"},
}

# `name` from `songs` (a Dir) with its saxophone leading, the band's other
# external voices from `voices`; its sounds built. nil for a song with no
# saxophone, when `songs` has no phrases made for it, or a phrase the song
# plays was not made (an edited song), which it says on stderr.
fn load(name, songs, voices) {
  let lead = LEADS.get(name, nil)
  return nil if lead == nil || !songs.exists("{lead.made}.json")
  let made = JSON.parse(songs.read("{lead.made}.json")).voices[lead.voice]
  let bytes = songs.read("{lead.made}.bin")
  let missing = []
  let sax = {phrase: fn (notes, params) {
    let at = made.sounds.get(JSON.stringify([notes, params]), nil)
    if at == nil {
      missing.push(notes)
      return Audio.Sound([0.0])
    }
    Audio.Sound(bytes.slice(at[0], at[0] + at[1]).to_string())
  }, hears: made.hears}
  let as_led = |n| n == "run.kau" ? lead.band : n
  let dir = {
    exists: |n| songs.exists(as_led(n)),
    read: |n| songs.read(as_led(n)),
  }
  let led = {...voices}
  led[lead.voice] = sax
  let tune = Audio.Kauai.load(name, dir: dir, voices: led)
  while tune.prepare() > 0 {
  }
  if !missing.empty() {
    IO.eprintln("retro-run: {missing.size()} of {name}'s phrases were not made for the saxophone, so its lead is the chip's")
    return nil
  }
  tune
}

export {LEADS, load}
