# Same Game (さめがめ) — a Term TUI showcase for per-cell colour and the
# unified input-event model (mouse + keyboard).
#
# Click a group of two or more connected same-coloured tiles to clear it;
# the tiles above fall down and empty columns collapse to the left. A bigger
# group scores more — (n - 2)^2 points. Clear the whole board for a bonus.
# Game over when no group of two remains.
#
# Run it:  culebra examples/samegame.cul             (play; click or arrows+space, q quits)
#          culebra examples/samegame.cul 40 </dev/null    (auto-demo, up to 40 moves)
#          culebra examples/samegame.cul 40 7 </dev/null  (auto-demo, board seeded with 7)

ROWS = 9
COLS = 14
NCOLORS = 5
COLORS = [0, 196, 46, 39, 226, 201]   # 256-colour per tile value 1..5

MAX_MOVES = !Sys.argv.empty() ? to_long(Sys.argv[0]) : -1
# Optional second arg seeds the board for a reproducible demo (and lets the
# interp / JIT / AOT backends be diffed byte-for-byte); -1 = seed from the clock.
SEED = Sys.argv.size() > 1 ? to_long(Sys.argv[1]) : -1
INTERACTIVE = IO.stdin_is_terminal()

SCORE_DIR = Sys.env("HOME") + "/.samegame"
SCORE_FILE = SCORE_DIR + "/score.json"

fn new_board() {
  Random.seed(SEED >= 0 ? SEED : to_long(Time.now().unix()))
  iota(ROWS).map(|_| iota(COLS).map(|_| Random.int(1, NCOLORS + 1)))   # 1..NCOLORS
}

# All cells orthogonally connected to (r,c) sharing its colour.
fn group_at(b, r, c) {
  let color = b[r][c]
  if color == 0 { return [] }

  mut out = []
  mut seen = [].to_set()          # (row, col) tuples — Sets take any hashable
  mut stack = [(r, c)]
  while !stack.empty() {
    let (pr, pc) = stack.pop()
    let inside = pr >= 0 && pr < ROWS && pc >= 0 && pc < COLS
    # `add` reports whether the cell was new, so the visited test and the mark
    # it leaves behind are one call.
    if inside && seen.add((pr, pc)) && b[pr][pc] == color {
      out.push((pr, pc))
      stack.push((pr - 1, pc))
      stack.push((pr + 1, pc))
      stack.push((pr, pc - 1))
      stack.push((pr, pc + 1))
    }
  }
  out
}

fn remove_cells(b, cells) {
  for (r, c) in cells { b[r][c] = 0 }
}

# Tiles fall to the bottom of each column: the survivors keep their order and
# the gap they leave lands on top.
fn gravity(b) {
  for c in 0..COLS {
    let col = range(ROWS).map(|r| b[r][c]).filter(|v| v != 0).collect()
    let gap = ROWS - col.size()
    for r in 0..ROWS { b[r][c] = r < gap ? 0 : col[r - gap] }
  }
}

# Empty columns are removed; the rest shift left.
fn collapse(b) {
  mut write = 0
  for c in 0..COLS {
    if b[ROWS - 1][c] != 0 {
      if write != c {
        for r in 0..ROWS { b[r][write] = b[r][c] }
      }
      write += 1
    }
  }
  for c in write..COLS {
    for r in 0..ROWS { b[r][c] = 0 }
  }
}

fn has_moves(b) {
  for r in 0..ROWS {
    for c in 0..COLS {
      let v = b[r][c]
      if v != 0 {
        if c + 1 < COLS && b[r][c + 1] == v { return true }
        if r + 1 < ROWS && b[r + 1][c] == v { return true }
      }
    }
  }
  false
}

fn count_tiles(b) { b.iter().flatten().filter(|v| v != 0).count() }

# First cell whose group is removable (used by the auto-demo).
fn find_move(b) {
  for r in 0..ROWS {
    for c in 0..COLS {
      if b[r][c] != 0 && group_at(b, r, c).size() >= 2 { return (r, c) }
    }
  }
  (-1, -1)
}

fn offsets(s) { ((s.cols() - COLS * 2) / 2, (s.rows() - ROWS) / 2) }

fn draw(s, b, cur_r, cur_c, score, msg) {
  s.clear()
  let (ox, oy) = offsets(s)
  s.put(ox, oy - 2, "Same Game   Score: {score}   {msg}")
  for r in 0..ROWS {
    for c in 0..COLS {
      let v = b[r][c]
      let px = ox + c * 2
      let py = oy + r
      let cur = INTERACTIVE && r == cur_r && c == cur_c
      let tile = cur ? "()" : "  "
      if v == 0 { s.put(px, py, tile) }
      else if cur { s.put(px, py, tile, Term.style(fg: 15, bg: COLORS[v])) }
      else { s.put(px, py, tile, Term.style(bg: COLORS[v])) }
    }
  }
  s.flush()
}

fn load_scores() {
  if !FS.exists(SCORE_FILE) { return [] }
  try { JSON.parse(FS.read(SCORE_FILE)) } catch e { [] }
}

fn save_scores(scores) {
  FS.mkdir(SCORE_DIR)
  FS.write(SCORE_FILE, JSON.stringify(scores, indent: 2))
}

# Merges `entry` into `scores`, keeps the top 5 by score, and reports
# whether `entry` made the cut.
fn rank_into(scores, entry) {
  let list = [...scores, entry].sorted_by(|x| x.score, reverse: true).slice(0, 5)
  (list, list.index_of(entry) >= 0)
}

# Persists `score` into the top-5 file. Returns (top5, entry) — entry is
# nil when the score didn't make the cut (and nothing is written).
fn record_score(score) {
  let scores = load_scores()
  let now = Time.now()
  let entry = {score: score, date: now.format("%Y-%m-%d"), time: now.format("%H:%M:%S")}
  let (list, made_top5) = rank_into(scores, entry)
  if made_top5 { save_scores(list) }
  (list, made_top5 ? entry : nil)
}

fn spaces(n) { [](n, " ").join("") }

let BOX_BODY = Term.style(bg: 236, fg: 255)
let BOX_TITLE = Term.style(bg: 236, fg: 226, bold: true)
let BOX_FOOTER = Term.style(bg: 236, fg: 244)
let BOX_PICK = Term.style(bg: 226, fg: 16, bold: true)

# A centred `w`-wide panel: title, body lines, footer. `pick` is the index of
# the body line to single out, or -1 for none.
fn draw_box(s, w, title, lines, pick, footer) {
  let list_start = 3
  let footer_row = list_start + lines.size() + 1
  let h = footer_row + 2
  let bx = (s.cols() - w) / 2
  let by = (s.rows() - h) / 2

  let blank = spaces(w)
  for r in 0..h { s.put(bx, by + r, blank, BOX_BODY) }

  s.put(bx + 2, by + 1, title, BOX_TITLE)
  for i, line in lines.enumerate() {
    s.put(bx + 2, by + list_start + i, line, i == pick ? BOX_PICK : BOX_BODY)
  }
  s.put(bx + 2, by + footer_row, footer, BOX_FOOTER)
  s.flush()
}

fn draw_score_box(s, scores, highlight, footer) {
  let lines = scores.empty()
    ? ["no scores yet"]
    : scores.enumerate()
            .map(|(i, e)| "{i + 1}. {e.score}   {e.date} {e.time}")
            .collect()
  # index_of answers -1 for a nil highlight and for the empty board alike.
  draw_box(s, 40, "BEST 5", lines, scores.index_of(highlight), footer)
}

# Shows the persisted top 5, plus the live in-progress score (highlighted)
# if it would currently place in the top 5. Blocks until any key is pressed.
fn show_scores(s, board, cur_r, cur_c, score, msg) {
  let scores = load_scores()
  let entry = {score: score, date: "(current)", time: ""}
  let (list, made_top5) = rank_into(scores, entry)
  draw(s, board, cur_r, cur_c, score, msg)
  draw_score_box(s, made_top5 ? list : scores, made_top5 ? entry : nil, "press any key")
  wait_any_key(s)
}

fn draw_help_box(s) {
  draw_box(s, 44, "HELP", [
    "Click 2+ same-colored tiles to clear them.",
    "",
    "arrows    move cursor",
    "space     clear group",
    "n         new game",
    "s         best scores",
    "h         this help",
    "q         quit",
  ], -1, "press any key")
}

# Shows the help overlay. Blocks until any key is pressed.
fn show_help(s, board, cur_r, cur_c, score, msg) {
  draw(s, board, cur_r, cur_c, score, msg)
  draw_help_box(s)
  wait_any_key(s)
}

fn wait_any_key(s) {
  while true {
    let e = s.poll(0.1)
    if e?.kind == "key" { return e.key }
  }
}

fn try_remove(b, r, c) {
  let cells = group_at(b, r, c)
  if cells.size() < 2 { return -1 }
  remove_cells(b, cells)
  gravity(b)
  collapse(b)
  cells.size()
}

Term.app(fn (s) {
  mut board = new_board()
  mut score = 0
  mut cur_r = 0
  mut cur_c = 0
  mut moves = 0
  mut msg = ""

  fn new_round() {
    board = new_board()
    score = 0
    cur_r = 0
    cur_c = 0
    moves = 0
    msg = ""
  }

  draw(s, board, cur_r, cur_c, score, msg)

  while true {
    if !has_moves(board) {
      let left = count_tiles(board)
      if left == 0 { score += 1000; msg = "CLEARED!  bonus +1000" }
      else { msg = "no moves — game over ({left} left)" }
      msg += "  —  q: quit, other key: new game"
      draw(s, board, cur_r, cur_c, score, msg)
      if !INTERACTIVE { return }
      let (best, entry) = record_score(score)
      if entry != nil {
        draw_score_box(s, best, entry, "q: quit   other key: new game")
        if wait_any_key(s) == "q" { return }
        new_round()
        draw(s, board, cur_r, cur_c, score, msg)
        continue
      }
      if wait_any_key(s) == "q" { return }
      new_round()
      draw(s, board, cur_r, cur_c, score, msg)
    }
    if MAX_MOVES >= 0 && moves >= MAX_MOVES { return }

    mut sr = -1
    mut sc = -1
    if INTERACTIVE {
      let ev = s.poll(0.1)
      if ev != nil {
        if ev.kind == "key" {
          if ev.key == "q" { return }
          match ev.key {
            "n" => { new_round() },
            "s" => { show_scores(s, board, cur_r, cur_c, score, msg) },
            "h" => { show_help(s, board, cur_r, cur_c, score, msg) },
            "left"  => { cur_c = Math.clamp(cur_c - 1, 0, COLS - 1) },
            "right" => { cur_c = Math.clamp(cur_c + 1, 0, COLS - 1) },
            "up"    => { cur_r = Math.clamp(cur_r - 1, 0, ROWS - 1) },
            "down"  => { cur_r = Math.clamp(cur_r + 1, 0, ROWS - 1) },
            " " | "enter" => { sr = cur_r; sc = cur_c },
          }
          draw(s, board, cur_r, cur_c, score, msg)
        } else if ev.kind == "mouse" && ev.event == "press" && ev.button == "left" {
          let (ox, oy) = offsets(s)
          let gc = (ev.x - ox) / 2
          let gr = ev.y - oy
          if gr >= 0 && gr < ROWS && gc >= 0 && gc < COLS { sr = gr; sc = gc }
        }
      }
    } else {
      (sr, sc) = find_move(board)
      Time.sleep(0.04)
    }

    if sr >= 0 {
      let n = try_remove(board, sr, sc)
      if n >= 2 {
        score += (n - 2) * (n - 2)
        moves += 1
        msg = "cleared {n}"
        draw(s, board, cur_r, cur_c, score, msg)
      }
    }
  }
}, mouse: INTERACTIVE)   # enable mouse reporting (interactive only) so clicks reach s.poll()
