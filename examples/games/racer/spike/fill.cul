# racer port — Phase 0 spike: fill rate of the existing Canvas primitives.
#
# The day-cycle design draws the 3 background layers twice during a scene
# transition (~1.2M px/frame at 480x360 on top of the road), so we need to know
# what a pixel costs before committing to that. Everything here is a native
# primitive, so the numbers say what the *host* can do — independent of how
# fast culebra itself runs. `rect` stands in for the future `trapezoid` (both
# are integer spans of a flat colour); `draw_sub` stands in for `blit_scaled`.

let RUNS = 20

let bench = fn (label, px_per_call, calls, body) {
  body()                      # warm up
  let t = Time.monotonic()
  mut i = 0
  while i < RUNS { body(); i = i + 1 }
  let ms = (Time.monotonic() - t) * 1000.0 / RUNS
  let mpx = px_per_call * calls / 1e6
  println("{label:<34}{ms:8.2f} ms  {mpx:6.2f} Mpx  {mpx * 1000.0 / ms:8.1f} Mpx/s")
}

let run = fn (w, h) {
  _Canvas.init(w, h)          # Canvas.init is only exposed from Phase 2 on
  let red = Canvas.rgba(220, 90, 90)
  let blue = Canvas.rgba(90, 120, 220)
  println("--- {w}x{h} ({w * h / 1000} kpx per full screen) ---")

  # one full-screen fill
  bench("clear", w * h, 1, fn () { Canvas.clear(red) })
  bench("rect fullscreen x1", w * h, 1, fn () { Canvas.rect(0, 0, w, h, blue) })
  bench("rect fullscreen x6", w * h, 6, fn () {
    mut i = 0
    while i < 6 { Canvas.rect(0, 0, w, h, blue); i = i + 1 }
  })

  # the road: ~200 horizontal bands covering the lower half, 4 spans each
  # (grass / rumble / road / lane) — what Canvas.trapezoid will replace
  bench("road bands (200 x 4 spans)", w * h / 2, 1, fn () {
    mut n = 0
    while n < 200 {
      let y = h / 2 + (n * h) / 400
      Canvas.rect(0, y, w, 2, red)
      Canvas.rect(w / 8, y, w * 3 / 4, 2, blue)
      Canvas.rect(w / 4, y, w / 2, 2, red)
      Canvas.rect(w / 2 - 1, y, 2, 2, blue)
      n = n + 1
    }
  })

  # background layer: a full-width band blitted from a sheet, unscaled. The
  # band is only 64px tall so building the pixel Array from culebra stays cheap
  # (the real port decodes a PNG straight into the sprite); throughput is what
  # we are after, so scale the Mpx/s up to whatever height the layer needs.
  let band_h = 64
  mut px = []
  mut k = 0
  while k < w * band_h { px.push(red); k = k + 1 }
  let sheet = Canvas.Sprite.new(px, w, band_h)
  bench("blit band x3 (1:1)", w * band_h, 3, fn () {
    mut i = 0
    while i < 3 { sheet.draw_sub(0, 0, 0, 0, w, band_h); i = i + 1 }
  })
  bench("blit band x6 (1:1, transition)", w * band_h, 6, fn () {
    mut i = 0
    while i < 6 { sheet.draw_sub(0, 0, 0, 0, w, band_h); i = i + 1 }
  })
  println("")
}

run(480, 360)
run(640, 480)
run(1024, 768)
