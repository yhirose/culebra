# racer port — Phase 0 follow-up: how far do the optimisations move it?
#
# Same world and same arithmetic as logic.cul, but update()/render() come in
# stacked variants so each rewrite can be priced on its own. The question this
# file answers: at the faithful settings (200 cars, dd=300, one configuration
# shared by native and the Playground), what is left after the rewrites that
# keep the game identical?
#
# Levels (each includes the ones below it):
#   0  logic.cul as measured in Phase 0, plus the AI window (already adopted)
#   1  + per-car segment cursor: the car carries (segment index, offset inside
#      that segment) instead of a track-absolute z, so the two find_segment
#      calls, the modulo and the two Math.floor per car per frame go away
#   2  + inlined render: project() unrolled into the loop, for -> while, and
#      screen coordinates left as floats (the draw primitive rounds, not us)
#   3  + no control-flow exceptions: `return` / `break` / `continue` are C++
#      exceptions in the interpreter, and the AI takes an early `return` for
#      190 of the 200 cars every frame. Same answer via a `done` flag
#
# The sink is reported per level: 0 and 1 must agree exactly (1 is a pure
# rewrite), as do 2 and 3 (3 only changes how update is written); 2 differs
# from 1 by design because it stops rounding.
#
# Section D prices the pieces of the per-car body and is where the cost of
# `return` was isolated.

# --- constants (v4.final.html) ---------------------------------------------
let SEGMENT_LENGTH = 200
let RUMBLE_LENGTH = 3
let ROAD_WIDTH = 2000
let CAMERA_HEIGHT = 1000
let FIELD_OF_VIEW = 100
let FOG_DENSITY = 5
let CENTRIFUGAL = 0.3
let TOTAL_CARS = 200
let LOOKAHEAD = 20
# QUICK trims section A to one player position and shortens the runs, for the
# Playground: the wasm interpreter is several times slower and the browser tab
# has to hold still for the whole run. See README for the one-liner that
# generates the Playground copy (it also drops sections B..D and, against the
# currently published wasm, renames println back to puts).
let QUICK = false
let REPS = if QUICK { 3 } else { 5 }   # best-of-N, to survive CPU contention
let FPS = 60
let STEP = 1.0 / FPS
let SKY_SPEED = 0.001
let HILL_SPEED = 0.002
let TREE_SPEED = 0.003

let CAMERA_DEPTH = 1.0 / Math.tan((FIELD_OF_VIEW / 2.0) * Math.pi / 180.0)
let PLAYER_Z = CAMERA_HEIGHT * CAMERA_DEPTH
let MAX_SPEED = SEGMENT_LENGTH / STEP
let ACCEL = MAX_SPEED / 5.0
let BREAKING = -MAX_SPEED
let DECEL = -MAX_SPEED / 5.0
let OFF_ROAD_DECEL = -MAX_SPEED / 2.0
let OFF_ROAD_LIMIT = MAX_SPEED / 4.0

# sprite sheet geometry (common.js SPRITES) — only w/h matter to the logic
let SPRITE_SCALE = 0.3 * (1.0 / 80.0)      # 1/PLAYER_STRAIGHT.w
let PLAYER_W = 80.0 * SPRITE_SCALE
# [w, h] of everything that gets placed along the road
let CAR_SPRITES = [[80.0, 56.0], [80.0, 59.0], [88.0, 55.0], [80.0, 57.0],
                   [122.0, 144.0], [100.0, 78.0]]     # CAR01..04, SEMI, TRUCK
let SEMI_INDEX = 4
let BILLBOARDS = [[300.0, 170.0], [215.0, 220.0], [230.0, 220.0], [268.0, 170.0],
                  [298.0, 190.0], [298.0, 190.0], [298.0, 190.0], [385.0, 265.0],
                  [328.0, 282.0]]
let PLANTS = [[360.0, 360.0], [282.0, 295.0], [135.0, 332.0], [150.0, 260.0],
              [215.0, 540.0], [240.0, 155.0], [232.0, 152.0], [235.0, 118.0],
              [195.0, 140.0], [168.0, 248.0], [298.0, 140.0], [320.0, 220.0]]
let PALM_TREE = [215.0, 540.0]
let COLUMN = [200.0, 315.0]
let TREE1 = [360.0, 360.0]
let TREE2 = [282.0, 295.0]

# --- Util (common.js) ------------------------------------------------------
let limit_f = fn (v, lo, hi) { if v < lo { lo } else if v > hi { hi } else { v } }
let interpolate = fn (a, b, percent) { a + (b - a) * percent }
let ease_in = fn (a, b, percent) { a + (b - a) * percent * percent }
let ease_out = fn (a, b, percent) { a + (b - a) * (1.0 - (1.0 - percent) * (1.0 - percent)) }
let ease_in_out = fn (a, b, percent) { a + (b - a) * ((-Math.cos(percent * Math.pi) / 2.0) + 0.5) }
let percent_remaining = fn (n, total) { (n % total) / total }
let exponential_fog = fn (distance, density) { 1.0 / Math.exp(distance * distance * density) }

let increase = fn (start, increment, max) {
  mut result = start + increment
  while result >= max { result = result - max }
  while result < 0 { result = result + max }
  result
}

# `percent` is the fraction of each width that counts as a hit (v4 passes 0.8
# for the player/car test and 1.2 for the AI steering test).
let overlap = fn (x1, w1, x2, w2, percent) {
  let half = percent / 2.0
  let min1 = x1 - w1 * half
  let max1 = x1 + w1 * half
  let min2 = x2 - w2 * half
  let max2 = x2 + w2 * half
  !((max1 < min2) || (min1 > max2))
}

# --- world -----------------------------------------------------------------
# p1/p2 are flattened into fields rather than nested objects: the projection
# loop touches ten of them per segment per frame and this is the hot path.
class Segment {
  new (index, y1, y2, curve) {
    self.index = index
    self.p1_wy = y1
    self.p1_wz = index * SEGMENT_LENGTH * 1.0
    self.p2_wy = y2
    self.p2_wz = (index + 1) * SEGMENT_LENGTH * 1.0
    self.curve = curve
    self.p1_cx = 0.0; self.p1_cy = 0.0; self.p1_cz = 0.0
    self.p1_sx = 0; self.p1_sy = 0; self.p1_sw = 0; self.p1_scale = 0.0
    self.p2_cx = 0.0; self.p2_cy = 0.0; self.p2_cz = 0.0
    self.p2_sx = 0; self.p2_sy = 0; self.p2_sw = 0; self.p2_scale = 0.0
    self.looped = false
    self.fog = 1.0
    self.clip = 0
    self.sprites = []
    self.cars = []
  }
}

class Car {
  new (offset, z, sprite, speed) {
    self.offset = offset
    self.z = z
    self.sprite = sprite     # [w, h]
    self.speed = speed
    self.percent = 0.0
    # level >= 1 tracks the same position as (segment index, offset in segment)
    # and keeps `z` only for the rare collision reads. `w` is the sprite width
    # already multiplied by SPRITE_SCALE, which the AI recomputed every frame.
    self.seg = 0
    self.zin = 0.0
    self.w = sprite[0] * SPRITE_SCALE
    self.h = sprite[1] * SPRITE_SCALE
  }
}

class Prop {
  new (source, offset) {
    self.source = source
    self.offset = offset
    self.w = source[0] * SPRITE_SCALE
    self.h = source[1] * SPRITE_SCALE
  }
}

mut segments = []
mut cars = []
mut track_length = 0.0

let last_y = fn () {
  if segments.size() == 0 { 0.0 } else { segments[segments.size() - 1].p2_wy }
}

let add_segment = fn (curve, y) {
  segments.push(Segment.new(segments.size(), last_y(), y, curve))
}

let add_road = fn (enter, hold, leave, curve, y) {
  let start_y = last_y()
  let end_y = start_y + y * SEGMENT_LENGTH * 1.0
  let total = (enter + hold + leave) * 1.0
  for n in 0..enter {
    add_segment(ease_in(0.0, curve, n / (enter * 1.0)),
                ease_in_out(start_y, end_y, n / total))
  }
  for n in 0..hold {
    add_segment(curve, ease_in_out(start_y, end_y, (enter + n) / total))
  }
  for n in 0..leave {
    add_segment(ease_in_out(curve, 0.0, n / (leave * 1.0)),
                ease_in_out(start_y, end_y, (enter + hold + n) / total))
  }
}

let L_SHORT = 25
let L_MEDIUM = 50
let L_LONG = 100
let H_LOW = 20.0
let H_MEDIUM = 40.0
let H_HIGH = 60.0
let C_EASY = 2.0
let C_MEDIUM = 4.0

let add_straight = fn (num) { add_road(num, num, num, 0.0, 0.0) }
let add_hill = fn (num, height) { add_road(num, num, num, 0.0, height) }
let add_curve = fn (num, curve, height) { add_road(num, num, num, curve, height) }

let add_low_rolling_hills = fn (num, height) {
  add_road(num, num, num, 0.0, height / 2.0)
  add_road(num, num, num, 0.0, -height)
  add_road(num, num, num, C_EASY, height)
  add_road(num, num, num, 0.0, 0.0)
  add_road(num, num, num, -C_EASY, height / 2.0)
  add_road(num, num, num, 0.0, 0.0)
}

let add_s_curves = fn () {
  add_road(L_MEDIUM, L_MEDIUM, L_MEDIUM, -C_EASY, 0.0)
  add_road(L_MEDIUM, L_MEDIUM, L_MEDIUM, C_MEDIUM, H_MEDIUM)
  add_road(L_MEDIUM, L_MEDIUM, L_MEDIUM, C_EASY, -H_LOW)
  add_road(L_MEDIUM, L_MEDIUM, L_MEDIUM, -C_EASY, H_MEDIUM)
  add_road(L_MEDIUM, L_MEDIUM, L_MEDIUM, -C_MEDIUM, -H_MEDIUM)
}

let add_bumps = fn () {
  add_road(10, 10, 10, 0.0, 5.0)
  add_road(10, 10, 10, 0.0, -2.0)
  add_road(10, 10, 10, 0.0, -5.0)
  add_road(10, 10, 10, 0.0, 8.0)
  add_road(10, 10, 10, 0.0, 5.0)
  add_road(10, 10, 10, 0.0, -7.0)
  add_road(10, 10, 10, 0.0, 5.0)
  add_road(10, 10, 10, 0.0, -2.0)
}

let add_downhill_to_end = fn (num) {
  add_road(num, num, num, -C_EASY, -last_y() / SEGMENT_LENGTH)
}

let find_segment = fn (z) { segments[Math.floor(z / SEGMENT_LENGTH) % segments.size()] }

let add_sprite = fn (n, sprite, offset) { segments[n].sprites.push(Prop.new(sprite, offset)) }

let reset_sprites = fn () {
  add_sprite(20, BILLBOARDS[6], -1.0)
  add_sprite(40, BILLBOARDS[5], -1.0)
  add_sprite(60, BILLBOARDS[7], -1.0)
  add_sprite(80, BILLBOARDS[8], -1.0)
  add_sprite(100, BILLBOARDS[0], -1.0)
  add_sprite(120, BILLBOARDS[1], -1.0)
  add_sprite(140, BILLBOARDS[2], -1.0)
  add_sprite(160, BILLBOARDS[3], -1.0)
  add_sprite(180, BILLBOARDS[4], -1.0)

  add_sprite(240, BILLBOARDS[6], -1.2)
  add_sprite(240, BILLBOARDS[5], 1.2)
  add_sprite(segments.size() - 25, BILLBOARDS[6], -1.2)
  add_sprite(segments.size() - 25, BILLBOARDS[5], 1.2)

  mut n = 10
  while n < 200 {
    add_sprite(n, PALM_TREE, 0.5 + Random.uniform(0.0, 0.5))
    add_sprite(n, PALM_TREE, 1.0 + Random.uniform(0.0, 2.0))
    n = n + 4 + n / 100
  }

  n = 250
  while n < 1000 {
    add_sprite(n, COLUMN, 1.1)
    add_sprite(n + Random.int(0, 6), TREE1, -1.0 - Random.uniform(0.0, 2.0))
    add_sprite(n + Random.int(0, 6), TREE2, -1.0 - Random.uniform(0.0, 2.0))
    n = n + 5
  }

  n = 200
  while n < segments.size() {
    let side = if Random.int(0, 2) == 0 { 1.0 } else { -1.0 }
    add_sprite(n, PLANTS[Random.int(0, PLANTS.size())], side * (2.0 + Random.uniform(0.0, 5.0)))
    n = n + 3
  }

  n = 1000
  while n < segments.size() - 50 {
    let side = if Random.int(0, 2) == 0 { 1.0 } else { -1.0 }
    add_sprite(n + Random.int(0, 51), BILLBOARDS[Random.int(0, BILLBOARDS.size())], -side)
    for _ in 0..20 {
      add_sprite(n + Random.int(0, 51), PLANTS[Random.int(0, PLANTS.size())],
                 side * (1.5 + Random.uniform(0.0, 1.0)))
    }
    n = n + 100
  }
}

mut total_cars = TOTAL_CARS

let reset_cars = fn () {
  cars = []
  for _ in 0..total_cars {
    let side = if Random.int(0, 2) == 0 { -0.8 } else { 0.8 }
    let offset = Random.uniform(0.0, 1.0) * side
    let z = Random.int(0, segments.size()) * SEGMENT_LENGTH * 1.0
    let idx = Random.int(0, CAR_SPRITES.size())
    let spread = if idx == SEMI_INDEX { 4.0 } else { 2.0 }
    let speed = MAX_SPEED / 4.0 + Random.uniform(0.0, MAX_SPEED / spread)
    let car = Car.new(offset, z, CAR_SPRITES[idx], speed)
    let segment = find_segment(car.z)
    car.seg = segment.index
    car.zin = car.z - segment.index * SEGMENT_LENGTH * 1.0
    segment.cars.push(car)
    cars.push(car)
  }
}

let reset_road = fn () {
  segments = []
  add_straight(L_SHORT)
  add_low_rolling_hills(L_SHORT, H_LOW)
  add_s_curves()
  add_curve(L_MEDIUM, C_MEDIUM, H_LOW)
  add_bumps()
  add_low_rolling_hills(L_SHORT, H_LOW)
  add_curve(L_LONG * 2, C_MEDIUM, H_MEDIUM)
  add_straight(L_MEDIUM)
  add_hill(L_MEDIUM, H_HIGH)
  add_s_curves()
  add_curve(L_LONG, -C_MEDIUM, 0.0)
  add_hill(L_LONG, H_HIGH)
  add_curve(L_LONG, C_MEDIUM, -H_LOW)
  add_bumps()
  add_hill(L_LONG, -H_MEDIUM)
  add_straight(L_MEDIUM)
  add_s_curves()
  add_downhill_to_end(200)

  reset_sprites()
  reset_cars()
  track_length = segments.size() * SEGMENT_LENGTH * 1.0
}

# --- game state ------------------------------------------------------------
mut width = 640
mut height = 480
mut draw_distance = 300
mut position = 0.0
mut speed = 0.0
mut player_x = 0.0
mut sky_offset = 0.0
mut hill_offset = 0.0
mut tree_offset = 0.0
# synthetic input for the benchmark: hold accelerate, weave left/right so the
# curve/centrifugal and off-road branches all get exercised
mut key_left = false
mut key_right = false
# how many segments behind the player still get AI steering. -1 selects v4's
# original forward-only test (see update_car_offset).
mut ai_lookbehind = -1
# which stack of rewrites is active (see the header)
mut opt_level = 0
mut use_probe = false

# --- update ----------------------------------------------------------------
mut scans = 0        # lookahead segment visits, to check the skip actually fires
mut skips = 0
mut culled = 0       # segments the hill clip drops — v4 `continue`s over these

let update_car_offset = fn (car, car_segment, player_segment, player_w) {
  let car_w = car.sprite[0] * SPRITE_SCALE
  if ai_lookbehind < 0 {
    # v4 as written: the test is signed, so it only skips cars *ahead* of the
    # player. Everything behind — almost the whole field — still scans.
    if (car_segment.index - player_segment.index) > draw_distance { skips = skips + 1; return 0.0 }
  } else {
    # circular window: drawDistance ahead plus ai_lookbehind behind, so a car
    # that is about to overtake the player is still steering when it appears.
    let n = segments.size()
    let ahead = (car_segment.index - player_segment.index + n) % n
    if ahead > draw_distance && ahead < n - ai_lookbehind { skips = skips + 1; return 0.0 }
  }

  for i in 1..LOOKAHEAD {
    scans = scans + 1
    let segment = segments[(car_segment.index + i) % segments.size()]

    if segment.index == player_segment.index && car.speed > speed &&
       overlap(player_x, player_w, car.offset, car_w, 1.2) {
      let dir = if player_x > 0.5 { -1.0 }
                else if player_x < -0.5 { 1.0 }
                else if car.offset > player_x { 1.0 } else { -1.0 }
      return dir * (1.0 / i) * (car.speed - speed) / MAX_SPEED
    }

    for other in segment.cars {
      let other_w = other.sprite[0] * SPRITE_SCALE
      if car.speed > other.speed && overlap(car.offset, car_w, other.offset, other_w, 1.2) {
        let dir = if other.offset > 0.5 { -1.0 }
                  else if other.offset < -0.5 { 1.0 }
                  else if car.offset > other.offset { 1.0 } else { -1.0 }
        return dir * (1.0 / i) * (car.speed - other.speed) / MAX_SPEED
      }
    }
  }

  if car.offset < -0.9 { 0.1 } else if car.offset > 0.9 { -0.1 } else { 0.0 }
}

# v4 splices the car out of its old segment; order inside a segment is not
# observable (they are all drawn in the same z band), so swap-pop is enough.
let remove_car = fn (list, car) {
  let i = list.index_of(car)
  if i >= 0 {
    list[i] = list[list.size() - 1]
    list.pop()
  }
}

let update_cars = fn (dt, player_segment, player_w) {
  for car in cars {
    let old_segment = find_segment(car.z)
    car.offset = car.offset + update_car_offset(car, old_segment, player_segment, player_w)
    car.z = increase(car.z, dt * car.speed, track_length)
    car.percent = percent_remaining(car.z, SEGMENT_LENGTH * 1.0)
    let new_segment = find_segment(car.z)
    if old_segment.index != new_segment.index {
      remove_car(old_segment.cars, car)
      new_segment.cars.push(car)
    }
  }
}

# --- level 1: per-car segment cursor ---------------------------------------
# The car's position is (seg, zin) instead of a track-absolute z. Advancing it
# is one add and at most one carry, because a car covers less than a segment
# per frame: the fastest AI speed is 0.75*MAX_SPEED and MAX_SPEED*STEP is
# exactly one SEGMENT_LENGTH. That removes both find_segment calls (each of
# which is a call plus a Math.floor plus a modulo), increase() and
# percent_remaining() from the per-car path.
#
# The overlap tests are inlined as a distance-vs-summed-half-widths compare,
# which is the same predicate with fewer statements but not bit-identical
# rounding at the exact boundary.

let update_car_offset_fast = fn (car, car_index, player_index, n, player_half) {
  let ahead = (car_index - player_index + n) % n
  if ahead > draw_distance && ahead < n - ai_lookbehind { skips = skips + 1; return 0.0 }

  let car_w = car.w
  let offset = car.offset
  let car_speed = car.speed
  mut i = 1
  while i < LOOKAHEAD {
    scans = scans + 1
    mut si = car_index + i
    if si >= n { si = si - n }
    let segment = segments[si]

    if si == player_index && car_speed > speed {
      let lim = player_half + car_w * 0.6
      let d = player_x - offset
      if d >= -lim && d <= lim {
        let dir = if player_x > 0.5 { -1.0 }
                  else if player_x < -0.5 { 1.0 }
                  else if offset > player_x { 1.0 } else { -1.0 }
        return dir * (1.0 / i) * (car_speed - speed) / MAX_SPEED
      }
    }

    for other in segment.cars {
      if car_speed > other.speed {
        let lim = (car_w + other.w) * 0.6
        let d = offset - other.offset
        if d >= -lim && d <= lim {
          let dir = if other.offset > 0.5 { -1.0 }
                    else if other.offset < -0.5 { 1.0 }
                    else if offset > other.offset { 1.0 } else { -1.0 }
          return dir * (1.0 / i) * (car_speed - other.speed) / MAX_SPEED
        }
      }
    }
    i = i + 1
  }

  if offset < -0.9 { 0.1 } else if offset > 0.9 { -0.1 } else { 0.0 }
}

# --- level 3: no control-flow exceptions ------------------------------------
# `return`, `break` and `continue` are C++ exceptions in the interpreter
# (interpreter.h: `throw ReturnValue{...}`, BreakSignal, ContinueSignal), so
# every early exit costs an unwind. The AI takes one per car per frame — 190 of
# the 200 cars leave through the window test. This version computes the same
# answer with a `done` flag and no early exit anywhere.
let update_car_offset_free = fn (car, car_index, player_index, n, player_half) {
  let ahead = (car_index - player_index + n) % n
  mut result = 0.0
  if ahead > draw_distance && ahead < n - ai_lookbehind {
    skips = skips + 1
  } else {
    let car_w = car.w
    let offset = car.offset
    let car_speed = car.speed
    mut done = false
    mut i = 1
    while !done && i < LOOKAHEAD {
      scans = scans + 1
      mut si = car_index + i
      if si >= n { si = si - n }
      let segment = segments[si]

      if si == player_index && car_speed > speed {
        let lim = player_half + car_w * 0.6
        let d = player_x - offset
        if d >= -lim && d <= lim {
          let dir = if player_x > 0.5 { -1.0 }
                    else if player_x < -0.5 { 1.0 }
                    else if offset > player_x { 1.0 } else { -1.0 }
          result = dir * (1.0 / i) * (car_speed - speed) / MAX_SPEED
          done = true
        }
      }

      if !done {
        let list = segment.cars
        let m = list.size()
        mut j = 0
        while !done && j < m {
          let other = list[j]
          if car_speed > other.speed {
            let lim = (car_w + other.w) * 0.6
            let d = offset - other.offset
            if d >= -lim && d <= lim {
              let dir = if other.offset > 0.5 { -1.0 }
                        else if other.offset < -0.5 { 1.0 }
                        else if offset > other.offset { 1.0 } else { -1.0 }
              result = dir * (1.0 / i) * (car_speed - other.speed) / MAX_SPEED
              done = true
            }
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    if !done {
      if offset < -0.9 { result = 0.1 } else if offset > 0.9 { result = -0.1 }
    }
  }
  result
}

let update_cars_fast = fn (dt, player_index, player_half) {
  let n = segments.size()
  let seg_len = SEGMENT_LENGTH * 1.0
  let flow_free = opt_level >= 3
  for car in cars {
    let old_index = car.seg
    if flow_free {
      car.offset = car.offset + update_car_offset_free(car, old_index, player_index, n, player_half)
    } else {
      car.offset = car.offset + update_car_offset_fast(car, old_index, player_index, n, player_half)
    }
    mut zin = car.zin + dt * car.speed
    if zin >= seg_len {
      zin = zin - seg_len
      mut ni = old_index + 1
      if ni >= n { ni = 0 }
      car.seg = ni
      remove_car(segments[old_index].cars, car)
      segments[ni].cars.push(car)
    }
    car.zin = zin
    car.percent = zin / seg_len
    car.z = car.seg * seg_len + zin
  }
}

let update = fn (dt) {
  let player_segment = find_segment(position + PLAYER_Z)
  let speed_percent = speed / MAX_SPEED
  let dx = dt * 2.0 * speed_percent
  let start_position = position

  if use_probe {
    update_cars_probe(dt, player_segment.index, PLAYER_W * 0.6)
  } else if opt_level >= 1 {
    update_cars_fast(dt, player_segment.index, PLAYER_W * 0.6)
  } else {
    update_cars(dt, player_segment, PLAYER_W)
  }

  position = increase(position, dt * speed, track_length)

  if key_left { player_x = player_x - dx }
  else if key_right { player_x = player_x + dx }
  player_x = player_x - (dx * speed_percent * player_segment.curve * CENTRIFUGAL)

  speed = speed + ACCEL * dt          # the benchmark always accelerates

  if player_x < -1.0 || player_x > 1.0 {
    if speed > OFF_ROAD_LIMIT { speed = speed + OFF_ROAD_DECEL * dt }
    for prop in player_segment.sprites {
      let prop_w = prop.source[0] * SPRITE_SCALE
      let side = if prop.offset > 0.0 { 1.0 } else { -1.0 }
      if overlap(player_x, PLAYER_W, prop.offset + prop_w / 2.0 * side, prop_w, 1.0) {
        speed = MAX_SPEED / 5.0
        position = increase(player_segment.p1_wz, -PLAYER_Z, track_length)
        break
      }
    }
  }

  for car in player_segment.cars {
    let car_w = car.sprite[0] * SPRITE_SCALE
    if speed > car.speed && overlap(player_x, PLAYER_W, car.offset, car_w, 0.8) {
      speed = car.speed * (car.speed / speed)
      position = increase(car.z, -PLAYER_Z, track_length)
      break
    }
  }

  player_x = limit_f(player_x, -3.0, 3.0)
  speed = limit_f(speed, 0.0, MAX_SPEED)

  let scroll = player_segment.curve * (position - start_position) / SEGMENT_LENGTH
  sky_offset = increase(sky_offset, SKY_SPEED * scroll, 1.0)
  hill_offset = increase(hill_offset, HILL_SPEED * scroll, 1.0)
  tree_offset = increase(tree_offset, TREE_SPEED * scroll, 1.0)
}

# --- render (arithmetic only; every draw call removed) ----------------------
# `sink` accumulates what the draw calls would have consumed so nothing can be
# optimised away, and so the segment/sprite counts are reportable.
mut sink = 0.0

let project = fn (segment, first, camera_x, camera_y, camera_z) {
  if first {
    let cx = -camera_x
    let cy = segment.p1_wy - camera_y
    let cz = segment.p1_wz - camera_z
    let scale = CAMERA_DEPTH / cz
    segment.p1_cx = cx; segment.p1_cy = cy; segment.p1_cz = cz
    segment.p1_scale = scale
    segment.p1_sx = Math.round((width / 2.0) + (scale * cx * width / 2.0))
    segment.p1_sy = Math.round((height / 2.0) - (scale * cy * height / 2.0))
    segment.p1_sw = Math.round(scale * ROAD_WIDTH * width / 2.0)
  } else {
    let cx = -camera_x
    let cy = segment.p2_wy - camera_y
    let cz = segment.p2_wz - camera_z
    let scale = CAMERA_DEPTH / cz
    segment.p2_cx = cx; segment.p2_cy = cy; segment.p2_cz = cz
    segment.p2_scale = scale
    segment.p2_sx = Math.round((width / 2.0) + (scale * cx * width / 2.0))
    segment.p2_sy = Math.round((height / 2.0) - (scale * cy * height / 2.0))
    segment.p2_sw = Math.round(scale * ROAD_WIDTH * width / 2.0)
  }
}

let render = fn () {
  let base_segment = find_segment(position)
  let base_percent = percent_remaining(position, SEGMENT_LENGTH * 1.0)
  let player_segment = find_segment(position + PLAYER_Z)
  let player_percent = percent_remaining(position + PLAYER_Z, SEGMENT_LENGTH * 1.0)
  let player_y = interpolate(player_segment.p1_wy, player_segment.p2_wy, player_percent)
  mut maxy = height
  mut x = 0.0
  mut dx = -(base_segment.curve * base_percent)
  let n_segments = segments.size()

  for n in 0..draw_distance {
    let segment = segments[(base_segment.index + n) % n_segments]
    segment.looped = segment.index < base_segment.index
    segment.fog = exponential_fog(n / (draw_distance * 1.0), FOG_DENSITY)
    segment.clip = maxy

    let camera_z = position - (if segment.looped { track_length } else { 0.0 })
    let camera_y = player_y + CAMERA_HEIGHT
    project(segment, true, (player_x * ROAD_WIDTH) - x, camera_y, camera_z)
    project(segment, false, (player_x * ROAD_WIDTH) - x - dx, camera_y, camera_z)

    x = x + dx
    dx = dx + segment.curve

    if segment.p1_cz <= CAMERA_DEPTH || segment.p2_sy >= segment.p1_sy || segment.p2_sy >= maxy {
      continue
    }

    # Render.segment() would fire here: grass rect + 2 rumble + road + lanes.
    sink = sink + segment.p1_sy + segment.p2_sy + segment.p1_sw
    maxy = segment.p1_sy
  }

  mut n = draw_distance - 1
  while n > 0 {
    let segment = segments[(base_segment.index + n) % n_segments]

    for car in segment.cars {
      let scale = interpolate(segment.p1_scale, segment.p2_scale, car.percent)
      let sx = interpolate(segment.p1_sx * 1.0, segment.p2_sx * 1.0, car.percent) +
               (scale * car.offset * ROAD_WIDTH * width / 2.0)
      let sy = interpolate(segment.p1_sy * 1.0, segment.p2_sy * 1.0, car.percent)
      # Render.sprite(): destW/destH, the -0.5/-1 anchor and the hill clip
      let dw = (car.sprite[0] * scale * width / 2.0) * (SPRITE_SCALE * ROAD_WIDTH)
      let dh = (car.sprite[1] * scale * width / 2.0) * (SPRITE_SCALE * ROAD_WIDTH)
      let dxp = sx - dw * 0.5
      let dyp = sy - dh
      let clip_h = Math.max(0.0, dyp + dh - segment.clip)
      if clip_h < dh { sink = sink + Math.floor(dxp) + Math.floor(dyp) }
    }

    for prop in segment.sprites {
      let scale = segment.p1_scale
      let sx = segment.p1_sx + (scale * prop.offset * ROAD_WIDTH * width / 2.0)
      let sy = segment.p1_sy * 1.0
      let dw = (prop.source[0] * scale * width / 2.0) * (SPRITE_SCALE * ROAD_WIDTH)
      let dh = (prop.source[1] * scale * width / 2.0) * (SPRITE_SCALE * ROAD_WIDTH)
      let dxp = sx + (if prop.offset < 0.0 { -dw } else { 0.0 })
      let dyp = sy - dh
      let clip_h = Math.max(0.0, dyp + dh - segment.clip)
      if clip_h < dh { sink = sink + Math.floor(dxp) + Math.floor(dyp) }
    }

    if segment.index == player_segment.index {
      let scale = CAMERA_DEPTH / PLAYER_Z
      let cy = interpolate(player_segment.p1_wy - (player_y + CAMERA_HEIGHT),
                           player_segment.p2_wy - (player_y + CAMERA_HEIGHT), player_percent)
      let dyp = (height / 2.0) - (scale * cy * height / 2.0)
      sink = sink + Math.floor(dyp)
    }

    n = n - 1
  }
}

# --- probe: what is update_cars actually spending its time on? --------------
# Level 1 still costs ~39 us per car per frame while the statement-level
# calibration (ops.cul) says the body should be around 4 us. This variant drops
# one piece at a time — the results are wrong on purpose, it only exists to
# price the pieces.
#   0 full   1 no segment hand-off   2 no AI call   3 neither   4 loop only
#   5 AI call replaced by an empty function (prices the call itself)
#   6 AI call replaced by the window test alone (adds the global reads)
mut probe = 0

let ai_noop = fn (car, car_index, player_index, n, player_half) { 0.0 }

let ai_window_only = fn (car, car_index, player_index, n, player_half) {
  let ahead = (car_index - player_index + n) % n
  if ahead > draw_distance && ahead < n - ai_lookbehind { skips = skips + 1; return 0.0 }
  0.0
}

# 7 and 8 split the window test's two suspects: the early `return`, and the
# reads of the top-level mutable state (draw_distance / ai_lookbehind / skips).
let ai_window_noreturn = fn (car, car_index, player_index, n, player_half) {
  let ahead = (car_index - player_index + n) % n
  if ahead > draw_distance && ahead < n - ai_lookbehind { skips = skips + 1; 0.0 } else { 0.0 }
}

let ai_window_locals = fn (car_index, player_index, n, dd, lb) {
  let ahead = (car_index - player_index + n) % n
  if ahead > dd && ahead < n - lb { return 0.0 }
  0.0
}

let update_cars_probe = fn (dt, player_index, player_half) {
  let n = segments.size()
  let seg_len = SEGMENT_LENGTH * 1.0
  let dd = draw_distance
  let lb = ai_lookbehind
  let do_ai = probe == 0 || probe == 1
  let do_move = probe != 1 && probe != 3
  let loop_only = probe == 4
  for car in cars {
    if loop_only { continue }
    let old_index = car.seg
    if do_ai {
      car.offset = car.offset + update_car_offset_fast(car, old_index, player_index, n, player_half)
    } else if probe == 5 {
      car.offset = car.offset + ai_noop(car, old_index, player_index, n, player_half)
    } else if probe == 6 {
      car.offset = car.offset + ai_window_only(car, old_index, player_index, n, player_half)
    } else if probe == 7 {
      car.offset = car.offset + ai_window_noreturn(car, old_index, player_index, n, player_half)
    } else if probe == 8 {
      car.offset = car.offset + ai_window_locals(old_index, player_index, n, dd, lb)
    }
    mut zin = car.zin + dt * car.speed
    if zin >= seg_len {
      zin = zin - seg_len
      mut ni = old_index + 1
      if ni >= n { ni = 0 }
      car.seg = ni
      if do_move {
        remove_car(segments[old_index].cars, car)
        segments[ni].cars.push(car)
      }
    }
    car.zin = zin
    car.percent = zin / seg_len
    car.z = car.seg * seg_len + zin
  }
}

# --- level 2: inlined render -----------------------------------------------
# Same projection, written for an interpreter that charges per statement and
# per call: project() unrolled, for -> while, the segment index advanced by an
# add plus a wrap test instead of a modulo, the loop-invariant camera terms
# hoisted, and the per-n fog precomputed (it only depends on n/drawDistance).
#
# Screen coordinates stay floats. v4 rounds them because the canvas API takes
# whatever it is given; if the Canvas primitives take doubles and round inside,
# the six Math.round per segment plus the Math.floor per sprite disappear from
# the culebra side. That is what this level prices, and it is why its sink
# differs from level 0/1.
mut fog_table = []

let build_fog_table = fn () {
  fog_table = []
  for n in 0..draw_distance {
    fog_table.push(exponential_fog(n / (draw_distance * 1.0), FOG_DENSITY))
  }
}

let render_fast = fn () {
  let n_segments = segments.size()
  let base_segment = find_segment(position)
  let base_index = base_segment.index
  let base_percent = percent_remaining(position, SEGMENT_LENGTH * 1.0)
  let player_segment = find_segment(position + PLAYER_Z)
  let player_index = player_segment.index
  let player_percent = percent_remaining(position + PLAYER_Z, SEGMENT_LENGTH * 1.0)
  let player_y = player_segment.p1_wy +
                 (player_segment.p2_wy - player_segment.p1_wy) * player_percent
  let camera_y = player_y + CAMERA_HEIGHT
  let w2 = width / 2.0
  let h2 = height / 2.0
  let sw_k = ROAD_WIDTH * w2
  let px_road = player_x * ROAD_WIDTH
  let cz_here = position
  let cz_looped = position - track_length

  mut maxy = height * 1.0
  mut x = 0.0
  mut dx = -(base_segment.curve * base_percent)
  mut n = 0
  mut si = base_index
  while n < draw_distance {
    let segment = segments[si]
    let looped = si < base_index
    segment.looped = looped
    segment.fog = fog_table[n]
    segment.clip = maxy
    let camera_z = if looped { cz_looped } else { cz_here }

    let cz1 = segment.p1_wz - camera_z
    let scale1 = CAMERA_DEPTH / cz1
    let sy1 = h2 - scale1 * (segment.p1_wy - camera_y) * h2
    segment.p1_cz = cz1
    segment.p1_scale = scale1
    segment.p1_sx = w2 + scale1 * (x - px_road) * w2
    segment.p1_sy = sy1
    segment.p1_sw = scale1 * sw_k

    let cz2 = segment.p2_wz - camera_z
    let scale2 = CAMERA_DEPTH / cz2
    let sy2 = h2 - scale2 * (segment.p2_wy - camera_y) * h2
    segment.p2_scale = scale2
    segment.p2_sx = w2 + scale2 * (x + dx - px_road) * w2
    segment.p2_sy = sy2
    segment.p2_sw = scale2 * sw_k

    x = x + dx
    dx = dx + segment.curve
    si = si + 1
    if si >= n_segments { si = 0 }
    n = n + 1

    # v4 `continue`s over a culled segment. `continue` is a C++ exception in
    # the interpreter, and roughly half the window is culled by the hill clip,
    # so the test is inverted instead.
    if cz1 > CAMERA_DEPTH && sy2 < sy1 && sy2 < maxy {
      sink = sink + sy1 + sy2 + segment.p1_sw
      maxy = sy1
    } else {
      culled = culled + 1
    }
  }

  # back to front over the same window. `clip_h < dh` reduces to `dyp < clip`
  # (clip_h is max(0, dyp+dh-clip) and dh > 0), so Math.max goes too.
  let player_scale = CAMERA_DEPTH / PLAYER_Z
  mut m = draw_distance - 1
  mut mi = base_index + m
  while mi >= n_segments { mi = mi - n_segments }
  while m > 0 {
    let segment = segments[mi]
    let s1x = segment.p1_sx
    let s1y = segment.p1_sy
    let s1s = segment.p1_scale
    let clip = segment.clip

    for car in segment.cars {
      let pc = car.percent
      let scale = s1s + (segment.p2_scale - s1s) * pc
      let k = scale * sw_k
      let dh = car.h * k
      let dyp = s1y + (segment.p2_sy - s1y) * pc - dh
      if dyp < clip {
        let sx = s1x + (segment.p2_sx - s1x) * pc + scale * car.offset * sw_k
        sink = sink + (sx - car.w * k * 0.5) + dyp
      }
    }

    let pk = s1s * sw_k
    for prop in segment.sprites {
      let dh = prop.h * pk
      let dyp = s1y - dh
      if dyp < clip {
        let sx = s1x + s1s * prop.offset * sw_k
        sink = sink + (if prop.offset < 0.0 { sx - prop.w * pk } else { sx }) + dyp
      }
    }

    if mi == player_index {
      let cy = (player_segment.p1_wy - camera_y) +
               ((player_segment.p2_wy - camera_y) - (player_segment.p1_wy - camera_y)) *
               player_percent
      sink = sink + (h2 - player_scale * cy * h2)
    }

    m = m - 1
    mi = mi - 1
    if mi < 0 { mi = n_segments - 1 }
  }
}

# --- benchmark -------------------------------------------------------------
# v4's AI early-out test is signed: it skips a car when its segment index is
# more than drawDistance *greater* than the player's. How much of the field
# that covers therefore depends on where the player is on the track — nearly
# all of it at the start line, none of it at the finish. So the benchmark has
# to sweep the player's position, not start every run at zero.
let clear_cars = fn () {
  for segment in segments { segment.cars = [] }
}

let bench = fn (w, h, dd, frames, start_frac) {
  width = w
  height = h
  draw_distance = dd
  build_fog_table()
  speed = MAX_SPEED / 2.0
  player_x = 0.0
  clear_cars()
  Random.seed(2)
  reset_cars()
  sink = 0.0
  # +0.1 keeps the camera off an exact segment boundary. JS gets Infinity from
  # cameraDepth/0 there and culls it a line later; culebra raises
  # ZeroDivisionError, so the port has to cull *before* it divides.
  position = track_length * start_frac + 0.1

  # warm up: two frames so the JIT has compiled and the caches are hot
  let fast_render = opt_level >= 2
  update(STEP)
  if fast_render { render_fast() } else { render() }
  update(STEP)
  if fast_render { render_fast() } else { render() }

  # Other sessions on this machine can steal most of the CPU, so take the best
  # of REPS runs rather than a mean — contention only ever adds time.
  scans = 0
  skips = 0
  culled = 0
  mut best_update = 1e9
  mut best_render = 1e9
  mut rep = 0
  while rep < REPS {
    let t_u = Time.monotonic()
    for i in 0..frames {
      key_left = (i / 20) % 2 == 0
      key_right = !key_left
      update(STEP)
    }
    let u = (Time.monotonic() - t_u) * 1000.0 / frames
    if u < best_update { best_update = u }

    let t_r = Time.monotonic()
    if fast_render {
      for _ in 0..frames { render_fast() }
    } else {
      for _ in 0..frames { render() }
    }
    let r = (Time.monotonic() - t_r) * 1000.0 / frames
    if r < best_render { best_render = r }
    rep = rep + 1
  }

  {
    update_ms: best_update,
    render_ms: best_render,
    scans: scans / (frames * REPS),
    skips: skips / (frames * REPS),
    culled: culled / (frames * REPS),
    sink: sink,
  }
}

let pad = fn (s, n) {
  mut out = to_string(s)
  while out.size() < n { out = " " + out }
  out
}
let ms = fn (v) { pad("{v:.2f}", 8) }

Random.seed(1)
let t_build = Time.monotonic()
reset_road()
println("track: {segments.size()} segments, {cars.size()} cars, " +
        "build {(Time.monotonic() - t_build) * 1000.0:.0f} ms")
println("")
let frames = if QUICK { 10 } else { 20 }
let W = 640
let H = 480

# A. what each level costs at the faithful settings. The player position still
# has to be swept: the AI window's work depends on how many cars sit inside it.
ai_lookbehind = 100
println("A. ms/frame at 640x480, dd=300, 200 cars, AI window (behind=100)")
println("  level         lap 0%     25%      50%      75%      95%    sink(50%)")
mut culled_per_frame = 0
for lv in [0, 1, 2, 3] {
  opt_level = lv
  mut urow = pad("L{lv} update", 12)
  mut rrow = pad("   render", 12)
  mut trow = pad("   TOTAL", 12)
  mut mid_sink = 0.0
  for frac in if QUICK { [0.5] } else { [0.0, 0.25, 0.5, 0.75, 0.95] } {
    let r = bench(W, H, 300, frames, frac)
    urow = urow + ms(r.update_ms)
    rrow = rrow + ms(r.render_ms)
    trow = trow + ms(r.update_ms + r.render_ms)
    if frac == 0.5 { mid_sink = r.sink; culled_per_frame = r.culled }
  }
  println(urow)
  println(rrow)
  println(trow + pad("{mid_sink:.0f}", 14))
}
println("   (of the {draw_distance} projected segments, {culled_per_frame} are culled — v4 would")
println("    `continue` over each one, and `continue` is a C++ exception too)")

# B. how the best level scales with drawDistance, in case the shared default
# has to come down (v4's tweak UI covers 100..500, so anything in that band is
# still a faithful setting).
println("")
println("B. ms/frame by drawDistance at the best level (player at 50%)")
println("      dd        300      200      150      100       50")
opt_level = 3
mut brow_u = pad("update", 12)
mut brow_r = pad("render", 12)
mut brow_t = pad("TOTAL", 12)
for dd in [300, 200, 150, 100, 50] {
  let r = bench(W, H, dd, frames, 0.5)
  brow_u = brow_u + ms(r.update_ms)
  brow_r = brow_r + ms(r.render_ms)
  brow_t = brow_t + ms(r.update_ms + r.render_ms)
}
println(brow_u)
println(brow_r)
println(brow_t)

# C. and with the size of the field, which is what sets update's floor.
println("")
println("C. ms/frame by totalCars at the best level (dd=300, player at 50%)")
println("    cars        200      100       50       20")
mut crow_u = pad("update", 12)
mut crow_t = pad("TOTAL", 12)
for n in [200, 100, 50, 20] {
  total_cars = n
  let r = bench(W, H, 300, frames, 0.5)
  crow_u = crow_u + ms(r.update_ms)
  crow_t = crow_t + ms(r.update_ms + r.render_ms)
}
total_cars = TOTAL_CARS
println(crow_u)
println(crow_t)

# D. where update's per-car cost actually goes (wrong results by construction —
# each column drops one piece of the body).
println("")
println("D. update ms/frame with pieces of the per-car body removed (dd=300, 50%)")
println("           full  no-hand-off  no-AI-call  neither  loop-only  AI:empty  AI:window  AI:no-return  AI:locals")
opt_level = 1
use_probe = true
mut drow = pad("update", 11)
for p in [0, 1, 2, 3, 4, 5, 6, 7, 8] {
  probe = p
  drow = drow + ms(bench(W, H, 300, frames, 0.5).update_ms) + "  "
}
use_probe = false
println(drow)
