# How much of the ~900 ns is the loop itself vs each statement in the body?
let N = 200000
let t = fn (label, body) {
  let t0 = Time.monotonic()
  body()
  println("{label:<22}{(Time.monotonic() - t0) * 1e9 / N:8.1f} ns/iter")
}

t("empty for", fn () { for _ in 0..N { } })
t("1 stmt", fn () { mut s = 0.0; for _ in 0..N { s = s + 1.0 }; s })
t("2 stmts", fn () { mut s = 0.0; for _ in 0..N { s = s + 1.0; s = s + 1.0 }; s })
t("4 stmts", fn () { mut s = 0.0; for _ in 0..N { s = s + 1.0; s = s + 1.0; s = s + 1.0; s = s + 1.0 }; s })
t("8 stmts", fn () {
  mut s = 0.0
  for _ in 0..N {
    s = s + 1.0; s = s + 1.0; s = s + 1.0; s = s + 1.0
    s = s + 1.0; s = s + 1.0; s = s + 1.0; s = s + 1.0
  }
  s
})
