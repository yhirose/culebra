# The fill spike showed ~6 us per Canvas.rect call — far more than the pixels
# cost. Where does it go: the preamble wrapper, or the primitive itself?
# Decides whether the render loop should call `_Canvas.*` directly.

let N = 20000
_Canvas.init(320, 240)
let col = Canvas.rgba(200, 100, 100)

let t = fn (label, body) {
  body()
  let t0 = Time.monotonic()
  body()
  println("{label:<30}{(Time.monotonic() - t0) * 1e9 / N:9.0f} ns/call")
}

t("empty while loop", fn () { mut i = 0; while i < N { i = i + 1 } })
t("user fn call", fn () { let f = fn (a, b, c, d, e) { a }; mut i = 0; while i < N { f(1, 2, 3, 4, 5); i = i + 1 } })
t("_Canvas.rect (prim, 1px)", fn () { mut i = 0; while i < N { _Canvas.rect(0, 0, 1, 1, col); i = i + 1 } })
t("Canvas.rect (wrapper, 1px)", fn () { mut i = 0; while i < N { Canvas.rect(0, 0, 1, 1, col); i = i + 1 } })
t("_Canvas.rect (prim, 320x2)", fn () { mut i = 0; while i < N { _Canvas.rect(0, 0, 320, 2, col); i = i + 1 } })
t("_Canvas.set_pixel", fn () { mut i = 0; while i < N { _Canvas.set_pixel(0, 0, col); i = i + 1 } })
