# What does the interpreter charge per elementary operation?
# Calibrates the racer spike: tells us whether the hot loops are dominated by
# arithmetic, by property lookup, by array indexing or by call overhead, and
# therefore which rewrite is worth doing.

let N = 200000

class P {
  new () { self.a = 1.0; self.b = 2.0; self.c = 3.0 }
  get_a () { self.a }
}

let obj = { a: 1.0, b: 2.0, c: 3.0 }
let arr = [1.0, 2.0, 3.0]
let p = P.new()
let f = fn (x) { x }

let time_it = fn (label, body) {
  let t = Time.monotonic()
  body()
  let ns = (Time.monotonic() - t) * 1e9 / N
  println("{label:<26}{ns:8.1f} ns/iter")
}

# baseline: the loop itself plus one float add
time_it("loop + add", fn () {
  mut s = 0.0
  for _ in 0..N { s = s + 1.0 }
  s
})

time_it("+ class field read", fn () {
  mut s = 0.0
  for _ in 0..N { s = s + p.a }
  s
})

time_it("+ class field write", fn () {
  for _ in 0..N { p.b = 1.0 }
})

time_it("+ object property read", fn () {
  mut s = 0.0
  for _ in 0..N { s = s + obj.a }
  s
})

time_it("+ array index read", fn () {
  mut s = 0.0
  for _ in 0..N { s = s + arr[0] }
  s
})

time_it("+ local read", fn () {
  let a = 1.0
  mut s = 0.0
  for _ in 0..N { s = s + a }
  s
})

time_it("+ method call", fn () {
  mut s = 0.0
  for _ in 0..N { s = s + p.get_a() }
  s
})

time_it("+ function call", fn () {
  mut s = 0.0
  for _ in 0..N { s = s + f(1.0) }
  s
})

time_it("+ Math.floor", fn () {
  mut s = 0
  for _ in 0..N { s = s + Math.floor(1.5) }
  s
})

time_it("+ int modulo", fn () {
  mut s = 0
  for i in 0..N { s = s + i % 7 }
  s
})

time_it("+ 4 float mul/add", fn () {
  mut s = 0.0
  for _ in 0..N { s = s + 1.0 * 2.0 + 3.0 * 4.0 }
  s
})
