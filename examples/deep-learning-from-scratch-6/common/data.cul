# Reading and writing the corpora, in upstream's own formats.
#
# A tokenized corpus is a flat run of little-endian `uint16` -- what
# `np.fromfile(dtype=np.uint16)` reads and `ndarray.tofile` writes. Culebra
# Strings hold arbitrary bytes, so `FS.read` + `s.bytes()` is the whole
# reader.
#
# Both loops stay loops. `.chunks(2).map(...)` and `.flat_map(...)` read
# better but allocate a small Array per token, and at the size of the full
# corpus that shows: 2.68M tokens, best of 3, release build -- read 0.370 s
# for the loop against 0.519 s for `chunks`, write 0.348 s against 0.515 s
# for `flat_map`.

fn read_bin_u16(path) {
  let bytes = FS.read(path).bytes().collect()
  if bytes.size() % 2 != 0 {
    throw {
      kind: "ValueError",
      message: "{path}: {bytes.size()} bytes is not a uint16 stream",
    }
  }
  mut tokens = []
  for i in 0..bytes.size() / 2 {
    tokens.push(bytes[2 * i] + bytes[2 * i + 1] * 256)
  }
  tokens
}

fn write_bin_u16(path, tokens) {
  mut bytes = []
  for t in tokens {
    bytes.push(t % 256)
    bytes.push(t / 256)
  }
  FS.write(path, String.from_bytes(bytes))
}

export {read_bin_u16, write_bin_u16}
