# PL/0, compiled instead of interpreted.
#
# `pl0.cul` (next to this file) evaluates the AST `Peg.parse` returns
# directly: a `match` arm reads a node's shape and computes its value on the
# spot. This file does the same parse, but instead of computing anything it
# builds a `CodeGen.Module` -- Core-IR, from vendor/cpp-vmlib -- and hands the
# finished program to `Module.run()`. The two are independent implementations
# of the same language, and this file's samples/*.pas output is checked
# against pl0.cul's own, which makes each the other's oracle: see
# tests/test_pl0_codegen.cul (or run both by hand and diff).
#
# The interesting difference is a binder, not an evaluator: a variable
# reference has to resolve to a (block, slot) or "which enclosing block's
# variable is this" at bind time, because `CodeGen` cannot go back and ask the
# AST again once a program is running. See "Name resolution" below, and
# cpp-vmlib's own examples/pl0/binder.cc for the C++ twin of this file --
# same four phases (collect declarations, scan free variables, solve captures
# by fixpoint, emit), same PL/0, different host language. The two phases that
# are the same for every language -- the capture solver and the IR shapes a
# lowering builds over and over -- live in ../codegen-front/front.cul, shared
# with mini_culebra.cul and mini_js.cul.
#
# Run it:  culebra examples/pl0/pl0_codegen.cul examples/pl0/samples/square.pas
#          culebra examples/pl0/pl0_codegen.cul --ir examples/pl0/samples/square.pas
#          culebra examples/pl0/pl0_codegen.cul --bc examples/pl0/samples/square.pas

import front from '../codegen-front/front.cul'

let grammar = `
  program    <- _ block '.' _

  block      <- const var procedure statement
  const      <- ('CONST' __ ident '=' _ number (',' _ ident '=' _ number)* ';' _)?
  var        <- ('VAR' __ ident (',' _ ident)* ';' _)?      { no_ast_opt }
  procedure  <- ('PROCEDURE' __ ident ';' _ block ';' _)*

  statement  <- (assignment / call / statements / if / while / out / in)?
  assignment <- ident ':=' _ expression
  call       <- 'CALL' __ ident                             { no_ast_opt }
  statements <- 'BEGIN' __ statement (';' _ statement )* 'END' __
  if         <- 'IF' __ condition 'THEN' __ statement
  while      <- 'WHILE' __ condition 'DO' __ statement
  out        <- ('out' __ / 'write' __ / '!' _) expression  { no_ast_opt }
  in         <- ('in' __ / 'read' __ / '?' _) ident         { no_ast_opt }

  condition  <- odd / compare
  odd        <- 'ODD' __ expression                         { no_ast_opt }
  compare    <- expression compare_op expression
  compare_op <- < '=' / '#' / '<=' / '<' / '>=' / '>' > _

  expression <- sign? term (term_op term)*
  sign       <- < [-+] > _
  term_op    <- < [-+] > _

  term       <- factor (factor_op factor)*
  factor_op  <- < [*/] > _

  factor     <- ident / number / '(' _ expression ')' _

  ident      <- < [a-z] [a-z0-9]* > _
  number     <- < [0-9]+ > _

  ~_         <- [ \t\r\n]*
  ~__        <- ![a-z0-9_] _
`

fn fail(node, msg) {
  throw {kind: 'Pl0Error', message: msg, line: node.line, col: node.column}
}

fn binop_name(tok) {
  match tok {
    '+' => 'add',
    '-' => 'sub',
    '*' => 'mul',
    '/' => 'div',
  }
}

fn cmp_name(tok) {
  match tok {
    '=' => 'eq',
    '#' => 'ne',
    '<' => 'lt',
    '<=' => 'le',
    '>' => 'gt',
    '>=' => 'ge',
  }
}

# The four phases below (collect declarations, scan free variables, solve
# captures by fixpoint, emit) all read and mutate the same per-compile
# state, so they live as methods on one `Binder` instance instead of on
# module-level `mut` globals -- a second `Binder.new()` in the same process
# starts from nothing rather than inheriting another compile's leftovers.
class Binder {
  blocks = []                  # {parent, name, consts, var_slot, var_names, procs, children, body}
  frames = front.Frames.new()  # blocks and Frames share indices: collect registers both
  ir = nil                     # the Emitter, once build has the Module

  # --- Phase 1: collect declarations -----------------------------------------
  #
  # One entry per PL/0 block (the outermost program counts as block 0), holding
  # only the *static* structure: which names this block declares and where its
  # nested procedures live. No values -- `CodeGen`'s variables are (block, slot)
  # pairs resolved once here, not names looked up while running.
  #
  # Every sibling procedure is registered before the first of them is walked
  # (two passes over `procedure`'s nodes below), so a call to a later sibling
  # resolves. Doing it in one pass -- register-then-immediately-descend -- is
  # the reason cpp-peglib's own pl0.cc fails on exactly this case.

  declared_anywhere(block, name) {
    mut b = block
    while b != nil {
      let bi = self.blocks[b]
      if bi.consts.has(name) || bi.var_slot.has(name) || bi.procs.has(name) {
        return true
      }
      b = bi.parent
    }
    false
  }

  check_fresh(block, name, at) {
    if self.declared_anywhere(block, name) {
      fail(at, "'{name}' is already defined")
    }
  }

  collect(node, parent, name) {
    let index = self.blocks.size()
    self.blocks.push({
      parent: parent,
      name: name,
      consts: {},
      var_slot: {},
      var_names: [],
      procs: {},
      children: [],
      body: node.nodes[3],
    })
    # no parent edge: a PL/0 closure exists only at its call site, so the
    # call edges alone say what a procedure has to capture
    self.frames.add(nil)

    let [cst, vr, prc, _] = node.nodes
    for [cname, cvalue] in cst.nodes.iter().chunks(2) {
      self.check_fresh(index, cname.token, cname)
      self.blocks[index].consts[cname.token] = to_long(cvalue.token)
    }
    for vname in vr.nodes {
      self.check_fresh(index, vname.token, vname)
      let slot = self.blocks[index].var_names.size()
      self.blocks[index].var_slot[vname.token] = slot
      self.blocks[index].var_names.push(vname.token)
    }
    for [pname, _] in prc.nodes.iter().chunks(2) {
      self.check_fresh(index, pname.token, pname)
      self.blocks[index].procs[pname.token] = -1  # reserved; filled in below
    }
    for [pname, sub] in prc.nodes.iter().chunks(2) {
      let child = self.collect(sub, index, pname.token)
      self.blocks[index].procs[pname.token] = child
      self.blocks[index].children.push(child)
    }
    index
  }

  # --- Name resolution --------------------------------------------------------
  #
  # Three lookups, matching pl0.cul's three: reading a name sees constants and
  # variables; assigning sees the same but rejects a constant; CALL sees only
  # procedures. A procedure name read as a value is "undefined variable", which
  # is what pl0.cul itself reports.

  lookup_value(block, name) {
    mut b = block
    while b != nil {
      let bi = self.blocks[b]
      if bi.consts.has(name) {
        return {found: true, is_const: true, cval: bi.consts[name]}
      }
      if bi.var_slot.has(name) {
        return {found: true, is_const: false, var: (b, bi.var_slot[name])}
      }
      b = bi.parent
    }
    {found: false}
  }

  lookup_assign(block, name, at) {
    mut b = block
    while b != nil {
      let bi = self.blocks[b]
      if bi.consts.has(name) {
        fail(at, "cannot assign to constant '{name}'")
      }
      if bi.var_slot.has(name) {
        return (b, bi.var_slot[name])
      }
      b = bi.parent
    }
    fail(at, "undefined variable '{name}'")
  }

  lookup_proc(block, name) {
    mut b = block
    while b != nil {
      let bi = self.blocks[b]
      if bi.procs.has(name) {
        return bi.procs[name]
      }
      b = bi.parent
    }
    -1
  }

  # --- Phase 2: free variables -------------------------------------------------
  #
  # A reference block doesn't declare is free, and has to be captured from
  # whichever ancestor does declare it. `Frames.solve` closes this over the
  # call graph: if f calls g, everything g captures that f doesn't own
  # itself must be captured by f too (recursion makes this a fixpoint, not a
  # single pass -- self-recursion is the case a single pass misses).

  note_ref(block, var) {
    let (vb, vs) = var
    self.frames.use(block, vb, vs)
  }

  scan_chain(nodes, block) {
    for n in nodes {
      if n.name != 'sign' && n.name != 'term_op' && n.name != 'factor_op' {
        self.scan_expr(n, block)
      }
    }
  }

  scan_expr(node, block) {
    match node {
      {name: 'number'} => to_long(node.token),  # range-checked now, at bind time
      {name: 'ident', token} => {
        let r = self.lookup_value(block, token)
        if !r.found {
          fail(node, "undefined variable '{token}'")
        }
        if !r.is_const {
          self.note_ref(block, r.var)
        }
      },
      {name: 'expression', nodes} => self.scan_chain(nodes, block),
      {name: 'term', nodes} => self.scan_chain(nodes, block),
      _ => fail(node, "cannot evaluate {node.name}"),
    }
  }

  scan_cond(node, block) {
    match node {
      {name: 'odd', nodes: [value]} => self.scan_expr(value, block),
      {name: 'compare', nodes: [l, _op, r]} => {
        self.scan_expr(l, block)
        self.scan_expr(r, block)
      },
      _ => fail(node, "cannot evaluate {node.name} as a condition"),
    }
  }

  scan_stmt(node, block) {
    match node {
      {
        name: 'statements',
        nodes,
      } => nodes.for_each(|s| self.scan_stmt(s, block)),
      {name: 'assignment', nodes: [name, value]} => {
        self.note_ref(block, self.lookup_assign(block, name.token, name))
        self.scan_expr(value, block)
      },
      {name: 'call', nodes: [name]} => {
        let g = self.lookup_proc(block, name.token)
        if g < 0 {
          fail(name, "undefined procedure '{name.token}'")
        }
        self.frames.note_call(block, g)
      },
      {name: 'if', nodes: [cond, body]} => {
        self.scan_cond(cond, block)
        self.scan_stmt(body, block)
      },
      {name: 'while', nodes: [cond, body]} => {
        self.scan_cond(cond, block)
        self.scan_stmt(body, block)
      },
      {name: 'out', nodes: [value]} => self.scan_expr(value, block),
      {
        name: 'in',
        nodes: [name],
      } => self.note_ref(block, self.lookup_assign(block, name.token, name)),
      {name: 'statement'} => nil,  # the empty statement a trailing `;` leaves
      _ => fail(node, "cannot execute {node.name}"),
    }
  }

  # Nested procedures scan before the block's own body, so a diagnostic comes
  # out in source order (PL/0 writes PROCEDURE declarations ahead of the
  # statement they precede).
  scan_block(block) {
    for child in self.blocks[block].children {
      self.scan_block(child)
    }
    self.scan_stmt(self.blocks[block].body, block)
  }

  # --- Phase 3: emit -----------------------------------------------------------

  # `expression <- sign? term (term_op term)*` and `term <- factor (factor_op
  # factor)*` are the same shape: an optional leading sign, a first operand,
  # then operator/operand pairs, left-associated. The sign binds to the first
  # term only, so -a*b+c is ((-(a*b)) + c) -- same fact pl0.cul's own `chain`
  # leans on, restated here as IR construction instead of arithmetic.
  emit_chain(nodes, f) {
    let [head, ...rest] = nodes
    if head.name == 'sign' {
      let [first, ...pairs] = rest
      mut acc = self.emit_expr(first, f)
      if head.token == '-' {
        acc = self.ir.unary('neg', acc, head)
      }
      self.emit_fold(pairs, acc, f)
    } else {
      self.emit_fold(rest, self.emit_expr(head, f), f)
    }
  }

  emit_fold(pairs, acc, f) {
    mut value = acc
    for [op, operand] in pairs.iter().chunks(2) {
      let rhs = self.emit_expr(operand, f)
      value = self.ir.binary(binop_name(op.token), value, rhs, op)
    }
    value
  }

  emit_expr(node, f) {
    match node {
      {name: 'number'} => self.ir.literal(to_long(node.token), node),
      {name: 'ident', token} => {
        let r = self.lookup_value(f, token)
        if r.is_const {
          self.ir.literal(r.cval, node)
        } else {
          let (vb, vs) = r.var
          self.ir.read(f, vb, vs, node)
        }
      },
      {name: 'expression', nodes} => self.emit_chain(nodes, f),
      {name: 'term', nodes} => self.emit_chain(nodes, f),
      _ => fail(node, "cannot evaluate {node.name}"),
    }
  }

  # ODD e is e mod 2 != 0. cpp-peglib's own pl0.cc reads it as e != 0 in both of
  # its lanes, agreeing with itself while disagreeing with the language -- see
  # cpp-vmlib's examples/pl0/README.md for the sample that catches it.
  emit_cond(node, f) {
    match node {
      {name: 'odd', nodes: [value]} => {
        let e = self.emit_expr(value, f)
        let rem = self.ir.binary('mod', e, self.ir.literal(2, node), node)
        self.ir.binary('ne', rem, self.ir.literal(0, node), node)
      },
      {name: 'compare', nodes: [l, op, r]} => {
        let lhs = self.emit_expr(l, f)
        let rhs = self.emit_expr(r, f)
        self.ir.binary(cmp_name(op.token), lhs, rhs, op)
      },
      _ => fail(node, "cannot evaluate {node.name} as a condition"),
    }
  }

  emit_stmt(node, f) {
    match node {
      {
        name: 'statements',
        nodes,
      } => self.ir.block(nodes.map(|n| self.emit_stmt(n, f)), node),
      {name: 'assignment', nodes: [name, value]} => {
        let (vb, vs) = self.lookup_assign(f, name.token, name)
        let v = self.emit_expr(value, f)
        self.ir.write(f, vb, vs, v, node)
      },
      # The closure is built here, per call site, because a self-recursive
      # call (g == f) forwards `f`'s own captures straight through -- see
      # cpp-vmlib's README for fib.pas's version of that table.
      {name: 'call', nodes: [name]} => {
        let g = self.lookup_proc(f, name.token)
        self.ir.call(f, g, [], node)
      },
      {name: 'if', nodes: [cond, body]} => {
        let c = self.emit_cond(cond, f)
        let t = self.emit_stmt(body, f)
        self.ir.make_if(c, t, node)
      },
      {name: 'while', nodes: [cond, body]} => {
        let c = self.emit_cond(cond, f)
        let b = self.emit_stmt(body, f)
        self.ir.make_while(c, b, node)
      },
      {name: 'out', nodes: [value]} => {
        let v = self.emit_expr(value, f)
        self.ir.intrinsic('print', [v], node)
      },
      {name: 'in', nodes: [name]} => {
        let (vb, vs) = self.lookup_assign(f, name.token, name)
        let read = self.ir.intrinsic('readint', [], node)
        self.ir.write(f, vb, vs, read, node)
      },
      {name: 'statement'} => self.ir.block([], node),
      _ => fail(node, "cannot execute {node.name}"),
    }
  }

  # --- Driver ------------------------------------------------------------------

  build(m, root) {
    self.ir = front.Emitter.new(m, self.frames)
    self.collect(root, nil, 'main')
    self.scan_block(0)
    self.frames.solve()

    # Blocks and funcs share indices by construction: block 0 (the program's
    # own outermost scope) is emitted first, so it becomes func #0, the entry
    # point CodeGen requires.
    for f in range(self.blocks.size()) {
      let body = self.emit_stmt(self.blocks[f].body, f)
      let func = self.ir.add_func(
        self.blocks[f].name,
        f,
        self.blocks[f].var_names.size(),
        0,
        body,
      )
      for i, name in self.blocks[f].var_names.enumerate() {
        m.set_local_name(func: func, index: i, name: name)
      }
      self.ir.name_captures(func, f, |_, vb, vs| self.blocks[vb].var_names[vs])
    }
    self.ir
  }
}

let want_ir = Sys.argv.contains('--ir')
let want_bc = Sys.argv.contains('--bc')
let args = Sys.argv.filter(|a| a != '--ir' && a != '--bc')
if args.empty() {
  println("usage: culebra pl0_codegen.cul [--ir | --bc] PROGRAM.pas")
  Sys.exit(1)
}

try {
  # `program <- _ block '.' _` folds to a single child, so the root that
  # arrives is the block itself -- same fact pl0.cul's own driver leans on.
  let tree = Peg.parse(grammar, FS.read(args[0]), path: args[0])
  Binder.new().build(CodeGen.Module.new(), tree).finish(want_ir, want_bc)
} catch e {
  match e {
    {kind: 'Pl0Error'} => println("{args[0]}:{e.line}:{e.col}: {e.message}"),
    {kind: 'PegError'} => println(e.message),
    {kind: 'IrError'} => println("{args[0]}:{e.line}:{e.col}: {e.message}"),
    _ => throw e,
  }
  Sys.exit(1)
}
