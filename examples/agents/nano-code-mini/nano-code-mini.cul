# nano-code-mini — a port of https://github.com/1rgs/nanocode (MIT-spirit,
# single-file Python "minimal Claude Code alternative").
#
# Same shape as the original: one file, a hand-rolled tool schema, and a
# REPL that loops "call the API, run any tool calls, repeat" until the model
# stops asking for tools. What's simplified for the port: `bash` captures
# the whole process instead of streaming lines live (Proc.run buffers in
# full — see docs/stdlib.md §11), and interleaved stdout/stderr ordering is
# not preserved (they're captured on separate pipes).
#
# Usage:
#   export ANTHROPIC_API_KEY="..."      # or OPENROUTER_API_KEY
#   culebra nano-code-mini.cul
#
# Commands: /c (clear conversation), /q or exit (quit).

# --- setup -------------------------------------------------------------

let openrouter_key = Sys.env('OPENROUTER_API_KEY')
let use_openrouter = !openrouter_key.empty()

# OpenRouter speaks the Anthropic Messages API here, tool calls included, even
# for non-Anthropic models — so one response shape covers both providers.
let api_url = use_openrouter
  ? 'https://openrouter.ai/api/v1/messages'
  : 'https://api.anthropic.com/v1/messages'

let default_model = use_openrouter ? 'openai/gpt-oss-20b:free' : 'claude-opus-5'
let model = Sys.env('MODEL', default_model)

# --- small helpers -------------------------------------------------------

# Term.* is tty-aware: off a terminal the styles are no-ops and `cols()` is 80,
# so nothing here needs an `IO.stdout_is_terminal()` branch.
fn separator() {
  Term.dim("\u2500".repeat(Math.min(Term.cols(), 80)))
}

fn render_markdown(text) {
  text.replace(re'\*\*(.+?)\*\*', Term.bold('$1'))
}

# --- tool implementations -------------------------------------------------

fn tool_read(args) {
  let lines = FS.read(args.path).lines()
  let offset = args.offset ?? 0
  let limit = args.limit ?? lines.size()
  lines
    .slice(offset, offset + limit)
    .enumerate()
    .map(|(i, line)| "{offset + i + 1:4}| {line}")
    .join("\n")
}

fn tool_write(args) {
  FS.write(args.path, args.content)
  'ok'
}

fn tool_edit(args) {
  let text = FS.read(args.path)
  let count = text.count(args.old)
  if count == 0 {
    return 'error: old_string not found'
  }

  let all = args.all ?? false
  if !all && count > 1 {
    return "error: old_string appears {count} times, must be unique (use all=true)"
  }

  # count is 1 here whenever !all, so replacing every occurrence still touches
  # just that one — no separate first-vs-all branch needed.
  FS.write(args.path, text.replace(args.old, args.new))
  'ok'
}

fn tool_glob(args) {
  let sorted = FS
    .glob(FS.join(args.path ?? '.', args.pat))
    .sorted_by(|f| FS.is_file(f) ? FS.stat(f).mtime : 0, reverse: true)
  sorted.presence()?.join("\n") ?? 'none'
}

fn tool_grep(args) {
  let re = Regex.compile(args.pat)
  mut hits = []
  for p in FS.walk(args.path ?? '.') {
    if !FS.is_file(p) {
      continue
    }
    try {
      for i, line in FS.read(p).lines().enumerate() {
        if re.test(line) {
          hits.push("{p}:{i + 1}:{line}")
          if hits.size() >= 50 {
            return hits.join("\n")
          }
        }
      }
    } catch _ {
}
  }

  # The walk returns at 50, so whatever is left here is already under the cap.
  hits.presence()?.join("\n") ?? 'none'
}

fn tool_bash(args) {
  let r = Proc.run(['sh', '-c', args.cmd], timeout: 30000)

  let combined = (r.stdout + r.stderr).trim_end("\n")
  if !combined.empty() {
    for line in combined.lines() {
      println(Term.dim("  \u2502 {line}"))
    }
  }

  # Lead with the timeout note: the caller previews only the first line.
  if r.timed_out {
    return combined.empty()
      ? '(timed out after 30s)'
      : "(timed out after 30s)\n" + combined
  }

  combined.trim().presence() ?? '(empty)'
}

# --- tool registry + schema ------------------------------------------------

let TOOL_LIST = [
  {
    name: 'read',
    description: 'Read file with line numbers (file path, not directory)',
    params: {path: 'string', offset: 'integer?', limit: 'integer?'},
    run: tool_read,
  },
  {
    name: 'write',
    description: 'Write content to file',
    params: {path: 'string', content: 'string'},
    run: tool_write,
  },
  {
    name: 'edit',
    description: 'Replace old with new in file (old must be unique unless all=true)',
    params: {path: 'string', old: 'string', new: 'string', all: 'boolean?'},
    run: tool_edit,
  },
  {
    name: 'glob',
    description: 'Find files by pattern, sorted by mtime',
    params: {pat: 'string', path: 'string?'},
    run: tool_glob,
  },
  {
    name: 'grep',
    description: 'Search files for regex pattern',
    params: {pat: 'string', path: 'string?'},
    run: tool_grep,
  },
  {
    name: 'bash',
    description: 'Run shell command',
    params: {cmd: 'string'},
    run: tool_bash,
  },
]

let TOOLS = TOOL_LIST.map(|t| (t.name, t)).to_object()

fn run_tool(name, args) {
  let tool = TOOLS.get(name, nil)
  if tool == nil {
    return "error: unknown tool {name}"
  }
  try {
    tool.run(args)
  } catch e {
    "error: {e}"
  }
}

fn param_types(params) {
  params.iter().map(|(k, v)| (k, {type: v.trim_end('?')})).to_object()
}

# Built once — TOOL_LIST is static, so every call_api turn reuses this. Param
# specs are JSON Schema type names; a trailing '?' marks one optional.
let TOOL_SCHEMA = TOOL_LIST.map(|t| {
  name: t.name,
  description: t.description,
  input_schema: {
    type: 'object',
    properties: param_types(t.params),
    required: t.params.keys().filter(|k| !t.params[k].ends_with('?')),
  },
})

# --- API call --------------------------------------------------------------

let HEADERS = {
  "anthropic-version": '2023-06-01',
  ...use_openrouter
    ? {"Authorization": 'Bearer ' + openrouter_key}
    : {"x-api-key": Sys.env('ANTHROPIC_API_KEY')},
}

# Thinking is on by default on this model and `max_tokens` caps thinking plus
# reply together, so the budget needs headroom a reply-only one would not.
let MAX_TOKENS = 16000

fn call_api(messages, system_prompt) {
  let body = {
    model,
    max_tokens: MAX_TOKENS,
    system: system_prompt,
    messages,
    tools: TOOL_SCHEMA,
  }

  let r = Http.post(api_url, json: body, headers: HEADERS, timeout: 120)
  if !r.ok {
    throw {
      kind: 'LLMApiError',
      message: "API error {r.status}: {r.body}",
      status: r.status,
    }
  }
  r.json()
}

# --- REPL --------------------------------------------------------------

fn main() {
  let provider = use_openrouter ? 'OpenRouter' : 'Anthropic'
  let banner = Term.dim("{model} ({provider}) | {Sys.getcwd()}")
  println("{Term.bold('nanocode')} | {banner}\n")

  mut messages = []
  let system_prompt = "Concise coding assistant. cwd: {Sys.getcwd()}"

  while true {
    try {
      println(separator())
      print("{Term.bold(Term.blue("\u276f"))} ")

      let user_input = IO.input().trim()
      println(separator())

      match user_input {
        '' => {
          if !IO.stdin_is_terminal() {
            break
          }
          continue
        },
        '/q' | 'exit' => break,
        '/c' => {
          messages = []
          println(Term.green("\u23fa Cleared conversation"))
          continue
        },
        _ => messages.push({role: 'user', content: user_input}),
      }

      while true {
        let response = call_api(messages, system_prompt)

        # A safety classifier can decline the request: HTTP 200, no content.
        # Say so rather than looping back with an empty turn.
        if response.stop_reason == 'refusal' {
          println(Term.red("\u23fa Declined ({response.stop_details?.category ?? 'no category'})"))
          break
        }

        let content_blocks = response.content ?? []
        mut tool_results = []

        for block in content_blocks {
          if block.type == 'text' {
            println("\n{Term.cyan("\u23fa")} {render_markdown(block.text)}")
          } else if block.type == 'tool_use' {
            let first_arg = "{block.input.values().first() ?? ''}"
            let label = Term.green("\u23fa {block.name.capitalize()}")
            println("\n{label}({Term.dim(first_arg.slice(0, 50))})")

            let result = run_tool(block.name, block.input)
            let lines = result.split("\n")
            # "+N lines" already signals more text, so multi-line skips
            # truncate's own ellipsis; single-line adds it when it cuts.
            let preview = lines.size() > 1
              ? "{lines[0].slice(0, 60)} ... +{lines.size() - 1} lines"
              : lines[0].truncate(60)
            println(Term.dim("  \u23bf  {preview}"))

            tool_results.push({
              type: 'tool_result',
              tool_use_id: block.id,
              content: result,
            })
          }
        }

        messages.push({role: 'assistant', content: content_blocks})

        if tool_results.empty() {
          break
        }
        messages.push({role: 'user', content: tool_results})
      }

      println('')
    } catch e {
      if e.kind == 'Interrupted' {
        break
      }
      println(Term.red("\u23fa Error: {e}"))
    }
  }
}

main()
