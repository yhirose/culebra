import anthropic from './providers/anthropic.cul'
import msg from './core/message.cul'

# The conversions both ways, and one round trip through a stub client. What is
# being checked is the shape the format demands: the system prompt lifted out
# of the conversation, a tool result carried as a user turn, and a reply whose
# two halves — what the model said and what it wants run — come back separated.

# A client that answers with a canned payload and remembers what it was sent.
class AnthropicStub {
  new(response) {
    self.response = response
    self.sent = []
  }

  post(path, json) {
    self.sent.push({path: path, body: json})
    self.response
  }

  last_body() {
    self.sent[self.sent.size() - 1].body
  }
}

fn an_anthropic_response(status, payload) {
  {
    ok: status >= 200 && status < 300,
    status: status,
    body: JSON.stringify(payload),
    json: fn () { payload },
  }
}

fn an_anthropic_reply(blocks, stop_reason) {
  {
    content: blocks,
    stop_reason: stop_reason,
    usage: {input_tokens: 11, output_tokens: 7},
  }
}

# --- what goes out ----------------------------------------------------------

@test
fn lifts_the_system_prompt_out_of_the_conversation() {
  let history = [msg.system('be brief'), msg.user('hello'),
                 msg.system('and kind')]
  # Blocks, not one string: this format takes the system prompt as a list of
  # text blocks, one per system message.
  assert_eq(anthropic.system_blocks(history),
            [{type: 'text', text: 'be brief'},
             {type: 'text', text: 'and kind'}])
  assert_eq(anthropic.turns_of(history).size(), 1)
}

@test
fn a_plain_turn_carries_its_text() {
  let turns = anthropic.turns_of([msg.user('hello'), msg.assistant('hi')])
  assert_eq(turns[0], {role: 'user', content: 'hello'})
  assert_eq(turns[1], {role: 'assistant', content: 'hi'})
}

@test
fn an_assistant_turn_with_calls_becomes_blocks() {
  let calls = [{tool_call_id: 'c1', name: 'readFile', args: {path: 'a.txt'}}]
  let turns = anthropic.turns_of([msg.assistant('reading it', calls)])

  assert_eq(turns[0].role, 'assistant')
  assert_eq(turns[0].content[0], {type: 'text', text: 'reading it'})
  assert_eq(turns[0].content[1], {type: 'tool_use', id: 'c1',
                                  name: 'readFile', input: {path: 'a.txt'}})
}

@test
fn a_call_without_text_carries_no_empty_block() {
  let calls = [{tool_call_id: 'c1', name: 'readFile', args: {}}]
  let turns = anthropic.turns_of([msg.assistant('', calls)])
  # An empty text block is refused by the API, so there is only the call.
  assert_eq(turns[0].content.size(), 1)
  assert_eq(turns[0].content[0].type, 'tool_use')
}

@test
fn a_tool_result_goes_back_as_a_user_turn() {
  let turns = anthropic.turns_of(
    [msg.tool_result('c1', 'readFile', 'contents')])
  assert_eq(turns[0], {
    role: 'user',
    content: [{type: 'tool_result', tool_use_id: 'c1', content: 'contents'}],
  })
}

@test
fn a_tool_declares_its_schema_under_the_name_this_format_uses() {
  let specs = [{name: 'readFile', description: 'read it',
                parameters: {type: 'object', properties: {}, required: []}}]
  assert_eq(anthropic.tools_of(specs)[0], {
    name: 'readFile',
    description: 'read it',
    input_schema: {type: 'object', properties: {}, required: []},
  })
}

# --- what comes back --------------------------------------------------------

@test
fn reads_text_and_calls_out_of_one_reply() {
  let reply = an_anthropic_reply([
    {type: 'text', text: 'I will read it.'},
    {type: 'tool_use', id: 'c1', name: 'readFile', input: {path: 'a.txt'}},
  ], 'tool_use')
  let out = anthropic.read_reply(reply)

  assert_eq(out.text, 'I will read it.')
  assert_eq(out.finish_reason, 'tool_calls')
  assert_eq(out.tool_calls, [{tool_call_id: 'c1', name: 'readFile',
                              args: {path: 'a.txt'}}])
  assert_eq(out.usage.total_tokens, 18)
}

@test
fn a_reply_of_words_alone_has_no_calls() {
  let out = anthropic.read_reply(
    an_anthropic_reply([{type: 'text', text: 'done'}], 'end_turn'))
  assert_eq(out.text, 'done')
  assert_eq(out.finish_reason, 'stop')
  assert_true(out.tool_calls.empty())
}

@test
fn a_turn_of_pure_thinking_is_not_an_empty_turn() {
  # A model that thinks before it answers sends the thinking as a block of its
  # own, and can spend a whole turn on it. Read for `text` and `tool_use`
  # alone, such a turn arrives empty and ends the run — which is what happened
  # against a live endpoint.
  let out = anthropic.read_reply(an_anthropic_reply(
    [{type: 'thinking', thinking: 'We need to create hello.cul first.'}],
    'end_turn'))

  assert_eq(out.text, '')
  assert_true(out.tool_calls.empty())
  assert_true(out.reasoning.contains('hello.cul'))
}

@test
fn thinking_comes_back_verbatim_to_be_sent_again() {
  # The block is checked, not read: a signature travels with it, and one
  # rebuilt from its text alone is rejected. So what arrives is kept whole.
  let block = {type: 'thinking', thinking: 'first, look around',
               signature: 'abc123'}
  let out = anthropic.read_reply(an_anthropic_reply([block], 'end_turn'))

  assert_eq(out.reasoning_blocks, [block])
  assert_eq(out.reasoning, 'first, look around')
}

@test
fn the_models_own_thinking_leads_the_turn_it_belongs_to() {
  # Without this the model loses the thread: it sees a tool call it does not
  # remember making, thinks the task through again, and gives up. Order
  # matters — this format wants the thinking ahead of the rest.
  let block = {type: 'thinking', thinking: 'I should list the files',
               signature: 'abc123'}
  let turns = anthropic.turns_of([
    msg.user('what is here'),
    msg.assistant('looking', [{tool_call_id: 'c1', name: 'ls', args: {}}],
                  [block]),
  ])

  assert_eq(turns[1].content[0], block)
  assert_eq(turns[1].content[1], {type: 'text', text: 'looking'})
  assert_eq(turns[1].content[2].type, 'tool_use')
}

@test
fn a_turn_of_thinking_alone_still_goes_back_as_blocks() {
  # No text and no calls, but something to hand back: the turn cannot collapse
  # to a plain string, or the thinking is lost with it.
  let block = {type: 'thinking', thinking: 'still deciding', signature: 's'}
  let turns = anthropic.turns_of([msg.assistant('', [], [block])])

  assert_eq(turns[0], {role: 'assistant', content: [block]})
}

@test
fn thinking_stays_out_of_what_the_model_said() {
  # Both blocks in one turn: the answer is the text, and only the text.
  let out = anthropic.read_reply(an_anthropic_reply([
    {type: 'thinking', thinking: 'the user wants a greeting'},
    {type: 'text', text: 'Done.'},
  ], 'end_turn'))

  assert_eq(out.text, 'Done.')
  assert_eq(out.reasoning, 'the user wants a greeting')
}

@test
fn a_generation_that_broke_is_an_error_rather_than_a_finished_turn() {
  # The same failure in this format: a 200 whose body is an error in place of
  # the turn.
  let http = AnthropicStub.new(an_anthropic_response(200, {
    type: 'error',
    error: {type: 'api_error', message: 'inference generation failed'},
  }))
  let raised = try {
    anthropic.AnthropicModel.new(http, 'a-model')
      .do_generate({messages: []})
    nil
  } catch e {
    e
  }
  assert_eq(raised.kind, 'LLMApiError')
  assert_eq(raised.provider, 'anthropic')
  assert_true(raised.message.contains('inference generation failed'))
}

@test
fn names_every_reason_the_model_stopped() {
  assert_eq(anthropic.finish_reason_of('end_turn'), 'stop')
  assert_eq(anthropic.finish_reason_of('tool_use'), 'tool_calls')
  assert_eq(anthropic.finish_reason_of('max_tokens'), 'length')
  # Anything this format does not name is a plain finish. A generation that
  # broke never reaches here: it arrives as an error in place of the turn and
  # `read_reply` raises before asking why the model stopped.
  assert_eq(anthropic.finish_reason_of('something_new'), 'stop')
  assert_eq(anthropic.finish_reason_of(nil), 'stop')
}

# --- the round trip ---------------------------------------------------------

@test
fn posts_a_body_this_format_would_accept() {
  let http = AnthropicStub.new(an_anthropic_response(200,
    an_anthropic_reply([{type: 'text', text: 'hi'}], 'end_turn')))
  let model = anthropic.AnthropicModel.new(http, 'a-model')

  let out = model.do_generate({
    messages: [msg.system('be brief'), msg.user('hello')],
    tools: [{name: 'readFile', description: 'read it', parameters: {}}],
  })

  assert_eq(http.sent[0].path, '/messages')
  let body = http.last_body()
  assert_eq(body.model, 'a-model')
  assert_eq(body.system, [{type: 'text', text: 'be brief'}])
  assert_eq(body.messages, [{role: 'user', content: 'hello'}])
  assert_eq(body.tools[0].name, 'readFile')
  assert_eq(out.text, 'hi')
}

@test
fn leaves_out_what_it_has_nothing_to_say_about() {
  let http = AnthropicStub.new(an_anthropic_response(200,
    an_anthropic_reply([{type: 'text', text: 'hi'}], 'end_turn')))
  anthropic.AnthropicModel.new(http, 'a-model')
    .do_generate({messages: [msg.user('hello')], tools: []})

  # An empty `tools` is rejected by this format, so it is left out rather than
  # sent empty. `system` always goes, as upstream sends it: an empty list of
  # blocks is a conversation with no system prompt, which is a thing this
  # format can say.
  let body = http.last_body()
  assert_eq(body.system, [])
  assert_eq(body.tools, nil)
}

@test
fn a_refusal_names_the_status_and_what_the_body_said() {
  let http = AnthropicStub.new(an_anthropic_response(400,
    {error: {type: 'invalid_request_error', message: 'model not found'}}))
  let model = anthropic.AnthropicModel.new(http, 'no-such-model')

  let raised = try {
    model.do_generate({messages: [msg.user('hello')], tools: []})
    nil
  } catch e {
    e
  }
  assert_eq(raised.kind, 'LLMApiError')
  assert_eq(raised.status, 400)
  assert_eq(raised.provider, 'anthropic')
  assert_true(raised.message.contains('model not found'))
}

@test
fn repairs_the_pairing_before_sending() {
  # A tool result whose call was compressed away cannot go on the wire.
  let history = [msg.user('go'), msg.tool_result('gone', 'readFile', 'stale')]
  let http = AnthropicStub.new(an_anthropic_response(200,
    an_anthropic_reply([{type: 'text', text: 'ok'}], 'end_turn')))
  anthropic.AnthropicModel.new(http, 'a-model').do_generate({messages: history})

  assert_eq(http.last_body().messages, [{role: 'user', content: 'go'}])
}
