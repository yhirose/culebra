import agent from './core/agent.cul'
import approval from './core/approval.cul'
import prompt from './core/prompt.cul'
import workspace from './core/workspace.cul'
import tools from './tools/index.cul'
import factory from './providers/model_factory.cul'

# Ported from upstream's `bin/cli.ts`, without the parts this port leaves out:
# no --sandbox, no --stream, no --responses, no Issue-driven mode.
#
# The workspace is `./workspace` under the working directory, as upstream
# resolves it, so this is run from the directory holding it:
#
#     cd examples/agents/nano-code
#     LLM_PROVIDER=openai LLM_MODEL=... LLM_API_KEY=... \
#     OPENAI_BASE_URL=https://openrouter.ai/api/v1 \
#     culebra nano-code.cul --yolo "fix the bug in hello.cul"
#
# Everything lives inside `main`: a top-level binding in the file that is also
# the entry point is a global for the whole program, and neither the workspace
# nor the agent has any reason to be one.

let MAX_STEPS = 30

let USAGE = """
usage: culebra nano-code.cul [--yolo] <task...>

  --yolo    run tools that change things without asking

  LLM_PROVIDER         openai or anthropic
  LLM_MODEL            the model id that provider serves
  LLM_API_KEY          the key, unless the provider's own variable is set
  OPENAI_BASE_URL      where the openai format is spoken, if not OpenAI itself
  ANTHROPIC_BASE_URL   the same, for the other format
"""

fn main() {
  let opts = parse(Sys.argv)
  let provider = Sys.env('LLM_PROVIDER', '')
  let model_id = Sys.env('LLM_MODEL', '')
  let root = FS.join(Sys.getcwd(), 'workspace')

  if !opts.unknown.empty() {
    IO.eprintln("error: unknown option {opts.unknown[0]}")
    IO.eprintln(USAGE)
    Sys.exit(1)
  }
  if opts.task.empty() {
    IO.eprintln('error: say what to do')
    IO.eprintln(USAGE)
    Sys.exit(1)
  }
  if !FS.exists(root) {
    FS.mkdir(root)
  }

  println('=== Nano Code Agent ===')
  println("Provider: {provider.empty() ? '(unset)' : provider}")
  println("Model: {model_id.empty() ? '(unset)' : model_id}")
  println("Workspace: {root}")
  if opts.yolo {
    println('[mode] approving every tool call (--yolo)')
  }
  println("Task: {clip(opts.task)}")
  println('')

  # The key can also come from the provider's own variable, so it is not
  # required here — but naming what is missing beats a 401.
  if provider.empty() || model_id.empty() {
    IO.eprintln('error: LLM_PROVIDER and LLM_MODEL must be set')
    Sys.exit(1)
  }

  let a = agent.Agent.new({
    name: 'nano-code',
    instructions: prompt.load_instructions(root),
    model: factory.create_model_from_env(),
    tools: tools.make_tools(workspace.Workspace.new(root)),
    max_steps: MAX_STEPS,
    verbose: true,
    approval_func: opts.yolo ? approval.approve_all : nil,
  })

  a.generate(opts.task)
}

# `Args` is not used for one reason: an optional positional is not expressible
# in a spec (stdlib §10), and the task reads better as trailing words than as
# `--task "..."`.
fn parse(argv) {
  {
    yolo: argv.contains('--yolo'),
    # An option this does not know is not task text. Upstream's `parseArgs`
    # rejects it; folding it into the prompt asks the model to do `--yes fix
    # it`.
    unknown: argv.filter(|a| a.starts_with('--') && a != '--yolo'),
    task: argv.filter(|a| !a.starts_with('--')).join(' '),
  }
}

fn clip(s) {
  s.size() <= 100 ? s : s.slice(0, 100) + '...'
}

# The key is masked out of whatever is reported, as upstream masks it: an error
# from an endpoint can quote the request it refused. Upstream reads one variable
# because it requires one; here a provider's own key wins over the shared one,
# so all three have to be covered or the usual configuration is the unmasked
# one.
fn mask(text) {
  mut out = text
  for name in ['LLM_API_KEY', 'OPENAI_API_KEY', 'ANTHROPIC_API_KEY'] {
    let key = Sys.env(name, '')
    if !key.empty() {
      out = out.replace(key, '***')
    }
  }
  out
}

# A missing key or an endpoint that will not answer is the usual first run, and
# it is not a crash.
try {
  main()
} catch e {
  IO.eprintln('')
  IO.eprintln("nano-code: {mask(e.message ?? e)}")
  Sys.exit(1)
}
