import msg from './message.cul'
import lm from './language_model.cul'
import approval from './approval.cul'

# Ported from upstream's `src/core/agent.ts`.
#
# The loop: ask the model, run what it asked for, hand the results back, ask
# again — until it answers in words instead of in tool calls, or until the step
# budget runs out.
#
# Every outcome of a tool call — no such tool, a refusal, a throw from inside
# the tool — goes back into the conversation as a tool result rather than being
# raised, because the model is the one who has to react to it and it can only
# read what is in the history.

# ~10k-15k tokens; size it to the model's context window.
let CHAR_LIMIT = 30000
let KEEP_RECENT = 4          # newest turns, never compressed
let TOOL_RESULT_LIMIT = 200  # an older tool result longer than this is elided
let LOG_CLIP = 200

# The model is told this, so make it a direction rather than a dead end.
let CANCELLED = 'Cancelled by the user. Consider another approach.'

class Agent {
  new(config) {
    self.name = config.name
    self.instructions = config.instructions
    self.model = config.model
    # An Object of tools becomes a list: the model calls them by name, not by
    # the key they were filed under.
    self.tools = config.tools.values().collect()
    self.max_steps = config.max_steps ?? 10
    self.verbose = config.verbose ?? false
    self.approval_func = config.approval_func ?? approval.request_approval
  }

  generate(user_prompt) {
    mut messages = [msg.system(self.instructions), msg.user(user_prompt)]
    mut step = 0
    mut final_text = ''
    mut tool_call_count = 0

    while step < self.max_steps {
      step += 1
      if self.verbose {
        println("\n=== step {step}/{self.max_steps} ===")
      }

      messages = self.manage_context(messages)
      let response = lm.generate_text(self.model, messages, self.tools)

      let said = response.text ?? ''
      if !said.empty() {
        final_text = said
        println(said)
      } else if self.verbose && !(response.reasoning ?? '').empty() {
        # Not upstream's. A model that thinks before it answers can spend a
        # whole turn on it, and a step that prints nothing at all reads as a
        # hang rather than as a turn that produced no answer.
        println("[thought, said nothing] {clip(response.reasoning)}")
      }

      # Whatever the provider wants handed back with this turn. The loop does
      # not read them; it only keeps them attached to the turn they came from.
      let blocks = response.reasoning_blocks ?? []

      let calls = response.tool_calls ?? []
      if calls.empty() {
        # The model answered in words: that is the end of the task.
        messages.push(msg.assistant(said, [], blocks))
        break
      }

      messages.push(msg.assistant(said, calls, blocks))
      for call in calls {
        if self.run_call(call, messages) {
          tool_call_count += 1
        }
      }
    }

    if step >= self.max_steps {
      println('warning: reached the maximum number of steps')
    }
    if tool_call_count == 0 && step == 1 {
      println('warning: finished without using a tool')
    }

    {text: final_text}
  }

  # One call: its result is appended to `messages`, and the answer says whether
  # the tool ran.
  run_call(call, messages) {
    let tool = self.tools.find(|t| t.name == call.name)
    if tool == nil {
      messages.push(self.result(call, "error: tool {call.name} not found"))
      return false
    }

    if self.verbose {
      println("[tool] {call.name}({JSON.stringify(call.args ?? {})})")
    }

    if (tool.needs_approval ?? false) &&
       !self.approval_func(call.name, call.args) {
      messages.push(self.result(call, CANCELLED))
      return false
    }

    let out = execute_tool(tool, call.args ?? {})
    if self.verbose {
      println("[result] {clip(out)}")
    }
    messages.push(self.result(call, out))
    true
  }

  result(call, content) {
    msg.tool_result(call.tool_call_id, call.name, content)
  }

  # Compression, in two strategies applied in order: elide old tool results —
  # one readFile is usually why a history got big — and then, if it is still
  # over, drop what is left oldest-first. The system prompt and the newest
  # KEEP_RECENT messages are never touched, so the model keeps both its
  # instructions and the thread it is in the middle of.
  manage_context(messages) {
    let total = total_chars(messages)
    if total < CHAR_LIMIT || messages.size() <= KEEP_RECENT + 1 {
      return messages
    }
    println("\n[Context] compressing the conversation " +
            "(currently {total} characters)")

    let system = messages[0]
    let recent = messages.slice(messages.size() - KEEP_RECENT, messages.size())
    let middle = messages.slice(1, messages.size() - KEEP_RECENT)
      .map(|m| elide(m))

    # `from` is where the surviving middle starts. An index rather than
    # repeated removal from the head of an array.
    mut chars = msg.content_of(system).size() +
                total_chars(middle) + total_chars(recent)
    mut from = 0
    while chars > CHAR_LIMIT && from < middle.size() {
      chars -= msg.content_of(middle[from]).size()
      from += 1
    }

    [system] + middle.slice(from, middle.size()) + recent
  }
}

# A tool that throws answers with the text of the failure: the model is the one
# who has to read it and try something else.
fn execute_tool(tool, args) {
  try {
    tool.execute(args)
  } catch e {
    "error: {e.message ?? e}"
  }
}

fn total_chars(messages) {
  messages.map(|m| msg.content_of(m).size()).sum()
}

fn elide(m) {
  match m {
    Tool(t) => elide_tool_result(m, t),
    _       => m,
  }
}

fn elide_tool_result(m, t) {
  let content = t.content ?? ''
  content.size() <= TOOL_RESULT_LIMIT
    ? m
    : msg.tool_result(t.tool_call_id, t.name,
        "(an earlier tool result of {content.size()} characters was omitted)")
}

fn clip(s) {
  s.size() <= LOG_CLIP ? s : s.slice(0, LOG_CLIP) + '...'
}

export {Agent, execute_tool, CHAR_LIMIT, KEEP_RECENT, CANCELLED}
