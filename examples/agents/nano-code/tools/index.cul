import read_file from './read_file.cul'
import write_file from './write_file.cul'
import edit_file from './edit_file.cul'
import exec_command from './exec_command.cul'

# Ported from upstream's `src/tools/index.ts`: the four tools of chapter 4,
# in one place.
#
# Upstream exports each tool as a value, because each one resolves the
# workspace root from the process's working directory when it is imported.
# Here they are made against a workspace instead — one difference, and the
# reason for it is that a test can then be handed a directory of its own
# rather than writing into the one the agent works in.

fn make_tools(ws) {
  [
    read_file.make_read_file(ws),
    write_file.make_write_file(ws),
    edit_file.make_edit_file(ws),
    exec_command.make_exec_command(ws),
  ].map(|t| (t.name, t)).to_object()
}

export {make_tools}
