import openai from './providers/openai.cul'
import msg from './core/message.cul'

# Ported from upstream's `src/providers/openai.test.ts`. The same checks
# test_anthropic.cul makes, against the other format —
# and the three places the two disagree are what these are really about: the
# system prompt stays a turn, a tool result gets its own role, and a call's
# arguments travel as a JSON string.

class OpenAIStub {
  new(response) {
    self.response = response
    self.sent = []
  }

  post(path, json) {
    self.sent.push({path: path, body: json})
    self.response
  }

  last_body() {
    self.sent[self.sent.size() - 1].body
  }
}

fn an_openai_response(status, payload) {
  {
    ok: status >= 200 && status < 300,
    status: status,
    body: JSON.stringify(payload),
    json: fn () { payload },
  }
}

fn an_openai_reply(message, finish_reason) {
  {
    choices: [{message: message, finish_reason: finish_reason}],
    usage: {prompt_tokens: 11, completion_tokens: 7, total_tokens: 18},
  }
}

# --- what goes out ----------------------------------------------------------

@test
fn the_system_prompt_stays_a_turn() {
  let turns = openai.turns_of([msg.system('be brief'), msg.user('hello')])
  assert_eq(turns, [{role: 'system', content: 'be brief'},
                    {role: 'user', content: 'hello'}])
}

@test
fn a_calls_arguments_travel_as_a_string() {
  let calls = [{tool_call_id: 'c1', name: 'readFile', args: {path: 'a.txt'}}]
  let turn = openai.turns_of([msg.assistant('reading it', calls)])[0]

  assert_eq(turn.role, 'assistant')
  assert_eq(turn.content, 'reading it')
  assert_eq(turn.tool_calls[0].id, 'c1')
  assert_eq(turn.tool_calls[0].type, 'function')
  assert_eq(turn.tool_calls[0].function.name, 'readFile')
  # A JSON document inside a JSON document.
  assert_eq(JSON.parse(turn.tool_calls[0].function.arguments), {path: 'a.txt'})
}

@test
fn a_tool_result_has_a_role_of_its_own() {
  let turns = openai.turns_of([msg.tool_result('c1', 'readFile', 'contents')])
  assert_eq(turns[0], {role: 'tool', tool_call_id: 'c1', content: 'contents'})
}

@test
fn a_tool_is_declared_under_a_function_of_its_own() {
  let specs = [{name: 'readFile', description: 'read it',
                parameters: {type: 'object', properties: {}, required: []}}]
  assert_eq(openai.tools_of(specs)[0], {
    type: 'function',
    function: {
      name: 'readFile',
      description: 'read it',
      parameters: {type: 'object', properties: {}, required: []},
    },
  })
}

# --- what comes back --------------------------------------------------------

@test
fn reads_text_and_calls_out_of_one_choice() {
  let out = openai.read_reply(an_openai_reply({
    content: 'I will read it.',
    tool_calls: [{id: 'c1', type: 'function',
                  function: {name: 'readFile',
                             arguments: '{"path": "a.txt"}'}}],
  }, 'tool_calls'))

  assert_eq(out.text, 'I will read it.')
  assert_eq(out.finish_reason, 'tool_calls')
  assert_eq(out.tool_calls, [{tool_call_id: 'c1', name: 'readFile',
                              args: {path: 'a.txt'}}])
  assert_eq(out.usage.total_tokens, 18)
}

@test
fn a_reply_of_words_alone_has_no_calls() {
  let out = openai.read_reply(an_openai_reply({content: 'done'}, 'stop'))
  assert_eq(out.text, 'done')
  assert_eq(out.finish_reason, 'stop')
  assert_true(out.tool_calls.empty())
}

@test
fn arguments_that_are_not_json_come_back_empty() {
  # The model's mistake to see and correct: the tool will say what was
  # missing, which is more use to it than a parse error raised here.
  assert_eq(openai.args_of({arguments: '{"path": '}), {})
  assert_eq(openai.args_of({arguments: ''}), {})
  assert_eq(openai.args_of({}), {})
}

@test
fn keeps_this_formats_own_names_for_stopping() {
  assert_eq(openai.finish_reason_of('stop'), 'stop')
  assert_eq(openai.finish_reason_of('length'), 'length')
  assert_eq(openai.finish_reason_of('tool_calls'), 'tool_calls')
  # This one the other format has no word for at all.
  assert_eq(openai.finish_reason_of('content_filter'), 'content_filter')
  # A generation that broke never reaches here: it arrives as an error beside
  # the turn, and `read_reply` raises before asking why the model stopped.
  assert_eq(openai.finish_reason_of('something_new'), 'stop')
  assert_eq(openai.finish_reason_of(nil), 'stop')
}

# --- the round trip ---------------------------------------------------------

@test
fn posts_a_body_this_format_would_accept() {
  let http = OpenAIStub.new(
    an_openai_response(200, an_openai_reply({content: 'hi'}, 'stop')))
  let out = openai.OpenAIModel.new(http, 'a-model').do_generate({
    messages: [msg.system('be brief'), msg.user('hello')],
    tools: [{name: 'readFile', description: 'read it', parameters: {}}],
  })

  assert_eq(http.sent[0].path, '/chat/completions')
  let body = http.last_body()
  assert_eq(body.model, 'a-model')
  # No ceiling: this format does not require one, so nothing is sent unless
  # the caller asks for it. The other format requires one and defaults it.
  assert_eq(body.max_completion_tokens, nil)
  # No `system` field: it is in the conversation.
  assert_eq(body.system, nil)
  assert_eq(body.messages.size(), 2)
  assert_eq(body.tools[0].function.name, 'readFile')
  assert_eq(out.text, 'hi')
}

@test
fn a_refusal_names_the_status_and_what_the_body_said() {
  let http = OpenAIStub.new(an_openai_response(404,
    {error: {message: 'model not found', type: 'invalid_request_error'}}))

  let raised = try {
    openai.OpenAIModel.new(http, 'no-such-model')
      .do_generate({messages: [msg.user('hello')]})
    nil
  } catch e {
    e
  }
  assert_eq(raised.kind, 'LLMApiError')
  assert_eq(raised.status, 404)
  assert_eq(raised.provider, 'openai')
  assert_true(raised.message.contains('model not found'))
}

@test
fn what_the_other_format_wants_handed_back_is_ignored_here() {
  # A history can carry blocks the other provider asked for. This format has
  # nowhere to put them, so the turn goes out as it always did.
  let turns = openai.turns_of([
    msg.assistant('looking', [], [{type: 'thinking', thinking: 'hmm'}]),
  ])
  assert_eq(turns[0], {role: 'assistant', content: 'looking'})
}

@test
fn thinking_arrives_in_a_field_here_rather_than_a_block() {
  # The same thing the other format sends as a block. Same name on the way
  # out, which is the whole job of a wire.
  let out = openai.read_reply(an_openai_reply(
    {content: '', reasoning: 'We need to create hello.cul first.'}, 'stop'))

  assert_eq(out.text, '')
  assert_true(out.reasoning.contains('hello.cul'))

  # And a model that does not think at all answers with none.
  let plain = openai.read_reply(
    an_openai_reply({content: 'Done.'}, 'stop'))
  assert_eq(plain.text, 'Done.')
  assert_eq(plain.reasoning, '')
}

@test
fn a_generation_that_broke_is_an_error_rather_than_a_finished_turn() {
  # A 200 whose choice carries an error instead of an answer. An endpoint that
  # routes to a provider reports the provider's failure this way, and calling
  # it a turn is what makes an overloaded free tier look like a model that had
  # nothing to say.
  let http = OpenAIStub.new(an_openai_response(200, {
    choices: [{
      error: {code: 502, message: 'inference generation failed',
              metadata: {error_type: 'provider_unavailable'}},
      message: {content: ''},
      finish_reason: 'error',
    }],
  }))
  let raised = try {
    openai.OpenAIModel.new(http, 'a-model').do_generate({messages: []})
    nil
  } catch e {
    e
  }
  assert_eq(raised.kind, 'LLMApiError')
  assert_eq(raised.status, 502)
  assert_true(raised.message.contains('inference generation failed'))
  assert_true(raised.message.contains('provider_unavailable'))
}

@test
fn an_answer_with_no_choices_is_an_error_rather_than_an_empty_turn() {
  let http = OpenAIStub.new(an_openai_response(200, {choices: []}))
  let raised = try {
    openai.OpenAIModel.new(http, 'a-model').do_generate({messages: []})
    nil
  } catch e {
    e
  }
  assert_eq(raised.kind, 'LLMApiError')
}
