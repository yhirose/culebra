import msg from '../core/message.cul'
import clean from '../core/clean_messages.cul'
import err from '../core/errors.cul'
import sse from '../core/sse.cul'
import api_error from './api_error.cul'

# Ported from upstream's `src/providers/openai.ts`.
#
# The same conversation as providers/anthropic.cul, said differently. Reading
# the two side by side is the point of having both; three things are spelled
# differently and nothing else is:
#
#   the system prompt   a turn in the array here, a field of its own there
#   a tool call         a JSON *string* of arguments here, a nested object there
#   a tool result       its own `tool` role here, a user turn there
#
# `create_openai` stands in for `new OpenAI(...)`, and reads what that SDK
# reads: `OPENAI_API_KEY`, and `OPENAI_BASE_URL` for anything speaking this
# format at another address. That last one is all it takes to reach OpenRouter,
# which is how upstream would reach it too.

let DEFAULT_BASE_URL = 'https://api.openai.com/v1'
let TIMEOUT = 120
let PROVIDER = 'openai'

fn create_openai(config = {}) {
  let key = config.api_key ?? Sys.env('OPENAI_API_KEY', '')
  let http = Http.client(
    config.base_url ?? Sys.env('OPENAI_BASE_URL', DEFAULT_BASE_URL),
    headers: {Authorization: "Bearer {key}"},
    timeout: config.timeout ?? TIMEOUT)
  |model_id| OpenAIModel.new(http, model_id)
}

class OpenAIModel {
  new(http, model_id) {
    self.http = http
    self.model_id = model_id
  }

  do_generate(params) {
    let res = self.http.post('/chat/completions',
                             json: self.body_for(params, false))
    if !res.ok {
      throw err.llm_api_error(res.status, PROVIDER,
                              api_error.explain(PROVIDER, res))
    }
    read_reply(api_error.parsed(PROVIDER, res))
  }

  # The same turn, streamed. As in the other format, the deltas are assembled
  # into the body a non-streaming request would have returned, so `read_reply`
  # is what interprets it either way.
  do_stream(params, on_text) {
    let turn = OpenAIStream.new(on_text)
    let stream = sse.EventStream.new(|e| turn.take(e))
    let res = self.http.post('/chat/completions',
                             json: self.body_for(params, true),
                             into: stream.sink())
    if !res.ok {
      throw err.llm_api_error(res.status, PROVIDER,
                              api_error.explain(PROVIDER, stream.failure(res)))
    }
    if stream.events == 0 {
      throw err.llm_api_error(res.status, PROVIDER,
        "{PROVIDER} wire: the stream closed without sending an event")
    }
    read_reply(turn.finish())
  }

  body_for(params, streaming) {
    let history = clean.clean_messages(params.messages)

    mut body = {model: self.model_id, messages: turns_of(history)}
    # This format does not require a ceiling, so upstream sends one only when
    # asked to. The other format requires one and defaults it.
    if params.max_tokens != nil {
      body.max_completion_tokens = params.max_tokens
    }
    let specs = params.tools ?? []
    if !specs.empty() {
      body.tools = tools_of(specs)
    }
    if streaming {
      body.stream = true
      # Usage is left out of a stream unless it is asked for, and a turn
      # without it reports nothing about what it cost.
      body.stream_options = {include_usage: true}
    }
    body
  }
}

# --- what goes out ----------------------------------------------------------

fn turns_of(messages) {
  messages.map(|m| turn_of(m))
}

fn turn_of(m) {
  match m {
    Tool(t)      => tool_turn(t),
    Assistant(a) => assistant_turn(a),
    _            => plain_turn(m),
  }
}

fn tool_turn(t) {
  {role: 'tool', tool_call_id: t.tool_call_id, content: t.content ?? ''}
}

fn assistant_turn(a) {
  let calls = a.tool_calls ?? []
  if calls.empty() {
    return {role: 'assistant', content: a.content ?? ''}
  }
  {
    role: 'assistant',
    content: a.content ?? '',
    # The arguments travel as a JSON string inside the JSON body — the one
    # place this format asks for a document within a document.
    tool_calls: calls.map(|c| {
      id: c.tool_call_id,
      type: 'function',
      function: {name: c.name, arguments: JSON.stringify(c.args ?? {})},
    }),
  }
}

fn plain_turn(m) {
  {role: msg.role_of(m), content: msg.content_of(m)}
}

fn tools_of(specs) {
  specs.map(|t| {
    type: 'function',
    function: {
      name: t.name,
      description: t.description,
      parameters: t.parameters,
    },
  })
}

# --- what comes back --------------------------------------------------------

fn read_reply(payload) {
  let choices = payload.choices ?? []
  if choices.empty() {
    throw err.llm_api_error(500, PROVIDER, 'the API answered with no choices')
  }
  let choice = choices[0]
  # Not upstream's: a failure can arrive beside the turn it could not produce,
  # inside a 200. See README, "Where this differs from upstream".
  if choice.error != nil {
    throw api_error.carried_error(PROVIDER, choice.error)
  }

  let reply = choice.message ?? {}
  {
    text: reply.content ?? '',
    # Nor is this: what the other format sends as a `thinking` block arrives
    # here as a field beside the answer. Nothing goes back — this format has no
    # place for it, and the endpoints that speak it reconstruct what they need.
    reasoning: reply.reasoning ?? '',
    reasoning_blocks: [],
    finish_reason: finish_reason_of(choice.finish_reason),
    tool_calls: (reply.tool_calls ?? []).map(|c| call_of(c)),
    usage: usage_of(payload.usage),
  }
}

fn call_of(c) {
  {tool_call_id: c.id, name: c.function.name, args: args_of(c.function)}
}

# Malformed arguments are answered with an empty call rather than a raised
# SyntaxError: what the model wrote is its mistake to see and correct, and the
# tool will say what was missing.
fn args_of(f) {
  let text = f.arguments ?? ''
  if text.empty() {
    return {}
  }
  # `{}` as the last thing in a block is an empty *block*, worth nil — an
  # object literal needs an expression position, which `??` gives it here.
  let parsed = try {
    JSON.parse(text)
  } catch _e {
    nil
  }
  parsed ?? {}
}

# --- what comes back, a piece at a time -------------------------------------

# Where the other format numbers blocks and opens each one, this format sends
# a partial turn per frame: `delta` holds whatever grew since the last one, and
# a tool call is identified by its index in the list rather than by a block.
# The pieces are added up and handed back as the turn they amount to.

# The frame that ends the stream. It is a sentinel rather than JSON, which is
# the one thing here that would raise if it were read as a frame.
let DONE = '[DONE]'

class OpenAIStream {
  new(on_text) {
    self.on_text = on_text
    self.content = ''
    self.reasoning = ''
    self.calls = []
    self.finish_reason = nil
    self.usage = nil
    self.failure = nil
  }

  take(event) {
    return nil if event.data == DONE
    let payload = try {
      JSON.parse(event.data)
    } catch _e {
      nil
    }
    return nil if payload == nil

    # A failure can arrive as a frame of its own, or beside the turn it could
    # not produce. Kept rather than raised: `read_reply` already knows what a
    # choice carrying an error means.
    if payload.error != nil {
      self.failure = payload.error
      return nil
    }
    if payload.usage != nil {
      self.usage = payload.usage
    }

    let choices = payload.choices ?? []
    return nil if choices.empty()
    let choice = choices[0]
    if choice.error != nil {
      self.failure = choice.error
      return nil
    }
    if choice.finish_reason != nil {
      self.finish_reason = choice.finish_reason
    }
    self.grow(choice.delta ?? {})
    nil
  }

  grow(delta) {
    let said = delta.content ?? ''
    if !said.empty() {
      self.content = self.content + said
      if self.on_text != nil {
        self.on_text(said)
      }
    }
    # Thinking, where this format puts it: a field beside the answer rather
    # than a block of its own. It is not what the model said, so it is not
    # what a watcher hears.
    self.reasoning = self.reasoning + (delta.reasoning ?? '')
    for call in (delta.tool_calls ?? []) {
      self.grow_call(call)
    }
  }

  # A call's id and name arrive with the first piece of it; the arguments
  # accumulate across the pieces that follow.
  grow_call(delta) {
    let index = delta.index ?? 0
    while self.calls.size() <= index {
      self.calls.push(nil)
    }
    if self.calls[index] == nil {
      self.calls[index] = {mut id: '', mut name: '', mut arguments: ''}
    }
    let call = self.calls[index]
    if delta.id != nil {
      call.id = delta.id
    }
    let f = delta.function ?? {}
    if f.name != nil {
      call.name = f.name
    }
    call.arguments = call.arguments + (f.arguments ?? '')
  }

  # The body the non-streaming endpoint would have sent. The arguments stay a
  # JSON string, as they are on that wire — `read_reply` is what parses them,
  # and what forgives a document the model left unfinished.
  finish() {
    if self.failure != nil {
      return {choices: [{error: self.failure}]}
    }
    {
      choices: [{
        message: {
          content: self.content,
          reasoning: self.reasoning,
          tool_calls: self.calls.filter(|c| c != nil).map(|c| call_frame_of(c)),
        },
        finish_reason: self.finish_reason,
      }],
      usage: self.usage,
    }
  }
}

fn call_frame_of(c) {
  {id: c.id, type: 'function',
   function: {name: c.name, arguments: c.arguments}}
}

# This format's own names, kept as they are where they already agree.
fn finish_reason_of(reason) {
  match reason {
    'stop'           => 'stop',
    'length'         => 'length',
    'content_filter' => 'content_filter',
    'tool_calls'     => 'tool_calls',
    _                => 'stop',
  }
}

fn usage_of(u) {
  if u == nil {
    return {}
  }
  {
    prompt_tokens: u.prompt_tokens ?? 0,
    completion_tokens: u.completion_tokens ?? 0,
    total_tokens: u.total_tokens ?? 0,
  }
}

export {create_openai, OpenAIModel, OpenAIStream}
export {turns_of, tools_of, read_reply, finish_reason_of, args_of}
