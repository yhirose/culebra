import msg from '../core/message.cul'
import clean from '../core/clean_messages.cul'
import err from '../core/errors.cul'
import sse from '../core/sse.cul'
import api_error from './api_error.cul'

# Ported from upstream's `src/providers/anthropic.ts`.
#
# Upstream calls `new Anthropic(...)` and lets the vendor SDK carry the base
# URL, the key and the retries. There is no such SDK here, so `create_anthropic`
# does what the SDK does: it reads the same environment the SDK reads
# (`ANTHROPIC_API_KEY`, `ANTHROPIC_BASE_URL`) and hands back a provider — a
# function from a model id to a `LanguageModel`, exactly upstream's `Provider`.
#
# Writing the format out by hand is the one thing this port gains from having
# no SDK: what a tool-calling conversation looks like on the wire is visible in
# `turns_of` and `read_reply` rather than hidden behind a client library.

let DEFAULT_BASE_URL = 'https://api.anthropic.com/v1'
let ANTHROPIC_VERSION = '2023-06-01'
let MAX_TOKENS = 4096
let TIMEOUT = 120
let PROVIDER = 'anthropic'

fn create_anthropic(config = {}) {
  let key = config.api_key ?? Sys.env('ANTHROPIC_API_KEY', '')
  let http = Http.client(
    config.base_url ?? Sys.env('ANTHROPIC_BASE_URL', DEFAULT_BASE_URL),
    # `x-api-key` is what this API takes and what upstream's SDK sends. The
    # bearer header goes too, because a gateway serving this format in front
    # of other models authorises the way the rest of the web does, and one of
    # the two is ignored either way.
    headers: {
      'x-api-key': key,
      Authorization: "Bearer {key}",
      'anthropic-version': ANTHROPIC_VERSION,
    },
    timeout: config.timeout ?? TIMEOUT)
  |model_id| AnthropicModel.new(http, model_id)
}

class AnthropicModel {
  new(http, model_id) {
    self.http = http
    self.model_id = model_id
  }

  do_generate(params) {
    let res = self.http.post('/messages', json: self.body_for(params, false))
    if !res.ok {
      throw err.llm_api_error(res.status, PROVIDER,
                              api_error.explain(PROVIDER, res))
    }
    read_reply(api_error.parsed(PROVIDER, res))
  }

  # The same turn, streamed: `on_text` is called with each piece of the answer
  # as it arrives. What comes back is what `do_generate` would have answered,
  # and by construction rather than by agreement — the events are assembled
  # into the body the non-streaming endpoint would have sent, and `read_reply`
  # is what reads it either way.
  do_stream(params, on_text) {
    let turn = AnthropicStream.new(on_text)
    let stream = sse.EventStream.new(|e| turn.take(e))
    let res = self.http.post('/messages', json: self.body_for(params, true),
                             into: stream.sink())
    if !res.ok {
      # `into:` took the body, so what the refusal said is in the stream's own
      # buffer rather than in `res.body`.
      throw err.llm_api_error(res.status, PROVIDER,
                              api_error.explain(PROVIDER, stream.failure(res)))
    }
    # A 200 that carried no event at all. Read as a finished turn this is a
    # model with nothing to say, and the run ends in silence — the same reason
    # `read_reply` raises on a failure carried inside a 200.
    if stream.events == 0 {
      throw err.llm_api_error(res.status, PROVIDER,
        "{PROVIDER} wire: the stream closed without sending an event")
    }
    read_reply(turn.finish())
  }

  # Both ways of asking send the same body; only `stream` differs.
  body_for(params, streaming) {
    # Repair the call/result pairing first: compression can have cut a tool
    # call away from its result, and this format rejects a history where the
    # two do not match up.
    let history = clean.clean_messages(params.messages)

    mut body = {
      model: self.model_id,
      system: system_blocks(params.messages),
      # This format requires a ceiling, so upstream supplies one when the
      # caller does not. The other format does not require it, and upstream
      # sends none there — the asymmetry belongs to the formats.
      max_tokens: params.max_tokens ?? MAX_TOKENS,
      messages: turns_of(history),
    }
    let specs = params.tools ?? []
    if !specs.empty() {
      body.tools = tools_of(specs)
    }
    if streaming {
      body.stream = true
    }
    body
  }
}

# --- what goes out ----------------------------------------------------------

# The system prompt is a field of its own here, not a turn in the conversation,
# so it is lifted out and the rest of the history keeps its order.
fn system_blocks(messages) {
  messages
    .filter(|m| msg.role_of(m) == 'system')
    .map(|m| {type: 'text', text: msg.content_of(m)})
}

fn turns_of(messages) {
  messages
    .filter(|m| msg.role_of(m) != 'system')
    .map(|m| turn_of(m))
}

fn turn_of(m) {
  match m {
    Tool(t)      => tool_turn(t),
    Assistant(a) => assistant_turn(a),
    _            => plain_turn(m),
  }
}

# A tool result is a user turn in this format: the model's own calls are the
# assistant side, and what came back is what the user hands it.
fn tool_turn(t) {
  {
    role: 'user',
    content: [{
      type: 'tool_result',
      tool_use_id: t.tool_call_id,
      content: t.content ?? '',
    }],
  }
}

fn assistant_turn(a) {
  let calls = a.tool_calls ?? []
  # The model's own thinking, verbatim and first. This format asks for it back
  # with the turn it belongs to, and it is checked rather than read: a block
  # rebuilt from its text alone is rejected, which is why what was received is
  # what is sent.
  let thinking = a.reasoning_blocks ?? []
  if calls.empty() && thinking.empty() {
    return {role: 'assistant', content: a.content ?? ''}
  }

  # Text and calls are blocks of one turn. An empty text block is rejected, so
  # it is there only when the model said something alongside its calls.
  mut blocks = [] + thinking
  if !(a.content ?? '').empty() {
    blocks.push({type: 'text', text: a.content})
  }
  for c in calls {
    blocks.push({
      type: 'tool_use',
      id: c.tool_call_id,
      name: c.name,
      input: c.args ?? {},
    })
  }
  {role: 'assistant', content: blocks}
}

fn plain_turn(m) {
  {role: msg.role_of(m), content: msg.content_of(m)}
}

fn tools_of(specs) {
  specs.map(|t| {
    name: t.name,
    description: t.description,
    input_schema: t.parameters,
  })
}

# --- what comes back --------------------------------------------------------

# One reply carries both halves of a turn: the text blocks are what the model
# said, the tool_use blocks are what it wants run. The loop in agent.cul reads
# the second and stops when there is none.
fn read_reply(payload) {
  # Not upstream's: a failure can arrive in place of the turn, inside a 200.
  # See README, "Where this differs from upstream".
  if payload.type == 'error' {
    throw api_error.carried_error(PROVIDER, payload.error ?? payload)
  }

  let blocks = payload.content ?? []
  # Nor is this: a model that thinks before it answers sends the thinking as a
  # block of its own, and a whole turn can be nothing else. One set, read two
  # ways — the text is for a reader, the blocks go back on the next turn
  # untouched. A redacted block has no text to contribute.
  let thinking = blocks.filter(|b| b.type == 'thinking' ||
                                   b.type == 'redacted_thinking')
  {
    text: blocks.filter(|b| b.type == 'text').map(|b| b.text ?? '').join(''),
    reasoning: thinking.map(|b| b.thinking ?? '').join(''),
    reasoning_blocks: thinking,
    finish_reason: finish_reason_of(payload.stop_reason),
    tool_calls: blocks.filter(|b| b.type == 'tool_use').map(|b| call_of(b)),
    usage: usage_of(payload.usage),
  }
}

fn call_of(b) {
  {tool_call_id: b.id, name: b.name, args: b.input ?? {}}
}

# --- what comes back, a piece at a time -------------------------------------

# This format streams deltas against numbered blocks: a block is opened, its
# content arrives in pieces, and it is closed. A turn's text can be split at
# any point, and a tool call's arguments arrive as a JSON document written a
# few characters at a time — which is why the arguments cannot be read until
# the block ends.
#
# The pieces are held in a shape of this class's own and turned into the
# format's blocks at the end, so that what `finish` answers is exactly a
# non-streaming body.
class AnthropicStream {
  new(on_text) {
    self.on_text = on_text
    self.blocks = []
    self.stop_reason = nil
    self.sent = 0
    self.received = 0
    self.failure = nil
  }

  take(event) {
    # A frame that will not parse is not worth ending the turn over: the next
    # one usually carries the same content, and the stream says when it broke.
    let payload = try {
      JSON.parse(event.data)
    } catch _e {
      nil
    }
    return nil if payload == nil

    let kind = payload.type
    if kind == 'message_start' {
      self.open(payload)
    } else if kind == 'content_block_start' {
      self.open_block(payload)
    } else if kind == 'content_block_delta' {
      self.grow_block(payload)
    } else if kind == 'message_delta' {
      self.close(payload)
    } else if kind == 'error' {
      # Kept rather than raised here: `read_reply` already knows what to do
      # with a body that is an error in place of a turn.
      self.failure = payload
    }
    nil
  }

  open(payload) {
    let usage = (payload.message ?? {}).usage ?? {}
    self.sent = usage.input_tokens ?? 0
    self.received = usage.output_tokens ?? 0
  }

  open_block(payload) {
    let block = payload.content_block ?? {}
    self.put(payload.index ?? 0, {
      kind: block.type ?? 'text',
      id: block.id,
      name: block.name,
      data: block.data,
      # A block opens with what it already has, which for a thinking block is
      # under a name of its own.
      mut text: block.text ?? block.thinking ?? '',
      mut json: '',
      mut signature: block.signature ?? '',
    })
  }

  grow_block(payload) {
    let block = self.at(payload.index ?? 0)
    return nil if block == nil

    let delta = payload.delta ?? {}
    let kind = delta.type
    if kind == 'text_delta' {
      let said = delta.text ?? ''
      block.text = block.text + said
      # The one place a piece leaves this class as it arrives, rather than at
      # the end: what the model is saying, to whoever is watching it be said.
      if self.on_text != nil && !said.empty() {
        self.on_text(said)
      }
    } else if kind == 'thinking_delta' {
      block.text = block.text + (delta.thinking ?? '')
    } else if kind == 'input_json_delta' {
      block.json = block.json + (delta.partial_json ?? '')
    } else if kind == 'signature_delta' {
      block.signature = block.signature + (delta.signature ?? '')
    }
    nil
  }

  close(payload) {
    self.stop_reason = (payload.delta ?? {}).stop_reason ?? self.stop_reason
    # The final count. What `message_start` carried was the count so far.
    self.received = (payload.usage ?? {}).output_tokens ?? self.received
  }

  # Blocks are numbered, and nothing says they arrive in order.
  put(index, block) {
    while self.blocks.size() <= index {
      self.blocks.push(nil)
    }
    self.blocks[index] = block
  }

  at(index) {
    index >= 0 && index < self.blocks.size() ? self.blocks[index] : nil
  }

  # The body the non-streaming endpoint would have sent.
  finish() {
    return self.failure if self.failure != nil
    {
      content: self.blocks.filter(|b| b != nil).map(|b| block_of(b)),
      stop_reason: self.stop_reason,
      usage: {input_tokens: self.sent, output_tokens: self.received},
    }
  }
}

fn block_of(b) {
  if b.kind == 'tool_use' {
    return {type: 'tool_use', id: b.id, name: b.name, input: args_of(b.json)}
  }
  if b.kind == 'thinking' {
    # The signature is what makes the block checkable when it goes back, and a
    # block that never carried one is sent as it came rather than with an empty
    # one invented for it.
    return b.signature.empty()
      ? {type: 'thinking', thinking: b.text}
      : {type: 'thinking', thinking: b.text, signature: b.signature}
  }
  if b.kind == 'redacted_thinking' {
    return {type: 'redacted_thinking', data: b.data}
  }
  {type: 'text', text: b.text}
}

# A document written across deltas, read once it is whole. A turn cut short
# leaves it unfinished, which is answered with an empty call rather than a
# raised SyntaxError — the same choice the other format makes for the same
# reason (providers/openai.cul, `args_of`).
fn args_of(text) {
  return {} if text.empty()
  let parsed = try {
    JSON.parse(text)
  } catch _e {
    nil
  }
  parsed ?? {}
}

# This format's three names, onto the set both providers answer with.
fn finish_reason_of(stop_reason) {
  match stop_reason {
    'end_turn'   => 'stop',
    'tool_use'   => 'tool_calls',
    'max_tokens' => 'length',
    _            => 'stop',
  }
}

fn usage_of(u) {
  if u == nil {
    return {}
  }
  let sent = u.input_tokens ?? 0
  let received = u.output_tokens ?? 0
  {prompt_tokens: sent, completion_tokens: received,
   total_tokens: sent + received}
}

export {create_anthropic, AnthropicModel, AnthropicStream}
export {system_blocks, turns_of, tools_of, read_reply, finish_reason_of}
