import anthropic from './anthropic.cul'
import openai from './openai.cul'
import err from '../core/errors.cul'

# Ported from upstream's `src/providers/modelFactory.ts`.
#
# Three variables name the model: `LLM_PROVIDER` picks the format to speak,
# `LLM_MODEL` the model id, and `LLM_API_KEY` the key when the provider's own
# variable is not already set. The first two have no default — a stale default
# model id fails in a way that reads as the endpoint's fault rather than the
# setting's.
#
# Where to connect is the provider's business, not this file's, exactly as
# upstream leaves it to the SDK: `OPENAI_BASE_URL` and `ANTHROPIC_BASE_URL`
# move a format to another address. That is all OpenRouter needs —
#
#     LLM_PROVIDER=openai
#     LLM_MODEL=openai/gpt-oss-20b
#     LLM_API_KEY=$OPENROUTER_API_KEY
#     OPENAI_BASE_URL=https://openrouter.ai/api/v1
#
# and it serves the other format at /api/v1/messages, so `LLM_PROVIDER=anthropic`
# with `ANTHROPIC_BASE_URL` set there reaches the same model through the other
# wire. One key, two formats, nothing else changed.

# Upstream's third provider, Google, is not ported: it is a third wire format
# and neither of the two here is written in terms of it.
let PROVIDERS = {
  openai: {key: 'OPENAI_API_KEY', create: openai.create_openai},
  anthropic: {key: 'ANTHROPIC_API_KEY', create: anthropic.create_anthropic},
}

fn create_model_from_env() {
  let provider = Sys.env('LLM_PROVIDER', '')
  if provider.empty() {
    throw err.agent_error('no_provider', 'LLM_PROVIDER is not set')
  }
  let model_id = Sys.env('LLM_MODEL', '')
  if model_id.empty() {
    throw err.agent_error('no_model', 'LLM_MODEL is not set')
  }
  create_model(provider, model_id, Sys.env('LLM_API_KEY', ''))
}

# Split from the environment so a test can name a provider without one.
fn create_model(provider, model_id, api_key) {
  let chosen = PROVIDERS.get(provider.lower(), nil)
  if chosen == nil {
    throw err.agent_error('unknown_provider',
      "unsupported provider: {provider}. supported providers: " +
      PROVIDERS.keys().join(', '))
  }
  chosen.create(config_for(chosen.key, api_key))(model_id)
}

# Upstream copies `LLM_API_KEY` into the provider's own variable only when that
# one is unset, so a provider-specific key wins. An empty config is not the
# same as an empty key: it leaves the provider to read its own variable.
fn config_for(own_var, api_key) {
  let own = Sys.env(own_var, '')
  let key = own.empty() ? api_key : own
  key.empty() ? {} : {api_key: key}
}

export {create_model_from_env, create_model, config_for, PROVIDERS}
