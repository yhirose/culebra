import agent from './core/agent.cul'
import msg from './core/message.cul'
import err from './core/errors.cul'

# Ported from upstream's `src/core/agent.test.ts`. The loop is driven by a
# scripted model, so the whole of chapter 5 — tool dispatch, the approval gate,
# a tool that throws, the step budget — and chapter 6's compression run with no
# API key and no network.
#
# `generate` answers with the model's last words and nothing else, as upstream
# does, so what the loop did is read off the model: `seen` is one entry per
# turn, holding the history it was asked with.
#
# The streaming half of the loop is exercised in test_streaming.cul, where the
# two ways of asking are run against each other.

# A model that answers from a list, and remembers what it was asked.
class ScriptedModel {
  new(replies) {
    self.replies = replies
    self.seen = []
  }

  do_generate(params) {
    # The agent keeps pushing onto the array it passed, so what is recorded
    # has to be a copy — otherwise every entry here would be the same live
    # history, read after the run rather than during it.
    self.seen.push(params.messages.slice(0, params.messages.size()))
    let i = self.seen.size() - 1
    i < self.replies.size() ? self.replies[i] : {text: 'nothing more to do.'}
  }

  last_messages() {
    self.seen[self.seen.size() - 1]
  }
}

fn a_tool(name, needs_approval, run) {
  {
    name: name,
    description: 'a tool, for testing',
    needs_approval: needs_approval,
    parameters: {type: 'object', properties: {}, required: []},
    execute: run,
  }
}

fn calls_a_tool(n, name) {
  {
    text: "step {n}",
    tool_calls: [{tool_call_id: "call_{n}", name: name, args: {}}],
  }
}

fn an_agent(model, tools, extra) {
  agent.Agent.new({
    name: 'test-agent',
    instructions: 'do as you are told',
    model: model,
    tools: tools,
    max_steps: extra.max_steps ?? 5,
    verbose: extra.verbose,
    approval_func: extra.approval_func,
  })
}

fn last_of(messages) {
  messages[messages.size() - 1]
}

# --- the loop ---------------------------------------------------------------

@test
fn runs_a_tool_then_finishes() {
  let model = ScriptedModel.new([
    {
      text: 'I will search.',
      tool_calls: [{tool_call_id: 'call_1', name: 'search',
                    args: {query: 'test'}}],
    },
    {text: 'Found it. Done.'},
  ])
  let tools = {
    search: a_tool('search', false, fn (args) { "results for {args.query}" }),
  }
  let r = an_agent(model, tools, {}).generate('please search')

  assert_eq(r.text, 'Found it. Done.')
  assert_eq(model.seen.size(), 2)

  # The second call saw the result of the first, which is the whole point of
  # the loop: the model reads its own tool output as history.
  let seen = model.last_messages()
  assert_eq(msg.role_of(last_of(seen)), 'tool')
  assert_eq(msg.tool_name_of(last_of(seen)), 'search')
  assert_eq(msg.content_of(last_of(seen)), 'results for test')
}

@test
fn every_call_starts_a_conversation_of_its_own() {
  let model = ScriptedModel.new([{text: 'It is four.'}, {text: 'Still four.'}])
  let a = an_agent(model, {}, {})
  a.generate('what is two and two')
  a.generate('are you sure')

  # Instructions and the question, and nothing carried over: a run is one task,
  # and the agent is not a session.
  assert_eq(model.last_messages().map(|m| msg.role_of(m)), ['system', 'user'])
  assert_eq(msg.content_of(last_of(model.last_messages())), 'are you sure')
}

@test
fn the_last_words_are_what_comes_back() {
  # Text arrives on the turn that also calls a tool, and again at the end. What
  # the caller gets is the last of them.
  let model = ScriptedModel.new([
    {text: 'working on it',
     tool_calls: [{tool_call_id: 'c1', name: 'noop', args: {}}]},
    {text: 'all done'},
  ])
  let tools = {noop: a_tool('noop', false, fn (_args) { 'ok' })}
  assert_eq(an_agent(model, tools, {}).generate('go').text, 'all done')
}

@test
fn what_a_provider_asks_to_have_back_stays_on_the_turn() {
  # The loop does not read them; it keeps them attached to the turn they came
  # from, so the next request carries them.
  let block = {type: 'thinking', thinking: 'first, look around'}
  let model = ScriptedModel.new([
    {text: '', reasoning_blocks: [block],
     tool_calls: [{tool_call_id: 'c1', name: 'noop', args: {}}]},
    {text: 'done'},
  ])
  let tools = {noop: a_tool('noop', false, fn (_args) { 'ok' })}
  an_agent(model, tools, {}).generate('go')

  let sent = model.last_messages()
  let assistant = sent.find(|m| msg.role_of(m) == 'assistant')
  assert_eq(msg.reasoning_blocks_of(assistant), [block])
}

@test
fn stops_at_the_step_budget() {
  # Always another tool call: only the budget can end this.
  let model = ScriptedModel.new([1, 2, 3].map(|n| calls_a_tool(n, 'dummy')))
  let tools = {dummy: a_tool('dummy', false, fn (_args) { 'ok' })}
  an_agent(model, tools, {max_steps: 3}).generate('never end')

  assert_eq(model.seen.size(), 3)
}

# --- the approval gate ------------------------------------------------------

@test
fn an_approved_call_runs() {
  let ran = []
  let model = ScriptedModel.new([calls_a_tool(1, 'write')])
  let tools = {
    write: a_tool('write', true, fn (args) { ran.push(args); 'written' }),
  }
  an_agent(model, tools, {max_steps: 2,
                          approval_func: |_name, _args| true})
    .generate('write it')

  assert_eq(ran.size(), 1)
  assert_eq(msg.content_of(last_of(model.last_messages())), 'written')
}

@test
fn a_refused_call_does_not_run() {
  let ran = []
  let model = ScriptedModel.new([calls_a_tool(1, 'write')])
  let tools = {
    write: a_tool('write', true, fn (args) { ran.push(args); 'written' }),
  }
  an_agent(model, tools, {max_steps: 2,
                          approval_func: |_name, _args| false})
    .generate('write it')

  assert_eq(ran.size(), 0)
  # The refusal is in the history, so the model can try something else rather
  # than wait for a result that is never coming.
  assert_eq(msg.content_of(last_of(model.last_messages())), agent.CANCELLED)
}

@test
fn a_tool_without_needs_approval_is_never_asked_about() {
  let asked = []
  let model = ScriptedModel.new([calls_a_tool(1, 'read')])
  let tools = {read: a_tool('read', false, fn (_args) { 'contents' })}
  an_agent(model, tools, {max_steps: 2,
                          approval_func: |name, _args| asked.push(name)})
    .generate('read it')

  assert_eq(asked.size(), 0)
  assert_eq(msg.content_of(last_of(model.last_messages())), 'contents')
}

# --- what the model is told when a call goes wrong --------------------------

@test
fn an_unknown_tool_comes_back_as_a_result() {
  let model = ScriptedModel.new([calls_a_tool(1, 'nope')])
  an_agent(model, {}, {max_steps: 2}).generate('use a missing tool')

  let told = msg.content_of(last_of(model.last_messages()))
  assert_true(told.contains('tool nope not found'))
}

@test
fn a_tool_that_throws_comes_back_as_a_result() {
  let model = ScriptedModel.new([calls_a_tool(1, 'boom')])
  let tools = {
    boom: a_tool('boom', false, fn (_args) {
      throw err.tool_error('boom', 'not_found', 'no such file: x.txt')
    }),
  }
  # The step after it still happens: a failing tool is a fact to report, not
  # the end of the run.
  an_agent(model, tools, {max_steps: 2}).generate('break something')

  assert_eq(model.seen.size(), 2)
  let told = msg.content_of(last_of(model.last_messages()))
  assert_true(told.contains('no such file: x.txt'))
}

@test
fn a_tool_is_run_by_name_not_by_the_key_it_was_filed_under() {
  # The model calls what the schema advertised, and the schema carries `name`.
  let model = ScriptedModel.new([calls_a_tool(1, 'search')])
  let tools = {anything: a_tool('search', false, fn (_args) { 'found' })}
  an_agent(model, tools, {max_steps: 2}).generate('go')

  assert_eq(msg.content_of(last_of(model.last_messages())), 'found')
}

# --- context compression ----------------------------------------------------

@test
fn a_short_history_is_left_alone() {
  let a = an_agent(ScriptedModel.new([]), {}, {})
  let history = [msg.system('instructions'), msg.user('hello')]
  assert_eq(a.manage_context(history).size(), 2)
}

@test
fn a_long_history_is_compressed_before_it_is_sent() {
  # Four tool results of 12,000 characters: the third step is where the
  # history first passes the limit.
  let model = ScriptedModel.new([1, 2, 3, 4].map(|n| calls_a_tool(n, 'big')))
  let tools = {
    big: a_tool('big', false, fn (_args) { 'result'.repeat(2000) }),
  }
  an_agent(model, tools, {max_steps: 6}).generate('start')

  assert_eq(model.seen.size(), 5)
  let sent = model.last_messages()
  let total = sent.map(|m| msg.content_of(m).size()).sum()
  assert_true(total <= agent.CHAR_LIMIT)
  assert_true(sent.any(|m| msg.content_of(m).contains('was omitted')))

  # What survives is the shape the model needs: its instructions, and the
  # thread it is in the middle of.
  assert_eq(msg.role_of(sent[0]), 'system')
  assert_eq(msg.role_of(last_of(sent)), 'tool')
}

# --- what a run prints ------------------------------------------------------
#
# Not upstream's: the log is this port's, and it is the only account of a run
# there is. `IO.capture` reads back what a call printed rather than what it
# returned (stdlib §2).

fn verbose_output(model, tools, max_steps) {
  IO.capture(fn () {
    an_agent(model, tools, {max_steps: max_steps, verbose: true}).generate('go')
  })
}

@test
fn a_call_and_its_result_are_logged() {
  let model = ScriptedModel.new([calls_a_tool(1, 'search'), {text: 'done'}])
  let tools = {search: a_tool('search', false, fn (_args) { 'found it' })}
  let out = verbose_output(model, tools, 5)

  assert_true(out.contains('=== step 1/5 ==='))
  assert_true(out.contains('[tool] search({})'))
  assert_true(out.contains('[result] found it'))
}

@test
fn a_call_naming_a_tool_that_is_not_there_is_logged_too() {
  # The step ends before the `[tool]` line, so this one used to print nothing
  # at all: a verbose run went quiet with no reason given.
  let model = ScriptedModel.new([calls_a_tool(1, 'nope'), {text: 'done'}])
  let out = verbose_output(model, {}, 5)

  assert_true(out.contains('[tool] nope: no such tool'))
}

@test
fn reaching_the_step_budget_warns() {
  let model = ScriptedModel.new([1, 2].map(|n| calls_a_tool(n, 'dummy')))
  let tools = {dummy: a_tool('dummy', false, fn (_args) { 'ok' })}

  assert_true(verbose_output(model, tools, 2)
    .contains('warning: reached the maximum number of steps'))
}

@test
fn answering_without_using_a_tool_warns() {
  let model = ScriptedModel.new([{text: 'nothing to do'}])

  assert_true(verbose_output(model, {}, 5)
    .contains('warning: finished without using a tool'))
}

@test
fn a_quiet_run_prints_what_the_model_said_and_nothing_else() {
  let model = ScriptedModel.new([calls_a_tool(1, 'search'), {text: 'done'}])
  let tools = {search: a_tool('search', false, fn (_args) { 'found it' })}
  let out = IO.capture(fn () {
    an_agent(model, tools, {}).generate('go')
  })

  assert_eq(out, "step 1\ndone\n")
}

# --- a tool that fails is not an exception ----------------------------------

@test
fn execute_tool_answers_with_the_failure_rather_than_raising() {
  let boom = a_tool('boom', false, fn (_args) {
    throw err.tool_error('boom', 'not_found', 'no such file')
  })
  assert_true(agent.execute_tool(boom, {}).contains('no such file'))
  let fine = a_tool('fine', false, fn (_args) { 'ok' })
  assert_eq(agent.execute_tool(fine, {}), 'ok')
}
