import factory from './providers/model_factory.cul'
import agent from './core/agent.cul'
import approval from './core/approval.cul'

# One conversation, twice, over a real socket: one server, one model id, one
# set of tools, reached once through each wire. What a stub cannot check is
# exactly what breaks in practice — the path joined onto the base URL, the
# auth header actually reaching the other side, and a body the far end can
# parse. Both routes live on the same server because that is the claim being
# made: where to connect and how to speak are separate choices.
#
# The server's handlers run on a worker pool and must be Sendable, so they
# cannot write into a variable out here. They report what they saw by putting
# it in the reply instead, and the assertions read it off the agent's result.

fn fake_api() {
  let srv = Http.server()

  srv.post('/v1/messages', fn (req) {
    let body = JSON.parse(req.body)
    let seen = "auth={req.headers['Authorization']} model={body.model} " +
               "tools={(body.tools ?? []).size()} turns={body.messages.size()} " +
               "system={body.system}"

    # A history carrying a tool result is the second turn; answer it in words
    # so the loop ends. Here a result arrives as a user turn of blocks.
    if body.messages.any(|m| type_of(m.content) == 'Array') {
      return JSON.stringify({
        content: [{type: 'text', text: seen}],
        stop_reason: 'end_turn',
      })
    }
    JSON.stringify({
      content: [
        {type: 'text', text: seen},
        {type: 'tool_use', id: 'c1', name: 'echo', input: {say: 'hi'}},
      ],
      stop_reason: 'tool_use',
    })
  })

  srv.post('/v1/chat/completions', fn (req) {
    let body = JSON.parse(req.body)
    let seen = "auth={req.headers['Authorization']} model={body.model} " +
               "tools={(body.tools ?? []).size()} turns={body.messages.size()} " +
               "system={body.messages[0].content}"

    # The same question in this format's terms: a result is a turn of its own
    # role.
    if body.messages.any(|m| m.role == 'tool') {
      return JSON.stringify({
        choices: [{message: {content: seen}, finish_reason: 'stop'}],
      })
    }
    JSON.stringify({
      choices: [{
        message: {
          content: seen,
          tool_calls: [{id: 'c1', type: 'function',
                        function: {name: 'echo', arguments: '{"say": "hi"}'}}],
        },
        finish_reason: 'tool_calls',
      }],
    })
  })

  srv
}

fn an_echo_tool() {
  {
    name: 'echo',
    description: 'say something back',
    needs_approval: false,
    params: {say: {type: 'string', doc: 'what to say'}},
    run: fn (args) { "echo: {args.say}" },
  }
}

fn talk_over(wire, port) {
  let conn = factory.connection({
    LLM_ENDPOINT: 'openrouter',
    LLM_WIRE: wire,
    LLM_API_KEY: 'test-key',
    LLM_BASE_URL: "http://127.0.0.1:{port}/v1",
    LLM_MODEL: 'a/model',
  })
  agent.Agent.new({
    name: 'nano-code',
    instructions: 'be brief',
    model: factory.connect(conn),
    tools: {echo: an_echo_tool()},
    max_steps: 4,
    approve: approval.approve_all,
  }).generate('say hi')
}

@test
fn both_wires_reach_the_same_endpoint_over_a_real_socket() {
  let srv = fake_api()
  let port = srv.listen_async(0, '127.0.0.1')
  defer { srv.stop() }

  let over_anthropic = talk_over('anthropic', port)
  let over_openai = talk_over('openai', port)

  # Same conversation either way: the loop asks, runs the one tool, and ends.
  # Only the spelling of the request changed.
  for r in [over_anthropic, over_openai] {
    assert_eq(r.steps, 2)
    assert_eq(r.tool_runs, 1)
    assert_true(r.text.contains('auth=Bearer test-key'))
    assert_true(r.text.contains('model=a/model'))
    assert_true(r.text.contains('tools=1'))
    assert_true(r.text.contains('system=be brief'))
  }

  # Where they differ is the shape the server saw. The system prompt is a
  # field of its own on one wire and the first turn on the other, so the same
  # history is three turns there and four here.
  assert_true(over_anthropic.text.contains('turns=3'))
  assert_true(over_openai.text.contains('turns=4'))
}
