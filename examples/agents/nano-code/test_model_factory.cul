import factory from './providers/model_factory.cul'

# Ported from upstream's `src/providers/modelFactory.test.ts`.
#
# `create_model` takes the three settings as arguments rather than reading them
# itself, so every branch — which format, which key wins, what an unknown name
# does — is testable with no environment to set up and no key.

fn factory_reason_of(f) {
  try {
    f()
    nil
  } catch e {
    e.reason
  }
}

@test
fn builds_a_model_for_each_supported_provider() {
  # A provider is a function from a model id to a model, so what comes back
  # answers `do_generate` without anything having been sent.
  for name in ['openai', 'anthropic'] {
    let model = factory.create_model(name, 'a-model', 'k')
    assert_eq(model.model_id, 'a-model')
  }
}

@test
fn the_provider_name_is_read_without_regard_to_case() {
  assert_eq(factory.create_model('OpenAI', 'a-model', 'k').model_id, 'a-model')
}

@test
fn an_unsupported_provider_says_which_ones_are() {
  let raised = try {
    factory.create_model('carrier-pigeon', 'a-model', 'k')
    nil
  } catch e {
    e
  }
  assert_eq(raised.reason, 'unknown_provider')
  assert_true(raised.message.contains('openai'))
  assert_true(raised.message.contains('anthropic'))
}

@test
fn a_providers_own_key_wins_over_the_shared_one() {
  # Upstream copies LLM_API_KEY into the provider's variable only when that one
  # is unset. Nothing here sets OPENAI_API_KEY, so the shared key is what a
  # config would carry.
  assert_eq(factory.config_for('OPENAI_API_KEY', 'shared'),
            {api_key: 'shared'})
  # And with neither, an empty config: the provider then reads its own
  # variable, which is not the same as being handed an empty key.
  assert_eq(factory.config_for('OPENAI_API_KEY', ''), {})
  # A name no environment defines stands in for "the provider's own is unset".
  assert_eq(factory.config_for('NANO_CODE_NO_SUCH_KEY', 'shared'),
            {api_key: 'shared'})
}

@test
fn an_unset_provider_is_an_unknown_one() {
  # `LLM_PROVIDER` unset reaches here as the empty string, and there is no
  # provider by that name.
  assert_eq(factory_reason_of(fn () { factory.create_model('', 'm', '') }),
            'unknown_provider')
}
