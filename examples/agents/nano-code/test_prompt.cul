import prompt from './core/prompt.cul'

# The base prompt is read through Dir.embedded from beside core/prompt.cul,
# whichever script imports it; the composition is tested with a base standing
# in for the file.

@test
fn the_base_is_read_from_beside_its_module() {
  assert_true(
    prompt.base_instructions().starts_with('You are a coding assistant'))
}

fn temp_dir() {
  let dir = FS.join(Sys.env('TMPDIR', '/tmp'), 'nano-code-p-' + UUID.v4())
  FS.mkdir(dir)
  dir
}

@test
fn a_workspace_with_nothing_to_say_gets_the_base_unchanged() {
  let dir = temp_dir()
  defer { FS.remove(dir, recursive: true) }
  assert_eq(prompt.with_project_instructions('be helpful.', dir),
            'be helpful.')
}

@test
fn appends_what_the_workspace_says_about_itself() {
  let dir = temp_dir()
  defer { FS.remove(dir, recursive: true) }
  FS.write(FS.join(dir, 'AGENTS.md'), 'Indent with two spaces.')

  let text = prompt.with_project_instructions('be helpful.', dir)
  assert_true(text.contains('# Project-specific instructions'))
  assert_true(text.contains('Indent with two spaces.'))
  # The base is still there: AGENTS.md adds to the instructions rather than
  # replacing them.
  assert_true(text.starts_with('be helpful.'))
}
