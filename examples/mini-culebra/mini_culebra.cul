# mini-culebra: culebra's sequential core, compiled to CodeGen (cpp-vmlib's
# Core-IR) and run on its bytecode executor.
#
# Every samples/*.cul runs unchanged under the real `culebra` binary, which
# is what makes the oracle work: tests/mini_culebra_test.sh diffs this
# compiler's stdout against the real implementation's for every sample.
# Where PL/0 (examples/pl0/) proved the backend carries a static language,
# this proves it carries a dynamic one.
#
# What's in: all scalars (Long incl. hex/binary literals, Float, String
# with '...' raw / "..." interpolated forms, Bool, Nil), the full scalar
# operator set at culebra's own precedence (|| && chained-comparisons
# | ^ & << >> + - * / % unary - ! ~ and right-associative **), block
# scoping with shadowing, if/else (as statement and expression), while,
# return/break/continue, try/catch/throw (and `e.kind`-style property
# reads on caught error objects), defer, named `fn` declarations (mutually
# recursive), first-class closures, println/print -- and, since the
# container batch: Array/Object/Tuple literals with culebra's index rules
# (negative reads wrap, writes don't; a literal object key is immutable,
# a bracket-added one is `mut`; a missing bracket key is KeyError where a
# missing property is nil), destructuring `let`, compound assignment,
# `|x|` lambdas, `for` over arrays / strings (by code point) / objects
# (as (key, value) tuples) / tuples / anything with the iter() protocol
# -- each iteration its own binding, the way closures observe it -- and
# the first slice of the SS18 built-in methods plus inspect / type_of /
# to_string / to_long / range / iota / assert_eq / assert_true /
# assert_false, written in the prelude itself. The match batch adds:
# match (literal / binding / object / array / tuple / nil patterns, with
# guards) and cond as expressions, the ternary and ??, parameter defaults
# (evaluated in the callee, so they can name earlier params), keyword
# arguments, *rest, multimethods dispatched on scalar type annotations
# (DispatchError when nothing matches), UFCS for names outside the
# built-in method set, decorators, named functions as values, and
# let-closures that see their own binding -- the cell->closure->cell
# cycle they can build now falls to cpp-vmlib's tracing backstop. The
# class batch adds: class declarations (constructor via Name(...) or
# Name.new(...); fields all-mutable; instances are ordinary objects whose
# 'class' key holds the class object, exactly culebra's own shape),
# methods with self, structural traits (required signatures + default
# methods, conformance checked by name and arity at class build), typed
# dispatch on class and trait annotations, the operator dunders
# (__add__/__sub__/__mul__/__neg__/__lt__/__eq__/__index__/__str__),
# @derive accepted as a no-op (the default == is already structural), and
# deterministic drop() -- carried to the VM's drop contract, which calls
# a hidden-key closure the moment an instance's refcount reaches zero.
#
# Semantics are culebra's, not the VM's: a prelude of helper functions
# (written in this same subset, compiled alongside the program) wraps every
# operator whose culebra behavior differs from the raw Core-IR node --
# truthiness that rejects non-numeric operands, `==` that answers false
# across types instead of failing, ZeroDivisionError/TypeError objects with
# culebra's kind/message/line/col shape, wrapping MIN/-1 division, float %
# via fmod, int ** with wrapping multiply, whole doubles displayed as
# "4.0" -- so both output and a caught error look the way culebra's do.
# Inside the prelude itself operators compile to raw VM nodes (the prelude
# is type-correct by construction; wrapping its own operators in itself
# would recurse forever).
#
# What's out (deliberately, for now): generators, string subscripts,
# isolates, and fn/class declarations below a function's top level. A closure may not refer to its own binding
# (`let f = fn () { f() }` -- the cell->closure->cell cycle needs the
# Known asymmetries with the real culebra, all
# unreachable from the samples: an arity mismatch and a few other
# executor-level traps surface as IrError-shaped diagnostics rather than
# culebra's ArityError; function values never compare equal; and a line
# beginning with a binary-operator character (`-`, `(`) continues the
# previous expression -- the grammar here skips newlines everywhere, where
# the real parser ends a statement at one.
#
# Run it:  culebra examples/mini-culebra/mini_culebra.cul prog.cul
#          culebra examples/mini-culebra/mini_culebra.cul --ir prog.cul
#          culebra examples/mini-culebra/mini_culebra.cul --bc prog.cul

let grammar = `
  program    <- _ stmt*                                     { no_ast_opt }
  stmt       <- class_d / trait_d / fn_decl / decl / while / for / if / try /
                match / cond_e / return_s / break_s / continue_s / throw_s /
                defer_s / yield_f / yield_v / bare_block / assign / expr
  class_d    <- deco* 'class' __ ident '{' _ method* '}' _
  method     <- ident '(' _ fparams ')' _ ret_ann? block    { no_ast_opt }
  trait_d    <- 'trait' __ ident '{' _ titem* '}' _
  titem      <- ident '(' _ fparams ')' _ ret_ann? block?   { no_ast_opt }
  ret_ann    <- '->' _ ident                                { no_ast_opt }

  fn_decl    <- deco* 'fn' __ ident '(' _ fparams ')' _ ret_ann? block
  deco       <- '@' ident ('(' _ args ')' _)? _             { no_ast_opt }
  fparams    <- (fparam (',' _ fparam)*)?                   { no_ast_opt }
  fparam     <- rest_p / tydef_p / typed_p / def_p / ident
  rest_p     <- '*' ident                                   { no_ast_opt }
  tydef_p    <- ident ':' _ ident '=' !'=' _ expr           { no_ast_opt }
  typed_p    <- ident ':' _ ident                           { no_ast_opt }
  def_p      <- ident '=' !'=' _ expr                       { no_ast_opt }
  params     <- (ident (',' _ ident)*)?                     { no_ast_opt }
  decl       <- decl_kw decl_pat '=' !'=' _ expr
  decl_pat   <- tup_pat / arr_pat / ident
  tup_pat    <- '(' _ ident (',' _ ident)+ ')' _            { no_ast_opt }
  arr_pat    <- '[' _ ident (',' _ ident)* ']' _            { no_ast_opt }
  decl_kw    <- < 'let' / 'mut' > __
  while      <- 'while' __ expr block
  for        <- 'for' __ for_pat 'in' __ expr block
  for_pat    <- tup_pat / ident
  if         <- 'if' __ expr block ('else' __ (if / block))?
  try        <- 'try' _ block 'catch' __ ident block
  return_s   <- 'return' kw_end (!stmt_kw expr)?            { no_ast_opt }
  break_s    <- 'break' kw_end                              { no_ast_opt }
  continue_s <- 'continue' kw_end                           { no_ast_opt }
  throw_s    <- 'throw' __ expr                             { no_ast_opt }
  defer_s    <- 'defer' _ block                             { no_ast_opt }
  yield_f    <- 'yield' kw_end 'from' kw_end expr           { no_ast_opt }
  yield_v    <- 'yield' kw_end expr                         { no_ast_opt }
  bare_block <- block                                       { no_ast_opt }
  assign     <- postfix assign_op _ expr
  assign_op  <- < '+=' / '-=' / '*=' / '/=' / '%=' / '=' !'=' >
  block      <- '{' _ stmt* '}' _                           { no_ast_opt }
  stmt_kw    <- ('let' / 'mut' / 'while' / 'return' / 'break' / 'continue' /
                 'throw' / 'defer') ![a-zA-Z0-9_]

  expr       <- ternary
  ternary    <- nilco ('?' !'?' _ expr ':' _ expr)?
  nilco      <- lor (nilco_op lor)*
  nilco_op   <- < '??' > _
  match      <- 'match' __ expr '{' _ arm (',' _ arm)* (',' _)? '}' _
  arm        <- pattern guard? '=>' _ arm_body              { no_ast_opt }
  guard      <- 'if' __ expr                                { no_ast_opt }
  arm_body   <- block / expr
  cond_e     <- 'cond' _ '{' _ carm (',' _ carm)* (',' _)? '}' _
  carm       <- (wild_p / expr) '=>' _ arm_body             { no_ast_opt }
  pattern    <- nil_p / true_p / false_p / float_p / num_p / str_p /
                obj_p / arr_p / tup_p / wild_p / bind_p
  nil_p      <- 'nil' kw_end                                { no_ast_opt }
  true_p     <- 'true' kw_end                               { no_ast_opt }
  false_p    <- 'false' kw_end                              { no_ast_opt }
  float_p    <- float                                       { no_ast_opt }
  num_p      <- number                                      { no_ast_opt }
  str_p      <- str_sq                                      { no_ast_opt }
  obj_p      <- '{' _ (opat (',' _ opat)*)? '}' _           { no_ast_opt }
  opat       <- ident (':' _ pattern)?                      { no_ast_opt }
  arr_p      <- '[' _ (pattern (',' _ pattern)*)? ']' _     { no_ast_opt }
  tup_p      <- '(' _ pattern (',' _ pattern)+ ')' _        { no_ast_opt }
  wild_p     <- '_' ![a-zA-Z0-9_] _                         { no_ast_opt }
  bind_p     <- ident                                       { no_ast_opt }
  lor        <- land (lor_op land)*
  lor_op     <- < '||' > _
  land       <- cmp (land_op cmp)*
  land_op    <- < '&&' > _
  cmp        <- bor (cmp_op bor)*
  cmp_op     <- < '==' / '!=' / '<=' / '<' !'<' / '>=' / '>' !'>' > _
  bor        <- bxor (bor_op bxor)*
  bor_op     <- < '|' > ![|=] _
  bxor       <- band (bxor_op band)*
  bxor_op    <- < '^' > _
  band       <- shift (band_op shift)*
  band_op    <- < '&' > ![&=] _
  shift      <- add (shift_op add)*
  shift_op   <- < '<<' / '>>' > _
  add        <- mul (add_op mul)*
  add_op     <- < [+-] > ![=] _
  mul        <- unary (mul_op unary)*
  mul_op     <- < [*/%] > !'*' ![=] _
  unary      <- neg / lnot / bnot / power
  neg        <- '-' _ unary                                 { no_ast_opt }
  lnot       <- '!' !'=' _ unary                            { no_ast_opt }
  bnot       <- '~' _ unary                                 { no_ast_opt }
  power      <- postfix (pow_op unary)?
  pow_op     <- < '**' > _
  postfix    <- primary (mcall / pcall / prop / subscript)*
  pcall      <- '(' _ args ')' _                            { no_ast_opt }
  mcall      <- '.' ident '(' _ args ')' _                  { no_ast_opt }
  prop       <- '.' ident                                   { no_ast_opt }
  subscript  <- '[' _ expr ']' _                            { no_ast_opt }
  primary    <- float / number / str_dq / str_sq / true_l / false_l /
                nil_l / closure / lambda / call / if / try / match / cond_e /
                ident / array_lit / object_lit / set_lit / tuple / paren
  array_lit  <- '[' _ (expr (',' _ expr)* (',' _)?)? ']' _  { no_ast_opt }
  object_lit <- '{' _ (obj_pair (',' _ obj_pair)* (',' _)?)? '}' _ { no_ast_opt }
  obj_pair   <- mut_pair / plain_pair
  mut_pair   <- 'mut' __ okey ':' _ expr                    { no_ast_opt }
  plain_pair <- okey ':' _ expr                             { no_ast_opt }
  okey       <- ident / str_sq / nskey
  nskey      <- float / number / true_l / false_l / nil_l / tuple
  set_lit    <- '{' _ expr (',' _ expr)+ (',' _)? '}' _ /
                '{' _ expr ',' _ '}' _                    { no_ast_opt }
  tuple      <- '(' _ expr (',' _ expr)+ (',' _)? ')' _ /
                '(' _ expr ',' _ ')' _                      { no_ast_opt }
  lambda     <- '|' _ params '|' _ expr                     { no_ast_opt }
  paren      <- '(' _ expr ')' _
  closure    <- 'fn' _ '(' _ fparams ')' _ ret_ann? block
  call       <- ident '(' _ args ')' _
  args       <- (argx (',' _ argx)*)?                       { no_ast_opt }
  argx       <- kwarg / expr
  kwarg      <- ident ':' !':' _ expr                       { no_ast_opt }

  true_l     <- 'true' kw_end                               { no_ast_opt }
  false_l    <- 'false' kw_end                              { no_ast_opt }
  nil_l      <- 'nil' kw_end                                { no_ast_opt }
  str_sq     <- "'" < [^']* > "'" _
  str_dq     <- '"' dq_part* '"' _                          { no_ast_opt }
  dq_part    <- interp / dq_chars
  interp     <- '{' _ expr '}'                              { no_ast_opt }
  dq_chars   <- < ('\\' . / [^"{\\])+ >

  keyword    <- ('let' / 'mut' / 'fn' / 'if' / 'else' / 'while' / 'for' /
                 'in' / 'try' / 'catch' / 'return' / 'break' / 'continue' /
                 'throw' / 'defer' / 'true' / 'false' / 'nil' / 'match' /
                 'cond' / 'class' / 'trait') ![a-zA-Z0-9_]
  ident      <- !keyword < [a-zA-Z_] [a-zA-Z0-9_]* > _
  float      <- < [0-9]+ ('.' [0-9]+ ([eE] [+-]? [0-9]+)? /
                          [eE] [+-]? [0-9]+) > _
  number     <- < '0x' [0-9a-fA-F]+ / '0b' [01]+ / [0-9]+ > _
  ~kw_end    <- ![a-zA-Z0-9_] _

  ~_         <- (comment / [ \t\r\n] / ';')*
  ~__        <- ![a-zA-Z0-9_] _
  comment    <- '#' [^\r\n]*
`

fn fail(node, msg) {
  throw {kind: 'MiniError', message: msg, line: node.line, col: node.column}
}

# The prelude and the user program are separate parse trees whose line/col
# coordinates overlap, so every position-keyed side table gets a unit
# prefix.
fn pkey(node) {
  cond {
    in_prelude => "p{node.line}:{node.column}",
    _ => "u{node.line}:{node.column}",
  }
}

# --- The prelude --------------------------------------------------------------
#
# culebra's operator semantics, written in the same subset and compiled in
# front of every program. Prelude bodies compile with raw operators (the
# VM's own nodes, no wrapping) and may call the intrinsic builtins
# (__typeof, __tostr, ...) that user code cannot name. `__error` builds a
# culebra-shaped error object; user code reads it back through `.kind` etc.
# Line/col arguments thread the user program's positions into the error
# objects, so a caught error reports where the operator was, not where the
# prelude is.

let prelude_src = `
fn __raise(kind, msg, line, col) {
  throw __error(kind, msg, line, col)
}

fn __type_name(v) {
  let t = __typeof(v)
  if t == 'int' { return 'Long' }
  if t == 'double' { return 'Float' }
  if t == 'string' { return 'String' }
  if t == 'bool' { return 'Bool' }
  if t == 'nil' { return 'Nil' }
  if t == 'function' { return 'Function' }
  if t == 'array' { return 'Array' }
  if __is_set(v) { return 'Set' }
  if __is_tuple(v) { return 'Tuple' }
  if __is_marker(v) { return 'Function' }
  'Object'
}

fn __truthy(v, line, col) {
  let t = __typeof(v)
  if t == 'bool' { return v }
  if t == 'int' { return v != 0 }
  if t == 'double' { return v != 0.0 }
  __raise('TypeError', 'type error: expected Bool, Long, or Float, got ' +
          __type_name(v), line, col)
}

fn __expect_num(v, line, col) {
  let t = __typeof(v)
  if t != 'int' {
    if t != 'double' {
      __raise('TypeError', 'type error: expected Long or Float, got ' +
              __type_name(v), line, col)
    }
  }
  nil
}

fn __num2(a, b, line, col) {
  __expect_num(a, line, col)
  __expect_num(b, line, col)
  nil
}

fn __scalar_eq(a, b) {
  let t = __typeof(a)
  if t == 'function' { return false }
  if t == 'array' { return false }
  if t == 'object' { return false }
  a == b
}

fn __cmp_ok(a, b, line, col) {
  let ta = __typeof(a)
  let tb = __typeof(b)
  if ta == 'string' {
    if tb == 'string' { return nil }
  }
  if ta == 'bool' {
    if tb == 'bool' { return nil }
  }
  if __is_num(a) {
    if __is_num(b) { return nil }
  }
  __raise('TypeError', 'type error: cannot compare ' + __type_name(a) +
          ' and ' + __type_name(b), line, col)
}

fn __cmpv(v) {
  if __typeof(v) == 'bool' {
    if v { return 1 }
    return 0
  }
  v
}

fn __lt(a, b, line, col) {
  if __inst_dunder(a, '__lt__') {
    return __truthy(__dunder2(a, '__lt__', b, line, col), line, col)
  }
  __cmp_ok(a, b, line, col)
  __cmpv(a) < __cmpv(b)
}
fn __le(a, b, line, col) {
  __cmp_ok(a, b, line, col)
  __cmpv(a) <= __cmpv(b)
}
fn __gt(a, b, line, col) {
  __cmp_ok(a, b, line, col)
  __cmpv(a) > __cmpv(b)
}
fn __ge(a, b, line, col) {
  __cmp_ok(a, b, line, col)
  __cmpv(a) >= __cmpv(b)
}

fn __add(a, b, line, col) {
  if __inst_dunder(a, '__add__') { return __dunder2(a, '__add__', b, line, col) }
  let ta = __typeof(a)
  let tb = __typeof(b)
  if ta == 'string' {
    if tb == 'string' { return a + b }
  }
  if ta == 'array' {
    if tb == 'array' { return __concat(a, b) }
  }
  __arith_ok('+', a, b, line, col)
  a + b
}

fn __is_num(v) {
  let t = __typeof(v)
  if t == 'int' { return true }
  t == 'double'
}

fn __arith_ok(op, a, b, line, col) {
  if __is_num(a) {
    if __is_num(b) { return nil }
  }
  __raise('TypeError', "type error: cannot apply '" + op + "' to " +
          __type_name(a) + ' and ' + __type_name(b), line, col)
}

fn __concat(a, b) {
  mut out = []
  mut i = 0
  while i < __len(a) {
    __arraypush(out, a[i])
    i = i + 1
  }
  mut j = 0
  while j < __len(b) {
    __arraypush(out, b[j])
    j = j + 1
  }
  out
}

fn __sub(a, b, line, col) {
  if __inst_dunder(a, '__sub__') { return __dunder2(a, '__sub__', b, line, col) }
  __arith_ok('-', a, b, line, col)
  a - b
}

fn __mul(a, b, line, col) {
  if __inst_dunder(a, '__mul__') { return __dunder2(a, '__mul__', b, line, col) }
  __arith_ok('*', a, b, line, col)
  a * b
}

fn __zero(b) {
  if __typeof(b) == 'int' { return b == 0 }
  b == 0.0
}

fn __both_int(a, b) {
  if __typeof(a) == 'int' {
    if __typeof(b) == 'int' { return true }
  }
  false
}

fn __div(a, b, line, col) {
  __arith_ok('/', a, b, line, col)
  if __zero(b) { __raise('ZeroDivisionError', 'divide by 0 error', line, col) }
  if __both_int(a, b) {
    if a == (1 << 63) {
      if b == -1 { return 1 << 63 }
    }
  }
  a / b
}

fn __mod(a, b, line, col) {
  __arith_ok('%', a, b, line, col)
  if __zero(b) { __raise('ZeroDivisionError', 'divide by 0 error', line, col) }
  if __both_int(a, b) {
    if a == (1 << 63) {
      if b == -1 { return 0 }
    }
    return a % b
  }
  __fmod(a, b)
}

fn __ipow(base, exp) {
  mut r = 1
  mut b = base
  mut e = exp
  while e > 0 {
    if (e & 1) == 1 { r = r * b }
    b = b * b
    e = e >> 1
  }
  r
}

fn __pow(a, b, line, col) {
  __arith_ok('**', a, b, line, col)
  if __both_int(a, b) {
    if b >= 0 { return __ipow(a, b) }
    if a == 0 { __raise('ZeroDivisionError', 'divide by 0 error', line, col) }
    return __fpow(__todouble(a), __todouble(b))
  }
  __fpow(__todouble(a), __todouble(b))
}

fn __neg(v, line, col) {
  if __inst_dunder(v, '__neg__') { return __dunder1(v, '__neg__', line, col) }
  __expect_num(v, line, col)
  return -v
}

fn __long2(a, b, line, col) {
  if __typeof(a) != 'int' {
    __raise('TypeError', 'type error: expected Long, got ' +
            __type_name(a), line, col)
  }
  if __typeof(b) != 'int' {
    __raise('TypeError', 'type error: expected Long, got ' +
            __type_name(b), line, col)
  }
  nil
}

fn __band(a, b, line, col) {
  __long2(a, b, line, col)
  a & b
}
fn __bor(a, b, line, col) {
  __long2(a, b, line, col)
  a | b
}
fn __bxor(a, b, line, col) {
  __long2(a, b, line, col)
  a ^ b
}
fn __shl(a, b, line, col) {
  __long2(a, b, line, col)
  a << b
}
fn __shr(a, b, line, col) {
  __long2(a, b, line, col)
  a >> b
}
fn __bnot(v, line, col) {
  if __typeof(v) != 'int' {
    __raise('TypeError', 'type error: expected Long, got ' +
            __type_name(v), line, col)
  }
  ~v
}

fn __display(v) {
  let t = __typeof(v)
  if t == 'string' { return v }
  if t == 'array' { return __repr(v) }
  if t == 'object' { return __repr(v) }
  if t == 'function' { return '[function]' }
  __scalar_display(v)
}

fn __getprop(v, name, line, col) {
  if __typeof(v) != 'object' {
    __raise('TypeError', 'type error: expected Object, got ' +
            __type_name(v), line, col)
  }
  if __is_instance(v) {
    if __objecthas(v, name) { return __bind(v[name], v) }
    let cls = v['class']
    let ms = cls['methods']
    if __objecthas(ms, name) {
      return __bind(__mk_selfc(ms[name], cls['arities'][name]), v)
    }
    return nil
  }
  __bind(v[name], v)
}

fn __is_class(v) {
  if __typeof(v) != 'object' { return false }
  if !__objecthas(v, "\zk") { return false }
  v["\zk"] == 'class'
}

fn __is_instance(v) {
  if __typeof(v) != 'object' { return false }
  if !__objecthas(v, 'class') { return false }
  __is_class(v['class'])
}

fn __inst_class_is(v, cname) {
  if !__is_instance(v) { return false }
  v['class']['name'] == cname
}

fn __inst_conf(v, tname) {
  if !__is_instance(v) { return false }
  __objecthas(v['class']['conf'], tname)
}

fn __construct(cls, args, line, col) {
  if !__is_class(cls) {
    __raise('TypeError', 'type error: expected Function, got ' +
            __type_name(cls), line, col)
  }
  mut inst = {}
  inst['class'] = cls
  # the VM's drop contract: a "\zd" prefix cannot be spelled by programs,
  # and the executor calls the stored method with the instance when its
  # refcount hits zero
  if __objecthas(cls['methods'], 'drop') {
    inst["\zdrop"] = cls['methods']['drop']
  }
  let ctor = cls['new']
  __call_self(ctor, inst, args, line, col)
  inst
}

# Apply a method closure to (self, args...), at the caller's arity.
fn __call_self(f, self_v, args, line, col) {
  if __is_marker(f) {
    return __call_self(f["\zb"], __marker_self(f, self_v), args, line, col)
  }
  let n = __len(args)
  if n == 0 { return f(self_v) }
  if n == 1 { return f(self_v, args[0]) }
  if n == 2 { return f(self_v, args[0], args[1]) }
  if n == 3 { return f(self_v, args[0], args[1], args[2]) }
  if n == 4 { return f(self_v, args[0], args[1], args[2], args[3]) }
  __raise('TypeError', 'type error: too many arguments', line, col)
}

fn __inst_dunder(v, name) {
  if !__is_instance(v) { return false }
  __objecthas(v['class']['methods'], name)
}

fn __dunder1(v, name, line, col) {
  __call_self(v['class']['methods'][name], v, [], line, col)
}

fn __dunder2(v, name, o, line, col) {
  __call_self(v['class']['methods'][name], v, [o], line, col)
}

fn __callee_check(v, line, col) {
  if __is_marker(v) { return __as_fn(v, line, col) }
  if __typeof(v) != 'function' {
    __raise('TypeError', 'type error: expected Function, got ' +
            __type_name(v), line, col)
  }
  v
}

fn __mk_tuple(items) {
  mut o = {}
  o["\zt"] = items
  o
}

fn __is_tuple(v) {
  if __typeof(v) != 'object' { return false }
  __objecthas(v, "\zt")
}

fn __titems(t) { t["\zt"] }


fn __destr(v, n, line, col) {
  let t = __typeof(v)
  mut items = []
  mut found = false
  if t == 'array' {
    items = v
    found = true
  }
  if __is_tuple(v) {
    items = __titems(v)
    found = true
  }
  if !found {
    __raise('ValueError', 'destructure pattern did not match value', line, col)
  }
  if __len(items) != n {
    __raise('ValueError', 'destructure pattern did not match value', line, col)
  }
  items
}

fn __type_of(v, line, col) {
  if __is_tuple(v) { return 'Tuple' }
  __type_name(v)
}

fn __eq_list(xs, ys) {
  if __len(xs) != __len(ys) { return false }
  mut i = 0
  while i < __len(xs) {
    if !__truthy(__eq(xs[i], ys[i]), 0, 0) { return false }
    i = i + 1
  }
  true
}

fn __eq_inst_fields(a, b) {
  let ka = __objectkeys(a)
  mut i = 0
  while i < __len(ka) {
    let k = ka[i]
    if k != 'class' {
      if !__objecthas(b, k) { return false }
      if !__truthy(__eq(a[k], b[k]), 0, 0) { return false }
    }
    i = i + 1
  }
  __len(ka) == __len(__objectkeys(b))
}

fn __eq_obj(a, b) {
  let ka = __objectkeys(a)
  mut n = 0
  mut i = 0
  while i < __len(ka) {
    let k = ka[i]
    if !__hidden_key(k) {
      n = n + 1
      if !__objecthas(b, k) { return false }
      if !__truthy(__eq(a[k], b[k]), 0, 0) { return false }
    }
    i = i + 1
  }
  n == __obj_visible_size(b)
}

fn __eq(a, b) {
  let ta = __typeof(a)
  let tb = __typeof(b)
  if ta == tb {
    if ta == 'function' { return __same(a, b) }
    if ta == 'array' {
      if __same(a, b) { return true }
      if tb == 'array' { return __eq_list(a, b) }
    }
    if ta == 'object' {
      if __same(a, b) { return true }
      if __is_marker(a) {
        if !__is_marker(b) { return false }
        if !__same(a["\zb"], b["\zb"]) { return false }
        return __same(__marker_self(a, nil), __marker_self(b, nil))
      }
      if __is_marker(b) { return false }
      let at = __is_tuple(a)
      let bt = __is_tuple(b)
      if at {
        if bt { return __eq_list(__titems(a), __titems(b)) }
        return false
      }
      if bt { return false }
      let asx = __is_set(a)
      let bsx = __is_set(b)
      if asx {
        if bsx { return __set_eq(a, b) }
        return false
      }
      if bsx { return false }
      let ai = __is_instance(a)
      let bi = __is_instance(b)
      if ai {
        if !bi { return false }
        if a['class']['name'] != b['class']['name'] { return false }
        if __inst_dunder(a, '__eq__') {
          return __truthy(__dunder2(a, '__eq__', b, 0, 0), 0, 0)
        }
        return __eq_inst_fields(a, b)
      }
      if bi { return false }
      return __eq_obj(a, b)
    }
    return a == b
  }
  if ta == 'int' {
    if tb == 'double' { return a == b }
  }
  if ta == 'double' {
    if tb == 'int' { return a == b }
  }
  false
}

fn __repr(v) {
  let t = __typeof(v)
  if t == 'string' { return "'" + v + "'" }
  if t == 'function' { return '[function]' }
  if t == 'array' {
    mut out = '['
    mut i = 0
    while i < __len(v) {
      if i > 0 { out = out + ', ' }
      out = out + __repr(v[i])
      i = i + 1
    }
    return out + ']'
  }
  if t == 'object' {
    if __is_marker(v) { return '[function]' }
    if __is_tuple(v) {
      let items = __titems(v)
      mut out = '('
      mut i = 0
      while i < __len(items) {
        if i > 0 { out = out + ', ' }
        out = out + __repr(items[i])
        i = i + 1
      }
      if __len(items) == 1 { out = out + ',' }
      return out + ')'
    }
    if __is_instance(v) {
      if __inst_dunder(v, '__str__') {
        return __dunder1(v, '__str__', 0, 0)
      }
      let ks = __objectkeys(v)
      mut out = v['class']['name'] + ' {'
      mut first = true
      mut i = 0
      while i < __len(ks) {
        let k = ks[i]
        if k != 'class' {
          if !__hidden_key(k) {
            if !first { out = out + ', ' }
            first = false
            out = out + 'mut ' + k + ': ' + __repr(v[k])
          }
        }
        i = i + 1
      }
      return out + '}'
    }
    if __is_set(v) { return __set_repr(v) }
    mut muts = {}
    mut has_muts = false
    if __objecthas(v, "\zm") {
      muts = v["\zm"]
      has_muts = true
    }
    let ks = __objectkeys(v)
    mut out = '{'
    mut first = true
    mut i = 0
    while i < __len(ks) {
      let k = ks[i]
      if !__hidden_key(k) {
        if !first { out = out + ', ' }
        first = false
        if has_muts {
          if __objecthas(muts, k) { out = out + 'mut ' }
        }
        out = out + __key_repr(v, k) + ': ' + __repr(v[k])
      }
      i = i + 1
    }
    return out + '}'
  }
  __scalar_display(v)
}

fn __scalar_display(v) {
  if __typeof(v) == 'double' {
    let s = __tostr(v)
    mut i = 0
    mut plain = true
    while i < __len(s) {
      let ch = s[i]
      if ch == '.' { plain = false }
      if ch == 'e' { plain = false }
      if ch == 'n' { plain = false }
      if ch == 'f' { plain = false }
      i = i + 1
    }
    if plain { return s + '.0' }
    return s
  }
  __tostr(v)
}

fn __obj_visible_size(v) {
  let ks = __objectkeys(v)
  mut n = 0
  mut i = 0
  while i < __len(ks) {
    if !__hidden_key(ks[i]) { n = n + 1 }
    i = i + 1
  }
  n
}

fn __setindex(recv, key, val, is_prop, line, col) {
  let t = __typeof(recv)
  if t == 'array' {
    if __typeof(key) != 'int' {
      __raise('TypeError', 'type error: expected Long, got ' +
              __type_name(key), line, col)
    }
    if key < 0 { __raise('IndexError', 'index out of range', line, col) }
    if key >= __len(recv) {
      __raise('IndexError', 'index out of range', line, col)
    }
    recv[key] = val
    return nil
  }
  if t == 'object' {
    if __is_tuple(recv) {
      __raise('TypeError', 'type error: expected Object, Array, or Tensor, got Tuple',
              line, col)
    }
    if __is_set(recv) {
      __raise('TypeError', 'type error: expected Object, Array, or Tensor, got Set',
              line, col)
    }
    let pk = __hkey(key, line, col)
    if __is_instance(recv) {
      # instance fields are all mutable, dot and bracket alike
      recv[pk] = val
      __record_key(recv, pk, key)
      return nil
    }
    if __objecthas(recv, pk) {
      mut ok = false
      if __objecthas(recv, "\zm") {
        if __objecthas(recv["\zm"], pk) { ok = true }
      }
      if !ok {
        if __is_nsk(pk) {
          __raise('ImmutableError', 'immutable entry on non-String key',
                  line, col)
        }
        __raise('ImmutableError', "immutable property '" + pk + "'",
                line, col)
      }
      recv[pk] = val
      return nil
    }
    if is_prop == 1 {
      __raise('ImmutableError', "immutable property '" + pk + "'",
              line, col)
    }
    if !__objecthas(recv, "\zm") {
      mut fresh = {}
      recv["\zm"] = fresh
    }
    let muts = recv["\zm"]
    muts[pk] = true
    recv[pk] = val
    __record_key(recv, pk, key)
    return nil
  }
  __raise('TypeError', 'type error: expected Object, Array, or Tensor, got ' +
          __type_name(recv), line, col)
}

fn __getindex(v, k, line, col) {
  let t = __typeof(v)
  if t == 'array' {
    if __typeof(k) != 'int' {
      __raise('TypeError', 'type error: expected Long, got ' +
              __type_name(k), line, col)
    }
    mut i = k
    if i < 0 { i = i + __len(v) }
    if i < 0 { __raise('IndexError', 'index out of range', line, col) }
    if i >= __len(v) { __raise('IndexError', 'index out of range', line, col) }
    return v[i]
  }
  if t == 'object' {
    if __is_tuple(v) {
      if __typeof(k) != 'int' {
        __raise('TypeError', 'type error: expected Long, got ' +
                __type_name(k), line, col)
      }
      let items = __titems(v)
      mut i = k
      if i < 0 { i = i + __len(items) }
      if i < 0 { __raise('IndexError', 'index out of range', line, col) }
      if i >= __len(items) {
        __raise('IndexError', 'index out of range', line, col)
      }
      return items[i]
    }
    if __is_instance(v) {
      if __inst_dunder(v, '__index__') {
        return __dunder2(v, '__index__', k, line, col)
      }
    }
    if __is_set(v) {
      __raise('TypeError', 'type error: expected Array, got Set', line, col)
    }
    let pk = __hkey(k, line, col)
    if !__objecthas(v, pk) {
      __raise('KeyError', 'key not present', line, col)
    }
    return v[pk]
  }
  __raise('TypeError', 'type error: expected Object, Array, or Tensor, got ' +
          __type_name(v), line, col)
}

fn __getindex_or_prop(recv, key, is_prop, line, col) {
  if is_prop == 1 { return __getprop(recv, key, line, col) }
  __getindex(recv, key, line, col)
}

fn __cp_len(c) {
  mut l = 1
  if c >= "\y" { l = 2 }
  if c >= "\x" { l = 3 }
  if c >= "\w" { l = 4 }
  l
}




fn __gen_wrap(raw) {
  mut la = nil
  mut has_la = false
  mut done = false
  mut disposed = false
  mut obj = {}
  fn advance() {
    let r = __genresume(raw, nil)
    let v = r['value']
    cond {
      r['done'] => { done = true },
      __typeof(v) == 'string' && v == "\zgend" => { done = true },
      _ => {
        la = v
        has_la = true
      },
    }
  }
  obj['iter'] = fn () { obj }
  obj['has_next'] = fn () {
    if !has_la {
      if !done { advance() }
    }
    has_la
  }
  obj['next'] = fn () {
    if !has_la {
      if !done { advance() }
    }
    cond {
      has_la => {
        has_la = false
        let v = la
        la = nil
        v
      },
      _ => nil,
    }
  }
  obj['dispose'] = fn () {
    if !disposed {
      disposed = true
      __genreturn(raw, nil)
      nil
    }
  }
  obj
}

fn __iter_close(it) {
  if __has_proto(it, 'dispose') { __invoke(it, 'dispose', [], 0, 0) }
  nil
}

fn __closer(it) {
  fn () { __iter_close(it) }
}



fn __range2(a, b, line, col) {
  let base = __range_iter(a, b)
  {iter: fn () { __range_iter(a, b) },
   has_next: base['has_next'],
   next: base['next']}
}

fn __range1(n, line, col) { __range2(0, n, line, col) }

fn __iota2(a, b, line, col) {
  mut out = []
  mut i = a
  while i < b {
    __arraypush(out, i)
    i = i + 1
  }
  out
}

fn __iota1(n, line, col) { __iota2(0, n, line, col) }

fn __inspect(v, line, col) {
  println(__repr(v))
  nil
}

fn __to_string(v, line, col) { __display(v) }

fn __to_long(v, line, col) {
  let t = __typeof(v)
  if t == 'int' { return v }
  if t == 'double' { return __toint(v) }
  if t == 'string' {
    mut i = 0
    mut sign = 1
    if __len(v) > 0 {
      if v[0] == '-' {
        sign = 0 - 1
        i = 1
      }
    }
    if i >= __len(v) { __raise('TypeError', 'type error', line, col) }
    mut out = 0
    while i < __len(v) {
      let c = v[i]
      if c < '0' { __raise('TypeError', 'type error', line, col) }
      if c > '9' { __raise('TypeError', 'type error', line, col) }
      out = out * 10 + __digit(c)
      i = i + 1
    }
    return sign * out
  }
  __raise('TypeError', 'type error', line, col)
}

fn __digit(c) {
  if c == '0' { return 0 }
  if c == '1' { return 1 }
  if c == '2' { return 2 }
  if c == '3' { return 3 }
  if c == '4' { return 4 }
  if c == '5' { return 5 }
  if c == '6' { return 6 }
  if c == '7' { return 7 }
  if c == '8' { return 8 }
  9
}

fn __to_float(v, line, col) {
  let t = __typeof(v)
  if t == 'int' { return __todouble(v) }
  if t == 'double' { return v }
  __raise('TypeError', 'type error', line, col)
}

fn __assert_eq(a, b, line, col) {
  if __truthy(__eq(a, b), line, col) { return nil }
  __raise('AssertionError',
          "assert_eq failed:\n  left:  " + __display(a) +
          "\n  right: " + __display(b),
          line, col)
}

fn __assert_true(v, line, col) {
  if __truthy(v, line, col) { return nil }
  __raise('AssertionError', "assert_true failed:\n  value: " + __display(v),
          line, col)
}

fn __assert_false(v, line, col) {
  if __truthy(v, line, col) {
    __raise('AssertionError', "assert_false failed:\n  value: " + __display(v),
            line, col)
  }
  nil
}

# Apply f to an argument array. The IR's CallValue is fixed-arity, so the
# spread is a size switch; five arguments covers every sample.
fn __call_n(f0, args, line, col) {
  let f = __as_fn(f0, line, col)
  let n = __len(args)
  if n == 0 { return f() }
  if n == 1 { return f(args[0]) }
  if n == 2 { return f(args[0], args[1]) }
  if n == 3 { return f(args[0], args[1], args[2]) }
  if n == 4 { return f(args[0], args[1], args[2], args[3]) }
  __raise('TypeError', 'type error: too many arguments', line, col)
}

fn __check_fn(v, line, col) {
  if __is_marker(v) { return __as_fn(v, line, col) }
  if __typeof(v) != 'function' {
    __raise('TypeError', 'type error: expected Function, got ' +
            __type_name(v), line, col)
  }
  v
}

fn __str_index_of(s, sub, from) {
  let n = __len(s)
  let m = __len(sub)
  mut i = from
  while i + m <= n {
    mut j = 0
    mut hit = true
    while j < m {
      if s[i + j] != sub[j] { hit = false }
      j = j + 1
    }
    if hit { return i }
    i = i + 1
  }
  0 - 1
}

fn __str_slice(s, a, b) {
  mut lo = a
  mut hi = b
  if lo < 0 { lo = 0 }
  if hi > __len(s) { hi = __len(s) }
  mut out = ''
  mut i = lo
  while i < hi {
    out = out + s[i]
    i = i + 1
  }
  out
}

fn __is_space(c) {
  if c == ' ' { return true }
  if c == "\t" { return true }
  if c == "\n" { return true }
  if c == "\r" { return true }
  false
}

fn __method(recv, name, args, line, col) {
  let t = __typeof(recv)
  if t == 'array' { return __array_method(recv, name, args, line, col) }
  if t == 'string' { return __string_method(recv, name, args, line, col) }
  if t == 'object' {
    if __is_tuple(recv) { return __tuple_method(recv, name, args, line, col) }
    if __is_set(recv) { return __set_method(recv, name, args, line, col) }
    if __is_instance(recv) {
      let ms = recv['class']['methods']
      if __objecthas(ms, name) {
        return __call_self(ms[name], recv, args, line, col)
      }
      if __objecthas(recv, name) {
        if __is_fn(recv[name]) { return __invoke(recv, name, args, line, col) }
      }
      if __is_iterator(recv) {
        let r = __iter_method(__norm_iter(recv), name, args, line, col)
        mut handled = true
        if __typeof(r) == 'string' {
          if r == "\znomethod" { handled = false }
        }
        if handled { return r }
      }
      return __object_method(recv, name, args, line, col)
    }
    if __is_class(recv) {
      if name == 'new' {
        return __construct(recv, args, line, col)
      }
      __raise('TypeError', 'type error: expected Function, got Nil',
              line, col)
    }
    if __objecthas(recv, name) {
      # a stored closure called as a method; a self-closure gets the receiver
      return __invoke(recv, name, args, line, col)
    }
    if __is_iterator(recv) {
      let r = __iter_method(__norm_iter(recv), name, args, line, col)
      mut handled = true
      if __typeof(r) == 'string' {
        if r == "\znomethod" { handled = false }
      }
      if handled { return r }
    }
    return __object_method(recv, name, args, line, col)
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

fn __array_method(a, name, args, line, col) {
  if name == 'size' { return __len(a) }
  if name == 'empty' { return __len(a) == 0 }
  if name == 'presence' {
    if __len(a) == 0 { return nil }
    return a
  }
  if name == 'iter' { return __arr_iter(a) }
  if name == 'enumerate' { return __it_enumerate(__arr_iter(a)) }
  if name == 'to_set' { return __mk_set(a, line, col) }
  if name == 'push' {
    __arraypush(a, args[0])
    return nil
  }
  if name == 'pop' {
    if __len(a) == 0 { return nil }
    return __arraypop(a)
  }
  if name == 'get' {
    mut i = args[0]
    if i < 0 { i = i + __len(a) }
    if i < 0 { return args[1] }
    if i >= __len(a) { return args[1] }
    return a[i]
  }
  if name == 'slice' {
    mut lo = args[0]
    mut hi = args[1]
    if lo < 0 { lo = 0 }
    if hi > __len(a) { hi = __len(a) }
    mut out = []
    mut i = lo
    while i < hi {
      __arraypush(out, a[i])
      i = i + 1
    }
    return out
  }
  if name == 'join' {
    mut out = ''
    mut i = 0
    while i < __len(a) {
      if i > 0 { out = out + args[0] }
      out = out + __display(a[i])
      i = i + 1
    }
    return out
  }
  if name == 'contains' {
    mut i = 0
    while i < __len(a) {
      if __truthy(__eq(a[i], args[0]), line, col) { return true }
      i = i + 1
    }
    return false
  }
  if name == 'index_of' {
    mut i = 0
    while i < __len(a) {
      if __truthy(__eq(a[i], args[0]), line, col) { return i }
      i = i + 1
    }
    return 0 - 1
  }
  if name == 'map' {
    let f = __check_fn(args[0], line, col)
    mut out = []
    mut i = 0
    while i < __len(a) {
      __arraypush(out, f(a[i]))
      i = i + 1
    }
    return out
  }
  if name == 'filter' {
    let f = __check_fn(args[0], line, col)
    mut out = []
    mut i = 0
    while i < __len(a) {
      if __truthy(f(a[i]), line, col) { __arraypush(out, a[i]) }
      i = i + 1
    }
    return out
  }
  if name == 'for_each' {
    let f = __check_fn(args[0], line, col)
    mut i = 0
    while i < __len(a) {
      f(a[i])
      i = i + 1
    }
    return nil
  }
  if name == 'reduce' {
    let f = __check_fn(args[1], line, col)
    mut acc = args[0]
    mut i = 0
    while i < __len(a) {
      acc = f(acc, a[i])
      i = i + 1
    }
    return acc
  }
  if name == 'find' {
    let f = __check_fn(args[0], line, col)
    mut i = 0
    while i < __len(a) {
      if __truthy(f(a[i]), line, col) { return a[i] }
      i = i + 1
    }
    return nil
  }
  if name == 'any' {
    let f = __check_fn(args[0], line, col)
    mut i = 0
    while i < __len(a) {
      if __truthy(f(a[i]), line, col) { return true }
      i = i + 1
    }
    return false
  }
  if name == 'all' {
    let f = __check_fn(args[0], line, col)
    mut i = 0
    while i < __len(a) {
      if !__truthy(f(a[i]), line, col) { return false }
      i = i + 1
    }
    return true
  }
  if name == 'sum' {
    mut acc = 0
    mut i = 0
    while i < __len(a) {
      acc = __add(acc, a[i], line, col)
      i = i + 1
    }
    return acc
  }
  if name == 'reverse' {
    mut i = 0
    mut j = __len(a) - 1
    while i < j {
      let tmp = a[i]
      a[i] = a[j]
      a[j] = tmp
      i = i + 1
      j = j - 1
    }
    return nil
  }
  if name == 'sorted' {
    mut out = []
    mut i = 0
    while i < __len(a) {
      __arraypush(out, a[i])
      i = i + 1
    }
    mut k = 1
    while k < __len(out) {
      let v = out[k]
      mut j = k - 1
      mut go = true
      while go {
        if j < 0 { go = false }
        if go {
          if __lt(v, out[j], line, col) {
            out[j + 1] = out[j]
            j = j - 1
          } else { go = false }
        }
      }
      out[j + 1] = v
      k = k + 1
    }
    return out
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

fn __string_method(s, name, args, line, col) {
  if name == 'size' { return __len(s) }
  if name == 'empty' { return __len(s) == 0 }
  if name == 'presence' {
    if __len(s) == 0 { return nil }
    return s
  }
  if name == 'iter' { return __str_iter(s) }
  if name == 'contains' { return __str_index_of(s, args[0], 0) >= 0 }
  if name == 'starts_with' {
    let m = __len(args[0])
    if m > __len(s) { return false }
    return __str_slice(s, 0, m) == args[0]
  }
  if name == 'ends_with' {
    let m = __len(args[0])
    if m > __len(s) { return false }
    return __str_slice(s, __len(s) - m, __len(s)) == args[0]
  }
  if name == 'index_of' { return __str_index_of(s, args[0], 0) }
  if name == 'slice' { return __str_slice(s, args[0], args[1]) }
  if name == 'split' {
    let sep = args[0]
    mut out = []
    mut from = 0
    mut go = true
    while go {
      let hit = __str_index_of(s, sep, from)
      if hit < 0 {
        __arraypush(out, __str_slice(s, from, __len(s)))
        go = false
      } else {
        __arraypush(out, __str_slice(s, from, hit))
        from = hit + __len(sep)
      }
    }
    return out
  }
  if name == 'trim' {
    mut lo = 0
    mut hi = __len(s)
    while lo < hi && __is_space(s[lo]) { lo = lo + 1 }
    while hi > lo && __is_space(s[hi - 1]) { hi = hi - 1 }
    return __str_slice(s, lo, hi)
  }
  if name == 'repeat' {
    mut out = ''
    mut i = 0
    while i < args[0] {
      out = out + s
      i = i + 1
    }
    return out
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

fn __object_method(o, name, args, line, col) {
  if name == 'size' { return __obj_visible_size(o) }
  if name == 'empty' { return __obj_visible_size(o) == 0 }
  if name == 'presence' {
    if __obj_visible_size(o) == 0 { return nil }
    return o
  }
  if name == 'keys' {
    let ks = __visible_keys(o)
    mut out = []
    mut i = 0
    while i < __len(ks) {
      __arraypush(out, __key_val(o, ks[i]))
      i = i + 1
    }
    return out
  }
  if name == 'values' {
    let ks = __visible_keys(o)
    mut vis = []
    mut i = 0
    while i < __len(ks) {
      __arraypush(vis, o[ks[i]])
      i = i + 1
    }
    return __arr_iter(vis)
  }
  if name == 'iter' { return __entries_iter(o) }
  if name == 'has' { return __objecthas(o, __hkey(args[0], line, col)) }
  if name == 'get' {
    let pk = __hkey(args[0], line, col)
    if __objecthas(o, pk) { return o[pk] }
    return args[1]
  }
  if name == 'get_or_put' {
    let pk = __hkey(args[0], line, col)
    if __objecthas(o, pk) { return o[pk] }
    mut val = args[1]
    if __typeof(val) == 'function' { val = val() }
    __setindex(o, args[0], val, 0, line, col)
    return val
  }
  if name == 'remove' {
    let pk = __hkey(args[0], line, col)
    if __objecthas(o, pk) { __drop_key(o, pk) }
    return nil
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

# --- Hashable keys: non-String Object keys and Set members ------------------
#
# A non-String key lives under a physical key spelled "\zh" + tag + text
# (type-strict, so 1 / 1.0 / true are three keys); the original value sits
# in the hidden "\zK" table for keys() / iteration / display. The "\zh"
# prefix is the one \z-prefixed key that is *visible*.

fn __hidden_key(k) {
  if k[0] != "\z" { return false }
  k[1] != 'h'
}

fn __is_nsk(pk) { pk[0] == "\z" }

fn __hash_name(v) {
  if __is_set(v) { return 'Set' }
  if __is_marker(v) { return 'Function' }
  let t = __typeof(v)
  if t == 'array' { return 'Array' }
  if t == 'function' { return 'Function' }
  'Object'
}

fn __hkey(v, line, col) {
  let t = __typeof(v)
  if t == 'string' { return v }
  if t == 'int' { return "\zhi" + __tostr(v) }
  if t == 'double' { return "\zhd" + __scalar_display(v) }
  if t == 'bool' {
    if v { return "\zhb1" }
    return "\zhb0"
  }
  if t == 'nil' { return "\zhn" }
  if __is_tuple(v) {
    let items = __titems(v)
    mut out = "\zht"
    mut i = 0
    while i < __len(items) {
      let hk = __hkey(items[i], line, col)
      out = out + __tostr(__len(hk)) + ':' + hk
      i = i + 1
    }
    return out
  }
  let hn = __hash_name(v)
  mut msg = "unhashable type: '" + hn + "'"
  if hn == 'Object' { msg = msg + ' (no hash() method)' }
  __raise('TypeError', msg, line, col)
}

fn __key_val(o, pk) {
  if __is_nsk(pk) { return o["\zK"][pk] }
  pk
}

fn __key_repr(o, pk) {
  if __is_nsk(pk) { return __repr(o["\zK"][pk]) }
  pk
}

fn __record_key(o, pk, key) {
  if !__is_nsk(pk) { return nil }
  if !__objecthas(o, "\zK") {
    mut fresh = {}
    o["\zK"] = fresh
  }
  let tbl = o["\zK"]
  tbl[pk] = key
  nil
}

fn __olit_nsk(o, keys) {
  mut i = 0
  while i < __len(keys) {
    __record_key(o, __hkey(keys[i], 0, 0), keys[i])
    i = i + 1
  }
  o
}

fn __olit_mut(o, pks) {
  if !__objecthas(o, "\zm") {
    mut fresh = {}
    o["\zm"] = fresh
  }
  let muts = o["\zm"]
  mut i = 0
  while i < __len(pks) {
    muts[pks[i]] = true
    i = i + 1
  }
  o
}

fn __drop_key(o, pk) {
  __objectremove(o, pk)
  if __is_nsk(pk) {
    if __objecthas(o, "\zK") { __objectremove(o["\zK"], pk) }
  }
  if __objecthas(o, "\zm") {
    if __objecthas(o["\zm"], pk) { __objectremove(o["\zm"], pk) }
  }
  nil
}

fn __visible_keys(o) {
  let ks = __objectkeys(o)
  mut out = []
  mut i = 0
  while i < __len(ks) {
    if !__hidden_key(ks[i]) { __arraypush(out, ks[i]) }
    i = i + 1
  }
  out
}

fn __nargs(name, args, n, line, col) {
  if __len(args) == n { return nil }
  mut word = ' arguments but '
  if n == 1 { word = ' argument but ' }
  __raise('ArityError', "'" + name + "' takes " + __tostr(n) + word +
          __tostr(__len(args)) + ' given', line, col)
}

# --- Set: an Object carrying its members under the hidden "\zs" table -----

fn __is_set(v) {
  if __typeof(v) != 'object' { return false }
  __objecthas(v, "\zs")
}

fn __new_set() {
  mut s = {}
  mut members = {}
  s["\zs"] = members
  s
}

fn __set_add(s, v, line, col) {
  let pk = __hkey(v, line, col)
  let ms = s["\zs"]
  if __objecthas(ms, pk) { return false }
  ms[pk] = v
  true
}

fn __mk_set(items, line, col) {
  let s = __new_set()
  mut i = 0
  while i < __len(items) {
    __set_add(s, items[i], line, col)
    i = i + 1
  }
  s
}

fn __set_items(s) {
  let ms = s["\zs"]
  let ks = __objectkeys(ms)
  mut out = []
  mut i = 0
  while i < __len(ks) {
    __arraypush(out, ms[ks[i]])
    i = i + 1
  }
  out
}

fn __set_has(s, v, line, col) { __objecthas(s["\zs"], __hkey(v, line, col)) }

fn __set_size(s) { __len(__objectkeys(s["\zs"])) }

fn __set_repr(s) {
  let items = __set_items(s)
  mut out = '{'
  mut i = 0
  while i < __len(items) {
    if i > 0 { out = out + ', ' }
    out = out + __repr(items[i])
    i = i + 1
  }
  out + '}'
}

fn __set_eq(a, b) {
  if __set_size(a) != __set_size(b) { return false }
  let items = __set_items(a)
  mut i = 0
  while i < __len(items) {
    if !__set_has(b, items[i], 0, 0) { return false }
    i = i + 1
  }
  true
}

fn __set_arg(v, line, col) {
  if !__is_set(v) {
    __raise('TypeError', "type error: parameter 'other' expects Set", line, col)
  }
  v
}

fn __set_method(s, name, args, line, col) {
  if name == 'size' {
    __nargs(name, args, 0, line, col)
    return __set_size(s)
  }
  if name == 'empty' {
    __nargs(name, args, 0, line, col)
    return __set_size(s) == 0
  }
  if name == 'presence' {
    __nargs(name, args, 0, line, col)
    if __set_size(s) == 0 { return nil }
    return s
  }
  if name == 'contains' {
    __nargs(name, args, 1, line, col)
    return __set_has(s, args[0], line, col)
  }
  if name == 'to_array' {
    __nargs(name, args, 0, line, col)
    return __set_items(s)
  }
  if name == 'iter' {
    __nargs(name, args, 0, line, col)
    return __arr_iter(__set_items(s))
  }
  if name == 'add' {
    __nargs(name, args, 1, line, col)
    return __set_add(s, args[0], line, col)
  }
  if name == 'remove' {
    __nargs(name, args, 1, line, col)
    let pk = __hkey(args[0], line, col)
    if !__objecthas(s["\zs"], pk) { return false }
    __objectremove(s["\zs"], pk)
    return true
  }
  if name == 'union' {
    __nargs(name, args, 1, line, col)
    let b = __set_arg(args[0], line, col)
    let out = __mk_set(__set_items(s), line, col)
    let bs = __set_items(b)
    mut i = 0
    while i < __len(bs) {
      __set_add(out, bs[i], line, col)
      i = i + 1
    }
    return out
  }
  if name == 'intersect' {
    __nargs(name, args, 1, line, col)
    let b = __set_arg(args[0], line, col)
    let out = __new_set()
    let xs = __set_items(s)
    mut i = 0
    while i < __len(xs) {
      if __set_has(b, xs[i], line, col) { __set_add(out, xs[i], line, col) }
      i = i + 1
    }
    return out
  }
  if name == 'diff' {
    __nargs(name, args, 1, line, col)
    let b = __set_arg(args[0], line, col)
    let out = __new_set()
    let xs = __set_items(s)
    mut i = 0
    while i < __len(xs) {
      if !__set_has(b, xs[i], line, col) { __set_add(out, xs[i], line, col) }
      i = i + 1
    }
    return out
  }
  if name == 'sym_diff' {
    __nargs(name, args, 1, line, col)
    let b = __set_arg(args[0], line, col)
    let out = __new_set()
    let xs = __set_items(s)
    mut i = 0
    while i < __len(xs) {
      if !__set_has(b, xs[i], line, col) { __set_add(out, xs[i], line, col) }
      i = i + 1
    }
    let ys = __set_items(b)
    mut j = 0
    while j < __len(ys) {
      if !__set_has(s, ys[j], line, col) { __set_add(out, ys[j], line, col) }
      j = j + 1
    }
    return out
  }
  if name == 'subset' {
    __nargs(name, args, 1, line, col)
    let b = __set_arg(args[0], line, col)
    let xs = __set_items(s)
    mut i = 0
    while i < __len(xs) {
      if !__set_has(b, xs[i], line, col) { return false }
      i = i + 1
    }
    return true
  }
  if name == 'superset' {
    __nargs(name, args, 1, line, col)
    let b = __set_arg(args[0], line, col)
    let ys = __set_items(b)
    mut i = 0
    while i < __len(ys) {
      if !__set_has(s, ys[i], line, col) { return false }
      i = i + 1
    }
    return true
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

fn __tuple_method(t, name, args, line, col) {
  let items = __titems(t)
  if name == 'size' {
    __nargs(name, args, 0, line, col)
    return __len(items)
  }
  if name == 'empty' {
    __nargs(name, args, 0, line, col)
    return __len(items) == 0
  }
  if name == 'presence' {
    __nargs(name, args, 0, line, col)
    if __len(items) == 0 { return nil }
    return t
  }
  if name == 'contains' {
    __nargs(name, args, 1, line, col)
    mut i = 0
    while i < __len(items) {
      if __truthy(__eq(items[i], args[0]), line, col) { return true }
      i = i + 1
    }
    return false
  }
  if name == 'to_array' {
    __nargs(name, args, 0, line, col)
    mut out = []
    mut i = 0
    while i < __len(items) {
      __arraypush(out, items[i])
      i = i + 1
    }
    return out
  }
  if name == 'iter' {
    __nargs(name, args, 0, line, col)
    return __arr_iter(items)
  }
  __raise('TypeError', 'type error: expected Function, got Nil', line, col)
}

# --- Iterators -------------------------------------------------------------
#
# Every built-in iterator is {iter, has_next, next} (plus dispose when a
# source it pulls from has one). Adapters are built on __lazy: a pull
# function fills a one-element lookahead, so has_next() is idempotent and
# next() past the end yields nil, the way culebra's do.

fn __mk_iter(hn, nx) {
  mut me = nil
  let o = {iter: fn () { me }, has_next: hn, next: nx}
  me = o
  o
}

fn __mk_iter_d(hn, nx, srcs) {
  mut me = nil
  let o = {iter: fn () { me }, has_next: hn, next: nx,
           dispose: fn () { __close_all(srcs) }}
  me = o
  o
}

fn __has_dispose(it) { __has_proto(it, 'dispose') }

fn __any_dispose(srcs) {
  mut i = 0
  while i < __len(srcs) {
    if __has_dispose(srcs[i]) { return true }
    i = i + 1
  }
  false
}

fn __close_all(srcs) {
  mut i = 0
  while i < __len(srcs) {
    __iter_close(srcs[i])
    i = i + 1
  }
  nil
}

fn __is_iterator(v) {
  if !__has_proto(v, 'has_next') { return false }
  __has_proto(v, 'next')
}

fn __lazy(srcs, pull) {
  mut la = nil
  mut has_la = false
  mut done = false
  mut slot = [nil]
  fn fill() {
    if has_la { return nil }
    if done { return nil }
    if pull(slot) {
      la = slot[0]
      has_la = true
    } else {
      done = true
    }
    nil
  }
  let hn = fn () {
    fill()
    has_la
  }
  let nx = fn () {
    fill()
    if !has_la { return nil }
    has_la = false
    let v = la
    la = nil
    v
  }
  if __any_dispose(srcs) { return __mk_iter_d(hn, nx, srcs) }
  __mk_iter(hn, nx)
}

fn __arr_iter(items) {
  mut i = 0
  __mk_iter(fn () { i < __len(items) },
            fn () {
              if i >= __len(items) { return nil }
              let v = items[i]
              i = i + 1
              v
            })
}

fn __str_iter(s) {
  mut i = 0
  __mk_iter(fn () { i < __len(s) },
            fn () {
              if i >= __len(s) { return nil }
              let l = __cp_len(s[i])
              mut out = ''
              mut j = 0
              while j < l {
                if i + j < __len(s) {
                  out = out + s[i + j]
                }
                j = j + 1
              }
              i = i + l
              out
            })
}

fn __entries_iter(o) {
  let vis = __visible_keys(o)
  mut j = 0
  __mk_iter(fn () { j < __len(vis) },
            fn () {
              if j >= __len(vis) { return nil }
              let k = vis[j]
              j = j + 1
              __mk_tuple([__key_val(o, k), o[k]])
            })
}

fn __range_iter(a, b) {
  mut i = a
  __mk_iter(fn () { i < b },
            fn () {
              if i >= b { return nil }
              let v = i
              i = i + 1
              v
            })
}

fn __iter_or_nil(v, line, col) {
  let t = __typeof(v)
  if t == 'array' { return __arr_iter(v) }
  if t == 'string' { return __str_iter(v) }
  if t == 'object' {
    if __is_tuple(v) { return __arr_iter(__titems(v)) }
    if __is_set(v) { return __arr_iter(__set_items(v)) }
    if __has_proto(v, 'iter') {
      let it = __invoke(v, 'iter', [], line, col)
      if __typeof(it) != 'object' {
        __raise('TypeError', 'type error: iter() did not return an Object',
                line, col)
      }
      if !__is_iterator(it) {
        __raise('TypeError', 'type error: iterator missing has_next()/next()',
                line, col)
      }
      return __norm_iter(it)
    }
    return __entries_iter(v)
  }
  nil
}

fn __iter(v, line, col) {
  let it = __iter_or_nil(v, line, col)
  if __typeof(it) == 'nil' {
    __raise('TypeError', 'type error: expected an iterable, got ' +
            __type_name(v), line, col)
  }
  it
}

# flatten / flat_map coerce their inner values with a different message
fn __iter_coerce(v, line, col) {
  let it = __iter_or_nil(v, line, col)
  if __typeof(it) == 'nil' {
    __raise('TypeError',
            'type error: expected Array, Tuple, Set, Object, or String, got ' +
            __type_name(v), line, col)
  }
  it
}

fn __copy_arr(xs) {
  mut out = []
  mut i = 0
  while i < __len(xs) {
    __arraypush(out, xs[i])
    i = i + 1
  }
  out
}

fn __it_map(src, f) {
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    slot[0] = f(src.next())
    true
  })
}

fn __it_filter(src, p, line, col) {
  __lazy([src], fn (slot) {
    while src.has_next() {
      let v = src.next()
      if __truthy(p(v), line, col) {
        slot[0] = v
        return true
      }
    }
    false
  })
}

fn __it_take(src, n) {
  mut left = n
  __lazy([src], fn (slot) {
    if left <= 0 { return false }
    if !src.has_next() { return false }
    slot[0] = src.next()
    left = left - 1
    true
  })
}

fn __it_skip(src, n) {
  mut pending = n
  __lazy([src], fn (slot) {
    while pending > 0 {
      if !src.has_next() { return false }
      src.next()
      pending = pending - 1
    }
    if !src.has_next() { return false }
    slot[0] = src.next()
    true
  })
}

fn __it_take_while(src, p, line, col) {
  mut stopped = false
  __lazy([src], fn (slot) {
    if stopped { return false }
    if !src.has_next() { return false }
    let v = src.next()
    if !__truthy(p(v), line, col) {
      stopped = true
      return false
    }
    slot[0] = v
    true
  })
}

fn __it_skip_while(src, p, line, col) {
  mut skipping = true
  __lazy([src], fn (slot) {
    while skipping {
      if !src.has_next() { return false }
      let v = src.next()
      if !__truthy(p(v), line, col) {
        skipping = false
        slot[0] = v
        return true
      }
    }
    if !src.has_next() { return false }
    slot[0] = src.next()
    true
  })
}

fn __it_step_by(src, n) {
  mut first = true
  __lazy([src], fn (slot) {
    if !first {
      mut k = 1
      while k < n {
        if !src.has_next() { return false }
        src.next()
        k = k + 1
      }
    }
    first = false
    if !src.has_next() { return false }
    slot[0] = src.next()
    true
  })
}

fn __it_distinct(src, line, col) {
  mut seen = {}
  __lazy([src], fn (slot) {
    while src.has_next() {
      let v = src.next()
      let pk = __hkey(v, line, col)
      if !__objecthas(seen, pk) {
        seen[pk] = true
        slot[0] = v
        return true
      }
    }
    false
  })
}

fn __it_tap(src, f) {
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    let v = src.next()
    f(v)
    slot[0] = v
    true
  })
}

fn __it_scan(src, init, f) {
  mut acc = init
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    acc = f(acc, src.next())
    slot[0] = acc
    true
  })
}

# flatten and flat_map share one shape: an inner iterator drained before
# the next outer element is coerced
fn __it_flat(src, f, line, col) {
  mut inner = nil
  mut has_inner = false
  __lazy([src], fn (slot) {
    mut go = true
    while go {
      if has_inner {
        if inner.has_next() {
          slot[0] = inner.next()
          return true
        }
        __iter_close(inner)
        has_inner = false
      }
      if !src.has_next() { go = false } else {
        inner = __iter_coerce(f(src.next()), line, col)
        has_inner = true
      }
    }
    false
  })
}

fn __it_chunk_by(src, f, line, col) {
  mut pend = nil
  mut has_pend = false
  __lazy([src], fn (slot) {
    if !has_pend {
      if !src.has_next() { return false }
      pend = src.next()
      has_pend = true
    }
    let key = f(pend)
    mut group = [pend]
    has_pend = false
    mut go = true
    while go {
      if !src.has_next() { go = false } else {
        let v = src.next()
        if __truthy(__eq(f(v), key), line, col) {
          __arraypush(group, v)
        } else {
          pend = v
          has_pend = true
          go = false
        }
      }
    }
    slot[0] = group
    true
  })
}

fn __it_chunks(src, n) {
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    mut group = []
    while __len(group) < n && src.has_next() {
      __arraypush(group, src.next())
    }
    slot[0] = group
    true
  })
}

fn __it_windows(src, n) {
  mut buf = []
  mut primed = false
  __lazy([src], fn (slot) {
    if !primed {
      primed = true
      while __len(buf) < n && src.has_next() {
        __arraypush(buf, src.next())
      }
      if __len(buf) < n { return false }
      slot[0] = __copy_arr(buf)
      return true
    }
    if !src.has_next() { return false }
    mut nb = []
    mut i = 1
    while i < __len(buf) {
      __arraypush(nb, buf[i])
      i = i + 1
    }
    __arraypush(nb, src.next())
    buf = nb
    slot[0] = __copy_arr(buf)
    true
  })
}

fn __it_chain(src, other, line, col) {
  let o2 = __iter_coerce(other, line, col)
  mut first_done = false
  __lazy([src, o2], fn (slot) {
    if !first_done {
      if src.has_next() {
        slot[0] = src.next()
        return true
      }
      first_done = true
    }
    if !o2.has_next() { return false }
    slot[0] = o2.next()
    true
  })
}

fn __it_zip(src, other, line, col) {
  let o2 = __iter_coerce(other, line, col)
  __lazy([src, o2], fn (slot) {
    if !src.has_next() { return false }
    if !o2.has_next() { return false }
    let a = src.next()
    let b = o2.next()
    slot[0] = {first: a, second: b}
    true
  })
}

fn __it_enumerate(src) {
  mut i = 0
  __lazy([src], fn (slot) {
    if !src.has_next() { return false }
    let v = src.next()
    slot[0] = __mk_tuple([i, v])
    i = i + 1
    true
  })
}

# A terminal closes its source exactly once: after the result on success,
# before rethrowing on failure (a dispose that throws while unwinding is
# swallowed so the original error is the one that escapes).
fn __term(src, body) {
  mut failed = false
  mut err = nil
  mut r = nil
  try {
    r = body()
  } catch e {
    failed = true
    err = e
  }
  if failed {
    try {
      __iter_close(src)
    } catch e2 {
      nil
    }
    throw err
  }
  __iter_close(src)
  r
}

fn __it_min_max(src, name, want_lt, line, col) {
  __term(src, fn () {
    if !src.has_next() {
      __raise('ValueError', name + ' of empty Iterator', line, col)
    }
    mut best = src.next()
    __expect_num(best, line, col)
    while src.has_next() {
      let v = src.next()
      __expect_num(v, line, col)
      if want_lt {
        if v < best { best = v }
      } else {
        if v > best { best = v }
      }
    }
    best
  })
}

fn __it_min_max_by(src, name, f, want_lt, line, col) {
  __term(src, fn () {
    if !src.has_next() {
      __raise('ValueError', name + ' of empty Iterator', line, col)
    }
    mut best = src.next()
    mut bk = f(best)
    __expect_num(bk, line, col)
    while src.has_next() {
      let v = src.next()
      let k = f(v)
      __expect_num(k, line, col)
      mut better = false
      if want_lt {
        if k < bk { better = true }
      } else {
        if k > bk { better = true }
      }
      if better {
        best = v
        bk = k
      }
    }
    best
  })
}

fn __pair_of(v, line, col) {
  if __is_tuple(v) {
    let items = __titems(v)
    if __len(items) == 2 { return items }
  } else {
    if __typeof(v) == 'object' {
      if !__is_set(v) {
        if __objecthas(v, 'first') {
          if __objecthas(v, 'second') { return [v['first'], v['second']] }
        }
      }
    }
  }
  __raise('TypeError',
          'type error: unzip expects (a, b) tuples or {first, second} objects',
          line, col)
}

fn __iter_method(src, name, args, line, col) {
  if name == 'map' {
    __nargs(name, args, 1, line, col)
    return __it_map(src, __check_fn(args[0], line, col))
  }
  if name == 'filter' {
    __nargs(name, args, 1, line, col)
    return __it_filter(src, __check_fn(args[0], line, col), line, col)
  }
  if name == 'take' {
    __nargs(name, args, 1, line, col)
    return __it_take(src, args[0])
  }
  if name == 'skip' {
    __nargs(name, args, 1, line, col)
    return __it_skip(src, args[0])
  }
  if name == 'take_while' {
    __nargs(name, args, 1, line, col)
    return __it_take_while(src, __check_fn(args[0], line, col), line, col)
  }
  if name == 'skip_while' {
    __nargs(name, args, 1, line, col)
    return __it_skip_while(src, __check_fn(args[0], line, col), line, col)
  }
  if name == 'step_by' {
    __nargs(name, args, 1, line, col)
    if args[0] < 1 {
      __raise('ValueError', 'step_by() n must be at least 1', line, col)
    }
    return __it_step_by(src, args[0])
  }
  if name == 'distinct' {
    __nargs(name, args, 0, line, col)
    return __it_distinct(src, line, col)
  }
  if name == 'tap' {
    __nargs(name, args, 1, line, col)
    return __it_tap(src, __check_fn(args[0], line, col))
  }
  if name == 'scan' {
    __nargs(name, args, 2, line, col)
    return __it_scan(src, args[0], __check_fn(args[1], line, col))
  }
  if name == 'flatten' {
    __nargs(name, args, 0, line, col)
    return __it_flat(src, fn (v) { v }, line, col)
  }
  if name == 'flat_map' {
    __nargs(name, args, 1, line, col)
    return __it_flat(src, __check_fn(args[0], line, col), line, col)
  }
  if name == 'chunk_by' {
    __nargs(name, args, 1, line, col)
    return __it_chunk_by(src, __check_fn(args[0], line, col), line, col)
  }
  if name == 'chunks' {
    __nargs(name, args, 1, line, col)
    if args[0] < 1 {
      __raise('ValueError', 'chunks() n must be at least 1', line, col)
    }
    return __it_chunks(src, args[0])
  }
  if name == 'windows' {
    __nargs(name, args, 1, line, col)
    if args[0] < 1 {
      __raise('ValueError', 'windows() n must be at least 1', line, col)
    }
    return __it_windows(src, args[0])
  }
  if name == 'chain' {
    __nargs(name, args, 1, line, col)
    return __it_chain(src, args[0], line, col)
  }
  if name == 'zip' {
    __nargs(name, args, 1, line, col)
    return __it_zip(src, args[0], line, col)
  }
  if name == 'enumerate' {
    __nargs(name, args, 0, line, col)
    return __it_enumerate(src)
  }
  if name == 'collect' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut out = []
      while src.has_next() { __arraypush(out, src.next()) }
      out
    })
  }
  if name == 'join' {
    __nargs(name, args, 1, line, col)
    let sep = args[0]
    return __term(src, fn () {
      mut out = ''
      mut first = true
      while src.has_next() {
        if !first { out = out + sep }
        first = false
        out = out + __display(src.next())
      }
      out
    })
  }
  if name == 'for_each' {
    __nargs(name, args, 1, line, col)
    let f = __check_fn(args[0], line, col)
    return __term(src, fn () {
      while src.has_next() { f(src.next()) }
      nil
    })
  }
  if name == 'reduce' {
    __nargs(name, args, 2, line, col)
    let f = __check_fn(args[1], line, col)
    mut acc = args[0]
    return __term(src, fn () {
      while src.has_next() { acc = f(acc, src.next()) }
      acc
    })
  }
  if name == 'find' {
    __nargs(name, args, 1, line, col)
    let p = __check_fn(args[0], line, col)
    return __term(src, fn () {
      while src.has_next() {
        let v = src.next()
        if __truthy(p(v), line, col) { return v }
      }
      nil
    })
  }
  if name == 'any' {
    __nargs(name, args, 1, line, col)
    let p = __check_fn(args[0], line, col)
    return __term(src, fn () {
      while src.has_next() {
        if __truthy(p(src.next()), line, col) { return true }
      }
      false
    })
  }
  if name == 'all' {
    __nargs(name, args, 1, line, col)
    let p = __check_fn(args[0], line, col)
    return __term(src, fn () {
      while src.has_next() {
        if !__truthy(p(src.next()), line, col) { return false }
      }
      true
    })
  }
  if name == 'count' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut n = 0
      while src.has_next() {
        src.next()
        n = n + 1
      }
      n
    })
  }
  if name == 'first' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      if !src.has_next() { return nil }
      src.next()
    })
  }
  if name == 'last' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut v = nil
      while src.has_next() { v = src.next() }
      v
    })
  }
  if name == 'nth' {
    __nargs(name, args, 1, line, col)
    let n = args[0]
    if n < 0 {
      __raise('ValueError', 'nth() n must not be negative', line, col)
    }
    return __term(src, fn () {
      mut i = 0
      while i < n {
        if !src.has_next() { return nil }
        src.next()
        i = i + 1
      }
      if !src.has_next() { return nil }
      src.next()
    })
  }
  if name == 'position' {
    __nargs(name, args, 1, line, col)
    let p = __check_fn(args[0], line, col)
    return __term(src, fn () {
      mut i = 0
      while src.has_next() {
        if __truthy(p(src.next()), line, col) { return i }
        i = i + 1
      }
      nil
    })
  }
  if name == 'contains' {
    __nargs(name, args, 1, line, col)
    let want = args[0]
    return __term(src, fn () {
      while src.has_next() {
        if __truthy(__eq(src.next(), want), line, col) { return true }
      }
      false
    })
  }
  if name == 'sum' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut acc = 0
      while src.has_next() {
        let v = src.next()
        __expect_num(v, line, col)
        acc = acc + v
      }
      acc
    })
  }
  if name == 'product' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut acc = 1
      while src.has_next() {
        let v = src.next()
        __expect_num(v, line, col)
        acc = acc * v
      }
      acc
    })
  }
  if name == 'min' {
    __nargs(name, args, 0, line, col)
    return __it_min_max(src, name, true, line, col)
  }
  if name == 'max' {
    __nargs(name, args, 0, line, col)
    return __it_min_max(src, name, false, line, col)
  }
  if name == 'min_by' {
    __nargs(name, args, 1, line, col)
    return __it_min_max_by(src, name, __check_fn(args[0], line, col), true,
                           line, col)
  }
  if name == 'max_by' {
    __nargs(name, args, 1, line, col)
    return __it_min_max_by(src, name, __check_fn(args[0], line, col), false,
                           line, col)
  }
  if name == 'to_set' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      let s = __new_set()
      while src.has_next() { __set_add(s, src.next(), line, col) }
      s
    })
  }
  if name == 'to_object' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut o = {}
      while src.has_next() {
        let v = src.next()
        mut ok = false
        if __is_tuple(v) {
          if __len(__titems(v)) == 2 { ok = true }
        }
        if !ok {
          __raise('TypeError', 'type error: to_object expects (key, value) tuples',
                  line, col)
        }
        let kv = __titems(v)
        __setindex(o, kv[0], kv[1], 0, line, col)
      }
      o
    })
  }
  if name == 'group_by' {
    __nargs(name, args, 1, line, col)
    let f = __check_fn(args[0], line, col)
    return __term(src, fn () {
      mut o = {}
      while src.has_next() {
        let v = src.next()
        let key = f(v)
        let pk = __hkey(key, line, col)
        if !__objecthas(o, pk) {
          mut bucket = []
          __setindex(o, key, bucket, 0, line, col)
        }
        __arraypush(o[pk], v)
      }
      o
    })
  }
  if name == 'partition' {
    __nargs(name, args, 1, line, col)
    let p = __check_fn(args[0], line, col)
    return __term(src, fn () {
      mut yes = []
      mut no = []
      while src.has_next() {
        let v = src.next()
        if __truthy(p(v), line, col) { __arraypush(yes, v) } else { __arraypush(no, v) }
      }
      __mk_tuple([yes, no])
    })
  }
  if name == 'unzip' {
    __nargs(name, args, 0, line, col)
    return __term(src, fn () {
      mut xs = []
      mut ys = []
      while src.has_next() {
        let pr = __pair_of(src.next(), line, col)
        __arraypush(xs, pr[0])
        __arraypush(ys, pr[1])
      }
      __mk_tuple([xs, ys])
    })
  }
  "\znomethod"
}

# --- Bound methods and self in closures ----------------------------------
#
# A closure that mentions self compiles with a hidden receiver parameter
# in front of its declared ones and is carried as a marker object
# {"\zb": raw, "\zn": declared arity[, "\zS": bound receiver]}. A method call
# supplies the receiver, a dot read binds it (an already-bound marker keeps
# its receiver), and a plain call passes nil -- which the body's prologue
# replaces with the receiver of the enclosing method, if any, so a closure
# built inside a method still sees self when called on its own.

fn __is_marker(v) {
  if __typeof(v) != 'object' { return false }
  __objecthas(v, "\zb")
}

fn __is_fn(v) {
  if __typeof(v) == 'function' { return true }
  __is_marker(v)
}

fn __mk_selfc(raw, n) {
  mut o = {}
  o["\zb"] = raw
  o["\zn"] = n
  o
}

fn __bind(v, recv) {
  if !__is_marker(v) { return v }
  if __objecthas(v, "\zS") { return v }
  mut o = {}
  o["\zb"] = v["\zb"]
  o["\zn"] = v["\zn"]
  o["\zS"] = recv
  o
}

fn __self_pick(sp, outer) {
  if __typeof(sp) == 'nil' { return outer }
  sp
}

fn __self_use(v, line, col) {
  if __typeof(v) == 'nil' {
    __raise('NameError', "undefined variable 'self'", line, col)
  }
  v
}

fn __marker_self(mk, fallback) {
  if __objecthas(mk, "\zS") { return mk["\zS"] }
  fallback
}

# The declared-arity closure a marker stands for, with its receiver fixed:
# what a callback slot or a plain call site can invoke directly.
fn __bindn(raw, selfv, n, line, col) {
  if n == 0 { return fn () { raw(selfv) } }
  if n == 1 { return fn (a) { raw(selfv, a) } }
  if n == 2 { return fn (a, b) { raw(selfv, a, b) } }
  if n == 3 { return fn (a, b, c) { raw(selfv, a, b, c) } }
  if n == 4 { return fn (a, b, c, d) { raw(selfv, a, b, c, d) } }
  __raise('TypeError', 'type error: too many parameters', line, col)
}

fn __as_fn(v, line, col) {
  if __is_marker(v) {
    return __bindn(v["\zb"], __marker_self(v, nil), v["\zn"], line, col)
  }
  v
}

# Calls a callable-looking property with a receiver: a class method, a
# self-closure marker, or a plain closure (which takes no receiver).
fn __invoke(o, name, args, line, col) {
  if __is_instance(o) {
    let ms = o['class']['methods']
    if __objecthas(ms, name) {
      return __call_self(ms[name], o, args, line, col)
    }
  }
  if !__objecthas(o, name) {
    __raise('TypeError', 'type error: iterator missing has_next()/next()',
            line, col)
  }
  let f = o[name]
  if __is_marker(f) {
    return __call_self(f["\zb"], __marker_self(f, o), args, line, col)
  }
  __call_n(__check_fn(f, line, col), args, line, col)
}

fn __has_proto(o, name) {
  if __typeof(o) != 'object' { return false }
  if __is_instance(o) {
    if __objecthas(o['class']['methods'], name) { return true }
  }
  if !__objecthas(o, name) { return false }
  __is_fn(o[name])
}

# The adapters drive their source with raw protocol calls, which only a
# plain object holding plain closures answers; anything else (an instance,
# a marker-holding object) is wrapped so those calls go through __invoke.
fn __norm_iter(it) {
  if !__is_instance(it) {
    mut plain = true
    if __typeof(it['has_next']) != 'function' { plain = false }
    if __typeof(it['next']) != 'function' { plain = false }
    if __objecthas(it, 'dispose') {
      if __typeof(it['dispose']) != 'function' { plain = false }
    }
    if plain { return it }
  }
  let hn = fn () { __invoke(it, 'has_next', [], 0, 0) }
  let nx = fn () { __invoke(it, 'next', [], 0, 0) }
  if __has_proto(it, 'dispose') {
    mut me = nil
    let o = {iter: fn () { me }, has_next: hn, next: nx,
             dispose: fn () { __invoke(it, 'dispose', [], 0, 0) }}
    me = o
    return o
  }
  __mk_iter(hn, nx)
}
`

# --- Function records and scopes ---------------------------------------------
#
# One record per function: func 0 is the top level ("main"); every named
# `fn`, closure literal, and defer body gets its own. Within a function,
# variables live in a stack of block scopes; the scan stores every
# resolution (keyed by the ident node's position, which is unique) so the
# emitter never re-resolves. Slots are never reused -- a captured
# variable's identity is (function, slot), and reuse would alias two
# variables through one cell -- so a block's Scope range is
# [its first slot, the function's watermark when it closed]; an inner
# block's slots fall inside that range and are released again, which is a
# no-op the second time.

mut funcs = []          # {parent, name, params, named, stmts, body_key, is_prelude}
mut free = []           # per func: {"owner:slot": (owner, slot)}
mut calls = []          # per func: [callee func index...]
mut capture_index = []  # per func: {"owner:slot": capture index}
mut cell_index = []     # per func (the owner): {slot: cell index}
mut nslots = []         # per func: named local slots (params + decls)
mut nscratch = []       # per func: lowering-temp slots, appended after
mut closure_of = {}     # "line:col" of a closure/defer body -> func index
mut resolved = {}       # "line:col" of an ident use/decl -> resolution
mut scratch_of = {}     # "line:col" of an op token -> scratch index
mut block_info = {}     # "line:col" of a block -> {base, wrap}
mut prelude_named = {}  # prelude fn name -> func index
# closure literals that mention `self`: func -> how `self` resolves in the
# enclosing function (kind 'var' record, or 'none'), plus the closure's own
# `self` slot and definition position for its prologue diagnostics
mut self_closure = {}
mut self_slot = {}
mut closure_funcs = {}
mut fn_pos = {}
mut in_prelude = false
mut scope_stack = []    # per func: [{map: {name: (slot, is_mut)}}...]
mut loop_depth = {}     # func -> depth (scan-time)

# The culebra type-annotation names, as the typeof vocabulary the emitted
# checks compare against. Tuple is special-cased (a marked object).
let type_map = {Long: 'int', Float: 'double', String: 'string', Bool: 'bool',
                Nil: 'nil', Array: 'array', Object: 'object',
                Function: 'function'}

# Method names the built-in dispatcher owns; a .name(...) outside this set
# falls back to UFCS when a function of that name is in scope.
let builtin_methods = ['size', 'empty', 'push', 'pop', 'get', 'slice',
                       'join', 'contains', 'index_of', 'map', 'filter',
                       'for_each', 'reduce', 'find', 'any', 'all', 'sum',
                       'reverse', 'sorted', 'starts_with', 'ends_with',
                       'split', 'trim', 'repeat', 'keys', 'values', 'has',
                       'remove', 'presence', 'iter', 'enumerate', 'to_set',
                       'get_or_put', 'to_array', 'union', 'intersect', 'diff',
                       'sym_diff', 'subset', 'superset', 'add',
                       'take', 'skip', 'take_while', 'skip_while', 'step_by',
                       'distinct', 'tap', 'scan', 'flatten', 'chunk_by',
                       'chunks', 'windows', 'flat_map', 'chain', 'zip',
                       'collect', 'count', 'first', 'last', 'nth', 'position',
                       'product', 'min', 'max', 'min_by', 'max_by',
                       'to_object', 'group_by', 'partition', 'unzip']

let missing_marker = String.from_code_point(1) + 'missing'
# What a raw generator yields instead of ever completing: culebra runs a
# generator body's defers only through dispose, never at the body's own
# end, so the raw frame must stay suspended -- pending defers intact --
# until a genreturn (or never). The wrapper treats this value as "done".
let gen_end_marker = String.from_code_point(1) + 'gend'
let class_marker = String.from_code_point(1) + 'k'

let intrinsics = {
  __typeof: ('typeof', 1), __tostr: ('tostr', 1), __len: ('len', 1),
  __toint: ('toint', 1), __todouble: ('todouble', 1), __fmod: ('fmod', 2),
  __fpow: ('pow', 2), __arraypush: ('arraypush', 2), __arraypop: ('arraypop', 1),
  __objecthas: ('objecthas', 2), __objectkeys: ('objectkeys', 1),
  __objectremove: ('objectremove', 2),
  __genresume: ('genresume', 2), __genreturn: ('genreturn', 2),
  __same: ('same', 2),
}

# Global builtins user code calls by name; each lowers to the prelude
# function of the same table entry, with the call's position appended.
let builtins = {
  inspect: ('__inspect', 1), type_of: ('__type_of', 1),
  to_string: ('__to_string', 1), to_long: ('__to_long', 1),
  to_float: ('__to_float', 1), iota: nil, range: nil,
  assert_eq: ('__assert_eq', 2), assert_true: ('__assert_true', 1),
  assert_false: ('__assert_false', 1),
}

fn new_func(parent, name, stmts, body_key) {
  let f = funcs.size()
  funcs.push({parent: parent, name: name, params: [], pspecs: [], named: {},
              stmts: stmts, body_key: body_key, is_prelude: in_prelude})
  free.push({})
  calls.push([])
  capture_index.push({})
  cell_index.push({})
  nslots.push(0)
  nscratch.push(0)
  scope_stack.push([])
  loop_depth[f] = 0
  f
}

# A parameter node in any of its five shapes, normalized.
fn param_record(node) {
  match node {
    {name: 'rest_p', nodes: [id]} =>
      {pname: id.token, ty: nil, dflt: nil, rest: true, id: id},
    {name: 'tydef_p', nodes: [id, ty, dflt]} =>
      {pname: id.token, ty: ty.token, dflt: dflt, rest: false, id: id},
    {name: 'typed_p', nodes: [id, ty]} =>
      {pname: id.token, ty: ty.token, dflt: nil, rest: false, id: id},
    {name: 'def_p', nodes: [id, dflt]} =>
      {pname: id.token, ty: nil, dflt: dflt, rest: false, id: id},
    _ => {pname: node.token, ty: nil, dflt: nil, rest: false, id: node},
  }
}

fn declare_var(f, name, is_mut, at) {
  let scopes = scope_stack[f]
  if scopes[scopes.size() - 1].map.has(name) {
    fail(at, "'{name}' is already defined")
  }
  # culebra rejects shadowing across a function boundary (`self` is the
  # receiver, redeclared per function on purpose)
  mut h = funcs[f].parent
  if name == 'self' || name == '__selfp' { h = nil }
  while h != nil {
    let outer = scope_stack[h]
    mut i = outer.size() - 1
    while i >= 0 {
      if outer[i].map.has(name) {
        fail(at, "cannot shadow outer variable '{name}' (declared in an enclosing function)")
      }
      i = i - 1
    }
    h = funcs[h].parent
  }
  let slot = nslots[f]
  nslots[f] = slot + 1
  scopes[scopes.size() - 1].map[name] = (slot, is_mut)
  resolved[pkey(at)] =
      {kind: 'var', owner: f, slot: slot, is_mut: is_mut}
  slot
}

fn new_scratch(f, at) {
  let k = nscratch[f]
  nscratch[f] = k + 1
  scratch_of[pkey(at)] = k
  k
}

fn resolve(f, name) {
  mut h = f
  while h != nil {
    if classes.has("{h}/{name}") {
      # the class binding is also a plain variable (the class object); the
      # kind lets a call site construct directly
      let scopes2 = scope_stack[h]
      mut j = scopes2.size() - 1
      mut slot = nil
      mut going = true
      while going {
        cond {
          j < 0 => going = false,
          scopes2[j].map.has(name) => {
            let (sl, _) = scopes2[j].map[name]
            slot = sl
            going = false
          },
          _ => j = j - 1,
        }
      }
      if slot != nil {
        return {kind: 'class', owner: h, slot: slot, cls: "{h}/{name}"}
      }
    }
    let scopes = scope_stack[h]
    mut i = scopes.size() - 1
    while i >= 0 {
      if scopes[i].map.has(name) {
        let (slot, is_mut) = scopes[i].map[name]
        return {kind: 'var', owner: h, slot: slot, is_mut: is_mut}
      }
      i = i - 1
    }
    if funcs[h].named.has(name) {
      return {kind: 'fn', funcs: funcs[h].named[name]}
    }
    if funcs[h].is_prelude && prelude_named.has(name) {
      return {kind: 'fn', funcs: [prelude_named[name]]}
    }
    h = funcs[h].parent
  }
  {kind: 'none'}
}

fn use_var(f, owner, slot) {
  if owner != f { free[f]["{owner}:{slot}"] = (owner, slot) }
}

fn note_use(node, f, r) {
  resolved[pkey(node)] = r
  if r.kind == 'var' { use_var(f, r.owner, r.slot) }
}

# --- Pass A: collect + scan ---------------------------------------------------
#
# Sibling named fns register before any sibling body is walked, so mutual
# recursion resolves; everything else binds in textual order.

fn enter_scope(f) { scope_stack[f].push({map: {}}) }
fn leave_scope(f) { scope_stack[f].pop() }

# A fn_decl's pieces: [deco..., ident, fparams, block]. Decorated functions
# are not multimethods -- they become a let-bound closure wrapped by the
# decorators, applied innermost-first.
fn fn_decl_parts(s) {
  mut decos = []
  mut i = 0
  while s.nodes[i].name == 'deco' {
    decos.push(s.nodes[i])
    i = i + 1
  }
  mut blk = s.nodes[i + 2]
  if blk.name == 'ret_ann' { blk = s.nodes[i + 3] }
  {decos: decos, id: s.nodes[i], prms: s.nodes[i + 1], blk: blk}
}

# a method/titem node: [ident, fparams, ret_ann?, block?]
fn method_parts(n) {
  mut blk = nil
  mut i = 2
  while i < n.nodes.size() {
    if n.nodes[i].name == 'block' { blk = n.nodes[i] }
    i = i + 1
  }
  {id: n.nodes[0], prms: n.nodes[1], blk: blk}
}

# Whether a statement subtree contains a yield of its own -- not one hidden
# inside a nested function body, which belongs to that function.
fn has_yield_node(n) {
  if n.name == 'yield_v' || n.name == 'yield_f' { return true }
  if n.name == 'closure' || n.name == 'lambda' || n.name == 'defer_s' ||
     n.name == 'fn_decl' || n.name == 'class_d' || n.name == 'trait_d' {
    return false
  }
  for c in n.nodes {
    if has_yield_node(c) { return true }
  }
  false
}

fn has_yield_stmts(blk) {
  for st in blk.nodes {
    if has_yield_node(st) { return true }
  }
  false
}

fn scan_body_stmts(f, stmts, blk_key) {
  mut has_defer = false
  for s in stmts {
    if s.name == 'trait_d' {
      let tname = s.nodes[0].token
      mut req = []
      mut dfl = {}
      mut dar = {}
      mut i = 1
      while i < s.nodes.size() {
        let it = method_parts(s.nodes[i])
        cond {
          it.blk == nil => req.push((it.id.token, it.prms.nodes.size())),
          _ => {
            # a default method: its own function, self as the first param
            let g = new_func(f, "{tname}.{it.id.token}", it.blk.nodes,
                             pkey(it.blk))
            dfl['m:' + it.id.token] = g
            dar['m:' + it.id.token] = it.prms.nodes.size()
            closure_of[pkey(s.nodes[i])] = g
          },
        }
        i = i + 1
      }
      traits[tname] = {required: req, defaults: dfl, darities: dar}
    }
    if s.name == 'class_d' {
      let d = class_parts(s)
      declare_var(f, d.id.token, false, d.id)
      mut methods = {}
      mut marities = {}
      mut ctor = nil
      for mn in d.methods {
        let it = method_parts(mn)
        let g = new_func(f, "{d.id.token}.{it.id.token}", it.blk.nodes,
                         pkey(it.blk))
        closure_of[pkey(mn)] = g
        cond {
          it.id.token == 'new' => ctor = g,
          _ => {
            # keys carry an 'm:' prefix so a method named `drop` cannot trip
            # the host's own auto-drop contract on this compiler map
            methods['m:' + it.id.token] = g
            marities['m:' + it.id.token] = it.prms.nodes.size()
          },
        }
      }
      if ctor == nil { fail(d.id, "class '{d.id.token}' has no new()") }
      classes["{f}/{d.id.token}"] =
          {name: d.id.token, ctor: ctor, methods: methods, marities: marities}
    }
    if s.name == 'fn_decl' {
      let d = fn_decl_parts(s)
      if d.decos.size() > 0 {
        # a decorated fn is a value binding; handled in order below
      } else {
        if scope_stack[f][scope_stack[f].size() - 1].map.has(d.id.token) {
          fail(d.id, "'{d.id.token}' is already defined")
        }
        let is_gen = has_yield_stmts(d.blk)
        if is_gen && funcs[f].named.has(d.id.token) {
          fail(d.id, "generator fn '{d.id.token}' cannot have multiple definitions")
        }
        if funcs[f].named.has(d.id.token) {
          let fam = funcs[f].named[d.id.token]
          if funcs[fam[0]].gen_raw != nil {
            fail(d.id, "generator fn '{d.id.token}' cannot have multiple definitions")
          }
        }
        # A generator declaration becomes two functions: the visible one
        # keeps the name, the params, and every dispatch behavior, and its
        # (synthesized) body just calls the hidden raw generator -- a child
        # function holding the real statements -- and wraps the activation
        # in the iterator-protocol object. Every existing call and
        # fn-as-value site then works untouched.
        cond {
          is_gen => {
            let g = new_func(f, d.id.token, [], 'w:' + pkey(d.blk))
            let rw = new_func(g, d.id.token, d.blk.nodes, pkey(d.blk))
            funcs[g]['gen_raw'] = rw
            funcs[rw]['is_gen'] = true
            funcs[f].named[d.id.token] = [g]
          },
          _ => {
            let g = new_func(f, d.id.token, d.blk.nodes, pkey(d.blk))
            cond {
              funcs[f].named.has(d.id.token) =>
                funcs[f].named[d.id.token].push(g),
              _ => funcs[f].named[d.id.token] = [g],
            }
          },
        }
      }
    }
  }
  for s in stmts {
    cond {
      s.name == 'trait_d' => {
        mut i = 1
        while i < s.nodes.size() {
          let it = method_parts(s.nodes[i])
          if it.blk != nil {
            let g = closure_of[pkey(s.nodes[i])]
            walk_method(g, it.prms.nodes)
          }
          i = i + 1
        }
      },
      s.name == 'class_d' => {
        let d = class_parts(s)
        for mn in d.methods {
          let it = method_parts(mn)
          walk_method(closure_of[pkey(mn)], it.prms.nodes)
        }
      },
      s.name == 'fn_decl' => {
        let d = fn_decl_parts(s)
        cond {
          d.decos.size() > 0 => scan_decorated(s, d, f),
          _ => {
            # walk each overload exactly once, in registration order
            let lst = funcs[f].named[d.id.token]
            let g = lst[deco_walked_index(f, d.id.token)]
            walk_fn(g, d.prms.nodes)
            # the raw generator walks after its wrapper: the wrapper's own
            # scopes are closed by then, so the raw's params -- the same
            # names -- do not trip the cross-function shadow check
            let rw = funcs[g].gen_raw
            if rw != nil { walk_gen_raw(rw, d.prms.nodes) }
          },
        }
      },
      _ => {
        if s.name == 'defer_s' { has_defer = true }
        scan_stmt(s, f)
      },
    }
  }
  has_defer
}

# Which overload of `name` in `f` walks next: a cursor per (f, name).
# class registry: "f/Name" -> {name, ctor: func idx, methods: {name: idx},
# marities: {name: arity}}; traits: "Name" -> {required: [(name, arity)],
# defaults: {name: func idx}, darities: {name: arity}} (traits are global --
# culebra's are file-scope declarations)
mut classes = {}
mut traits = {}

mut walk_cursor = {}
fn deco_walked_index(f, name) {
  let k = "{f}/{name}"
  let i = walk_cursor.get(k, 0)
  walk_cursor[k] = i + 1
  i
}

fn class_parts(s) {
  mut i = 0
  while s.nodes[i].name == 'deco' { i = i + 1 }
  mut methods = []
  mut j = i + 1
  while j < s.nodes.size() {
    methods.push(s.nodes[j])
    j = j + 1
  }
  {id: s.nodes[i], methods: methods}
}

# A method walks like a function whose first parameter is `self`.
fn walk_method(g, param_nodes) {
  enter_scope(g)
  declare_self(g)
  for pn in param_nodes {
    let rec = param_record(pn)
    declare_var(g, rec.pname, false, rec.id)
    funcs[g].params.push(rec.pname)
    funcs[g].pspecs.push(rec)
  }
  for rec in funcs[g].pspecs {
    if rec.dflt != nil { scan_expr(rec.dflt, g) }
  }
  let base = nslots[g]
  let has_defer = scan_body_stmts(g, funcs[g].stmts, funcs[g].body_key)
  leave_scope(g)
  block_info[funcs[g].body_key] =
      {base: base, high: nslots[g], wrap: nslots[g] > base || has_defer}
}

fn declare_self(g) {
  let scopes = scope_stack[g]
  scopes[scopes.size() - 1].map['self'] = (nslots[g], false)
  resolved["self/{g}"] = {kind: 'var', owner: g, slot: nslots[g], is_mut: false}
  nslots[g] = nslots[g] + 1
  funcs[g].params.push('self')
  funcs[g].pspecs.push({pname: 'self', ty: nil, dflt: nil, rest: false, id: nil})
}

fn scan_decorated(s, d, f) {
  # each decorator must resolve to something callable
  for dn in d.decos {
    let r = resolve(f, dn.nodes[0].token)
    if r.kind == 'none' {
      fail(dn.nodes[0], "undefined name '{dn.nodes[0].token}'")
    }
    note_deco(dn, f, r)
  }
  # the wrapped closure: letrec -- the body may name itself
  declare_var(f, d.id.token, false, d.id)
  let g = new_func(f, d.id.token, d.blk.nodes, pkey(d.blk))
  closure_of[pkey(s)] = g
  walk_fn(g, d.prms.nodes)
}

fn note_deco(dn, f, r) {
  resolved[pkey(dn.nodes[0])] = r
  if r.kind == 'var' { use_var(f, r.owner, r.slot) }
  if r.kind == 'fn' {
    for g in r.funcs { calls[f].push(g) }
  }
}

# The function's own top scope: params, then its body statements. The body
# block wraps in a Scope when it declares anything beyond the params or
# registers defers (params stay outside the range -- they live as long as
# the frame).
# Whether a subtree names `self` anywhere -- nested closures included,
# since an inner closure's `self` falls back to the enclosing one's.
fn mentions_self(node) {
  if node.name == 'ident' {
    if node.token == 'self' { return true }
  }
  if node.nodes != nil {
    for c in node.nodes {
      if mentions_self(c) { return true }
    }
  }
  false
}

fn walk_fn(f, param_nodes) {
  enter_scope(f)
  if self_closure.has(f) {
    # the hidden receiver parameter sits in front of the declared ones
    declare_var(f, '__selfp', false, {name: 'ident', token: '__selfp', line: 0, column: f})
    funcs[f].params.push('__selfp')
    funcs[f].pspecs.push({pname: '__selfp', ty: nil, dflt: nil, rest: false, id: nil})
  }
  for p in param_nodes {
    let rec = param_record(p)
    declare_var(f, rec.pname, false, rec.id)
    funcs[f].params.push(rec.pname)
    funcs[f].pspecs.push(rec)
  }
  # a default's expression binds in the callee, after the params before it
  for rec in funcs[f].pspecs {
    if rec.dflt != nil { scan_expr(rec.dflt, f) }
  }
  if self_closure.has(f) {
    # `self` is a local the prologue fills: the supplied receiver, or the
    # enclosing function's `self` when the call supplied none
    self_slot[f] = declare_var(f, 'self', false,
                               {name: 'ident', token: 'self', line: 0, column: 1000000 + f})
    let outer = self_closure[f]
    if outer.kind == 'var' { use_var(f, outer.owner, outer.slot) }
  }
  let base = nslots[f]
  let has_defer = scan_body_stmts(f, funcs[f].stmts, funcs[f].body_key)
  leave_scope(f)
  block_info[funcs[f].body_key] =
      {base: base, high: nslots[f], wrap: nslots[f] > base || has_defer}
}

# The raw generator's walk: params redeclare by name only (the wrapper
# already owns the default expressions and the dispatch surface; the raw
# body receives every argument resolved), then the body as usual.
fn walk_gen_raw(f2, param_nodes) {
  enter_scope(f2)
  for p in param_nodes {
    let rec = param_record(p)
    declare_var(f2, rec.pname, false, rec.id)
    funcs[f2].params.push(rec.pname)
    funcs[f2].pspecs.push({pname: rec.pname, ty: nil, dflt: nil, rest: false,
                           id: rec.id})
  }
  let base = nslots[f2]
  let has_defer = scan_body_stmts(f2, funcs[f2].stmts, funcs[f2].body_key)
  leave_scope(f2)
  block_info[funcs[f2].body_key] =
      {base: base, high: nslots[f2], wrap: nslots[f2] > base || has_defer}
}

fn scan_block(blk, f) {
  enter_scope(f)
  let base = nslots[f]
  mut has_defer = false
  for s in blk.nodes {
    if s.name == 'fn_decl' {
      fail(s, "fn declarations are only allowed at a function's top level")
    }
    if s.name == 'defer_s' { has_defer = true }
    scan_stmt(s, f)
  }
  leave_scope(f)
  block_info[pkey(blk)] =
      {base: base, high: nslots[f], wrap: nslots[f] > base || has_defer}
}

fn scan_stmt(node, f) {
  match node {
    {name: 'fn_decl'} =>
      fail(node, "fn declarations are only allowed at a function's top level"),
    {name: 'decl', nodes: [kw, pat, value]} => {
      # a closure initializer sees its own binding (culebra's letrec shape;
      # the cell->closure->cell cycle it can build now falls to the
      # backstop); everything else binds after its initializer
      let letrec = pat.name == 'ident' &&
                   (value.name == 'closure' || value.name == 'lambda')
      if letrec {
        declare_var(f, pat.token, kw.token == 'mut', pat)
        scan_expr(value, f)
      } else {
        scan_expr(value, f)
        cond {
          pat.name == 'tup_pat' || pat.name == 'arr_pat' => {
            new_scratch(f, pat)
            for id in pat.nodes { declare_var(f, id.token, kw.token == 'mut', id) }
          },
          _ => declare_var(f, pat.token, kw.token == 'mut', pat),
        }
      }
    },
    {name: 'assign', nodes: [lhs, op, value]} => {
      scan_expr(value, f)
      cond {
        lhs.name == 'ident' => {
          let r = resolve(f, lhs.token)
          if r.kind == 'none' { fail(lhs, "undefined variable '{lhs.token}'") }
          if r.kind == 'class' { fail(lhs, "cannot assign to class '{lhs.token}'") }
          if r.kind == 'fn' { fail(lhs, "cannot assign to fn '{lhs.token}'") }
          if !r.is_mut { fail(lhs, "cannot assign to immutable '{lhs.token}'") }
          note_use(lhs, f, r)
        },
        # a[k] = v / o.k = v: the receiver chain is an expression; the last
        # step is the write target
        lhs.name == 'postfix' => {
          let last = lhs.nodes[lhs.nodes.size() - 1]
          if last.name == 'mcall' { fail(last, 'cannot assign to a call') }
          if op.token != '=' {
            new_scratch(f, op)    # holds the receiver
            new_scratch(f, lhs)   # holds the key
          }
          scan_expr(lhs.nodes[0], f)
          mut i = 1
          while i < lhs.nodes.size() {
            let step = lhs.nodes[i]
            if step.name == 'subscript' { scan_expr(step.nodes[0], f) }
            if step.name == 'mcall' {
              if i < lhs.nodes.size() - 1 {
                for a in step.nodes[1].nodes { scan_expr(a, f) }
              }
            }
            i = i + 1
          }
        },
        _ => fail(lhs, 'cannot assign to this expression'),
      }
    },
    {name: 'for', nodes: [pat, iterable, body]} => {
      scan_expr(iterable, f)
      new_scratch(f, node)   # the iterator lives across the loop
      enter_scope(f)
      let base = nslots[f]
      cond {
        pat.name == 'tup_pat' =>
          for id in pat.nodes { declare_var(f, id.token, false, id) },
        _ => declare_var(f, pat.token, false, pat),
      }
      loop_depth[f] = loop_depth[f] + 1
      mut has_defer = false
      for s in body.nodes {
        if s.name == 'fn_decl' {
          fail(s, "fn declarations are only allowed at a function's top level")
        }
        if s.name == 'defer_s' { has_defer = true }
        scan_stmt(s, f)
      }
      loop_depth[f] = loop_depth[f] - 1
      leave_scope(f)
      block_info[pkey(body)] =
          {base: base, high: nslots[f], wrap: true}
    },
    {name: 'while', nodes: [cnd, body]} => {
      scan_expr(cnd, f)
      loop_depth[f] = loop_depth[f] + 1
      scan_block(body, f)
      loop_depth[f] = loop_depth[f] - 1
    },
    {name: 'yield_v', nodes: [e]} => {
      if funcs[f].is_gen != true {
        fail(node, "yield can only appear inside a named fn declaration (a lambda, closure, method, or defer body cannot be a generator)")
      }
      scan_expr(e, f)
    },
    {name: 'yield_f', nodes: [e]} => {
      if funcs[f].is_gen != true {
        fail(node, "yield can only appear inside a named fn declaration (a lambda, closure, method, or defer body cannot be a generator)")
      }
      scan_expr(e, f)
      new_scratch(f, node)   # the delegated-to iterator lives across the loop
    },
    {name: 'break_s'} => {
      if loop_depth[f] == 0 { fail(node, "'break' outside a loop") }
    },
    {name: 'continue_s'} => {
      if loop_depth[f] == 0 { fail(node, "'continue' outside a loop") }
    },
    {name: 'return_s'} => {
      if node.nodes.size() == 1 { scan_expr(node.nodes[0], f) }
    },
    {name: 'throw_s', nodes: [value]} => scan_expr(value, f),
    {name: 'defer_s', nodes: [blk]} => {
      let g = new_func(f, "defer@{node.line}:{node.column}", blk.nodes,
                       pkey(blk))
      closure_of[pkey(node)] = g
      let saved = loop_depth[f]
      walk_fn(g, [])
      loop_depth[f] = saved
    },
    {name: 'bare_block', nodes: [blk]} => scan_block(blk, f),
    _ => scan_expr(node, f),
  }
}

fn scan_if(node, f) {
  scan_expr(node.nodes[0], f)
  scan_block(node.nodes[1], f)
  if node.nodes.size() == 3 {
    let alt = node.nodes[2]
    if alt.name == 'if' { scan_if(alt, f) } else { scan_block(alt, f) }
  }
}

fn scan_try(node, f) {
  let [body, id, handler] = node.nodes
  scan_block(body, f)
  enter_scope(f)
  let caught = declare_var(f, id.token, false, id)
  mut has_defer = false
  for s in handler.nodes {
    if s.name == 'fn_decl' {
      fail(s, "fn declarations are only allowed at a function's top level")
    }
    if s.name == 'defer_s' { has_defer = true }
    scan_stmt(s, f)
  }
  leave_scope(f)
  block_info[pkey(handler)] =
      {base: caught, high: nslots[f], wrap: true}   # owns the caught slot
}

fn scan_call(node, f) {
  let [id, args] = node.nodes
  for a in args.nodes { scan_expr(arg_val(a), f) }
  if id.token == 'println' || id.token == 'print' {
    if args.nodes.size() != 1 { fail(id, "{id.token} takes 1 argument") }
    return nil
  }
  if !in_prelude && builtins.has(id.token) {
    cond {
      id.token == 'range' => {
        if args.nodes.size() < 1 || args.nodes.size() > 2 {
          fail(id, 'range takes 1 or 2 arguments')
        }
      },
      id.token == 'iota' => {
        if args.nodes.size() < 1 || args.nodes.size() > 2 {
          fail(id, 'iota takes 1 or 2 arguments')
        }
      },
      _ => {
        let (_, arity) = builtins[id.token]
        if args.nodes.size() != arity {
          fail(id, "{id.token} takes {arity} argument(s)")
        }
      },
    }
    return nil
  }
  if in_prelude {
    if intrinsics.has(id.token) {
      let (_, arity) = intrinsics[id.token]
      if args.nodes.size() != arity {
        fail(id, "{id.token} takes {arity} argument(s)")
      }
      return nil
    }
    if id.token == '__error' {
      if args.nodes.size() != 4 { fail(id, '__error takes 4 arguments') }
      return nil
    }
  }
  let r = resolve(f, id.token)
  cond {
    r.kind == 'none' => fail(id, "undefined name '{id.token}'"),
    r.kind == 'class' => {
      resolved[pkey(id)] = r
      use_var(f, r.owner, r.slot)
    },
    r.kind == 'fn' => {
      resolved[pkey(id)] = r
      for g in r.funcs { calls[f].push(g) }
      # multimethod / kwargs / defaults sites hold each argument in its own
      # slot while the dispatch tests run
      if needs_dispatch(r.funcs, args) {
        for a in args.nodes { new_scratch(f, arg_val(a)) }
      }
    },
    _ => note_use(id, f, r),   # a closure value being called
  }
}

fn arg_val(a) {
  cond { a.name == 'kwarg' => a.nodes[1], _ => a }
}

fn kwarg_name(a) {
  cond { a.name == 'kwarg' => a.nodes[0].token, _ => nil }
}

# The old direct emission survives for the plain shape: one overload, no
# types, defaults, or rest, all-positional call at exact arity.
fn needs_dispatch(fns, args) {
  if fns.size() != 1 { return true }
  let specs = funcs[fns[0]].pspecs
  for a in args.nodes {
    if a.name == 'kwarg' { return true }
  }
  for rec in specs {
    if rec.ty != nil { return true }
    if rec.dflt != nil { return true }
    if rec.rest { return true }
  }
  args.nodes.size() != specs.size()
}

# Chained comparisons: every middle operand is held in a scratch slot while
# the rest of the chain evaluates. Short-circuit || and &&: the left value
# is held across the decision. Each op token gets its own slot -- a few
# extra locals beat a lifetime analysis.
# match: three slots per site (subject, matched, result); each arm opens a
# scope for its bindings, whose block_info drives the emitter like any
# other block.
fn scan_match(node, f) {
  scan_expr(node.nodes[0], f)
  new_scratch(f, node)                    # subject
  new_scratch(f, node.nodes[0])           # matched flag
  new_scratch(f, node.nodes[1])           # result
  mut i = 1
  while i < node.nodes.size() {
    scan_arm(node.nodes[i], f)
    i = i + 1
  }
}

fn scan_arm(arm, f) {
  enter_scope(f)
  let base = nslots[f]
  scan_pattern(arm.nodes[0], f)
  mut i = 1
  while i < arm.nodes.size() {
    let piece = arm.nodes[i]
    cond {
      piece.name == 'guard' => scan_expr(piece.nodes[0], f),
      piece.name == 'block' => {
        # the arm body block scans inside the arm scope so bindings resolve;
        # it wraps itself as usual
        scan_block(piece, f)
      },
      _ => scan_expr(piece, f),
    }
    i = i + 1
  }
  leave_scope(f)
  block_info[pkey(arm)] = {base: base, high: nslots[f], wrap: true}
}

fn scan_pattern(pat, f) {
  match pat {
    {name: 'bind_p', nodes: [id]} => declare_var(f, id.token, false, id),
    {name: 'obj_p'} => {
      for op in pat.nodes {
        cond {
          op.nodes.size() == 2 => scan_pattern(op.nodes[1], f),
          _ => declare_var(f, op.nodes[0].token, false, op.nodes[0]),
        }
      }
    },
    {name: 'arr_p'} => { for sp in pat.nodes { scan_pattern(sp, f) } },
    {name: 'tup_p'} => { for sp in pat.nodes { scan_pattern(sp, f) } },
    _ => nil,
  }
}

fn scan_cond(node, f) {
  new_scratch(f, node)                    # matched flag
  new_scratch(f, node.nodes[0])           # result
  for carm in node.nodes {
    let head = carm.nodes[0]
    if head.name != 'wild_p' { scan_expr(head, f) }
    let body = carm.nodes[1]
    cond {
      body.name == 'block' => scan_block(body, f),
      _ => scan_expr(body, f),
    }
  }
}

fn scan_chain_ops(node, f, give_scratch) {
  let nodes = node.nodes
  scan_expr(nodes[0], f)
  mut i = 1
  while i < nodes.size() {
    if give_scratch { new_scratch(f, nodes[i]) }
    scan_expr(nodes[i + 1], f)
    i = i + 2
  }
}

# UFCS: a .name(...) whose name is not a built-in method falls back to a
# free function in scope; note the resolution (and its scratches) now.
fn scan_mcall_target(step, f) {
  let name = step.nodes[0]
  if builtin_methods.contains(name.token) { return nil }
  let r = resolve(f, name.token)
  if r.kind == 'fn' {
    resolved[pkey(name)] = r
    for g in r.funcs { calls[f].push(g) }
    # the receiver + each argument each hold a slot across dispatch
    new_scratch(f, name)
    for a in step.nodes[1].nodes { new_scratch(f, arg_val(a)) }
  }
}

fn scan_expr(node, f) {
  match node {
    {name: 'number'} => nil,
    {name: 'float'} => nil,
    {name: 'str_sq'} => nil,
    {name: 'str_dq'} => {
      for part in node.nodes {
        if part.name == 'interp' { scan_expr(part.nodes[0], f) }
      }
    },
    {name: 'true_l'} => nil,
    {name: 'false_l'} => nil,
    {name: 'nil_l'} => nil,
    {name: 'ident', token} => {
      let r = resolve(f, token)
      if r.kind == 'none' { fail(node, "undefined variable '{token}'") }
      if r.kind == 'class' {
        resolved[pkey(node)] = {kind: 'var', owner: r.owner, slot: r.slot,
                                is_mut: false}
        use_var(f, r.owner, r.slot)
        return nil
      }
      if r.kind == 'fn' {
        # a named fn used as a value closes over its captures here (the
        # self-cycle this can build now falls to the backstop); referencing
        # a whole multimethod family as one value has no single closure
        if r.funcs.size() > 1 {
          fail(node, "fn '{token}' has multiple definitions and can only be called")
        }
        resolved[pkey(node)] = r
        calls[f].push(r.funcs[0])
        return nil
      }
      note_use(node, f, r)
    },
    {name: 'call'} => scan_call(node, f),
    {name: 'array_lit'} => { for e in node.nodes { scan_expr(e, f) } },
    {name: 'tuple'} => { for e in node.nodes { scan_expr(e, f) } },
    {name: 'object_lit'} => {
      for pair in node.nodes {
        let k = pair.nodes[0]
        if k.name != 'ident' && k.name != 'str_sq' { scan_expr(k, f) }
        scan_expr(pair.nodes[1], f)
      }
    },
    {name: 'set_lit'} => { for e in node.nodes { scan_expr(e, f) } },
    {name: 'lambda', nodes: [prms, bodye]} => {
      let g = new_func(f, "fn@{node.line}:{node.column}", [bodye],
                       pkey(node))
      closure_of[pkey(node)] = g
      closure_funcs[g] = true
      fn_pos[g] = (node.line, node.column)
      if mentions_self(bodye) { self_closure[g] = resolve(f, 'self') }
      let saved = loop_depth[f]
      walk_fn(g, prms.nodes)
      loop_depth[f] = saved
    },
    {name: 'closure', nodes: [prms, blk]} => {
      let g = new_func(f, "fn@{node.line}:{node.column}", blk.nodes,
                       pkey(blk))
      closure_of[pkey(node)] = g
      closure_funcs[g] = true
      fn_pos[g] = (node.line, node.column)
      if mentions_self(blk) { self_closure[g] = resolve(f, 'self') }
      let saved = loop_depth[f]
      walk_fn(g, prms.nodes)
      loop_depth[f] = saved
    },
    {name: 'if'} => scan_if(node, f),
    {name: 'try'} => scan_try(node, f),
    {name: 'neg', nodes: [operand]} => scan_expr(operand, f),
    {name: 'lnot', nodes: [operand]} => scan_expr(operand, f),
    {name: 'bnot', nodes: [operand]} => scan_expr(operand, f),
    {name: 'power', nodes} => {
      scan_expr(nodes[0], f)
      if nodes.size() == 3 { scan_expr(nodes[2], f) }
    },
    {name: 'postfix', nodes} => {
      scan_expr(nodes[0], f)
      mut i = 1
      while i < nodes.size() {
        let step = nodes[i]
        if step.name == 'subscript' { scan_expr(step.nodes[0], f) }
        if step.name == 'mcall' {
          for a in step.nodes[1].nodes { scan_expr(arg_val(a), f) }
          scan_mcall_target(step, f)
        }
        if step.name == 'pcall' {
          for a in step.nodes[0].nodes { scan_expr(arg_val(a), f) }
        }
        i = i + 1
      }
    },
    {name: 'match'} => scan_match(node, f),
    {name: 'cond_e'} => scan_cond(node, f),
    {name: 'ternary', nodes} => {
      scan_expr(nodes[0], f)
      new_scratch(f, node)
      scan_expr(nodes[1], f)
      scan_expr(nodes[2], f)
    },
    {name: 'nilco'} => scan_chain_ops(node, f, true),
    {name: 'cmp'} => scan_chain_ops(node, f, true),
    {name: 'lor'} => scan_chain_ops(node, f, true),
    {name: 'land'} => scan_chain_ops(node, f, true),
    {name: 'bor'} => scan_chain_ops(node, f, false),
    {name: 'bxor'} => scan_chain_ops(node, f, false),
    {name: 'band'} => scan_chain_ops(node, f, false),
    {name: 'shift'} => scan_chain_ops(node, f, false),
    {name: 'add'} => scan_chain_ops(node, f, false),
    {name: 'mul'} => scan_chain_ops(node, f, false),
    _ => fail(node, "cannot evaluate {node.name}"),
  }
}

# --- Pass B: solve ------------------------------------------------------------
#
# Two obligations, iterated together to a fixpoint (see the integer-subset
# history for the derivation): a call from f to a named fn g builds g's
# capture map in f's frame; a function nested in p resolves its own map in
# p's frame. Whatever anyone captures, its owner keeps in a cell.

fn solve() {
  mut changed = true
  while changed {
    changed = false
    for f in range(funcs.size()) {
      for g in calls[f] {
        for v in free[g].values() {
          let (o, s) = v
          if o != f {
            let key = "{o}:{s}"
            if !free[f].has(key) {
              free[f][key] = v
              changed = true
            }
          }
        }
      }
      let p = funcs[f].parent
      if p != nil {
        for v in free[f].values() {
          let (o, s) = v
          if o != p {
            let key = "{o}:{s}"
            if !free[p].has(key) {
              free[p][key] = v
              changed = true
            }
          }
        }
      }
    }
  }

  for f in range(funcs.size()) {
    mut i = 0
    for v in free[f].values() {
      let (o, s) = v
      capture_index[f]["{o}:{s}"] = i
      i = i + 1
      if !cell_index[o].has(s) {
        cell_index[o][s] = cell_index[o].size()
      }
    }
  }
}

# `f`'s own view of a variable: its own slot (a cell if anything nested
# captures it, otherwise a plain local), or the index `f` captures it at.
fn access_from(f, v) {
  let (o, s) = v
  cond {
    o == f => cond {
      cell_index[f].has(s) => {kind: 'cell', index: cell_index[f][s]},
      _ => {kind: 'local', index: s},
    },
    _ => {kind: 'capture', index: capture_index[f]["{o}:{s}"]},
  }
}

# A scratch slot's local index: appended after the named slots.
fn scratch_slot(f, k) { nslots[f] + k }

# --- Pass C: emit -------------------------------------------------------------

# Raw IR fragments the lowering composes without prelude round-trips: the
# checks below only ever compare typeof (a string) against a literal, which
# the VM's own eq handles.
fn ir_typeof(m, v, ln, cl) {
  let a = m.list_new()
  m.list_push(a, v)
  m.intrinsic(name: 'typeof', args_list: a, line: ln, col: cl)
}

fn ir_bool(m, v, ln, cl) { m.bool_literal(v: v, line: ln, col: cl) }

fn ir_and(m, a, b, ln, cl) {
  m.make_if_else(cond: a, then_branch: b, else_branch: ir_bool(m, false, ln, cl),
                 line: ln, col: cl)
}

fn make_list(m, ids) {
  let list = m.list_new()
  for x in ids { m.list_push(list, x) }
  list
}

fn cmap_for(m, f, g) {
  let cmap = m.capture_map_new()
  for v in free[g].values() {
    let a = access_from(f, v)
    m.capture_map_push(cmap, kind: a.kind, index: a.index)
  }
  m.add_capture_map(cmap)
}

# A call to a prelude helper, with the user-site position threaded in.
fn call_pre(m, f, name, arg_ids, ln, cl) {
  let g = prelude_named[name]
  calls_note(f, g)
  let callee = m.make_closure(func: g, cmap: cmap_for(m, f, g),
                              line: ln, col: cl)
  m.call_value(callee: callee, args_list: make_list(m, arg_ids),
               line: ln, col: cl)
}

# Pass C discovers prelude calls the scan didn't see (they come from the
# lowering itself). The prelude captures nothing, so no fixpoint re-run is
# needed -- this is bookkeeping only, kept for symmetry.
fn calls_note(f, g) { nil }

# The prelude-only marks give the prelude bytes the surface language cannot
# spell: \z is 0x01 (the tuple/mut-metadata key prefix -- no user string can
# collide with it) and \y/\x/\w are the UTF-8 lead-byte thresholds 0xC0 /
# 0xE0 / 0xF0 its code-point iterator compares against.
fn unescape(s) {
  mut out = ''
  mut i = 0
  while i < s.size() {
    let c = s.slice(i, i + 1)
    cond {
      c == "\\" && i + 1 < s.size() => {
        let d = s.slice(i + 1, i + 2)
        out = out + cond {
          d == 'n' => "\n",
          d == 't' => "\t",
          d == 'r' => "\r",
          in_prelude && d == 'z' => String.from_code_point(1),
          in_prelude && d == 'y' => String.from_bytes([192]),
          in_prelude && d == 'x' => String.from_bytes([224]),
          in_prelude && d == 'w' => String.from_bytes([240]),
          _ => d,   # backslash, brace, quotes: the char itself
        }
        i = i + 2
      },
      _ => {
        out = out + c
        i = i + 1
      },
    }
  }
  out
}

fn parse_int_token(tok) {
  cond {
    tok.starts_with('0x') => to_long(tok.slice(2, tok.size()), base: 16),
    tok.starts_with('0b') => to_long(tok.slice(2, tok.size()), base: 2),
    _ => to_long(tok),
  }
}

fn binop_prelude(tok) {
  cond {
    tok == '+' => '__add',
    tok == '-' => '__sub',
    tok == '*' => '__mul',
    tok == '/' => '__div',
    tok == '%' => '__mod',
    tok == '<' => '__lt',
    tok == '<=' => '__le',
    tok == '>' => '__gt',
    tok == '>=' => '__ge',
    tok == '&' => '__band',
    tok == '|' => '__bor',
    tok == '^' => '__bxor',
    tok == '<<' => '__shl',
    tok == '>>' => '__shr',
    tok == '**' => '__pow',
    _ => nil,
  }
}

fn binop_raw(tok) {
  cond {
    tok == '+' => 'add',
    tok == '-' => 'sub',
    tok == '*' => 'mul',
    tok == '/' => 'div',
    tok == '%' => 'mod',
    tok == '==' => 'eq',
    tok == '!=' => 'ne',
    tok == '<' => 'lt',
    tok == '<=' => 'le',
    tok == '>' => 'gt',
    tok == '>=' => 'ge',
    tok == '&' => 'bitand',
    tok == '|' => 'bitor',
    tok == '^' => 'bitxor',
    tok == '<<' => 'shl',
    _ => 'shr',
  }
}

fn pos_args(m, node) {
  (m.literal(v: node.line, line: node.line, col: node.column),
   m.literal(v: node.column, line: node.line, col: node.column))
}

# One binary application, per dialect: the prelude compiles the raw VM
# node; user code calls the prelude wrapper that implements culebra's rule.
fn emit_binop(m, f, tok, lhs_id, rhs_id, op_node) {
  if in_prelude || binop_prelude(tok) == nil {
    if tok == '==' || tok == '!=' {
      if !in_prelude {
        let e = call_pre(m, f, '__eq', [lhs_id, rhs_id],
                         op_node.line, op_node.column)
        if tok == '==' { return e }
        return m.make_if_else(cond: e,
                              then_branch: m.bool_literal(v: false, line: op_node.line, col: op_node.column),
                              else_branch: m.bool_literal(v: true, line: op_node.line, col: op_node.column),
                              line: op_node.line, col: op_node.column)
      }
    }
    return m.binary(op: binop_raw(tok), lhs: lhs_id, rhs: rhs_id,
                    line: op_node.line, col: op_node.column)
  }
  let (ln, cl) = pos_args(m, op_node)
  call_pre(m, f, binop_prelude(tok), [lhs_id, rhs_id, ln, cl],
           op_node.line, op_node.column)
}

fn emit_left_chain(m, node, f) {
  let nodes = node.nodes
  mut value = emit_expr(m, nodes[0], f)
  mut i = 1
  while i < nodes.size() {
    let rhs = emit_expr(m, nodes[i + 1], f)
    value = emit_binop(m, f, nodes[i].token, value, rhs, nodes[i])
    i = i + 2
  }
  value
}

# a OP b OP c ...: strictly culebra -- each middle evaluates once, the
# chain short-circuits left to right. Lowered as nested ifs over scratch
# slots. Comparison results are real Bools, so the condition needs no
# truthiness call.
fn emit_cmp_chain(m, node, f) {
  let nodes = node.nodes
  if nodes.size() == 3 {
    let l = emit_expr(m, nodes[0], f)
    let r = emit_expr(m, nodes[2], f)
    return emit_cmp_one(m, f, nodes[1], l, r)
  }
  emit_cmp_rest(m, node, f, emit_expr(m, nodes[0], f), 1)
}

fn emit_cmp_rest(m, node, f, lhs_id, i) {
  let nodes = node.nodes
  let op = nodes[i]
  let ln = op.line
  let cl = op.column
  if i + 2 >= nodes.size() {
    let r = emit_expr(m, nodes[i + 1], f)
    return emit_cmp_one(m, f, op, lhs_id, r)
  }
  # middle operand: hold it, compare, and only then continue the chain
  let slot = scratch_slot(f, scratch_of[pkey(op)])
  let store = m.assign(kind: 'local', index: slot,
                       value: emit_expr(m, nodes[i + 1], f), line: ln, col: cl)
  let first = emit_cmp_one(m, f, op, lhs_id,
                           m.var_ref(kind: 'local', index: slot,
                                     line: ln, col: cl))
  let rest = emit_cmp_rest(m, node, f,
                           m.var_ref(kind: 'local', index: slot,
                                     line: ln, col: cl),
                           i + 2)
  let stmts = make_list(m, [store])
  let seq = m.block(stmts_list: stmts, line: ln, col: cl)
  # block: [store]; value: if first { rest } else { false }
  let cond_v = m.make_if_else(cond: first, then_branch: rest,
                              else_branch: m.bool_literal(v: false, line: ln, col: cl),
                              line: ln, col: cl)
  let outer = make_list(m, [seq, cond_v])
  m.block(stmts_list: outer, line: ln, col: cl)
}

fn emit_cmp_one(m, f, op, l, r) {
  emit_binop(m, f, op.token, l, r, op)
}

# a && b  ->  t = a; if truthy(t) { b } else { t }
# a || b  ->  t = a; if truthy(t) { t } else { b }
fn emit_shortcircuit(m, node, f) {
  let nodes = node.nodes
  mut value = emit_expr(m, nodes[0], f)
  mut i = 1
  while i < nodes.size() {
    let op = nodes[i]
    let ln = op.line
    let cl = op.column
    let slot = scratch_slot(f, scratch_of[pkey(op)])
    let store = m.assign(kind: 'local', index: slot, value: value,
                         line: ln, col: cl)
    let t = fn () { m.var_ref(kind: 'local', index: slot, line: ln, col: cl) }
    let (pl, pc) = pos_args(m, op)
    let c = call_pre(m, f, '__truthy', [t(), pl, pc], ln, cl)
    let rhs = emit_expr(m, nodes[i + 1], f)
    let picked = cond {
      op.token == '&&' => m.make_if_else(cond: c, then_branch: rhs,
                                         else_branch: t(), line: ln, col: cl),
      _ => m.make_if_else(cond: c, then_branch: t(), else_branch: rhs,
                          line: ln, col: cl),
    }
    let seq = make_list(m, [store, picked])
    value = m.block(stmts_list: seq, line: ln, col: cl)
    i = i + 2
  }
  value
}

# a ?? b: keep a unless it is nil. The slot is the op's scratch.
fn emit_nilco(m, node, f) {
  let nodes = node.nodes
  mut value = emit_expr(m, nodes[0], f)
  mut i = 1
  while i < nodes.size() {
    let op = nodes[i]
    let ln = op.line
    let cl = op.column
    let slot = scratch_slot(f, scratch_of[pkey(op)])
    let store = m.assign(kind: 'local', index: slot, value: value,
                         line: ln, col: cl)
    fn tref() { m.var_ref(kind: 'local', index: slot, line: ln, col: cl) }
    let isnil = m.binary(op: 'eq',
                         lhs: ir_typeof(m, tref(), ln, cl),
                         rhs: m.str_literal(s: 'nil', line: ln, col: cl),
                         line: ln, col: cl)
    let picked = m.make_if_else(cond: isnil,
                                then_branch: emit_expr(m, nodes[i + 1], f),
                                else_branch: tref(), line: ln, col: cl)
    value = m.block(stmts_list: make_list(m, [store, picked]), line: ln, col: cl)
    i = i + 2
  }
  value
}

# One pattern, compiled to a test over `subj()` (a fresh reference each
# call) plus binding assignments run when the arm is taken. Sub-values are
# re-read through index chains -- pure reads, so repetition is safe.
fn emit_pat_test(m, f, pat, subj, ln, cl) {
  match pat {
    {name: 'wild_p'} => ir_bool(m, true, ln, cl),
    {name: 'bind_p'} => ir_bool(m, true, ln, cl),
    {name: 'nil_p'} => m.binary(op: 'eq', lhs: ir_typeof(m, subj(), ln, cl),
                                rhs: m.str_literal(s: 'nil', line: ln, col: cl),
                                line: ln, col: cl),
    {name: 'true_p'} => emit_pat_eq(m, f, subj, m.bool_literal(v: true, line: ln, col: cl), ln, cl),
    {name: 'false_p'} => emit_pat_eq(m, f, subj, m.bool_literal(v: false, line: ln, col: cl), ln, cl),
    {name: 'num_p'} => emit_pat_eq(m, f, subj,
                                   m.literal(v: parse_int_token(pat.nodes[0].token), line: ln, col: cl),
                                   ln, cl),
    {name: 'float_p'} => emit_pat_eq(m, f, subj,
                                     m.double_literal(v: to_float(pat.nodes[0].token), line: ln, col: cl),
                                     ln, cl),
    {name: 'str_p'} => emit_pat_eq(m, f, subj,
                                   m.str_literal(s: pat.nodes[0].token, line: ln, col: cl),
                                   ln, cl),
    {name: 'obj_p'} => {
      mut t = m.binary(op: 'eq', lhs: ir_typeof(m, subj(), ln, cl),
                       rhs: m.str_literal(s: 'object', line: ln, col: cl),
                       line: ln, col: cl)
      for op in pat.nodes {
        let key = op.nodes[0].token
        let ha = m.list_new()
        m.list_push(ha, subj())
        m.list_push(ha, m.str_literal(s: key, line: ln, col: cl))
        let haskey = m.intrinsic(name: 'objecthas', args_list: ha,
                                 line: ln, col: cl)
        t = ir_and(m, t, haskey, ln, cl)
        if op.nodes.size() == 2 {
          fn sub() {
            m.index(recv: subj(), key: m.str_literal(s: key, line: ln, col: cl),
                    line: ln, col: cl)
          }
          t = ir_and(m, t, emit_pat_test(m, f, op.nodes[1], sub, ln, cl), ln, cl)
        }
      }
      t
    },
    {name: 'arr_p'} => emit_seq_pat(m, f, pat, subj, 'array', ln, cl),
    {name: 'tup_p'} => {
      let items = fn () { call_pre(m, f, '__titems', [subj()], ln, cl) }
      let ist = call_pre(m, f, '__is_tuple', [subj()], ln, cl)
      ir_and(m, ist, emit_seq_items(m, f, pat, items, ln, cl), ln, cl)
    },
    _ => fail(pat, "unsupported pattern {pat.name}"),
  }
}

fn emit_pat_eq(m, f, subj, lit, ln, cl) {
  call_pre(m, f, '__eq', [subj(), lit], ln, cl)
}

fn emit_seq_pat(m, f, pat, subj, tyname, ln, cl) {
  let t = m.binary(op: 'eq', lhs: ir_typeof(m, subj(), ln, cl),
                   rhs: m.str_literal(s: tyname, line: ln, col: cl),
                   line: ln, col: cl)
  ir_and(m, t, emit_seq_items(m, f, pat, subj, ln, cl), ln, cl)
}

fn emit_seq_items(m, f, pat, items, ln, cl) {
  let n = pat.nodes.size()
  let la = m.list_new()
  m.list_push(la, items())
  let lenv = m.intrinsic(name: 'len', args_list: la, line: ln, col: cl)
  mut t = m.binary(op: 'eq', lhs: lenv, rhs: m.literal(v: n, line: ln, col: cl),
                   line: ln, col: cl)
  mut i = 0
  while i < n {
    let idx = i
    fn sub() {
      m.index(recv: items(), key: m.literal(v: idx, line: ln, col: cl),
              line: ln, col: cl)
    }
    t = ir_and(m, t, emit_pat_test(m, f, pat.nodes[idx], sub, ln, cl), ln, cl)
    i = i + 1
  }
  t
}

# Binding assignments for a taken arm, in pattern order.
fn emit_pat_binds(m, f, pat, subj, ids, ln, cl) {
  match pat {
    {name: 'bind_p', nodes: [id]} => {
      let r = resolved[pkey(id)]
      let a = access_from(f, (f, r.slot))
      ids.push(m.assign(kind: a.kind, index: a.index, value: subj(),
                        line: id.line, col: id.column))
    },
    {name: 'obj_p'} => {
      for op in pat.nodes {
        let key = op.nodes[0].token
        fn sub() {
          m.index(recv: subj(), key: m.str_literal(s: key, line: ln, col: cl),
                  line: ln, col: cl)
        }
        cond {
          op.nodes.size() == 2 => emit_pat_binds(m, f, op.nodes[1], sub, ids, ln, cl),
          _ => {
            let r = resolved[pkey(op.nodes[0])]
            let a = access_from(f, (f, r.slot))
            ids.push(m.assign(kind: a.kind, index: a.index, value: sub(),
                              line: ln, col: cl))
          },
        }
      }
    },
    {name: 'arr_p'} => emit_seq_binds(m, f, pat, subj, ids, ln, cl),
    {name: 'tup_p'} => {
      let items = fn () { call_pre(m, f, '__titems', [subj()], ln, cl) }
      emit_seq_binds(m, f, pat, items, ids, ln, cl)
    },
    _ => nil,
  }
}

fn emit_seq_binds(m, f, pat, items, ids, ln, cl) {
  mut i = 0
  while i < pat.nodes.size() {
    let idx = i
    fn sub() {
      m.index(recv: items(), key: m.literal(v: idx, line: ln, col: cl),
              line: ln, col: cl)
    }
    emit_pat_binds(m, f, pat.nodes[idx], sub, ids, ln, cl)
    i = i + 1
  }
}

fn emit_match(m, node, f) {
  let ln = node.line
  let cl = node.column
  let subj_slot = scratch_slot(f, scratch_of[pkey(node)])
  let flag_slot = scratch_slot(f, scratch_of[pkey(node.nodes[0])])
  let res_slot = scratch_slot(f, scratch_of[pkey(node.nodes[1])])
  fn subj() { m.var_ref(kind: 'local', index: subj_slot, line: ln, col: cl) }
  mut ids = [
    m.assign(kind: 'local', index: subj_slot,
             value: emit_expr(m, node.nodes[0], f), line: ln, col: cl),
    m.assign(kind: 'local', index: flag_slot, value: ir_bool(m, false, ln, cl),
             line: ln, col: cl),
    m.assign(kind: 'local', index: res_slot,
             value: m.nil_literal(line: ln, col: cl), line: ln, col: cl),
  ]
  mut i = 1
  while i < node.nodes.size() {
    let arm = node.nodes[i]
    let pat = arm.nodes[0]
    mut guard = nil
    mut body = arm.nodes[arm.nodes.size() - 1]
    if arm.nodes.size() == 3 { guard = arm.nodes[1] }
    let notyet = m.make_if_else(
        cond: m.var_ref(kind: 'local', index: flag_slot, line: ln, col: cl),
        then_branch: ir_bool(m, false, ln, cl),
        else_branch: emit_pat_test(m, f, pat, subj, ln, cl),
        line: ln, col: cl)
    # taken: bindings, then guard, then body into the result
    mut arm_ids = []
    emit_pat_binds(m, f, pat, subj, arm_ids, ln, cl)
    let bodyv = cond {
      body.name == 'block' => emit_block(m, body, f),
      _ => emit_expr(m, body, f),
    }
    let take = m.block(stmts_list: make_list(m, [
        m.assign(kind: 'local', index: flag_slot, value: ir_bool(m, true, ln, cl),
                 line: ln, col: cl),
        m.assign(kind: 'local', index: res_slot, value: bodyv, line: ln, col: cl),
    ]), line: ln, col: cl)
    let guarded = cond {
      guard == nil => take,
      _ => {
        let (pl, pc) = pos_args(m, guard)
        let g0 = emit_expr(m, guard.nodes[0], f)
        let g = call_pre(m, f, '__truthy', [g0, pl, pc], ln, cl)
        m.make_if(cond: g, then_branch: take, line: ln, col: cl)
      },
    }
    let info = block_info[pkey(arm)]
    let pre = fresh_cells(m, f, info.base, info.high, arm.line, arm.column)
    let inner = m.block(stmts_list: make_list(m, pre + arm_ids + [guarded]),
                        line: arm.line, col: arm.column)
    let scoped = m.scope(first_local: info.base, end_local: nslots[f],
                         body: inner, line: arm.line, col: arm.column)
    ids.push(m.make_if(cond: notyet, then_branch: scoped, line: ln, col: cl))
    i = i + 1
  }
  ids.push(m.var_ref(kind: 'local', index: res_slot, line: ln, col: cl))
  m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
}

fn emit_cond(m, node, f) {
  let ln = node.line
  let cl = node.column
  let flag_slot = scratch_slot(f, scratch_of[pkey(node)])
  let res_slot = scratch_slot(f, scratch_of[pkey(node.nodes[0])])
  mut ids = [
    m.assign(kind: 'local', index: flag_slot, value: ir_bool(m, false, ln, cl),
             line: ln, col: cl),
    m.assign(kind: 'local', index: res_slot,
             value: m.nil_literal(line: ln, col: cl), line: ln, col: cl),
  ]
  for carm in node.nodes {
    let head = carm.nodes[0]
    let body = carm.nodes[1]
    let ctest = cond {
      head.name == 'wild_p' => ir_bool(m, true, ln, cl),
      _ => {
        let (pl, pc) = pos_args(m, head)
        call_pre(m, f, '__truthy', [emit_expr(m, head, f), pl, pc],
                 head.line, head.column)
      },
    }
    let notyet = m.make_if_else(
        cond: m.var_ref(kind: 'local', index: flag_slot, line: ln, col: cl),
        then_branch: ir_bool(m, false, ln, cl),
        else_branch: ctest, line: ln, col: cl)
    let bodyv = cond {
      body.name == 'block' => emit_block(m, body, f),
      _ => emit_expr(m, body, f),
    }
    let take = m.block(stmts_list: make_list(m, [
        m.assign(kind: 'local', index: flag_slot, value: ir_bool(m, true, ln, cl),
                 line: ln, col: cl),
        m.assign(kind: 'local', index: res_slot, value: bodyv, line: ln, col: cl),
    ]), line: ln, col: cl)
    ids.push(m.make_if(cond: notyet, then_branch: take, line: ln, col: cl))
  }
  ids.push(m.var_ref(kind: 'local', index: res_slot, line: ln, col: cl))
  m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
}

fn emit_interp(m, node, f) {
  mut value = nil
  for part in node.nodes {
    let piece = cond {
      part.name == 'interp' => {
        let (ln, cl) = (part.line, part.column)
        call_pre(m, f, '__display', [emit_expr(m, part.nodes[0], f)], ln, cl)
      },
      _ => m.str_literal(s: unescape(part.token), line: part.line,
                         col: part.column),
    }
    value = cond {
      value == nil => piece,
      _ => m.binary(op: 'add', lhs: value, rhs: piece,
                    line: node.line, col: node.column),
    }
  }
  if value == nil {
    return m.str_literal(s: '', line: node.line, col: node.column)
  }
  value
}

fn emit_call(m, node, f) {
  let [id, args] = node.nodes
  let ln = node.line
  let cl = node.column
  if id.token == 'println' || id.token == 'print' {
    let v = emit_expr(m, args.nodes[0], f)
    let shown = cond {
      in_prelude => v,   # the prelude prints strings it already formatted
      _ => call_pre(m, f, '__display', [v], ln, cl),
    }
    let iname = cond { id.token == 'println' => 'print', _ => 'printraw' }
    return m.intrinsic(name: iname, args_list: make_list(m, [shown]),
                       line: ln, col: cl)
  }
  if !in_prelude && builtins.has(id.token) {
    mut arg_ids = []
    for a in args.nodes { arg_ids.push(emit_expr(m, a, f)) }
    let (pl, pc) = pos_args(m, id)
    let target = cond {
      id.token == 'range' => cond {
        args.nodes.size() == 1 => '__range1',
        _ => '__range2',
      },
      id.token == 'iota' => cond {
        args.nodes.size() == 1 => '__iota1',
        _ => '__iota2',
      },
      _ => {
        let (t, _) = builtins[id.token]
        t
      },
    }
    arg_ids.push(pl)
    arg_ids.push(pc)
    return call_pre(m, f, target, arg_ids, ln, cl)
  }
  if in_prelude {
    if intrinsics.has(id.token) {
      let (iname, _) = intrinsics[id.token]
      mut arg_ids = []
      for a in args.nodes { arg_ids.push(emit_expr(m, a, f)) }
      return m.intrinsic(name: iname, args_list: make_list(m, arg_ids),
                         line: ln, col: cl)
    }
    if id.token == '__error' {
      let kv = m.list_new()
      let keys = ['kind', 'message', 'line', 'col']
      mut i = 0
      while i < 4 {
        m.list_push(kv, m.str_literal(s: keys[i], line: ln, col: cl))
        m.list_push(kv, emit_expr(m, args.nodes[i], f))
        i = i + 1
      }
      return m.object_lit(kv_list: kv, line: ln, col: cl)
    }
  }
  let r = resolved[pkey(id)]
  if r.kind == 'class' {
    mut arg_ids = []
    for a in args.nodes { arg_ids.push(emit_expr(m, arg_val(a), f)) }
    let acc = access_from(f, (r.owner, r.slot))
    let clsv = m.var_ref(kind: acc.kind, index: acc.index,
                         line: id.line, col: id.column)
    let argsarr = m.array_lit(items_list: make_list(m, arg_ids),
                              line: ln, col: cl)
    let (pl, pc) = pos_args(m, id)
    return call_pre(m, f, '__construct', [clsv, argsarr, pl, pc], ln, cl)
  }
  if r.kind == 'fn' {
    if !needs_dispatch(r.funcs, args) {
      # the plain shape keeps the direct emission: one overload, exact
      # positional arity, no types/defaults/rest
      mut arg_ids = []
      for a in args.nodes { arg_ids.push(emit_expr(m, a, f)) }
      let g = r.funcs[0]
      let callee = m.make_closure(func: g, cmap: cmap_for(m, f, g),
                                  line: ln, col: cl)
      return m.call_value(callee: callee, args_list: make_list(m, arg_ids),
                          line: ln, col: cl)
    }
    return emit_dispatch(m, f, id.token, r.funcs, args.nodes, nil, node)
  }
  mut arg_ids = []
  for a in args.nodes { arg_ids.push(emit_expr(m, arg_val(a), f)) }
  let aa = access_from(f, (r.owner, r.slot))
  let cv = m.var_ref(kind: aa.kind, index: aa.index,
                     line: id.line, col: id.column)
  let callee = cond {
    in_prelude => cv,
    _ => {
      let (pl, pc) = pos_args(m, id)
      call_pre(m, f, '__callee_check', [cv, pl, pc], ln, cl)
    },
  }
  m.call_value(callee: callee, args_list: make_list(m, arg_ids),
               line: ln, col: cl)
}

# The multimethod / kwargs / defaults call: evaluate every argument once
# into its slot, then try each overload -- most-typed first -- with the
# static shape check done here at compile time and only the type tests
# left for run time. `recv_extra` (UFCS) prepends one already-emitted
# receiver value as the first positional argument.
fn emit_dispatch(m, f, name, fns, arg_nodes, recv_extra, at) {
  let ln = at.line
  let cl = at.column
  mut ids = []
  mut pos_slots = []     # positional argument slots, in order
  mut kw_slots = {}      # kwarg name -> slot
  if recv_extra != nil {
    pos_slots.push(recv_extra.slot)
    ids.push(m.assign(kind: 'local', index: recv_extra.slot,
                      value: recv_extra.value, line: ln, col: cl))
  }
  for a in arg_nodes {
    let slot = scratch_slot(f, scratch_of[pkey(arg_val(a))])
    ids.push(m.assign(kind: 'local', index: slot,
                      value: emit_expr(m, arg_val(a), f), line: ln, col: cl))
    cond {
      a.name == 'kwarg' => kw_slots[a.nodes[0].token] = slot,
      _ => pos_slots.push(slot),
    }
  }

  # overloads ordered most-typed-first (approximating "most specific")
  mut order = []
  for g in fns { order.push(g) }
  mut oi = 1
  while oi < order.size() {
    let g = order[oi]
    mut oj = oi - 1
    mut going = true
    while going {
      cond {
        oj < 0 => going = false,
        typed_count(order[oj]) < typed_count(g) => {
          order[oj + 1] = order[oj]
          oj = oj - 1
        },
        _ => going = false,
      }
    }
    order[oj + 1] = g
    oi = oi + 1
  }

  mut chain = []
  for g in order {
    let plan = overload_plan(g, pos_slots, kw_slots)
    if plan != nil { chain.push((g, plan)) }
  }
  let (pl, pc) = pos_args(m, at)
  # innermost alternative: no overload matched
  let kindv = m.str_literal(s: 'DispatchError', line: ln, col: cl)
  let msgv = m.str_literal(s: 'no matching method for `' + name + '`',
                           line: ln, col: cl)
  mut alt = call_pre(m, f, '__raise', [kindv, msgv, pl, pc], ln, cl)
  mut ci = chain.size() - 1
  while ci >= 0 {
    let (g, plan) = chain[ci]
    mut test = ir_bool(m, true, ln, cl)
    for tc in plan.checks {
      let (slot, tyname) = tc
      fn sref() { m.var_ref(kind: 'local', index: slot, line: ln, col: cl) }
      let tv = cond {
        tyname == '@tuple' => call_pre(m, f, '__is_tuple', [sref()], ln, cl),
        tyname.starts_with('@trait:') =>
          call_pre(m, f, '__inst_conf',
                   [sref(), m.str_literal(s: tyname.slice(7, tyname.size()).to_string(), line: ln, col: cl)],
                   ln, cl),
        tyname.starts_with('@cls:') =>
          call_pre(m, f, '__inst_class_is',
                   [sref(), m.str_literal(s: tyname.slice(5, tyname.size()).to_string(), line: ln, col: cl)],
                   ln, cl),
        _ => m.binary(op: 'eq', lhs: ir_typeof(m, sref(), ln, cl),
                      rhs: m.str_literal(s: tyname, line: ln, col: cl),
                      line: ln, col: cl),
      }
      test = ir_and(m, test, tv, ln, cl)
    }
    mut call_args = []
    for item in plan.args {
      let (akind, aval) = item
      call_args.push(cond {
        akind == 'slot' => m.var_ref(kind: 'local', index: aval, line: ln, col: cl),
        akind == 'missing' => m.str_literal(s: missing_marker, line: ln, col: cl),
        _ => {   # rest: pack the listed slots
          mut xs = []
          for sl in aval {
            xs.push(m.var_ref(kind: 'local', index: sl, line: ln, col: cl))
          }
          m.array_lit(items_list: make_list(m, xs), line: ln, col: cl)
        },
      })
    }
    let callv = m.call_value(callee: m.make_closure(func: g, cmap: cmap_for(m, f, g), line: ln, col: cl),
                             args_list: make_list(m, call_args), line: ln, col: cl)
    alt = m.make_if_else(cond: test, then_branch: callv, else_branch: alt,
                         line: ln, col: cl)
    ci = ci - 1
  }
  ids.push(alt)
  m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
}

fn typed_count(g) {
  mut n = 0
  for rec in funcs[g].pspecs {
    if rec.ty != nil { n = n + 1 }
  }
  n
}

# Can this overload take this call shape at all? nil when it cannot;
# otherwise {args: [per-param ('slot', i) / ('missing', 0) / ('rest', [..])],
# checks: [(slot, typeof-name)]}.
fn overload_plan(g, pos_slots, kw_slots) {
  let specs = funcs[g].pspecs
  mut args = []
  mut checks = []
  mut pi = 0
  mut used_kw = 0
  mut i = 0
  while i < specs.size() {
    let rec = specs[i]
    cond {
      rec.rest => {
        mut extra = []
        while pi < pos_slots.size() {
          extra.push(pos_slots[pi])
          pi = pi + 1
        }
        args.push(('rest', extra))
      },
      pi < pos_slots.size() => {
        args.push(('slot', pos_slots[pi]))
        if rec.ty != nil {
          checks.push((pos_slots[pi], ty_check_of(rec.ty)))
        }
        pi = pi + 1
      },
      kw_slots.has(rec.pname) => {
        args.push(('slot', kw_slots[rec.pname]))
        used_kw = used_kw + 1
        if rec.ty != nil {
          checks.push((kw_slots[rec.pname], ty_check_of(rec.ty)))
        }
      },
      rec.dflt != nil => args.push(('missing', 0)),
      _ => return nil,   # a required param nobody supplied
    }
    i = i + 1
  }
  if pi < pos_slots.size() { return nil }       # extra positionals
  if used_kw != kw_slots.size() { return nil }  # an unknown kwarg
  args_and_checks(args, checks)
}

fn args_and_checks(args, checks) { {args: args, checks: checks} }

# What a type annotation means at run time: a typeof name, the tuple mark,
# a trait conformance check, or an instance-of-class check (any name that
# is neither scalar nor a declared trait).
fn ty_check_of(ty) {
  cond {
    ty == 'Tuple' => '@tuple',
    type_map.has(ty) => type_map[ty],
    traits.has(ty) => '@trait:' + ty,
    _ => '@cls:' + ty,
  }
}


# A closure value; one that mentions `self` travels as a marker carrying
# its declared arity, so a method call or dot read can supply the receiver.
fn emit_closure_value(m, node, f) {
  let g = closure_of[pkey(node)]
  let c = m.make_closure(func: g, cmap: cmap_for(m, f, g),
                         line: node.line, col: node.column)
  cond {
    self_closure.has(g) =>
      call_pre(m, f, '__mk_selfc',
               [c, m.literal(v: funcs[g].params.size() - 1, line: node.line,
                             col: node.column)],
               node.line, node.column),
    _ => c,
  }
}

fn emit_postfix_step(m, f, value, step) {
  let (pl, pc) = pos_args(m, step)
  cond {
    step.name == 'pcall' => {
      mut arg_ids = []
      for a in step.nodes[0].nodes { arg_ids.push(emit_expr(m, a, f)) }
      let callee = cond {
        in_prelude => value,
        _ => call_pre(m, f, '__callee_check', [value, pl, pc],
                      step.line, step.column),
      }
      m.call_value(callee: callee, args_list: make_list(m, arg_ids),
                   line: step.line, col: step.column)
    },
    step.name == 'mcall' => {
      let name = step.nodes[0]
      cond {
        # inside the prelude a .name(...) is a protocol call: read the
        # property, call what it holds (used for user iterators)
        in_prelude => {
          mut arg_ids = []
          for a in step.nodes[1].nodes { arg_ids.push(emit_expr(m, a, f)) }
          m.call_value(
              callee: m.index(recv: value,
                              key: m.str_literal(s: name.token, line: name.line, col: name.column),
                              line: step.line, col: step.column),
              args_list: make_list(m, arg_ids), line: step.line, col: step.column)
        },
        # UFCS: a name outside the built-in method set that resolves to a
        # function in scope is a free call with the receiver first
        !builtin_methods.contains(name.token) && resolved.has(pkey(name)) => {
          let r = resolved[pkey(name)]
          emit_dispatch(m, f, name.token, r.funcs, step.nodes[1].nodes,
                        {slot: scratch_slot(f, scratch_of[pkey(name)]),
                         value: value},
                        step)
        },
        _ => {
          mut arg_ids = []
          for a in step.nodes[1].nodes { arg_ids.push(emit_expr(m, arg_val(a), f)) }
          let args = m.array_lit(items_list: make_list(m, arg_ids),
                                 line: step.line, col: step.column)
          call_pre(m, f, '__method',
                   [value,
                    m.str_literal(s: name.token, line: name.line, col: name.column),
                    args, pl, pc],
                   step.line, step.column)
        },
      }
    },
    step.name == 'prop' => cond {
      in_prelude => m.index(recv: value,
                            key: m.str_literal(s: step.nodes[0].token,
                                               line: step.line,
                                               col: step.column),
                            line: step.line, col: step.column),
      _ => call_pre(m, f, '__getprop',
                    [value,
                     m.str_literal(s: step.nodes[0].token, line: step.line,
                                   col: step.column),
                     pl, pc],
                    step.line, step.column),
    },
    _ => cond {   # subscript
      in_prelude => m.index(recv: value,
                            key: emit_expr(m, step.nodes[0], f),
                            line: step.line, col: step.column),
      _ => call_pre(m, f, '__getindex',
                    [value, emit_expr(m, step.nodes[0], f), pl, pc],
                    step.line, step.column),
    },
  }
}

fn emit_postfix(m, node, f) {
  let nodes = node.nodes
  mut value = emit_expr(m, nodes[0], f)
  mut i = 1
  while i < nodes.size() {
    value = emit_postfix_step(m, f, value, nodes[i])
    i = i + 1
  }
  value
}

fn emit_unary(m, node, f, which) {
  let e = emit_expr(m, node.nodes[0], f)
  let ln = node.line
  let cl = node.column
  if in_prelude {
    return cond {
      which == 'neg' => m.unary(op: 'neg', operand: e, line: ln, col: cl),
      which == 'bnot' => m.unary(op: 'bitnot', operand: e, line: ln, col: cl),
      # ! on a value the prelude already knows is a Bool
      _ => m.make_if_else(cond: e,
                          then_branch: m.bool_literal(v: false, line: ln, col: cl),
                          else_branch: m.bool_literal(v: true, line: ln, col: cl),
                          line: ln, col: cl),
    }
  }
  let (pl, pc) = pos_args(m, node)
  cond {
    which == 'neg' => call_pre(m, f, '__neg', [e, pl, pc], ln, cl),
    which == 'bnot' => call_pre(m, f, '__bnot', [e, pl, pc], ln, cl),
    _ => {
      let c = call_pre(m, f, '__truthy', [e, pl, pc], ln, cl)
      m.make_if_else(cond: c,
                     then_branch: m.bool_literal(v: false, line: ln, col: cl),
                     else_branch: m.bool_literal(v: true, line: ln, col: cl),
                     line: ln, col: cl)
    },
  }
}

fn emit_if(m, node, f, ln, cl) {
  let c0 = emit_expr(m, node.nodes[0], f)
  let c = cond {
    in_prelude => c0,
    _ => {
      let (pl, pc) = pos_args(m, node)
      call_pre(m, f, '__truthy', [c0, pl, pc], node.line, node.column)
    },
  }
  let t = emit_block(m, node.nodes[1], f)
  cond {
    node.nodes.size() == 3 => {
      let alt = node.nodes[2]
      let e = cond {
        alt.name == 'if' => emit_if(m, alt, f, alt.line, alt.column),
        _ => emit_block(m, alt, f),
      }
      m.make_if_else(cond: c, then_branch: t, else_branch: e,
                     line: node.line, col: node.column)
    },
    _ => m.make_if(cond: c, then_branch: t, line: node.line, col: node.column),
  }
}

fn emit_try(m, node, f) {
  let [body, id, handler] = node.nodes
  let b = emit_block(m, body, f)
  let r = resolved[pkey(id)]
  let info = block_info[pkey(handler)]
  mut ids = []
  # a captured caught variable arrives in its local slot and moves into the
  # cell every other reference resolves to (same shape as parameters)
  if cell_index[f].has(r.slot) {
    let src = m.var_ref(kind: 'local', index: r.slot,
                        line: id.line, col: id.column)
    ids.push(m.assign(kind: 'cell', index: cell_index[f][r.slot], value: src,
                      line: id.line, col: id.column))
  }
  for s in handler.nodes {
    let e = emit_stmt(m, s, f)
    if e != nil { ids.push(e) }
  }
  let hb = m.block(stmts_list: make_list(m, ids),
                   line: handler.line, col: handler.column)
  let wrapped = m.scope(first_local: info.base, end_local: nslots[f],
                        body: hb, line: handler.line, col: handler.column)
  m.make_try(caught_local: r.slot, body: b, handler: wrapped,
             line: node.line, col: node.column)
}

fn emit_expr(m, node, f) {
  match node {
    {name: 'number'} =>
      m.literal(v: parse_int_token(node.token), line: node.line,
                col: node.column),
    {name: 'float'} =>
      m.double_literal(v: to_float(node.token), line: node.line,
                       col: node.column),
    {name: 'str_sq'} =>
      m.str_literal(s: node.token, line: node.line, col: node.column),
    {name: 'str_dq'} => emit_interp(m, node, f),
    {name: 'true_l'} => m.bool_literal(v: true, line: node.line, col: node.column),
    {name: 'false_l'} => m.bool_literal(v: false, line: node.line, col: node.column),
    {name: 'nil_l'} => m.nil_literal(line: node.line, col: node.column),
    {name: 'ident', token} => {
      if !resolved.has(pkey(node)) {
        fail(node, "DEBUG unresolved ident '{token}' key={pkey(node)} f={f}")
      }
      let r = resolved[pkey(node)]
      cond {
        r.kind == 'fn' => m.make_closure(func: r.funcs[0],
                                         cmap: cmap_for(m, f, r.funcs[0]),
                                         line: node.line, col: node.column),
        _ => {
          let a = access_from(f, (r.owner, r.slot))
          let ref = m.var_ref(kind: a.kind, index: a.index, line: node.line,
                              col: node.column)
          cond {
            # a closure's `self` may be unbound: nil until a receiver arrives
            token == 'self' && self_slot.has(r.owner) &&
                self_slot[r.owner] == r.slot => {
              let (pl, pc) = pos_args(m, node)
              call_pre(m, f, '__self_use', [ref, pl, pc], node.line, node.column)
            },
            _ => ref,
          }
        },
      }
    },
    {name: 'call'} => emit_call(m, node, f),
    {name: 'array_lit'} => {
      mut ids = []
      for e in node.nodes { ids.push(emit_expr(m, e, f)) }
      m.array_lit(items_list: make_list(m, ids), line: node.line,
                  col: node.column)
    },
    {name: 'tuple'} => {
      mut ids = []
      for e in node.nodes { ids.push(emit_expr(m, e, f)) }
      let items = m.array_lit(items_list: make_list(m, ids),
                              line: node.line, col: node.column)
      call_pre(m, f, '__mk_tuple', [items], node.line, node.column)
    },
    {name: 'object_lit'} => {
      let kv = m.list_new()
      mut nsk = []
      mut muts = []
      let (pl, pc) = pos_args(m, node)
      fn key_node(kn) {
        cond {
          kn.name == 'ident' || kn.name == 'str_sq' =>
            m.str_literal(s: kn.token, line: kn.line, col: kn.column),
          # a non-String key is stored under its hash spelling; the
          # original value is recorded afterwards for keys() and display
          _ => call_pre(m, f, '__hkey', [emit_expr(m, kn, f), pl, pc],
                        kn.line, kn.column),
        }
      }
      for pair in node.nodes {
        let k = pair.nodes[0]
        m.list_push(kv, key_node(k))
        if k.name != 'ident' && k.name != 'str_sq' { nsk.push(k) }
        if pair.name == 'mut_pair' { muts.push(k) }
        m.list_push(kv, emit_expr(m, pair.nodes[1], f))
      }
      mut obj = m.object_lit(kv_list: kv, line: node.line, col: node.column)
      if nsk.size() > 0 {
        mut ids = []
        for k in nsk { ids.push(emit_expr(m, k, f)) }
        obj = call_pre(m, f, '__olit_nsk',
                       [obj, m.array_lit(items_list: make_list(m, ids),
                                         line: node.line, col: node.column)],
                       node.line, node.column)
      }
      if muts.size() > 0 {
        mut ids2 = []
        for k in muts { ids2.push(key_node(k)) }
        obj = call_pre(m, f, '__olit_mut',
                       [obj, m.array_lit(items_list: make_list(m, ids2),
                                         line: node.line, col: node.column)],
                       node.line, node.column)
      }
      obj
    },
    {name: 'set_lit'} => {
      let (pl, pc) = pos_args(m, node)
      mut ids = []
      for e in node.nodes { ids.push(emit_expr(m, e, f)) }
      call_pre(m, f, '__mk_set',
               [m.array_lit(items_list: make_list(m, ids),
                            line: node.line, col: node.column), pl, pc],
               node.line, node.column)
    },
    {name: 'lambda'} => emit_closure_value(m, node, f),
    {name: 'closure'} => emit_closure_value(m, node, f),
    {name: 'if'} => emit_if(m, node, f, node.line, node.column),
    {name: 'try'} => emit_try(m, node, f),
    {name: 'neg'} => emit_unary(m, node, f, 'neg'),
    {name: 'lnot'} => emit_unary(m, node, f, 'lnot'),
    {name: 'bnot'} => emit_unary(m, node, f, 'bnot'),
    {name: 'power', nodes} => {
      cond {
        nodes.size() == 3 => {
          let l = emit_expr(m, nodes[0], f)
          let r = emit_expr(m, nodes[2], f)
          emit_binop(m, f, '**', l, r, nodes[1])
        },
        _ => emit_expr(m, nodes[0], f),
      }
    },
    {name: 'postfix'} => emit_postfix(m, node, f),
    {name: 'ternary', nodes} => {
      let ln = node.line
      let cl = node.column
      let c0 = emit_expr(m, nodes[0], f)
      let (pl, pc) = pos_args(m, node)
      let c = call_pre(m, f, '__truthy', [c0, pl, pc], ln, cl)
      m.make_if_else(cond: c, then_branch: emit_expr(m, nodes[1], f),
                     else_branch: emit_expr(m, nodes[2], f), line: ln, col: cl)
    },
    {name: 'nilco'} => emit_nilco(m, node, f),
    {name: 'match'} => emit_match(m, node, f),
    {name: 'cond_e'} => emit_cond(m, node, f),
    {name: 'cmp'} => emit_cmp_chain(m, node, f),
    {name: 'lor'} => emit_shortcircuit(m, node, f),
    {name: 'land'} => emit_shortcircuit(m, node, f),
    {name: 'bor'} => emit_left_chain(m, node, f),
    {name: 'bxor'} => emit_left_chain(m, node, f),
    {name: 'band'} => emit_left_chain(m, node, f),
    {name: 'shift'} => emit_left_chain(m, node, f),
    {name: 'add'} => emit_left_chain(m, node, f),
    {name: 'mul'} => emit_left_chain(m, node, f),
    _ => fail(node, "cannot evaluate {node.name}"),
  }
}

# a = v, a op= v, recv[k] = v, recv.k = v (and their op= forms). The
# compound forms re-emit the read; the receiver chain is evaluated twice,
# which for the sample programs (variables and fields) is indistinguishable
# from once.
fn emit_assign(m, node, f) {
  let [lhs, op, value] = node.nodes
  let ln = node.line
  let cl = node.column
  if in_prelude && lhs.name == 'postfix' {
    # the prelude mutates arrays and objects directly; its stores are the
    # raw node (it is type-correct by construction)
    let steps = lhs.nodes
    let last = steps[steps.size() - 1]
    mut recv = emit_expr(m, steps[0], f)
    mut i = 1
    while i < steps.size() - 1 {
      recv = emit_postfix_step(m, f, recv, steps[i])
      i = i + 1
    }
    let key = cond {
      last.name == 'prop' => m.str_literal(s: last.nodes[0].token,
                                           line: last.line, col: last.column),
      _ => emit_expr(m, last.nodes[0], f),
    }
    return m.set_index(recv: recv, key: key,
                       value: emit_expr(m, value, f), line: ln, col: cl)
  }
  fn rhs_of(read_back) {
    let v = emit_expr(m, value, f)
    cond {
      op.token == '=' => v,
      read_back == nil => v,
      _ => {
        let (pl, pc) = pos_args(m, op)
        let name = cond {
          op.token == '+=' => '__add',
          op.token == '-=' => '__sub',
          op.token == '*=' => '__mul',
          op.token == '/=' => '__div',
          _ => '__mod',
        }
        call_pre(m, f, name, [read_back(), v, pl, pc], op.line, op.column)
      },
    }
  }
  cond {
    lhs.name == 'ident' => {
      let r = resolved[pkey(lhs)]
      let a = access_from(f, (r.owner, r.slot))
      let cur_var = fn () {
        m.var_ref(kind: a.kind, index: a.index, line: lhs.line, col: lhs.column)
      }
      m.assign(kind: a.kind, index: a.index, value: rhs_of(cur_var),
               line: ln, col: cl)
    },
    _ => {
      # postfix: everything up to the last step is the receiver expression
      let steps = lhs.nodes
      let last = steps[steps.size() - 1]
      mut recv = emit_expr(m, steps[0], f)
      mut i = 1
      while i < steps.size() - 1 {
        recv = emit_postfix_step(m, f, recv, steps[i])
        i = i + 1
      }
      let (pl, pc) = pos_args(m, last)
      let key = cond {
        last.name == 'prop' => m.str_literal(s: last.nodes[0].token,
                                             line: last.line, col: last.column),
        _ => emit_expr(m, last.nodes[0], f),
      }
      let is_prop = cond { last.name == 'prop' => 1, _ => 0 }
      cond {
        op.token == '=' => call_pre(m, f, '__setindex',
                                    [recv, key, rhs_of(nil),
                                     m.literal(v: is_prop, line: last.line, col: last.column),
                                     pl, pc],
                                    ln, cl),
        _ => {
          # receiver and key evaluate once, into scratch slots the read and
          # the write both reference
          let rslot = scratch_slot(f, scratch_of[pkey(op)])
          let kslot = scratch_slot(f, scratch_of[pkey(lhs)])
          let stores = [
            m.assign(kind: 'local', index: rslot, value: recv, line: ln, col: cl),
            m.assign(kind: 'local', index: kslot, value: key, line: ln, col: cl),
          ]
          fn rref() { m.var_ref(kind: 'local', index: rslot, line: ln, col: cl) }
          fn kref() { m.var_ref(kind: 'local', index: kslot, line: ln, col: cl) }
          let cur_read = fn () {
            call_pre(m, f, '__getindex_or_prop',
                     [rref(), kref(), m.literal(v: is_prop, line: last.line, col: last.column), pl, pc],
                     last.line, last.column)
          }
          let setc = call_pre(m, f, '__setindex',
                              [rref(), kref(), rhs_of(cur_read),
                               m.literal(v: is_prop, line: last.line, col: last.column),
                               pl, pc],
                              ln, cl)
          mut ids = stores
          ids.push(setc)
          m.block(stmts_list: make_list(m, ids), line: ln, col: cl)
        },
      }
    },
  }
}

# The class statement builds the class object -- name, ctor and method
# closures (self as their first parameter), the trait-conformance flags and
# any conforming trait's default methods -- and binds it to the class name.
fn emit_class(m, node, f) {
  let d = class_parts(node)
  let ln = node.line
  let cl = node.column
  let ck = "{f}/{d.id.token}"
  let ci = classes[ck]
  let kv = m.list_new()
  m.list_push(kv, m.str_literal(s: class_marker, line: ln, col: cl))
  m.list_push(kv, m.str_literal(s: 'class', line: ln, col: cl))
  m.list_push(kv, m.str_literal(s: 'name', line: ln, col: cl))
  m.list_push(kv, m.str_literal(s: d.id.token, line: ln, col: cl))
  m.list_push(kv, m.str_literal(s: 'new', line: ln, col: cl))
  m.list_push(kv, m.make_closure(func: ci.ctor, cmap: cmap_for(m, f, ci.ctor),
                                 line: ln, col: cl))
  let mkv = m.list_new()
  let akv = m.list_new()
  for name in ci.methods.keys() {
    let g = ci.methods[name]
    m.list_push(mkv, m.str_literal(s: name.slice(2, name.size()).to_string(),
                                   line: ln, col: cl))
    m.list_push(mkv, m.make_closure(func: g, cmap: cmap_for(m, f, g),
                                    line: ln, col: cl))
    m.list_push(akv, m.str_literal(s: name.slice(2, name.size()).to_string(),
                                   line: ln, col: cl))
    m.list_push(akv, m.literal(v: funcs[g].params.size() - 1, line: ln, col: cl))
  }
  # conforming traits contribute their defaults (never overriding) and a
  # flag the typed-dispatch check reads
  let confkv = m.list_new()
  for tname in traits.keys() {
    let tr = traits[tname]
    mut ok = true
    for req in tr.required {
      let (rname, rar) = req
      cond {
        ci.methods.has('m:' + rname) => {
          if ci.marities['m:' + rname] != rar { ok = false }
        },
        _ => ok = false,
      }
    }
    if ok {
      m.list_push(confkv, m.str_literal(s: tname, line: ln, col: cl))
      m.list_push(confkv, m.bool_literal(v: true, line: ln, col: cl))
      for dname in tr.defaults.keys() {
        if !ci.methods.has(dname) {
          let g = tr.defaults[dname]
          m.list_push(mkv, m.str_literal(s: dname.slice(2, dname.size()).to_string(),
                                         line: ln, col: cl))
          m.list_push(mkv, m.make_closure(func: g, cmap: cmap_for(m, f, g),
                                          line: ln, col: cl))
          m.list_push(akv, m.str_literal(s: dname.slice(2, dname.size()).to_string(),
                                         line: ln, col: cl))
          m.list_push(akv, m.literal(v: funcs[g].params.size() - 1, line: ln, col: cl))
        }
      }
    }
  }
  m.list_push(kv, m.str_literal(s: 'methods', line: ln, col: cl))
  m.list_push(kv, m.object_lit(kv_list: mkv, line: ln, col: cl))
  m.list_push(kv, m.str_literal(s: 'arities', line: ln, col: cl))
  m.list_push(kv, m.object_lit(kv_list: akv, line: ln, col: cl))
  m.list_push(kv, m.str_literal(s: 'conf', line: ln, col: cl))
  m.list_push(kv, m.object_lit(kv_list: confkv, line: ln, col: cl))
  let clsobj = m.object_lit(kv_list: kv, line: ln, col: cl)
  let r = resolved[pkey(d.id)]
  let a = access_from(f, (f, r.slot))
  m.assign(kind: a.kind, index: a.index, value: clsobj, line: ln, col: cl)
}

fn emit_stmt(m, node, f) {
  match node {
    {name: 'class_d'} => emit_class(m, node, f),
    {name: 'trait_d'} => nil,
    {name: 'fn_decl'} => {
      # plain declarations emit nothing here (bodies are per-function);
      # a decorated one is a value binding: deco1(deco2(closure))
      let d = fn_decl_parts(node)
      if d.decos.size() == 0 { return nil }
      let g = closure_of[pkey(node)]
      mut v = m.make_closure(func: g, cmap: cmap_for(m, f, g),
                             line: node.line, col: node.column)
      mut i = d.decos.size() - 1
      while i >= 0 {
        let dn = d.decos[i].nodes[0]
        let r = resolved[pkey(dn)]
        let callee = cond {
          r.kind == 'fn' => m.make_closure(func: r.funcs[0],
                                           cmap: cmap_for(m, f, r.funcs[0]),
                                           line: dn.line, col: dn.column),
          _ => {
            let a = access_from(f, (r.owner, r.slot))
            m.var_ref(kind: a.kind, index: a.index, line: dn.line, col: dn.column)
          },
        }
        v = m.call_value(callee: callee, args_list: make_list(m, [v]),
                         line: dn.line, col: dn.column)
        i = i - 1
      }
      let rb = resolved[pkey(d.id)]
      let ab = access_from(f, (f, rb.slot))
      m.assign(kind: ab.kind, index: ab.index, value: v,
               line: node.line, col: node.column)
    },
    {name: 'decl', nodes: [kw, pat, value]} => {
      let v = emit_expr(m, value, f)
      cond {
        pat.name == 'tup_pat' || pat.name == 'arr_pat' => {
          let tmp = scratch_slot(f, scratch_of[pkey(pat)])
          let n = pat.nodes.size()
          let (pl, pc) = pos_args(m, pat)
          let checked = call_pre(m, f, '__destr',
                                 [v, m.literal(v: n, line: pat.line, col: pat.column), pl, pc],
                                 pat.line, pat.column)
          mut ids = [m.assign(kind: 'local', index: tmp, value: checked,
                              line: pat.line, col: pat.column)]
          mut i = 0
          while i < n {
            let id = pat.nodes[i]
            let r = resolved[pkey(id)]
            let a = access_from(f, (f, r.slot))
            let item = m.index(recv: m.var_ref(kind: 'local', index: tmp,
                                               line: id.line, col: id.column),
                               key: m.literal(v: i, line: id.line, col: id.column),
                               line: id.line, col: id.column)
            ids.push(m.assign(kind: a.kind, index: a.index, value: item,
                              line: id.line, col: id.column))
            i = i + 1
          }
          m.block(stmts_list: make_list(m, ids), line: node.line,
                  col: node.column)
        },
        _ => {
          let r = resolved[pkey(pat)]
          let a = access_from(f, (f, r.slot))
          m.assign(kind: a.kind, index: a.index, value: v,
                   line: node.line, col: node.column)
        },
      }
    },
    {name: 'assign', nodes: [lhs, op, value]} => emit_assign(m, node, f),
    {name: 'for', nodes: [pat, iterable, body]} => {
      let ln = node.line
      let cl = node.column
      let itv = emit_expr(m, iterable, f)
      let (pl, pc) = pos_args(m, node)
      let itslot = scratch_slot(f, scratch_of[pkey(node)])
      let store_it = m.assign(kind: 'local', index: itslot,
                              value: call_pre(m, f, '__iter', [itv, pl, pc], ln, cl),
                              line: ln, col: cl)
      fn itref() { m.var_ref(kind: 'local', index: itslot, line: ln, col: cl) }
      let has = m.call_value(callee: m.index(recv: itref(),
                                             key: m.str_literal(s: 'has_next', line: ln, col: cl),
                                             line: ln, col: cl),
                             args_list: make_list(m, []), line: ln, col: cl)
      let nextv = m.call_value(callee: m.index(recv: itref(),
                                               key: m.str_literal(s: 'next', line: ln, col: cl),
                                               line: ln, col: cl),
                               args_list: make_list(m, []), line: ln, col: cl)
      let info = block_info[pkey(body)]
      mut pre = fresh_cells(m, f, info.base, info.high, body.line, body.column)
      cond {
        pat.name == 'tup_pat' => {
          # (k, v) in ...: next() yields a pair; unpack via its items. The
          # first slot temporarily holds the items array and is overwritten
          # last.
          let n = pat.nodes.size()
          let first = pat.nodes[0]
          let r0 = resolved[pkey(first)]
          let a0 = access_from(f, (f, r0.slot))
          pre.push(m.assign(kind: a0.kind, index: a0.index,
                            value: call_pre(m, f, '__destr',
                                            [nextv, m.literal(v: n, line: ln, col: cl), pl, pc],
                                            ln, cl),
                            line: first.line, col: first.column))
          mut i = n - 1
          while i >= 1 {
            let id = pat.nodes[i]
            let r = resolved[pkey(id)]
            let a = access_from(f, (f, r.slot))
            pre.push(m.assign(kind: a.kind, index: a.index,
                              value: m.index(recv: m.var_ref(kind: a0.kind, index: a0.index, line: id.line, col: id.column),
                                             key: m.literal(v: i, line: id.line, col: id.column),
                                             line: id.line, col: id.column),
                              line: id.line, col: id.column))
            i = i - 1
          }
          pre.push(m.assign(kind: a0.kind, index: a0.index,
                            value: m.index(recv: m.var_ref(kind: a0.kind, index: a0.index, line: first.line, col: first.column),
                                           key: m.literal(v: 0, line: first.line, col: first.column),
                                           line: first.line, col: first.column),
                            line: first.line, col: first.column))
        },
        _ => {
          let r = resolved[pkey(pat)]
          let a = access_from(f, (f, r.slot))
          pre.push(m.assign(kind: a.kind, index: a.index, value: nextv,
                            line: pat.line, col: pat.column))
        },
      }
      let b = emit_block_stmts(m, body, f, pre)
      let wrapped = m.scope(first_local: info.base, end_local: nslots[f],
                            body: b, line: body.line, col: body.column)
      let loop = m.make_while(cond: has, body: wrapped, line: ln, col: cl)
      # The iterator is disposed on every exit path -- drain, break, an
      # early return, or a throw -- via a defer over the whole statement
      # (culebra's optional-dispose contract; a no-op for iterators
      # without one).
      let closer = m.make_defer(value: call_pre(m, f, '__closer', [itref()], ln, cl),
                                line: ln, col: cl)
      m.scope(first_local: 0, end_local: 0,
              body: m.block(stmts_list: make_list(m, [store_it, closer, loop]),
                            line: ln, col: cl),
              line: ln, col: cl)
    },
    {name: 'while', nodes: [cnd, body]} => {
      let c0 = emit_expr(m, cnd, f)
      let c = cond {
        in_prelude => c0,
        _ => {
          let (pl, pc) = pos_args(m, cnd)
          call_pre(m, f, '__truthy', [c0, pl, pc], cnd.line, cnd.column)
        },
      }
      let b = emit_block(m, body, f)
      m.make_while(cond: c, body: b, line: node.line, col: node.column)
    },
    {name: 'return_s'} => {
      cond {
        # In a raw generator body a return finishes the iteration without
        # running the frame's defers (culebra's rule: only dispose runs
        # them), so it suspends at the end sentinel instead of returning.
        # The returned expression still evaluates; its value is discarded,
        # as culebra discards it.
        funcs[f].is_gen == true => {
          mut ids = []
          if node.nodes.size() == 1 {
            ids.push(emit_expr(m, node.nodes[0], f))
          }
          ids.push(m.make_yield(value: m.str_literal(s: gen_end_marker,
                                                     line: node.line,
                                                     col: node.column),
                                line: node.line, col: node.column))
          m.block(stmts_list: make_list(m, ids), line: node.line,
                  col: node.column)
        },
        _ => {
          let v = cond {
            node.nodes.size() == 1 => emit_expr(m, node.nodes[0], f),
            _ => m.nil_literal(line: node.line, col: node.column),
          }
          m.make_return(value: v, line: node.line, col: node.column)
        },
      }
    },
    {name: 'break_s'} => m.make_break(line: node.line, col: node.column),
    {name: 'continue_s'} => m.make_continue(line: node.line, col: node.column),
    {name: 'throw_s', nodes: [value]} => {
      let v = emit_expr(m, value, f)
      m.make_throw(value: v, line: node.line, col: node.column)
    },
    {name: 'yield_v', nodes: [e]} => {
      let v = emit_expr(m, e, f)
      m.make_yield(value: v, line: node.line, col: node.column)
    },
    {name: 'yield_f', nodes: [e]} => {
      # yield from: drive the delegated iterator inline (Yield must sit in
      # the generator function itself), disposing it however this region
      # exits -- an early close of the outer generator runs the defer.
      let ln = node.line
      let cl = node.column
      let itv = emit_expr(m, e, f)
      let (pl, pc) = pos_args(m, node)
      let itslot = scratch_slot(f, scratch_of[pkey(node)])
      let store = m.assign(kind: 'local', index: itslot,
                           value: call_pre(m, f, '__iter', [itv, pl, pc], ln, cl),
                           line: ln, col: cl)
      fn itref() { m.var_ref(kind: 'local', index: itslot, line: ln, col: cl) }
      let closer = m.make_defer(value: call_pre(m, f, '__closer', [itref()], ln, cl),
                                line: ln, col: cl)
      let has = m.call_value(callee: m.index(recv: itref(),
                                             key: m.str_literal(s: 'has_next', line: ln, col: cl),
                                             line: ln, col: cl),
                             args_list: make_list(m, []), line: ln, col: cl)
      let nextv = m.call_value(callee: m.index(recv: itref(),
                                               key: m.str_literal(s: 'next', line: ln, col: cl),
                                               line: ln, col: cl),
                               args_list: make_list(m, []), line: ln, col: cl)
      let body = m.block(stmts_list: make_list(m, [m.make_yield(value: nextv, line: ln, col: cl)]),
                         line: ln, col: cl)
      let loop = m.make_while(cond: has, body: body, line: ln, col: cl)
      m.scope(first_local: 0, end_local: 0,
              body: m.block(stmts_list: make_list(m, [store, closer, loop]),
                            line: ln, col: cl),
              line: ln, col: cl)
    },
    {name: 'defer_s'} => {
      let g = closure_of[pkey(node)]
      let c = m.make_closure(func: g, cmap: cmap_for(m, f, g),
                             line: node.line, col: node.column)
      m.make_defer(value: c, line: node.line, col: node.column)
    },
    {name: 'bare_block', nodes: [blk]} => emit_block(m, blk, f),
    _ => emit_expr(m, node, f),
  }
}

# Cell refreshes for a scope's own captured slots: entering the region is
# declaring anew, so closures from earlier entries keep the old box.
fn fresh_cells(m, f, base, high, ln, cl) {
  mut ids = []
  mut s = base
  while s < high {
    if cell_index[f].has(s) {
      ids.push(m.cell_fresh(cell: cell_index[f][s], line: ln, col: cl))
    }
    s = s + 1
  }
  ids
}

fn emit_block_stmts(m, blk, f, pre_ids) {
  mut ids = pre_ids
  for s in blk.nodes {
    let e = emit_stmt(m, s, f)
    if e != nil { ids.push(e) }
  }
  m.block(stmts_list: make_list(m, ids), line: blk.line, col: blk.column)
}

fn emit_block(m, blk, f) {
  let info = block_info[pkey(blk)]
  cond {
    info.wrap => {
      let pre = fresh_cells(m, f, info.base, info.high, blk.line, blk.column)
      let b = emit_block_stmts(m, blk, f, pre)
      m.scope(first_local: info.base, end_local: nslots[f],
              body: b, line: blk.line, col: blk.column)
    },
    _ => emit_block_stmts(m, blk, f, []),
  }
}

# --- Driver -------------------------------------------------------------------

fn emit_funcs(m) {
  # Records and add_func calls share indices by construction: the loop adds
  # in array order, so make_closure's func index means the same thing on
  # both sides.
  for f in range(funcs.size()) {
    let fi = funcs[f]
    in_prelude = fi.is_prelude
    mut ids = []
    # Prologue, in order: a defaulted parameter that received the missing
    # marker evaluates its default -- in this scope, so it can name earlier
    # params -- and only then is a captured parameter copied into its cell.
    let is_closure = closure_funcs.has(f)
    for pi in range(fi.pspecs.size()) {
      let rec = fi.pspecs[pi]
      fn pref() { m.var_ref(kind: 'local', index: pi, line: 1, col: 1) }
      # a closure is called through call_value with whatever count the
      # caller had (lenient arity), so a parameter nothing arrived for is
      # detected by the supplied count
      fn absent() {
        m.binary(op: 'le', lhs: m.intrinsic(name: 'argcount', args_list: m.list_new(),
                                             line: 1, col: 1),
                 rhs: m.literal(v: pi, line: 1, col: 1), line: 1, col: 1)
      }
      cond {
        rec.dflt != nil => {
          let is_marker = ir_and(
              m,
              m.binary(op: 'eq', lhs: ir_typeof(m, pref(), 1, 1),
                       rhs: m.str_literal(s: 'string', line: 1, col: 1),
                       line: 1, col: 1),
              m.binary(op: 'eq', lhs: pref(),
                       rhs: m.str_literal(s: missing_marker, line: 1, col: 1),
                       line: 1, col: 1),
              1, 1)
          let missing = cond {
            is_closure => m.make_if_else(cond: absent(),
                                         then_branch: ir_bool(m, true, 1, 1),
                                         else_branch: is_marker, line: 1, col: 1),
            _ => is_marker,
          }
          let fill = m.assign(kind: 'local', index: pi,
                              value: emit_expr(m, rec.dflt, f), line: 1, col: 1)
          ids.push(m.make_if(cond: missing, then_branch: fill, line: 1, col: 1))
        },
        is_closure && rec.pname != '__selfp' && !rec.rest => {
          let (dl, dc) = fn_pos[f]
          let raise = call_pre(m, f, '__raise',
                               [m.str_literal(s: 'ArityError', line: 1, col: 1),
                                m.str_literal(s: "missing required argument '" + rec.pname + "'",
                                              line: 1, col: 1),
                                m.literal(v: dl, line: 1, col: 1),
                                m.literal(v: dc, line: 1, col: 1)],
                               1, 1)
          ids.push(m.make_if(cond: absent(), then_branch: raise, line: 1, col: 1))
        },
        _ => nil,
      }
    }
    for p in range(fi.params.size()) {
      if cell_index[f].has(p) {
        let src = m.var_ref(kind: 'local', index: p, line: 1, col: 1)
        ids.push(m.assign(kind: 'cell', index: cell_index[f][p], value: src,
                          line: 1, col: 1))
      }
    }
    let rw = fi.gen_raw
    if rw != nil {
      # The wrapper's whole body: call the raw generator (its closure built
      # here, so the capture chain resolves in this frame) with every
      # parameter slot as-is -- defaults are already filled by the prologue
      # above -- and hand back the protocol object over the activation.
      mut cargs = []
      for pi2 in range(fi.params.size()) {
        cargs.push(m.var_ref(kind: 'local', index: pi2, line: 1, col: 1))
      }
      let rc = m.call_value(callee: m.make_closure(func: rw,
                                                   cmap: cmap_for(m, f, rw),
                                                   line: 1, col: 1),
                            args_list: make_list(m, cargs), line: 1, col: 1)
      ids.push(m.make_return(value: call_pre(m, f, '__gen_wrap', [rc], 1, 1),
                             line: 1, col: 1))
    }
    if self_closure.has(f) {
      let outer = self_closure[f]
      let outer_ref = cond {
        outer.kind == 'var' => {
          let a = access_from(f, (outer.owner, outer.slot))
          m.var_ref(kind: a.kind, index: a.index, line: 1, col: 1)
        },
        _ => m.nil_literal(line: 1, col: 1),
      }
      let picked = call_pre(m, f, '__self_pick',
                            [m.var_ref(kind: 'local', index: 0, line: 1, col: 1),
                             outer_ref],
                            1, 1)
      let a2 = access_from(f, (f, self_slot[f]))
      ids.push(m.assign(kind: a2.kind, index: a2.index, value: picked,
                        line: 1, col: 1))
    }
    for s in fi.stmts {
      let e = emit_stmt(m, s, f)
      if e != nil { ids.push(e) }
    }
    if fi.is_gen == true {
      # The end sentinel: falling off the body suspends here forever
      # instead of returning, keeping the frame's defers pending for a
      # dispose. It sits inside the body's own Scope, so nothing has run
      # its exit yet.
      ids.push(m.make_yield(value: m.str_literal(s: gen_end_marker,
                                                 line: 1, col: 1),
                            line: 1, col: 1))
    }
    mut body = m.block(stmts_list: make_list(m, ids), line: 1, col: 1)
    let info = block_info[fi.body_key]
    if info.wrap {
      body = m.scope(first_local: info.base, end_local: nslots[f],
                     body: body, line: 1, col: 1)
    }
    let func = m.add_func(name: fi.name,
                          num_locals: nslots[f] + nscratch[f],
                          num_captures: free[f].size(),
                          num_cells: cell_index[f].size(),
                          num_params: fi.params.size(), body: body)
    if fi.is_gen == true { m.set_generator(func: func) }
    m.set_lenient_arity(func: func)
    mut i = 0
    for v in free[f].values() {
      let (o, s) = v
      m.set_capture_name(func: func, index: i, name: "cap{i}")
      i = i + 1
    }
  }
  in_prelude = false
}

fn build(m, prelude_tree, root) {
  # main is funcs[0]; the prelude's functions follow; then the program's.
  let main = new_func(nil, 'main', root.nodes, "0:0")

  in_prelude = true
  for s in prelude_tree.nodes {
    let [id, prms, blk] = s.nodes
    prelude_named[id.token] =
        new_func(nil, id.token, blk.nodes, pkey(blk))
  }
  for s in prelude_tree.nodes {
    let g = prelude_named[s.nodes[0].token]
    walk_fn(g, s.nodes[1].nodes)
  }
  in_prelude = false

  enter_scope(main)
  let has_defer = scan_body_stmts(main, root.nodes, "0:0")
  leave_scope(main)
  block_info["0:0"] =
      {base: 0, high: nslots[main], wrap: nslots[main] > 0 || has_defer}

  solve()
  emit_funcs(m)
}

let want_ir = Sys.argv.contains('--ir')
let want_bc = Sys.argv.contains('--bc')
let cli = Sys.argv.filter(|a| a != '--ir' && a != '--bc')
if cli.empty() {
  println("usage: culebra mini_culebra.cul [--ir | --bc] PROGRAM.cul...")
  Sys.exit(1)
}

# The grammar and the prelude parse once; every program after the first
# reuses both, which is what makes a many-program batch cheap.
let prelude_tree = Peg.parse(grammar, prelude_src, path: '<prelude>')

mut had_err = false
for path in cli {
  if cli.size() > 1 {
    # Batch mode: a marker line before each program so a driver script can
    # split the concatenated output back into per-program chunks.
    println('-----8<----- ' + path.split('/')[-1])
  }
  # Positions repeat across programs, so nothing keyed by position -- and
  # no per-function table -- may survive from one compile into the next.
  funcs = []
  free = []
  calls = []
  capture_index = []
  cell_index = []
  nslots = []
  nscratch = []
  closure_of = {}
  resolved = {}
  scratch_of = {}
  block_info = {}
  prelude_named = {}
  self_closure = {}
  self_slot = {}
  closure_funcs = {}
  fn_pos = {}
  in_prelude = false
  scope_stack = []
  loop_depth = {}
  walk_cursor = {}
  classes = {}
  traits = {}
  try {
    let tree = Peg.parse(grammar, FS.read(path), path: path)
    let m = CodeGen.Module.new()
    build(m, prelude_tree, tree)
    m.verify()
    if want_ir {
      print(m.dump_ir())
    } else if want_bc {
      print(m.dump_bc())
    } else {
      m.run()
    }
  } catch e {
    match e {
      {kind: 'MiniError'} => println("{path}:{e.line}:{e.col}: {e.message}"),
      {kind: 'PegError'} => println(e.message),
      {kind: 'IrError'} => println("{path}:{e.line}:{e.col}: {e.message}"),
      _ => throw e,
    }
    had_err = true
  }
}
if had_err {
  Sys.exit(1)
}
