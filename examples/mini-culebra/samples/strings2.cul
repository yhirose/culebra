# strings2: the rest of the String method set
fn show(label, f) {
  try { println("{label}: {f()}") } catch e { println("{label}: !{e.kind}: {e.message}") }
}
show('count', || "aaaa".count("aa"))
show('count_empty', || "aaaa".count(""))
show('last_index_of', || "abcabc".last_index_of("bc"))
show('last_index_of_none', || "abc".last_index_of("z"))
show('index_of_start', || "abcabc".index_of("b", 2))
show('index_of_neg', || "abcabc".index_of("b", -2))
show('lines', || "a\nb\r\nc\rd\n".lines())
show('lines_empty', || "".lines())
show('replace', || "a-b-c".replace("-", "+"))
show('replace_empty_pat', || "abc".replace("", "-"))
show('replace_first', || "a-b-c".replace_first("-", "+"))
show('split_limit', || 'a.b.c'.split('.', 2))
show('split_limit0', || 'a.b.c'.split('.', 0))
show('split_limit_neg', || 'a.b.c'.split('.', -1))
show('split_empty_sep', || 'abc'.split(''))
show('split_trailing', || 'a,b,'.split(','))
show('rsplit', || 'a.b.c'.rsplit('.', 2))
show('rsplit_all', || 'a.b.c'.rsplit('.'))
show('split_once', || 'k=v=w'.split_once('='))
show('split_once_none', || 'kv'.split_once('='))
show('split_once_empty', || 'kv'.split_once(''))
show('rsplit_once', || 'k=v=w'.rsplit_once('='))
show('split_iter', || 'a.b.c'.split_iter('.').take(2).collect())
show('split_ws', || '  a  b '.split_whitespace())
show('split_ws_nbsp', || "a b　c".split_whitespace())
show('strip_prefix', || 'foobar'.strip_prefix('foo'))
show('strip_prefix_no', || 'foobar'.strip_prefix('bar'))
show('strip_suffix', || 'foobar'.strip_suffix('bar'))
show('trim_start', || "  a ".trim_start())
show('trim_start_chars', || "xxaxx".trim_start("x"))
show('trim_end_chars', || "xxaxx".trim_end("xa"))
show('trim_unicode', || "  a　".trim())
show('truncate', || "hello world".truncate(8))
show('truncate_fits', || "hi".truncate(8))
show('truncate_ell', || "hello world".truncate(6, "…"))
show('truncate_neg', || "hello".truncate(-1))
show('truncate_small', || "hello".truncate(2))
show('tr', || "hello".tr("el", "ip"))
show('tr_short', || "hello".tr("elo", "x"))
show('tr_del', || "hello".tr("l", ""))
show('tr_multi', || "０１２".tr("０１２３４５６７８９", "0123456789"))
show('bytes', || "aé".bytes().collect())
show('code_points', || "aé€".code_points().collect())
show('from_code_point', || String.from_code_point(233))
show('from_code_point_bad', || String.from_code_point(0xD800))
show('from_code_point_big', || String.from_code_point(0x110000))
show('from_code_points', || String.from_code_points([97, 233, 8364]))
show('from_code_points_bad', || String.from_code_points([97, 'x']))
show('from_bytes', || String.from_bytes([104, 105]))
show('from_bytes_bad', || String.from_bytes([300]))
show('from_bytes_roundtrip', || String.from_bytes("aé".bytes().collect()) == "aé")
show('is_digit', || "{'123'.is_digit()} {''.is_digit()} {'12a'.is_digit()} {'１２３'.is_digit()}")
show('is_alpha', || "{'abc'.is_alpha()} {'ab1'.is_alpha()} {''.is_alpha()} {'été'.is_alpha()}")
show('is_alnum', || "{'ab1'.is_alnum()} {'a b'.is_alnum()}")
let ideo = "　"
show('is_space', || "{'  '.is_space()} {' a'.is_space()} {''.is_space()} {ideo.is_space()}")
show('is_ascii', || "{'abc'.is_ascii()} {'é'.is_ascii()} {''.is_ascii()}")
show('reverse', || "abc".reverse())
show('reverse_utf8', || "aé€".reverse())
show('upper', || "hello".upper())
show('lower', || "HeLLo".lower())
show('upper_ss', || "ß".upper())
show('lower_utf8', || "ÉCOLE".lower())
show('capitalize', || "hELLO wORLD".capitalize())
show('title', || "hello wORLD o'neil".title())
show('eq_ignore_case', || "{'Straße'.eq_ignore_case('STRASSE')} {'abc'.eq_ignore_case('ABC')} {'a'.eq_ignore_case('b')}")
show('normalize_bad', || "a".normalize("NFX"))
show('to_string', || "abc".to_string())
show('view_disp', || "abc".view())
show('presence', || "{''.presence()} {'a'.presence()}")
show('s_iter_type', || type_of('a'.iter()))
show('code_points_invalid', || String.from_bytes([255, 97]).code_points().collect())
show('s_arity', || 'a'.count())
