# precedence and chains
println(1 + 2 * 3)
println((1 | 2) == 3)
println(1 | 2 & 3)
println(1 + 1 << 2)
println(2 ** 3 ** 2)
println(-2 ** 2)
println(1 < 2)
println(1 < 2 < 3)
println(3 > 2 > 1)
println(1 < 2 > 0)
println(5 / 2)
println(5.0 / 2)
println(-5 % 3)
println(5.5 % 2)
println(2 ** -1)
println(~7)
println(6 & 3 | 8 ^ 1)
println(1 << 63)
println('a' + 'b' < 'ac')
