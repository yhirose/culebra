# Exercises the wrapped Geo.Vec2 end to end: construction, methods,
# mutation, the by-value owning return, statics, deterministic drop +
# ClosedError. Run under interp / --jit / AOT — output must match.
let v = Geo.Vec2.new(3.0, 4.0)
inspect(v.len())
v.scale(2.0)  # bias omitted -> defaults to 0.0
inspect(v.show())
let u = v.unit()
inspect(u.len())
inspect(v.dot(u))       # handle argument: u borrows for the call
v.scale(1.0, bias: 1.0) # bias supplied
inspect(v.show())
inspect(Geo.Vec2.dims())
{
  let tmp = Geo.Vec2.new(1.0, 0.0)
  inspect(tmp.show())
}
v.drop()
inspect(try {
  v.len()
} catch e {
  e.kind + ': ' + e.message
})
inspect(u.show())
