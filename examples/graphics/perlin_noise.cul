# Perlin noise field — a culebra port of the classic OpenSiv3D
# PerlinNoise sample: two octave-noise lookups warp the coordinates fed
# into a third, and the result is shaded through a dusk palette. culebra
# has no built-in noise generator, so the noise itself is hand-rolled
# below: classic Ken Perlin gradient noise plus fBm octaves, matching
# Siv3D's PerlinNoise::normalizedOctave2D0_1.
#
# Run it:  culebra examples/graphics/perlin_noise.cul

w = 160
h = 120
cell = 8
cols = w / cell
rows = h / cell

# noise value 0..1 -> colour, interpolated through a few hand-picked stops
let PALETTE = [
  (18, 12, 46),
  (72, 24, 110),
  (168, 40, 120),
  (232, 92, 58),
  (250, 202, 68),
]

mut perm = iota(256)
Random.shuffle(perm)
perm = perm.iter().chain(perm).collect()

fn fade(t) {
  t * t * t * (t * (t * 6 - 15) + 10)
}

fn lerp(t, a, b) {
  a + t * (b - a)
}

fn grad(hash, x, y) {
  g = hash & 3
  u = g < 2 ? x : y
  v = g < 2 ? y : x
  (g & 1 == 0 ? u : -u) + (g & 2 == 0 ? v : -v)
}

fn perlin2d(x, y) {
  xi = Math.floor(x) & 255
  yi = Math.floor(y) & 255
  xf = x - Math.floor(x)
  yf = y - Math.floor(y)
  u = fade(xf)
  v = fade(yf)
  aa = perm[perm[xi] + yi]
  ab = perm[perm[xi] + yi + 1]
  ba = perm[perm[xi + 1] + yi]
  bb = perm[perm[xi + 1] + yi + 1]
  x1 = lerp(u, grad(aa, xf, yf), grad(ba, xf - 1.0, yf))
  x2 = lerp(u, grad(ab, xf, yf - 1.0), grad(bb, xf - 1.0, yf - 1.0))
  lerp(v, x1, x2)
}

# fBm summed over `octaves`, remapped from -1..1 to 0..1
fn octave2d_01(x, y, octaves) {
  mut total = 0.0
  mut freq = 1.0
  mut amp = 1.0
  mut max_amp = 0.0

  for _ in 0..octaves {
    total += perlin2d(x * freq, y * freq) * amp
    max_amp += amp
    amp *= 0.5
    freq *= 2.0
  }

  (total / max_amp + 1.0) / 2.0
}

fn palette_color(v) {
  n = PALETTE.size() - 1
  x = Math.min(1.0, Math.max(0.0, v)) * n
  i = Math.min(Math.floor(x), n - 1)
  frac = x - i
  let (r0, g0, b0) = PALETTE[i]
  let (r1, g1, b1) = PALETTE[i + 1]
  Canvas.rgba(
    Math.round(lerp(frac, r0, r1)),
    Math.round(lerp(frac, g0, g1)),
    Math.round(lerp(frac, b0, b1)),
  )
}

start = Time.monotonic()

Canvas.run(w, h, fn () {
  t = (Time.monotonic() - start) * 5

  for py in 0..rows {
    for px in 0..cols {
      qx = octave2d_01(px / 8.0 + t, py / 8.0 + t, 3)
      qy = octave2d_01(px / 8.0 + t * 1.2, py / 8.0 + t * 1.5, 3)
      v = octave2d_01(px / 10.0 + qx, py / 10.0 + qy, 3)

      Canvas.rect(
        px * cell,
        py * cell,
        cell,
        cell,
        palette_color(Math.min(1.0, v * 1.3)),
      )
    }
  }

  true
}, frames: 36000)
