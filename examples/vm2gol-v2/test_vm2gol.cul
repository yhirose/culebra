# Tests for the vm2gol-v2 port: a handful of parser unit tests mirroring
# vm2gol-v2's own test/test_vgparser.rb, an assembler unit test, and an
# end-to-end compile-and-run check mirroring test/test_gol.rb (which
# rewrites gol.vg.txt's `gen_limit` to stop after N generations, then
# compares the VRAM grid against a known-good Game of Life trace).

import parser_mod from './vgparser.cul'
import cg_mod from './vgcg.cul'
import asm_mod from './vgasm.cul'
import vm_mod from './vgvm.cul'

fn parse_stmts(body_src) {
  wrapped = 'func test()' + '{' + "\n" + body_src + "\n" + '}'
  tokens = parser_mod.tokenize(wrapped)
  tree = parser_mod.Parser(tokens).parse()
  tree[1][3]
}

@test
fn parses_empty_func() {
  tokens = parser_mod.tokenize('func f1(){}')
  tree = parser_mod.Parser(tokens).parse()
  assert_eq(tree, ['top_stmts', ['func', 'f1', [], []]])
}

@test
fn parses_func_with_args() {
  tokens = parser_mod.tokenize('func f1(a, b){}')
  tree = parser_mod.Parser(tokens).parse()
  assert_eq(tree, ['top_stmts', ['func', 'f1', ['a', 'b'], []]])
}

@test
fn parses_return_bare() {
  assert_eq(parse_stmts('return;'), [['return']])
}

@test
fn parses_return_value() {
  assert_eq(parse_stmts('return 1;'), [['return', 1]])
}

@test
fn parses_return_vram_ref() {
  assert_eq(parse_stmts('return vram[vi];'), [['return', 'vram[vi]']])
}

@test
fn parses_var_declare() {
  assert_eq(parse_stmts('var a;'), [['var', 'a']])
}

@test
fn parses_var_init_expr() {
  assert_eq(parse_stmts('var a = 1 + 2;'), [['var', 'a', ['+', 1, 2]]])
}

@test
fn parses_nested_parens() {
  assert_eq(
    parse_stmts('var a = ((b * c) + d) + e;'),
    [['var', 'a', ['+', ['+', ['*', 'b', 'c'], 'd'], 'e']]],
  )
}

@test
fn parses_set_vram_index() {
  assert_eq(parse_stmts('set vram[vi] = b;'), [['set', 'vram[vi]', 'b']])
}

@test
fn parses_call_set() {
  assert_eq(
    parse_stmts('call_set a = f2(a, 1);'),
    [['call_set', 'a', ['f2', 'a', 1]]],
  )
}

@test
fn parses_while() {
  assert_eq(
    parse_stmts('while (a != b) {}'),
    [['while', ['neq', 'a', 'b'], []]],
  )
}

@test
fn parses_case() {
  assert_eq(
    parse_stmts('case { (a == 1){ set a = 2; } }'),
    [['case', [['eq', 'a', 1], ['set', 'a', 2]]]],
  )
}

@test
fn assembler_resolves_labels_and_numbers() {
  asm = "  call main\n  exit\n\nlabel main\n  push 1\n  push -2\n  push [bp+2]\n  jump main\n"
  exe = asm_mod.assemble(asm)
  assert_eq(
    exe,
    [
      '["call",2]',
      '["exit"]',
      '["label","main"]',
      '["push",1]',
      '["push",-2]',
      '["push","[bp+2]"]',
      '["jump",2]',
    ],
  )
}

# `Sys.script` is nil under `culebra test`, so this can't resolve the path
# relative to this file's own location; instead try both directories the
# test is realistically invoked from (repo root, or this example's own dir).
fn gol_vg_txt_path() {
  cond {
    FS.exists('examples/vm2gol-v2/gol.vg.txt') => 'examples/vm2gol-v2/gol.vg.txt',
    FS.exists('gol.vg.txt') => 'gol.vg.txt',
    _ => throw "gol.vg.txt not found — run `culebra test` from the repo root or from examples/vm2gol-v2/",
  }
}

fn compile_and_run(num_generations) {
  src = FS.read(gol_vg_txt_path())
  replaced = src.replace(
    'var gen_limit = 0;',
    "var gen_limit = {num_generations + 1};",
  )

  tokens = parser_mod.tokenize(replaced)
  tree = parser_mod.Parser(tokens).parse()
  alines = cg_mod.codegen(tree)
  exe_lines = asm_mod.assemble(alines.join("\n"))

  insns = exe_lines.map(|line| JSON.parse(line))

  stack_size = 50
  mem = vm_mod.Memory(stack_size)
  vm = vm_mod.Vm(mem, stack_size)
  vm.load_program(insns)
  vm.start()

  mem.dump_vram_main()
}

@test
fn game_of_life_after_1_generation() {
  Sys.set_env('TEST', '1')
  assert_eq(
    compile_and_run(1),
    [".....", "@.@..", ".@@..", ".@...", "....."].join("\n"),
  )
}

@test
fn game_of_life_after_20_generations() {
  Sys.set_env('TEST', '1')
  assert_eq(
    compile_and_run(20),
    [".@...", "..@..", "@@@..", ".....", "....."].join("\n"),
  )
}
