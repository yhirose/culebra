# Tokenizer + recursive-descent parser for the toy "vg" language.
# Ported from vm2gol-v2's vgparser.rb. `culebra vgparser.cul <file>` prints
# the AST as pretty JSON, mirroring `ruby vgparser.rb <file>`.

class Token {
  new(type, value) {
    self.type = type
    self.value = value
  }
}

KEYWORDS = [
  "func",
  "set",
  "var",
  "call_set",
  "call",
  "return",
  "case",
  "while",
  "_cmt",
]
SYMBOL_CHARS = '(){}=;+*,'

fn is_digit(c) {
  '0123456789'.contains(c)
}

fn is_lower(c) {
  'abcdefghijklmnopqrstuvwxyz'.contains(c)
}

fn is_ident_start(c) {
  is_lower(c) || c == '_'
}

fn is_ident_char(c) {
  is_lower(c) || is_digit(c) || c == '_' || c == '[' || c == ']'
}

# Longest-match-with-boundary check: a keyword only matches when it is not
# immediately followed by another identifier character (so "call" does not
# match the start of "call_set").
fn match_keyword(src, pos, size) {
  mut found = nil
  for kw in KEYWORDS {
    if found == nil {
      end = pos + kw.size()
      if end <= size && src.slice(pos, end) == kw {
        if end == size {
          found = kw
        } else {
          next_c = src.slice(end, end + 1)
          found = kw unless is_lower(next_c) || next_c == '_'
        }
      }
    }
  }
  found
}

fn tokenize(src) {
  mut tokens = []
  mut pos = 0
  size = src.size()

  while pos < size {
    c = src.slice(pos, pos + 1)
    kw = match_keyword(src, pos, size)

    if c == ' ' || c == "\n" {
      pos += 1
    } else if c == '/' && pos + 1 < size && src.slice(pos + 1, pos + 2) == '/' {
      mut e = pos
      while e < size && src.slice(e, e + 1) != "\n" {
        e += 1
      }
      pos = e
    } else if c == '"' {
      mut e = pos + 1
      while e < size && src.slice(e, e + 1) != '"' {
        e += 1
      }
      tokens.push(Token('str', src.slice(pos + 1, e).to_string()))
      pos = e + 1
    } else if kw != nil {
      tokens.push(Token('kw', kw))
      pos += kw.size()
    } else if is_digit(c) || c == '-' && pos + 1 < size && is_digit(src.slice(pos + 1, pos + 2)) {
      mut e = pos + 1
      while e < size && is_digit(src.slice(e, e + 1)) {
        e += 1
      }
      tokens.push(Token('int', to_long(src.slice(pos, e))))
      pos = e
    } else if c == '=' && pos + 1 < size && src.slice(pos + 1, pos + 2) == '=' {
      tokens.push(Token('sym', '=='))
      pos += 2
    } else if c == '!' && pos + 1 < size && src.slice(pos + 1, pos + 2) == '=' {
      tokens.push(Token('sym', '!='))
      pos += 2
    } else if SYMBOL_CHARS.contains(c) {
      tokens.push(Token('sym', c.to_string()))
      pos += 1
    } else if is_ident_start(c) {
      mut e = pos + 1
      while e < size && is_ident_char(src.slice(e, e + 1)) {
        e += 1
      }
      tokens.push(Token('ident', src.slice(pos, e).to_string()))
      pos = e
    } else {
      end_pos = pos + 100 < size ? pos + 100 : size
      throw "must not happen: {JSON.stringify(src.slice(pos, end_pos))}"
    }
  }

  tokens
}

# --------------------------------

class ParseError {
  new(message = '') {
    self.message = message
  }
}

class Parser {
  new(tokens) {
    self.tokens = tokens
    self.pos = 0
  }

  rest_head() {
    limit = Math.min(self.pos + 8, self.tokens.size())
    self.tokens.slice(self.pos, limit).map(|t| "{t.type}<{t.value}>")
  }

  peek(offset = 0) {
    self.tokens[self.pos + offset]
  }

  dump_state(msg = nil) {
    IO.eprintln(JSON.stringify([msg, self.pos, self.rest_head()], 2))
  }

  assert_value(exp) {
    t = self.peek()
    if t.value != exp {
      throw ParseError("Assertion failed: expected({JSON.stringify(exp)}) actual(type={t.type} value={JSON.stringify(t.value)})")
    }
  }

  consume(str) {
    self.assert_value(str)
    self.pos += 1
  }

  is_end() {
    self.tokens.size() <= self.pos
  }

  # --------------------------------

  parse_arg() {
    t = self.peek()
    match t.type {
      'ident' | 'int' => {
        self.pos += 1
        t.value
      },
      _ => throw ParseError(),
    }
  }

  parse_args_first() {
    self.peek().value == ')' ? nil : self.parse_arg()
  }

  parse_args_rest() {
    if self.peek().value == ')' {
      nil
    } else {
      self.consume(',')
      self.parse_arg()
    }
  }

  parse_args() {
    first_arg = self.parse_args_first()
    if first_arg == nil {
      []
    } else {
      mut args = [first_arg]
      mut go = true
      while go {
        rest_arg = self.parse_args_rest()
        if rest_arg == nil {
          go = false
        } else {
          args.push(rest_arg)
        }
      }
      args
    }
  }

  parse_func() {
    self.consume('func')

    t = self.peek()
    self.pos += 1
    fn_name = t.value

    self.consume('(')
    args = self.parse_args()
    self.consume(')')

    self.consume('{')

    mut stmts = []
    while self.peek().value != '}' {
      t2 = self.peek()
      if t2.value == 'var' {
        stmts.push(self.parse_var())
      } else {
        stmts.push(self.parse_stmt())
      }
    }

    self.consume('}')

    ['func', fn_name, args, stmts]
  }

  parse_var_declare() {
    t = self.peek()
    self.pos += 1
    var_name = t.value

    self.consume(';')

    ['var', var_name]
  }

  parse_var_init() {
    t = self.peek()
    self.pos += 1
    var_name = t.value

    self.consume('=')

    expr = self.parse_expr()

    self.consume(';')

    ['var', var_name, expr]
  }

  parse_var() {
    self.consume('var')

    t = self.peek(1)

    match t.value {
      ';' => self.parse_var_declare(),
      '=' => self.parse_var_init(),
      _ => throw ParseError(),
    }
  }

  parse_expr_right(expr_l) {
    t = self.peek()

    match t.value {
      ';' | ')' => expr_l,
      '+' => {
        self.consume('+')
        ['+', expr_l, self.parse_expr()]
      },
      '*' => {
        self.consume('*')
        ['*', expr_l, self.parse_expr()]
      },
      '==' => {
        self.consume('==')
        ['eq', expr_l, self.parse_expr()]
      },
      '!=' => {
        self.consume('!=')
        ['neq', expr_l, self.parse_expr()]
      },
      _ => throw ParseError(),
    }
  }

  parse_expr() {
    t_left = self.peek()

    if t_left.value == '(' {
      self.consume('(')
      expr_l = self.parse_expr()
      self.consume(')')

      self.parse_expr_right(expr_l)
    } else if t_left.type == 'int' || t_left.type == 'ident' {
      self.pos += 1

      self.parse_expr_right(t_left.value)
    } else {
      throw ParseError()
    }
  }

  parse_set() {
    self.consume('set')

    t = self.peek()
    self.pos += 1
    var_name = t.value

    self.consume('=')

    expr = self.parse_expr()

    self.consume(';')

    ['set', var_name, expr]
  }

  parse_call() {
    self.consume('call')

    parts = self.parse_funcall()

    self.consume(';')

    ['call'] + parts
  }

  parse_funcall() {
    t = self.peek()
    self.pos += 1
    fn_name = t.value

    self.consume('(')
    args = self.parse_args()
    self.consume(')')

    [fn_name] + args
  }

  parse_call_set() {
    self.consume('call_set')

    t = self.peek()
    self.pos += 1
    var_name = t.value

    self.consume('=')

    expr = self.parse_funcall()

    self.consume(';')

    ['call_set', var_name, expr]
  }

  parse_return() {
    self.consume('return')

    t = self.peek()

    if t.value == ';' {
      self.consume(';')
      ['return']
    } else {
      expr = self.parse_expr()
      self.consume(';')
      ['return', expr]
    }
  }

  parse_when_clause() {
    t = self.peek()
    if t.value == '}' {
      nil
    } else {
      self.consume('(')
      expr = self.parse_expr()
      self.consume(')')

      self.consume('{')
      stmts = self.parse_stmts()
      self.consume('}')

      [expr] + stmts
    }
  }

  parse_case() {
    self.consume('case')

    self.consume('{')

    mut when_clauses = []
    mut go = true
    while go {
      when_clause = self.parse_when_clause()
      if when_clause == nil {
        go = false
      } else {
        when_clauses.push(when_clause)
      }
    }

    throw ParseError("At least one when clause is required") if when_clauses.empty()

    self.consume('}')

    ['case'] + when_clauses
  }

  parse_while() {
    self.consume('while')

    self.consume('(')
    expr = self.parse_expr()
    self.consume(')')

    self.consume('{')
    stmts = self.parse_stmts()
    self.consume('}')

    ['while', expr, stmts]
  }

  parse_vm_comment() {
    self.consume('_cmt')
    self.consume('(')

    t = self.peek()
    self.pos += 1
    comment = t.value

    self.consume(')')
    self.consume(';')

    ['_cmt', comment]
  }

  parse_stmt() {
    t = self.peek()

    match t.value {
      'set' => self.parse_set(),
      'call' => self.parse_call(),
      'call_set' => self.parse_call_set(),
      'return' => self.parse_return(),
      'while' => self.parse_while(),
      'case' => self.parse_case(),
      '_cmt' => self.parse_vm_comment(),
      _ => throw ParseError("Unexpected token (type={t.type} value={JSON.stringify(t.value)})"),
    }
  }

  parse_stmts() {
    mut stmts = []
    while self.peek().value != '}' {
      stmts.push(self.parse_stmt())
    }
    stmts
  }

  parse_top_stmt() {
    t = self.peek()
    match t.value {
      'func' => self.parse_func(),
      _ => throw ParseError("Unexpected token (type={t.type} value={JSON.stringify(t.value)})"),
    }
  }

  parse_top_stmts() {
    mut stmts = []
    while !self.is_end() {
      stmts.push(self.parse_top_stmt())
    }
    stmts
  }

  parse() {
    top_stmts = self.parse_top_stmts()
    ['top_stmts'] + top_stmts
  }
}

export {tokenize, Token, Parser, ParseError}

# --------------------------------

if Sys.script != nil && FS.basename(Sys.script) == 'vgparser.cul' {
  in_file = Sys.argv[0]
  tokens = tokenize(FS.read(in_file))

  parser = Parser(tokens)

  tree = try {
    parser.parse()
  } catch e {
    parser.dump_state(nil)
    throw e
  }

  println(JSON.stringify(tree, 2))
}
