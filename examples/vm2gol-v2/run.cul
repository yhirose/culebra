# Driver: parse -> codegen -> assemble -> run, mirroring vm2gol-v2's run.sh.
# `culebra run.cul [file.vg.txt]` (defaults to gol.vg.txt next to this
# script). Writes the same intermediate artifacts run.sh does
# (tmp/<name>.vgt.json / .vga.txt / .vge.txt) so each IR stage can be
# inspected on disk, then runs the VM (interactive unless `TEST` is set,
# same as `ruby vgvm.rb`).
#
# Top-level bindings below are named with a `main_` prefix on purpose: a
# bare top-level binding here can collide with a same-named bare local
# inside a function pulled in from an imported module (a cross-module
# scoping quirk, not something this example can fix).

import parser_mod from './vgparser.cul'
import cg_mod from './vgcg.cul'
import asm_mod from './vgasm.cul'
import vm_mod from './vgvm.cul'

fn strip_vg_suffix(basename) {
  basename.ends_with('.vg.txt')
    ? basename.slice(0, basename.size() - 7).to_string()
    : FS.stem(basename)
}

main_dir = FS.dirname(Sys.script)
main_src_file = Sys.argv.empty() ? FS.join(main_dir, 'gol.vg.txt') : Sys.argv[0]
main_bname = strip_vg_suffix(FS.basename(main_src_file))

main_tmp_dir = FS.join(main_dir, 'tmp')
FS.mkdir(main_tmp_dir) unless FS.exists(main_tmp_dir)

main_tree_file = FS.join(main_tmp_dir, "{main_bname}.vgt.json")
main_asm_file = FS.join(main_tmp_dir, "{main_bname}.vga.txt")
main_exe_file = FS.join(main_tmp_dir, "{main_bname}.vge.txt")

main_tokens = parser_mod.tokenize(FS.read(main_src_file))
main_tree = parser_mod.Parser(main_tokens).parse()
FS.write(main_tree_file, JSON.stringify(main_tree, 2) + "\n")

main_asm_lines = cg_mod.codegen(main_tree)
FS.write(main_asm_file, main_asm_lines.join("\n") + "\n")

main_exe_lines = asm_mod.assemble(main_asm_lines.join("\n"))
FS.write(main_exe_file, main_exe_lines.join("\n") + "\n")

main_insns = main_exe_lines.map(|line| JSON.parse(line))

main_stack_size = 50
main_mem = vm_mod.Memory(main_stack_size)
main_vm = vm_mod.Vm(main_mem, main_stack_size)
main_vm.load_program(main_insns)

main_vm.start()
main_vm.dump_v2()
IO.eprintln('exit')
