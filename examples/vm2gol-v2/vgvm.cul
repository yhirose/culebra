# Stack-machine VM: executes the JSON-lines produced by vgasm.cul.
# Ported from vm2gol-v2's vgvm.rb. `culebra vgvm.cul <file.vge.txt>` runs it,
# mirroring `ruby vgvm.rb <file.vge.txt>` (interactive step dump unless the
# `TEST` env var is set).

import common from './common.cul'

FLAG_TRUE = 1
FLAG_FALSE = 0

TERM_RESET = "\x1b[m"
TERM_RED = "\x1b[0;31m"
TERM_BLUE = "\x1b[0;34m"

BP_PLUS_RE = Regex.compile('^\[bp\+(\d+)\]$')
BP_MINUS_RE = Regex.compile('^\[bp-(\d+)\]$')

fn bp_plus_offset(s) {
  if type_of(s) != 'String' {
    nil
  } else {
    m = BP_PLUS_RE.match(s)
    m == nil ? nil : to_long(m[1])
  }
}

fn bp_minus_offset(s) {
  if type_of(s) != 'String' {
    nil
  } else {
    m = BP_MINUS_RE.match(s)
    m == nil ? nil : to_long(m[1])
  }
}

fn zeros(n) {
  iota(n).map(|_| 0)
}

fn pad2(n) {
  s = to_string(n)
  s.size() < 2 ? "0{s}" : s
}

class Memory {
  new(stack_size) {
    self.main = []
    self.stack = zeros(stack_size)
    self.vram = zeros(50)
  }

  dump_main(pc) {
    mut lines = []
    mut i = 0
    for insn in self.main {
      if pc - 10 <= i && i <= pc + 10 {
        head = i == pc ? "pc =>" : "     "
        operator = insn[0]
        color = match operator {
          'exit' | 'call' | 'ret' | 'jump' | 'jump_eq' => TERM_RED,
          '_cmt' => TERM_BLUE,
          _ => '',
        }
        indent = operator == 'label' ? '' : '  '
        lines.push("{head} {pad2(i)} {color}{indent}{JSON.stringify(insn)}{TERM_RESET}")
      }
      i += 1
    }
    lines.join("\n")
  }

  dump_stack(sp, bp) {
    mut lines = []
    mut i = 0
    for x in self.stack {
      if i >= sp - 8 && i <= sp + 8 {
        head = cond {
          i == sp && sp == bp => "sp bp => ",
          i == sp => "sp    => ",
          i == bp => "   bp => ",
          _ => "         ",
        }
        lines.push("{head}{i} {JSON.stringify(x)}")
      }
      i += 1
    }
    lines.join("\n")
  }

  format_cols(cols) {
    cols.map(|col| col == 1 ? '@' : '.').join('')
  }

  dump_vram() {
    rows = self.vram.iter().chunks(5).collect()
    main_rows = rows.slice(0, 5)
    buf_rows = rows.slice(5, 10)
    main_rows
      .iter()
      .zip(buf_rows)
      .map(|pair| "{self.format_cols(pair.first)} {self.format_cols(pair.second)}")
      .join("\n")
  }

  # Not in the original vgvm.rb: added (as a Memory monkey-patch there) by
  # vm2gol-v2's own test/test_gol.rb to check just the visible grid.
  dump_vram_main() {
    rows = self.vram.iter().chunks(5).collect()
    rows.slice(0, 5).map(|row| self.format_cols(row)).join("\n")
  }
}

class Vm {
  new(mem, stack_size) {
    self.pc = 0
    self.reg_a = 0
    self.reg_b = 0
    self.zf = FLAG_FALSE
    self.mem = mem
    self.sp = stack_size - 1
    self.bp = stack_size - 1
    self.step = 0
  }

  is_test() {
    Sys.env('TEST', nil) != nil
  }

  is_step_mode() {
    Sys.env('STEP', nil) != nil
  }

  set_sp(addr) {
    throw "Stack overflow" if addr < 0
    self.sp = addr
  }

  load_program_file(path) {
    insns = FS
      .read(path)
      .lines()
      .filter(|line| !line.trim().empty())
      .map(|line| JSON.parse(line.to_string()))
    self.load_program(insns)
  }

  load_program(words) {
    self.mem.main = words
  }

  execute() {
    insn = self.mem.main[self.pc]
    op = insn[0]

    match op {
      'exit' => true,
      'label' => {
        self.pc += 1
        false
      },
      '_cmt' => {
        self.pc += 1
        false
      },
      'jump' => {
        self.jump()
        false
      },
      'jump_eq' => {
        self.jump_eq()
        false
      },
      'call' => {
        self.call()
        false
      },
      'ret' => {
        self.ret()
        false
      },
      'set_reg_a' => {
        self.set_reg_a()
        self.pc += 1
        false
      },
      'set_reg_b' => {
        self.set_reg_b()
        self.pc += 1
        false
      },
      'cp' => {
        self.copy()
        self.pc += 1
        false
      },
      'add_ab' => {
        self.add_ab()
        self.pc += 1
        false
      },
      'mult_ab' => {
        self.mult_ab()
        self.pc += 1
        false
      },
      'add_sp' => {
        self.add_sp()
        self.pc += 1
        false
      },
      'sub_sp' => {
        self.sub_sp()
        self.pc += 1
        false
      },
      'compare' => {
        self.compare()
        self.pc += 1
        false
      },
      'push' => {
        self.push()
        self.pc += 1
        false
      },
      'pop' => {
        self.pop()
        self.pc += 1
        false
      },
      'set_vram' => {
        self.set_vram()
        self.pc += 1
        false
      },
      'get_vram' => {
        self.get_vram()
        self.pc += 1
        false
      },
      _ => throw "Unknown operator ({op})",
    }
  }

  start() {
    if !self.is_test() {
      self.dump_v2()
      println("Press enter key to start")
      IO.input()
    }

    mut done = false
    while !done {
      self.step += 1

      do_exit = self.execute()

      if do_exit {
        done = true
      } else if !self.is_test() {
        if self.is_step_mode() {
          self.dump_v2()
          IO.input()
        } else if self.step % 10 == 0 {
          self.dump_v2()
        }
      }
    }
  }

  dump_reg() {
    "reg_a({JSON.stringify(self.reg_a)}) reg_b({JSON.stringify(self.reg_b)})"
  }

  dump_v2() {
    println("================================")
    println("{self.step}: {self.dump_reg()} zf({self.zf})")
    println("---- memory (main) ----")
    println(self.mem.dump_main(self.pc))
    println("---- memory (stack) ----")
    println(self.mem.dump_stack(self.sp, self.bp))
    println("---- memory (vram) ----")
    println(self.mem.dump_vram())
  }

  add_ab() {
    self.reg_a = self.reg_a + self.reg_b
  }

  mult_ab() {
    self.reg_a = self.reg_a * self.reg_b
  }

  # Shared by set_reg_a/set_reg_b: an immediate, or a stack slot relative to bp.
  resolve_reg_operand(val) {
    minus = bp_minus_offset(val)
    plus = bp_plus_offset(val)
    cond {
      type_of(val) == 'Long' => val,
      minus != nil => self.mem.stack[self.bp - minus],
      plus != nil => self.mem.stack[self.bp + plus],
      _ => throw common.not_yet_impl("val", val),
    }
  }

  set_reg_a() {
    self.reg_a = self.resolve_reg_operand(self.mem.main[self.pc][1])
  }

  set_reg_b() {
    self.reg_b = self.resolve_reg_operand(self.mem.main[self.pc][1])
  }

  copy() {
    arg1 = self.mem.main[self.pc][1]
    arg2 = self.mem.main[self.pc][2]

    plus1 = bp_plus_offset(arg1)
    minus1 = bp_minus_offset(arg1)
    src_val = cond {
      type_of(arg1) == 'Long' => arg1,
      arg1 == 'reg_a' => self.reg_a,
      arg1 == 'sp' => self.sp,
      arg1 == 'bp' => self.bp,
      plus1 != nil => self.mem.stack[self.bp + plus1],
      minus1 != nil => self.mem.stack[self.bp - minus1],
      _ => throw common.not_yet_impl("copy src", arg1),
    }

    minus2 = bp_minus_offset(arg2)
    cond {
      arg2 == 'reg_a' => {
        self.reg_a = src_val
      },
      arg2 == 'reg_b' => {
        self.reg_b = src_val
      },
      arg2 == 'bp' => {
        self.bp = src_val
      },
      arg2 == 'sp' => {
        self.set_sp(src_val)
      },
      minus2 != nil => {
        self.mem.stack[self.bp - minus2] = src_val
      },
      _ => throw common.not_yet_impl("copy dest", arg2),
    }
  }

  add_sp() {
    self.set_sp(self.sp + self.mem.main[self.pc][1])
  }

  sub_sp() {
    self.set_sp(self.sp - self.mem.main[self.pc][1])
  }

  compare() {
    self.zf = self.reg_a == self.reg_b ? FLAG_TRUE : FLAG_FALSE
  }

  jump() {
    self.pc = self.mem.main[self.pc][1]
  }

  jump_eq() {
    self.pc = self.zf == FLAG_TRUE ? self.mem.main[self.pc][1] : self.pc + 1
  }

  call() {
    self.set_sp(self.sp - 1)
    self.mem.stack[self.sp] = self.pc + 1
    next_addr = self.mem.main[self.pc][1]
    self.pc = next_addr
  }

  ret() {
    ret_addr = self.mem.stack[self.sp]
    self.pc = ret_addr
    self.set_sp(self.sp + 1)
  }

  push() {
    arg = self.mem.main[self.pc][1]

    minus = bp_minus_offset(arg)
    plus = bp_plus_offset(arg)
    val_to_push = cond {
      type_of(arg) == 'Long' => arg,
      arg == 'reg_a' => self.reg_a,
      arg == 'bp' => self.bp,
      minus != nil => self.mem.stack[self.bp - minus],
      plus != nil => self.mem.stack[self.bp + plus],
      _ => throw common.not_yet_impl("push", arg),
    }

    self.set_sp(self.sp - 1)
    self.mem.stack[self.sp] = val_to_push
  }

  pop() {
    arg = self.mem.main[self.pc][1]
    val = self.mem.stack[self.sp]

    match arg {
      'reg_a' => {
        self.reg_a = val
      },
      'reg_b' => {
        self.reg_b = val
      },
      'bp' => {
        self.bp = val
      },
      _ => throw common.not_yet_impl("pop", arg),
    }

    self.set_sp(self.sp + 1)
  }

  set_vram() {
    arg1 = self.mem.main[self.pc][1]
    arg2 = self.mem.main[self.pc][2]

    plus2 = bp_plus_offset(arg2)
    minus2 = bp_minus_offset(arg2)
    src_val = cond {
      type_of(arg2) == 'Long' => arg2,
      plus2 != nil => self.mem.stack[self.bp + plus2],
      minus2 != nil => self.mem.stack[self.bp - minus2],
      _ => throw common.not_yet_impl("set_vram", arg2),
    }

    minus1 = bp_minus_offset(arg1)
    cond {
      type_of(arg1) == 'Long' => {
        self.mem.vram[arg1] = src_val
      },
      minus1 != nil => {
        self.mem.vram[self.mem.stack[self.bp - minus1]] = src_val
      },
      _ => throw common.not_yet_impl("set_vram", arg1),
    }
  }

  get_vram() {
    arg1 = self.mem.main[self.pc][1]
    arg2 = self.mem.main[self.pc][2]

    minus = bp_minus_offset(arg1)
    vram_addr = cond {
      type_of(arg1) == 'Long' => arg1,
      minus != nil => self.mem.stack[self.bp - minus],
      _ => throw common.not_yet_impl("arg1", arg1),
    }

    val = self.mem.vram[vram_addr]

    if arg2 == 'reg_a' {
      self.reg_a = val
    } else {
      throw common.not_yet_impl("arg2", arg2)
    }
  }
}

export {Memory, Vm}

# --------------------------------

if Sys.script != nil && FS.basename(Sys.script) == 'vgvm.cul' {
  exe_file = Sys.argv[0]

  stack_size = 50
  mem = Memory(stack_size)
  vm = Vm(mem, stack_size)
  vm.load_program_file(exe_file)

  vm.start()
  vm.dump_v2()
  IO.eprintln('exit')
}
