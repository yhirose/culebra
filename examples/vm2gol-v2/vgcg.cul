# Code generator: AST (vgt.json) -> stack-machine assembly text (vga.txt).
# Ported from vm2gol-v2's vgcg.rb. `culebra vgcg.cul <file.vgt.json>` prints
# assembly, mirroring `ruby vgcg.rb <file.vgt.json>`.

import common from './common.cul'

# Ruby's Array#inspect (used in a debug comment below): elements joined by
# ", " rather than JSON.stringify's compact ",".
fn ruby_inspect(v) {
  match type_of(v) {
    'String' => "\"{v}\"",
    'Array' => {
      elements = v.map(|x| ruby_inspect(x)).join(", ")
      "[{elements}]"
    },
    _ => to_string(v),
  }
}

mut label_id_counter = 0

fn next_label_id() {
  label_id_counter += 1
  label_id_counter
}

fn to_fn_arg_addr(fn_arg_names, fn_arg_name) {
  index = fn_arg_names.index_of(fn_arg_name)
  "[bp+{index + 2}]"
}

fn to_lvar_addr(lvar_names, lvar_name) {
  index = lvar_names.index_of(lvar_name)
  "[bp-{index + 1}]"
}

fn codegen_var(fn_arg_names, lvar_names, stmt_rest) {
  mut alines = ["  sub_sp 1"]

  if stmt_rest.size() == 2 {
    alines.extend(codegen_set(fn_arg_names, lvar_names, stmt_rest))
  }

  alines
}

fn codegen_case(fn_arg_names, lvar_names, when_blocks) {
  mut alines = []
  label_id = next_label_id()

  label_end = "end_case_{label_id}"
  label_when_head = "when_{label_id}"
  label_end_when_head = "end_when_{label_id}"

  alines.push("")
  alines.push("  # -->> case_{label_id}")

  mut when_idx = -1

  for when_block in when_blocks {
    when_idx += 1
    let [cond, ...rest] = when_block
    cond_head = cond[0]

    alines.push("  # when_{label_id}_{when_idx}: {ruby_inspect(cond)}")

    if cond_head == 'eq' {
      alines.push("  # -->> expr")
      alines.extend(codegen_expr(fn_arg_names, lvar_names, cond))
      alines.push("  # <<-- expr")

      alines.push("  set_reg_b 1")

      alines.push("  compare")
      alines.push("  jump_eq {label_when_head}_{when_idx}")
      alines.push("  jump {label_end_when_head}_{when_idx}")

      alines.push("label {label_when_head}_{when_idx}")

      alines.extend(codegen_stmts(fn_arg_names, lvar_names, rest))

      alines.push("  jump {label_end}")

      alines.push("label {label_end_when_head}_{when_idx}")
    } else {
      throw common.not_yet_impl("cond_head", cond_head)
    }
  }

  alines.push("label {label_end}")
  alines.push("  # <<-- case_{label_id}")
  alines.push("")

  alines
}

fn codegen_while(fn_arg_names, lvar_names, rest) {
  let [cond_expr, body] = rest

  label_id = next_label_id()

  label_begin = "while_{label_id}"
  label_end = "end_while_{label_id}"
  label_true = "true_{label_id}"

  mut alines = [""]

  alines.push("label {label_begin}")

  alines.extend(codegen_expr(fn_arg_names, lvar_names, cond_expr))
  alines.push("  set_reg_b 1")
  alines.push("  compare")

  alines.push("  jump_eq {label_true}")

  alines.push("  jump {label_end}")

  alines.push("label {label_true}")
  alines.extend(codegen_stmts(fn_arg_names, lvar_names, body))

  alines.push("  jump {label_begin}")

  alines.push("label {label_end}")
  alines.push("")

  alines
}

fn codegen_expr_push(fn_arg_names, lvar_names, val) {
  mut alines = []

  push_arg = cond {
    type_of(val) == 'Long' => to_string(val),
    fn_arg_names.contains(val) => to_fn_arg_addr(fn_arg_names, val),
    lvar_names.contains(val) => to_lvar_addr(lvar_names, val),
    type_of(val) == 'Array' => {
      alines.extend(codegen_expr(fn_arg_names, lvar_names, val))
      "reg_a"
    },
    _ => throw common.not_yet_impl("val", val),
  }

  alines.push("  push {push_arg}")

  alines
}

fn codegen_expr_add() {
  ["  pop reg_b", "  pop reg_a", "  add_ab"]
}

fn codegen_expr_mult() {
  ["  pop reg_b", "  pop reg_a", "  mult_ab"]
}

fn codegen_expr_eq() {
  label_id = next_label_id()

  label_end = "end_eq_{label_id}"
  label_then = "then_{label_id}"

  [
    "  pop reg_b",
    "  pop reg_a",
    "  compare",
    "  jump_eq {label_then}",
    "  set_reg_a 0",
    "  jump {label_end}",
    "label {label_then}",
    "  set_reg_a 1",
    "label {label_end}",
  ]
}

fn codegen_expr_neq() {
  label_id = next_label_id()

  label_end = "end_neq_{label_id}"
  label_then = "then_{label_id}"

  [
    "  pop reg_b",
    "  pop reg_a",
    "  compare",
    "  jump_eq {label_then}",
    "  set_reg_a 1",
    "  jump {label_end}",
    "label {label_then}",
    "  set_reg_a 0",
    "label {label_end}",
  ]
}

fn codegen_expr(fn_arg_names, lvar_names, expr) {
  let [operator, ...args] = expr
  arg_l = args[0]
  arg_r = args[1]

  mut alines = []
  alines.extend(codegen_expr_push(fn_arg_names, lvar_names, arg_l))
  alines.extend(codegen_expr_push(fn_arg_names, lvar_names, arg_r))

  match operator {
    '+' => alines.extend(codegen_expr_add()),
    '*' => alines.extend(codegen_expr_mult()),
    'eq' => alines.extend(codegen_expr_eq()),
    'neq' => alines.extend(codegen_expr_neq()),
    _ => throw common.not_yet_impl("operator", operator),
  }

  alines
}

fn codegen_call_push_fn_arg(fn_arg_names, lvar_names, fn_arg) {
  push_arg = cond {
    type_of(fn_arg) == 'Long' => to_string(fn_arg),
    fn_arg_names.contains(fn_arg) => to_fn_arg_addr(fn_arg_names, fn_arg),
    lvar_names.contains(fn_arg) => to_lvar_addr(lvar_names, fn_arg),
    _ => throw common.not_yet_impl(fn_arg),
  }

  ["  push {push_arg}"]
}

# Shared by codegen_call/codegen_call_set: push args (reversed), emit the
# call, and pop them back off the stack.
fn codegen_call_common(fn_arg_names, lvar_names, fn_name, fn_args, cmt_prefix) {
  mut fn_args_rev = fn_args.slice(0, fn_args.size())
  fn_args_rev.reverse()

  fn_args_rev.flat_map(|fn_arg| codegen_call_push_fn_arg(
    fn_arg_names,
    lvar_names,
    fn_arg,
  )) +
    codegen_vm_comment("{cmt_prefix}  {fn_name}") +
    ["  call {fn_name}", "  add_sp {fn_args.size()}"]
}

fn codegen_call(fn_arg_names, lvar_names, stmt_rest) {
  let [fn_name, ...fn_args] = stmt_rest
  codegen_call_common(fn_arg_names, lvar_names, fn_name, fn_args, "call")
}

fn codegen_call_set(fn_arg_names, lvar_names, stmt_rest) {
  let [lvar_name, fn_temp] = stmt_rest
  let [fn_name, ...fn_args] = fn_temp

  mut alines = codegen_call_common(
    fn_arg_names,
    lvar_names,
    fn_name,
    fn_args,
    "call_set",
  )

  lvar_addr = to_lvar_addr(lvar_names, lvar_name)
  alines.push("  cp reg_a {lvar_addr}")

  alines
}

VRAM_ADDR_RE = Regex.compile('^vram\[(\d+)\]$')
VRAM_REF_RE = Regex.compile('^vram\[([a-z_][a-z0-9_]*)\]$')

fn match_vram_addr(s) {
  if type_of(s) != 'String' {
    nil
  } else {
    m = VRAM_ADDR_RE.match(s)
    m == nil ? nil : m[1]
  }
}

fn match_vram_ref(s) {
  if type_of(s) != 'String' {
    nil
  } else {
    m = VRAM_REF_RE.match(s)
    m == nil ? nil : m[1]
  }
}

fn codegen_set(fn_arg_names, lvar_names, rest) {
  let [dest, expr] = rest

  mut alines = []

  src_val = cond {
    type_of(expr) == 'Long' => to_string(expr),
    type_of(expr) == 'Array' => {
      alines.extend(codegen_expr(fn_arg_names, lvar_names, expr))
      "reg_a"
    },
    type_of(expr) != 'String' => throw common.not_yet_impl("set src_val", rest),
    fn_arg_names.contains(expr) => to_fn_arg_addr(fn_arg_names, expr),
    lvar_names.contains(expr) => to_lvar_addr(lvar_names, expr),
    match_vram_addr(expr) != nil => {
      src_vram_addr = match_vram_addr(expr)
      alines.push("  get_vram {src_vram_addr} reg_a")
      "reg_a"
    },
    match_vram_ref(expr) != nil => {
      src_var_name = match_vram_ref(expr)
      if lvar_names.contains(src_var_name) {
        src_lvar_addr = to_lvar_addr(lvar_names, src_var_name)
        alines.push("  get_vram {src_lvar_addr} reg_a")
        "reg_a"
      } else {
        throw common.not_yet_impl("rest", rest)
      }
    },
    _ => throw common.not_yet_impl("set src_val", rest),
  }

  cond {
    match_vram_addr(dest) != nil => {
      dest_vram_addr = match_vram_addr(dest)
      alines.push("  set_vram {dest_vram_addr} {src_val}")
    },
    match_vram_ref(dest) != nil => {
      dest_vram_ref = match_vram_ref(dest)
      if lvar_names.contains(dest_vram_ref) {
        dest_lvar_addr = to_lvar_addr(lvar_names, dest_vram_ref)
        alines.push("  set_vram {dest_lvar_addr} {src_val}")
      } else {
        throw common.not_yet_impl("dest", dest)
      }
    },
    lvar_names.contains(dest) => {
      dest_plain_lvar_addr = to_lvar_addr(lvar_names, dest)
      alines.push("  cp {src_val} {dest_plain_lvar_addr}")
    },
    _ => throw common.not_yet_impl("dest", dest),
  }

  alines
}

fn codegen_return(lvar_names, stmt_rest) {
  retval = stmt_rest[0]

  cond {
    type_of(retval) == 'Long' => ["  cp {retval} reg_a"],
    match_vram_ref(retval) != nil => {
      ref_var_name = match_vram_ref(retval)
      if lvar_names.contains(ref_var_name) {
        ref_lvar_addr = to_lvar_addr(lvar_names, ref_var_name)
        ["  get_vram {ref_lvar_addr} reg_a"]
      } else {
        throw common.not_yet_impl("retval", retval)
      }
    },
    lvar_names.contains(retval) => {
      plain_lvar_addr = to_lvar_addr(lvar_names, retval)
      ["  cp {plain_lvar_addr} reg_a"]
    },
    _ => throw common.not_yet_impl("retval", retval),
  }
}

fn codegen_vm_comment(comment) {
  ["  _cmt {comment.tr(' ', '~')}"]
}

fn codegen_stmt(fn_arg_names, lvar_names, stmt) {
  let [stmt_head, ...stmt_rest] = stmt

  match stmt_head {
    'call' => codegen_call(fn_arg_names, lvar_names, stmt_rest),
    'call_set' => codegen_call_set(fn_arg_names, lvar_names, stmt_rest),
    'set' => codegen_set(fn_arg_names, lvar_names, stmt_rest),
    'return' => codegen_return(lvar_names, stmt_rest),
    'case' => codegen_case(fn_arg_names, lvar_names, stmt_rest),
    'while' => codegen_while(fn_arg_names, lvar_names, stmt_rest),
    '_cmt' => codegen_vm_comment(stmt_rest[0]),
    _ => throw common.not_yet_impl("stmt_head", stmt_head),
  }
}

fn codegen_stmts(fn_arg_names, lvar_names, stmts) {
  stmts.flat_map(|stmt| codegen_stmt(fn_arg_names, lvar_names, stmt))
}

fn codegen_func_def(rest) {
  let [fn_name, fn_arg_names, body] = rest

  mut alines = [
    "",
    "label {fn_name}",
    "  push bp",
    "  cp sp bp",
    "",
    "  # 関数の処理本体",
  ]

  mut lvar_names = []

  for stmt in body {
    if stmt[0] == 'var' {
      let [_head, ...stmt_rest] = stmt
      lvar_names.push(stmt_rest[0])
      alines.extend(codegen_var(fn_arg_names, lvar_names, stmt_rest))
    } else {
      alines.extend(codegen_stmt(fn_arg_names, lvar_names, stmt))
    }
  }

  alines.push("")
  alines.push("  cp bp sp")
  alines.push("  pop bp")
  alines.push("  ret")

  alines
}

fn codegen_top_stmts(rest) {
  rest.flat_map(fn (stmt) {
    let [stmt_head, ...stmt_rest] = stmt
    match stmt_head {
      'func' => codegen_func_def(stmt_rest),
      '_cmt' => codegen_vm_comment(stmt_rest[0]),
      _ => throw common.not_yet_impl("stmt_head", stmt_head),
    }
  })
}

fn codegen(tree) {
  let [_head, ...rest] = tree
  ["  call main", "  exit"] + codegen_top_stmts(rest)
}

export {codegen}

# --------------------------------

if Sys.script != nil && FS.basename(Sys.script) == 'vgcg.cul' {
  src = FS.read(Sys.argv[0])
  tree = JSON.parse(src)

  alines = codegen(tree)

  for aline in alines {
    println(aline)
  }
}
