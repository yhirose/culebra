# N-queens — a search that does not know it backtracks.
#
# Place N queens on an N×N board so that no two share a row, column, or
# diagonal. The search below never mentions backtracking: it asks for a column
# with `perform choose(...)` and gives up on a bad placement with
# `perform reject()`. What those operations *mean* is supplied by the enclosing
# `handle`, so one `search` runs unchanged as an exhaustive enumeration or as a
# short-circuiting first-answer search — and a third handler counts placements
# underneath either. See docs/language.md §16 for the reference.
#
# Run it:  culebra examples/effects/queen.cul        (6 queens)
#          culebra examples/effects/queen.cul 8      (8 queens — noticeably slower)
#          culebra --jit examples/effects/queen.cul  (JIT; options precede the script.
#                                                     Warmup dominates at this size,
#                                                     so it is slower than the interp.)

effect fn choose(options)   # pick one option; the handler decides how many
effect fn reject()          # this branch is a dead end
effect fn visit()           # one placement considered (for instrumentation)

let N = Sys.argv.size() > 0 ? to_long(Sys.argv[0]) : 6

# `cols[r]` is the column of the queen on row r; a partial solution is a
# prefix. A new queen at column `c` on row `cols.size()` is safe if it shares
# no column and no diagonal with any queen already placed.
fn is_safe(cols, c) {
  let row = cols.size()
  for r in 0..row {
    let cc = cols[r]
    if cc == c { return false }
    if (row - r) == Math.abs(c - cc) { return false }
  }
  true
}

# The whole search. It is written as if `choose` returned a single column and
# `reject` simply ended the program — the linear, obvious reading. Whether it
# explores one branch or all of them is entirely the handler's business.
effect fn search(cols) {
  if cols.size() == N { return cols }
  let c = perform choose(iota(N))
  perform visit()
  if !is_safe(cols, c) { perform reject() }
  # A fresh array, built *after* the suspension point above, so each fork of
  # `choose` gets its own. Pushing onto an array created before the `perform`
  # would be seen by every fork — the fork copies locals, not the heap.
  search([...cols, c])
}

fn board_of(cols) {
  cols.map(|c| iota(N).map(|i| i == c ? "Q" : ".").join("")).join("\n")
}

# --- handler A: enumerate every solution --------------------------------
# `choose` resumes once per option and concatenates the results, so a single
# `perform` fans out into the whole subtree — this is the backtracking. A
# handler that resumes more than once is "full-control": the continuation is
# captured, which is why `search` must be an `effect fn`.
# `reject` never resumes, so a dead branch's suspended computation is
# discarded and the clause's own value — no solutions — takes its place.
mut nodes_all = 0
let all = handle {
  handle {
    # `search` yields one solution, lifted into a list so that every clause
    # below deals in the same currency: a list of solutions.
    [search([])]
  } with choose(options, resume) {
    options.flat_map(|o| resume(o))
  } with reject(resume) {
    []
  }
} with visit(resume) {
  nodes_all += 1
  resume(nil)   # tail-resumptive: no continuation captured, just a callback
}

println("{N} queens: {all.size()} solutions, {nodes_all} placements considered\n")
if all.size() > 0 { println(board_of(all[0]) + "\n") }

# --- handler B: same search, stop at the first solution ------------------
# Only the `choose` clause changes — it stops resuming once a branch has
# produced an answer. `search` itself is untouched.
mut nodes_one = 0
let one = handle {
  handle {
    [search([])]
  } with choose(options, resume) {
    mut hit = []
    for o in options {
      for s in resume(o) { hit.push(s) }
      if hit.size() > 0 { break }
    }
    hit
  } with reject(resume) {
    []
  }
} with visit(resume) {
  nodes_one += 1
  resume(nil)
}

let answer = one.size() > 0 ? one[0].to_string() : "none"
println("first solution only: {answer}, {nodes_one} placements considered")
if nodes_one < nodes_all {
  println("(same search, {nodes_all - nodes_one} fewer placements — the handler pruned it)")
}
