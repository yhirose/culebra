# Byte order is spelled out, not the host's: wasm must lay out the same bytes.
let b = String.pack("u16", [1, 256, 65535]) +
  String.pack("u32", [7], endian: "big")
inspect(b.bytes().collect())
inspect(String.unpack("u16", b, count: 3))
inspect(String.unpack("u32", b, at: 6, endian: "big"))
inspect(String.unpack("f32", String.pack("f32", [0.1, -2.5])))
let dst = [0, 0]
String.unpack("i16", String.pack("i16", [-1, 2]), into: dst)
inspect(dst)
try {
  String.pack("u8", [256])
} catch e {
  println("{e.kind}: {e.message}")
}
# a @packable record, built back without `new`
@packable
class Rec {
  id: UInt16
  name: BoundedString<4>
  w: Float32
}
let r = Rec()
r.id = 513
r.name = "ab"
r.w = 1.5
let rb = String.pack(Rec, [r, r], endian: "big")
inspect(rb.bytes().collect())
inspect(String.unpack(Rec, rb, endian: "big").map(|x| [x.id, x.name, x.w]))
