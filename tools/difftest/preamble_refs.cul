# Difftest preamble for the refcount lane (DIFFTEST_GC_REFS=1 in run.sh):
# the same record as preamble.cul, plus `rc`, the change in the refcounted
# live count since the previous record. Under CULEBRA_GC_REFS=1 every
# collection finds its roots from the refcounts alone, so `rc` is what the
# case left behind according to the refcounts the engine holds: an engine
# that keeps one temporary more, or one less, on a value diverges here,
# where the plain lane would only notice once a drop fired at the wrong
# time. A delta, not a level: what an engine allocates once per process
# for its own bookkeeping cancels out. The baseline is taken at the first
# record, after the fixtures between this preamble and the cases have run.
fn _show(v) {
  type_of(v) + ":" + to_string(v)
}
mut _rc_prev = -1
fn _p(label, thunk) {
  if _rc_prev < 0 {
    _rc_prev = GC.stat().rc_objects
  }
  let r = try {
    "ok=" + _show(thunk())
  } catch e {
    "err=" +
      e.kind +
      "|" +
      e.message +
      "|" +
      e.line.to_string() +
      "|" +
      e.col.to_string()
  }
  let now = GC.stat().rc_objects
  let d = now - _rc_prev
  _rc_prev = now
  print(label + " ::: " + r + " rc=" + d.to_string() + "\n")
}
