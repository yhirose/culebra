# A binding declared inside an `if` arm is released when the arm ends, and a
# throw after the `if` unwinds the frame's own bindings alone. Both the
# function frame and the top-level one are covered — the corpus reaches only
# the first, and only through `_p`'s try.
fn in_arm(flag) {
  let outer = [1, 2, 3]
  if flag {
    let inner = {a: [4, 5]}
  }
  throw 'after-arm'
}

let top_outer = [6, 7]
if true {
  let top_inner = {b: [8, 9]}
}

try {
  in_arm(true)
} catch e {
}
try {
  in_arm(false)
} catch e {
}

throw 'boom'
