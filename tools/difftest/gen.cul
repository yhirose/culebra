# Differential-test corpus generator. Emits case lines (one `_p(...)` call per
# line) to stdout; the driver prepends preamble.cul to form the manifest, then
# runs it under interp / --jit / AOT and diffs the outputs byte-for-byte. Any
# divergence is an interp/JIT asymmetry.
#
# Generation is template-combinator, not random: it sweeps the seams where
# divergences cluster (operators x operands, methods x receiver types x arg
# shapes, builtins-as-values x call forms, indexing/slicing). Each generated
# body is syntactically valid culebra — a wrong type/arity is a *runtime* error,
# caught and recorded by `_p`, never a parse error that would break the run.
# Run: culebra tools/difftest/gen.cul > cases.cul
mut out = []
fn emit(line) {
  out.push(line)
}

# A case: label (for the diff report) + a body expression whose outcome is
# compared. Labels use single-quote raw strings so embedded `"`/`{}` need no
# escaping (no generated operand contains a single quote).
# `"..."` interpolates `{expr}`, so the literal braces of the generated lambda
# come from single-quote raw strings; the label/body are plain concatenation.
fn case(label, body) {
  emit("_p('" + label + "', fn () " + '{ ' + body + ' }' + ")")
}

# Receiver expressions spanning every Value::Type variant (interpreter.h's
# `enum Type`) except Tensor and StringView, which get their own dedicated
# sweeps (Dimension 15, Dimension 19/24) because neither is reachable through
# a plain literal. Parenthesized so a scalar receiver (`(1).size()`) and a
# method/index chain both parse.
let recvs = [
  '1',
  '1.5',
  'true',
  'nil',
  '"abc"',
  '[1, 2, 3]',
  '{a: 1, b: 2}',
  '(1, 2, 3)',
  '{1, 2, 3}',
  'fn (x) { x }',
]

# --- Dimension 1: operators x operand-type pairs --------------------------
let operands = [
  '1',
  '2',
  '1.5',
  '"a"',
  '"b"',
  'true',
  'nil',
  '[1, 2]',
  '{a: 1}',
  '(1, 2)',
]
let binops = ['+', '-', '*', '/', '%', '<', '<=', '>', '>=', '==', '!=']
for op in binops {
  for l in operands {
    for r in operands {
      case("op|" + op + "|" + l + "|" + r, "(" + l + ") " + op + " (" + r + ")")
    }
  }
}
for u in ['-', '!'] {
  for x in operands {
    case("un|" + u + "|" + x, u + "(" + x + ")")
  }
}

# --- Dimension 2: methods x receiver types x arg shapes -------------------
# Methods spanning Array/String/Object/Set/Tuple/iterator builtins. Applying
# every method to every receiver with every arg shape mostly errors; the point
# is that the error (kind/message/position) must match across backends.
# EVERY name in shared.h's builtin_method_names() belongs here — a method the
# corpus never applies is a method whose error shapes nobody compares
# (`trim_start` sat outside this list for two months with a live asymmetry).
# tools/check_difftest_coverage.sh fails the build when the two drift apart.
let methods = [
  'add',
  'all',
  'any',
  'argmax',
  'backward',
  'bytes',
  'capitalize',
  'chain',
  'chunk_by',
  'chunks',
  'clone',
  'code_points',
  'collect',
  'contains',
  'count',
  'detach',
  'diff',
  'distinct',
  'dot',
  'empty',
  'ends_with',
  'enumerate',
  'eq_ignore_case',
  'extend',
  'filter',
  'find',
  'first',
  'flat_map',
  'flatten',
  'for_each',
  'get',
  'get_or_put',
  'grad',
  'graphemes',
  'group_by',
  'has',
  'index_of',
  'insert',
  'intersect',
  'is_alnum',
  'is_alpha',
  'is_ascii',
  'is_digit',
  'is_space',
  'item',
  'iter',
  'join',
  'keys',
  'last',
  'last_index_of',
  'linear_sigmoid',
  'lines',
  'log',
  'lower',
  'map',
  'max',
  'max_by',
  'mean',
  'min',
  'min_by',
  'normalize',
  'nth',
  'partition',
  'pop',
  'position',
  'pow',
  'presence',
  'product',
  'push',
  'reduce',
  'relu',
  'remove',
  'remove_at',
  'repeat',
  'requires_grad',
  'reshape',
  'reverse',
  'rsplit',
  'scan',
  'shape',
  'sigmoid',
  'size',
  'skip',
  'skip_while',
  'slice',
  'softmax',
  'sort',
  'sort_by',
  'sorted',
  'sorted_by',
  'split',
  'split_iter',
  'split_whitespace',
  'starts_with',
  'step_by',
  'strip_prefix',
  'strip_suffix',
  'subset',
  'sum',
  'superset',
  'sym_diff',
  'take',
  'take_while',
  'tap',
  'title',
  'to_array',
  'to_object',
  'to_set',
  'to_string',
  'tr',
  'transpose',
  'trim',
  'trim_end',
  'trim_start',
  'truncate',
  'union',
  'unzip',
  'upper',
  'values',
  'view',
  'windows',
  'zero_grad',
  'zip',
]
let argshapes = [
  '',
  '0',
  '"x"',
  '1, 2',
  '0, 1, 2',
  '|x| x',
  '|x| x > 0',
  '0, |a, b| a + b',
  'fn (a, b) { a }',
  '[1]',
]
for recv in recvs {
  for m in methods {
    for a in argshapes {
      case(
        "m|" + recv + "|" + m + "|" + a,
        "(" + recv + ")." + m + "(" + a + ")",
      )
    }
  }
}

# --- Dimension 3: builtins / ns-methods as values x call forms ------------
# Covers the direct-vs-as-value duality: a builtin called directly, bound to a
# variable, or handed to a higher-order / lazy combinator. `arg` is good or bad.
let vals = [
  'Math.abs',
  'Math.sqrt',
  'Math.max',
  'Math.min',
  'range',
  'iota',
  'grid',
  'type_of',
  'to_long',
  'to_float',
  'to_string',
  'hash',
]
let vargs = ['1', '"x"', '', '1, 2', '1, 2, 3']
for v in vals {
  for a in vargs {
    case("v-direct|" + v + "|" + a, v + "(" + a + ")")
    case("v-let|" + v + "|" + a, "let _f = " + v + "; _f(" + a + ")")
  }
  # As a higher-order callback (eager array, then lazy iterator).
  case("v-map|" + v, '[1, "x"].map(' + v + ")")
  case("v-mapnum|" + v, "[1, 2, 3].map(" + v + ")")
  case("v-lazy|" + v, "[1, 2, 3].iter().map(" + v + ").collect()")
  case("v-reduce|" + v, "[1, 2, 3].reduce(0, " + v + ")")
}

# --- Dimension 3b: bare builtin-NAME property reads x receiver types ------
# `x.map` with no call parens is rejected only when the receiver's own builtin
# table would dispatch it; any other miss reads as nil like an absent property
# (the JIT decides via culebra_runtime_bare_builtin_reject — pin the two
# backends together across every receiver shape). `zzz` is the non-builtin
# control: a plain nil miss everywhere.
# `bare_names` reuses Dimension 2's `methods` (every name in
# builtin_method_names(), coverage-gated) rather than its own hand-picked
# subset — a name added there is swept here for free, closing the same kind
# of gap `trim_start` fell into (tools/check_difftest_coverage.sh).
let bare_recvs = [
  '1',
  '"abc"',
  '[1, 2]',
  '{a: 1}',
  '(1, 2)',
  '{1, 2}',
  '0..3',
  '[1, 2].iter()',
  '{has_next: fn () { false }, next: fn () { nil }}',
]
let bare_names = [...methods, 'zzz']
for r in bare_recvs {
  for n in bare_names {
    case("bareread|" + r + "|" + n, "(" + r + ")." + n)
  }
}

# --- Dimension 4: indexing and slicing x receiver types -------------------
let indices = ['0', '1', '-1', '100', '"a"', '"missing"']
for recv in recvs {
  for i in indices {
    case("idx|" + recv + "|" + i, "(" + recv + ")[" + i + "]")
  }
  for s in ['0..2', '1..', '..2', '-2..-1', '0..100', '2..0'] {
    case("slice|" + recv + "|" + s, "(" + recv + ")[" + s + "]")
  }
}

# `insert` / `remove_at` take the same positions a subscript does, so they get
# the same index sweep: the in-range, end-slot, negative and out-of-range arms
# must agree with each other and across backends. The receiver is rebuilt per
# case because both mutate.
for i in [...indices, '3', '-3', '-4'] {
  case('insert|' + i, '{ mut a = [1, 2, 3]; a.insert(' + i + ', 9); a }')
  case(
    'removeat|' + i,
    '{ mut a = [1, 2, 3]; let r = a.remove_at(' + i + '); (r, a) }',
  )
}
for src in ['[4, 5]', '[]', '(4, 5)', '{4, 5}', '"ab"', '4', 'nil'] {
  case('extend|' + src, '{ mut a = [1, 2]; a.extend(' + src + '); a }')
  case('concat|' + src, '[1, 2] + ' + src)
}
case("insert-empty", '{ mut a = []; a.insert(0, 1); a }')
case("removeat-empty", '{ mut a = []; a.remove_at(0) }')
case("extend-self", '{ mut a = [1, 2]; a.extend(a); a }')
case("concat-self", '{ let a = [1, 2]; a + a }')
case("concat-shared", '{ let a = [{v: 1}]; let c = a + []; (a[0].v, c[0].v) }')

# --- Dimension 5: value display (inspect / to_string) ----------------------
# The display path differs from to_string for some tags (e.g. a Function
# value: inspect printed `[unknown]` under the JIT while to_string gave
# `[function]`). `inspect(V)` prints before _p's own line, so a display
# divergence shows up on that leading line; `to_string(V)` is compared via
# `_show` on the returned String.
let disp_vals = [
  'to_long',
  'Math.abs',
  'print',
  'fn (x) { x }',
  '|x| x',
  '1',
  '1.5',
  'true',
  'nil',
  '"s"',
  '[1, 2]',
  '{a: 1}',
  '(1, 2)',
  '{1, 2}',
  'range',
  'iota',
  'grid',
]
for v in disp_vals {
  case("disp-inspect|" + v, "inspect(" + v + ")")
  case("disp-str|" + v, "to_string(" + v + ")")
}

# --- Dimension 6: class / enum construction x arity -----------------------
# Constructors are synthesized native closures (no source body), so they
# can diverge from the interpreter on arity the way builtin functions did.
# The decl lives inside the case thunk, so each `E`/`C` is fresh.
# Single-quote raw strings: the decl braces must not be read as `"{...}"`
# interpolation.
let enum_pre = 'enum E { V(Long), W }; '
let class_pre = 'class C { new(a) { self.a = a } }; '
for a in ['', '1', '1, 2', '1, 2, 3'] {
  case("ctor-enum|" + a, enum_pre + "E.V(" + a + ")")
  case("ctor-class|" + a, class_pre + "C.new(" + a + ")")
  # Callable class object: `C(a)` dispatches to `new`, identical to `C.new(a)`
  # (arity errors, kind/message/position all mirror `.new` across backends).
  case("ctor-call|" + a, class_pre + "C(" + a + ")")
}
case("ctor-enum-nullary", enum_pre + "E.W")
case("ctor-enum-nullary-call", enum_pre + "E.W()")
# `C(...)` construction ≡ `C.new(...)`, incl. kwargs and a plain dict staying
# non-callable (a "new" key alone must not make it callable — TypeError).
let kwclass_pre = 'class C { new(a, b = 5) { self.s = a + b } }; '
case("ctor-call-kw", kwclass_pre + "C(1, b: 2).s")
case("ctor-call-kw-default", kwclass_pre + "C(a: 7).s")
case("ctor-call-nullary", 'class C { new() { self.x = 9 } }; C().x')
case("ctor-call-plaindict", 'let d = { new: fn (x) { x } }; d(1)')

# --- Dimension 6d: declared instance fields (`x: T = e`) --------------------
# Initializers run per instance, declaration order, `self` in scope, after
# ctor-arg binding, before the `new` body. The JIT compiles them into a
# synthetic closure invoked from the `new` prologue (or the instance builder
# for a `new`-less class) — value, error kind/position, and init-vs-binding
# ordering must all mirror the interp.
let field_pre = 'class F { a: Long = 3  b: Long = self.a * 2  z: Long  ' +
  's: String  arr: Array = [] }; '
case("field-default", field_pre + "F.new().a")
case("field-this-order", field_pre + "F.new().b")
case("field-zero-long", field_pre + "F.new().z")
case("field-zero-string", field_pre + "F.new().s")
case(
  "field-fresh-array",
  field_pre + "let x = F.new(); let y = F.new(); x.arr.push(1); y.arr",
)
case(
  "field-before-new",
  'class F { a: Long = 3  new(m) { self.r = self.a * m } }; F.new(5).r',
)
case("field-init-throws", 'class F { a: Long = to_long("x") }; F.new()')
case(
  "field-init-after-binding",
  'class F { a: Long = to_long("x")  new(p, q) { } }; F.new(1)',
)
case(
  "field-method-call-init",
  'class F { a: Long = self.base()  base() { 41 } }; F.new().a + 1',
)
case(
  "field-forward-read",
  'class F { a: Long = self.later  later: Long = 9 }; F.new().a',
)
case(
  "field-packable-defaults",
  '@packable class P { x: Int32 = 7  y: Float32 = 0.5 }; ' +
    'let p = P.new(); [p.x, p.y]',
)
# The type annotation is optional (`x = e` declares the same field).
# (@packable rejects the untyped form — a STATIC error, pre-eval, so it
# cannot live in this corpus of runnable thunks.)
case(
  "field-untyped",
  'class F { a = 3  b = self.a * 2 }; let f = F.new(); [f.a, f.b]',
)

# --- Dimension 6e: ctor / method param defaults resolve in defining scope ---
# The interp's method-binding wrapper must carry def_env + the default
# evaluator: a defaulted member call resolves globals (and raises the
# default's own error) identically across backends.
case(
  "member-default-global",
  'let g = 7; class M { new() {} m(b = g * 2) { b } }; M.new().m()',
)
case(
  "member-default-throws",
  'class M { new(a = to_long("zzz")) { self.a = a } }; M.new()',
)
case(
  "member-default-hof",
  'class M { new(x = 1, a = to_long("z")) { } }; [9].map(M.new)',
)

# --- Dimension 6b: class getters (`get name()` read as `obj.name`) ----------
# A getter fires on a bare property read AND when spelled with call parens;
# both must agree across backends (the JIT resolves getters through a separate
# runtime path than the interp). A getter named `name` also exercises the
# function-introspection member path. `p` is fresh per case thunk.
let getter_pre = 'class G { new(a) { self.a = a } get twice() { self.a * 2 } ' +
  'get name() { "g" } plain() { self.a } }; let p = G.new(21); '
case("getter-bare", getter_pre + "p.twice")
case("getter-paren", getter_pre + "p.twice()")
case("getter-name-bare", getter_pre + "p.name")
case("getter-name-paren", getter_pre + "p.name()")
case("getter-in-hof", getter_pre + "[p, p].map(|x| x.twice)")
case("getter-plain-method-value", getter_pre + "type_of(p.plain)")
# a member literally named `get` is an ordinary method, not the modifier
case("getter-named-get", 'class G { new() {} get() { 7 } }; G.new().get()')

# --- Dimension 6c: iterator .join (terminal, no .collect() bridge) ----------
let joinseps = ['","', '"-"', '""', '" "']
for s in joinseps {
  case("iterjoin|" + s, "range(1, 5).map(|x| x * 10).join(" + s + ")")
  case("arrjoin|" + s, "[1, 2, 3].map(|x| x + 1).join(" + s + ")")
}
case("iterjoin-empty", 'range(0, 0).map(|x| x).join(",")')
case("iterjoin-filter", 'range(1, 10).filter(|x| x % 2 == 0).join("-")')

# --- Dimension 7: lazy iterator combinators over an erroring stream --------
# D3's v-lazy maps over `[1, 2, 3]` (never errors); these run the callback
# over `[1, "x"]` so a per-element type error tests the callback's error
# kind / message / *position* through the lazy pipeline (the eager forms
# are covered by D3's v-map). Terminal `collect`/`count`/`for_each`.
let lazycbs = [
  'map(to_long)',
  'filter(to_long)',
  'take_while(to_long)',
  'skip_while(to_long)',
  'tap(to_long)',
  'chunk_by(to_long)',
  'flat_map(to_long)',
  'map(Math.abs)',
  'map(|x| x + 1)',
]
for c in lazycbs {
  case("lazyerr-collect|" + c, '[1, "x"].iter().' + c + ".collect()")
  case("lazyerr-count|" + c, '[1, "x"].iter().' + c + ".count()")
}

# --- Dimension 8: keyword args / kwargs splat -----------------------------
# Positional splat `f(*xs)` is unimplemented (parse error on both), so only
# keyword + `**{}` forms appear here. Good and bad keywords.
let kwcases = [
  'range(0, 5, step: 2).collect()',
  'range(0, 5, **{step: 2}).collect()',
  'range(0, 5, step: 0).collect()',
  'range(0, 5, **{bad: 2}).collect()',
  'range(0, 5, bad: 2).collect()',
  '[1, 2, 3].sort_by(key: |x| x)',
  '[3, 1, 2].sorted(reverse: true)',
  '[3, 1, 2].sorted(bad: 1)',
  'Math.abs(x: 1)',
]
for kc in kwcases {
  case("kw|" + kc, kc)
}
# Ambiguous kwargs-only call landing on a 0-param overload: dispatch (by spec)
# picks `f()`, which can't take the kwargs, so binding fails with an unknown-
# keyword TypeError. Every backend must name the same leftover kwarg — leftover
# selection is single-sourced to the lexicographically smallest name, so this
# guards against the interp/JIT map-iteration-order drift it used to have.
case(
  "kw|overload_0param_ambiguous",
  'fn f() { "empty" }; fn f(x: Long, y: Long) { "xy" }; f(y: 9, x: 8)',
)

# --- Dimension 9: generators / yield --------------------------------------
# Generators lower to a flat-dispatch CPS engine — structurally a different
# implementation from the interpreter, so drive a generator declared inside
# the thunk through each terminal (collect/count/next/for-in), including an
# error mid-stream (position) and control-flow shapes. Single-quote raw so
# the `{ ... }` bodies are not read as interpolation.
let gens = ['fn gg() { yield 1; yield 2; yield 3 }; gg().collect()',
            'fn gg() { yield 1; yield to_long("x"); yield 3 }; gg().collect()',
            'fn gg() { for x in [1, 2] { yield x * 10 } }; gg().collect()',
            'fn gg() { yield 1; return; yield 2 }; gg().collect()',
            'fn gg() { }; gg().collect()',
            'fn gg() { yield 1; yield 2 }; gg().count()',
            'fn gg() { yield 7 }; gg().next()',
            'mut s = 0; fn gg() { yield 1; yield 2 }; for x in gg() { s = s + x }; s',
            # a local name as literal string text is not rewritten; interpolation is
            'fn gg() { let base = 9; yield "the base v"; yield "b={base}" }; to_string(gg().collect())']
for g in gens {
  case("gen|" + g, g)
}

# --- Dimension 10: try / catch / throw ------------------------------------
# Exception propagation + the caught error's kind/message/line, including
# throws raised inside an eager HOF, a lazy pipeline, and a raw user throw.
let trys = [
  'try { to_long("x") } catch e { e.kind }',
  'try { to_long("x") } catch e { e.message }',
  'try { to_long("x") } catch e { e.line }',
  'try { [1].map(|x| to_long("x")) } catch e { e.kind }',
  'try { [1, "x"].iter().map(to_long).collect() } catch e { e.line }',
  'try { throw {kind: "K", message: "m"} } catch e { e.kind }',
  'try { throw {kind: "K", message: "m"} } catch e { e.message }',
  'try { 1 + 1 } catch e { -1 }',
]
for t in trys {
  case("try|" + t, t)
}

# --- Dimension: while init clause (`while mut i = 0; cond { … }`) ----------
# The init clause binds loop-scoped variables that persist across iterations
# and drop on loop exit. Exercise single/multiple bindings, break/continue,
# nested loops, destructuring, and shadowing — all must agree interp vs JIT.
let winits = [
  '{ mut o = []; while mut i = 0; i < 5 { o.push(i); i = i + 1 }; o }',
  '{ mut a = 0; while mut i = 0, mut j = 10; i < j { a = a + i + j; i = i + 1; j = j - 1 }; a }',
  '{ mut r = -1; while mut i = 0; i < 100 { if i == 7 { r = i; break }; i = i + 1 }; r }',
  '{ mut s = 0; while mut i = 0; i < 6 { i = i + 1; if i % 2 == 0 { continue }; s = s + i }; s }',
  '{ mut t = 0; while mut i = 0; i < 3 { while mut j = 0; j < 3 { t = t + i * j; j = j + 1 }; i = i + 1 }; t }',
  '{ mut o = []; while mut (a, b) = (1, 2); a < b { o.push(a + b); a = a + 5 }; o }',
  '{ mut i = 999; while mut i = 0; i < 3 { i = i + 1 }; i }',
  '{ let hd = "0123456789abcdef".graphemes().collect(); let cs = "48656c6c6f".graphemes().collect(); mut o = []; while mut i = 0; i < cs.size() { o.push(hd.index_of(cs[i]) * 16 + hd.index_of(cs[i + 1])); i = i + 2 }; o }',
]
for w in winits {
  case("while_init|" + w, w)
}
# Generator + effect fn bodies with a while-init loop (source-transform paths).
case(
  "while_init|gen",
  'fn g() { while mut i = 0; i < 4 { yield i * i; i = i + 1 } }; g().collect()',
)
case(
  "while_init|eff",
  'effect fn tk(); effect fn c(n) { mut s = 0; while mut i = 0; i < n { perform tk(); s = s + i; i = i + 1 }; s }; handle { c(5) } with tk(r) { r(nil) }',
)

# --- Dimension: nobreak clause (loop-else, no-break semantics) -------------
# `nobreak { … }` runs only when the loop completes normally (condition false /
# iterator exhausted), never after break / return. Exercise while + for, run to
# completion vs break, the search idiom (return-in-body vs return-in-nobreak),
# and init + nobreak together — interp and JIT must agree on every path.
let nobreaks = [
  '{ mut o = []; while mut i = 0; i < 3 { o.push(i); i = i + 1 } nobreak { o.push(99) }; o }',
  '{ mut o = []; while mut i = 0; i < 10 { if i == 2 { break }; o.push(i); i = i + 1 } nobreak { o.push(99) }; o }',
  '{ mut r = 0; while mut i = 0; i < 5 { i = i + 1 } nobreak { r = i }; r }',
  '{ mut o = []; for x in [10, 20, 30] { o.push(x) } nobreak { o.push(0) }; o }',
  '{ mut o = []; for x in [10, 20, 30] { if x == 20 { break }; o.push(x) } nobreak { o.push(0) }; o }',
  '{ mut o = []; for x in 0..4 { o.push(x) } nobreak { o.push(-1) }; o }',
  '{ mut t = 0; for c in "abc" { t = t + 1 } nobreak { t = t + 100 }; t }',
]
for nb in nobreaks {
  case("nobreak|" + nb, nb)
}
# Search idiom: return inside body (break-like, skips nobreak) vs return inside
# nobreak (exhausted). Both the for and while forms, in a function.
case(
  "nobreak|find_hit",
  'fn f(xs, t) { for x in xs { if x == t { return "hit" } } nobreak { return "miss" } }; f([1, 2, 3], 2)',
)
case(
  "nobreak|find_miss",
  'fn f(xs, t) { for x in xs { if x == t { return "hit" } } nobreak { return "miss" } }; f([1, 2, 3], 9)',
)
case(
  "nobreak|while_ret",
  'fn f() { while mut i = 0; i < 3 { i = i + 1 } nobreak { return "done" } }; f()',
)
# A closure defined inside a nobreak block must capture enclosing locals
# identically on both backends (regression: the JIT free-var / local-collect
# pre-passes special-case FOR and used to drop the trailing nobreak child, so a
# closure there had no func_info and the JIT aborted while interp ran fine).
case(
  "nobreak|for_closure",
  'fn f() { let tag = "cap"; mut g = nil; for x in [1, 2] { } nobreak { g = fn() { tag } }; g() }; f()',
)
case(
  "nobreak|while_closure",
  'fn f() { let tag = "cap"; mut g = nil; while mut i = 0; i < 2 { i = i + 1 } nobreak { g = fn() { tag } }; g() }; f()',
)
case(
  "nobreak|for_closure_sum",
  'fn f() { mut total = 0; mut g = nil; for x in [1, 2, 3] { total = total + x } nobreak { g = fn() { total } }; g() }; f()',
)
# Generator + effect fn with nobreak (source-transform paths).
case(
  "nobreak|gen_while",
  'fn g() { while mut i = 0; i < 3 { yield i; i = i + 1 } nobreak { yield 100 } }; g().collect()',
)
case(
  "nobreak|gen_for",
  'fn g() { for x in [1, 2, 3] { yield x } nobreak { yield 99 } }; g().collect()',
)
case(
  "nobreak|eff",
  'effect fn tk(); effect fn c(n) { mut s = 0; while mut i = 0; i < n { perform tk(); s = s + i; i = i + 1 } nobreak { s = s + 1000 }; s }; handle { c(3) } with tk(r) { r(nil) }',
)

# --- Dimension: if init clause (`if mut x = f(); cond { … }`) --------------
# The init clause scopes bindings to the whole if / else-if / else chain and is
# dropped when the chain is left by any path. Exercise single/multiple bindings,
# else-if chains, the init var as the branch value, and if-as-expression.
let ifinits = [
  '{ mut r = ""; if mut d = 6 * 2; d > 10 { r = "big" } else if d > 4 { r = "mid" } else { r = "small" }; r }',
  '{ if mut d = 3 * 2; d > 10 { "big" } else if d > 4 { "mid" } else { "small" } }',
  '{ if mut d = 1 * 2; d > 10 { "big" } else if d > 4 { "mid" } else { "small" } }',
  '{ mut acc = 0; if mut a = 1, mut b = 2; a < b { acc = a + b }; acc }',
  '{ if mut s = "ab" + "cd"; s.size() > 3 { s } else { "x" } }',
  '{ if mut n = 5; n > 0 { n * 10 } else { -1 } }',
  '{ mut x = 100; if mut x = 1; x > 0 { x } else { x } }',
]
for f in ifinits {
  case("if_init|" + f, f)
}
# Generator + effect fn bodies with an if-init (source-transform paths).
case(
  "if_init|gen",
  'fn g() { for x in [1, 2, 3, 4] { if mut d = x * 2; d > 4 { yield d } } }; g().collect()',
)
case(
  "if_init|eff",
  'effect fn ask(); effect fn go() { let v = perform ask(); if mut d = v * 10; d > 50 { "big" } else { "small" } }; handle { go() } with ask(r) { r(9) }',
)

# --- Dimension: match init clause (`match mut x = f(); subject { … }`) -----
# The init clause scopes bindings to the subject and every arm, and is dropped
# when the match is left by any path. Exercise single/multiple bindings, the
# init var in the subject / a guard / an arm body, block arms with defer, and
# a heap-typed init var that must be released exactly once.
let minits = [
  '{ match mut x = 3 + 4; x { 7 => "seven", _ => "other" } }',
  '{ match mut a = 2, mut b = 10; a + b { 12 => "twelve", _ => "no" } }',
  '{ match mut n = 5; n { v if v > n - 1 => v * 2, _ => 0 } }',
  '{ match mut arr = [1, 2, 3]; arr.size() { 3 => arr.size() * 10, _ => 0 } }',
  '{ match mut s = "hi" + "!"; s { v => { defer { }; v.size() } } }',
  '{ mut x = 100; match mut x = 1; x { v => v } }',
  '{ mut o = []; for k in 0..3 { match mut d = k * 2; d { 0 => o.push("a"), 2 => o.push("b"), _ => o.push("c") } }; o }',
]
for m in minits {
  case("match_init|" + m, m)
}
# Throw out of an arm with a heap-typed init var: the init slot must be released
# on the unwind path (no leak), and the error must surface identically.
case(
  "match_init|throw",
  'fn f() { match mut arr = [1, 2, 3]; arr.size() { 3 => { throw "boom" }, _ => 0 } }; try { f() } catch e { "caught" }',
)

# --- Dimension 11: match / patterns ---------------------------------------
let me_pre = 'enum E { A(Long), B }; '
let matches = [
  me_pre + 'match E.A(5) { A(x) => x, _ => -1 }',
  me_pre + 'match E.B { A(x) => x, B => 0, _ => -1 }',
  me_pre + 'match E.A(5) { B => 0 }',
  'match 5 { 1 => "a", 5 => "b", _ => "c" }',
  'match [1, 2] { [a, b] => a + b, _ => 0 }',
  'match (1, 2) { (a, b) => a + b, _ => 0 }',
  'match 5 { x: Long => "long", _ => "other" }',
]
for m in matches {
  case("match|" + m, m)
}
# String value patterns use single-quote string literals: the pattern
# grammar's STRING is raw (single-quote), so `'a'` is a constant pattern
# while a `"..."` is an interpolated string (not a pattern). Backtick raw
# string keeps the single quotes; a fixed label avoids embedding them
# (the label itself is emitted inside a single-quoted string).
case("match-string", `match 'z' { 'a' => 1, 'z' => 2, _ => 3 }`)

# --- Dimension 12: numeric edge cases -------------------------------------
let nums = [
  '(1 << 63)',
  '(1 << 64)',
  '(-1 >> 1)',
  '(0.0 / 0.0)',
  '(1.0 / 0.0)',
  '(-5) % 3',
  '(5) % (-3)',
  '(0xff) + (0b1010) + (0o17)',
  '(2 ** 10)',
  '(2 ** 63)',
  '(~0)',
  '(~5)',
  '(5 / 0)',
  '(5 % 0)',
  '(1.5 % 0.5)',
]
for n in nums {
  case("num|" + n, n)
}

# --- Dimension 13: string formatting / escapes ----------------------------
let strs = [
  'let _x = 3.14159; "v={_x:.2f}"',
  'let _n = 42; "n={_n:05}"',
  'let _n = 255; "h={_n:x}"',
  '"a\tb\nc".size()',
  '"caf\u00e9".size()',
  '"a\x41b".size()',
  '"hello".slice(1, 3)',
  '"hello"[1..3]',
  'let _s = "x"; "interp={_s}{_s}"',
]
for s in strs {
  case("str|" + s, s)
}

# --- Dimension 14: compound / destructure assignment ----------------------
# `??=` on a property/index is a parse error (simple-variable only), so it is
# excluded — the manifest must parse as a whole.
let assigns = ['let o = {a: 1}; o.a += 5; o.a',
               'let o = {a: 1}; o.a += "x"; o.a',
               'mut a = [1, 2, 3]; a[0] += 10; a[0]',
               'mut a = [1, 2, 3]; a[0] += "x"; a[0]',
               'let (a, b) = (1, 2); a + b',
               'mut (a, b) = (1, 2); a - b',
               'mut x = nil; x ??= 5; x',
               'mut x = 3; x ??= 5; x',
               # ImmutableError on a subscript target must carry the same
               # kind/message/position across backends (String + non-String
               # keys, plain + compound). The JIT used to drop the position.
               'mut o = {a: 1}; o["a"] = 9; o.a',
               'mut o = {a: 1}; o["a"] += 9; o.a',
               'mut o = {1: "x"}; o[1] = "y"; o[1]',
               # PLACE_ASSIGN. `(a, b) = t` (all plain names) and
               # `(a, b[0]) = t` take different paths — the pattern matcher vs
               # eval_place_assign — so pair them on the same RHS to pin that
               # both accept the same shapes and report the same mismatch.
               'mut p = [1, 2]; (p[0], p[1]) = (p[1], p[0]); p',
               'mut p = [1, 2]; (p[0], p[1]) = [9, 8]; p',
               'mut p = [1, 2]; (p[1], p[0]) = p; p',
               'mut a = 1; mut p = [0]; (a, p[0]) = (2, 3); [a, p[0]]',
               'mut a = 1; mut b = 2; (a, b) = (3, 4); [a, b]',
               'mut p = [1, 2]; (p[0], p[1]) = (1, 2, 3); p',
               'mut a = 1; mut b = 2; (a, b) = (1, 2, 3); [a, b]',
               'mut p = [1, 2]; (p[0], p[1]) = 5; p',
               'mut a = 1; mut b = 2; (a, b) = 5; [a, b]',
               'mut p = [1]; (p[0], _) = (7, 8); p',
               'mut p = [1]; (p[0],) = (7,); p',
               'mut o = {mut a: 1, mut b: 2}; (o.a, o.b) = (o.b, o.a); [o.a, o.b]',
               'let o = {a: 1}; mut x = 0; (o.a, x) = (9, 9); o.a',
               'mut m = [[1, 2], [3, 4]]; (m[0][1], m[1][0]) = (m[1][0], m[0][1]); m',
               'mut p = [[1], [2]]; (p[0], p[1]) = (p[1], p[0]); p[0].push(9); p',
               'mut p = [1, 2]; (p[0], p[3]) = (1, 2); p']
for a in assigns {
  case("assign|" + a, a)
}

# --- Dimension 15: Tensor construction / ops / errors ---------------------
# Tensor is a separate runtime object with its own JIT codegen, so it was a
# corpus blind spot. Use only deterministic constructors (`zeros`/`ones`/
# `from`) — `randn` is random — and observe via `.shape()`, display, or
# `.to_array()` after `Tensor.eval`. The error cases pin the kind/message/
# *position* of the type, reshape, slice, and index guards across backends.
let tensors = ['Tensor.zeros(2, 3).shape()',
               'Tensor.zeros(2, 3)',
               'Tensor.zeros("f32", 2, 3)',
               'Tensor.zeros("f64", 2, 3)',  # rejected dtype tag
               'Tensor.ones(2, 2).to_array()',
               'Tensor.from([1.0, 2.0, 3.0]).shape()',
               'Tensor.from([[1, 2], [3, 4]]).shape()',
               'Tensor.from(5)',
               'Tensor.zeros(2, 3).reshape([3, 2]).shape()',
               'Tensor.zeros(2, 3).reshape([4, 4])',
               'Tensor.zeros(2, 3).transpose().shape()',
               'Tensor.zeros(5, 2).slice(1, 3).shape()',
               'Tensor.zeros(3, 2).slice(5, 9)',
               'Tensor.zeros(2, 3).sum()',
               'let a = Tensor.ones(2, 2); let b = Tensor.ones(2, 2); ' +
                 'let c = a + b; Tensor.eval(c); c.to_array()',
               'let a = Tensor.from([[1.0, 2.0], [3.0, 4.0]]); ' +
                 'let b = Tensor.ones(2, 2); let c = a * b; ' +
                 'Tensor.eval(c); c.to_array()',
               # autograd: VJP per op, hand-computable. Native grad/backward
               # is shared in tensor.h, so symmetry is structural — but pin it.
               'let a = Tensor.from([[1.0, 2.0], [3.0, 4.0]]).requires_grad(); ' +
                 'let b = Tensor.from([[5.0, 6.0], [7.0, 8.0]]).requires_grad(); ' +
                 'let c = a * b; c.backward(); a.grad().to_array()',
               'let a = Tensor.from([[1.0, 2.0], [3.0, 4.0]]).requires_grad(); ' +
                 'let b = Tensor.from([[5.0, 6.0], [7.0, 8.0]]).requires_grad(); ' +
                 'let c = a * b; c.backward(); b.grad().to_array()',
               'let p = Tensor.from([[1.0, 2.0]]).requires_grad(); ' +
                 'let q = Tensor.from([[3.0, 4.0]]).requires_grad(); ' +
                 'let r = p + q; r.backward(); p.grad().to_array()',
               'let v = Tensor.from([[1.0, 2.0, 3.0]]).requires_grad(); ' +
                 'let w = v * 2.0; w.backward(); v.grad().to_array()',
               'let A = Tensor.from([[1.0, 2.0], [3.0, 4.0]]).requires_grad(); ' +
                 'let B = Tensor.from([[1.0, 0.0], [0.0, 1.0]]).requires_grad(); ' +
                 'let C = A.dot(B); C.backward(); A.grad().to_array()',
               'let A = Tensor.from([[1.0, 2.0], [3.0, 4.0]]).requires_grad(); ' +
                 'let B = Tensor.from([[1.0, 0.0], [0.0, 1.0]]).requires_grad(); ' +
                 'let C = A.dot(B); C.backward(); B.grad().to_array()',
               'let x = Tensor.from([[-1.0, 2.0], [3.0, -4.0]]).requires_grad(); ' +
                 'let y = x.relu(); y.backward(); x.grad().to_array()',
               'let m = Tensor.from([[1.0, 2.0, 3.0]]).requires_grad(); ' +
                 'let mt = m.transpose(); mt.backward(); m.grad().to_array()',
               'let s = Tensor.from([[1.0, 2.0], [3.0, 4.0]]).requires_grad(); ' +
                 'let sr = s.reshape([4]); sr.backward(); s.grad().to_array()',
               'let t = Tensor.from([[1.0], [2.0], [3.0], [4.0]]).requires_grad(); ' +
                 'let ts = t.slice(1, 3); ts.backward(); t.grad().to_array()',
               'let z = Tensor.from([1.0, 2.0, 3.0]).requires_grad(); ' +
                 'let zs = z.softmax(); zs.backward(); z.grad().to_array()',
               'let a = Tensor.from([[1.0, 2.0]]).requires_grad(); ' +
                 'let c = a * a; c.backward(); a.zero_grad(); a.grad().to_array()',
               'let d = Tensor.from([[1.0, 2.0]]).requires_grad().detach(); ' +
                 'd.requires_grad()',
               'let x = Tensor.from([[2.0, 4.0], [8.0, 16.0]]).requires_grad(); ' +
                 'let y = x.log(); y.backward(); x.grad().to_array()',
               'let a = Tensor.from([[1.0, 2.0], [3.0, 4.0]]); ' +
                 'let b = Tensor.from([[5.0, 6.0]]); Tensor.concat([a, b]).to_array()',
               'let a = Tensor.from([[1.0, 2.0]]).requires_grad(); ' +
                 'let b = Tensor.from([[3.0, 4.0]]).requires_grad(); ' +
                 'let c = Tensor.concat([a, b]); ' +
                 'let w = Tensor.from([[10.0, 20.0], [30.0, 40.0]]); ' +
                 'let l = (c * w).sum(0).sum(0); l.backward(); a.grad().to_array()',
               'Tensor.from([3.0, 5.0]).sum(0).item()',
               'Tensor.from([[2.0]]).item()',
               'let g = Tensor.from([1.0, 2.0, 3.0]); (g * g).sum(0).item()',
               'Tensor.from([1.0, 2.0]).item()',
               'let a = Tensor.from([1.0, 2.0, 3.0]).requires_grad(); ' +
                 'Tensor.no_grad(fn () { let z = (a * a).sum(0); z.backward(); 0 }); ' +
                 'a.grad().to_array()',
               'Tensor.no_grad(fn () { Tensor.from([2.0, 3.0]).sum(0).item() })',
               'Tensor.no_grad(42)',
               'class C { new() {} __call__() { 1 } }; Tensor.no_grad(C.new())']
for t in tensors {
  case("tensor|" + t, t)
}

# --- Dimension 16: keyword-argument binding (constructors + methods) -------
# The JIT used to (a) reject every keyword arg to a constructor ("function does
# not accept keyword arguments") and (b) check unknown-keyword before
# missing-required — both interp/JIT divergences. Sweep ctor + method calls
# over kwarg shapes (good and bad) so the bound value OR the error
# kind/message/position stays identical across backends. A fresh class is
# declared inside each thunk (single-quote raw so the decl braces are literal,
# not read as `"{...}"` interpolation).
let kwc_pre = 'class C { new(a, b = 10) { self.s = a + b } m(a, b = 10) { a + b } }; '
let kw_ctor_calls = [
  'C.new(1).s',
  'C.new(1, 2).s',
  'C.new(a: 1).s',
  'C.new(a: 1, b: 2).s',
  'C.new(b: 2, a: 1).s',
  'C.new(1, b: 2).s',
  'C.new(1, **{b: 5}).s',
  'C.new().s',
  'C.new(bad: 1).s',
  'C.new(1, bad: 2).s',
  'C.new(1, a: 2).s',
  'C.new(a: 1, a: 2).s',
]
for c in kw_ctor_calls {
  case("kwbind-ctor|" + c, kwc_pre + c)
}
let kw_method_calls = [
  'C.new(0).m(1)',
  'C.new(0).m(1, 2)',
  'C.new(0).m(a: 1)',
  'C.new(0).m(a: 1, b: 2)',
  'C.new(0).m(b: 2, a: 1)',
  'C.new(0).m(1, b: 2)',
  'C.new(0).m()',
  'C.new(0).m(bad: 1)',
  'C.new(0).m(1, bad: 2)',
  'C.new(0).m(1, a: 2)',
]
for c in kw_method_calls {
  case("kwbind-method|" + c, kwc_pre + c)
}
# A method whose name collides with a builtin (`add`, also a Set method) must
# still bind kwargs to the user method, not the JIT's positional set-mutate
# fast path (which silently misbound a keyword as a positional arg).
let kwa_pre = 'class A { new() {} add(a, b = 10) { a + b } }; '
let kw_add_calls = [
  'A.new().add(1)',
  'A.new().add(a: 1)',
  'A.new().add(a: 1, b: 2)',
  'A.new().add(1, b: 2)',
  'A.new().add(bad: 1)',
  'A.new().add()',
]
for c in kw_add_calls {
  case("kwbind-add|" + c, kwa_pre + c)
}
# A real Set receiver rejects keywords to its mutating add/remove.
for c in ['{1, 2}.add(x: 3)', '{1, 2}.remove(x: 1)'] {
  case("kwbind-setmut|" + c, c)
}

# --- Dimension 17: for-in iteration model ---------------------------------
# Object iteration yields (key, value) pairs; bare-comma targets are tuple
# patterns; values()/enumerate() are lazy iterators. Pin the shapes (and the
# structural-mutation guard) across backends. Each body collects into a
# deterministic value.
let iters = [
  'mut r = []; for k, v in {a: 1, b: 2, c: 3} { r.push((k, v)) }; r',
  'mut r = []; for (k, v) in {a: 1, b: 2} { r.push(k) }; r',
  'mut r = []; for x in {a: 1, b: 2} { r.push(x) }; r',
  '{a: 1, b: 2, c: 3}.values().collect()',
  '{a: 1, b: 2, c: 3}.keys()',
  '{a: 1, b: 2}.iter().collect()',
  '{a: 1, b: 2}.values().map(|x| x * 10).collect()',
  'mut r = []; for k, v in {1: "a", 2: "b"} { r.push((k, v)) }; r',
  '[10, 20, 30].enumerate().collect()',
  'mut r = []; for i, v in [10, 20].enumerate() { r.push(i + v) }; r',
  '[5, 6].iter().enumerate().collect()',
  'mut r = []; for k, (a, b) in {x: (1, 2), y: (3, 4)} { r.push((k, a + b)) }; r',
  'mut r = []; for (a, b) in {p: (1, 2), q: (3, 4)}.values() { r.push(a + b) }; r',
  // Snapshot-tolerant mutation: add (not visited), remove (skipped), live value.
  'mut o = {a: 1, b: 2}; mut s = []; for k, v in o { o["z"] = 9; s.push(k) }; s',
  'mut o = {a: 1, b: 2, c: 3}; mut s = []; for k, v in o { if k == "a" { o.remove("c") }; s.push(k) }; s',
  'mut o = {a: 1, b: 2}; mut s = []; for k, v in o.values() { o[k + "2"] = v; s.push(v) }; s']
for it in iters {
  case("forin|" + it, it)
}

# --- Dimension 18: multimethod lexical scope isolation --------------------
# Each `_p` thunk is its own lexical scope. A `fn name` declared in one thunk
# must NOT contribute an overload to a same-named `fn` in another thunk. The
# JIT once keyed every multimethod by source name in a thread_local global
# table, so a sibling scope's overload silently satisfied a call the local
# signature alone would reject (a wrong result instead of the interp's
# DispatchError). Two thunks declare `fn lx` with disjoint arities; the second,
# run after the first has populated the (formerly shared) table, would
# mis-dispatch if the leak were still present.
# Bodies hold literal `{...}` decl braces, so they are single-quote raw (a
# double-quoted body would read the braces as `{expr}` interpolation).
case("scope-iso|decl-1-arg", 'fn lx(x) { x }; lx(41)')
case(
  "scope-iso|call-arity-only-local",
  'fn lx(x, y) { x + y }; try { lx(99) } catch e { e.kind }',
)
# Same-scope overloads still merge into one dispatcher within a thunk.
case(
  "scope-iso|same-scope-overload",
  'fn ov(x) { 1 }; fn ov(x, y) { 2 }; [ov(0), ov(0, 0)]',
)
# A nested helper rebuilt across two activations keeps a stable table.
case(
  "scope-iso|nested-reentrant",
  'fn mk(n) { fn h(x) { x * 2 }; h(n) }; [mk(3), mk(4)]',
)

# --- Dimension 19: string scalar iteration (value AND type) ---------------
# for-in / .iter() / .graphemes() yield 1-scalar StringViews; .code_points()
# yields Longs. The JIT used to yield String (for-in/graphemes) or Long
# (iter) — the type_of cases pin StringView across backends (a value-only
# case would miss it, since a StringView and a String render identically).
let strits = [
  'mut r = []; for c in "café" { r.push(c) }; r',
  '"café".iter().collect()',
  '"café".graphemes().collect()',
  '"café".code_points().collect()',
  '"e\u0301".graphemes().collect()',
  '"e\u0301".iter().collect()',
  '"a\xffb".iter().collect()',
  'mut t = ""; for c in "x" { t = type_of(c) }; t',
  'type_of("a".iter().collect()[0])',
  'type_of("a".graphemes().collect()[0])',
  'type_of("a".code_points().collect()[0])',
  'mut r = []; for c in "ab" { r.push(c.upper()) }; r',
]
for s in strits {
  case("striter|" + s, s)
}

# --- Dimension 20: String.replace (UFCS stdlib helper) --------------------
# Literal vs regex pattern, template vs callback repl, and chaining — must
# behave identically across backends (it desugars to split/join or the
# Regex's replace_all, both already symmetric). Bodies are single-quote raw,
# so regex literals use the `re"..."` (double-quote) form.
let reps = [
  '"a,b,c".replace(",", "、")',
  '"aaa".replace("a", "bb")',
  '"no".replace("x", "y")',
  '"a1b22c333".replace(re"\d+", "#")',
  '"x@y".replace(re"(\w+)@(\w+)", "$2.$1")',
  '"x12y3".replace(re"\d+", fn (m) { "[{m.value}]" })',
  '"10-20".replace(Regex.compile("(?<a>\d+)-(?<b>\d+)"), "$<a>から$<b>")',
  '"a, b  1".replace(",", "、").replace(re"\s+", " ").replace(re"\d", "N")',
]
for r in reps {
  case("replace|" + r, r)
}

# --- Dimension 21: sort_by / sorted_by reverse: kwarg ---------------------
# Keyword-only `reverse:` (stable descending). Both backends must agree on
# the order (incl. tie stability) and on the unknown-keyword TypeError.
let sorts = [
  '[3, 1, 2].sorted_by(|x| x)',
  '[3, 1, 2].sorted_by(|x| x, reverse: true)',
  '[3, 1, 2].sorted_by(|x| x, reverse: false)',
  '["bb", "a", "ccc"].sorted_by(|s| s.size(), reverse: true)',
  '[(1, "a"), (1, "b"), (0, "c")].sorted_by(|t| t[0], reverse: true)',
  'mut a = [3, 1, 2]; a.sort_by(|x| x, reverse: true); a',
  'mut k = nil; try { [1].sorted_by(|x| x, bad: 1) } catch e { k = e.kind }; k',
]
for s in sorts {
  case("sortrev|" + s, s)
}

# --- Dimension 22: regex literal `${expr}` interpolation ------------------
# Desugars to a `+`-concatenation of raw STRINGs and `Regex.interp(expr)`
# calls feeding `Regex.compile`; `Regex.interp` (shared stdlib helper) must
# escape Strings / splice Regexes identically on both backends. Bodies are
# single-quote raw, so the inner regex literals use the `re"..."` form and
# keep `\d` / `\$` verbatim.
let interps = [
  'let x = "a.b"; re"^${x}$".test("a.b")',
  'let x = "a.b"; re"^${x}$".test("axb")',
  'let n = 42; re"v${n}".test("v42")',
  'let d = re"\d+"; re"id=${d};".test("id=123;")',
  'let d = re"\d+"; re"id=${d};".test("id=;")',
  're"a{2,3}".test("aaa")',
  're"\${2}".test("$$")',
  'let a = "foo"; let b = "bar"; re"${a}-${b}".test("foo-bar")',
  're"a${re"\d"}b".test("a5b")',
  'let num = re"[0-9]+"; re"(${num})".find("x42y")[1]',
  'let nm = "abc"; re"${nm}"i.test("ABC")',
  're"".test("")',
  'let p = "c.t"; Regex.interp(p)',
]
for r in interps {
  case("regex_interp|" + r, r)
}

# --- Dimension 23: deterministic drop (scope-exit / cycles / escape) ------
# Phase 2 owned-stack semantics: a drop-having object created under a
# scope drops at that scope's exit (reverse creation order, cycle members
# included); escape into an outer container defers to the owner's scope;
# explicit drop is exactly-once. Drops are observed through a shared log
# array mutated by the drop bodies — the final log must match across
# backends in both content and order.
let drops = [
  'mut g = []; { let r = {drop: fn () { g.push(1) }} }; g',
  'mut g = []; { let a = {drop: fn () { g.push(1) }}; let b = {drop: fn () { g.push(2) }} }; g',
  'mut g = []; { let a = {drop: fn () { g.push(1) }}; let b = {drop: fn () { g.push(2) }}; a.p = b; b.p = a }; g',
  'mut g = []; { let a = {drop: fn () { g.push(1) }}; a.me = a }; g',
  'mut g = []; { mut x = {drop: fn () { g.push(1) }}; x.me = x; x = nil }; g',
  'mut g = []; let xs = []; { let f = {drop: fn () { g.push(1) }}; xs.push(f) }; g.size()',
  'mut g = []; { let a = {drop: fn () { g.push(1) }}; a.drop(); a.drop() }; g',
  'mut g = []; { let a = {drop: fn () { g.push(1) }}; let b = a }; g',
  'mut g = []; { let t = [{drop: fn () { g.push(1) }}, {drop: fn () { g.push(2) }}] }; g',
  'mut g = []; { let a = {drop: fn () { g.push(1) }}; a.list = [a] }; g',
  'mut g = []; { let a = {drop: fn () { g.push(1) }}; a.me = a; a.drop() }; g',
  'mut g = []; { let a = {mut p: nil, drop: fn () { g.push(1) }}; let b = {mut p: nil, drop: fn () { self.p = nil; g.push(2) }}; a.p = b; b.p = a }; g',
  'mut g = []; { let a = {drop: fn () { g.push(1) }}; let k = {hash: fn () { 42 }, eq: fn () { true }, back: a}; a[k] = 1 }; g',
  'mut g = []; { let a = {drop: fn () { g.push(1) }}; let b = {drop: fn () { g.push(2) }}; a.p = b; b.p = a }; let n = g.size(); n',
]
for d in drops {
  case("drop|" + d, d)
}

# --- Dimension 24: StringView ordering / equality -------------------------
# String iteration yields StringViews, so `sort_by(|c| c)` over collected
# characters orders StringView-to-StringView — a seam the JIT once missed
# (microgpt smoke regression). Same-tag ordering works; String-vs-StringView
# ordering is a TypeError on both backends; equality is value-based across
# the two tags.
let svs = [
  'mut xs = []; for c in "cba" { xs.push(c) }; xs.sort_by(|c| c); xs',
  'let v = "xz"[1..2]; let w = "ay"[1..2]; v < w',
  'let v = "xz"[1..2]; let w = "ay"[1..2]; (v > w, v <= w, v >= w)',
  'let v = "xz"[1..2]; v < "z"',
  'let v = "xz"[1..2]; (v == "z", "z" == v, v != "z")',
  '"ab"[0..1] == "ab"[1..2]',
  'mut xs = []; for c in "banana" { if !xs.contains(c) { xs.push(c) } }; xs.sort_by(|c| c); xs.join("")',
]
for s in svs {
  case("svord|" + s, s)
}

# --- Dimension 25: Foreign binding (__Foreign.Counter PoC) ----------------
# The hand-bound C++ class: construction, thunk dispatch, the three
# return-ownership shapes, ClosedError after drop, marshalling errors, a
# throwing C++ body — message and position must match across backends (the
# ownership-shape check).
let fns = [
  '{ let c = __Foreign.Counter.new(5); c.add(2); c.value() }',
  '{ let c = __Foreign.Counter.new(5); c.label() }',
  '{ let c = __Foreign.Counter.new(1); let b = c.clone(); b.add(9); (c.value(), b.value()) }',
  '{ let c = __Foreign.Counter.new(1); c.fork().value() }',
  '{ let c = __Foreign.Counter.new(1); c.share().value() }',
  'let n0 = __Foreign.Counter.live(); { let c = __Foreign.Counter.new(1); nil }; __Foreign.Counter.live() - n0',
  '{ let c = __Foreign.Counter.new(7); c.drop(); c.value() }',
  '{ let c = __Foreign.Counter.new(7); c.drop(); c.drop(); __Foreign.Counter.live() }',
  '{ let c = __Foreign.Counter.new(0); c.add("x") }',
  '{ let c = __Foreign.Counter.new(6); c.divide(0) }',
  '{ let c = __Foreign.Counter.new(0); c.drop(); c.add("x") }',
  '{ let c = __Foreign.Counter.new(0); let g = c.add; g("x") }',
  '{ let c = __Foreign.Counter.new(0); c.add() }',
  '__Foreign.Counter.new("x")',
  '__Foreign.Counter.new()',
]
for f in fns {
  case("foreign|" + f, f)
}

# --- Dimension 26: typed-param error positions -----------------------------
# Where "parameter '<x>' expects <T>" points: the interp binder reports a
# POSITIONAL argument at its own expression and a kwarg-/default-filled
# slot at the call site. The JIT once baked the fn-definition (or call)
# position; the prologue now resolves it per call via the argpos/call-site
# thread-locals. One case per call shape that threads positions: direct,
# kwargs (static + splat), property method, UFCS receiver/arg, add-dispatch,
# and the parenthesized-receiver builtin rich errors. These are single-line
# cases, so the probe's e.col is what makes them load-bearing.
let tps = [
  'let f = fn (n: Long) { n }; f("x")',
  'let f = fn (a: Long, b: Long) { a }; f(1, "x")',
  'let f = fn (n: Long) { n }; f(n: "x")',
  'let f = fn (a: Long, b: Long) { a }; f("x", b: 2)',
  'let f = fn (a: Long, b: Long) { a }; f(1, b: "x")',
  'let f = fn (a: Long, b: Long = "x") { a }; f(1)',
  'let f = fn (a: Long, b: Long) { a }; f(**{a: 1, b: "x"})',
  'let o = {m: fn (n: Long) { n }}; o.m("x")',
  'let o = {m: fn (a: Long, b: Long) { a }}; o.m(1, b: "x")',
  'let o = {m: fn (a: Long, b: Long) { a }}; o.m("x", b: 2)',
  'let f = fn (n: Long, m: Long) { n }; "x".f(1)',
  'let f = fn (n: Long, m: Long) { n }; (1).f("x")',
  'let f = fn (n: Long, m: Long) { n }; "x".f(m: 1)',
  'let o = {add: fn (n: Long) { n }}; o.add("x")',
  '("abc").contains(0)',
  '("abc").split(0)',
  '([1, 2]).join(0)',
  '("abc").slice(0, "x")',
  '([3, 1]).sort_by()',
  '([3, 1]).sort_by(1, 2)',
  'let cb = fn (v: Long) { v }; [1, "x"].for_each(cb)',
  '[1, "x"].map(fn (v: Long) { v })',
  '[1, "x"].filter(fn (v: Long) { true })',
  '[1, "x"].reduce(0, fn (a: Long, v: Long) { a + v })',
  '[1, "x"].sort_by(fn (v: Long) { v })',
  'let cb = fn (v: Long) { v }; [1, "x"].iter().map(cb).collect()',
  '[1, "x"].iter().map(fn (v: Long) { v }).collect()',
  '[1, "x"].iter().filter(fn (v: Long) { true }).collect()',
  '[1, "x"].iter().take_while(fn (v: Long) { true }).collect()',
  '[1, "x"].iter().skip_while(fn (v: Long) { true }).collect()',
  '[1, "x"].iter().position(fn (v: Long) { false })',
  '[1, "x"].iter().tap(fn (v: Long) { v }).collect()',
  '[1, "x"].iter().chunk_by(fn (v: Long) { v }).collect()',
  '[1, "x"].iter().scan(0, fn (a: Long, v: Long) { a }).collect()',
  '[[1], "x"].iter().flatten().collect()', '[1, 2].iter().flatten().collect()',
  '["ab"].iter().flatten().collect()', '[[1, 2]].iter().flatten().collect()',
  '[1, 1, 2].iter().distinct().collect()', '[[1]].iter().distinct().collect()',
  '[1, 1.0, true].iter().distinct().collect()',
  '[1, 2, 3].iter().step_by(2).collect()', '[1].iter().step_by(0).collect()',
  '[1].iter().step_by(-1).collect()', '[1].iter().step_by("x").collect()',
  '[1, 1, 2, 1].iter().chunk_by(|x| x).collect()',
  '[1, 2].iter().scan(0, |a, x| a + x).collect()',
  # A heap seed keeps the +1 alive across the callback compile, which ends the
  # block — the raw form tripped the pin check and aborted codegen.
  '[1, 2].iter().scan([0], |a, x| [a[0] + x]).collect()',
  'range(3).scan([0], |a, x| [a[0] + x]).collect()',
  '[1, 2.5].sum()', '[1, 2.5].iter().sum()', '[1, 2.5].product()',
  '[1, 2.5].min()', '[1, 2.5].max()', '[2.5, 3].iter().max()',
  '[1, "x"].sum()', '[1, "x"].min()', '[1, "x"].iter().product()',
  '[nil].sum()', '[].min()', '[].iter().max()', '[].sum()',
  '[1, 2].min_by(fn (v: Long) { v })',
  '[1, "x"].iter().min_by(fn (v: Long) { v })',
  '[1, 2].max_by(|x| "k")', '[].min_by(|x| x)', '[].iter().max_by(|x| x)',
  '[1, 2, 2].to_set()', '[1, 2, 2].iter().to_set()', '[[1]].to_set()',
  '[1, 1.0, true].to_set()', '[].to_set()',
  '[("a", 1), ("b", 2)].to_object()', '[("a", 1), ("b", 2)].iter().to_object()',
  '[("a", 1), ("a", 9)].to_object()', '[].to_object()', '[].iter().to_object()',
  '[(1, "x"), (true, "y"), (1.5, "z")].to_object()',
  '[1, 2].to_object()', '[("a", 1, 2)].iter().to_object()',
  '[([1], "v")].to_object()', '[nil].to_object()',
  '{a: 1, b: 2}.iter().map(|(k, v)| (k, v * 2)).to_object()',
  '[1, 2, 3].group_by(|x| x % 2)', '[1, 2, 3].iter().group_by(|x| x % 2)',
  '[1, 2].group_by(|x| [x])', '[1, "x"].group_by(fn (v: Long) { v })',
  '[1, 2, 3].partition(|x| x > 1)', '[1, 2, 3].iter().partition(|x| x > 1)',
  '[1, "x"].iter().partition(fn (v: Long) { true })',
  '[(1, 2), (3, 4)].unzip()', '[(1, 2), (3, 4)].iter().unzip()',
  '[].unzip()', '[].iter().unzip()',
  '[1, 2, 3].iter().zip([4, 5, 6]).unzip()',
  '["a", "b"].iter().enumerate().unzip()',
  '[(1, "x"), (true, "y"), (1.5, "z")].unzip()',
  '[{first: 1, second: 2, extra: 3}].unzip()',
  '[1, 2, 3].unzip()', '[(1, 2, 3)].unzip()',
  '[{first: 1}].unzip()', '[nil].unzip()',
  '[1, "x"].iter().for_each(fn (v: Long) { v })',
  '[1, "x"].iter().any(fn (v: Long) { false })',
  '[1, "x"].iter().reduce(0, fn (a: Long, v: Long) { a })',
  'range(2).map(fn (v: String) { v }).collect()',
  'range(2).for_each(fn (v: String) { v })',
  'range(2).reduce("", fn (a: String, v: String) { a })',
  '([1, "x"]).map(fn (v: Long) { v })',
  '[1].map(fn (v, *, w: Long = "x") { v })',
  '[1, "x"].map(fn (*xs) { xs })',
  '[5].map(FS.read).collect()',
  'class Dbl { __call__(v: Long) { v * 2 } }; [1, "x"].map(Dbl.new())']
for t in tps {
  case("typos|" + t, t)
}

# --- Dimension 27: destructuring pattern params as HOF callbacks -----------
# `fn ((a, b))` through every callback path. The JIT's inline fusion used to
# bind the pattern as an unnamed slot and NameError on the body's first read.
let pps = [
  '[(1, 2)].map(fn ((a, b)) { a + b })',
  'let f = fn ((a, b)) { a + b }; [(1, 2), (3, 4)].map(f)',
  '[(1, 2)].filter(fn ((a, b)) { a < b })',
  '[(1, 2), (3, 4)].reduce(0, fn (acc, (a, b)) { acc + a + b })',
  '[(1, 2)].iter().map(fn ((a, b)) { a + b }).collect()',
  '[(1, 2)].for_each(fn ((a, b)) { a + b })',
  '[(2, 1)].sort_by(fn ((a, b)) { b })',
  '[{x: 1, y: 2}].map(fn ({x, y}) { x + y })',
]
for p in pps {
  case("patcb|" + p, p)
}

# --- Dimension 28: borrowing handles ---------------------------------------
# `Box.inner()` returns a borrowing handle: parent closed/generation
# checks on every access (ClosedError, byte-identical), reads/writes
# through to the parent, escape keeps the parent alive, non-const bumps
# stale outstanding borrows, preserves_borrows doesn't, a throwing body
# reports at the call.
let brs = [
  '{ let b = __Foreign.Box.new(5); b.inner().value() }',
  '{ let b = __Foreign.Box.new(5); let c = b.inner(); c.add(3); (c.value(), b.peek()) }',
  '{ let b = __Foreign.Box.new(7); let c = b.inner(); b.drop(); c.value() }',
  '{ let b = __Foreign.Box.new(3); let c = b.inner(); b.reset(9); c.value() }',
  '{ let b = __Foreign.Box.new(3); let c = b.inner(); b.reset(9); b.inner().value() }',
  '{ let b = __Foreign.Box.new(4); let c = b.inner(); b.touch(); c.value() }',
  '{ let b = __Foreign.Box.new(4); let c = b.inner(); b.peek(); c.value() }',
  '{ let b = __Foreign.Box.new(6); let r = b.read_inner(); b.reset(1); r.value() }',
  '{ let b = __Foreign.Box.new(10); let c1 = b.inner(); let c2 = b.inner(); c1.add(5); c2.value() }',
  '{ let b = __Foreign.Box.new(1); let c = b.inner(); c.drop(); c.value() }',
  '{ let b = __Foreign.Box.new(1); let c = b.inner(); c.add("x") }',
  '{ let b = __Foreign.Box.new(8); b.slot(2) }',
  'mut c = nil; { let b = __Foreign.Box.new(2); c = b.inner() }; c.value()',
  '{ let b = __Foreign.Box.new(8); let c = b.inner(); c.label() }',
  '{ let b = __Foreign.Box.new(8); b.inner().clone().value() }',
  '{ let b = __Foreign.Box.new(1); let c = b.inner(); c.drop(); c.value() }',
]
for r in brs {
  case("borrow|" + r, r)
}

# --- Dimension 29: handle-method keyword arguments -------------------------
# A native-handle method binds keyword arguments by its param name like
# the interp's FunctionValue (the JIT used to reject all kwargs on handle
# methods — no param meta on the captureless thunk). Foreign/Box are
# generated; File is hand-written; both go through the same chokepoint.
let hkw = [
  '{ let c = __Foreign.Counter.new(5); c.add(n: 3); c.value() }',
  '{ let c = __Foreign.Counter.new(5); c.add(bad: 3) }',
  '{ let b = __Foreign.Box.new(5); b.reset(v: 9); b.peek() }',
  '{ let f = File.open("README.md", "r"); f.read(n: 4).size() }',
  '{ let f = File.open("README.md", "r"); f.read(size: 4) }',
  '{ let f = File.open("README.md", "r"); f.seek(offset: 10); f.tell() }',
  '{ let f = File.open("README.md", "r"); f.seek(offset: 4, whence: "set"); f.tell() }',
]
for h in hkw {
  case("handlekw|" + h, h)
}

# --- Dimension 30: File handle argument validation --------------------------
# The hand-written File thunks check arguments in binder order like the
# interp: missing required -> ArityError at the call site, wrong-typed
# param -> TypeError at the argument position, untyped-param body check
# ("expected X, got Y") at the call site. The JIT used to silently
# degrade all of these to the no-arg/default behavior.
let fck = [
  '{ let f = File.open("README.md", "r"); f.read("x") }',
  '{ let f = File.open("README.md", "r"); f.read(n: "x") }',
  '{ let f = File.open("README.md", "r"); f.read(true) }',
  '{ let f = File.open("README.md", "r"); f.read(nil).size() > 0 }',
  '{ let f = File.open("/dev/null", "w"); f.write(123) }',
  '{ let f = File.open("/dev/null", "w"); f.write("abcd"[1..3]) }',
  '{ let f = File.open("/dev/null", "w"); f.write() }',
  '{ let f = File.open("README.md", "r"); f.seek("x") }',
  '{ let f = File.open("README.md", "r"); f.seek() }',
  '{ let f = File.open("README.md", "r"); f.seek(0, 5) }',
  '{ let f = File.open("README.md", "r"); f.chunks("x") }',
  '{ let f = File.open("README.md", "r"); f.chunks() }',
]
for c in fck {
  case("filecheck|" + c, c)
}

# --- Dimension 31: recursive / forward-ref fn in nested scopes ---------------
# A captured name declared inside a nested statement list (block, if /
# while / for body, match arm, try / catch body) needs its cell before
# the closure that captures it is built. The JIT used to fail the whole
# compile with "cannot find free var" (interp was fine).
let nrec = [
  '{ fn h(n) { n > 0 ? h(n - 1) : 11 }; h(2) }',
  '{ let rec = fn (n) { n > 0 ? rec(n - 1) : 12 }; rec(2) }',
  '{ let a = fn () { b() }; let b = fn () { 13 }; a() }',
  'if true { fn h(n) { n > 0 ? h(n - 1) : 14 }; h(2) } else { nil }',
  '{ mut i = 0; mut r = 0; while i < 1 { fn h(n) { n > 0 ? h(n - 1) : 15 }; r = h(2); i = i + 1 }; r }',
  '{ mut r = 0; for i in [1] { fn h(n) { n > 0 ? h(n - 1) : 16 }; r = h(2) }; r }',
  'match 1 { Long => { fn h(n) { n > 0 ? h(n - 1) : 17 }; h(2) }, _ => nil }',
  'try { fn h(n) { n > 0 ? h(n - 1) : 18 }; h(2) } catch e { e.kind }',
  'try { throw "x" } catch e { fn h(n) { n > 0 ? h(n - 1) : 19 }; h(2) }',
  '{ mut rec = fn (n) { n > 0 ? rec(n - 1) : 20 }; rec(2) }',
  'if false { fn h(n) { n }; nil } else { nil }; h(2)',
  'if true { fn h(n) { n > 0 ? h(n - 1) : 21 }; h(2) } else { fn h(n) { n > 0 ? h(n - 1) : 22 }; h(2) }',
  'if false { fn h(n) { n > 0 ? h(n - 1) : 23 }; h(2) } else { fn h(n) { n > 0 ? h(n - 1) : 24 }; h(2) }',
  'fn h() { 25 }; { fn h() { 26 }; h() }',
  '{ fn h() { 27 }; nil }; fn h() { 28 }; h()',
]
for c in nrec {
  case("nestedfn|" + c, c)
}

# --- Dimension 32: Shared.new (immutable shared values, C4) -----------------
# Freeze + view reads + immutability + rejections must match across
# backends. Drop releases a registry ref (no user-visible side effect),
# so scope-exit timing differences cannot leak into the output.
let shv = [
  '{ let s = Shared.new({ a: 1, b: 2.5, c: "x", d: true, e: nil }); to_string(s.a) + to_string(s.b) + s.c + to_string(s.d) + to_string(s.e) }',
  '{ let s = Shared.new({ xs: [10, 20, 30] }); s.xs[1] + s.xs[-1] + s.xs.size() }',
  '{ let s = Shared.new({ v: { k: 7 } }); s.v["k"] + s["v"]["k"] }',
  '{ let s = Shared.new({ p: (1, "t") }); to_string(s.p[0]) + s.p[1] }',
  '{ let s = Shared.new({ m: { x: 1, y: 2 } }); s.m.keys().sorted_by(|k| k) }',
  '{ let s = Shared.new({ m: { x: 1, y: 2 } }); mut t = 0; for k, v in s.m { t = t + v }; t }',
  '{ let s = Shared.new([3, 4]); mut t = 0; for e in s { t = t + e }; t }',
  '{ let s = Shared.new({ m: { x: 1 } }); let c = s.m.copy(); c["xx"] = 9; to_string(c["xx"]) + to_string(s.m.has("xx")) }',
  '{ let s = Shared.new({ a: 1 }); s.a = 2 }',
  '{ let s = Shared.new([1]); s[0] = 2 }',
  '{ let s = Shared.new({ a: 1 }); s["a"] = 2 }',
  'Shared.new({ f: fn () { 1 } })',
  'Shared.new(5.iter)',
  '{ let s = Shared.new({ k: 1 }); s.drop(); s.k }',
  '{ let s = Shared.new({ k: 1 }); s.drop(); s.drop(); "twice-ok" }',
  '{ let s = Shared.new({ m: { z: 5 } }); let v = s.m; s.drop(); v.z }',
  '{ let s = Shared.new({ missing: 1 }); to_string(s.nothere) }',
  '{ let s = Shared.new({ a: 1 }); s["nope"] }',
  '{ let s = Shared.new([1, 2]); s[9] }',
  '{ let d = Shared.new({ n: 6 }); let w = Isolate.spawn(fn () { d.n * 7 }); w.join() }',
  '{ let d = Shared.new({ xs: [1, 2, 3] }); Parallel.map([0, 1, 2], fn (i) { d.xs[i] * 10 }) }',
  '{ let s = Shared.new({ xs: [1, 2] }); s.xs[1.5] }',
  '{ let s = Shared.new({ a: 1 }); s.get("a") }',
  '{ let s = Shared.new({ a: 1 }); s.get("a", 0) }',
  '{ let s = Shared.new({ a: 1 }); s.remove("a") }',
  '{ let s = Shared.new({ a: 1 }); s.remove("__sharedval_id__"); to_string(s.a) }',
  '{ let s = Shared.new({ a: 1 }); s.get_or_put("z", 9) }',
  '{ let s = Shared.new({ 1: "one", true: "yes", k: "z" }); to_string(s[1]) + to_string(s[true]) + s["k"] + to_string(s.size()) }',
  '{ let s = Shared.new({ 1: 10, 2: 20 }); mut t = 0; for k, v in s { t = t + v }; t }',
  '{ let s = Shared.new({ a: 1 }); let it = s.iter(); to_string(it.has_next()) }',
  '{ let s = Shared.new({ m: { z: 5 } }); let v = s.m; s.drop(); v.z }',
  '{ let fake = { __sharedval_id__: 9, __sharedval_node__: 0 }; to_string(fake.x) + to_string(fake["__sharedval_id__"]) }',
  '{ let v = Shared.new({ a: 1 }); to_string(try { Shared.new({ inner: v }) } catch e { e.kind }) + to_string(v.a) }',
]
for c in shv {
  case("sharedval|" + c, c)
}

# --- Dimension 33: operator -> trait method fallback ----------------------
# `==`/`!=` route through `eq(other)` and `<`/`<=`/`>`/`>=` through `cmp(other)`
# when no explicit `__eq__`/`__lt__` dunder is present. Explicit dunders win.
# Object pairs lacking both produce structural `==` / an ordering TypeError;
# kind/message/position must match across backends.
let optr = [
  # @derive(Eq, Comparable): operators must work over data fields
  '@derive(Eq, Comparable) class P { new(a, b) { self.a = a; self.b = b } }; to_string(P.new(1, 2) == P.new(1, 2)) + to_string(P.new(1, 2) == P.new(1, 3))',
  '@derive(Eq, Comparable) class P { new(a, b) { self.a = a; self.b = b } }; to_string(P.new(1, 2) != P.new(1, 3))',
  '@derive(Comparable) class P { new(a) { self.a = a } }; to_string(P.new(1) < P.new(2)) + to_string(P.new(2) < P.new(1))',
  '@derive(Comparable) class P { new(a) { self.a = a } }; to_string(P.new(1) <= P.new(1)) + to_string(P.new(2) >= P.new(1)) + to_string(P.new(2) > P.new(1))',
  # hand-written eq / cmp
  'class M { new(n) { self.n = n } eq(other) { self.n % 3 == other.n % 3 } }; to_string(M.new(1) == M.new(4)) + to_string(M.new(1) == M.new(2))',
  'class R { new(n) { self.n = n } cmp(other) { other.n - self.n } }; to_string(R.new(1) < R.new(2)) + to_string(R.new(2) < R.new(1))',
  # explicit dunder wins over the trait method
  'class T { new(n) { self.n = n } eq(other) { false } __eq__(other) { self.n == other.n } }; to_string(T.new(5) == T.new(5))',
  'class T { new(n) { self.n = n } cmp(other) { 0 } __lt__(other) { self.n < other.n } }; to_string(T.new(1) < T.new(2)) + to_string(T.new(2) < T.new(1))',
  # no eq / cmp: == is structural, ordering is a clean TypeError
  'class N { new(a) { self.a = a } }; to_string(N.new(1) == N.new(1)) + to_string(N.new(1) == N.new(2))',
  'class N { new(a) { self.a = a } }; N.new(1) < N.new(2)',
  'class N { new(a) { self.a = a } }; N.new(1) >= N.new(2)',
  # cmp returning a non-Long must not be coerced: falls through to TypeError
  'class B { new(a) { self.a = a } cmp(other) { "x" } }; B.new(1) < B.new(2)',
  # eq return is coerced via to_bool (Long/Float truthy), matching interp
  'class E { new(n) { self.n = n } eq(other) { self.n } }; to_string(E.new(5) == E.new(9)) + to_string(E.new(0) == E.new(9))',
  # non-coercible eq return throws with the operator position on both backends
  'class E { new(a) { self.a = a } eq(other) { "x" } }; E.new(1) == E.new(2)',
  'class E { new(a) { self.a = a } __eq__(other) { "x" } }; E.new(1) == E.new(2)',
  # operator equality and key equality agree (no divergence)
  '@derive(Eq, Hash) class P { new(a) { self.a = a } }; mut bag = {}; mut bag[P.new(7)] = "v"; bag[P.new(7)] + to_string(P.new(7) == P.new(7))']
for c in optr {
  case("optr|" + c, c)
}

# --- Dimension 34: function type annotations `fn(T) -> U` ------------------
# Structural callable match (params/return are documentation in the MVP):
# a closure or a `__call__` instance satisfies an `fn(...) -> R` param; a
# non-callable is a TypeError (kind/message/position must agree). Covers the
# optional-return `fn(A) -> B?` (function still required, nil rejected), a
# Union with a function alternative, and multifn dispatch fn-vs-concrete.
let fnty = [
  'fn ap(f: fn(Long) -> Long, x: Long) -> Long { f(x) }; ap(|n| n * 2, 21)',
  'fn cb(f: fn(Long, Long) -> Long, a, b) -> Long { f(a, b) }; cb(|a, b| a + b, 10, 32)',
  'fn ci(f: fn() -> String) -> String { f() }; ci(|| "hi")',
  'fn nf(f: fn(Long) -> Long) -> Long { f(1) }; nf(99)',
  'class D { new() {} __call__(n) { n * 2 } }; fn ap(f: fn(Long) -> Long, x) { f(x) }; ap(D.new(), 21)',
  'fn mk(n: Long) -> fn(Long) -> Long { |x| x + n }; let a = mk(5); a(37)',
  'fn ro(f: fn(Long) -> Long?) -> Long { let r = f(0); r ?? -1 }; ro(nil)',
  'fn ro(f: fn(Long) -> Long?) -> Long { let r = f(0); r ?? -1 }; ro(|n| nil)',
  'fn ro(f: fn(Long) -> Long?) -> Long { let r = f(0); r ?? -1 }; ro(|n| n + 42)',
  'fn fx(v: fn(Long) -> Long | Long) -> Long { match v { x: Long => x, _ => v(0) } }; to_string(fx(7)) + to_string(fx(|n| n + 100))',
  'fn ds(x: Long) -> String { "long" }; fn ds(f: fn(Long) -> Long) -> String { "fn" }; ds(5) + ds(|n| n)',
  'fn ds(x: Long) -> String { "long" }; fn ds(f: fn(Long) -> Long) -> String { "fn" }; class I { new() {} __call__(n) { n } }; ds(I.new())',
]
for c in fnty {
  case("fnty|" + c, c)
}

# --- Dimension 35: method multidispatch (class instance methods) ----------
# A class may declare same-named instance methods with distinct positional
# param-type signatures; `obj.m(args)` dispatches on the explicit arg types
# with `self` fixed by the lookup. Covers type/arity dispatch, `self` read in
# the picked overload (positional + kwarg call), default-param overloads,
# class-instance-typed dispatch, and the no-match DispatchError (kind +
# position must agree across backends). Single-method classes stay bare.
let mmd = [
  'class C { new(){} go(x: Long){"l"} go(x: String){"s"} }; C.new().go(1) + C.new().go("a")',
  'class C { new(){} go(x: Long){"one"} go(x: Long, y: Long){"two"} }; C.new().go(1) + C.new().go(1, 2)',
  'class B { new(n){self.n=n} add(x: Long){self.n+x} add(x: String){x.size()+self.n} }; to_string(B.new(10).add(5)) + to_string(B.new(10).add("abc"))',
  'class D { new(){} f(x: Long, y: Long = 100){x+y} f(x: String){x.size()} }; to_string(D.new().f(1)) + to_string(D.new().f(1,2)) + to_string(D.new().f("qq"))',
  'class S { new(){self.b=1000} h(x: Long, scale: Long = 2){self.b+x*scale} h(x: String){x.size()} }; to_string(S.new().h(5)) + to_string(S.new().h(5, scale: 10)) + to_string(S.new().h("hey"))',
  'class A { new(n){self.n=n} }; class Z { new(){} f(a: A){"a"} f(x: Long){"n"} }; Z.new().f(A.new("c")) + Z.new().f(7)',
  'class Z { new(){} f(x: Long){"n"} f(x: String){"s"} }; Z.new().f(1.5)',
  'class S { new(){} only(x){x*2} }; to_string(S.new().only(21))',
  'class T { new(){} __call__(n){n*2} }; class P { new(){} run(f: Function, x: Long){f(x)} run(x: Long){x} }; to_string(P.new().run(T.new(), 21)) + to_string(P.new().run(9))',
]
for c in mmd {
  case("mmd|" + c, c)
}

# --- Dimension 36: algebraic effects (thin slice) -------------------------
# `effect fn` / `perform` / `handle … with` lower, at parse time, onto
# synthesized computation classes + the `__Eff` runtime; both backends run
# the same lowered source, so a divergence would signal a transform/runtime
# asymmetry. Covers dynamic scope (perform inside a called effect fn),
# lexical perform, handler abort (no resume), an op argument, sequential
# performs, and resume-value flow-back. Bodies are single-line (statements
# `;`-separated) so `case` can wrap them in one thunk.
let eff = [
  'effect fn get(); effect fn c() { let x = perform get(); x * 2 }; handle { c() } with get(r) { r(21) }',
  'effect fn ask(); handle { let x = perform ask(); x + 1 } with ask(r) { r(10) }',
  'effect fn fail(); effect fn risky() { perform fail(); 99 }; handle { risky() } with fail(r) { -1 }',
  'effect fn emit(v); effect fn prod() { perform emit(1); perform emit(2); "done" }; mut seen = []; let c = handle { prod() } with emit(v, r) { seen.push(v); r(nil) }; to_string(seen) + c',
  'effect fn twice(n); effect fn dbl() { let y = perform twice(5); y + 100 }; handle { dbl() } with twice(n, r) { r(n * 2) }',
  # no handler for the performed op -> EffectError (same on both backends)
  'effect fn get(); handle { let x = perform get(); x } with other(r) { r(1) }',
  # A-normalization: perform nested in an expression is hoisted at parse
  # time, so both backends run the same lowered statement-level performs.
  'effect fn get(); effect fn c() { let x = perform get() + 1; x }; handle { c() } with get(r) { r(41) }',
  'effect fn get(); fn ad(a, b) { a + b }; effect fn c() { let y = ad(perform get(), 2); y }; handle { c() } with get(r) { r(40) }',
  'effect fn emit(v); effect fn c() { let z = perform emit(1) + perform emit(2); z }; mut s = []; let r = handle { c() } with emit(v, k) { s.push(v); k(v * 10) }; to_string(s) + to_string(r)',
  'effect fn wrap(v); effect fn c() { let w = perform wrap(perform wrap(1)); w }; handle { c() } with wrap(v, k) { k(v + 100) }',
  'effect fn get(); effect fn c() { return perform get() * 3 }; handle { c() } with get(r) { r(7) }',
  'effect fn get(); effect fn c() { let xs = [10, 20, 30]; let v = xs[perform get()]; v }; handle { c() } with get(r) { r(1) }',
  # control-flow bodies: a perform reachable through while / if / for / break /
  # continue / return lowers to the flat-dispatch CPS state machine; for-in is
  # desugared to while + iterator. The tail expression is the body's value.
  'effect fn ask(i); effect fn s(n) { mut t = 0; mut i = 0; while i < n { let a = perform ask(i); t = t + a; i = i + 1 }; t }; handle { s(3) } with ask(i, r) { r(i + 1) }',
  'effect fn ch(x); effect fn b(f) { if f == 0 { let a = perform ch(0); a } else if f == 1 { let z = perform ch(1); z * 2 } else { let c = perform ch(2); c + 100 } }; to_string(handle { b(0) } with ch(x, r) { r(x + 10) }) + "," + to_string(handle { b(1) } with ch(x, r) { r(x + 10) }) + "," + to_string(handle { b(2) } with ch(x, r) { r(x + 10) })',
  'effect fn each(); effect fn it(xs) { mut acc = []; for x in xs { let r = perform each(); acc.push(x + r) }; acc }; to_string(handle { it([10, 20, 30]) } with each(r) { r(1) })',
  'effect fn tick(); effect fn cnt(n) { mut i = 0; mut sum = 0; while true { if i >= n { break }; let v = perform tick(); if v == 0 { i = i + 1; continue }; sum = sum + v; i = i + 1 }; sum }; mut ts = [1, 0, 2, 3]; mut ti = 0; handle { cnt(4) } with tick(r) { let v = ts[ti]; ti = ti + 1; r(v) }',
  'effect fn probe(); effect fn find(n) { mut i = 0; while i < n { let h = perform probe(); if h { return i }; i = i + 1 }; -1 }; mut hs = [false, false, true]; mut pi = 0; handle { find(3) } with probe(r) { let h = hs[pi]; pi = pi + 1; r(h) }',
  # A-normalization inside a control-flow body (uniform with top level)
  'effect fn qty(); effect fn acc(n) { mut t = 0; mut i = 0; while i < n { t = t + perform qty() * 2; i = i + 1 }; t }; handle { acc(3) } with qty(r) { r(5) }',
  # a non-suspending loop in tail position runs verbatim (value nil); a
  # non-suspending tail `if` still yields its branch value
  'effect fn sd(); mut lg = []; effect fn f() { let r = perform sd(); for x in [1, 2] { lg.push(x + r) } }; to_string(handle { f() } with sd(k) { k(10) }) + "|" + to_string(lg)',
  'effect fn pk(); effect fn f() { let r = perform pk(); if r > 0 { "pos" } else { "neg" } }; to_string(handle { f() } with pk(k) { k(5) }) + "," + to_string(handle { f() } with pk(k) { k(-5) })',
  # nested handles: inner handled locally, a separate outer effect delegates up
  'effect fn ni(); effect fn no(); handle { let a = handle { perform ni() } with ni(r) { r(5) }; let b = perform no(); a + b } with no(r) { r(10) }',
  'effect fn na(); effect fn nb(); handle { handle { let x = perform na(); let y = perform nb(); x + y } with na(r) { r(1) } } with nb(r) { r(2) }',
  # multiple handler clauses (one `with` each) + optional `return` clause
  'effect fn g(); effect fn p(v); effect fn c() { let a = perform g(); perform p(a + 1); perform g() }; mut cell = 10; handle { c() } with g(r) { r(cell) } with p(v, r) { cell = v; r(nil) }',
  'effect fn ask(i); effect fn lg(m); effect fn dn(); effect fn s(n) { mut t = 0; mut i = 0; while i < n { let x = perform ask(i); perform lg(x); t = t + x; i = i + 1 }; perform dn(); t }; mut ls = []; let r = handle { s(3) } with ask(i, k) { k(i * 10) } with lg(m, k) { ls.push(m); k(nil) } with dn(k) { k(nil) }; to_string(r) + to_string(ls)',
  'effect fn ask(); handle { let x = perform ask(); x } with ask(r) { r(5) } with return(v) { v + 100 }',
  'effect fn fail(); handle { perform fail(); 99 } with fail(r) { -1 } with return(v) { v + 100 }',
  'effect fn q(i); effect fn nt(m); mut ns = []; let r = handle { mut t = 0; mut i = 0; while i < 3 { let x = perform q(i); perform nt(x); t = t + x; i = i + 1 }; t } with q(i, k) { k(i + 1) } with nt(m, k) { ns.push(m); k(nil) } with return(v) { { sum: v, count: ns.size() } }; to_string(r.sum) + "," + to_string(r.count) + to_string(ns)',
  # multi-shot resume: a handler may resume the same continuation N times. The
  # driver captures the whole delegate frame stack, so each fork re-runs the
  # enclosing computation (a return clause maps per fork, not the aggregate).
  'effect fn ch(a, b); effect fn c() { let x = perform ch(1, 2); x * 10 }; to_string(handle { c() } with ch(a, b, r) { [r(a), r(b)] })',
  'effect fn ch(a, b); effect fn c() { let x = perform ch(1, 2); let y = perform ch(10, 20); x + y }; to_string(handle { c() } with ch(a, b, r) { [r(a), r(b)] })',
  'effect fn ch(a, b); effect fn inr() { perform ch(1, 2) }; to_string(handle { let y = inr() * 10; y } with ch(a, b, r) { [r(a), r(b)] })',
  'effect fn ch(a, b); effect fn lg() { let acc = []; let x = perform ch(1, 2); acc.push(x); acc }; mut sn = []; handle { lg() } with ch(a, b, r) { sn.push(r(a)); sn.push(r(b)) }; to_string(sn[0])',
  'effect fn ch(a, b); effect fn idv() { perform ch(1, 2) }; to_string(handle { idv() } with ch(a, b, r) { [r(a), r(b)] } with return(v) { v + 100 })',
  # nested-handle capture: an inner handle's body / clauses reach an enclosing
  # binding through the enclosing instance (`_eff_outer` ctor arg / `_eff_self`
  # closure local), so both backends agree without leaning on lexical `self`.
  'effect fn o(); effect fn ic(); effect fn bd() { let base = perform o(); handle { base + perform ic() } with ic(k) { k(100) } }; to_string(handle { bd() } with o(k) { k(5) })',
  'effect fn o(); effect fn ic(); effect fn bd() { let base = perform o(); handle { perform ic() } with ic(k) { k(base) } }; to_string(handle { bd() } with o(k) { k(7) })',
  'effect fn o(); effect fn tk(); effect fn bd() { mut acc = 0; let r = handle { perform tk(); perform tk(); "d" } with tk(k) { acc = acc + 1; k(nil) }; to_string(acc) + r }; to_string(handle { bd() } with o(k) { k(nil) })',
  'effect fn o(); effect fn e1(); effect fn e2(); effect fn bd() { let base = perform o(); handle { let m = perform e1(); handle { base + m + perform e2() } with e2(k) { k(30) } } with e1(k) { k(200) } }; to_string(handle { bd() } with o(k) { k(1000) })',
  'effect fn o(); effect fn pk(x, y); effect fn bd() { let base = perform o(); handle { base + perform pk(1, 2) } with pk(x, y, k) { [k(x), k(y)] } }; to_string(handle { bd() } with o(k) { k(10) })',
  # `self.` inside a string is not a capture (AST-walk detection, not raw text)
  'effect fn ask(); to_string(handle { let msg = "p is self.foo"; let v = perform ask(); v + msg.size() } with ask(k) { k(3) })',
  # a local name as literal string text is not rewritten; interpolation is
  'effect fn a(); effect fn f() { let base = perform a(); let lit = "the base v"; "{base}-{lit}" }; handle { f() } with a(k) { k(2) }',
  # a block comment (its local name) is skipped, not rewritten
  'effect fn a(); effect fn f() { let base = perform a(); let y = /* just base */ base + 1; y }; to_string(handle { f() } with a(k) { k(10) })',
  # an effectful effect fn called with no driver raises EffectError
  'effect fn g(); effect fn f() { perform g() }; try { f() } catch e { e.kind }',
  # a named fn at statement level persists across a suspension (instance field)
  'effect fn a(); effect fn f() { fn h(n) { n * 2 }; let x = perform a(); h(x) }; handle { f() } with a(k) { k(5) }',
  # recursion through the field binding
  'effect fn a(); effect fn f() { let b = perform a(); fn r(n) { if n <= 1 { return b }; n * r(n - 1) }; r(4) }; handle { f() } with a(k) { k(1) }',
  # a nested named generator fn captures an effect local (effect body)
  'effect fn a(); effect fn f() { let x = perform a(); fn g(n) { yield n; yield n + x }; g(10).collect() }; to_string(handle { f() } with a(k) { k(5) })',
  # ... in a handle body
  'effect fn a(); to_string(handle { let x = perform a(); fn g(n) { yield n * x }; g(3).collect() } with a(k) { k(7) })',
  # ... in a handler clause
  'effect fn a(); to_string(handle { perform a() } with a(k) { fn g() { yield 1; yield 2 }; k(g().collect()) })',
  # multi-shot resume across a body defining a nested generator
  'effect fn c(); effect fn f() { let b = perform c(); fn g(n) { yield n; yield n + 1 }; g(b).collect() }; to_string(handle { f() } with c(k) { [k(10), k(20)] })',
  # a self-contained handle inside a generator body (fragment-registry slicing)
  'effect fn a(); fn g() { let v = handle { perform a() + 1 } with a(k) { k(10) }; yield v; yield v * 2 }; to_string(g().collect())',
  # ... in the yielded expression
  'effect fn a(); fn g() { yield handle { perform a() } with a(k) { k(5) }; yield 9 }; to_string(g().collect())',
  # ... capturing a generator local
  'effect fn a(); fn g(n) { let base = n * 10; let v = handle { base + perform a() } with a(k) { k(n) }; yield v }; to_string(g(3).collect())',
  # ... inside a yielding for-in loop
  'effect fn a(); fn g() { for i in [1, 2] { let v = handle { perform a() * i } with a(k) { k(100) }; yield v } }; to_string(g().collect())',
  # multi-shot resume inside a generator body handle
  'effect fn a(); fn g() { let r = handle { perform a() } with a(k) { [k(1), k(2)] }; yield r }; to_string(g().collect())',
  # --- dynamic perform: plain fns and effect fns interoperate freely -------
  # a perform in a plain fn dispatches off the dynamic handler stack (tail
  # clause = identity resume); an effect fn called from ordinary code drives
  # itself at the call site; abort clauses unwind natively to their handle.
  'effect fn ask(); fn g() { let n = perform ask(); "hi " + n }; handle { g() } with ask(r) { r("x") }',
  'effect fn get(); fn m() { perform get() + 1 }; effect fn o() { let a = perform get(); let b = m(); a + b }; handle { o() } with get(r) { r(10) }',
  'effect fn get(); effect fn tw() { let x = perform get(); x * 2 }; fn p() { tw() + 5 }; handle { p() } with get(r) { r(7) }',
  'effect fn get(); effect fn i() { perform get() + 1 }; effect fn o() { i() * 3 }; fn p() { o() }; handle { p() } with get(r) { r(2) }',
  'effect fn get(); fn s(x) { x * perform get() }; to_string(handle { [1, 2, 3].map(s) } with get(r) { r(10) })',
  'effect fn g(); let lam = fn() { perform g() * 2 }; handle { lam() } with g(k) { k(21) }',
  # abort from a plain fn: unwinds to the handle, invisible to try/catch,
  # defers still run, and the result bypasses the return clause
  'effect fn fl(m); fn r() { perform fl("n"); 99 }; handle { r() } with fl(m, k) { "a: " + m }',
  'effect fn fl(); fn r() { try { perform fl(); 1 } catch e { 2 } }; to_string(handle { r() } with fl(k) { -1 })',
  'effect fn fl(); mut lg = []; fn r() { defer { lg.push("d") }; perform fl(); 9 }; let x = handle { r() } with fl(k) { -1 }; to_string(x) + to_string(lg)',
  'effect fn fl(); fn r() { perform fl(); 9 }; handle { r() } with fl(k) { -1 } with return(v) { v + 100 }',
  # nested handles: the abort signal carries its handle token past inner ones
  'effect fn fl(m); effect fn tk(); fn d() { perform fl("s") }; handle { handle { d() } with tk(k) { k(nil) } } with fl(m, k) { "o: " + m }',
  # errors stay symmetric: no handler at all; full-control reached directly
  'effect fn np(); fn o() { perform np() }; try { o(); "no" } catch e { e.kind }',
  'effect fn ch(); fn w() { perform ch() }; try { handle { w() } with ch(r) { [r(1), r(2)] } } catch e { e.kind }',
  # a handler clause body re-performs to an outer handler (composition)
  'effect fn a(); effect fn l(s); mut lg = []; let r = handle { handle { (fn() { perform a() })() } with a(k) { perform l("x"); k(1) } } with l(s, k) { lg.push(s); k(nil) }; to_string(r) + to_string(lg)',
  # a bare perform in a generator body dispatches at .next() time
  'effect fn a(); fn g() { let v = perform a(); yield v; yield v * 2 }; to_string(handle { g().collect() } with a(k) { k(5) })',
  # a user global fn named like a __Eff builder method (_step / f / _drive)
  # must not be captured by the spliced captureless builder (scope barrier)
  'fn _step(x) { x + 100 }; effect fn cg(); effect fn cb() { let v = perform cg(); v * 2 }; to_string(handle { cb() } with cg(r) { r(21) }) + "," + to_string(_step(5))',
  'fn f(x) { x - 1 }; effect fn g2(); fn u() { perform g2() }; to_string(handle { u() } with g2(r) { r(7) }) + "," + to_string(f(10))',
  # `throw` as a terminal statement in an effect / handle body: it lowers to a
  # verbatim throw state and unwinds through the driver to the nearest try/catch.
  'effect fn ask(); effect fn b() { let x = perform ask(); throw "boom" }; try { handle { b() } with ask(r) { r(1) } } catch e { "caught:" + e }',
  'effect fn ask(); try { handle { let x = perform ask(); throw "hb" } with ask(r) { r(7) } } catch e { "caught:" + e }',
  'effect fn ask(); effect fn b() { let x = perform ask(); throw "mid"; x + 1 }; try { handle { b() } with ask(r) { r(1) } } catch e { e }',
  'effect fn ask(); effect fn b(f) { let x = perform ask(); if f { throw "hit" } else { x } }; to_string(handle { b(false) } with ask(r) { r(9) }) + "," + to_string(try { handle { b(true) } with ask(r) { r(9) } } catch e { e })',
  'effect fn ask(); effect fn b() { let x = perform ask(); throw "boom" }; fn g() { yield try { handle { b() } with ask(r) { r(0) } } catch e { "g:" + e } }; to_string(g().collect())',
  # top-level `defer` registers into the computation and runs LIFO at body
  # completion or on a throw unwinding out of it (not early at a suspension).
  'effect fn a(); mut lg = []; effect fn b() { defer { lg.push("d") }; let x = perform a(); lg.push("e"); x }; let r = handle { b() } with a(k) { k(1) }; to_string(lg) + to_string(r)',
  'effect fn a(); mut lg = []; effect fn b() { defer { lg.push("d1") }; let x = perform a(); defer { lg.push("d2") }; lg.push("e"); x }; handle { b() } with a(k) { k(1) }; to_string(lg)',
  'effect fn a(); mut lg = []; effect fn b() { defer { lg.push("d") }; let x = perform a(); throw "x" }; let r = try { handle { b() } with a(k) { k(1) } } catch e { lg.push("c"); e }; to_string(lg) + r',
  'effect fn a(); mut lg = []; fn boom() { throw "x" }; effect fn b() { defer { lg.push("d") }; let v = perform a(); boom(); v }; let r = try { handle { b() } with a(k) { k(1) } } catch e { "caught:" + e }; to_string(lg) + r',
  'effect fn ch(a, b); mut lg = []; effect fn c() { defer { lg.push("d") }; let x = perform ch(1, 2); x * 10 }; let r = handle { c() } with ch(a, b, k) { [k(a), k(b)] }; to_string(r) + to_string(lg)',
  # abort (handler never resumes): the driver runs the abandoned body's reached
  # defers; a defer after the aborting perform was never reached.
  'effect fn fail(); mut lg = []; effect fn b() { defer { lg.push("r") }; perform fail(); defer { lg.push("u") }; 99 }; let r = handle { b() } with fail(k) { "ab" }; r + to_string(lg)',
  'effect fn fail(); mut lg = []; effect fn inr() { defer { lg.push("i") }; perform fail(); 0 }; effect fn ot() { defer { lg.push("o") }; inr(); 0 }; let r = handle { ot() } with fail(k) { "ab" }; r + to_string(lg)',
  # an escaping continuation (resume saved, called after the handle returns) must
  # not finalize early: the defers run when the resumed fork completes.
  'effect fn a(); mut lg = []; mut sv = nil; effect fn b() { defer { lg.push("pre") }; let x = perform a(); lg.push("res"); defer { lg.push("post") }; x + 1 }; let r = handle { b() } with a(k) { sv = k; "p" }; lg.push("h:" + r); let r2 = sv(9); to_string(lg) + to_string(r2)']
for c in eff {
  case("eff|" + c, c)
}

# --- Dimension: range step (`a..b by n`) ------------------------------------
# Ascending/descending/inclusive/exclusive, display (`by n` suffix, and its
# absence for step 1), and the step == 0 error.
#
# Both backends compile `for <ident> in a..b [by s]` to a counter loop
# instead of building a range object and a heap iterator, but they decide on
# different evidence: the JIT fuses the range *literal* (compile_for), the
# interpreter fuses any range *value* (eval_for). A range reaching the loop
# through a variable therefore takes the fused path on one backend and the
# generic iterator on the other — the cases below pin the two together,
# along with the boundaries the fused loop has to reproduce: an empty span,
# a descending inclusive end, a runtime step (zero included), and the
# loop-control paths (break / nobreak / defer / closure capture / generator,
# plus a pattern binding, which stays generic everywhere).
let rangestep = [
  '(0..10 by 2).iter().collect()',
  '(0..=10 by 2).iter().collect()',
  '(10..0 by -2).iter().collect()',
  '(10..=0 by -2).iter().collect()',
  '(0..10 by 2).iter().chunks(2).collect()',
  'mut t = 0; for i in 0..10 by 3 { t = t + i }; t',
  'to_string(0..10 by 2)',
  'to_string(0..10)',
  'try { (0..10 by 0).iter().collect() } catch e { e.kind }',
  'try { for i in 0..10 by 0 { i } } catch e { e.kind }',
  'let r = 0..10 by 4; mut o = []; for i in r { o.push(i) }; to_string(o)',
  'let r = 0..; try { for i in r { } } catch e { e.kind + ":" + e.message }',
  'let s = 3; mut o = []; for i in 0..10 by s { o.push(i) }; to_string(o)',
  'let s = 0; try { for i in 0..10 by s { } } catch e { e.kind + ":" + e.message }',
  'let n = 3; let b = 4; mut o = []; for i in 0..=(n - b) by b { o.push(i) }; to_string(o)',
  'mut o = []; for i in -1..=0 by -1 { o.push(i) }; to_string(o)',
  'mut o = []; for i in 3..=0 by -1 { o.push(i) }; to_string(o)',
  'mut o = []; for i in 0..20 by 3 { if i == 9 { break }; o.push(i) }; to_string(o)',
  'mut o = []; for i in 0..6 by 2 { o.push(i) } nobreak { o.push(99) }; to_string(o)',
  'mut o = []; for i in 0..6 by 2 { defer { o.push(-i) }; o.push(i) }; to_string(o)',
  'mut o = []; mut fs = []; for i in 0..6 by 2 { fs.push(fn () { i }) }; for f in fs { o.push(f()) }; to_string(o)',
  'fn g() { for i in 0..6 by 2 { yield i * i } }; to_string(g().collect())',
  'try { for (a, b) in 0..3 by 1 { } } catch e { e.kind }',
  'mut o = []; for i in 0..7 by 2 { for j in i..=0 by -3 { o.push(i * 10 + j) } }; to_string(o)',
  'let lo = 2; let hi = 9; mut o = []; for i in lo..hi by (hi - lo) { o.push(i) }; to_string(o)',
]
for c in rangestep {
  case("rangestep|" + c, c)
}

# --- Dimension: constructor multidispatch (`new` overloads) ----------------
# A class may declare several `new` bodies with distinct positional
# param-type signatures; `C(args)` / `C.new(args)` dispatches on the explicit
# arg types, picked BEFORE any instance is built (a dispatch miss runs no
# field initializer). Covers type/arity dispatch, default-param and kwarg
# overloads, class-instance-typed dispatch, the no-match DispatchError (kind +
# position must agree), `self` immutability inside every overload, field-init
# running once per successful construction, and the first-class `C.new` value.
let cmd = [
  'class C { new(x: Long){self.t="l"} new(x: String){self.t="s"} }; C(1).t + C("a").t',
  'class C { new(x: Long){self.t="one"} new(x: Long, y: Long){self.t="two"} }; C(1).t + C(1,2).t',
  'class B { new(x: Long){self.v=x} new(x: String){self.v=x.size()} }; to_string(B(5).v) + to_string(B("abc").v)',
  'class D { new(v: Long = 100){self.v=v} new(a: Long, b: Long){self.v=a+b} }; to_string(D().v) + to_string(D(5).v) + to_string(D(5,6).v)',
  'class V { new(x: Long, y: Long){self.s=x+y} new(s: String){self.s=s.size()} }; to_string(V(x: 8, y: 9).s)',
  'class A { new(n){self.n=n} }; class W { new(a: A){self.k="a"} new(x: Long){self.k="n"} }; W(A.new("c")).k + W(7).k',
  'class W { new(x: Long){self.x=x} new(x: String){self.x=x.size()} }; try { W(1.5) } catch e { e.kind }',
  'class I { new(x: Long){self=5} new(x: String){self.x=x} }; try { I(1) } catch e { e.kind }',
  'class F { base: Long = 7  new(x: Long){self.x=x} new(s: String){self.x=s.size()} }; to_string(F(3).base) + to_string(F("ab").base)',
  'class S { new(x){self.x=x} }; to_string(S(9).x)',
  'class P { new(x: Long, y: Long){self.p=x*10+y} new(s: String){self.p=s.size()} }; let mk = P.new; to_string(mk(2,3).p) + to_string(mk("hi").p)',
]
for c in cmd {
  case("cmd|" + c, c)
}

# --- Dimension: dunder / operator multidispatch --------------------------
# Operator methods (`__add__`, `__eq__`, `__index__`, `__call__`, …) are
# ordinary instance methods reached through the operator-lookup path, so
# several with distinct positional-param-type signatures merge into one
# dispatcher; the operator picks the overload on the operand's runtime type.
# Covers type dispatch, commutative auto-reflection, subscript/call dunders,
# the no-match DispatchError (kind + position must agree), and single-dunder
# (bare method) staying unaffected.
let dmd = [
  'class V { new(x: Long){self.x=x} __add__(o: V){V(self.x+o.x)} __add__(n: Long){V(self.x+n)} }; to_string((V(1)+V(2)).x) + to_string((V(1)+5).x)',
  'class V { new(x: Long){self.x=x} __add__(o: V){V(self.x+o.x)} __add__(n: Long){V(self.x+n)} }; to_string((5+V(10)).x)',
  'class V { new(x: Long){self.x=x} __add__(o: V){V(self.x+o.x)} __add__(n: Long){V(self.x+n)} }; try { V(1)+"s" } catch e { e.kind }',
  'class N { new(n: Long){self.n=n} __eq__(o: N){self.n==o.n} __eq__(k: Long){self.n==k} }; to_string(N(7)==N(7)) + to_string(N(7)==7) + to_string(N(7)==8)',
  'class N { new(n: Long){self.n=n} __lt__(o: N){self.n<o.n} __lt__(k: Long){self.n<k} }; to_string(N(3)<N(5)) + to_string(N(3)<2)',
  'class G { new(){self.d=[10,20,30]} __index__(i: Long){self.d[i]} __index__(s: String){"k:"+s} }; to_string(G()[1]) + G()["a"]',
  'class M { new(v: Long){self.v=v} __mul__(n: Long){M(self.v*n)} __mul__(o: M){M(self.v*o.v)} }; to_string((M(3)*4).v) + to_string((M(3)*M(5)).v)',
  'class F { new(){} __call__(n: Long){"l:"+to_string(n)} __call__(s: String){"s:"+s} }; F()(3) + F()("x")',
  'class F { new(){} __call__(n: Long){n} __call__(s: String){s.size()} }; try { F()(1.5) } catch e { e.kind }',
  'class S { new(n: Long){self.n=n} __add__(o){self.n+o.n} }; to_string(S(3)+S(4))',
]
for c in dmd {
  case("dmd|" + c, c)
}

# --- Dimension: `self` without a receiver ---------------------------------
# `self` exists only when the call supplied a receiver, so a plain `f(x)`
# leaves it unbound — the JIT hands every frame a receiver ABI slot and used
# to let a receiver-less body read it silently. Covers the throw (kind,
# message and bare position), each call shape that reaches a body with no
# receiver (fn / lambda / multifn / runtime callback / top level), the branch
# that never reads it (the check is on read, not on entry), and the receiver
# paths that must keep seeing one (object property, method, ctor, static).
let selfcases = [
  'let f = fn (x) { self }; f(1)',
  'let f = fn (x) { self }; try { f(1) } catch e { e.kind + "|" + e.message }',
  'try { (|x| self)(1) } catch e { e.kind + "|" + e.message }',
  'fn top() { self }; try { top() } catch e { e.kind + "|" + e.message }',
  'try { [1].map(fn (x) { self }) } catch e { e.kind + "|" + e.message }',
  'try { self } catch e { e.kind + "|" + e.message }',
  'let f = fn (x) { if x > 0 { "ok" } else { self } }; f(1)',
  'let f = fn (x) { if x > 0 { "ok" } else { self } }; try { f(0) } catch e { e.kind }',
  'let f = fn (x: Long = 1) { self }; try { f(x: 5) } catch e { e.kind + "|" + e.message }',
  'let o = { x: 42, f: fn () { self.x } }; to_string(o.f())',
  'class C { new(v: Long){self.v=v} m() { self.v } }; to_string(C(5).m())',
  'class C { new(v: Long){self.v=v} static mk() { to_string(self) != "" } }; to_string(C.mk())',
  'trait T { cur() -> Long  nxt() -> Long { self.cur() + 1 } }; class Z { new(){} cur() { 4 } }; to_string(Z.new().nxt())',
]
for c in selfcases {
  case("self|" + c, c)
}

# --- Dimension: Canvas rasterization (Float coords / shapes / blit_scaled) ----
# The framebuffer prims take `Long|Float` geometry and round a Float in one
# shared place (canvas.h coord(), toward -inf); the shape fills and blit_scaled
# rasterize with integer-only arithmetic. All three must produce the identical
# shape on every backend, so each case draws and dumps the whole framebuffer.
# The coordinate sweep runs fractional, negative, non-finite and out-of-range
# values through every prim, which pins the rounding, the clipping and the type
# errors (colour/flags/handle stay Long-only) in one place.
let cvcoords = [
  '0',
  '1',
  '2.0',
  '1.5',
  '-0.5',
  '-1.5',
  '2.75',
  '4.5',
  'Math.nan',
  'Math.inf',
  '-Math.inf',
  '1e30',
  '"x"',
  'nil',
  'true',
]
let cvinit = '_Canvas.init(6, 4); _Canvas.clear(0); '
let cvsprite = '_Canvas.sprite_load([_CA+1, _CA+2, _CA+3, _CA+4], 2, 2)'
for c in cvcoords {
  case(
    "cvrect|" + c,
    cvinit + '_Canvas.rect(' + c + ', 0, 3, 2, _CA+5, 1); _cdump()',
  )
  case(
    "cvpix|" + c,
    cvinit + '_Canvas.set_pixel(' + c + ', 1, _CA+5); _cdump()',
  )
  case(
    "cvget|" + c,
    '_Canvas.init(6, 4); _Canvas.clear(_CA+7); to_string(_Canvas.get_pixel(' +
      c +
      ', 0))',
  )
  case(
    "cvtri|" + c,
    cvinit + '_Canvas.triangle(' + c + ', 0, 5, 0, 0, 3, _CA+5, 1); _cdump()',
  )
  case(
    "cvpolyv|" + c,
    cvinit +
      '_Canvas.polygon([1, 0, 5, 0, ' +
      c +
      ', 3, 0, 3], _CA+5, 1); _cdump()',
  )
  case(
    "cvblit|" + c,
    cvinit +
      '_Canvas.blit(' +
      cvsprite +
      ', ' +
      c +
      ', 0, 0, 0, 2, 2, 0); _cdump()',
  )
  case(
    "cvbsd|" + c,
    cvinit +
      '_Canvas.blit_scaled(' +
      cvsprite +
      ', ' +
      c +
      ', 0, 4, 4, 0, 0, 2, 2, 0, 255); _cdump()',
  )
  case(
    "cvbss|" + c,
    cvinit +
      '_Canvas.blit_scaled(' +
      cvsprite +
      ', 0, 0, 4, 4, 0, 0, ' +
      c +
      ', 2, 0, 255); _cdump()',
  )
  case(
    "cvcolor|" + c,
    cvinit + '_Canvas.rect(0, 0, 2, 2, ' + c + ', 1); _cdump()',
  )
  case(
    "cvglyph|" + c,
    cvinit + '_Canvas.glyph(_CFONT, 0, ' + c + ', 0, _CA+5, 1); _cdump()',
  )
  case(
    "cvglyphi|" + c,
    cvinit + '_Canvas.glyph(_CFONT, ' + c + ', 0, 0, _CA+5, 1); _cdump()',
  )
}
# music: the format sniff (MP3 frame sync / ID3 / OggS) and its ValueError run
# before any backend branch, so message and position must match everywhere; the
# controls are unloaded no-ops under the corpus's headless backend. Sniffable
# headers with garbage after them pass the sniff and fail the decoder silently.
for d in ['"x"', '""', '"RIFF...."', '"\xff\x00abcd"', '"\xff\xfbjunk"', '"\xff\xe3junk"', '"ID3 junk"', '"OggS junk"', '42', 'nil'] {
  case(
    "cvmusic|" + d,
    '_Canvas.music_play(' + d + ', 1, 100, 0); _Canvas.music_playing()',
  )
}
for c in cvcoords {
  case(
    "cvmusicstart|" + c,
    '_Canvas.music_play("\xff\xfbok", 1, 100, ' + c + '); "ok"',
  )
  case(
    "cvmusicseek|" + c,
    '_Canvas.music_seek(' + c + '); _Canvas.music_playing()',
  )
}
case(
  "cvmusic|noop",
  '_Canvas.music_stop(); _Canvas.music_pause(); _Canvas.music_resume(); _Canvas.music_volume(55); _Canvas.music_playing()',
)

# font_load / glyph: an unknown handle, a negative index and an index past the
# table must all draw nothing rather than read out of bounds. The two huge
# indices are the ones where `index * 8` wraps a 64-bit product, so a bound
# computed from that product would let them through.
for g in ['999, 0', '_CFONT, -1', '_CFONT, 2', '_CFONT, 99999', '_CFONT, 2305843009213693951', '_CFONT, 2305843009213693952', '_CFONT, 9223372036854775807', '_Canvas.font_load([]), 0', '_Canvas.font_load([1, 2]), 0'] {
  case(
    "cvglyphoob|" + g,
    cvinit + '_Canvas.glyph(' + g + ', 0, 0, _CA+5, 1); _cdump()',
  )
}
# Degenerate and inverted extents: a non-positive height/width draws nothing
# rather than wrapping, and shapes that share an edge tile with no seam and no
# double-drawn row.
let cvshapes = [
  '_Canvas.triangle(0, 0, 6, 0, 0, 4, _CA+5, 1)',
  '_Canvas.triangle(0, 0, 6, 0, 6, 0, _CA+5, 1)',
  '_Canvas.triangle(2, 2, 2, 2, 2, 2, _CA+5, 1)',
  '_Canvas.triangle(-3, -2, 9, -2, 3, 7, _CA+5, 1)',
  '_Canvas.triangle(0, 0, 6, 0, 0, 4, _CA+5, 1); _Canvas.triangle(6, 0, 6, 4, 0, 4, _CA+6, 1)',
  '_Canvas.polygon([], _CA+5, 1)',
  '_Canvas.polygon([1, 1], _CA+5, 1)',
  '_Canvas.polygon([1, 1, 4, 4], _CA+5, 1)',
  '_Canvas.polygon([1, 1, 4, 1, 4], _CA+5, 1)',
  '_Canvas.polygon([0, 0, 6, 0, 6, 4, 4, 4, 4, 1, 2, 1, 2, 4, 0, 4], _CA+5, 1)',
  '_Canvas.polygon([2, 0, 5, 0, 6, 2, 1, 2], _CA+5, 1); _Canvas.polygon([1, 2, 6, 2, 6, 4, 0, 4], _CA+6, 1)',
  '_Canvas.blit_scaled(' + cvsprite + ', 0, 0, 0, 4, 0, 0, 2, 2, 0, 255)',
  '_Canvas.blit_scaled(' + cvsprite + ', 0, 0, 4, 4, 0, 0, 2, 0, 0, 255)',
  '_Canvas.blit_scaled(' + cvsprite + ', -1, -1, 8, 8, 0, 0, 2, 2, 0, 255)',
  '_Canvas.blit_scaled(999, 0, 0, 4, 4, 0, 0, 2, 2, 0, 255)',
  '_Canvas.blit_scaled(' + cvsprite + ', 0, 0, 6, 4, 0, 0, 2, 2, 8, 255)',
  '_Canvas.blit_scaled(' + cvsprite + ', 0, 0, 1, 1, 0, 0, 2, 2, 8, 255)',
]
for s in cvshapes {
  case("cvshape|" + s, cvinit + s + '; _cdump()')
}
# `points` itself must be an Array — the element sweep above covers what may be
# inside one.
for p in ['5', '1.5', 'nil', '"xy"', '{a: 1}', '(1, 2)'] {
  case(
    "cvpolyarg|" + p,
    cvinit + '_Canvas.polygon(' + p + ', _CA+5, 1); _cdump()',
  )
}
# line / ellipse: the same coordinate sweep through the new prims (rounding,
# clipping, type errors), then shape-specific degenerates — reversed endpoints
# draw the same pixels, outlines leave the interior, non-positive radii/scales
# draw nothing, and a doubled glyph doubles.
for c in cvcoords {
  case(
    "cvline|" + c,
    cvinit + '_Canvas.line(' + c + ', 0, 5, 3, _CA+5); _cdump()',
  )
  case(
    "cvellip|" + c,
    cvinit + '_Canvas.ellipse(3, 2, ' + c + ', 2, _CA+5, 1); _cdump()',
  )
}
let cvnew = [
  '_Canvas.line(5, 3, 0, 0, _CA+5); _Canvas.line(0, 0, 5, 3, _CA+6)',
  '_Canvas.line(2, 2, 2, 2, _CA+5)',
  '_Canvas.line(-4, 1, 9, 2, _CA+5)',
  '_Canvas.rect(1, 0, 4, 3, _CA+5, 0)',
  '_Canvas.rect(1, 0, 1, 3, _CA+5, 0)',
  '_Canvas.rect(1, 0, 4, 2, _CA+5, 0)',
  '_Canvas.ellipse(3, 2, 2, 2, _CA+5, 0)',
  '_Canvas.ellipse(3, 2, 2, 2, _CA+5, 1)',
  '_Canvas.ellipse(3, 2, -1, 2, _CA+5, 1)',
  '_Canvas.ellipse(3, 2, 8, 0, _CA+5, 1)',
  '_Canvas.ellipse(3, 2, 0, 8, _CA+5, 1)',
  '_Canvas.triangle(0, 0, 5, 0, 0, 3, _CA+5, 0)',
  '_Canvas.polygon([1, 0, 5, 0, 3, 3], _CA+5, 0)',
  '_Canvas.glyph(_CFONT, 1, 0, 0, _CA+5, 2)',
  '_Canvas.glyph(_CFONT, 0, 0, 0, _CA+5, 0)',
  '_Canvas.glyph(_CFONT, 1, -3, -3, _CA+5, 3)',
]
for s in cvnew {
  case("cvnew|" + s, cvinit + s + '; _cdump()')
}
# Shape-colour alpha composites on every drawing call (integer source-over);
# raw pixel values in the record so the blended channels are pinned exactly.
for al in ['0', '1', '128', '255'] {
  case(
    "cvshapealpha|" + al,
    '_Canvas.init(3, 1); _Canvas.clear(_CA+9); ' +
      '_Canvas.rect(0, 0, 2, 1, 12345 + ' +
      al +
      ' * 16777216, 1); ' +
      'to_string(_Canvas.get_pixel(0, 0)) + "," + to_string(_Canvas.get_pixel(2, 0))',
  )
}
# Offscreen target: draw_to semantics at the prim level — width/height/get
# follow the target, the framebuffer is untouched until the blit back, a
# self-blit and freeing the live target both raise, and a stale handle
# resolves to nothing after free.
case(
  "cvtarget|roundtrip",
  '_Canvas.init(4, 2); _Canvas.clear(_CA+1); ' +
    'let s = _Canvas.sprite_blank(2, 2, _CA+2); let prev = _Canvas.target(s); ' +
    'let inw = _Canvas.width(); _Canvas.set_pixel(0, 0, _CA+3); ' +
    'let inp = _Canvas.get_pixel(0, 0); _Canvas.target(prev); ' +
    '_Canvas.blit(s, 0, 0, 0, 0, 2, 2, 0); ' +
    'to_string(inw) + ":" + to_string(inp % 10) + ":" + _cdump()',
)
case(
  "cvtarget|selfblit",
  '_Canvas.init(4, 2); let s = _Canvas.sprite_blank(2, 2, _CA+2); ' +
    '_Canvas.target(s); _Canvas.blit(s, 0, 0, 0, 0, 2, 2, 0)',
)
case(
  "cvtarget|freetarget",
  '_Canvas.init(4, 2); let s = _Canvas.sprite_blank(2, 2, _CA+2); ' +
    '_Canvas.target(s); _Canvas.sprite_free(s)',
)
case(
  "cvtarget|stale",
  '_Canvas.init(4, 2); let s = _Canvas.sprite_blank(2, 2, _CA+2); ' +
    '_Canvas.sprite_free(s); to_string(_Canvas.sprite_width(s)) + ":" + ' +
    'to_string(_Canvas.sprite_height(s))',
)
case(
  "cvtarget|deadhandle",
  '_Canvas.init(4, 2); let s = _Canvas.sprite_blank(2, 2, _CA+2); ' +
    '_Canvas.sprite_free(s); _Canvas.target(s)',
)
case("cvtarget|blank_neg", '_Canvas.sprite_blank(-1, -1, _CA+2)')
# flags x alpha: the flip / box-average bits, and the integer compositing rule
# read back over a filled buffer so the blended channels show up in the dump.
for f in ['0', '1', '2', '3', '8', '9', '4', '16', '-1'] {
  case(
    "cvflags|" + f,
    cvinit +
      '_Canvas.blit_scaled(' +
      cvsprite +
      ', 0, 0, 4, 4, 0, 0, 2, 2, ' +
      f +
      ', 255); _cdump()',
  )
}
# PNG decoding: every accepted colour type must land on the same packed-RGBA
# layout, and every rejection must be the one shared ValueError. The `_PNG_*`
# fixtures live in the preamble.
let cvpngs = [
  '_PNG_RGBA',
  '_PNG_RGB',
  '_PNG_GREY',
  '_PNG_GREYA',
  '_PNG_PAL',
  '_PNG_I16',
  '_PNG_TRUNCATED',
  '""',
  '"0102030405"',
  '5',
  'nil',
  '[1, 2]',
]
for p in cvpngs {
  case(
    "cvpng|" + p,
    'let id = _Canvas.sprite_from_png(' +
      p +
      '); let w = _Canvas.sprite_width(id); let h = _Canvas.sprite_height(id); _Canvas.init(w, h); _Canvas.clear(0); _Canvas.blit(id, 0, 0, 0, 0, w, h, 0); to_string(w) + "x" + to_string(h) + ":" + to_string(_Canvas.get_pixel(0, 0)) + "," + to_string(_Canvas.get_pixel(w - 1, h - 1))',
  )
}
# PNG encoding: the round trip has to reproduce the pixels, and the two
# rejections (stale handle, empty target) have to be the shared ValueError.
for p in ['_PNG_RGBA', '_PNG_RGB', '_PNG_GREY', '_PNG_PAL'] {
  case(
    "cvtopng|" + p,
    'let a = _Canvas.sprite_from_png(' +
      p +
      '); let b = _Canvas.sprite_from_png(_Canvas.sprite_to_png(a)); let w = _Canvas.sprite_width(b); let h = _Canvas.sprite_height(b); _Canvas.init(w, h); _Canvas.clear(0); _Canvas.blit(b, 0, 0, 0, 0, w, h, 0); to_string(w) + "x" + to_string(h) + ":" + to_string(_Canvas.get_pixel(0, 0)) + "," + to_string(_Canvas.get_pixel(w - 1, h - 1))',
  )
}
for id in ['0', '9999', '-1', 'nil', '"x"'] {
  case(
    "cvtopngerr|" + id,
    '_Canvas.init(2, 1); _Canvas.clear(_CA+9); _Canvas.sprite_to_png(' +
      id +
      ').size()',
  )
}
case("cvtopng|empty", '_Canvas.init(0, 0); _Canvas.sprite_to_png(0).size()')
case(
  "cvtopng|target",
  '_Canvas.init(4, 4); _Canvas.clear(_CA+1); let s = _Canvas.sprite_blank(2, 3, _CA+2); _Canvas.target(s); let inner = _Canvas.sprite_to_png(0).size(); _Canvas.target(0); [inner > 0, _Canvas.sprite_to_png(0).size() > 0]',
)

for al in ['0', '1', '64', '128', '191', '254', '255', '256', '-1', '1.5', '"x"'] {
  case(
    "cvalpha|" + al,
    '_Canvas.init(2, 1); _Canvas.clear(_CA+9); _Canvas.blit_scaled(' +
      cvsprite +
      ', 0, 0, 2, 1, 0, 0, 2, 1, 0, ' +
      al +
      '); to_string(_Canvas.get_pixel(0, 0)) + "," + to_string(_Canvas.get_pixel(1, 0))',
  )
}

# Compress.deflate: an optional trailing param (level) with a default, decoded
# by the existing Compress.gunzip (no separate inflate). Every call shape
# (direct, keyword, as-value, HOF) is generated because this is exactly the
# combination that once diverged — a namespace method whose adapter reads a
# second positional needs registering with the JIT's kwarg-slab dispatch, or
# every non-single-arg call form throws an ArityError while interp accepts it.
let deflate_data = '"the quick brown fox the quick brown fox"'
for lv in ['-1', '0', '1', '9', '99', '"x"'] {
  case(
    "cfdeflvl|" + lv,
    'let z = Compress.deflate(' +
      deflate_data +
      ', ' +
      lv +
      '); Compress.gunzip(z) == ' +
      deflate_data,
  )
  case(
    "cfdeflvlkw|" + lv,
    'let z = Compress.deflate(' +
      deflate_data +
      ', level: ' +
      lv +
      '); Compress.gunzip(z) == ' +
      deflate_data,
  )
}
case(
  "cfdefdefault",
  'Compress.gunzip(Compress.deflate(' + deflate_data + ')) == ' + deflate_data,
)
case(
  "cfdefvalue",
  'let f = Compress.deflate; Compress.gunzip(f(' +
    deflate_data +
    ', 9)) == ' +
    deflate_data,
)
case(
  "cfdefbare",
  'let c = Compress; Compress.gunzip(c.deflate(' +
    deflate_data +
    ', 9)) == ' +
    deflate_data,
)
case(
  "cfdefhof",
  '[' +
    deflate_data +
    '].map(|d| Compress.gunzip(Compress.deflate(d, 9)) == d)',
)
case("cfdefbaddata", 'Compress.deflate(5, 9)')
case("cfdeftoomany", 'Compress.deflate(' + deflate_data + ', 1, 2)')

# --- Dimension: iterator protocol contract --------------------------------
# `iter` / `has_next` / `next` must each hold a 0-arg Function, and opening an
# iterator validates the pair before anything drives it. Both seams used to
# diverge badly: a non-Function `has_next` was cast to a closure and called
# (JIT/AOT segfault) while the interp raised a plain type error, a 1-arg
# `has_next` looped forever on the interp but raised ArityError on the JIT,
# and the for-in / lazy-chain protocol errors differed in wording and
# position. `_p` records kind|message|line|col, so these lock all three.
let itercases = [
  'let o = { has_next: 1 }; o',
  'let o = { has_next: fn (a) { a } }; o',
  'let o = { next: 1 }; o',
  'let o = { iter: 1 }; o',
  'let o = { has_next_at: 1 }; to_string(o.has_next_at)',
  'let bad = { iter: fn () { 42 } }; for x in bad { }',
  'let bad = { iter: fn () { nil } }; for x in bad { }',
  'let bad = { iter: fn () { let i = { a: 1 }; i } }; for x in bad { }',
  'let bad = { iter: fn () { let i = { has_next: fn () { true } }; i } }; for x in bad { }',
  'let bad = { iter: fn () { let i = { next: fn () { 1 } }; i } }; for x in bad { }',
  'let h = { next: fn () { 1 }, iter: fn () { self } }; h.collect()',
  'let h = { next: fn () { 1 }, iter: fn () { self } }; h.map(|x| x).take(2).collect()',
  'let h = { next: fn () { 1 }, iter: fn () { self } }; h.count()',
  'let p = { a: 1 }; p.collect()',
  'let p = { a: 1 }; p.take(1).collect()',
  'mut n = 3; let it = { iter: fn () { self }, has_next: fn () { n > 0 }, next: fn () { n = n - 1; n } }; to_string(it.collect())',
  'mut n = 3; let it = { iter: fn () { self }, has_next: fn () { n > 0 }, next: fn () { n = n - 1; n } }; mut s = 0; for x in it { s = s + x }; to_string(s)',
  'mut n = 4; let it = { iter: fn () { self }, has_next: fn () { n > 0 }, next: fn () { n = n - 1; n } }; to_string(it.map(|x| x * 2).take(2).collect())',
]
for c in itercases {
  case("iterproto|" + c, c)
}

# --- Dimension: iterator producer / accumulator throw paths ---------------
# The corpus only ever threw from a loop *body* or from a broken protocol, so
# the "producer itself throws mid-drain" family went unmeasured — and with it
# the leak-abort gate's coverage of who owns the iterator and the reduce seed
# while `has_next()` / `next()` runs. Each case fails from a different position
# (producer, body, dispose, count expression, seed-before-open) with a heap
# value in flight, so a stranded +1 shows up in the suite-wide audit as well as
# in this diff.
#
# Failures are built-in errors (`1 / 0`, `[1][9]`), not `throw "..."`: `_p`
# renders kind/message/line/col, which a raw thrown String has none of.
# Bodies are single-quote raw (literal `{...}` decl braces).
let iterthrows = [
  'mut n = 0; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; if n > 2 { 1 / 0 }; n } }; mut s = 0; for x in it { s = s + x }; s',
  'let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { 1 / 0 } }; for x in it { }; 1',
  'mut n = 0; let it = { iter: fn () { self }, has_next: fn () { n = n + 1; if n > 2 { 1 / 0 }; true }, next: fn () { n } }; mut s = 0; for x in it { s = s + x }; s',
  'mut n = 0; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; if n > 2 { [1][9] }; [n, n] } }; mut r = []; for x in it { r.push(x) }; r',
  'mut n = 0; let it = { iter: fn () { self }, has_next: fn () { n < 5 }, next: fn () { n = n + 1; [n, n] } }; for x in it { [1][9] }; 1',
  'mut n = 0; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; if n > 2 { 1 / 0 }; [n, n] } }; mut s = 0; try { for x in it { s = s + x[0] } } catch e { s = s + 100 }; s',
  'fn mk(k) { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; if n > k { 1 / 0 }; [n, n] } } }; mut s = 0; for a in [1, 2] { try { for x in mk(a) { s = s + x[0] } } catch e { s = s + 10 } }; s',
  'fn g() { for v in [1, 2, 3] { if v == 2 { [1][9] }; yield [v, v] } }; mut r = []; for x in g() { r.push(x) }; r',
  # Accumulator seed: live from before the protocol open until the first
  # iteration hands it to the body scope.
  'let it = { iter: fn () { self }, has_next: fn () { 1 / 0 }, next: fn () { 1 } }; it.reduce([0, 0], |a, b| a)',
  'mut n = 0; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; if n > 2 { 1 / 0 }; n } }; it.reduce([0, 0], |a, b| [a[0] + b, a[1]])',
  'mut n = 0; let it = { iter: fn () { self }, has_next: fn () { n < 5 }, next: fn () { n = n + 1; n } }; it.reduce([0, 0], |a, b| b > 2 ? [1][9] : [a[0] + b, a[1]])',
  'let it = { iter: fn () { self }, next: 1 }; it.reduce([0, 0], |a, b| a)',
  'fn boom() { 1 / 0 }; range(boom()).reduce([0, 0], |a, b| a)',
  'range("x").reduce([0, 0], |a, b| a)',
  'range(5).reduce([0, 0], |a, b| b > 2 ? [1][9] : [a[0] + b, a[1]])',
  'range(4).reduce([0, 0], |a, b| [a[0] + b, a[1]])',
  # dispose x exit path (drain / break / body throw / early return), plus a
  # dispose that itself throws — propagating on drain, swallowed by the
  # in-flight body error.
  'mut d = 0; let it = { iter: fn () { self }, has_next: fn () { false }, next: fn () { 1 }, dispose: fn () { d = d + 1 } }; for x in it { }; d',
  'mut n = 0; mut d = 0; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } }; for x in it { break }; d',
  'mut n = 0; mut d = 0; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } }; try { for x in it { [1][9] } } catch e { nil }; d',
  'mut d = 0; fn f() { mut n = 0; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } }; for x in it { if x[0] >= 2 { return x[0] } }; 0 }; [f(), d]',
  'mut n = 0; let it = { iter: fn () { self }, has_next: fn () { n < 2 }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { 1 / 0 } }; for x in it { }; 1',
  'mut n = 0; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { 1 / 0 } }; for x in it { [1][9] }; 1',
  # One for-in statement driven by a protocol source and an Array in turn: the
  # cursor must not carry an iterator over into the Array run.
  'fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { n < 2 }, next: fn () { n = n + 1; [n, n] } } }; mut s = 0; for k in [0, 1, 2, 3] { let src = k % 2 == 0 ? mk() : [[7, 7], [8, 8]]; for x in src { s = s + x[0] } }; s',
  # dispose x *producer* throw (§18.5: any exception leaving the loop disposes).
  # The observed `d` / defer trace is the point here — these lock the exit-path
  # promise itself, not just its leak-freedom.
  'mut n = 0; mut d = 0; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; if n > 2 { [1][9] }; [n, n] }, dispose: fn () { d = d + 1 } }; try { for x in it { } } catch e { nil }; d',
  'mut d = 0; let it = { iter: fn () { self }, has_next: fn () { [1][9] }, next: fn () { 1 }, dispose: fn () { d = d + 1 } }; try { for x in it { } } catch e { nil }; d',
  'mut n = 0; mut d = 0; let it = { iter: fn () { self }, has_next: fn () { n = n + 1; if n > 2 { 1 / 0 }; true }, next: fn () { [n, n] }, dispose: fn () { d = d + 1 } }; mut k = nil; try { for x in it { } } catch e { k = e.kind }; [d, k]',
  # A dispose that throws on this path must not replace the in-flight error.
  'let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { [1][9] }, dispose: fn () { 1 / 0 } }; mut k = nil; try { for x in it { } } catch e { k = e.kind }; k',
  # Generator body throwing while suspended: dispose is what runs its defers.
  'mut g = 0; fn gen() { defer { g = g + 1 }; defer { g = g + 10 }; for v in [1, 2, 3] { if v == 2 { [1][9] }; yield [v, v] } }; try { for x in gen() { } } catch e { nil }; g',
  # Nested: inner producer throw disposes inner, then outer as it leaves.
  'mut t = []; fn mk(tag, n, bad) { mut i = 0; { iter: fn () { self }, has_next: fn () { i < n }, next: fn () { i = i + 1; if bad && i == 2 { [1][9] }; [i, i] }, dispose: fn () { t.push(tag) } } }; try { for a in mk(1, 9, false) { for b in mk(2, 9, true) { } } } catch e { nil }; t',
  'mut t = []; fn mk(tag, n, bad) { mut i = 0; { iter: fn () { self }, has_next: fn () { i < n }, next: fn () { i = i + 1; if bad && i == 2 { [1][9] }; [i, i] }, dispose: fn () { t.push(tag) } } }; for a in mk(1, 2, false) { try { for b in mk(2, 9, true) { } } catch e { nil } }; t',
  # dispose forwarding through a lazy chain: from the consumer's side the chain
  # is one iterator, so for-in closing it closes the source. Also pins that a
  # dispose-less source stays dispose-less (the wrapper must not grow one).
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } } }; for x in mk().map(|v| v) { break }; d',
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } } }; for x in mk().map(|v| v).filter(|v| true).enumerate() { break }; d',
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { n < 4 }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } } }; for x in mk().take(2) { }; d',
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } } }; for x in mk().zip([9, 9].iter()) { break }; d',
  'mut d = 0; fn mk(k) { mut n = 0; { iter: fn () { self }, has_next: fn () { n < k }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } } }; for x in mk(1).chain(mk(1)) { }; d',
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; if n > 2 { [1][9] }; [n, n] }, dispose: fn () { d = d + 1 } } }; try { for x in mk().map(|v| v) { } } catch e { nil }; d',
  '[1, 2].iter().map(|v| v).has("dispose")',
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } } }; for x in mk().skip_while(|v| v[0] < 3) { break }; d',
  '[1, 2].iter().skip_while(|v| false).has("dispose")',
  'fn g() { for v in [1, 2, 3] { yield v } }; for x in g().zip([9, 9].iter()) { break }; 1',
  # Each new lazy combinator upstream has added since must forward too — a
  # generator caught mid-stride, not just a happens-to-pass smoke case.
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } } }; for x in mk().scan(0, |a, b| a + b[0]) { break }; d',
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [[n, n]] }, dispose: fn () { d = d + 1 } } }; for x in mk().flatten() { break }; d',
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; n }, dispose: fn () { d = d + 1 } } }; for x in mk().distinct() { break }; d',
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } } }; for x in mk().tap(|v| v) { break }; d',
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } } }; for x in mk().step_by(2) { break }; d',
  'mut d = 0; fn mk() { mut n = 0; { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; [n, n] }, dispose: fn () { d = d + 1 } } }; for x in mk().chunk_by(|v| v) { break }; d',
]
for c in iterthrows {
  case("iterthrow|" + c, c)
}

# --- Dimension: terminal methods dispose the iterator (C# rule) ------------
# Every terminal — draining or early-exiting — closes the chain on the way
# out, like for-in's drain/break. `d` counts dispose calls; `t` traces the
# pull/dispose interleaving so the "dispose after the last pull, before the
# result is handed back" ordering is pinned across backends, not just the
# count. Failures are built-in errors (`1 / 0`, `[1][9]`), never thrown
# strings (corpus rule: `_p` needs kind/position).
let mkd = 'fn mk(lim) { mut n = 0; { iter: fn () { self }, has_next: fn () { n < lim }, next: fn () { n = n + 1; n }, dispose: fn () { d = d + 1 } } }; '
let iterterms = [
  # Full drain x all 22 terminals: dispose exactly once.
  'mut d = 0; ' + mkd + 'let r = mk(3).collect(); [d, r.size()]',
  'mut d = 0; ' + mkd + 'let r = mk(3).join(","); [d, r]',
  'mut d = 0; ' + mkd + 'mk(3).for_each(|x| x); d',
  'mut d = 0; ' + mkd + 'let r = mk(3).reduce(0, |a, b| a + b); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).find(|x| false); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).position(|x| false); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).contains(99); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).first(); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).last(); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).nth(1); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).any(|x| false); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).all(|x| true); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).count(); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).sum(); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).product(); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).min(); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).max(); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).min_by(|x| x); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).max_by(|x| x); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(3).to_set(); [d, r.size()]',
  'mut d = 0; ' + mkd + 'let r = mk(3).group_by(|x| x); [d, r.size()]',
  'mut d = 0; ' + mkd + 'let r = mk(3).partition(|x| true); [d, r.size()]',
  # Early exit: the terminal stops mid-stream; dispose still runs, and the
  # source really was left mid-stream (n pinned via a second drain-less probe).
  'mut d = 0; ' + mkd + 'let r = mk(9).find(|x| x == 2); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(9).position(|x| x == 2); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(9).contains(2); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(9).first(); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(9).nth(2); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(9).any(|x| x == 2); [d, r]',
  'mut d = 0; ' + mkd + 'let r = mk(9).all(|x| x != 2); [d, r]',
  # Ordering: dispose fires after the last pull, before the caller sees the
  # result — the trace is [pulls..., "d"] on every backend.
  'mut t = []; let it = { iter: fn () { self }, has_next: fn () { t.size() < 2 }, next: fn () { t.push("n"); 1 }, dispose: fn () { t.push("d") } }; it.collect(); t',
  'mut t = []; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { t.push("n"); t.size() }, dispose: fn () { t.push("d") } }; it.find(|x| x == 2); t',
  # Resume after an early-exit terminal on a generator: dispose broke the
  # source, so the rest is [] (same as resuming after a for-in break).
  'fn g() { for v in [1, 2, 3] { yield v } }; let x = g(); x.find(|v| v == 2); to_string(x.collect())',
  # Terminal through a lazy chain: forwarding + terminal dispose, once.
  'mut d = 0; ' + mkd + 'let r = mk(9).map(|x| x).take(2).collect(); [d, r.size()]',
  'mut d = 0; ' + mkd + 'let r = mk(9).skip_while(|x| x < 2).take(1).count(); [d, r]',
  # Fused inline paths (map+collect / for_each / reduce): same contract, and
  # the body-throw edge disposes with the original error kind surviving.
  'mut d = 0; ' + mkd + 'let r = mk(3).map(|x| x + 1).collect(); [d, r.size()]',
  'mut d = 0; ' + mkd + 'mut s = 0; mk(3).for_each(fn (x) { s = s + x }); [d, s]',
  'mut d = 0; ' + mkd + 'mut k = nil; try { mk(9).map(|x| x == 2 ? [1][9] : x).collect() } catch e { k = e.kind }; [d, k]',
  'mut d = 0; ' + mkd + 'mut k = nil; try { mk(9).reduce(0, |a, b| b == 2 ? 1 / 0 : a + b) } catch e { k = e.kind }; [d, k]',
  # Producer throws mid-terminal: dispose runs, original error propagates.
  'mut d = 0; mut n = 0; let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { n = n + 1; if n > 2 { 1 / 0 }; n }, dispose: fn () { d = d + 1 } }; mut k = nil; try { it.collect() } catch e { k = e.kind }; [d, k]',
  'mut d = 0; mut n = 0; let it = { iter: fn () { self }, has_next: fn () { n = n + 1; if n > 2 { [1][9] }; true }, next: fn () { n }, dispose: fn () { d = d + 1 } }; mut k = nil; try { it.count() } catch e { k = e.kind }; [d, k]',
  # Callback throws mid-terminal: dispose runs (quietly), original error kind.
  'mut d = 0; ' + mkd + 'mut k = nil; try { mk(9).find(|x| x == 2 ? [1][9] : false) } catch e { k = e.kind }; [d, k]',
  'mut d = 0; ' + mkd + 'mut k = nil; try { mk(9).group_by(|x| x == 2 ? 1 / 0 : x) } catch e { k = e.kind }; [d, k]',
  # A throwing dispose: drain propagates it; an unwinding terminal keeps the
  # original error (same lines as for-in).
  'mut n = 0; let it = { iter: fn () { self }, has_next: fn () { n < 2 }, next: fn () { n = n + 1; n }, dispose: fn () { 1 / 0 } }; mut k = nil; try { it.collect() } catch e { k = e.kind }; k',
  'let it = { iter: fn () { self }, has_next: fn () { true }, next: fn () { [1][9] }, dispose: fn () { 1 / 0 } }; mut k = nil; try { it.collect() } catch e { k = e.kind }; k',
  # Terminal then explicit dispose: no hidden extra dispose anywhere (a
  # hand-written dispose has no once-guard, so exactly 2 is the contract).
  'mut d = 0; ' + mkd + 'let x = mk(3); x.count(); x.dispose(); d',
  # Dispose-less sources stay dispose-less through eager terminals.
  'to_string([1, 2, 3].iter().map(|x| x).collect())',
  # Empty-input terminals that throw (min/max): dispose still runs.
  'mut d = 0; ' + mkd + 'mut k = nil; try { mk(0).min() } catch e { k = e.kind }; [d, k]',
  'mut d = 0; ' + mkd + 'mut k = nil; try { mk(0).max_by(|x| x) } catch e { k = e.kind }; [d, k]',
  # Callback validation straddles the dispose boundary: a non-Function is the
  # bind-time typed-param error (NO dispose), a wrong-arity Function is the
  # in-body arity check (dispose runs) — interp's split, pinned per backend.
  'mut d = 0; ' + mkd + 'mut m = nil; try { mk(3).for_each(42) } catch e { m = e.message }; [d, m]',
  'mut d = 0; ' + mkd + 'mut m = nil; try { mk(3).for_each(fn (a, b) { a }) } catch e { m = e.message }; [d, m]',
  'mut d = 0; ' + mkd + 'mut m = nil; try { mk(3).group_by(42) } catch e { m = e.message }; [d, m]',
  'mut d = 0; ' + mkd + 'mut m = nil; try { mk(3).partition(fn (a, b) { a }) } catch e { m = e.message }; [d, m]',
  'mut d = 0; ' + mkd + 'mut m = nil; try { mk(3).reduce([0, 0], fn (a, b, c) { a }) } catch e { m = e.message }; [d, m]',
  'mut d = 0; ' + mkd + 'mut m = nil; try { mk(3).min_by(42) } catch e { m = e.message }; [d, m]',
]
for c in iterterms {
  case("iterterm|" + c, c)
}

# --- Dimension: return / defer inside HOF callbacks ------------------------
# `_p` wraps each body in `fn () { ... }`, so a `return` that escapes the
# callback frame changes the thunk's result — exactly the bug shape. The
# JIT's inline fusion used to splice the callback body into the caller:
# `return` returned from the enclosing fn (or crashed codegen when the whole
# body was one `return`) and `defer` fired at the caller's exit. Sweeps
# every fused path (array / iter / range x for_each / map / filter / reduce)
# plus the variable-bound form that pins the runtime-helper path.
let cbrets = [
  'mut n = 0; [1, 2, 3].for_each(fn (x) { if x == 2 { return nil }; n = n + 1 }); n',
  'mut n = 0; [1, 2, 3].iter().for_each(fn (x) { if x == 2 { return nil }; n = n + 1 }); n',
  'mut n = 0; range(3).for_each(fn (x) { if x == 1 { return nil }; n = n + 1 }); n',
  '[1, 2, 3].map(fn (x) { if x == 2 { return 99 }; x * 10 })',
  '[1, 2, 3].iter().map(fn (x) { if x == 2 { return 99 }; x }).collect()',
  'range(3).map(fn (x) { if x == 1 { return 99 }; x }).collect()',
  '[1, 2, 3].filter(fn (x) { if x == 2 { return true }; false })',
  '[1, 2, 3].reduce(0, fn (a, x) { if x == 2 { return a }; a + x })',
  'range(3).reduce(0, fn (a, x) { if x == 1 { return a }; a + x })',
  # Whole body is a return (used to crash JIT codegen).
  '[1, 2].map(fn (x) { return x * 2 })',
  # Defer fires at callback exit, once per element.
  'mut t = []; [1, 2].for_each(fn (x) { defer { t.push(-x) }; t.push(x) }); t.push(0); t',
  # Return in a nested callback exits the inner callback only.
  'mut n = 0; [1, 2, 3].for_each(fn (x) { [x].for_each(fn (y) { if y == 2 { return nil }; n = n + 1 }) }); n',
  # Variable-bound callbacks take the runtime-helper path; pin it too.
  'mut n = 0; let cb = fn (x) { if x == 2 { return nil }; n = n + 1 }; [1, 2, 3].for_each(cb); n',
  'let cb = fn (a, x) { if x == 2 { return a }; a + x }; [1, 2, 3].reduce(0, cb)',
]
for c in cbrets {
  case("cbret|" + c, c)
}

# --- Dimension: HOF callback mutates the receiver --------------------------
# The walk re-reads the size every step, so it ends where the live array ends
# (the rule `for x in a` already used). Three behaviours used to coexist: the
# interp range-for'd over the live std::vector (undefined — `pop` read
# destroyed slots, `push` dangled the iterators), the JIT's inlined loops
# hoisted the size and threw IndexError, and its runtime helpers already
# re-read. Both the inline shape and the variable-bound (helper) shape are
# swept, plus the grow direction that used to corrupt interp values.
let mutrecv = [
  'mut a = [1,2,3,4]; mut s = []; for x in a { s.push(x); a.pop() }; s',
  'mut a = [1,2,3,4]; mut s = []; a.for_each(fn (x) { s.push(x); a.pop() }); s',
  'mut a = [1,2,3,4]; mut s = []; a.map(fn (x) { s.push(x); a.pop(); x }); s',
  'mut a = [1,2,3,4]; mut s = []; a.filter(fn (x) { s.push(x); a.pop(); true }); s',
  'mut a = [1,2,3,4]; mut s = []; a.reduce(0, fn (acc, x) { s.push(x); a.pop(); acc }); s',
  'mut a = [1,2,3,4]; mut s = []; a.find(fn (x) { s.push(x); a.pop(); false }); s',
  'mut a = [1,2,3,4]; mut s = []; a.any(fn (x) { s.push(x); a.pop(); false }); s',
  'mut a = [1,2,3,4]; mut s = []; a.all(fn (x) { s.push(x); a.pop(); true }); s',
  'mut a = [1,2,3,4]; mut s = []; a.flat_map(fn (x) { s.push(x); a.pop(); [x] }); s',
  'mut a = [1,2,3,4]; a.reduce([0, 0], |acc, x| [acc[0] + a.pop(), acc[1]])',
  # Variable-bound callbacks take the runtime-helper path.
  'mut a = [1,2,3,4]; mut s = []; let cb = fn (x) { s.push(x); a.pop() }; a.for_each(cb); s',
  'mut a = [1,2,3,4]; mut s = []; let cb = fn (x) { s.push(x); a.pop(); x }; a.map(cb); s',
  'mut a = [1,2,3,4]; mut s = []; let cb = fn (acc, x) { s.push(x); a.pop(); acc }; a.reduce(0, cb); s',
  # Growing: reallocation used to corrupt the interp's values.
  'mut a = [1,2]; mut n = 0; a.for_each(fn (x) { n = n + 1; if n < 20 { a.push(n) } }); [n, a.size()]',
  'mut a = [1,2]; mut n = 0; for x in a { n = n + 1; if n < 20 { a.push(n) } }; [n, a.size()]',
  'mut a = [1,2]; mut n = 0; a.map(fn (x) { n = n + 1; if n < 20 { a.push(n) }; x }).size()',
  # Draining faster than the walk advances ends it after one step.
  'mut a = [1,2,3,4]; mut s = []; a.for_each(fn (x) { s.push(x); a.pop(); a.pop(); a.pop() }); [s, a.size()]',
  # A receiver the callback does not touch is unaffected.
  'mut a = [1,2,3]; mut b = []; a.for_each(fn (x) { b.push(x * 2) }); b',
]
for c in mutrecv {
  case("mutrecv|" + c, c)
}

# --- Dimension: for-in element in flight when the binding throws -----------
# The cursor stores this iteration's element at +1, then the body binding
# takes it over; a throw between the two (a destructure mismatch, the loop
# safepoint) must release it. The leak-abort gate is the real consumer here
# — the JIT used to strand one element per throw — so every cursor kind
# gets the mismatch, and the matching / sink / body-throw shapes pin that
# the guard does *not* release a ref the body slot already owns.
let elemwin = [
  'mut n = 0; try { for (a, b) in [[1, 2], [3, 4, 5]] { n = n + a } } catch e { n = n + 1 }; n',
  'mut n = 0; try { for (a, b) in ([1, 2], [3, 4, 5]) { n = n + a } } catch e { n = n + 1 }; n',
  'mut n = 0; try { for (a, b) in {[1, 2], [3, 4, 5]} { n = n + a } } catch e { n = n + 1 }; n',
  'mut n = 0; try { for (a, b, c) in {x: 1, y: 2} { n = n + 1 } } catch e { n = n + 1 }; n',
  'mut n = 0; try { for (a, b) in "abc" { n = n + 1 } } catch e { n = n + 1 }; n',
  'fn g() { yield [1, 2]; yield [3, 4, 5] }; mut n = 0; try { for (a, b) in g() { n = n + a } } catch e { n = n + 1 }; n',
  # The first element already mismatches: the throw lands on iteration 0.
  'mut n = 0; try { for (a, b) in [[1, 2, 3]] { n = n + a } } catch e { n = n + 1 }; n',
  # Heap elements, so a stranded ref is a real object leak.
  'mut n = 0; try { for (a, b) in [{x: 1}] { n = n + 1 } } catch e { n = n + 1 }; n',
  'fn g2() { yield {x: 1} }; mut n = 0; try { for (a, b) in g2() { n = n + 1 } } catch e { n = n + 1 }; n',
  # Matched pattern / sink / body throw: the body slot owns the ref by then.
  'mut n = 0; for (a, b) in [(1, 2), (3, 4)] { n = n + a + b }; n',
  'mut n = 0; try { for x in [{x: 1}, {x: 2}] { n = n + x.y.z } } catch e { n = n + 1 }; n',
  'mut n = 0; try { for _ in [{x: 1}, {x: 2}] { n = n + [0][9] } } catch e { n = n + 1 }; n',
  'fn g3() { yield {x: 1}; yield {x: 2} }; mut n = 0; try { for x in g3() { n = n + x.y.z } } catch e { n = n + 1 }; n',
  # break / return leave the loop with the element already handed over.
  'mut n = 0; for x in [{x: 1}, {x: 2}] { n = n + 1; break }; n',
  'fn r() { for x in [{x: 1}, {x: 2}] { return x.x } ; 0 }; r()',
]
for c in elemwin {
  case("elemwin|" + c, c)
}

# --- Dimension: `self` resolution (dynamic receiver > lexical fallback) ----
# docs §Methods and UFCS. Nested frames (fn / lambda / HOF callback / defer /
# returned closure) inherit the enclosing method's receiver; a receiver call
# rebinds; a bound-method value read carries its receiver permanently; the
# `fn` handle in a method frame is the bound wrapper. NameError shapes use the
# built-in unbound-self error so `_p` records kind+position symmetrically.
let selflex = [
  # lexical fallback shapes inside a method
  'class A1 { new(n){ self.n = n } m(){ let f = fn (x) { x + self.n }; f(10) } }; A1.new(7).m()',
  'class A2 { new(n){ self.n = n } m(){ let g = |x| x + self.n; g(10) } }; A2.new(7).m()',
  'class A3 { new(n){ self.n = n } m(){ [1, 2].map(|x| x * self.n) } }; A3.new(7).m()',
  'class A4 { new(n){ self.n = n } m(){ let cb = fn (x) { x * self.n }; [1, 2].map(cb) } }; A4.new(7).m()',
  'class A5 { new(n){ self.n = n } m(){ |x| x + self.n } }; let a = A5.new(7).m(); a(1)',
  'class A6 { new(n){ self.n = n } m(out){ out.push(0); defer { out.push(self.n) } } }; let o = []; A6.new(7).m(o); o',
  'class A7 { new(n){ self.n = n } m(){ let mid = fn () { let inner = fn () { self.n }; inner() }; mid() } }; A7.new(42).m()',
  'class A8 { new(n){ self.n = n } m(){ let f = fn (x) { x + self.n }; 5.f() } }; A8.new(10).m()',
  # object-literal method: same fallback, no class involved
  'let ol = { n: 3, m: fn () { let f = fn () { self.n }; f() } }; ol.m()',
  # dynamic receiver wins over the lexical capture
  'class W1 { new(n){ self.n = n } mk(){ let g = fn () { self.n }; g } }; let gg = W1.new(1).mk(); gg()',
  'class W2 { new(n){ self.n = n } mk(){ let g = fn () { self.n }; g } }; let gg = W2.new(1).mk(); let w = { n: 99, g: gg }; w.g()',
  # no receiver anywhere: NameError at the read
  'let f = fn () { self }; f()',
  'let outer = fn () { let f = fn () { self.x }; f() }; outer()',
  '5.size() + (fn () { self })()',
  # `fn` handle: recursion / escape keep the receiver; rebind does not override
  'class R1 { new(n){ self.n = n } m(k){ if k == 0 { self.n } else { fn(k - 1) } } }; R1.new(5).m(2)',
  'class R2 { new(n){ self.n = n } m(k){ if k == 0 { self.n } else { fn(k - 1) } } }; let b = R2.new(5).m; b(1)',
  'class R3 { new(n){ self.n = n } m(k){ if k == 0 { self.n } else { fn(k - 1) } } }; let b = R3.new(5).m; let w = { n: 100, h: b }; w.h(1)',
  # bound-method value reads: proto method / static / ctor / own slot
  'class K1 { new(v){ self.v = v } g(){ self.v } }; let d = K1.new(7).g; d()',
  'class K2 { new(){ self.z = 0 } static who(){ type_of(self) } }; let s = K2.who; s()',
  'class K3 { new(v){ self.v = v } g(){ self.v } }; let mk = K3.new; mk(9).g()',
  'let os = { n: 3, f: fn () { self.n } }; let m = os.f; m()',
  'class K4 { new(){ self.cb = fn () { type_of(self) } } }; let c = K4.new().cb; c()',
  # each read mints a fresh wrapper
  'let oi = { n: 3, f: fn () { self.n } }; oi.f == oi.f',
  'class K5 { new(v){ self.v = v } }; K5.new == K5.new',
  # shadowing and reassignment keep their existing semantics
  'class S1 { new(n){ self.n = n } m(){ let self = 99; self } }; S1.new(1).m()',
  'class S2 { new(n){ self.n = n } m(){ self = 1 } }; S2.new(1).m()',
  # getter reached from a nested frame
  'class G1 { new(n){ self.n = n } get twice(){ self.n * 2 } m(){ let f = fn () { self.twice }; f() } }; G1.new(7).m()',
]
for c in selflex {
  case("selflex|" + c, c)
}

# --- Dimension: user dispatch throws over a borrowed operand ---------------
# A `cmp`/`__lt__`/`eq`/`__index__`/`__setindex__`/getter body reached from a
# container's own internals gets the element BORROWED — the array/dict/Set
# still owns it. A dispatch that consumed a ref on its throw path freed those
# elements out from under the container, so the JIT crashed where the interp
# read the collection back intact. Each case throws mid-operation and then
# *uses* the container, which is where the divergence surfaces; a stranded +1
# shows up in the leak-abort audit as well.
let borrowthrow = [
  # keyless sort/sorted: the comparator borrows two array slots
  'class Bs { new(v){ self.v = v } cmp(o){ if self.v == 9 { 1 / 0 }; self.v - o.v } }; let xs = [3, 9, 1].map(fn (v) { Bs.new(v) }); try { xs.sort() } catch e { nil }; xs.map(fn (b) { b.v })',
  'class Bt { new(v){ self.v = v } cmp(o){ if self.v == 9 { 1 / 0 }; self.v - o.v } }; let xs = [3, 9, 1].map(fn (v) { Bt.new(v) }); try { xs.sorted() } catch e { nil }; xs.map(fn (b) { b.v })',
  'class Bu { new(v){ self.v = v } __lt__(o){ if self.v == 9 { [1][9] }; self.v < o.v } }; let xs = [3, 9, 1].map(fn (v) { Bu.new(v) }); try { xs.sort() } catch e { nil }; xs.map(fn (b) { b.v })',
  # `reverse:` flips which side is the receiver — throw on either operand so
  # the borrow window is reached from that direction too
  'class Bv { new(v){ self.v = v } cmp(o){ if self.v == 9 || o.v == 9 { 1 / 0 }; self.v - o.v } }; let xs = [3, 9, 1].map(fn (v) { Bv.new(v) }); let e = try { xs.sort(reverse: true); nil } catch e { e.kind }; [e, xs.map(fn (b) { b.v })]',
  # sort_by compares extracted keys, so the throw comes from the key callback
  'class Bw { new(v){ self.v = v } }; let xs = [3, 9, 1].map(fn (v) { Bw.new(v) }); try { xs.sort_by(fn (b) { b.v == 9 ? 1 / 0 : b.v }) } catch e { nil }; xs.map(fn (b) { b.v })',
  # dict / Set lookup: the stored key is borrowed while `eq`/`hash` runs
  'class Bk { new(v){ self.v = v } hash(){ 1 } eq(o){ if self.v == 9 { 1 / 0 }; self.v == o.v } }; let s = [Bk.new(9)].to_set(); try { s.contains(Bk.new(1)) } catch e { nil }; s.iter().map(fn (k) { k.v }).collect()',
  'class Bm { new(v){ self.v = v } hash(){ 1 } eq(o){ if self.v == 9 { 1 / 0 }; self.v == o.v } }; mut d = {}; d[Bm.new(9)] = 1; try { d[Bm.new(1)] } catch e { nil }; d.keys().map(fn (k) { k.v })',
  # the `==` operator hands +1 temps instead — the other half of the contract
  'class Be { new(v){ self.v = v } __eq__(o){ 1 / 0 } }; let a = Be.new(1); let b = Be.new(2); let e = try { a == b; nil } catch e { e.kind }; [e, a.v + b.v]',
  'class Bl { new(v){ self.v = v } cmp(o){ 1 / 0 } }; let a = Bl.new(1); let b = Bl.new(2); let e = try { a < b; nil } catch e { e.kind }; [e, a.v + b.v]',
  # subscript / property overloads reached through a live receiver
  'class Bi { new(v){ self.v = v } __index__(k){ 1 / 0 } }; let o = Bi.new(5); let e = try { o[[1]]; nil } catch e { e.kind }; [e, o.v]',
  'class Bx { new(v){ mut self.v = v } __setindex__(k, x){ 1 / 0 } }; mut o = Bx.new(5); let e = try { o[[1]] = [2]; nil } catch e { e.kind }; [e, o.v]',
  'class By { new(v){ mut self.v = v } __setindex__(k, x){ 1 / 0 } }; mut o = By.new(5); let e = try { o["zz"] = [2]; nil } catch e { e.kind }; [e, o.v]',
  'class Bg { new(v){ self.v = v } get boom(){ 1 / 0 } }; let o = Bg.new(5); let e = try { o.boom; nil } catch e { e.kind }; [e, o.v]',
  # UFCS builtin forms: the receiver +1 rides the call into a user body
  'class Bq { new(v){ self.v = v } __str__(){ 1 / 0 } }; let o = Bq.new(1); let e = try { o.to_string(); nil } catch e { e.kind }; [e, o.v]',
  'class Br { new(v){ self.v = v } __str__(){ 1 / 0 } }; let o = Br.new(1); let e = try { o.println(); nil } catch e { e.kind }; [e, o.v]',
  'class Bh { new(v){ self.v = v } hash(){ 1 / 0 } }; let o = Bh.new(1); let e = try { o.hash(); nil } catch e { e.kind }; [e, o.v]',
  # a stored key is hashed on the way in, so a throwing hash() unwinds mid-write
  'class Bn { new(v){ self.v = v } hash(){ 1 / 0 } eq(o){ self.v == o.v } }; mut d = {}; let e = try { d[Bn.new(1)] = [5]; nil } catch e { e.kind }; [e, d.size()]',
  # a throwing __str__ over an element the array still owns
  'class Bp { new(v){ self.v = v } __str__(){ 1 / 0 } }; let xs = [Bp.new(1)]; let e = try { "{xs[0]}"; nil } catch e { e.kind }; [e, xs[0].v]',
  # builtin (non-dispatch) compare error on the same sorts: array untouched
  'let xs = [3, "a", 1]; let e = try { xs.sort(); nil } catch e { e.kind }; [e, xs]',
  'let xs = [3, "a", 1]; let e = try { xs.sorted(); nil } catch e { e.kind }; [e, xs]',
]
for c in borrowthrow {
  case("borrowthrow|" + c, c)
}

# --- Dimension: well-known property contract (drop/iter/has_next/next) ----
# Bind-time enforcement must hold on every write surface (literal prop,
# dynamic/literal subscript, native builder, class decl) with the interp's
# ordering: immutable gate first, then the contract check. Statics are a
# namespace — exempt. See shared.h is_well_known_prop.
let wkprop = [
  # dynamic + literal subscript keys reach the same chokepoint
  'mut o = {mut x: 1}; let k = "drop"; try { o[k] = 42; 0 } catch e { e.kind }',
  'mut o = {mut x: 1}; let k = "iter"; try { o[k] = 42; 0 } catch e { e.kind }',
  'mut o = {mut x: 1}; let k = "has_next"; try { o[k] = 42; 0 } catch e { e.kind }',
  'mut o = {mut x: 1}; let k = "next"; try { o[k] = 42; 0 } catch e { e.kind }',
  'mut o = {mut x: 1}; try { o["drop"] = 42; 0 } catch e { e.kind }',
  'mut o = {mut x: 1}; let k = "dro" + "p"; try { o[k] = fn () { nil }; 1 } catch e { e.kind }',
  # native builder (JSON.parse) writes through the same chokepoint
  'try { JSON.parse("\{\"drop\": 42}"); 0 } catch e { e.kind }',
  'try { JSON.parse("\{\"iter\": 1, \"x\": 2}"); 0 } catch e { e.kind }',
  'let o = JSON.parse("\{\"x\": 1}"); o.x',
  # ordering: the immutable gate wins over the contract check
  'let o = {drop: fn () { nil }}; try { o.drop = 42; 0 } catch e { e.kind }',
  'mut o = {mut drop: fn () { nil }}; try { o.drop = 42; 0 } catch e { e.kind }',
  'mut o = {mut drop: fn () { nil }}; o.drop = fn () { nil }; 1',
  # duplicate literal key: is_init overwrite still checks the contract
  'try { let _ = { drop: fn () { nil }, drop: 42 }; 0 } catch e { e.kind }',
  # class decl: proto methods carry the bind contract (decl-time error)
  'try { class Wd { new() { self.x = 1 } drop(a) { a } }; 0 } catch e { e.kind }',
  'try { class Wn { next(n) { n } }; 0 } catch e { e.kind }',
  'try { class Wo { drop() { nil } drop(a) { a } }; 0 } catch e { e.kind }',
  'class Wg { new() { self.x = 1 } drop() { nil } }; Wg.new(); 1',
  # statics are a namespace: no contract, no drop protocol
  'class Ws { static drop(a) { a + 1 } }; Ws.drop(1)',
  'class Wf { static next(n) { n * 2 } }; Wf.next(3)',
  # instance own-slot binds in a ctor stay checked
  'try { class Wc { new() { self.drop = 42 } }; Wc.new(); 0 } catch e { e.kind }',
  'try { class Wi { new() { self.iter = 1 } }; Wi.new(); 0 } catch e { e.kind }',
  # trait defaults reach every conforming instance without passing
  # `initialize`, so the contract is enforced where they are declared
  'try { trait Wta { tag() -> Long  next(x) { x } }; 0 } catch e { e.kind }',
  'try { trait Wtb { tag() -> Long  drop(a) { a } }; 0 } catch e { e.kind }',
  'try { trait Wtc { tag() -> Long  iter(x) { x } }; 0 } catch e { e.kind }',
  'try { trait Wtd { tag() -> Long  has_next(x) { x } }; 0 } catch e { e.kind }',
  # a rest/kwargs/defaulted/destructured param is still a param
  'try { trait Wte { tag() -> Long  next(*args) { 1 } }; 0 } catch e { e.kind }',
  'try { trait Wtf { tag() -> Long  next(**kw) { 1 } }; 0 } catch e { e.kind }',
  'try { trait Wtg { tag() -> Long  next(x = 1) { x } }; 0 } catch e { e.kind }',
  'try { trait Wth { tag() -> Long  next([a, b]) { a } }; 0 } catch e { e.kind }',
  'try { trait Wti { tag() -> Long  next(*, k = 1) { 1 } }; 0 } catch e { e.kind }',
  # 0-arg default, non-well-known name, and body-less requirement stay legal
  'trait Wtj { current() -> Long  next() { self.current() + 1 } }; class Wtk { new() {} current() { 41 } }; Wtk.new().next()',
  'try { trait Wtl { tag() -> Long  step(x) { x } }; 1 } catch e { e.kind }',
  'try { trait Wtm { next(x) }; 1 } catch e { e.kind }',
]
for c in wkprop {
  case("wkprop|" + c, c)
}

# --- Dimension: runtime-inserted keys default mutable, `??=` complex lvalue -
# o[k]=v / o.k=v / get_or_put / to_object insert mutable slots now (only
# Object *literal* keys stay immutable-by-default); `??=` extends past its
# former simple-variable-only MVP to Object dot/subscript (incl. class
# __index__/__setindex__) and Array elements (no auto-extend).
let nilco = [
  # mutable-by-default insert: second write to the same runtime key succeeds
  'mut o = {}; o["a"] = 1; o["a"] = 2; o["a"]',
  'mut o = {}; o.a = 1; o.a = 2; o.a',
  'let o = {x: 1}; try { o.x = 2; 0 } catch e { e.kind }',
  'mut o = {}; o.get_or_put("k", 0); o["k"] += 1; o["k"]',
  'mut o = [("a", 1)].to_object(); o.a = 2; o.a',
  # tally idiom
  'mut t = {}; for w in ["a", "b", "a"] { t[w] ??= 0; t[w] += 1 }; [t.a, t.b]',
  # short-circuit: RHS not evaluated when the current value is non-nil
  'mut ran = false; mut o = {z: 1}; let r = (o.z ??= (fn () { ran = true; 9 })()); [r, ran]',
  # subscript vs dot both coalesce a mutable nil slot
  'mut o = {mut x: nil}; o.x ??= 5; o.x ??= 99; o.x',
  'mut o = {}; o["y"] ??= 7; o["y"]',
  # immutable existing slot still throws on the write-back
  'mut o = {x: nil}; try { o.x ??= 5; 0 } catch e { e.kind }',
  # Tuple-keyed flat "sparse tensor" accumulation
  'mut s = {}; s[(1, 2)] ??= 0; s[(1, 2)] += 1; s[(1, 2)] += 1; s[(1, 2)]',
  # Array element: replace nil in place, no auto-extend
  'mut a = [1, nil, 3]; a[1] ??= 42; a',
  'mut a = [1, 2]; try { a[9] ??= 1; 0 } catch e { e.kind }',
  # class instance routes through __index__/__setindex__
  'class Ctr { new() { self.d = {} } __index__(k) { self.d.get(k, nil) } __setindex__(k, v) { self.d[k] = v; true } }; c = Ctr.new(); c["a"] ??= 0; c["a"] += 1; c["a"]',
]
for c in nilco {
  case("nilco|" + c, c)
}

# --- Dimension: UFCS shadowing (builtin method name vs same-named free fn) --
# Method resolution is one contract with a fixed order (docs/language.md §22):
# a closed namespace answers every name, then the receiver's own property,
# then its type's builtin, then a free function of that name (UFCS, only when
# the binding really is a Function), then the miss error. Both backends
# implement it separately, so sweep it: which arm answers depends on the
# receiver's runtime shape, and the JIT decides part of it at compile time.
#
# Every candidate is declared INSIDE the thunk. A top-level `fn map` would be
# a UFCS candidate for the whole module and would rewrite Dimension 2.
let shadow_recvs = [
  '5',
  '1.5',
  'true',
  'nil',
  '"ab"',
  '[1, 2]',
  '{a: 1}',
  '(1, 2)',
  '{1, 2}',
  'Math',
  '[1, 2].iter()',
  'Shared.new({a: 1})',
  'Tensor.zeros("f32", 2, 2)',
  'Sc.new()',
]
# Name classes: array/dict builtins, Set's mutating `add`, String's
# `to_string`, an iterator-only terminal, the two names with a dispatch of
# their own (`drop`'s at-most-once guard, class `parameters()`), and a name
# no builtin table holds.
let shadow_names = [
  'size',
  'map',
  'push',
  'add',
  'to_string',
  'collect',
  'upper',
  'drop',
  'parameters',
  'zzz',
]
# Candidate kinds: one that fits the UFCS call, one whose arity does not, and
# a binding that is not a Function at all (never a callee — the receiver's own
# resolution answers instead).
let shadow_cands = [
  'fn NAME(o) { "ufcs-NAME" }',
  'fn NAME(o, extra) { "ufcs-NAME" }',
  'let NAME = 5',
]
let shadow_prelude = 'class Sc { new() { self.f = 1 } }; '
for n in shadow_names {
  for cand in shadow_cands {
    let decl = cand.replace("NAME", n)
    for r in shadow_recvs {
      case(
        "ufcsshadow|" + n + "|" + decl + "|" + r,
        shadow_prelude + decl + '; (' + r + ').' + n + '()',
      )
      # Same call one frame down: the candidate reaches it as a free variable,
      # so the compile-time visibility the JIT gates on must agree with the
      # interpreter's environment lookup.
      case(
        "ufcsshadownest|" + n + "|" + decl + "|" + r,
        shadow_prelude +
          decl +
          '; fn nest(x) { return x.' +
          n +
          '() }; nest(' +
          r +
          ')',
      )
    }
  }
}

# Call forms other than the plain 0-arg call the sweep above already makes:
# a bare method reference is not a first-class value, kwargs never reach a
# real builtin, `?.` short-circuits before any of this, and a wrong arity on
# a resolved name is that name's ArityError, not the free function's.
let shadow_forms = ['.NAME(9)', '.NAME(k: 1)', '?.NAME()', '.NAME']
for n in ['size', 'add', 'to_string', 'drop', 'parameters', 'zzz'] {
  let decl = shadow_cands[0].replace("NAME", n)
  for f in shadow_forms {
    let call = f.replace("NAME", n)
    for r in ['5', '"ab"', '[1, 2]', '{a: 1}', '{1, 2}', 'nil', 'Math'] {
      case(
        "ufcsshadowform|" + n + "|" + call + "|" + r,
        decl + '; (' + r + ')' + call,
      )
    }
  }
}

print(out.join("\n"))
