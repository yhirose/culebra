# Categorize culebra binary code-size contribution by LLVM target/component.
# Port of tools/analysis/size_by_llvm_target.py.
#
# Approximates per-symbol size from sorted nm -n output (Mach-O nm does not
# emit sizes). Each T/t symbol's size is `next_addr - this_addr`.

import fmt from './fmt.cul'

let binary = !Sys.argv.empty() ? Sys.argv[0] : 'build/culebra'

let nm_out = Proc.run(["nm", "-n", binary], check: true).stdout
let entries = fmt.text_symbol_sizes(nm_out)
let total = entries.map(|e| e[1]).sum()
let demangled = fmt.demangle(entries.map(|e| e[0]))

# LLVM backend targets (folder names under llvm/lib/Target/).
let target_alias_pats = [
  ('X86',         '\bllvm::X86|\(anonymous namespace\)::X86'),
  ('AArch64',     '\bllvm::AArch64|\(anonymous namespace\)::AArch64'),
  ('ARM',         '\bllvm::ARM(?!V[0-9]*Reg)|\(anonymous namespace\)::ARM'),
  ('PowerPC',     '\bllvm::P(?:PC|owerPC)|\(anonymous namespace\)::PPC'),
  ('Mips',        '\bllvm::Mips|\(anonymous namespace\)::Mips'),
  ('RISCV',       '\bllvm::RISCV|\(anonymous namespace\)::RISCV'),
  ('WebAssembly', '\bllvm::(?:WebAssembly|WASM)|\(anonymous namespace\)::(?:WebAssembly|WASM)'),
  ('SystemZ',     '\bllvm::SystemZ|\(anonymous namespace\)::SystemZ'),
  ('Sparc',       '\bllvm::Sparc|\(anonymous namespace\)::Sparc'),
  ('AVR',         '\bllvm::AVR|\(anonymous namespace\)::AVR'),
  # AMDGPU has GCN/SI/R600 sub-prefixes too.
  ('AMDGPU',      '\bllvm::(?:AMDGPU|GCN|SI[A-Z]|R600)|\(anonymous namespace\)::(?:AMDGPU|GCN|SI[A-Z]|R600)'),
  ('NVPTX',       '\bllvm::NVPTX|\(anonymous namespace\)::NVPTX'),
  ('Hexagon',     '\bllvm::Hexagon|\(anonymous namespace\)::Hexagon'),
  ('Lanai',       '\bllvm::Lanai|\(anonymous namespace\)::Lanai'),
  ('BPF',         '\bllvm::BPF|\(anonymous namespace\)::BPF'),
  ('LoongArch',   '\bllvm::LoongArch|\(anonymous namespace\)::LoongArch'),
  ('VE',          '\bllvm::VE[A-Z]|\(anonymous namespace\)::VE[A-Z]'),
  ('XCore',       '\bllvm::XCore|\(anonymous namespace\)::XCore'),
  ('M68k',        '\bllvm::M68k|\(anonymous namespace\)::M68k'),
  ('MSP430',      '\bllvm::MSP430|\(anonymous namespace\)::MSP430'),
  ('Xtensa',      '\bllvm::Xtensa|\(anonymous namespace\)::Xtensa'),
  ('CSKY',        '\bllvm::CSKY|\(anonymous namespace\)::CSKY'),
  ('DirectX',     '\bllvm::(?:DirectX|DXIL)|\(anonymous namespace\)::(?:DirectX|DXIL)'),
  ('SPIRV',       '\bllvm::SPIRV|\(anonymous namespace\)::SPIRV'),
]
let target_res = target_alias_pats.map(|(t, pat)| (t, Regex.compile(pat)))

# Non-target LLVM components (rough buckets by namespace prefix). Array of
# pairs, not an Object, so first-match order (declaration order) is
# guaranteed rather than incidental.
let component_res = fmt.llvm_component_patterns.map(|(
  k,
  pat,
)| (k, Regex.compile(pat)))

# [symbol_count, byte_count] cells, keyed by target/component name. Built
# via to_object from (key, cell) pairs rather than a Counter-style
# increment loop — see sample_llvm_other.cul for why a bare `o[k] += v`
# doesn't work here (Object slots inserted via subscript default to
# immutable). Mutating the cell array in place, never reassigning the
# slot, sidesteps that. byte_count starts as a Float 0.0 rather than
# Long 0 so `cell[1] += size` promotes to Float on the first add (Either
# operand Float -> Float) — the display math below wants MB and %, and
# this way it never needs a per-print to_float(b).
let target_size = target_res.map(|(t, _)| (t, [0, 0.0])).to_object()
let comp_size = component_res.map(|(k, _)| (k, [0, 0.0])).to_object()
mut llvm_other = [0, 0.0]
mut non_llvm = [0, 0.0]

for i in 0..entries.size() {
  let name = demangled[i]
  let size = entries[i][1]

  let target_hit = target_res.find(|(_, p)| p.test(name))
  if target_hit != nil {
    let (t, _) = target_hit
    target_size[t][0] += 1
    target_size[t][1] += size
    continue
  }

  let comp_hit = component_res.find(|(_, p)| p.test(name))
  if comp_hit != nil {
    let (k, _) = comp_hit
    comp_size[k][0] += 1
    comp_size[k][1] += size
    continue
  }

  if name.contains('llvm::') {
    llvm_other[0] += 1
    llvm_other[1] += size
  } else {
    non_llvm[0] += 1
    non_llvm[1] += size
  }
}

let total_f = to_float(total)

println("binary: {binary}")
println("approx code (text): {total_f / 1024 / 1024:.2f} MB across {fmt.commas(entries.size())} symbols")
println()
println("=== LLVM TARGETS (cross-compile backends) ===")
println("{'target':<14} {'symbols':>9}   {'MB':>7}   {'%text':>6}")
mut target_total = 0.0
let target_sorted = target_size
  .iter()
  .collect()
  .sorted_by(|(_, cb)| cb[1], reverse: true)
for (t, cb) in target_sorted {
  let (c, b) = (cb[0], cb[1])
  if c == 0 {
    continue
  }
  target_total += b
  println("  {t:<12} {fmt.commas(c):>9}   {b/1024/1024:>7.2f}   {b/total_f*100:>5.2f}%")
}
println("  {'(targets sum)':<12} {'':>9}   {target_total/1024/1024:>7.2f}   {target_total/total_f*100:>5.2f}%")
println()
println("=== OTHER LLVM COMPONENTS ===")
println("{'component':<14} {'symbols':>9}   {'MB':>7}   {'%text':>6}")
mut comp_total = 0.0
let comp_sorted = comp_size
  .iter()
  .collect()
  .sorted_by(|(_, cb)| cb[1], reverse: true)
for (k, cb) in comp_sorted {
  let (c, b) = (cb[0], cb[1])
  comp_total += b
  println("  {k:<12} {fmt.commas(c):>9}   {b/1024/1024:>7.2f}   {b/total_f*100:>5.2f}%")
}
println("  llvm::other  {fmt.commas(llvm_other[0]):>9}   {llvm_other[1]/1024/1024:>7.2f}   {llvm_other[1]/total_f*100:>5.2f}%")
println()
println("=== NON-LLVM ===")
println("  {fmt.commas(non_llvm[0]):>9} symbols   {non_llvm[1]/1024/1024:>7.2f} MB   {non_llvm[1]/total_f*100:>5.2f}%")
