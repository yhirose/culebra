# Sample the 'llvm::other' bucket: top symbols by size + top namespace
# prefixes. Port of tools/analysis/sample_llvm_other.py — same nm -n +
# c++filt approach, same classification regexes.

import fmt from './fmt.cul'

let binary = !Sys.argv.empty() ? Sys.argv[0] : '/Users/yuji/Projects/culebra/build/culebra'

let nm_out = Proc.run(["nm", "-n", binary], check: true).stdout

# Next address strictly greater than raw[i]'s, scanning forward over a
# (possibly long) run of aliases at the same address; raw is sorted by
# address so the first greater one found is the right one. nil at the
# end of the table.
fn addr_after(raw, i) {
  let addr = raw[i][0]
  for j in i+1..raw.size() {
    if raw[j][0] > addr { return raw[j][0] }
  } nobreak {
    return nil
  }
}

let ws = re'\s+'
let candidates = nm_out.lines()
    .map(|line| ws.split(line.trim()))
    .filter(|parts| parts.size() == 3)

# addr, type, name — sorted by address. Mach-O nm has no size field, so
# each symbol's size is inferred as next_addr - this_addr below.
mut raw = []
for parts in candidates {
  try {
    raw.push((fmt.hex_to_long(parts[0]), parts[1], parts[2]))
  } catch e {
    # not a valid fixed-width hex address (e.g. a blank/undefined-symbol
    # row) — skip, matching the Python original's `except ValueError`.
  }
}
raw.sort_by(|t| t[0])

mut entries = []
for i in 0..raw.size() {
  let (addr, t, name) = raw[i]
  if t != 'T' && t != 't' { continue }
  let nxt = addr_after(raw, i)
  if nxt == nil { continue }
  let size = nxt - addr
  if size > 0 && size <= 10 * 1024 * 1024 {
    entries.push((name, size))
  }
}

let names = entries.map(|e| e[0])
let demangled = Proc.run(["c++filt"], stdin: names.join("\n"))
    .stdout.trim_end("\n").split("\n")

let known_targets = ['X86', 'AArch64', 'ARM', 'PowerPC', 'Mips', 'RISCV',
  'WebAssembly', 'SystemZ', 'Sparc', 'AVR', 'AMDGPU', 'NVPTX', 'Hexagon',
  'Lanai', 'BPF', 'LoongArch', 'VE', 'XCore', 'M68k', 'MSP430', 'Xtensa',
  'CSKY', 'DirectX', 'SPIRV']
let target_pat = Regex.compile('\bllvm::(' + known_targets.join('|') + ')\b')
let component_pats = [
  re'\bllvm::orc::',
  re'\bllvm::MC[A-Z]|\bllvm::mc::',
  re'\bllvm::(MachineFunction|MachineInstr|SelectionDAG|LiveInterval|RegAlloc)',
  re'\bllvm::(IRBuilder|Module|Function|Instruction|BasicBlock|Constant|GlobalVariable|Type|Value)\b',
  re'\bllvm::(StringRef|SmallVector|DenseMap|StringMap|Triple|raw_|ErrorOr|Optional|cl::)',
  re'\bllvm::(LoopInfo|ScalarEvolution|AAResults|DominatorTree|MemorySSA|TargetLibraryInfo)',
  re'\bllvm::(PassBuilder|InstCombine|GVN|SimplifyCFG|LoopVectorize|SLPVectorizer)',
  re'\bllvm::(DWARF|DIE|DebugInfo|DIBuilder)',
  re'\bllvm::Bitcode',
  re'\bllvm::object::',
]

fn classified(name) {
  if target_pat.test(name) { return true }
  for p in component_pats {
    if p.test(name) { return true }
  } nobreak {
    return false
  }
}

# Filter to llvm::other (unclassified llvm:: symbols).
mut other = []
for i in 0..entries.size() {
  let n = demangled[i]
  if n.contains('llvm::') && !classified(n) {
    other.push((n, entries[i][1]))
  }
}
other.sort_by(|pair| pair[1], reverse: true)

println("=== top 30 'llvm::other' symbols by size ===")
for (n, s) in other[..30] {
  println("  {fmt.commas(s):>8}  {n[..200]}")
}

# Second-level namespace under llvm:: — group_by + reduce instead of a
# Counter loop (Object properties inserted via `o[k] = v` are immutable
# by default, so a `counts[k] = counts.get(k, 0) + v` re-assign throws
# ImmutableError on the second hit for the same key).
let ns2_pat = re'\bllvm::(\(anonymous namespace\)::)?([A-Za-z0-9_]+)'
fn ns2_key((n, s)) {
  let m = ns2_pat.find(n)
  m != nil ? m[2] : '<other>'
}
let ns2 = other.group_by(ns2_key)
    .iter()
    .map(|(k, items)| (k, items.reduce(0, |acc, (_, s)| acc + s)))
    .to_object()
let ns2_sorted = ns2.iter().collect().sorted_by(|(_, v)| v, reverse: true)

println()
println("=== top 30 second-level prefixes under llvm:: in 'other' ===")
for (k, v) in ns2_sorted[..30] {
  println("  {to_float(v) / 1024 / 1024:>6.2f} MB   llvm::{k}")
}
