# Slicing — literal and stored range keys over the three receivers
# (Array shallow copy, String byte view, Tuple new tuple), every bound
# form, and range values as first-class objects.
let a = [1, 2, 3, 4, 5]
println(a[1..3])
println(a[1..=3])
println(a[..2])
println(a[2..])
println(a[..])
println(a[-3..-1])
println(a[3..1])
println(a[2..99])
println(a[-99..2])

# A slice ignores `by` (the stored range keeps it for iteration).
println(a[0..4 by 2])

# Array slice is a shallow copy: writes to the source stay unseen.
mut src = [1, 2, 3]
let copy = src[0..2]
src[0] = 9
println(src)
println(copy)

# String and Tuple receivers.
let s = "hello"
println(s[1..3])
println(s[..])
println(s[2..])
let tp = (1, 2, 3, 4)
println(tp[1..3])

# Stored ranges slice like literals; open forms and the bare `..` are
# first-class values.
let r = 1..4
println(a[r])
println(s[r])
println(tp[r])
let open_start = ..2
let open_end = 2..
let full = ..
println(a[open_start])
println(a[open_end])
println(a[full])

# Range display and structural equality.
println(r)
println(1..=3)
println(2..8 by 3)
println(r == 1..4)
println(r == 1..=4)

# Endpoints evaluate receiver-first, left to right, checked as they go.
fn t(x, v) {
  println(x)
  v
}
println(t("recv", a)[t("s", 0)..t("e", 3) by t("st", 1)])

# Chains: a slice result indexes on, and a call result slices.
let n = [[1, 2, 3], [4, 5, 6]]
println(n[0][1..3])
println(n[1..][0])
fn f() {
  [10, 20, 30]
}
println(f()[1..])

# Slice errors are catchable: non-sliceable receiver, both key shapes.
mut marker = ""
try {
  5[0..1]
} catch e {
  marker = "recv"
}
println(marker)
try {
  range(0, 3)[0..1]
} catch e {
  marker = "plain-object recv"
}
println(marker)

# Counted range `for` still takes the literal fast path.
mut sum = 0
for i in 1..=3 {
  sum += i
}
println(sum)
