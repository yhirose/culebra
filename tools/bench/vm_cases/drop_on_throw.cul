# A throw that escapes a frame releases the frame's slots on the way out, so
# a value with a `drop` dies deterministically there — the frame cleanup
# ladder, whose normal-path twin is the scope ladders the compiler emits.
# Order: the frame's pending defers first, then its slots in reverse.

class R {
  n = 0
  new(k) { self.n = k }
  drop() { println('drop ' + to_string(self.n)) }
}

# --- Plain locals, innermost frame first ---------------------------------
fn inner() {
  let a = R.new(1)
  let b = R.new(2)
  throw 'x'
}
fn outer() {
  let c = R.new(3)
  inner()
}
println(try { outer() } catch e { 'caught' })

# --- Defers run before the releases --------------------------------------
println('--- defers')
fn withdefer() {
  let a = R.new(4)
  defer { println('defer 1') }
  let b = R.new(5)
  defer { println('defer 2') }
  throw 'x'
}
println(try { withdefer() } catch e { 'caught' })

# The same order on the normal path: the body's locals are the frame's, so
# they release after the frame's defers.
println('--- normal path')
fn normal() {
  let a = R.new(6)
  defer { println('defer normal') }
  0
}
println(normal())

# --- A parent's cascade, and an Array of them ----------------------------
println('--- cascade')
class Holder {
  a = nil
  b = nil
  new(x, y) { self.a = x ; self.b = y }
  drop() { println('drop holder') }
}
fn cascade() {
  let h = Holder.new(R.new(7), R.new(8))
  throw 'x'
}
println(try { cascade() } catch e { 'caught' })
fn arr() {
  let xs = [R.new(9), R.new(10)]
  throw 'x'
}
println(try { arr() } catch e { 'caught' })

# --- Nested blocks and loop bodies ---------------------------------------
println('--- scopes')
fn blocks() {
  let o = R.new(11)
  {
    let i = R.new(12)
    throw 'x'
  }
}
println(try { blocks() } catch e { 'caught' })
fn loops() {
  for i in 0..3 {
    let a = R.new(20 + i)
    if i == 1 { throw 'x' }
  }
}
println(try { loops() } catch e { 'caught' })

# --- A handler that re-throws: its ladder, then the frame's --------------
println('--- rethrow')
fn rethrow() {
  let o = R.new(30)
  try {
    let i = R.new(31)
    throw 'x'
  } catch e {
    println('caught inside')
    throw 'again'
  }
}
println(try { rethrow() } catch e { 'caught outside' })

# --- A method frame: the receiver is a slot like any other ---------------
println('--- receiver')
class M {
  r = nil
  new() { self.r = R.new(40) }
  boom() {
    let local = R.new(41)
    throw 'x'
  }
  drop() { println('drop instance') }
}
fn usemethod() {
  M.new().boom()
}
println(try { usemethod() } catch e { 'caught' })

# --- A constructor that fails after allocating --------------------------
println('--- ctor')
class D {
  x = 1
  new(a: Long) { self.x = a }
  drop() { println('drop D') }
}
println(try { D.new() } catch e { e.kind })
println(try { D.new('x') } catch e { e.kind })

# --- Scope by scope: each scope's defers, then its own bindings ----------
# The unwind walks outward one scope at a time, so a `defer` and the drops of
# the scope it guards interleave rather than running in two blocks.
println('--- interleaved')
fn interleaved() {
  let a = R.new(50)
  defer { println('defer frame') }
  {
    let b = R.new(51)
    defer { println('defer inner') }
    throw 'x'
  }
}
println(try { interleaved() } catch e { 'caught' })

# The same inside a try: the nested scope's step runs before the try body's,
# and the catch only sees what is left.
println('--- interleaved try')
fn interleaved_try() {
  try {
    defer { println('defer try') }
    {
      let b = R.new(52)
      throw 'x'
    }
  } catch e {
    println('caught inside')
  }
}
println(interleaved_try())

# In-flight temporaries of the throwing expression die before any defer.
println('--- temps first')
fn temps(d: Long) {
  defer { println('defer temps') }
  let xs = [R.new(53), R.new(54), 1 / d]
  xs
}
println(try { temps(0) } catch e { e.kind })

# --- A captured local releases in declaration order ----------------------
# Its cell is created ahead of the scope (forward-ref support), which must not
# move its drop ahead of a local declared before it.
println('--- captured')
fn captured() {
  let first = R.new(60)
  let held = R.new(61)
  println(to_string((fn () { held.n })()))
  throw 'x'
}
println(try { captured() } catch e { 'caught' })

# --- A drop body that throws is logged and swallowed ---------------------
# The error already unwinding survives it (the thrown payload is carried in a
# global the body's own throw would otherwise overwrite).
println('--- noisy drop')
class Noisy {
  drop() { println('drop noisy') ; throw 'from drop' }
}
fn noisy() {
  let n = Noisy.new()
  throw 'original'
}
println(try { noisy() } catch e { 'caught ' + e })

# --- Construction interrupted mid-way ------------------------------------
# A throw while a call's argument list / a container literal is still being
# built releases the temporaries already evaluated. The release order must
# not depend on how the host STL tears down the staging buffer (libstdc++
# destroys a vector forward, libc++ backward) — the three lanes must agree.
println('--- args interrupted')
fn bad() { throw 'x' }
fn takes3(a, b, c) { nil }
println(try { takes3(R.new(70), R.new(71), bad()) ; 0 } catch e { 'caught' })

println('--- tuple interrupted')
fn tuple_interrupted() {
  let t = (R.new(72), R.new(73), bad())
}
println(try { tuple_interrupted() ; 0 } catch e { 'caught' })

println('--- dict interrupted')
fn dict_interrupted() {
  let d = {'a': R.new(74), 'b': R.new(75), 'c': bad()}
}
println(try { dict_interrupted() ; 0 } catch e { 'caught' })

# --- Non-string-keyed props and Set members --------------------------------
# These live in stores of their own (the non-string prop table, the Set's
# member vector) — their teardown order must be as pinned as the others'.
println('--- non-string keys')
fn nsk() {
  let d = {10: R.new(76), 20: R.new(77), 30: R.new(78)}
  throw 'x'
}
println(try { nsk() ; 0 } catch e { 'caught' })

println('--- set members')
class H {
  n = 0
  new(k) { self.n = k }
  drop() { println('drop ' + to_string(self.n)) }
  hash() { self.n }
  eq(other) { self.n == other.n }
}
fn setdrop() {
  let s = {H.new(85), H.new(86), H.new(87)}
  throw 'x'
}
println(try { setdrop() ; 0 } catch e { 'caught' })

# --- Churn: the ladder runs on every one of these ------------------------
# A counting drop rather than a printing one — the interest is that the
# releases happen every time, not the transcript.
mut dropped = 0
class Q {
  n = 0
  new(k) { self.n = k }
  drop() { dropped = dropped + 1 }
}
fn churn() {
  let a = Q.new(1)
  let b = [Q.new(2), Q.new(3)]
  throw 'x'
}
mut caught = 0
for i in 0..2000 {
  caught += try { churn() ; 0 } catch e { 1 }
}
println([caught, dropped])
println('drop_on_throw OK')
