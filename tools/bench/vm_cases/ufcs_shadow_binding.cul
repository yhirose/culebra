# A binding of a built-in method's name that is NOT a Function declines the
# UFCS gate. What answers then is the receiver's ordinary property read — not
# the built-in: `to_string` has no receiver gate of its own, so routing the
# declined arm back through it would let it take a receiver the gate had just
# ruled out (a class instance resolves no `to_string` of its own).
#
# The shadowing bindings make `to_string` itself unusable here, so the
# printing goes through interpolation.
class Sc {
  new() { self.f = 1 }
}

let to_string = 5
println("{try { Sc.new().to_string() } catch e { e.kind + '|' + e.message }}")
println("{try { (5).to_string() } catch e { e.kind + '|' + e.message }}")
println("{try { [1].to_string() } catch e { e.kind + '|' + e.message }}")
println("{try { 'ab'.to_string() } catch e { e.kind + '|' + e.message }}")
println("{try { nil.to_string() } catch e { e.kind + '|' + e.message }}")

let size = 'not a function'
println("{try { Sc.new().size() } catch e { e.kind + '|' + e.message }}")
println("{try { [1, 2].size() } catch e { e.kind + '|' + e.message }}")
println("{try { (5).size() } catch e { e.kind + '|' + e.message }}")
# The receiver still owes its own arity diagnostic where it does resolve it.
println("{try { [1, 2].size(1) } catch e { e.kind + '|' + e.message }}")

let take = nil
println("{try { [1, 2].take(1) } catch e { e.kind + '|' + e.message }}")
println("{try { range(0, 3).take(1).collect() } catch e { e.kind + '|' + e.message }}")
