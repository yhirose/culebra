# Set-only methods: union/intersect/diff/sym_diff/subset/superset (both
# operands Set, borrowed — the runtime helper retains fresh copies or just
# compares), add/remove (mutating: add absorbs the argument's `+1`, remove
# only hashes it for lookup), and to_array (shared with Tuple and Tensor —
# three unrelated value tables bind this one name, so the gate lets all
# three through and dispatches on the receiver tag).

let a = Set(1, 2, 3)
let b = Set(2, 3, 4)
inspect(a.union(b).to_array())
inspect(a.intersect(b).to_array())
inspect(a.diff(b).to_array())
inspect(a.sym_diff(b).to_array())
inspect(a.subset(b))
inspect(a.subset(Set(1, 2, 3, 4)))
inspect(a.superset(b))
inspect(Set(1, 2).superset(Set(1)))
inspect(a.to_array())

mut s = Set(1, 2)
inspect(s.add(3))
inspect(s.add(1))
inspect(s.to_array())
inspect(s.remove(1))
inspect(s.remove(99))
inspect(s.to_array())

# Self-referential: union/intersect/subset/superset with the receiver itself.
mut self_s = Set(1, 2)
inspect(self_s.union(self_s).to_array())
inspect(self_s.intersect(self_s).to_array())
inspect(self_s.subset(self_s))
inspect(self_s.superset(self_s))

# Aliasing: the set is one object seen through two names.
mut al = Set(1)
let same = al
al.add(2)
inspect(same.to_array())

# Heap elements: a Tuple is hashable (element-wise) and RC-real, unlike an
# Array or Object, so it is the one heap value a Set can actually hold —
# every insert/remove below moves a real refcount.
mut h = Set((1, 2))
h.add('s')
h.add((3, 4))
inspect(h.to_array())
inspect(h.remove((1, 2)))
inspect(h.to_array())

# Empty-set operations.
inspect(Set(1).diff(Set(1)).to_array())
inspect(Set(1).diff(Set(1)).empty())

# Churn: build and drain repeatedly, with a fresh heap value each round.
mut i = 0
while i < 300 {
    mut t = Set((i,))
    t.add((i, i))
    let u = t.union(Set((i,)))
    let d = t.diff(Set((i,)))
    t.remove((i,))
    i = i + 1
}
println(i)

# The errors: the receiver gate, the parameter checks and the runtime's own
# unhashable-element rejection, each at its own anchor.
try {
    Set(1, 2).union(5)
} catch err {
    println("{err.kind}: {err.message}")
}
try {
    Set(1, 2).subset('x')
} catch err {
    println("{err.kind}: {err.message}")
}
try {
    Set(1, 2).add([1, 2])
} catch err {
    println("{err.kind}: {err.message}")
}
try {
    Set(1, 2).union(Set([1, 2]))
} catch err {
    println("{err.kind}: {err.message}")
}

# A receiver that resolves no such method: a scalar fails at the property
# read, anything else only after the arguments have run.
fn seen(x) {
    println("ran {x}")
    x
}
try {
    (5).union(seen(1))
} catch err {
    println("{err.kind}: {err.message}")
}
try {
    [1, 2].add(seen(2))
} catch err {
    println("{err.kind}: {err.message}")
}
try {
    'ab'.remove(seen(3))
} catch err {
    println("{err.kind}: {err.message}")
}

# An argument that throws leaves the receiver untouched.
mut k = Set(1)
try {
    k.add(seen(4) / 0)
} catch err {
    println(err.kind)
}
inspect(k.to_array())
