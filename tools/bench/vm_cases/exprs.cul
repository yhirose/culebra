# The expression core: literals of every slice type, arithmetic dispatch,
# unary ops, and value-position control flow.
println(1 + 2 * 3 - 4)
println(7 / 2)
println(7 % 3)
println(2.5 + 1)
println(1 / 2.0)
println(7.5 % 2)
println(-2.5)
println(-(1 + 2))
println(+5)
println(!true)
println(!(1 == 2))
println(nil)
println(true)
println(3.25)

# `let` evaluates to the assigned value; blocks yield their last statement.
let a = if true { 1 } else { 2 }
println(a)
let b = if false { 1 }
println(b)
let c = if true { let x = 5 }
println(c)
let d = while false { 1 }
println(d)
let e = if true { 7; 8 }
println(e)
let f = if 1 > 2 { 1 } else if 1 > 0 { 22 } else { 3 }
println(f)
println(if false { 1 } else if false { 2 })

# Ternary shares the IF shape.
let t = true ? 'yes' : 'no'
println(t)
