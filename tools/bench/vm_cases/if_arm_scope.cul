# An `if` / `cond` / `?:` arm is a scope of its own, one statement or many:
# what it declares ends with the arm, on every backend. A value leaves an arm
# as the construct's value, and a test is no part of an arm.

# --- A value leaves as the construct's value ------------------------------
println('--- value')
let a = if true { let t = 'then'; t } else { 'else' }
println(a)
let b = if false { 1 } else if true { let t = 2; t } else { 3 }
println(to_string(b))
let c = cond { false => 'no', _ => { let t = 'default'; t } }
println(c)
let d = true ? (let t = 'ternary') : 'other'
println(d)

# --- A name an arm hides means the outer one again after it --------------
println('--- shadowing')
let f = 'outer'
if true { let f = 'inner'; println(f) }
println(f)
if false { let f = 'inner' }
println(f)
cond { true => { let f = 'cond'; println(f) }, _ => 0 }
println(f)
true ? (let f = 'ternary') : 0
println(f)

# --- The arms declare one name each, with their own mutability ------------
println('--- arms apart')
let pick = fn (p) {
  if p {
    mut v = 1
    v = v + 1
    v
  } else {
    v = 10
    try { fn () { v = 20 }() } catch err { err.kind }
  }
}
println(to_string(pick(true)))
println(pick(false))

# --- After the arms the name is free: a bare write declares it ------------
println('--- free again')
let again = fn (p) {
  if p { h = 1 } else { h = 2 }
  h = 5
  h
}
println(to_string(again(true)))

# --- Every declaring shape stays in the arm --------------------------------
println('--- shapes')
fn g(x: Long) { 'outer g' }
if true {
  fn g(x: String) { 'arm g' }
  println(g('s'))
  class K { new(n) { self.n = n } }
  println(to_string(K.new(3).n))
  enum E { A, B }
  println(to_string(E.A == E.A))
  let [i, j] = [4, 5]
  println(to_string(i + j))
}
println(g(1))
println(try { g('s') } catch err { err.kind })

# --- A declaring test is not an arm: the name is the scope's around -------
println('--- declaring test')
if let m = 8 { let n = m + 1; println(to_string(n)) }
println(to_string(m))
if false { 0 } else if (let o = 9) > 0 { println(to_string(o)) }
println(to_string(o))
let skipped = fn (p) {
  if p { 0 } else if (let q = 1) > 0 { 0 }
  try { q } catch err { err.kind }
}
println(to_string(skipped(false)))
println(skipped(true))

# --- A closure made in an arm keeps the arm's variable ---------------------
println('--- capture')
mut readers = []
for x in 0..3 {
  if x != 1 {
    let p = x * 100
    readers.push(|| p)
  }
}
println(to_string(readers.map(|r| r())))

# --- A defer in an arm runs when the arm ends ------------------------------
println('--- defer')
let run_defer = fn (p) {
  if p {
    defer { println('arm defer') }
    println('arm body')
  } else {
    println('else body')
  }
  println('after if')
}
run_defer(true)
run_defer(false)

# --- Resources: an arm's value drops when the arm ends ---------------------
println('--- drop')
class R {
  new(n) { self.n = n }
  drop() { println("drop {self.n}") }
}
let run = fn () {
  let first = R.new(1)
  if true { let w = R.new(2) }
  println('inside')
}
run()
println('after')

# --- Churn: an arm's slot is reused every turn, nothing accumulates --------
println('--- churn')
mut total = 0
for x in 0..2000 {
  if x % 2 == 0 {
    let y = [x]
    total = total + y.size()
  } else {
    let y = 'odd'
    total = total + 0
  }
}
println(to_string(total))
