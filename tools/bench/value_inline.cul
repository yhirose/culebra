# What an unboxed `@value` chain costs against the boxed form of the same
# work, and against the hand-written scalars both are trying to reach.
#
# Each row does the same arithmetic and prints the same checksum. What differs
# is only whether the intermediate 2D value is an object:
#
#   scalars              the floor — every component in its own local
#   inlined chain        `V2.new(a, b).len()`: the whole chain qualifies, so
#                        it compiles to slots, no object and no call
#   boxed chain          the same work through a name, which is a run with
#                        nowhere to go — it builds the instance the old way
#   scalars, op form      the floor for the operator rows below — elementwise
#                        add then length, in locals
#   operator, inlined     `(V2.new(a,b) + V2.new(c,d)).len()`: operand[0] is a
#                        fresh construction, so the fold's own `+` splices
#                        `__add__` instead of reaching the runtime dispatch —
#                        this is what Stage 2c (operator dispatch) adds on
#                        top of Stage 1's chain inlining above
#   operator, boxed       the identical arithmetic through `__add__`, but each
#                        operand comes back from an ordinary function
#                        (`make(x, y)`) instead of a literal `C.new(...)` — not
#                        a construction chain the compiler can name, so the
#                        fold declines and reaches `__add__` through the
#                        ordinary runtime dispatch (`_dispatch_arith_special`)
#                        this row and the inlined one differ ONLY in whether
#                        the compiler could see the constructions, so their gap
#                        is 2c's own contribution — not construction cost,
#                        which the (fresh-construction) inlined row still pays
#   scalars (control)    two rows doing identical arithmetic; if these two
#                        disagree by more than a few percent the run is noise
#                        and should be thrown away
#   mut, reused           `let mut v = V2.new(...)` reassigned every
#                        iteration as `v = v + V2.new(...)` (Stage 3, spec
#                        §15): `v` itself never allocates — the whole-scope
#                        walk proved every reference to it eligible before
#                        the loop ever compiled, so its two fields live in
#                        the same two frame slots for the loop's entire run.
#                        The OTHER operand (the fresh `V2.new(...)`) is
#                        still a construction each iteration and still
#                        reifies (2c's own operand[1] rule, unchanged) —
#                        this row isolates what Stage 3 alone buys over 2c:
#                        one allocation removed per iteration, not two
#   mut, boxed             identical arithmetic, but `v`'s own declaration
#                        goes through `make(x, y)` instead of a literal
#                        `V2.new(...)` — not a construction chain the
#                        whole-scope walk can name, so `v` never leaves the
#                        boxed path. The gap between this row and the one
#                        above is Stage 3's own contribution, the same way
#                        `operator, boxed` isolates 2c's
#

# Run on the -O3 + LTO binary (`just build`); build-dev is -O1 and the numbers
# mean nothing there. Read the ratios within one run, not across machines.
#
#   culebra tools/bench/value_inline.cul [iterations]
#   culebra --jit tools/bench/value_inline.cul [iterations]

let N = !Sys.argv.empty() ? to_long(Sys.argv[0]) : 1000000

@value
class V2 {
  x: Float
  y: Float

  new(x: Float, y: Float) {
    self.x = x
    self.y = y
  }

  len() {
    Math.sqrt(self.x * self.x + self.y * self.y)
  }

  __add__(o) {
    V2.new(self.x + o.x, self.y + o.y)
  }
}

# Not a `C.new(...)` chain from the call site's point of view — the fold's
# own lookahead (fold_resolves_to_class) requires operand[0] to be that
# literal shape, so a value coming back through this ordinary function
# always reaches the boxed operator dispatch, on purpose.
let make = fn (x, y) {
  V2.new(x, y)
}

let report = fn (name, dt, acc) {
  println("  {name:<28}{dt / N * 1e9:>8.1f}  ns/op   {acc:>18.6f}")
}

let scalars = fn () {
  let mut acc = 0.0
  for i in 0..N {
    let x = to_float(i % 7)
    let y = to_float(i % 5)
    acc += Math.sqrt(x * x + y * y)
  }
  acc
}

let inlined = fn () {
  let mut acc = 0.0
  for i in 0..N {
    acc += V2.new(to_float(i % 7), to_float(i % 5)).len()
  }
  acc
}

let boxed = fn () {
  let mut acc = 0.0
  for i in 0..N {
    let v = V2.new(to_float(i % 7), to_float(i % 5))
    acc += v.len()
  }
  acc
}

let scalars_op = fn () {
  let mut acc = 0.0
  for i in 0..N {
    let ax = to_float(i % 7)
    let ay = to_float(i % 5)
    let bx = to_float(i % 3)
    let by = to_float(i % 11)
    let sx = ax + bx
    let sy = ay + by
    acc += Math.sqrt(sx * sx + sy * sy)
  }
  acc
}

let op_inlined = fn () {
  let mut acc = 0.0
  for i in 0..N {
    acc += (V2.new(to_float(i % 7), to_float(i % 5)) +
      V2.new(to_float(i % 3), to_float(i % 11))).len()
  }
  acc
}

let op_boxed = fn () {
  let mut acc = 0.0
  for i in 0..N {
    acc += (make(to_float(i % 7), to_float(i % 5)) +
      make(to_float(i % 3), to_float(i % 11))).len()
  }
  acc
}

let mut_reused = fn () {
  let mut v = V2.new(0.0, 0.0)
  for i in 0..N {
    v = v + V2.new(to_float(i % 7), to_float(i % 5))
  }
  v.x + v.y
}

let mut_boxed = fn () {
  let mut v = make(0.0, 0.0)
  for i in 0..N {
    v = v + V2.new(to_float(i % 7), to_float(i % 5))
  }
  v.x + v.y
}

println("value inline, {N} iterations")
println("")

let run = fn (name, f) {
  let t0 = Time.monotonic()
  let acc = f()
  report(name, Time.monotonic() - t0, acc)
}

run('scalars', scalars)
run('inlined chain', inlined)
run('boxed chain', boxed)
run('scalars, op form', scalars_op)
run('operator, inlined', op_inlined)
run('operator, boxed', op_boxed)
run('mut, reused', mut_reused)
run('mut, boxed', mut_boxed)
run('scalars (control)', scalars)
