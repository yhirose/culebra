# The prebuilt static LLVM that misc/prebuilt_llvm.sh fetches: releases of
# https://github.com/yhirose/culebra-llvm, one per platform. A platform with no
# entry builds against the LLVM cmake finds, as before.
#
# To add a platform, add its three lines here (the key is
# `<uname -s>_<uname -m>`, lower case, MSYS and MinGW shells as `windows`):
#   PREBUILT_LLVM_<KEY>_TAG     the release tag
#   PREBUILT_LLVM_<KEY>_ASSET   the .tar.zst asset in that release
#   PREBUILT_LLVM_<KEY>_SHA256  its SHA256 (the release page shows it)

PREBUILT_LLVM_darwin_arm64_TAG=llvm-23.1.5-r1
PREBUILT_LLVM_darwin_arm64_ASSET=llvm-23.1.5-macos-arm64.tar.zst
PREBUILT_LLVM_darwin_arm64_SHA256=a717332e48ea1b017669f66d4546f13cf629c8df96da57142c71f7ec3099cceb
