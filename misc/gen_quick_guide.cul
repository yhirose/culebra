# Regenerate the signature index inside docs/quick-guide.md and
# docs/quick-guide.ja.md from the reference docs, so the context pack can
# never drift from them.
#
#   just gen-quick-guide            rewrite the generated section
#   just check-quick-guide          exit 1 if it is stale (CI gate)
#
# Signatures live in three markdown shapes in docs/:
#   heading   ### `Math.abs(x) -> Long`
#   table     | `Hash.sha256(s) -> String` | desc |
#             | `Regex.escape(s)`          | `String` — desc |   (return in cell 2)
#   bullet    * **`assert_eq(a, b) -> Nil`** — desc

BEGIN_MARK = '<!-- BEGIN GENERATED: signature index -->'
END_MARK = '<!-- END GENERATED -->'

# The whole documented surface, one signature per line, for
# tools/checks/check_api_coverage.sh. That gate's population has to be
# everything the reference documents, not the part the context pack lists
# inline -- reading it off the pack would have quietly halved what it measures
# the moment a namespace moved to being named rather than listed.
SURFACE = 'tools/checks/api_surface.txt'

HEADING = re'^#{3,5} (.+)$'
TABLE = re'^\|\s*`([^`]+)`([^`|]*)\|(.*)$'
# The same row, when its first cell holds SEVERAL signatures
# (`m.index(...)` / `m.set_index(...)`): TABLE cannot match one at all --
# its note group stops at the next backtick -- so the whole row, every
# signature in it, used to be dropped. Ten of stdlib.md's own were.
TABLE_MULTI = re'^\|\s*(`[^`]+`[^|]*)\|(.*)$'
BULLET = re'^\s*[*-]\s+\*\*`([^`]+)`\*\*'
BARE = re'^`[A-Za-z_][A-Za-z0-9_.]*`$'
CELL_RET = re'^\s*`([^`]+)`\s*(—|-|$)'
# A signature is a (possibly dotted, possibly receiver-less) name applied to
# arguments, or a bare constant. Reference tables also hold worked idioms
# (`let f = File.open(p, m); defer { f.close() }`) — those are not signatures,
# and their `;` would collide with the separator this index joins on.
SIG_SHAPE = re'^\.?[A-Za-z_][A-Za-z0-9_.]*(\(|$)'
SPAN = re'`[^`]+`'
NS_HEADING = re'^## \d+\. (.+)$'
# stdlib.md's own index: `27. [`Scene`](#27-scene) — one line about it`. The
# summaries a named-only namespace carries below come from there, so there is
# still one place to edit when a namespace changes.
INDEX_ROW = re'^\d+\. \[([^\]]+)\]\([^)]+\)\s+—\s+(.+)$'

# These namespaces are named rather than listed signature by signature. Each
# drives a stateful subsystem -- a view and a frame loop, an open connection,
# a grammar, an emitter -- where the signatures alone do not say how to drive
# it, so a reader holding only them writes code that lints and does not run.
# They are also half of every signature here, spent on whichever subsystem the
# task at hand is not about. `culebra docs stdlib <name>` prints one whole.
# Membership only: the table keeps stdlib.md's chapter order.
BY_NAME = {
  'SQLite',
  'Canvas',
  'Scene',
  'Net',
  'Desktop / Webview',
  'PEG',
  'CodeGen',
  'StateMachine',
  'FST',
  'Search',
}

# The six built-in-type groups live in language.md; every other group is one
# stdlib.md namespace. Only the Set anchor differs between en and ja — the
# rest are numbered headings, which translation preserves.
fn builtin_groups(ja) {
  [
    {
      title: ja ? '文字列メソッド' : 'String methods',
      from: '### 18.1 ',
      to: '### 18.2 ',
    },
    {
      title: ja ? '配列メソッド' : 'Array methods',
      from: '### 18.2 ',
      to: '### 18.3 ',
    },
    {
      title: ja ? 'オブジェクトメソッド' : 'Object methods',
      from: '### 18.3 ',
      to: '### 18.4 ',
    },
    {
      title: ja ? 'セットのメソッド' : 'Set methods',
      from: ja ? '## 集合' : '## Sets',
      to: '## 11. ',
    },
    {
      title: ja ? 'イテレータメソッド' : 'Iterator methods',
      from: '### 18.5 ',
      to: '## 19. ',
    },
    {
      title: ja ? 'コア組み込み関数' : 'Core built-ins',
      from: '## 19. ',
      to: '## 20. ',
    },
  ]
}

fn strip_ticks(t) {
  t.slice(1, t.size() - 1).to_string()
}

fn unescape(s) {
  s.replace('\|', '|').to_string()
}

fn ret_of(cell) {
  m = CELL_RET.find(cell)
  if m == nil {
    nil
  } else {
    r = m[1]
    r.contains('(') || r.size() > 40 ? nil : r.to_string()
  }
}

# Every signature in `lines`, in source order, with duplicates dropped.
fn harvest(lines) {
  mut seen = {}
  mut out = []
  for line in lines {
    mut cands = []
    hm = HEADING.find(line)
    if hm != nil {
      title = hm[1].trim()
      # one heading may carry several: ### `Math.sin(x)`, `Math.cos(x)`
      for span in SPAN.find_all_str(title) {
        inner = strip_ticks(span)
        cands.push(unescape(inner)) if inner.contains('(')
      }
      # a bare `Math.pi` heading is a constant, worth listing
      if cands.size() == 0 && BARE.test(title) {
        cands.push(strip_ticks(title))
      }
    } else {
      tm = TABLE.find(line)
      if tm != nil && tm[1].contains('(') {
        mut sig = unescape(tm[1])
        if !sig.contains('->') {
          r = ret_of(tm[3])
          sig = sig + ' -> ' + r if r != nil
        }
        # a trailing `*(mutating)*` on the same cell is worth carrying over
        note = tm[2].replace('*', '').trim()
        if note.size() > 0 && note.size() <= 20 {
          sig = sig + ' ' + note.to_string()
        }
        cands.push(sig)
      } else {
        mm = TABLE_MULTI.find(line)
        if mm != nil {
          # Several signatures in one cell: each takes the row's return type,
          # but not the trailing note above — between two of them that text is
          # only the ` / ` separating them.
          r = ret_of(mm[2])
          for span in SPAN.find_all_str(mm[1]) {
            inner = unescape(strip_ticks(span))
            if inner.contains('(') {
              cands.push(r == nil || inner.contains('->')
                ? inner
                : inner + ' -> ' + r)
            }
          }
        } else {
          bm = BULLET.find(line)
          cands.push(unescape(bm[1])) if bm != nil && bm[1].contains('(')
        }
      }
    }
    for sig in cands {
      if SIG_SHAPE.test(sig) && !sig.contains('…') && !seen.has(sig) {
        seen[sig] = true
        out.push(sig)
      }
    }
  }
  out
}

fn slice_lines(lines, from, to) {
  mut out = []
  mut inside = false
  for line in lines {
    if inside {
      break if line.starts_with(to)
      out.push(line)
    } else if line.starts_with(from) {
      inside = true
    }
  }
  out
}

fn read_lines(path) {
  mut out = []
  for raw in FS.read(path).split("\n") {
    out.push(raw.to_string())
  }
  out
}

# Every group has the same shape — {title, sigs, experimental, by_name,
# summary} — in document order, language.md's built-in types first. Whether a
# group is listed inline or only named is a flag read at render time, so the
# surface file below is ordered by the reference, not by that choice.
fn group(title, sigs) {
  {title: title, sigs: sigs, experimental: false, by_name: false, summary: ''}
}

# A namespace whose own section calls itself **experimental** carries the mark
# into the index, so the one file written to be read whole says which entries
# a released binary may not have. stdlib.md stays the single source.
fn ns_group(title, buf, summaries) {
  {
    ...group(title, harvest(buf)),
    experimental: buf.any(|line| line.contains('**experimental**')),
    by_name: BY_NAME.contains(title),
    summary: summaries.get(title, ''),
  }
}

# One group per `## N. Name` section of stdlib.md.
fn namespace_groups(lines) {
  summaries = index_summaries(lines)
  mut out = []
  mut title = nil
  mut buf = []
  for line in lines {
    if line.starts_with('## ') {
      if title != nil {
        out.push(ns_group(title, buf, summaries))
      }
      m = NS_HEADING.find(line)
      title = m == nil ? nil : m[1].replace('`', '').trim().to_string()
      buf = []
    } else if title != nil {
      buf.push(line)
    }
  }
  if title != nil {
    out.push(ns_group(title, buf, summaries))
  }
  out
}

fn index_summaries(lines) {
  mut out = {}
  for line in lines {
    m = INDEX_ROW.find(line)
    if m != nil {
      out[m[1].replace('`', '').trim().to_string()] = m[2].trim().to_string()
    }
  }
  out
}

fn collect(ja) {
  suffix = ja ? '.ja' : ''
  lang = read_lines("docs/language{suffix}.md")
  mut groups = []
  for g in builtin_groups(ja) {
    groups.push(group(g.title, harvest(slice_lines(lang, g.from, g.to))))
  }
  groups + namespace_groups(read_lines("docs/stdlib{suffix}.md"))
}

fn mark(g) {
  g.experimental ? ' (experimental)' : ''
}

fn render(groups, ja) {
  mut out = []
  for g in groups.filter(|g| !g.by_name && g.sigs.size() > 0) {
    out.push('**' + g.title + mark(g) + '** — ' + g.sigs.join('; '))
  }
  rows_for = groups.filter(|g| g.by_name)
  if rows_for.size() > 0 {
    out.push(ja
      ? '### 一覧ではなく章を読むもの'
      : '### Read the chapter for these')
    mut rows = [
      ja
        ? '| 名前空間 | 署名 | 何をするもの |'
        : '| Namespace | Signatures | What it is |',
      '|---|---:|---|',
    ]
    for g in rows_for {
      name = g.title.split(' / ').map(|p| '`' + p.to_string() + '`').join(' / ')
      rows.push('| ' +
        name +
        mark(g) +
        ' | ' +
        to_string(g.sigs.size()) +
        ' | ' +
        g.summary.replace('|', '\|').to_string() +
        ' |')
    }
    out.push(rows.join("\n"))
  }
  out.join("\n\n")
}

fn splice(text, body) {
  mut out = []
  mut state = 'before'
  for raw in text.split("\n") {
    line = raw.to_string()
    if state == 'before' {
      out.push(line)
      if line.starts_with(BEGIN_MARK) {
        out.push('')
        out.push(body)
        out.push('')
        state = 'inside'
      }
    } else if state == 'inside' {
      if line.starts_with(END_MARK) {
        out.push(line)
        state = 'after'
      }
    } else {
      out.push(line)
    }
  }
  throw "missing generated-section markers" if state != 'after'
  out.join("\n")
}

fn surface_text(groups) {
  mut out = ['# Generated by misc/gen_quick_guide.cul -- do not edit by hand.']
  for g in groups {
    for sig in g.sigs {
      out.push(sig)
    }
  }
  out.join("\n") + "\n"
}

fn count(groups, by_name) {
  groups.filter(|g| g.by_name == by_name).map(|g| g.sigs.size()).sum()
}

check = Sys.argv.contains('--check')
mut stale = []

fn settle(check, stale, path, want, label) {
  if want == FS.read(path) {
    println("{path}: up to date ({label})")
  } else if check {
    stale.push(path)
    println("{path}: STALE")
  } else {
    FS.write(path, want)
    println("{path}: regenerated ({label})")
  }
}

for ja in [false, true] {
  path = ja ? 'docs/quick-guide.ja.md' : 'docs/quick-guide.md'
  groups = collect(ja)
  want = splice(FS.read(path), render(groups, ja))
  listed = count(groups, false)
  named = count(groups, true)
  names = groups.filter(|g| g.by_name).size()
  settle(
    check,
    stale,
    path,
    want,
    "{listed} signatures, {named} more behind {names} names",
  )
  if !ja {
    settle(
      check,
      stale,
      SURFACE,
      surface_text(groups),
      "{listed + named} signatures",
    )
  }
}

if stale.size() > 0 {
  IO.eprintln("run `just gen-quick-guide` to refresh: {stale.join(', ')}")
  Sys.exit(1)
}
