{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Culebra",
  "scopeName": "source.culebra",
  "patterns": [
    { "include": "#comments" },
    { "include": "#regex" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#language-constants" },
    { "include": "#function-call" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.culebra",
          "begin": "//|#",
          "end": "$",
          "patterns": [{ "include": "#comment-todo" }]
        },
        {
          "name": "comment.block.culebra",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comment-todo" }]
        }
      ]
    },
    "comment-todo": {
      "match": "\\b(TODO|FIXME|XXX|TBD)\\b",
      "name": "keyword.other.todo.culebra"
    },
    "regex": {
      "comment": "re'...' / re\"...\" / re`...` with trailing [ims] flags. The 're' prefix sits at a word boundary; a bare 're' stays an ordinary identifier.",
      "patterns": [
        {
          "name": "string.regexp.culebra",
          "begin": "\\b(re)(')",
          "beginCaptures": {
            "1": { "name": "keyword.other.regex.culebra" },
            "2": { "name": "punctuation.definition.string.begin.culebra" }
          },
          "end": "'[ims]*",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.culebra" }
          },
          "patterns": [
            { "include": "#regex-interp" },
            { "include": "#regex-escape" }
          ]
        },
        {
          "name": "string.regexp.culebra",
          "begin": "\\b(re)(\")",
          "beginCaptures": {
            "1": { "name": "keyword.other.regex.culebra" },
            "2": { "name": "punctuation.definition.string.begin.culebra" }
          },
          "end": "\"[ims]*",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.culebra" }
          },
          "patterns": [
            { "include": "#regex-interp" },
            { "include": "#regex-escape" }
          ]
        },
        {
          "name": "string.regexp.culebra",
          "begin": "\\b(re)(`)",
          "beginCaptures": {
            "1": { "name": "keyword.other.regex.culebra" },
            "2": { "name": "punctuation.definition.string.begin.culebra" }
          },
          "end": "`[ims]*",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.culebra" }
          },
          "patterns": [
            { "include": "#regex-interp" },
            { "include": "#regex-escape" }
          ]
        }
      ]
    },
    "regex-interp": {
      "comment": "${expr} interpolation inside a regex literal.",
      "name": "meta.embedded.line.culebra",
      "begin": "\\${",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.culebra" } },
      "end": "}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.culebra" } },
      "patterns": [{ "include": "$self" }]
    },
    "regex-escape": {
      "comment": "A backslash escape that never consumes a quote, so it can't swallow the closing delimiter.",
      "match": "\\\\[^'\"`]",
      "name": "constant.character.escape.culebra"
    },
    "strings": {
      "patterns": [
        {
          "comment": "Triple-quoted block string (Swift-style dedent).",
          "name": "string.quoted.triple.culebra",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-interp" },
            { "include": "#string-escape" }
          ]
        },
        {
          "comment": "Double-quoted string with {expr} interpolation.",
          "name": "string.quoted.double.culebra",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.culebra" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.culebra" } },
          "patterns": [
            { "include": "#string-interp" },
            { "include": "#string-escape" }
          ]
        },
        {
          "comment": "Single-quoted raw string (no interpolation).",
          "name": "string.quoted.single.culebra",
          "begin": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.culebra" } },
          "end": "'",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.culebra" } },
          "patterns": [{ "include": "#string-escape" }]
        },
        {
          "comment": "Backtick raw string (Go-style): no escapes, no interpolation, may hold ' \" and {.",
          "name": "string.quoted.other.culebra",
          "begin": "`",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.culebra" } },
          "end": "`",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.culebra" } }
        }
      ]
    },
    "string-interp": {
      "comment": "{expr} interpolation inside a double / triple string.",
      "name": "meta.embedded.line.culebra",
      "begin": "{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.culebra" } },
      "end": "}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.culebra" } },
      "patterns": [{ "include": "$self" }]
    },
    "string-escape": {
      "match": "\\\\.",
      "name": "constant.character.escape.culebra"
    },
    "numbers": {
      "patterns": [
        {
          "comment": "Float patterns first so the integer rule does not steal them.",
          "match": "\\b\\d+\\.\\d+([eE][-+]?\\d+)?\\b",
          "name": "constant.numeric.float.culebra"
        },
        {
          "match": "\\b\\d+[eE][-+]?\\d+\\b",
          "name": "constant.numeric.float.culebra"
        },
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.integer.culebra"
        }
      ]
    },
    "keywords": {
      "comment": "Keyword rules below are generated from misc/keyword-map.txt by `just sync-grammar` (mirrors the culebra.vim AUTO-KEYWORDS block). The \\b\\B markers never match; they only delimit the generated region for the sync script.",
      "patterns": [
        { "match": "\\b\\B", "name": "meta.marker.auto-keywords-begin.culebra" },
        { "match": "\\b(fn)\\b", "name": "keyword.declaration.function.culebra" },
        { "match": "\\b(class|trait|enum)\\b", "name": "keyword.declaration.class.culebra" },
        { "match": "\\b(if|unless|else|match|cond)\\b", "name": "keyword.control.conditional.culebra" },
        { "match": "\\b(while|for|in|by)\\b", "name": "keyword.control.loop.culebra" },
        { "match": "\\b(return|break|continue|nobreak|throw|try|catch|defer|yield)\\b", "name": "keyword.control.culebra" },
        { "match": "\\b(effect|perform|handle|with)\\b", "name": "keyword.other.culebra" },
        { "match": "\\b(import|export|from)\\b", "name": "keyword.control.import.culebra" },
        { "match": "\\b(debugger)\\b", "name": "keyword.other.debugger.culebra" },
        { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.culebra" },
        { "match": "\\b(nil)\\b", "name": "constant.language.culebra" },
        { "match": "\\b(let|mut|static|get)\\b", "name": "storage.modifier.culebra" },
        { "match": "\\b(Nil|Bool|Long|Float|String|Array|Object|Function|Any)\\b", "name": "support.class.culebra" },
        { "match": "\\b(Math|IO|FS|File|Embed|Time|Random|Sys|Tensor|JSON|Args|Proc|Path)\\b", "name": "support.class.culebra" },
        { "match": "\\b(Isolate|Channel|Parallel|Signal|SharedBuffer|Shared|GC|Regex|Http)\\b", "name": "support.class.culebra" },
        { "match": "\\b(Encoding|Compress|Hash|CSV|Env|UUID|Term|Log|TOML|SQLite)\\b", "name": "support.class.culebra" },
        { "match": "\\b(Canvas|Scene|Net|Desktop|Webview|Vector2|Vector3|Deque|PriorityQueue|StateMachine)\\b", "name": "support.class.culebra" },
        { "match": "\\b(PEG|FST)\\b", "name": "support.class.culebra" },
        { "match": "\\b\\B", "name": "meta.marker.auto-keywords-end.culebra" }
      ]
    },
    "language-constants": {
      "match": "\\b(self|__ARGS__)\\b",
      "name": "variable.language.culebra"
    },
    "function-call": {
      "comment": "An identifier immediately followed by '(' is a call site.",
      "match": "\\b([A-Za-z_]\\w*)(?=\\()",
      "name": "entity.name.function.culebra"
    },
    "types": {
      "comment": "Capitalized identifiers: built-in types, stdlib namespaces, user classes.",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.culebra"
    },
    "operators": {
      "patterns": [
        {
          "comment": "Multi-char operators first so prefixes don't shadow them.",
          "match": "&&|\\|\\||\\?\\?|\\*\\*|=>|->|\\.\\.\\.|\\.\\.=?",
          "name": "keyword.operator.culebra"
        },
        {
          "match": "[-+*/%@!=<>^|&]=?",
          "name": "keyword.operator.culebra"
        }
      ]
    }
  }
}
