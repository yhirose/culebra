{
  "name": "culebra-debug",
  "displayName": "Culebra",
  "description": "Syntax highlighting and debugging for Culebra (.cul) programs.",
  "publisher": "local",
  "version": "0.0.1",
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Programming Languages", "Debuggers"],
  "contributes": {
    "languages": [
      {
        "id": "culebra",
        "extensions": [".cul"],
        "aliases": ["Culebra"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "culebra",
        "scopeName": "source.culebra",
        "path": "./syntaxes/culebra.tmLanguage.json"
      }
    ],
    "breakpoints": [
      { "language": "culebra" }
    ],
    "debuggers": [
      {
        "type": "culebra",
        "label": "Culebra",
        "languages": ["culebra"],
        "program": "culebra",
        "args": ["dap"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .cul file to debug.",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at the first statement.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "culebra",
            "request": "launch",
            "name": "Debug current file",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
          }
        ]
      }
    ]
  }
}
