# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Compiled dynamic libraries
*.so
*.dylib
*.dll

# Compiled static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Debug symbols
*.dSYM

# Editor swap files
*.swp

# CMake at the repo root (the canonical build dir is build/, but
# `cmake .` from the root would scatter these here).
Makefile
CMakeFiles
CMakeCache.txt

# Build directories. A glob rather than a list: build-tsan/ was not on the
# list and got committed, binary and all.
build*/
raylib_ext_build/

# Extended `culebra wrap` binaries (default + spike outputs)
culebra-wrapped
webview-culebra
webview-app

# examples/webview/desktop_app.cul's persisted visit counter
examples/webview/visits.db
/visits.db

# macOS metadata
.DS_Store

# Claude Code: ignore local artifacts (permission allowlist,
# scheduled-tasks lock, plan dir, etc.) but track team-shared
# settings (plansDirectory, etc.) and skills.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/commands/
!.claude/rules/

# Local scratch probes (kept out of git)
tmp/

# Per-user editor config, generated by misc/<editor>/install.sh (regenerable)
.zed/
.vscode/
.vimspector.json

# Local ccache scratch (the canonical CCACHE_DIR is $TMPDIR/ccache)
.cache-ccache/
scratchpad/

# Ignore internal development history
docs/_history.md
docs/_history.ja.md

# Private, unpolished dev notes on implementation internals — not guaranteed
# in sync with the code, not embedded, not part of the public doc set.
docs/_internals.md
docs/_internals.ja.md

# Python bytecode from the asset generator
__pycache__/
*.pyc

# Upstream art dropped in locally to play with — not redistributable
examples/games/retro-run/assets-*/

# `culebra build`ing the example in place, as its README shows
examples/games/retro-run/retro-run
