# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Compiled dynamic libraries
*.so
*.dylib
*.dll

# Compiled static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Debug symbols
*.dSYM

# Editor swap files
*.swp

# CMake at the repo root (the canonical build dir is build/, but
# `cmake .` from the root would scatter these here).
Makefile
CMakeFiles
CMakeCache.txt

# Build directory
build/
build-dev/
build-gate/
build-asan/
build-no-jit/
build-gfx/
raylib_ext_build/
build-webview/

# Extended `culebra wrap` binaries (default + spike outputs)
culebra-wrapped
webview-culebra
webview-app

# macOS metadata
.DS_Store

# Claude Code: ignore local artifacts (permission allowlist,
# scheduled-tasks lock, plan dir, etc.) but track team-shared
# settings (plansDirectory, etc.).
.claude/*
!.claude/settings.json

# Local scratch probes (kept out of git)
tmp/

# Per-user editor config, generated by misc/<editor>/install.sh (regenerable)
.zed/
.vscode/
.vimspector.json

# Local ccache scratch (the canonical CCACHE_DIR is $TMPDIR/ccache)
.cache-ccache/
scratchpad/

# Ignore internal development history
docs/_history.md
docs/_history.ja.md
docs/_internal/*
