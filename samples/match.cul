# Pattern matching (Phase 5b)

describe = fn (x) {
  match x {
    0                  => 'zero',
    1 | 2 | 3          => 'small',
    n: Long if n > 100 => "big ({n})",
    n: Long            => "int ({n})",
    s: String          => "str ({s})",
    true               => 'TRUE',
    false              => 'FALSE',
    nil                => 'NIL',
    _                  => 'other'
  }
}

puts(describe(0))
puts(describe(2))
puts(describe(42))
puts(describe(999))
puts(describe('hi'))
puts(describe(true))
puts(describe(false))
puts(describe(nil))
puts(describe([1,2]))

# match as expression yielding a value, used in arithmetic
classify = fn (n: Long) -> Long {
  match n {
    n if n < 0  => -1,
    0           => 0,
    _           => 1
  }
}

puts(classify(-5))
puts(classify(0))
puts(classify(7))

# Recursive traversal using match (arm bodies are single expressions)
is_even = fn (n) {
  match n {
    0 => true,
    1 => false,
    _ => self(n - 2)
  }
}
puts(is_even(10))
puts(is_even(7))

# Array destructuring
shape = fn (a) {
  match a {
    []              => 'empty',
    [x]             => "one ({x})",
    [x, y]          => "two ({x},{y})",
    [head, ...tail] => "head={head}, tail.size={tail.size()}",
  }
}
puts(shape([]))
puts(shape([9]))
puts(shape([1, 2]))
puts(shape([10, 20, 30, 40]))

# Object destructuring
greet = fn (o) {
  match o {
    {name, age} => "Hello {name}, age {age}",
    {name}      => "Hello {name}",
    _           => 'Hello anon'
  }
}
puts(greet({name: 'alice', age: 30}))
puts(greet({name: 'bob'}))
puts(greet({}))

# Nested
first_name = fn (people) {
  match people {
    [{name}, ..._] => name,
    _              => 'none'
  }
}
puts(first_name([{name: 'x'}, {name: 'y'}]))
puts(first_name([]))
