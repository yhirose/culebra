# Optional type annotations (Phase 5a, Level 1 / Style B).
# Annotations are enforced at runtime boundaries (assignments, function
# calls, and returns). Omitting annotations keeps the dynamic behavior.

# Variable type annotations
let x: Long = 10
let name: String = 'alice'
let flag: Bool = true
puts(x)
puts(name)
puts(flag)

# Parameter and return types
add = fn (a: Long, b: Long) -> Long { a + b }
puts(add(3, 4))

greet = fn (name: String) -> String {
  "Hello, {name}!"
}
puts(greet('world'))

# Any matches everything
identity = fn (x: Any) -> Any { x }
puts(identity(42))
puts(identity('hi'))

# Mix: some typed, some dynamic
describe = fn (v, label: String) -> String {
  "{label}: {v}"
}
puts(describe(123, 'number'))
puts(describe([1,2,3], 'array'))
