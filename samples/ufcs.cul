# Uniform Function Call Syntax (UFCS): any free function whose first
# parameter matches the receiver can be called with method syntax.
#
# Resolution order for `x.name(args)`:
#   1. property/method on `x` (wins)
#   2. free function `name` in scope, called as `name(x, args)`
#   3. property access returns nil; if call follows, errors out

# --- UFCS on primitives ----------------------------------------------
double = fn (x) { x * 2 }
puts(42.double())                                  # 84

# --- UFCS on String ---------------------------------------------------
word_count = fn (s) { s.split(' ').size() }
puts('hello world foo'.word_count())               # 3

# --- UFCS on Array: user-defined folds/utilities --------------------
sum = fn (xs) { xs.reduce(0, fn (a, x) { a + x }) }
puts([1, 2, 3, 4].sum())                           # 10

# --- Existing method wins ---------------------------------------------
# Array has a builtin `reverse`. A user-defined `reverse` does NOT
# override it via UFCS.
reverse = fn (x) { puts('user reverse NOT called') }
mut a = [1, 2, 3]
a.reverse()                                        # Array builtin (mutating)
puts(a)                                            # [3, 2, 1]

# --- Object HOF via UFCS ---------------------------------------------
# Object has no built-in map; UFCS lets user utilities feel native.
map_keys = fn (o, f) {
  mut r = []
  for k in o { r.push(f(k)) }
  r
}
puts({b: 2, a: 1, c: 3}.map_keys(fn (k) { k }))    # ['a', 'b', 'c']

# --- Method chains mixing builtins and UFCS --------------------------
[1, 2, 3, 4, 5]
  .filter(fn (x) { x % 2 == 1 })                   # Array builtin → [1,3,5]
  .sum()                                            # UFCS → 9
  .double()                                         # UFCS → 18
  .puts()                                           # UFCS → prints 18
