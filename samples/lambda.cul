/*
 * Lambda / closure sugar. `|x, y| expr` and `|x, y| { ... }` desugar to
 * `fn(x, y) { ... }`, handy as a functor for higher-order calls.
 */

add = |x, y| x + y
puts("add(2, 3) = { add(2, 3) }")

// Captures from the enclosing scope.
make_adder = |n| |x| x + n
add5 = make_adder(5)
puts("add5(10) = { add5(10) }")

// Block body when you need statements.
clamp = |v, lo, hi| {
  mut x = v
  if x < lo { x = lo }
  if x > hi { x = hi }
  x
}
puts("clamp(42, 0, 10) = { clamp(42, 0, 10) }")

// As a direct argument to a higher-order function.
apply = fn (f, v) { f(v) }
puts("apply(|x| x*x, 7) = { apply(|x| x*x, 7) }")
