# Error handling in Culebra: throw / try / catch / defer
# plus a small user-defined scope-guard helper.

# 1. throw + catch across function boundaries
validate = fn (x) {
  if x < 0 { throw "negative: {x}" }
  x
}

try {
  puts(validate(42))
  puts(validate(-1))   # throws, unreached below
  puts('unreached')
} catch e {
  puts("caught: {e}")
}

# 2. try as expression with default on error
safe = fn (x) {
  try { validate(x) } catch _ { 0 }
}
puts(safe(7))
puts(safe(-99))

# 3. defer runs on every exit path (LIFO). Wrap in `{ }` so the
#    cleanups also fire when the body throws.
demo = fn (fail) {
  {
    defer { puts('cleanup A') }
    defer { puts('cleanup B') }
    if fail { throw 'failed' }
    puts('work done')
  }
}
demo(false)
puts('---')
try { demo(true) } catch e { puts("caught: {e}") }

# 4. User-defined scope guard: one-time init inside a loop,
#    one-time cleanup at function exit.
make_guard = fn () {
  mut fns = []
  {
    add: fn (f) { fns.push(f) },
    run: fn () {
      mut i = fns.size() - 1
      while i >= 0 { fns[i](); i = i - 1 }
      fns = []
    }
  }
}

process = fn (items) {
  {
    g = make_guard()
    defer { g.run() }

    mut f = nil
    items.for_each(fn (item) {
      if f == nil {
        f = 'OPEN'
        puts('(open once)')
        g.add(fn () { puts('(close once)') })
      }
      puts("handle {item}")
    })
  }
}
puts('---')
process([1, 2, 3])
