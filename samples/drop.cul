# RAII via the `drop` method.
#
# If an Object has a Function-typed `drop` property that takes no
# arguments, the interpreter calls it automatically when the object's
# last reference goes away (§16 of the language spec).
#
# Guideline: define `drop` via a factory function, and bind the
# returned object in a block scope. This keeps the closure capture
# outside the binding's own scope, so the refcount truly hits zero on
# scope exit. Defining `drop` directly in an object literal bound at
# the top level may leave the object alive until program shutdown via
# a closure-to-environment cycle.

# --- Cascade: parent → children on scope exit --------------------------

make_child = fn (name) {
  { drop: fn () { puts("child {name} dropped") } }
}

make_parent = fn () {
  a = make_child('A')
  b = make_child('B')
  { a: a, b: b, drop: fn () { puts('parent dropped') } }
}

puts('enter')
{
  parent = make_parent()
}
puts('exit')
#   enter
#   parent dropped
#   child A dropped
#   child B dropped
#   exit

# --- Shared ownership: drop fires on last release ---------------------

make_resource = fn (id) { { drop: fn () { puts("R{id} released") } } }
make_holder = fn (tag, res) {
  { tag: tag, res: res, drop: fn () { puts("H{tag} done") } }
}

puts('---')
{
  r = make_resource('X')
  {
    h1 = make_holder('1', r)
    h2 = make_holder('2', r)
  }
  # h1, h2 dropped here, but r stays alive (outer `r` still owns it)
  puts('between')
}
# r dropped here
puts('final')
