# API mock — Tensor port of samples/mnist/train_bench.cul.
#
# This file does NOT run yet; it is a design surface for the planned
# Tensor builtin. Compare line-by-line with train_bench_numpy.py — the
# numpy version is 30 lines of math, and the Tensor version should be
# the same.
#
# numpy reference (train_bench_numpy.py, inner loop):
#     z1 = W1 @ x + b1[:, None]
#     a1 = sigmoid(z1)
#     z2 = W2 @ a1 + b2[:, None]
#     a2 = sigmoid(z2)
#     d2 = (a2 - t) * a2 * (1.0 - a2)
#     d1 = (W2.T @ d2) * a1 * (1.0 - a1)
#     W2 -= ETA * (d2 @ a1.T) / BATCH
#     b2 -= ETA * d2.mean(axis=1)
#     W1 -= ETA * (d1 @ x.T) / BATCH
#     b1 -= ETA * d1.mean(axis=1)

let DIR = 'samples/mnist'
let N_HID = 30
let N_OUT = 10
let BATCH = 10
let ETA   = 3.0

let load_2d = fn (path) {
  mut rows = []
  for line in IO.read(path).split("\n") {
    if line.size() == 0 { continue }
    mut row = []
    for s in line.split(",") {
      row.push(to_float(s))
    }
    rows.push(row)
  }
  rows
}

let load_int_1d = fn (path) {
  mut out = []
  for line in IO.read(path).split("\n") {
    let s = line.trim()
    if s.size() == 0 { continue }
    out.push(to_long(s))
  }
  out
}

let build_one_hot = fn (labels, k) {
  mut rows = []
  for label in labels {
    mut row = []
    for j in range(k) {
      row.push(if j == label { 1.0 } else { 0.0 })
    }
    rows.push(row)
  }
  Tensor.from(rows)
}

# Sanity check.
for f in ['init_W1.csv', 'init_b1.csv', 'init_W2.csv', 'init_b2.csv',
          'train_images.csv', 'train_labels.csv',
          'test_images.csv',  'test_labels.csv'] {
  if !IO.exists("{DIR}/{f}") {
    puts("missing {DIR}/{f}; run prep_train.py and prep_test.py first")
    Sys.exit(1)
  }
}

mut W1 = Tensor.from_csv("{DIR}/init_W1.csv")     # [30, 784]
mut b1 = Tensor.from_csv("{DIR}/init_b1.csv")     # [30, 1]
mut W2 = Tensor.from_csv("{DIR}/init_W2.csv")     # [10, 30]
mut b2 = Tensor.from_csv("{DIR}/init_b2.csv")     # [10, 1]
let X  = Tensor.from_csv("{DIR}/train_images.csv") # [N, 784]
let Xt = Tensor.from_csv("{DIR}/test_images.csv")  # [N_test, 784]

# Labels as int Array — see infer_tensor.cul for rationale.
let y  = load_int_1d("{DIR}/train_labels.csv")
let yt = load_int_1d("{DIR}/test_labels.csv")

let n = X.shape()[0]
puts("[culebra-tensor-train] loaded train={n} test={Xt.shape()[0]}")

# One-hot target Tensor Y [N, 10]. Built once up front; Phase 1 has
# no Tensor.one_hot, so we materialize from a nested Array. Cheap at
# this scale — 1000–10000 rows.
let Y = build_one_hot(y, N_OUT)

let lr = ETA / to_float(BATCH)
let inv_batch = 1.0 / to_float(BATCH)

mut s = 0
while s < n {
  # Mini-batch slice. .slice(start, end) is a zero-copy view, so
  # this allocates nothing per iteration.
  let xb = X.slice(s, s + BATCH).transpose()        # [784, BATCH]
  let tb = Y.slice(s, s + BATCH).transpose()        # [10,  BATCH]

  # Forward (fused dot + bias + sigmoid).
  let a1 = W1.linear_sigmoid(xb, b1)                # [30, BATCH]
  let a2 = W2.linear_sigmoid(a1, b2)                # [10, BATCH]

  # Backward (MSE loss + sigmoid output derivative).
  let d2 = (a2 - tb) * a2 * (Tensor.ones(N_OUT, BATCH) - a2)
  let d1 = W2.transpose().dot(d2) * a1 * (Tensor.ones(N_HID, BATCH) - a1)

  # Weight update. Building lazy graph nodes for all four updates,
  # then forcing evaluation in a single topological pass — shared
  # subexpressions (a1, d2, etc.) compute exactly once.
  W2 = W2 - d2.dot(a1.transpose()) * lr
  b2 = b2 - d2.sum(1).reshape([N_OUT, 1]) * lr * inv_batch
  W1 = W1 - d1.dot(xb.transpose()) * lr
  b1 = b1 - d1.sum(1).reshape([N_HID, 1]) * lr * inv_batch

  Tensor.eval(W1, b1, W2, b2)

  s = s + BATCH
}

# Inference on the held-out test set, identical to infer_tensor.cul.
let a1 = W1.linear_sigmoid(Xt.transpose(), b1)
let a2 = W2.linear_sigmoid(a1, b2)
let preds = a2.argmax(0)
Tensor.eval(preds)

let p = preds.to_array()
mut correct = 0
for k in range(yt.size()) {
  if to_long(p[k]) == yt[k] { correct = correct + 1 }
}
let acc = to_float(correct) / to_float(yt.size())
puts("[culebra-tensor-train] {n / BATCH} batches done, test accuracy: {acc}")
