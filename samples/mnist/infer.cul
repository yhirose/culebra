# Culebra port of samples/mnist/infer_pure.py — same nested-loop
# scalar inference, byte-identical CSV inputs. The two ports walk
# the same code shape so any timing gap reflects interpreter quality
# rather than algorithmic differences. Times are measured externally
# (e.g. `time ./build/culebra --jit samples/mnist/infer.cul`).

let DIR = 'samples/mnist'
let N_IN  = 784
let N_HID = 30
let N_OUT = 10

let load_2d = fn (path) {
  mut rows = []
  for line in IO.read(path).split("\n") {
    if line.size() == 0 { continue }
    mut row = []
    for s in line.split(",") {
      row.push(to_float(s))
    }
    rows.push(row)
  }
  rows
}

let load_1d = fn (path) {
  mut out = []
  for line in IO.read(path).split("\n") {
    let s = line.trim()
    if s.size() == 0 { continue }
    out.push(to_float(s))
  }
  out
}

let load_int_1d = fn (path) {
  mut out = []
  for line in IO.read(path).split("\n") {
    let s = line.trim()
    if s.size() == 0 { continue }
    out.push(to_long(s))
  }
  out
}

let sigmoid = fn (z) {
  1.0 / (1.0 + Math.exp(-z))
}

let predict = fn (x, W1, b1, W2, b2) {
  mut a1 = []
  for i in Math.range(N_HID) {
    mut s = b1[i]
    let row = W1[i]
    for j in Math.range(N_IN) {
      s = s + row[j] * x[j]
    }
    a1.push(sigmoid(s))
  }

  mut best_v = -1.0
  mut best_i = 0
  for i in Math.range(N_OUT) {
    mut s = b2[i]
    let row = W2[i]
    for j in Math.range(N_HID) {
      s = s + row[j] * a1[j]
    }
    let v = sigmoid(s)
    if v > best_v {
      best_v = v
      best_i = i
    }
  }
  best_i
}

# Sanity: required CSVs must be present
for f in ['W1.csv', 'b1.csv', 'W2.csv', 'b2.csv',
          'test_images.csv', 'test_labels.csv'] {
  if !IO.exists("{DIR}/{f}") {
    puts("missing {DIR}/{f}; run train.py and prep_test.py first")
    Sys.exit(1)
  }
}

let W1 = load_2d("{DIR}/W1.csv")
let b1 = load_1d("{DIR}/b1.csv")
let W2 = load_2d("{DIR}/W2.csv")
let b2 = load_1d("{DIR}/b2.csv")
let X  = load_2d("{DIR}/test_images.csv")
let y  = load_int_1d("{DIR}/test_labels.csv")

let n = X.size()
puts("[culebra] loaded N={n} (W1={W1.size()}x{W1[0].size()}, W2={W2.size()}x{W2[0].size()})")

mut correct = 0
for k in Math.range(n) {
  if predict(X[k], W1, b1, W2, b2) == y[k] {
    correct = correct + 1
  }
}

let acc = to_float(correct) / to_float(n)
puts("[culebra] inference: {n} predictions, accuracy: {acc}")
