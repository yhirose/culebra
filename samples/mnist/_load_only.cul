# Load-only timing helper: identical loaders to infer.cul, no inference.
# Time externally: `time ./build/culebra [--jit] samples/mnist/_load_only.cul`

let DIR = 'samples/mnist'

let load_2d = fn (path) {
  mut rows = []
  for line in IO.read(path).split("\n") {
    if line.size() == 0 { continue }
    mut row = []
    for s in line.split(",") {
      row.push(to_float(s))
    }
    rows.push(row)
  }
  rows
}

let load_1d = fn (path) {
  mut out = []
  for line in IO.read(path).split("\n") {
    let s = line.trim()
    if s.size() == 0 { continue }
    out.push(to_float(s))
  }
  out
}

let load_int_1d = fn (path) {
  mut out = []
  for line in IO.read(path).split("\n") {
    let s = line.trim()
    if s.size() == 0 { continue }
    out.push(to_long(s))
  }
  out
}

let W1 = load_2d("{DIR}/W1.csv")
let b1 = load_1d("{DIR}/b1.csv")
let W2 = load_2d("{DIR}/W2.csv")
let b2 = load_1d("{DIR}/b2.csv")
let X  = load_2d("{DIR}/test_images.csv")
let y  = load_int_1d("{DIR}/test_labels.csv")

puts("loaded W1={W1.size()}x{W1[0].size()} X={X.size()}x{X[0].size()}")
