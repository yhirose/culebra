/*
 * Unit tests
 */

test_call = fn () {
  ret = fn(){[1,fn(){[4,5,6]},3]}()[1]()[1]
  assert(ret == 5)
}

test_return = fn () {
  f = fn (x) {
    if x % 2 {
      return 'odd'
    }
    'even'
  }
  assert(f(3) == 'odd')
  assert(f(4) == 'even')

  mut val = 0
  f2 = fn () {
    val = 1
    return // comment
    val = 2
  }
  f2()
  assert(val == 1)
}

test_nil = fn () {
  assert(nil == nil)
  assert(!(nil != nil))

  a = nil
  assert(a == nil)
  assert(!(a != nil))
  assert(!(a <= nil))
  assert(!(a < nil))
  assert(!(a >= nil))
  assert(!(a > nil))
  assert(nil == a)
  assert(!(nil != a))
  assert(!(nil <= a))
  assert(!(nil < a))
  assert(!(nil >= a))
  assert(!(nil > a))
}

test_closure = fn () {
  make_func = fn (mut x) {
    mut n = 100
    fn () {
      n = n + 1
      x = x + 1 + n
    }
  }

  f = make_func(10)
  f()
  f()
  ret = f()

  assert(ret == 319)
}

test_array = fn () {
  a = [1,2,3]
  assert(a.size() == 3)

  a.push(4)
  assert(a.size() == 4)

  b = []
  assert(b.size() == 0)

  c = [1]
  assert(c.size() == 1)

	d = [1,2,3](5, 0)
	assert(d.size() == 5 && d[-1] == 0)

	e = [1,2,3](2)
	assert(e.size() == 3 && e[-1] == 3)

	f = [1,2,3](5)
	assert(f.size() == 5 && f[-1] == nil)
}

g_ = 1

test_function = fn () {
  a = 1
  make = fn () {
    b = 1
    fn (c) {
      g_ + a + b + c
    }
  }
  f = make()
  assert(f(1) == 4)
}

test_object = fn () {
  n = 1
  o = {
    n: 123,
    s: 'str',
    f1: fn (x) { x + this.n },
    f2: fn (x) { x + n }
  }
  assert(o.size() == 4)
  assert(o.f1(10) == 133)
  assert(o.f2(10) == 11)

  a = {}
  a.b = 1
  assert(a.a == nil)
  assert(a.b == 1)
  assert(a.size() == 1)
}

test_object_factory = fn () {
  ctor = fn (init) {
    mut n = init

    {
      add: fn (x) {
        n = n + x
      },
      sub: fn (x) {
        n = n - x
      },
      val: fn () {
        n
      }
    }
  }

  calc = ctor(10)

  assert(calc.val() == 10)
  assert(calc.add(1) == 11)
  assert(calc.sub(1) == 10)
}

test_class = fn () {
  // TODO: support 'prototype' property
  Car = {
    new: fn(miles_per_run) {
      mut total_miles = 0

      {
        run: fn (times) {
          total_miles = total_miles + miles_per_run * times
        },
        total: fn () {
          total_miles
        }
      }
    }
  }

  car = Car.new(5)
  car.run(1)
  car.run(2)

  assert(car.total() == 15)
}

test_sum = fn () {
  mut i = 1
  mut ret = 0
  while i <= 10 {
    ret = ret + i
    i = i + 1
  }

  assert(ret == 55)
}

test_float = fn () {
  // Literals & type
  assert(type_of(1.0) == 'Float')
  assert(type_of(0.5) == 'Float')
  assert(type_of(1e-5) == 'Float')
  assert(type_of(1.5e3) == 'Float')
  assert(type_of(42) == 'Long')

  // Display: Float always carries a decimal point or exponent.
  assert(to_string(1.0) == '1.0')
  assert(to_string(0.5) == '0.5')
  assert(to_string(-2.5) == '-2.5')
  assert(to_string(1.5e-5) == '1.5e-05')

  // Arithmetic — homogeneous Long (unchanged integer semantics).
  assert(1 + 2 == 3)
  assert(7 / 2 == 3)
  assert(-7 % 3 == -1)
  assert(type_of(1 + 2) == 'Long')

  // Arithmetic — homogeneous Float.
  assert(1.0 + 2.0 == 3.0)
  assert(1.5 * 2.0 == 3.0)
  assert(type_of(1.0 + 2.0) == 'Float')

  // Promotion: Long op Float -> Float (both directions).
  assert(type_of(1 + 2.0) == 'Float')
  assert(type_of(2.0 + 1) == 'Float')
  assert(1 + 0.5 == 1.5)
  assert(2.0 - 1 == 1.0)
  assert(3 / 2.0 == 1.5)
  assert(2.0 / 4 == 0.5)

  // Cross-type equality (numeric).
  assert(1 == 1.0)
  assert(1.0 == 1)
  assert(!(1 == 1.5))
  assert(1 < 1.5)
  assert(2.5 > 2)

  // Unary minus.
  assert(-1.5 == -1.5)
  assert(type_of(-1.5) == 'Float')

  // Power.
  assert(2 ** 10 == 1024)
  assert(type_of(2 ** 10) == 'Long')
  assert(2 ** -1 == 0.5)
  assert(type_of(2 ** -1) == 'Float')
  assert(2.0 ** 0.5 < 1.4143 && 2.0 ** 0.5 > 1.4142)
  assert(type_of(2.0 ** 10) == 'Float')
  // Right-associative: 2**3**2 == 2**(3**2) == 512.
  assert(2 ** 3 ** 2 == 512)
  // Unary minus binds looser than **: -2**2 == -(2**2) == -4.
  assert(-2 ** 2 == -4)
  // Operator precedence: 2 * 3**2 == 2 * 9 == 18.
  assert(2 * 3 ** 2 == 18)
  // 0 ** 0 convention.
  assert(0 ** 0 == 1)

  // Type annotation.
  x: Float = 3.14
  assert(x == 3.14)

  // Conversions.
  assert(to_long(3.7) == 3)       // truncate toward zero
  assert(to_long(-3.7) == -3)
  assert(to_float(3) == 3.0)
  assert(to_float('1.5') == 1.5)
  assert(to_long('42') == 42)     // unchanged string path

  // Zero sign: IEEE 754 treats 0.0 and -0.0 as equal but with
  // distinct bit patterns. Culebra follows Python: equal.
  assert(0.0 == -0.0)
  assert(!(0.0 != -0.0))
  // Truthiness: 0.0 and -0.0 are both false.
  mut zero_is_falsy = true
  if 0.0 { zero_is_falsy = false }
  assert(zero_is_falsy)
  mut nz_is_truthy = false
  if 0.5 { nz_is_truthy = true }
  assert(nz_is_truthy)

  // NaN: self-inequality, arithmetic propagation, ordering returns
  // false, truthy under Python semantics (UNE matches). Built via
  // sqrt of a negative (0.0 / 0.0 would raise divide-by-zero).
  nan = (-1.0) ** 0.5
  assert(type_of(nan) == 'Float')
  assert(nan != nan)               // IEEE 754: NaN !=  everything
  assert(!(nan == nan))
  assert(!(nan < 1.0))             // ordering on NaN is false
  assert(!(nan > 1.0))
  assert(!(nan <= 1.0))
  assert(!(nan >= 1.0))
  nan_plus = nan + 1.0
  assert(nan_plus != nan_plus)     // NaN propagates through arithmetic
  mut nan_truthy = false
  if nan { nan_truthy = true }     // NaN is truthy
  assert(nan_truthy)

  // Infinity: produced by overflow (1e308 * 10), propagates through
  // arithmetic, ordered above every finite value.
  big = 1e308 * 10.0
  assert(type_of(big) == 'Float')
  assert(big > 1e308)
  assert(big == big)
  assert(to_string(big) == 'inf')
  neg_big = -big
  assert(to_string(neg_big) == '-inf')
  // inf - inf is NaN.
  sub = big - big
  assert(sub != sub)

  // Pattern matching on Float literals.
  described = match 1.5 {
    1.5 => 'one-point-five',
    _   => 'other',
  }
  assert(described == 'one-point-five')
  described2 = match 2.0 {
    1.5 => 'nope',
    x: Float => x + 1.0,
    _   => nil,
  }
  assert(described2 == 3.0)

  // Interpolated strings pick up Float display form. Leading text is
  // required because a `"{expr}"` with only one segment collapses to
  // the expression (pre-existing optimizer behavior, not Float-specific).
  assert("x={1.0}" == 'x=1.0')
  assert("x={-2.5}" == 'x=-2.5')
  assert("x={1.5e-5}" == 'x=1.5e-05')
  assert("x={nan}" == 'x=nan')
  assert("x={big}" == 'x=inf')

  // Constant-folding peephole for `** 2` keeps result Long when base
  // is Long (wraps like Long multiplication).
  assert(5 ** 2 == 25)
  assert(2.5 ** 2 == 6.25)
  assert(type_of(5 ** 2) == 'Long')
  assert(type_of(2.5 ** 2) == 'Float')
  // `** 0.5` peephole: sqrt.
  assert(16 ** 0.5 == 4.0)
  assert(2.0 ** 0.5 < 1.4143 && 2.0 ** 0.5 > 1.4142)

  // Divide-by-zero on Float still raises (same diagnostic as Long).
  // Not easy to assert without a try/catch helper — skip for now;
  // behavior covered manually.
}

test_fib = fn () {
  fib = fn (x) {
    if x < 2 {
      x
    } else {
      self(x - 2) + self(x -1)
    }
  }

  ret = fib(15)

  assert(ret == 610)
}

test_interpolated_string = fn () {
  hello = "Hello"
  world = "World!"
  ret = "{hello} {world}"
  assert(ret == 'Hello World!')
}

test_lexical_scope = fn () {
	a = 0
	{
		let a = 1;
		assert(a == 1)
	}
	assert(a == 0)

	mut b = 0
	{
		b = 1;
		assert(b == 1)
	}
	assert(b == 1)

	c = 0
	{
		let mut c = 0;
		c = 1
		assert(c == 1)
	}
	assert(c == 0)

	obj = {
		name: 'object'
	}

	assert(obj.name == 'object')
}

test_builtin_methods = fn () {
  // String methods (§17.1)
  assert('hello'.size() == 5)
  assert('HeLLo'.upper() == 'HELLO')
  assert('HeLLo'.lower() == 'hello')
  assert('  hi  '.trim() == 'hi')
  assert('a,b,c'.split(',').size() == 3)
  assert('a,b,c'.split(',')[1] == 'b')
  assert('abc'.split(',').size() == 1)
  assert('hello'.contains('ell'))
  assert(!'hello'.contains('xyz'))
  assert('hello'.starts_with('he'))
  assert(!'hello'.starts_with('lo'))
  assert('hello'.ends_with('lo'))
  assert(!'hello'.ends_with('he'))
  assert('hello'.slice(1, 4) == 'ell')
  assert('hello'.slice(-3, -1) == 'll')
  assert('hello'.slice(2, 10) == 'llo')

  // Array methods (§17.2)
  mut a = [1, 2, 3]
  assert(a.pop() == 3)
  assert(a.size() == 2)
  empty = []
  assert(empty.pop() == nil)
  assert([10, 20, 30, 40].slice(1, 3).size() == 2)
  assert([10, 20, 30, 40].slice(1, 3)[0] == 20)
  assert(['a', 'b', 'c'].join('-') == 'a-b-c')
  assert([1, 2, 3].join(',') == '1,2,3')
  assert([1, 2, 3].contains(2))
  assert(![1, 2, 3].contains(9))
  assert([10, 20, 30].index_of(20) == 1)
  assert([10, 20, 30].index_of(99) == -1)
  mut b = [1, 2, 3]
  b.reverse()
  assert(b[0] == 3 && b[2] == 1)

  // Object methods (§17.3)
  o = {b: 2, a: 1, c: 3}
  assert(o.keys().size() == 3)
  assert(o.keys()[0] == 'a')
  assert(o.keys()[2] == 'c')
  assert(o.has('a'))
  assert(!o.has('z'))
  mut p = {a: 1, b: 2}
  p.remove('a')
  assert(p.size() == 1)
  assert(!p.has('a'))
  assert(p.has('b'))

  // Higher-order array methods (§17.2)
  squared = [1, 2, 3].map(fn (x) { x * x })
  assert(squared.size() == 3 && squared[0] == 1 && squared[2] == 9)

  evens = [1, 2, 3, 4, 5].filter(fn (x) { x % 2 == 0 })
  assert(evens.size() == 2 && evens[0] == 2 && evens[1] == 4)

  sum = [1, 2, 3, 4].reduce(0, fn (acc, x) { acc + x })
  assert(sum == 10)

  assert([1, 2, 3].reduce(1, fn (acc, x) { acc * x }) == 6)

  mut total = 0
  [10, 20, 30].for_each(fn (x) { total = total + x })
  assert(total == 60)

  assert([3, 1, 4, 1, 5].find(fn (x) { x > 3 }) == 4)
  assert([3, 1, 4].find(fn (x) { x > 100 }) == nil)

  assert([1, 2, 3].any(fn (x) { x > 2 }))
  assert(![1, 2, 3].any(fn (x) { x > 100 }))
  assert([].any(fn (x) { x > 0 }) == false)

  assert([1, 2, 3].all(fn (x) { x > 0 }))
  assert(![1, 2, 3].all(fn (x) { x > 1 }))
  assert([].all(fn (x) { x > 0 }))

  # sum / product: identity on empty (0 / 1)
  assert([1, 2, 3, 4].sum() == 10)
  assert([].sum() == 0)
  assert([2, 3, 4].product() == 24)
  assert([].product() == 1)

  # min / max
  assert([3, 1, 4, 1, 5, 9, 2, 6].min() == 1)
  assert([3, 1, 4, 1, 5, 9, 2, 6].max() == 9)
  assert([-3, -1, -4].min() == -4)

  fm = [1, 2, 3].flat_map(fn (x) { [x, x * 10] })
  assert(fm.size() == 6 && fm[0] == 1 && fm[1] == 10 && fm[5] == 30)

  mut nums = [3, 1, 4, 1, 5, 9, 2, 6]
  nums.sort_by(fn (x) { x })
  assert(nums[0] == 1 && nums[1] == 1 && nums[7] == 9)

  mut ws = ['banana', 'fig', 'apple']
  ws.sort_by(fn (s) { s.size() })
  assert(ws[0] == 'fig' && ws[1] == 'apple' && ws[2] == 'banana')
}

// Top-level binding used by test_shadow_rules to exercise "shadowing a
// top-level user binding is allowed" (globals tier).
shadow_src_value = 100

// Top-level function whose parameter shadows a top-level binding
// (globals tier — allowed).
shadow_arg_fn = fn (shadow_src_value) { shadow_src_value + 1 }

// Top-level function whose match pattern shadows a top-level binding
// (globals tier — allowed).
shadow_match_fn = fn (v) {
  match v {
    shadow_src_value: Long => shadow_src_value * 10
  }
}

test_shadow_rules = fn () {
  // (A) Shadowing a builtin is allowed.
  mut min = 0
  min = 5
  assert(min == 5)

  // (B) Shadowing a top-level user binding is allowed.
  mut shadow_src_value = 999
  assert(shadow_src_value == 999)

  // (C) Block-scope rebinding within the same function is allowed.
  val = 0
  {
    let val = 1
    assert(val == 1)
  }
  assert(val == 0)

  // (D) Closure-as-object: bare reassignment reaches captured outer.
  make_counter = fn () {
    mut n = 0
    {
      incr: fn () { n = n + 1 },
      get:  fn () { n }
    }
  }
  c = make_counter()
  c.incr()
  c.incr()
  c.incr()
  assert(c.get() == 3)

  // (E) Parameter of a top-level function may shadow a top-level
  // binding (globals tier). Tested via shadow_arg_fn defined above.
  assert(shadow_arg_fn(4) == 5)

  // (F) Match pattern of a top-level function may shadow a top-level
  // binding. Tested via shadow_match_fn defined above.
  assert(shadow_match_fn(7) == 70)
}

// Auto-drop (RAII). Cross-checks that scope-exit drop fires in both
// backends and that the well-known-property contract for `drop` is
// enforced at assignment time.
test_drop = fn () {
  // Use a captured `mut` counter to observe drop firings without
  // depending on stdout ordering.
  mut events = []
  make_thing = fn (id) {
    { drop: fn () { events.push(id) } }
  }

  // Scope-exit drop on a single object.
  {
    let _t = make_thing('a')
  }
  assert(events.size() == 1 && events[0] == 'a')

  // Cascade: parent drop fires before child drops are released.
  events = []
  make_parent = fn () {
    let c1 = make_thing('c1')
    let c2 = make_thing('c2')
    { c1: c1, c2: c2, drop: fn () { events.push('p') } }
  }
  {
    let _p = make_parent()
  }
  assert(events.size() == 3)
  assert(events[0] == 'p')        // parent's drop runs first
  // Child order between c1/c2 isn't observable from refcount semantics
  assert((events[1] == 'c1' && events[2] == 'c2') ||
         (events[1] == 'c2' && events[2] == 'c1'))
}

// JIT-safe subset of UFCS tests. The __ARGS__/variadic case lives
// in samples/test_ufcs.cul and runs under the interpreter only.
test_ufcs = fn () {
  // Free function as method on primitive
  double = fn (x) { x * 2 }
  assert(42.double() == 84)
  assert((-3).double() == -6)

  // UFCS on String / Array
  word_count = fn (s) { s.split(' ').size() }
  assert('a b c'.word_count() == 3)
  sum = fn (xs) { xs.reduce(0, fn (a, x) { a + x }) }
  assert([1, 2, 3, 4].sum() == 10)

  // Multiple args: receiver first, rest follow
  scale = fn (x, factor) { x * factor }
  assert(7.scale(3) == 21)

  // Existing method wins over same-named free function
  size = fn (x) { 99 }
  assert([1, 2, 3].size() == 3)
  assert('hello'.size() == 5)
  assert({a: 1, b: 2}.size() == 2)

  // Object HOF via UFCS
  map_keys_to = fn (o, f) {
    mut r = []
    for k in o { r.push(f(k)) }
    r
  }
  ks = {b: 2, a: 1}.map_keys_to(fn (k) { k })
  assert(ks.size() == 2)
  assert(ks[0] == 'a' && ks[1] == 'b')

  // Chain mixing builtin (Array.map) and UFCS (sum/incr)
  incr = fn (x) { x + 1 }
  result = [1, 2, 3]
    .map(fn (x) { x * 10 })
    .sum()
    .incr()
  assert(result == 61)

  // Variadic __ARGS__: overflow goes to __ARGS__, and __ARGS__ is
  // always bound (empty Array when no overflow).
  greet = fn () {
    if __ARGS__.size() > 0 { "hello {__ARGS__[0]}" } else { 'hello' }
  }
  assert('world'.greet() == 'hello world')
  assert(greet() == 'hello')
  collect_extras = fn (first) { __ARGS__ }
  assert(collect_extras('a').size() == 0)
  rest = collect_extras(1, 2, 3)
  assert(rest.size() == 2 && rest[0] == 2 && rest[1] == 3)
}

// JIT-safe subset of for-in tests. Iterator-protocol coverage
// (user-defined iter/next, lazy Math.range, iterator methods) lives
// in samples/test_iter.cul and runs under the interpreter only.
test_for_in = fn () {
  // Array iteration
  mut sum = 0
  for x in [1, 2, 3, 4] { sum = sum + x }
  assert(sum == 10)

  // Object iteration yields keys (ascending)
  mut keys = []
  for k in {b: 2, a: 1, c: 3} { keys.push(k) }
  assert(keys.size() == 3)
  assert(keys[0] == 'a' && keys[1] == 'b' && keys[2] == 'c')

  // break exits inner loop only
  mut hit = 0
  for i in [1, 2, 3] {
    for j in [10, 20, 30] {
      if j == 20 { break }
      hit = hit + 1
    }
  }
  assert(hit == 3)

  // continue skips
  mut evens = 0
  for x in [1, 2, 3, 4, 5, 6] {
    if x % 2 == 1 { continue }
    evens = evens + 1
  }
  assert(evens == 3)

  // Empty iteration
  mut touched = false
  for _ in [] { touched = true }
  assert(touched == false)

  // Math.iota returns an Array — goes through the Array fast path.
  mut total = 0
  for i in Math.iota(5) { total = total + i }
  assert(total == 10)

  // String: UTF-8 scalar walk. 'café' is 5 bytes but 4 scalars.
  mut count = 0
  for c in 'hello' { count = count + 1 }
  assert(count == 5)
  mut scalars = 0
  for c in 'café' { scalars = scalars + 1 }
  assert(scalars == 4)
  mut parts = []
  for c in 'ab' { parts.push(c) }
  assert(parts.size() == 2)
  assert(parts[0] == 'a' && parts[1] == 'b')
}

test_stdlib = fn () {
  assert(Math.abs(-7) == 7)
  assert(Math.abs(5) == 5)
  assert(Math.min(3, 5) == 3)
  assert(Math.max(3, 5) == 5)
  assert(Math.pow(2, 10) == 1024)
  assert(Math.pow(7, 0) == 1)
  assert(Math.pow(-3, 3) == -27)
  assert(Math.sign(-5) == -1)
  assert(Math.sign(0) == 0)
  assert(Math.sign(42) == 1)
  assert(Math.clamp(5, 0, 10) == 5)
  assert(Math.clamp(-5, 0, 10) == 0)
  assert(Math.clamp(15, 0, 10) == 10)
  assert(Math.iota(3).size() == 3)
  assert(Math.iota(3)[0] == 0 && Math.iota(3)[2] == 2)
  assert(Math.iota(2, 5).size() == 3)
  assert(Math.iota(2, 5)[0] == 2 && Math.iota(2, 5)[2] == 4)
  assert(Math.iota(5, 2).size() == 0)
  assert(to_long('42') == 42)
  assert(to_long('  -7  ') == -7)
  assert(to_string(42) == '42')
  assert(to_string('hi') == 'hi')
  assert(type_of(42) == 'Long')
  assert(type_of('x') == 'String')
  assert(type_of([1]) == 'Array')
  assert(type_of({a: 1}) == 'Object')
  assert(type_of(nil) == 'Nil')
  assert(type_of(true) == 'Bool')
}


debugger
test_call()
test_return()
test_closure()
test_nil()
test_array()
test_function()
test_object()
test_object_factory()
test_class()
debugger
test_sum()
test_float()
test_fib()
test_interpolated_string()
test_lexical_scope()
test_builtin_methods()
test_shadow_rules()
// After test_shadow_rules, the top-level binding should be unchanged
// because the inner `mut shadow_src_value = 999` was a local shadow.
assert(shadow_src_value == 100)
test_stdlib()
test_drop()
test_ufcs()
test_for_in()

return // end
