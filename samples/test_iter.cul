# For-in / iterator protocol regression tests.
#
# INTERPRETER ONLY. The JIT implements direct for-in over Array/Object/
# String (see test_for_in in test.cul) but not the user-level iterator
# protocol or lazy iterator methods exercised here.
#
# Run with: ./build/culebra samples/test_iter.cul

# Array iteration
mut sum = 0
for x in [1, 2, 3, 4] { sum = sum + x }
assert(sum == 10)

# Object iteration yields keys (ascending)
mut keys = []
for k in {b: 2, a: 1, c: 3} { keys.push(k) }
assert(keys.size() == 3)
assert(keys[0] == 'a' && keys[1] == 'b' && keys[2] == 'c')

# break exits inner loop only
mut hit = 0
for i in [1, 2, 3] {
  for j in [10, 20, 30] {
    if j == 20 { break }
    hit = hit + 1
  }
}
assert(hit == 3)

# continue skips
mut evens = 0
for x in [1, 2, 3, 4, 5, 6] {
  if x % 2 == 1 { continue }
  evens = evens + 1
}
assert(evens == 3)

# User-defined iterator
once = fn (v) {
  mut emitted = false
  {
    iter: fn () { this },
    next: fn () {
      if emitted { { done: true } }
      else { emitted = true; { done: false, value: v } }
    }
  }
}
mut seen = []
for x in once(42) { seen.push(x) }
assert(seen.size() == 1 && seen[0] == 42)

# Empty iteration
mut touched = false
for _ in [] { touched = true }
assert(!touched)

# Iteration over Math.iota (factory-returned Array)
mut total = 0
for i in Math.iota(5) { total = total + i }
assert(total == 10)

# --- Phase 2: String iteration (UTF-8 scalar walk) ---
mut count = 0
for c in 'hello' { count = count + 1 }
assert(count == 5)

# Non-ASCII: 'café' is 5 UTF-8 bytes but 4 scalars
mut scalars = 0
for c in 'café' { scalars = scalars + 1 }
assert(scalars == 4)

# Scalars are yielded as 1-char Strings, not Longs
mut parts = []
for c in 'ab' { parts.push(c) }
assert(parts.size() == 2)
assert(parts[0] == 'a' && parts[1] == 'b')

# --- String.code_points() — Iterator<Long> over Unicode scalars ---
cps = 'café'.code_points().collect()
assert(cps.size() == 4)
assert(cps[0] == 99 && cps[1] == 97 && cps[2] == 102 && cps[3] == 233)

# Numeric ops are natural on code points (range / classification)
upper = 'Hello World'.code_points()
  .filter(fn (cp) { cp >= 65 && cp <= 90 })
  .count()
assert(upper == 2)

# Empty and ASCII-only
assert(''.code_points().count() == 0)
assert('hello'.code_points().count() == 5)

# --- String.graphemes() — Iterator<String> over Extended Grapheme Clusters ---
gs = 'a👨‍👩‍👧b'.graphemes().collect()
assert(gs.size() == 3)
assert(gs[0] == 'a')
assert(gs[1] == '👨‍👩‍👧')
assert(gs[2] == 'b')

# No combining marks → each scalar is its own grapheme
assert('café'.graphemes().count() == 4)
# Scalar count depends on exact source bytes (ZWJ separators included);
# grapheme count is the API-level guarantee.
assert('a👨‍👩‍👧b'.code_points().count() == 7)
assert('a👨‍👩‍👧b'.graphemes().count() == 3)
assert(''.graphemes().count() == 0)

# --- Phase 2: Math.range (lazy integer iterator) ---
mut sum = 0
for i in Math.range(5) { sum = sum + i }
assert(sum == 10)

# Empty range
mut touched = false
for _ in Math.range(5, 2) { touched = true }
assert(!touched)

# Large bounds with early break — must not OOM/hang
mut n = 0
for i in Math.range(1000000) {
  n = i
  if i >= 3 { break }
}
assert(n == 3)

# start, end form
mut coll = []
for i in Math.range(3, 7) { coll.push(i) }
assert(coll.size() == 4)
assert(coll[0] == 3 && coll[3] == 6)

# --- Phase 3: non-terminal Iterator methods ---

# map
r1 = [1, 2, 3].iter().map(fn (x) { x * 10 }).collect()
assert(r1.size() == 3)
assert(r1[0] == 10 && r1[2] == 30)

# filter
r2 = Math.range(10).filter(fn (x) { x % 3 == 0 }).collect()
assert(r2.size() == 4)
assert(r2[0] == 0 && r2[3] == 9)

# take — lazy: never touches the 1M elements beyond index 3
r3 = Math.range(1000000).take(3).collect()
assert(r3.size() == 3)
assert(r3[0] == 0 && r3[2] == 2)

# skip
r4 = Math.range(10).skip(7).collect()
assert(r4.size() == 3)
assert(r4[0] == 7 && r4[2] == 9)

# take_while
r5 = Math.range(20).take_while(fn (x) { x < 5 }).collect()
assert(r5.size() == 5)
assert(r5[0] == 0 && r5[4] == 4)

# chain
r6 = [1, 2].iter().chain([3, 4]).collect()
assert(r6.size() == 4)
assert(r6[0] == 1 && r6[3] == 4)

# zip: stops at shorter side
r7 = [1, 2, 3, 4].iter().zip([10, 20]).collect()
assert(r7.size() == 2)
assert(r7[0].first == 1 && r7[0].second == 10)
assert(r7[1].first == 2 && r7[1].second == 20)

# enumerate
r8 = ['a', 'b'].iter().enumerate().collect()
assert(r8.size() == 2)
assert(r8[0].index == 0 && r8[0].value == 'a')
assert(r8[1].index == 1 && r8[1].value == 'b')

# flat_map
r9 = [[1, 2], [], [3]].iter().flat_map(fn (xs) { xs }).collect()
assert(r9.size() == 3)
assert(r9[0] == 1 && r9[1] == 2 && r9[2] == 3)

# --- Phase 3: terminal Iterator methods ---

# for_each
mut acc = 0
[1, 2, 3].iter().for_each(fn (x) { acc = acc + x })
assert(acc == 6)

# reduce
s = Math.range(1, 6).reduce(0, fn (a, x) { a + x })
assert(s == 15)

s2 = [].iter().reduce(42, fn (a, x) { a + x })
assert(s2 == 42)   # empty → init

# find
f = Math.range(100).find(fn (x) { x > 10 && x % 3 == 0 })
assert(f == 12)

f2 = [1, 2, 3].iter().find(fn (x) { x > 99 })
assert(f2 == nil)

# any / all
assert([1, 2, 3].iter().any(fn (x) { x > 2 }) == true)
assert([1, 2, 3].iter().any(fn (x) { x > 99 }) == false)
assert([1, 2, 3].iter().all(fn (x) { x > 0 }) == true)
assert([1, 2, 3].iter().all(fn (x) { x > 1 }) == false)
assert([].iter().all(fn (x) { x > 0 }) == true)   # vacuous truth

# count
assert(Math.range(100).filter(fn (x) { x % 7 == 0 }).count() == 15)
assert([].iter().count() == 0)

# Chain of chains: lazy + terminal
head = Math.range(1000000)
  .filter(fn (x) { x % 2 == 0 })
  .map(fn (x) { x * x })
  .take(4)
  .collect()
assert(head.size() == 4)
assert(head[0] == 0 && head[1] == 4 && head[2] == 16 && head[3] == 36)

# Eager Array methods still win when the receiver is an Array
# (not an iterator). Array.map returns Array, not Iterator.
m = [1, 2, 3].map(fn (x) { x + 1 })
assert(type_of(m) == 'Array')
assert(m[0] == 2 && m[2] == 4)
