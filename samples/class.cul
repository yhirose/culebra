# Two equivalent OO styles.
#
# (1) Closure-based — the idiom available since day one. State lives
# in captured locals (truly private), methods close over them.
#
# (2) `class` sugar — terser syntax, fields on `this`, carries a
# `class:` tag for match / debugging. Fields set via `this.x = ...`
# inside the class body are mutable by default. Works on both the
# tree interpreter and the JIT.

# --- (1) closure style ---
Car = {
  new: fn (miles_per_run) {
    mut total_miles = 0
    {
      run:   fn (times) { total_miles = total_miles + miles_per_run * times },
      total: fn ()      { "走行距離: {total_miles} miles." }
    }
  }
}

car = Car.new(5)
car.run(1)
car.run(2)
puts(car.total())

# --- (2) class sugar (same behavior; public fields via `this.*`) ---
class Car2 {
  new(mpr)   { this.miles = 0; this.mpr = mpr }
  run(n)     { this.miles = this.miles + this.mpr * n }
  total()    { "走行距離: {this.miles} miles." }
}

car2 = Car2.new(5)
car2.run(1)
car2.run(2)
puts(car2.total())
puts(car2.class)                     # 'Car2'
