# Tensor autograd — drop-in autograd layer over Phase 1 Tensor.
# Mirrors the scalar Value class in microgpt.cul (Karpathy's micrograd
# pattern) but with each node holding a Tensor instead of a Float.
#
# Used by microgpt_tensor.cul (work in progress; this file is the
# autograd primitive that the transformer port will be rewritten on
# top of in F.2 / F.3 / F.4 of the Tensor-port milestone).
#
# Each op:
#   1. Computes the forward Tensor result
#   2. Wraps it in a TNode together with parents and a backward closure
#   3. The backward closure knows how to push grad back through this op
#
# `node.backward()` runs a topological-sort pass and invokes each
# closure in reverse, accumulating .grad on every TNode in the graph.
# Parameters (leaf TNodes) end up with full gradients ready for the
# optimizer.
#
# This file is independent — load it, run it, and a small linear-
# regression smoke test trains and checks the loss decreases.

class TNode {
  new(data, children = []) {
    this.data = data                     # Tensor (forward value)
    this.grad = Tensor.zeros(data.shape())  # Tensor (gradient, zero-init)
    this._children = children
    this._backward_fn = nil              # closure set by op factories
    this._visited = false
  }
  set_backward(f) { this._backward_fn = f }
  zero_grad() { this.grad = Tensor.zeros(this.data.shape()) }

  backward() {
    # Topological sort: children before parents so reverse-order
    # iteration sees a node only after all its consumers' grads are
    # accumulated.
    mut topo = []
    let build_topo = |node| {
      if !node._visited {
        node._visited = true
        for ch in node._children { self(ch) }
        topo.push(node)
      }
    }
    build_topo(this)

    # Seed the root with all-ones (this is the dL/dself for L = self).
    this.grad = Tensor.ones(this.data.shape())
    Tensor.eval(this.grad)

    topo.reverse()
    for tv in topo {
      if tv._backward_fn != nil { tv._backward_fn() }
    }
    # Materialize accumulated grads in one batched eval per leaf.
    for tv in topo {
      Tensor.eval(tv.grad)
      tv._visited = false
    }
  }
}

# --- Op factories ---
#
# Each returns a fresh TNode and wires up a backward closure. The
# closures capture their input nodes (parents) so they can read .data
# during backward and accumulate into parents' .grad.

let ts_add = fn (a, b) {
  let out = TNode.new(a.data + b.data, [a, b])
  out.set_backward(fn() {
    # d(a+b)/da = 1, d(a+b)/db = 1; just pass-through
    a.grad += out.grad
    b.grad += out.grad
  })
  out
}

let ts_sub = fn (a, b) {
  let out = TNode.new(a.data - b.data, [a, b])
  out.set_backward(fn() {
    a.grad += out.grad
    b.grad -= out.grad
  })
  out
}

let ts_mul = fn (a, b) {
  let out = TNode.new(a.data * b.data, [a, b])
  out.set_backward(fn() {
    a.grad += out.grad * b.data
    b.grad += out.grad * a.data
  })
  out
}

let ts_dot = fn (a, b) {
  # a [M, K] @ b [K, N] = out [M, N]
  let out = TNode.new(a.data.dot(b.data), [a, b])
  out.set_backward(fn() {
    # dL/da = dL/dout @ b^T  ([M, N] @ [N, K] = [M, K])
    # dL/db = a^T @ dL/dout  ([K, M] @ [M, N] = [K, N])
    a.grad += out.grad.dot(b.data.transpose())
    b.grad += a.data.transpose().dot(out.grad)
  })
  out
}

let ts_sum = fn (a) {
  # axis-less sum: scalar Float, but we wrap as a [1, 1] Tensor for
  # uniform handling. (TNode.data must be a Tensor.)
  let s = a.data.sum()                           # Float
  let s_t = Tensor.from([[s]])                   # [1, 1]
  let out = TNode.new(s_t, [a])
  out.set_backward(fn() {
    # dL/da = dL/dout (broadcast scalar across a's shape)
    let g = to_float(out.grad.to_array()[0][0])
    a.grad += Tensor.ones(a.data.shape()) * g
  })
  out
}

# --- Smoke test: linear regression ---
#
# Fit y = W * x with synthetic data. Loss = (W*x - target)^2 summed.
# After a few gradient steps, loss should be much smaller.

# Target weights (what the model should learn).
let W_target = Tensor.from([[2.0, -1.0], [0.5, 3.0]])
let x_const = Tensor.from([[1.0], [2.0]])
let y_target_tensor = W_target.dot(x_const)       # [[0], [6.5]]
Tensor.eval(y_target_tensor)
puts("target y = {y_target_tensor.to_array()}")

# Model parameter: W initialized small. Wrap as TNode so its grad
# accumulates.
mut W = TNode.new(Tensor.randn(2, 2) * 0.1)
let x = TNode.new(x_const)                        # leaf, no grad needed
let y_target = TNode.new(y_target_tensor)         # leaf

let lr = 0.1
mut step = 0
while step < 30 {
  W.zero_grad()
  let y_pred = ts_dot(W, x)                       # [2, 1]
  let diff = ts_sub(y_pred, y_target)
  let sq = ts_mul(diff, diff)
  let loss = ts_sum(sq)
  loss.backward()

  # SGD: W.data -= lr * W.grad  (in-place via Tensor)
  W.data -= W.grad * lr
  Tensor.eval(W.data)

  if step % 5 == 0 || step == 29 {
    let l = to_float(loss.data.to_array()[0][0])
    puts("step {step}: loss = {l}")
  }
  step = step + 1
}

# Check: W should now be close to W_target.
let final_W = W.data.to_array()
puts("final W = {final_W}")
puts("target W = {W_target.to_array()}")
