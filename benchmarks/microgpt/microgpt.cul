# Culebra port of karpathy/microgpt (scalar autograd), unchanged
# algorithm. Reference implementation for the benchmark; reads from
# benchmarks/microgpt/names.txt.
#
# Usage: ./build/culebra [--jit] benchmarks/microgpt/microgpt.cul -- [num_steps] [n_samples]

Random.seed(42) # Let there be order among chaos

# Let there be a Dataset `docs`: list[str] of documents (e.g. a list of names)
data_path = 'benchmarks/microgpt/names.txt'
if !IO.exists(data_path) {
  puts("error: {data_path} missing. Run `just fetch-names` first.")
  Sys.exit(1)
}

mut docs = []
for line in IO.read(data_path).split("\n") {
  let s = line.trim()
  if s.size() > 0 { docs.push(s) }
}
Random.shuffle(docs)
puts("num docs: {docs.size()}")

# Let there be a Tokenizer to translate strings to sequences of integers ("tokens") and back
mut uchars = [] # unique characters in the dataset become token ids 0..n-1
for d in docs { for c in d { if !uchars.contains(c) { uchars.push(c) } } }
uchars.sort_by(|c| c)
BOS = uchars.size()              # token id for a special Beginning of Sequence (BOS) token
vocab_size = uchars.size() + 1   # total number of unique tokens, +1 is for BOS
puts("vocab size: {vocab_size}")


# Let there be Autograd to recursively apply the chain rule through a computation graph
class Value {
  new(data, children = [], local_grads = []) {
    this.data = data                # scalar value of this node calculated during forward pass
    this.grad = 0.0                 # derivative of the loss w.r.t. this node, calculated in backward pass
    this._children = children       # children of this node in the computation graph
    this._local_grads = local_grads # local derivative of this node w.r.t. its children
    this._visited = false
  }
  __add__(other) {
    match other {
      o: Object => Value.new(this.data + o.data, [this, o], [1.0, 1.0]),
      _         => Value.new(this.data + other, [this], [1.0])
    }
  }
  __mul__(other) {
    match other {
      o: Object => Value.new(this.data * o.data, [this, o], [o.data, this.data]),
      _         => Value.new(this.data * other, [this], [other])
    }
  }
  __pow__(n)     { Value.new(this.data ** n, [this], [n * this.data ** (n - 1)]) }
  __neg__()      { this * (-1.0) }
  __sub__(other) { this + (-other) }
  __div__(other) {
    match other {
      o: Object => this * (o ** -1.0),
      _         => this * (1.0 / other)
    }
  }
  log()  { Value.new(Math.log(this.data), [this], [1.0 / this.data]) }
  exp()  { d = Math.exp(this.data); Value.new(d, [this], [d]) }
  relu() {
    d = if this.data > 0.0 { this.data } else { 0.0 }
    g = if this.data > 0.0 { 1.0 } else { 0.0 }
    Value.new(d, [this], [g])
  }
  backward() {
    mut topo = []
    build_topo = |node| {
      if !node._visited {
        node._visited = true
        for ch in node._children { self(ch) }
        topo.push(node)
      }
    }
    build_topo(this)
    this.grad = 1.0
    topo.reverse()
    topo.for_each(|v| {
      range(v._children.size()).for_each(|j| {
        let child = v._children[j]
        child.grad = child.grad + v._local_grads[j] * v.grad
      })
    })
    for tv in topo { tv._visited = false }
  }
}

sum_v = |arr| arr.reduce(Value.new(0.0), |a, b| a + b)

max_data = |arr| arr.reduce(arr[0].data, |best, v|
  if v.data > best { v.data } else { best }
)


# Initialize the parameters, to store the knowledge of the model
n_layer = 1     # depth of the transformer neural network (number of layers)
n_embd = 16     # width of the network (embedding dimension)
block_size = 16 # maximum context length of the attention window (note: the longest name is 15 characters)
n_head = 4      # number of attention heads
head_dim = n_embd / n_head # derived dimension of each head
attn_scale = 1.0 / (head_dim ** 0.5)

matrix = |nout, nin, std = 0.08|
  range(nout).map(|_|
    range(nin).map(|_| Value.new(Random.gauss(0.0, std))).collect()
  ).collect()

# Wrap the parameters in a class so that `model.parameters()` returns
# every Value automatically (the walker descends Arrays and plain
# Object dicts in alphabetical-key order). Matrix construction order
# mirrors the upstream Python's `state_dict.values()` iteration
# (`wte`, `wpe`, `lm_head`, then per-layer attn/mlp) for structural
# fidelity. Loss curves still diverge step-by-step because
# `Random.shuffle` / `Random.gauss` use different PRNG algorithms
# than Python (Mersenne Twister state isn't portable), but the
# overall convergence behavior matches.
class GPT {
  new() {
    this.wte = matrix(vocab_size, n_embd)
    this.wpe = matrix(block_size, n_embd)
    this.lm_head = matrix(vocab_size, n_embd)
    mut layers = []
    for _ in 0..n_layer {
      layers.push({
        attn_wq: matrix(n_embd, n_embd),
        attn_wk: matrix(n_embd, n_embd),
        attn_wv: matrix(n_embd, n_embd),
        attn_wo: matrix(n_embd, n_embd),
        mlp_fc1: matrix(4 * n_embd, n_embd),
        mlp_fc2: matrix(n_embd, 4 * n_embd)
      })
    }
    this.layers = layers
  }
}

let model = GPT.new()
let params = model.parameters()
puts("num params: {params.size()}") # flat Array<Value>, one per scalar weight


# Define the model architecture: a function mapping tokens and parameters to logits over what comes next
# Follow GPT-2, blessed among the GPTs, with minor differences: layernorm -> rmsnorm, no biases, GeLU -> ReLU
dot = |a, b| range(a.size()).reduce(Value.new(0.0),
  |acc, i| acc + a[i] * b[i])

linear = |x, w| w.map(|wo| dot(wo, x))

softmax = |logits| {
  let mx = max_data(logits)
  let exps = logits.map(|v| (v - mx).exp())
  let total = sum_v(exps)
  exps.map(|e| e / total)
}

rmsnorm = |x| {
  let ms = sum_v(x.map(|xi| xi * xi)) * (1.0 / x.size())
  let scale = (ms + 1e-5) ** -0.5
  x.map(|xi| xi * scale)
}

add_v = |a, b| range(a.size()).map(|i| a[i] + b[i]).collect()

gpt = fn (token_id, pos_id, keys, values) {
  let tok_emb = model.wte[token_id]               # token embedding
  let pos_emb = model.wpe[pos_id]                 # position embedding
  mut x = rmsnorm(add_v(tok_emb, pos_emb))        # joint token and position embedding, then rmsnorm
                                                  # (not redundant: backward pass via the residual connection)

  for li in 0..n_layer {
    # 1) Multi-head Attention block
    let x_residual1 = x
    x = rmsnorm(x)
    let layer = model.layers[li]
    let q = linear(x, layer.attn_wq)
    let k = linear(x, layer.attn_wk)
    let v = linear(x, layer.attn_wv)
    keys[li].push(k)
    values[li].push(v)

    let x_attn = range(n_head).flat_map(|h| {
      let hs = h * head_dim
      let q_h = q.slice(hs, hs + head_dim)
      let k_h = keys[li].map(|ki| ki.slice(hs, hs + head_dim))
      let v_h = values[li].map(|vi| vi.slice(hs, hs + head_dim))
      let attn_logits = k_h.map(|kt| dot(kt, q_h) * attn_scale)
      let attn_weights = softmax(attn_logits)
      range(head_dim).map(|j|
        range(v_h.size()).reduce(Value.new(0.0),
          |acc, t| acc + attn_weights[t] * v_h[t][j])
      ).collect()
    }).collect()

    x = add_v(linear(x_attn, layer.attn_wo), x_residual1)

    # 2) MLP block
    let x_residual2 = x
    x = rmsnorm(x)
    x = linear(x, layer.mlp_fc1).map(|xi| xi.relu())
    x = add_v(linear(x, layer.mlp_fc2), x_residual2)
  }
  linear(x, model.lm_head)
}


# Let there be Adam, the blessed optimizer and its buffers
learning_rate = 0.01
beta1 = 0.85
beta2 = 0.99
eps_adam = 1e-8
mut m_buf = [] # first moment buffer
mut v_buf = [] # second moment buffer
for _ in 0..params.size() { m_buf.push(0.0); v_buf.push(0.0) }

# Repeat in sequence
num_steps = if Sys.argv.size() > 0 { to_long(Sys.argv[0]) } else { 1000 } # number of training steps
mut final_loss = 0.0

mut step = 0
while step < num_steps {
  # Take single document, tokenize it, surround it with BOS special token on both sides
  let doc = docs[step % docs.size()]
  mut tokens = [BOS]
  for c in doc { tokens.push(uchars.index_of(c)) }
  tokens.push(BOS)
  let n = if block_size < tokens.size() - 1 { block_size } else { tokens.size() - 1 }

  # Forward the token sequence through the model, building up the computation graph all the way to the loss
  mut keys = []
  mut values = []
  for _ in 0..n_layer { keys.push([]); values.push([]) }

  let total_loss = range(n).reduce(Value.new(0.0), |acc, pos_id| {
    let probs = softmax(gpt(tokens[pos_id], pos_id, keys, values))
    acc + (-probs[tokens[pos_id + 1]].log())
  })
  let loss = (1.0 / n) * total_loss # final average loss over the document sequence. May yours be low.

  # Backward the loss, calculating the gradients with respect to all model parameters
  loss.backward()

  # Adam optimizer update: update the model parameters based on the corresponding gradients
  let lr_t = learning_rate * (1.0 - to_float(step) / to_float(num_steps)) # linear learning rate decay
  for i in 0..params.size() {
    let p = params[i]
    m_buf[i] = beta1 * m_buf[i] + (1.0 - beta1) * p.grad
    v_buf[i] = beta2 * v_buf[i] + (1.0 - beta2) * p.grad * p.grad
    let m_hat = m_buf[i] / (1.0 - beta1 ** (step + 1))
    let v_hat = v_buf[i] / (1.0 - beta2 ** (step + 1))
    p.data = p.data - lr_t * m_hat / (v_hat ** 0.5 + eps_adam)
    p.grad = 0.0
  }

  if (step + 1) % 10 == 0 || step == 0 {
    puts("step {step+1} / {num_steps} | loss {loss.data}")
  }
  final_loss = loss.data
  step = step + 1
}

puts("final loss: {final_loss}")


# Inference: may the model babble back to us
let n_samples = if Sys.argv.size() > 1 { to_long(Sys.argv[1]) } else { 5 }
temperature = 0.5 # in (0, 1], control the "creativity" of generated text, low to high
puts('--- inference (new, hallucinated names) ---')
let pop = range(vocab_size).collect()

mut sample_idx = 0
while sample_idx < n_samples {
  mut keys2 = []
  mut values2 = []
  for _ in 0..n_layer { keys2.push([]); values2.push([]) }
  mut token_id = BOS
  mut sample = []
  for pos_id in 0..block_size {
    let logits = gpt(token_id, pos_id, keys2, values2)
    let probs = softmax(logits.map(|l| l / temperature))
    let weights = probs.map(|p| p.data)
    token_id = Random.weighted_choice(pop, weights)
    if token_id == BOS { break }
    sample.push(uchars[token_id])
  }
  puts("sample {sample_idx+1}: {sample.join('')}")
  sample_idx = sample_idx + 1
}
