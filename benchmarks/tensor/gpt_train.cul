# One GPT training step — token and position embeddings, pre-norm blocks of
# causal multi-head attention and a ReLU MLP, a tied output head,
# cross-entropy, backward, Adam — written the way the Tensor chapter of
# the stdlib reference spells a training loop (a leaf per parameter,
# `.detach()` on every update). gpt_train.py is the same model in PyTorch.
#
# The whole step is timed, not a hand-picked op: whatever a step costs a
# program (the backward's transposed products, the embedding scatter, the
# optimizer's elementwise work, host bookkeeping between launches) shows up.
#
# Usage: ./build/culebra --jit benchmarks/tensor/gpt_train.cul [cpu|gpu|auto] [small|medium|large]

let device = if !Sys.argv.empty() {
  Sys.argv[0]
} else {
  'gpu'
}
let config = if Sys.argv.size() > 1 {
  Sys.argv[1]
} else {
  'small'
}
if device == 'cpu' {
  Tensor.use_cpu()
} else if device == 'gpu' {
  Tensor.use_gpu()
} else {
  Tensor.use_auto()
}

# vocab, width, heads, layers, seq, batch, warmup steps, timed steps —
# identical to gpt_train.py
let cfg = if config == 'small' {
  [4096, 256, 4, 4, 256, 8, 3, 10]
} else if config == 'medium' {
  [8192, 512, 8, 6, 512, 8, 3, 10]
} else {
  [16384, 768, 12, 8, 1024, 4, 3, 5]
}
let V = cfg[0]
let C = cfg[1]
let H = cfg[2]
let L = cfg[3]
let T = cfg[4]
let B = cfg[5]
let WARMUP = cfg[6]
let STEPS = cfg[7]
let D = C / H
let N = B * T
let LR = 3.0e-4
let BETA1 = 0.9
let BETA2 = 0.95
let EPS = 1.0e-8

# --- Data: one fixed batch, the same ids gpt_train.py builds ---

let id_tensor = fn (mul, add, n) {
  mut out = []
  for i in range(N) {
    out.push(to_float((i * mul + add) % n))
  }
  Tensor.from(out)
}
let tokens = id_tensor(7919, 13, V)
let targets = id_tensor(104729, 7, V)
let positions = id_tensor(1, 0, T)

# --- Parameters: a leaf each, boxed so the optimizer can replace it ---

class Param {
  new(t) {
    self.t = t
  }
}

let leaf = fn (t) {
  Param.new(t.detach().requires_grad())
}
let normal = fn (rows, cols) {
  leaf(Tensor.randn(rows, cols) * 0.02)
}
let zeros = fn (n) {
  leaf(Tensor.zeros(n))
}
let ones = fn (n) {
  leaf(Tensor.ones(n))
}

let wte = normal(V, C)
let wpe = normal(T, C)
let lnf_g = ones(C)
let lnf_b = zeros(C)
mut layers = []
for _ in range(L) {
  layers.push({
    ln1_g: ones(C),
    ln1_b: zeros(C),
    wq: normal(C, C),
    bq: zeros(C),
    wk: normal(C, C),
    bk: zeros(C),
    wv: normal(C, C),
    bv: zeros(C),
    wo: normal(C, C),
    bo: zeros(C),
    ln2_g: ones(C),
    ln2_b: zeros(C),
    fc1: normal(C, 4 * C),
    b1: zeros(4 * C),
    fc2: normal(4 * C, C),
    b2: zeros(C),
  })
}

mut params = [wte, wpe, lnf_g, lnf_b]
for l in layers {
  for p in [l.ln1_g, l.ln1_b, l.wq, l.bq, l.wk, l.bk, l.wv, l.bv, l.wo, l.bo, l.ln2_g, l.ln2_b, l.fc1, l.b1, l.fc2, l.b2] {
    params.push(p)
  }
}

# --- Model ---

# [N, C] rows to [B*H, T, D] heads, and back.
let split_heads = fn (t) {
  t.reshape([B, T, H, D]).permute([0, 2, 1, 3]).reshape([B * H, T, D])
}
let merge_heads = fn (t) {
  t.reshape([B, H, T, D]).permute([0, 2, 1, 3]).reshape([N, C])
}

let forward = fn () {
  mut x = wte.t.index_select(tokens) + wpe.t.index_select(positions)
  for l in layers {
    let h = x.layer_norm(l.ln1_g.t, l.ln1_b.t)
    let q = split_heads(h.dot(l.wq.t) + l.bq.t)
    let k = split_heads(h.dot(l.wk.t) + l.bk.t)
    let v = split_heads(h.dot(l.wv.t) + l.bv.t)
    let ctx = merge_heads(q.causal_attention(k, v))
    x += ctx.dot(l.wo.t) + l.bo.t
    let h2 = x.layer_norm(l.ln2_g.t, l.ln2_b.t)
    x += (h2.dot(l.fc1.t) + l.b1.t).relu().dot(l.fc2.t) + l.b2.t
  }
  let logits = x.layer_norm(lnf_g.t, lnf_b.t).dot(wte.t.transpose())  # tied head
  logits.softmax_cross_entropy(targets).mean(0)
}

# --- Adam (torch.optim.Adam's update, same hyperparameters) ---

mut m = []
mut v = []
for p in params {
  m.push(Tensor.zeros(p.t.shape()))
  v.push(Tensor.zeros(p.t.shape()))
}

let adam = fn (step) {
  let bc1 = 1.0 - BETA1 ** to_float(step)
  let bc2 = 1.0 - BETA2 ** to_float(step)
  for i in range(params.size()) {
    let p = params[i]
    let g = p.t.grad()
    m[i] = (m[i] * BETA1 + g * (1.0 - BETA1)).detach()
    v[i] = (v[i] * BETA2 + g * g * (1.0 - BETA2)).detach()
    let update = (m[i] * (LR / bc1)) / ((v[i] * (1.0 / bc2)).pow(0.5) + EPS)
    p.t = (p.t - update).detach().requires_grad()
  }
}

let train_step = fn (step) {
  for p in params {
    p.t.zero_grad()
  }
  let loss = forward()
  loss.backward()
  adam(step)
  loss
}

# --- Timing ---

let loss0 = train_step(1).item()
for s in 2..=WARMUP {
  train_step(s)
}

let t0 = Sys.time()
mut last = nil
for s in WARMUP + 1..=WARMUP + STEPS {
  last = train_step(s)
}
# Reading the loss waits for whatever the device still has in flight, the
# counterpart of gpt_train.py's synchronize before its clock stops.
let loss = last.item()
let per = 1000.0 * (Sys.time() - t0) / to_float(STEPS)
print("BENCH label=culebra_gpt_train device={device} config={config} tokens={N} ms_per_step={per} loss0={loss0} loss={loss}\n")
