# Tensor port of benchmarks/mnist/infer.cul. Routes the forward pass
# through the builtin Tensor type (BLAS sgemm + fused linear_sigmoid).
# Runs CYCLES cycles in-process and reports cold (cycle 1) vs
# warm-mean (cycles 2..K).

let DIR = 'benchmarks/mnist'
let CYCLES = 3

let load_int_1d = fn (path) {
  mut out = []
  for line in FS.read(path).split("\n") {
    let s = line.trim()
    if s.size() == 0 {
      continue
    }
    out.push(to_long(s))
  }
  out
}

# Sanity: required CSVs must be present.
for f in ['W1.csv', 'b1.csv', 'W2.csv', 'b2.csv', 'test_images.csv', 'test_labels.csv'] {
  if !FS.exists("{DIR}/{f}") {
    inspect("missing {DIR}/{f}; run train.py and prep_test.py first")
    Sys.exit(1)
  }
}

let load_t0 = Sys.time()
let W1 = Tensor.from_csv("{DIR}/W1.csv")          # [30, 784]
let b1 = Tensor.from_csv("{DIR}/b1.csv")          # [30, 1]
let W2 = Tensor.from_csv("{DIR}/W2.csv")          # [10, 30]
let b2 = Tensor.from_csv("{DIR}/b2.csv")          # [10, 1]
let X = Tensor.from_csv("{DIR}/test_images.csv")  # [N, 784]
let y = load_int_1d("{DIR}/test_labels.csv")
let t_load = Sys.time() - load_t0

let n = X.shape()[0]
inspect("[culebra-tensor] loaded N={n} in {t_load}s (W1=30x784, W2=10x30)")

let Xt = X.transpose()  # [784, N], zero-copy view

mut times = []
for cycle in range(CYCLES) {
  let t0 = Sys.time()
  let a1 = W1.linear_sigmoid(Xt, b1)  # [30, N]
  let a2 = W2.linear_sigmoid(a1, b2)  # [10, N]
  let preds = a2.argmax(0)            # [N]
  Tensor.eval(preds)
  times.push(Sys.time() - t0)
}

# Accuracy: re-run forward pass once outside the timing loop. Matches
# the post-train pattern in train_bench.cul.
let a1 = W1.linear_sigmoid(Xt, b1)
let a2 = W2.linear_sigmoid(a1, b2)
let preds = a2.argmax(0)
Tensor.eval(preds)
let p = preds.to_array()
mut correct = 0
for k in range(n) {
  if to_long(p[k]) == y[k] {
    correct = correct + 1
  }
}
let acc = to_float(correct) / to_float(n)

let cold = times[0]
mut warm_sum = 0.0
for t in times {
  warm_sum = warm_sum + t
}
warm_sum = warm_sum - cold
let warm = if times.size() > 1 {
  warm_sum / to_float(times.size() - 1)
} else {
  Math.nan
}
inspect("[culebra-tensor] cold={cold}s warm={warm}s accuracy={acc}")
print("BENCH label=culebra_tensor_infer load={t_load} cold={cold} warm={warm} accuracy={acc}\n")
