# MNIST autoencoder training benchmark: 784->512->256->64->256->512->784
# (sigmoid, MSE, SGD), replicating the shape/hyperparameters of
# silarray's bench/mnist/bench_autoencoder.cpp to compare culebra
# Tensor's cpu/gpu/auto backends on a realistic (not synthetic)
# workload. Mini-batch SGD, batch=100, 1 epoch = 600 steps over
# 60,000 images (unlike a single giant full-batch step, this lets
# the GPU backend pipeline many small kernel dispatches, which is
# what actually crosses the GPU/CPU threshold in practice).
#
# Usage: ./build/culebra --jit benchmarks/mnist/train_bench_autoencoder.cul [cpu|gpu|auto]

let DIR = 'benchmarks/mnist'
let L = [784, 512, 256, 64, 256, 512, 784]
let N_LAYERS = 6
let BATCH = 100
let LR = 0.01
let CYCLES = 2

let device = if Sys.argv.size() > 0 { Sys.argv[0] } else { 'auto' }
if device == 'cpu' { Tensor.use_cpu() }
else if device == 'gpu' { Tensor.use_gpu() }
else { Tensor.use_auto() }

if !FS.exists("{DIR}/train_images.csv") {
  inspect("missing {DIR}/train_images.csv; run prep_train.py 60000 first")
  Sys.exit(1)
}

let load_t0 = Sys.time()
let X = Tensor.from_csv("{DIR}/train_images.csv") # [N, 784]
let t_load = Sys.time() - load_t0
let n = X.shape()[0]
inspect("[culebra-tensor-autoencoder] device={device} loaded train={n} in {t_load}s")

let make_weights = fn () {
  mut Ws = []
  mut bs = []
  for l in range(N_LAYERS) {
    let n_in = L[l]
    let n_out = L[l + 1]
    # .clone() works around a resolver bug where reassigning a mut var
    # from a raw binop expression makes it look immutable to a callee's
    # first parameter that later does `-=`/index-assign on it. Harmless
    # here: outside the timed region.
    Ws.push((Tensor.randn(n_out, n_in) * (2.0 / Math.sqrt(to_float(n_in)))).clone())
    bs.push(Tensor.zeros(n_out, 1))
  }
  [Ws, bs]
}

let run_epoch = fn (Ws, bs) {
  mut s = 0
  while s + BATCH <= n {
    let xb = X.slice(s, s + BATCH).transpose()  # [784, BATCH]

    mut outs = []
    mut h = xb
    for l in range(N_LAYERS) {
      let o = Ws[l].linear_sigmoid(h, bs[l])
      outs.push(o)
      h = o
    }

    let inv_n = 2.0 / to_float(BATCH * 784)
    mut dout = (h - xb) * inv_n

    mut l = N_LAYERS - 1
    while l >= 0 {
      let out_l = outs[l]
      let dnet = dout * out_l * (Tensor.ones(L[l + 1], BATCH) - out_l)
      let input_l = if l > 0 { outs[l - 1] } else { xb }
      let dW = dnet.dot(input_l.transpose())
      let db = dnet.sum(1).reshape([L[l + 1], 1])
      if l > 0 {
        dout = Ws[l].transpose().dot(dnet)
      }
      Ws[l] = Ws[l] - dW * LR
      bs[l] = bs[l] - db * LR
      l = l - 1
    }

    Tensor.eval(Ws[0], Ws[1], Ws[2], Ws[3], Ws[4], Ws[5])
    s = s + BATCH
  }
}

mut times = []
for cycle in range(CYCLES) {
  let wb = make_weights()
  mut Ws = wb[0]
  mut bs = wb[1]
  let t0 = Sys.time()
  run_epoch(Ws, bs)
  times.push(Sys.time() - t0)
}

let cold = times[0]
mut warm_sum = 0.0
for t in times { warm_sum = warm_sum + t }
warm_sum = warm_sum - cold
let warm = if times.size() > 1 { warm_sum / to_float(times.size() - 1) } else { Math.nan }
inspect("[culebra-tensor-autoencoder] cold={cold}s warm={warm}s")
print("BENCH label=culebra_tensor_autoencoder device={device} load={t_load} cold={cold} warm={warm}\n")
