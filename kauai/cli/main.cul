# The Kauai command line: `kauai song.kau` plays a song (options.cul reads its
# options, play.cul plays it), with the instruments it bundles (bundled.cul); `kauai convert` writes a song as a
# MusicXML score, or a score as a song. `just kauai-build` compiles it into
# one binary. The sound packages it knows are compiled in, so the binary reads
# no module at run time and needs no culebra; kauai/tools/play.cul plays a
# song with a module of one's own.
import bundled from './bundled.cul'
import cmdline from './options.cul'
import play from './play.cul'
import live from './live.cul'
import musicxml from '../convert/musicxml.cul'
import musicxml_read from '../convert/musicxml_read.cul'
import kau from '../convert/kau.cul'

let instruments = bundled.instruments

let usage = "Usage: kauai <song.kau> [options]
  --check              read and check the song, and play nothing
  --wav <file.wav>     write the song once through to a WAV file, as it
                       would sound, and play nothing; no device needed
  --from <at>          with --wav, write the part from <at> on, heard
                       from a second before it: seconds (83.5),
                       minutes and seconds (1:23.5) or a mark's name
  --to <at>            with --wav, write the part until <at>, and what
                       starts before it ringing on

       kauai convert <song.kau> <score.musicxml>
  write the song as a MusicXML score (.musicxml, .xml or a compressed .mxl)
  that notation programs open: its melody, parts, chords and band, in the
  order it plays them

       kauai convert <score.musicxml> <song.kau>
  write a MusicXML score (.musicxml, .xml or .mxl) as a song, with a band
  that plays its lines; what Kauai leaves out or changes is said

       kauai instruments
  the instruments and drums a song names after `external`; live plays
  the instruments

       kauai live <instrument> [options]
  play an instrument from a MIDI controller, as a wind controller plays it:
  its breath is the volume and the brightness, until Ctrl+C
  --midi <name>        the MIDI input whose name has <name> (the one
                       there is, when there is one)
  --breath <from>      where the breath comes from: cc2 (breath, the
                       default), cc7, cc11 or pressure
  --gain <dB>          how much louder than the instrument's own level
                       (6 by default, to stand over a song played
                       alongside); a limit keeps the loudest unclipped"

let args = Sys.argv

if args.contains("-h") || args.contains("--help") {
  println(usage)
  Sys.exit(0)
}
if args.empty() {
  IO.eprintln(usage)
  Sys.exit(2)
}

# The word after option `name`, or `fallback` without the option; the option
# with no word after it ends the program.
fn option(name, fallback) {
  let at = args.index_of(name)
  return fallback if at < 0
  if at + 1 >= args.size() {
    IO.eprintln("kauai: {name} needs a value")
    Sys.exit(2)
  }
  args[at + 1]
}

fn refuse(e) {
  IO.eprintln("{e.kind}: {e.message}")
  Sys.exit(1)
}

if args[0] == "convert" {
  let paths = args.slice(1, args.size())
  let is_score = |p| [".musicxml", ".xml", ".mxl"].any(|x| p.ends_with(x))
  let to_score = paths.size() == 2 &&
    paths[0].ends_with(".kau") &&
    is_score(paths[1])
  let to_song = paths.size() == 2 &&
    is_score(paths[0]) &&
    paths[1].ends_with(".kau")
  if !to_score && !to_song {
    IO.eprintln("kauai: convert writes a song (.kau) as a MusicXML score (.musicxml, .xml or .mxl), or a score (.musicxml, .xml or .mxl) as a song: kauai convert song.kau score.musicxml")
    Sys.exit(2)
  }
  try {
    if to_score {
      let score = musicxml.write(Kauai.parse_file(paths[0]))
      FS.write(
        paths[1],
        paths[1].ends_with(".mxl") ? musicxml.mxl(score) : score,
      )
    } else {
      let read = musicxml_read.read(musicxml_read.score_text(FS.read(paths[0])))
      let text = kau.write(read.score)
      Kauai.parse(text)
      FS.write(paths[1], text)
      for what in read.dropped {
        IO.eprintln("left out or changed: {what}")
      }
    }
  } catch e: KauaiError | IOError | ValueError {
    refuse(e)
  } catch e: String {
    # A song a score cannot hold, or a score Kauai does not play.
    IO.eprintln(e)
    Sys.exit(1)
  }
  println("{paths[0]}: written to {paths[1]}")
  Sys.exit(0)
}

if args[0] == "instruments" {
  let width = instruments.map(|i| i.name.size()).max()
  for i in instruments {
    println("{i.name}{" ".repeat(width - i.name.size() + 2)}{i.about}")
  }
  Sys.exit(0)
}

if args[0] == "live" {
  let name = args.size() > 1 ? args[1] : ""
  let found = instruments.find(|i| i.name.lower() == name.lower())
  if found == nil {
    IO.eprintln("kauai: no instrument `{name}`; `kauai instruments` lists them")
    Sys.exit(2)
  }
  if found.live == nil {
    IO.eprintln("kauai: `{found.name}` is a drum, which live does not play")
    Sys.exit(2)
  }
  let breath = option("--breath", "cc2")
  if !["cc2", "cc7", "cc11", "pressure"].contains(breath) {
    IO.eprintln("kauai: --breath is cc2, cc7, cc11 or pressure, not {breath}")
    Sys.exit(2)
  }
  let gain_text = option("--gain", nil)
  let db = try {
    gain_text == nil ? live.GAIN : to_float(gain_text)
  } catch _ {
    nil
  }
  if db == nil || !(db >= -60.0 && db <= 24.0) {
    IO.eprintln("kauai: --gain is from -60 to 24 dB, not {gain_text}")
    Sys.exit(2)
  }
  let wanted = option("--midi", nil)
  let inputs = MIDI.inputs()
  let named = wanted == nil
    ? inputs
    : inputs.filter(|p| p.name.lower().contains(wanted.lower()))
  if named.size() != 1 {
    let there = inputs.empty() ? "none" : inputs.map(|p| p.name).join(", ")
    let which = wanted == nil
      ? "one MIDI input to play from"
      : "one MIDI input named like {wanted}"
    IO.eprintln("kauai: live needs {which}; there are {there}")
    Sys.exit(1)
  }
  let player = found.live()
  println("playing {found.name} from {named[0].name} (Ctrl+C stops)")
  live.play(player, MIDI.Input.new(named[0].id), breath, db)
}

play.wait(play.start(
  cmdline.options(args, "kauai"),
  bundled.voices,
  bundled.drums,
  "kauai",
))
