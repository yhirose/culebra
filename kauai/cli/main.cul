# The Kauai command line: `kauai song.kau` plays a song, and `--check`, `--wav`,
# `--from` and `--to` do what they do under `culebra play`. `just kauai-build`
# compiles it into one binary. The sound packages it knows are compiled in, so
# the binary reads no module at run time and needs no culebra.
import soprano from '../sounds/soprano_sax/main.cul'
import alto from '../sounds/alto_sax/main.cul'
import recipes from '../recipes/main.cul'
import live from './live.cul'

let packages = [soprano, alto, recipes]

# Every bundled instrument, by the name a song gives it (`external SopranoSax`).
let voices = packages.flat_map(|p| p.voices.keys().map(|k| (k, p.voices[k]))).to_object()

# The same, as `kauai instruments` lists them.
let instruments = packages.flat_map(|p| p.instruments).sorted_by(|i| i.name)

let usage = "Usage: kauai <song.kau> [options]
  --check              read and check the song, and play nothing
  --wav <file.wav>     write the song once through to a WAV file, as it
                       would sound, and play nothing; no device needed
  --from <at>          with --wav, write the part from <at> on, heard
                       from a second before it: seconds (83.5),
                       minutes and seconds (1:23.5) or a mark's name
  --to <at>            with --wav, write the part until <at>, and what
                       starts before it ringing on

       kauai instruments
  the instruments a song names after `external`, and which play live

       kauai live <instrument> [options]
  play an instrument from a MIDI controller, as a wind controller plays it:
  its breath is the volume and the brightness, until Ctrl+C
  --midi <name>        the MIDI input whose name has <name> (the one
                       there is, when there is one)
  --breath <from>      where the breath comes from: cc2 (breath, the
                       default), cc7, cc11 or pressure
  --breath-full <x>    the breath, 0 to 1, that plays at full (0.9)"

let args = Sys.argv

if args.contains("-h") || args.contains("--help") {
  println(usage)
  Sys.exit(0)
}
if args.empty() || args[0].starts_with("-") {
  IO.eprintln(usage)
  Sys.exit(2)
}

# The word after option `name`, or `fallback` without it.
fn option(name, fallback) {
  let at = args.index_of(name)
  at < 0 || at + 1 >= args.size() ? fallback : args[at + 1]
}

if args[0] == "instruments" {
  let width = instruments.map(|i| i.name.size()).max()
  for i in instruments {
    println("{i.name}{" ".repeat(width - i.name.size() + 2)}{i.live ? "live  " : "      "}{i.about}")
  }
  Sys.exit(0)
}

if args[0] == "live" {
  let name = args.size() > 1 ? args[1] : ""
  let found = instruments.find(|i| i.name.lower() == name.lower())
  if found == nil {
    IO.eprintln("kauai: no instrument `{name}`; `kauai instruments` lists them")
    Sys.exit(2)
  }
  if !found.live {
    IO.eprintln("kauai: {found.name} is made from recordings before it plays, so it cannot be played live")
    Sys.exit(1)
  }
  let breath = option("--breath", "cc2")
  if !["cc2", "cc7", "cc11", "pressure"].contains(breath) {
    IO.eprintln("kauai: --breath is cc2, cc7, cc11 or pressure, not {breath}")
    Sys.exit(2)
  }
  let full = to_float(option("--breath-full", "0.9"))
  if !(full > 0.0 && full <= 1.0) {
    IO.eprintln("kauai: --breath-full is above 0 and at most 1")
    Sys.exit(2)
  }
  let wanted = option("--midi", nil)
  let inputs = MIDI.inputs()
  let named = wanted == nil ? inputs : inputs.filter(|p| p.name.lower().contains(wanted.lower()))
  if named.size() != 1 {
    let there = inputs.empty() ? "none" : inputs.map(|p| p.name).join(", ")
    let which = wanted == nil ? "one MIDI input to play from" : "one MIDI input named like {wanted}"
    IO.eprintln("kauai: live needs {which}; there are {there}")
    Sys.exit(1)
  }
  println("playing {found.name} from {named[0].name} (Ctrl+C stops)")
  live.play(recipes.recipe(found.recipe), MIDI.Input.new(named[0].id), breath, full)
}

let path = args[0]
let check = args.contains("--check")
let wav = args.contains("--wav") ? args[args.index_of("--wav") + 1] : nil
let from_at = args.contains("--from") ? args[args.index_of("--from") + 1] : nil
let to_at = args.contains("--to") ? args[args.index_of("--to") + 1] : nil

if wav != nil && check {
  IO.eprintln("kauai: --wav writes the song and plays nothing, so not with --check")
  Sys.exit(2)
}
if (from_at != nil || to_at != nil) && wav == nil {
  IO.eprintln("kauai: --from and --to choose the part --wav writes, so they need --wav")
  Sys.exit(2)
}

fn clock(secs) {
  let s = Math.round(secs)
  "{s / 60}:{s % 60 < 10 ? "0" : ""}{s % 60}"
}

fn refuse(e) {
  IO.eprintln("{e.kind}: {e.message}")
  Sys.exit(1)
}

let song = try {
  Audio.Kauai.load(path, voices: voices)
} catch e: KauaiError {
  refuse(e)
} catch e: IOError {
  refuse(e)
} catch e: ValueError {
  # An external instrument the program does not have.
  refuse(e)
}

if check {
  println("{path}: {clock(song.length())} once through")
  Sys.exit(0)
}
if wav == nil && !Audio.available() {
  IO.eprintln("{path}: no audio device, so nothing plays")
  Sys.exit(1)
}

# A point in the song, in seconds, from a number of seconds, minutes and
# seconds, or a mark's name. A mistake ends the program.
let marks = song.marks()
fn point(name, s) {
  return nil if s == nil
  if !"0123456789".contains(s.slice(0, 1).to_string()) && !marks.has(s) {
    let has = marks.empty() ? "none" : marks.keys().join(", ")
    IO.eprintln("kauai: {path} has no mark {s} (it has {has})")
    Sys.exit(1)
  }
  song.seconds(s)
}
let from = point("--from", from_at)
let to = point("--to", to_at)
if from != nil && from >= song.length() {
  IO.eprintln("kauai: --from {from_at} is past the song's end ({clock(song.length())})")
  Sys.exit(1)
}
if to != nil && to <= (from ?? 0.0) {
  let after = from == nil ? "the song's start" : "--from {from_at}"
  IO.eprintln("kauai: --to {to_at} is not after {after}")
  Sys.exit(1)
}

# The external sounds are built first, and a terminal shows how far along
# that is. A part builds only its own, as it renders.
let watched = IO.stdout_is_terminal()
mut left = from == nil && to == nil ? song.prepare() : 0
while left > 0 {
  print("\rpreparing sounds: {left} left ") if watched
  left = song.prepare()
}
print("\r") if watched

if wav != nil {
  let samples = song.render(from: from, to: to)
  try {
    FS.write(wav, Audio.Sound(samples).data())
  } catch e: IOError {
    refuse(e)
  }
  println("{path}: {clock(samples.size() / 44100.0)} written to {wav}")
  Sys.exit(0)
}

println("playing {path} ({clock(song.length())} once through)")
song.play()
while song.playing() {
  Time.sleep(0.1)
}
