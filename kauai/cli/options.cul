# The command line of a song played, as `kauai song.kau` and
# kauai/tools/play.cul read it. Apart from play.cul, which plays the song, so
# that a program that only reads its options (the tool's own, before it runs
# the one that plays) does not load Kauai.

# Whether `s` names a mark: a mark's name starts with a capital letter.
fn is_mark(s) {
  re'^[A-Z]'.test(s)
}

# Whether `s` is a point in a song as --from and --to take it: seconds (83,
# 83.5), minutes and seconds (1:23, 1:23.5), or a mark's name.
fn is_point(s) {
  is_mark(s) ||
    re'^[0-9]+(\.[0-9]+)?$'.test(s) ||
    re'^[0-9]+:[0-5][0-9](\.[0-9]+)?$'.test(s)
}

# Ends the program with status 2, saying `msg` after the command's name.
fn quit(name, msg) {
  IO.eprintln("{name}: {msg}")
  Sys.exit(2)
}

# `args` read by Args against `spec`, a mistake ending the program as quit
# does; an option given as `--x=` with nothing after it is one.
fn parse(args, spec) {
  let opts = try {
    Args.try_parse(args, spec)
  } catch e: ArgParseError {
    quit(spec.name, e.message)
  }
  for arg in spec.args.filter(|a| a.positional != true) {
    if opts[arg.name] == "" {
      quit(spec.name, "option '--{arg.name}' expects a value")
    }
  }
  opts
}

# The song and the options for it, in Args's form.
let SONG = [
  {name: "song", positional: true},
  {name: "check", type: "Bool", default: false},
  {name: "wav", default: nil},
  {name: "from", default: nil},
  {name: "to", default: nil},
]

# What a command line after the command asks for: {song, check, wav, from,
# to}, and the options `more` adds (Args's form). Options may come before or
# after the song, as `--wav out.wav` or `--wav=out.wav`. A mistake on it ends
# the program with status 2, before any song is read.
fn options(args, name, more = []) {
  let stop = |msg| quit(name, msg)
  let opts = parse(args, {name: name, args: SONG + more})
  for key in ["from", "to"] {
    if opts[key] != nil && !is_point(opts[key]) {
      stop("--{key} takes seconds (83.5), minutes and seconds (1:23.5) or a mark's name, not '{opts[key]}'")
    }
  }
  if opts.wav != nil && (opts.check || opts.watch == true) {
    stop("--wav writes the song and plays nothing, so not with {opts.check ? "--check" : "--watch"}")
  }
  if (opts.from != nil || opts.to != nil) && opts.wav == nil {
    let which = opts.from != nil ? "--from" : "--to"
    stop("{which} chooses the part --wav writes, so it needs --wav")
  }
  opts
}

export {options, parse, quit, is_mark}
