# `kauai live`: an instrument played from a MIDI controller, one note at a
# time, as a wind controller plays. The breath is the volume, in proportion
# (half the breath is half the amplitude), and what else it does is the
# instrument's. How hard to blow for full is the controller's own breath
# gain. Each note is made ahead, so a note played only begins it.
#
# An instrument is played through a player, which has
#
#   legato        whether a note played while another is held moves that
#                 one to the new pitch, rather than striking a new note
#   prepare()     the next note, made ahead and silent
#   breath(n, x)  note n played with the breath at x, 0.0 to 1.0
#   every         nil, or how often (s) a sounding note needs feed(n)
#   feed(n)       note n kept sounding, as `every` asks
#
# and a note has begin(pitch, level, volume, to:), retune(pitch),
# bend(semitones), volume(v), release() and done(), as the recipes' Held has
# them (`to:` a bus it plays into, nil for the device).

# The device's period asked for: a note starts this much after it is played,
# besides the device's own delay.
let PERIOD = 0.003

# The fewest seconds between two changes of a note by the breath.
let BREATH_EVERY = 0.01

# How many dB over the instrument's own level a full breath plays by
# default: an instrument made as loud as a song's lead at full breath is
# then over a song's whole band at the breath blown most, and the limit at
# its output keeps the loudest under full scale.
let GAIN = 6.0

# The breath, 0.0 to 1.0, as the output's level times `gain` (not dB), in
# proportion: squared, the breath blown most sounded 14 dB under full.
fn loudness(x, gain) {
  Math.clamp(x, 0.0, 1.0) * gain
}

# A song's room (its feedback 0.86 and damp 0.25), so a part played live
# rings as it does in a song.
let ROOM_SIZE = 4.0 / 7.0
let ROOM_DAMP = 0.625

# `dry` in a song's room heard `wet` strong (0.0 to 1.0) on each side, the
# left and the right, each held under full scale by a limit as each note is.
fn in_room(g, dry, wet) {
  let side = |k| g.limit(g.mix([dry, g.gain(g.room(dry, size: ROOM_SIZE, damp: ROOM_DAMP, side: k), wet)]))
  [side(0), side(1)]
}

# A graph that plays what is played into `bus` in a song's room, `wet`
# strong.
fn room_graph(bus, wet) {
  let g = Audio.Graph.new()
  let sides = in_room(g, g.input(bus), wet)
  g.output(sides[0], sides[1])
  g
}

# Plays `player`'s instrument from `input` until the program is stopped.
# `breath` is where the breath comes from: "cc2", "cc7", "cc11" or
# "pressure"; `db`, how many dB over its own level the instrument plays;
# `room`, how strong its room's echo is heard, 0.0 (none) to 1.0. In a room
# the notes play into a bus that one graph reads and plays in the room, so
# the room rings on past each note.
fn play(player, input, breath, db, room = 0.0) {
  let gain = 10.0 ** (db / 20.0)
  Audio.latency(PERIOD)
  let bus = room > 0.0 ? Audio.Bus(1) : nil
  # Kept while the instrument plays: a graph stops with its last reference.
  let hall = bus == nil ? nil : room_graph(bus, room)
  hall?.play()
  # The device opens on the first play(), which takes a while: open it now,
  # with a silent graph, rather than on the first note.
  let silence = Audio.Graph.new()
  silence.output(silence.gain(silence.wave(), 0.0))
  silence.play()
  silence.stop()

  let cc = breath == "pressure" ? nil : to_long(breath.slice(2, breath.size()))
  mut pressure = 0.0
  # The breath now on channel `on`, 0.0 to 1.0.
  let blown = |on| cc == nil ? pressure : input.control(cc, on)

  mut ready = player.prepare()
  mut held = nil
  mut held_pitch = nil
  mut channel = 0  # the one the notes come on, whose breath is read
  mut fading = []
  mut range = 2.0  # the bend's, in semitones, until the controller says (RPN 0)
  mut rpn = (127, 127)
  # When the note was last changed by the breath, and for what breath (nil:
  # not yet); a change held back by BREATH_EVERY waits that long for the
  # next message at most.
  mut turned = 0.0
  mut turned_for = nil
  mut behind = false

  while true {
    let fed = player.every != nil && (held != nil || !fading.empty())
    let waits = [behind ? BREATH_EVERY : nil, fed ? player.every : nil].filter(|w| w != nil)
    input.wait(waits.empty() ? nil : waits.min())
    for m in input.read() {
      cond {
        m.kind == "note_on" && held != nil && player.legato => {
          held.retune(m.note)
          held_pitch = m.note
        },
        m.kind == "note_on" => {
          if held != nil {
            held.release()
            fading.push(held)
          }
          channel = m.channel
          let level = Math.clamp(2.0 * m.velocity, 0.05, 2.0)
          held = ready.begin(m.note, level, loudness(blown(channel), gain), to: bus)
          held_pitch = m.note
          turned_for = nil
          ready = player.prepare()
        },
        m.kind == "note_off" && held != nil && m.note == held_pitch => {
          held.release()
          fading.push(held)
          held = nil
          held_pitch = nil
        },
        m.kind == "bend" => {
          held?.bend(m.bend * range)
        },
        m.kind == "pressure" => {
          pressure = m.value
        },
        m.kind == "cc" && m.cc == 101 => {
          rpn = (m.bytes[2], rpn[1])
        },
        m.kind == "cc" && m.cc == 100 => {
          rpn = (rpn[0], m.bytes[2])
        },
        m.kind == "cc" && m.cc == 6 && rpn == (0, 0) => {
          range = to_float(m.bytes[2])
        },
        _ => {},
      }
    }
    behind = false
    if held != nil {
      let x = blown(channel)
      held.volume(loudness(x, gain))
      if x != turned_for {
        if turned_for == nil || Time.monotonic() - turned >= BREATH_EVERY {
          player.breath(held, x)
          turned = Time.monotonic()
          turned_for = x
        } else {
          behind = true
        }
      }
    }
    fading = fading.filter(|h| !h.done())
    if player.every != nil {
      for n in [held, ...fading].filter(|n| n != nil) {
        player.feed(n)
      }
    }
  }
}

export {play, GAIN, in_room, ROOM_SIZE, ROOM_DAMP}
