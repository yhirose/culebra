# `kauai live`: a recipe played from a MIDI controller, one note at a time,
# as a wind controller plays. The breath is the volume, straight in dB from
# BREATH_DB down at no breath to full at `full`. When the recipe's output
# gain has an attack, the breath is that attack instead (the gain starts
# where its `on` ends) and turns the `bright` knob from its least to its
# most, and a note played while another is held moves it to the new pitch
# (legato). A recipe whose sound fades by itself, as a piano's, strikes
# every note anew. Each note is made ahead, so a note played only begins it.

# How far below full no breath is (dB).
let BREATH_DB = 40.0

# The device's period asked for: a note starts this much after it is played,
# besides the device's own delay.
let PERIOD = 0.003

# The fewest seconds between two turns of a knob by the breath.
let KNOB_EVERY = 0.01

# The breath, 0.0 to 1.0 of `full`, as the output's level.
fn loudness(x) {
  x <= 0.0 ? 0.0 : 10.0 ** ((Math.min(x, 1.0) - 1.0) * BREATH_DB / 20.0)
}

# Plays `recipe` from `input` until the input is closed or the program is
# stopped. `breath` is where the breath comes from: "cc2", "cc7", "cc11" or
# "pressure".
fn play(recipe, input, breath, full) {
  Audio.latency(PERIOD)
  # The device opens on the first play(), which takes a while: open it now,
  # with a silent graph, rather than on the first note.
  let silence = Audio.Graph.new()
  silence.output(silence.gain(silence.wave(), 0.0))
  silence.play()
  silence.stop()

  # The output's gain, when its `on` moves (an attack), is the breath's.
  let out_gain = recipe.parts[recipe.out].values.get("gain", nil)
  let blown_in = out_gain != nil && out_gain.on.size() > 1
  let steady = blown_in ? [recipe.out] : []
  let bright = blown_in ? recipe.knobs.get("bright", nil) : nil
  let cc = breath == "pressure" ? nil : to_long(breath.slice(2, breath.size()))
  mut pressure = 0.0
  # The breath now on channel `on`, 0.0 to 1.0 of full.
  let blown = |on| Math.min((cc == nil ? pressure : input.control(cc, on)) / full, 1.0)

  mut ready = recipe.prepare({}, steady)
  mut held = nil
  mut held_pitch = nil
  mut channel = 0  # the one the notes come on, whose breath is read
  mut fading = []
  mut range = 2.0  # the bend's, in semitones, until the controller says (RPN 0)
  mut rpn = (127, 127)
  # When the knob was last turned, and for what breath; a change of breath
  # held back by KNOB_EVERY waits that long for the next message at most.
  mut turned = 0.0
  mut turned_for = nil
  mut behind = false

  while true {
    if behind {
      input.wait(KNOB_EVERY)
    } else {
      input.wait()
    }
    for m in input.read() {
      cond {
        m.kind == "note_on" && held != nil && blown_in => {
          held.retune(m.note)
          held_pitch = m.note
        },
        m.kind == "note_on" => {
          if held != nil {
            held.release()
            fading.push(held)
          }
          channel = m.channel
          let level = Math.clamp(2.0 * m.velocity, 0.05, 2.0)
          held = ready.begin(m.note, level, loudness(blown(channel)))
          held_pitch = m.note
          turned_for = nil
          ready = recipe.prepare({}, steady)
        },
        m.kind == "note_off" && held != nil && m.note == held_pitch => {
          held.release()
          fading.push(held)
          held = nil
          held_pitch = nil
        },
        m.kind == "bend" => {
          held?.bend(m.bend * range)
        },
        m.kind == "pressure" => {
          pressure = m.value
        },
        m.kind == "cc" && m.cc == 101 => {
          rpn = (m.bytes[2], rpn[1])
        },
        m.kind == "cc" && m.cc == 100 => {
          rpn = (rpn[0], m.bytes[2])
        },
        m.kind == "cc" && m.cc == 6 && rpn == (0, 0) => {
          range = to_float(m.bytes[2])
        },
        _ => {},
      }
    }
    behind = false
    if held != nil {
      let x = blown(channel)
      held.volume(loudness(x))
      if bright != nil && x != turned_for {
        if Time.monotonic() - turned >= KNOB_EVERY {
          held.knob("bright", bright.min + x * (bright.max - bright.min))
          turned = Time.monotonic()
          turned_for = x
        } else {
          behind = true
        }
      }
    }
    fading = fading.filter(|h| !h.done())
  }
}

export {play}
