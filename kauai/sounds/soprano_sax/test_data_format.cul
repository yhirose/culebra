import format from './data_format.cul'

# A 7-frame note with 3 breath bands and 4 harmonics, the 4th silent in all
# but frame 5, and 12 fine gains, the 3rd silent.
let NOTE = {
  cents: [0.0, 12.346, -7.5, 3.0, 0.004, -0.006, 40.0],
  db: [-3.0, -2.5, -2.0, -1.5, -1.0, -0.5, 0.0],
  breath: iota(7).map(|j| [-20.0 - j, -25.0, -30.125]),
  gains: iota(12).map(|k| k == 2 ? 0.0 : 0.5 + 0.1 * k),
  shapes: iota(7).map(|j| [0.8, 0.4 + 0.01 * j, 0.2, j == 5 ? 0.05 : 0.0]),
}

fn packed(n) {
  let p = format.pack_note(n)
  let e = {at: 3, frames: n.cents.size(), gains: n.gains.size(), harms: p.harms}
  {e: e, bytes: String.pack("i16", [9, 9, 9, ...p.numbers]), p: p}
}

@test
fn a_note_reads_back_to_its_hundredths() {
  let t = packed(NOTE)
  let parts = format.note_parts(t.bytes, t.e, 3)
  assert_eq(parts.cents, [0.0, 12.35, -7.5, 3.0, 0.0, -0.01, 40.0])
  assert_eq(format.note_db(t.bytes, t.e), NOTE.db)
  assert_eq(parts.breath[2], [-22.0, -25.0, -30.12])
}

@test
fn gains_read_back_within_a_hundredth_of_a_db_and_silence_as_nothing() {
  let parts = format.note_parts(packed(NOTE).bytes, packed(NOTE).e, 3)
  assert_eq(parts.gains[2], 0.0)
  for k in [0, 1, 3, 11] {
    let db = 20.0 * Math.log(parts.gains[k] / NOTE.gains[k]) / Math.log(10.0)
    assert_true(Math.abs(db) <= 0.005)
  }
}

@test
fn shapes_keep_as_many_harmonics_as_any_frame_has() {
  let t = packed(NOTE)
  assert_eq(t.p.harms, 4)
  # Kept frames 0, 3, 6: three frames of four harmonics after 7 + 7 + 21 + 12.
  assert_eq(t.p.numbers.size(), 7 + 7 + 21 + 12 + 3 * 4)
}

@test
fn the_last_frame_is_kept_wherever_the_steps_end() {
  assert_eq(format.kept_frames(7), [0, 3, 6])
  assert_eq(format.kept_frames(8), [0, 3, 6, 7])
  assert_eq(format.kept_frames(1), [0])
}

@test
fn harmonics_silent_in_every_frame_are_not_kept() {
  let n = {...NOTE, shapes: NOTE.shapes.map(|row| [row[0], row[1], 0.0, 0.0])}
  assert_eq(format.pack_note(n).harms, 2)
}

@test
fn shapes_between_kept_frames_lie_on_a_straight_line_in_db() {
  let t = packed(NOTE)
  let shapes = format.note_shapes(t.bytes, t.e, 3, 6)
  # Frame 4 is a third of the way from kept frame 3 to kept frame 6.
  let db = |v| 20.0 * Math.log(v) / Math.log(10.0)
  let want = db(0.43) + (db(0.46) - db(0.43)) / 3.0
  assert_true(Math.abs(db(shapes[4][1]) - want) <= 0.01)
  assert_eq(shapes[4].size(), 6)
  assert_eq(shapes[4][5], 0.0)
  # The 4th harmonic is silent at the kept frames, so silent between them.
  assert_eq(shapes[5][3], 0.0)
}

@test
fn attacks_read_back_over_their_scale() {
  let nums = format.pack_attack([0.5, -0.25, 0.1], 10000.0)
  assert_eq(nums, [5000, -2500, 1000])
  let a = {at: 1, len: 3}
  assert_eq(
    format.attack_samples(String.pack("i16", [7, ...nums]), a, 10000.0),
    [0.5, -0.25, 0.1],
  )
}
