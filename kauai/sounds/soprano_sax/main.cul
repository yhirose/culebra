# A soprano saxophone for Kauai, played a phrase at a time from real notes.
# Each note of a phrase borrows the recorded note nearest it (in pitch,
# length, loudness, how it is entered and left, how much vibrato it has)
# from three takes of a soprano saxophonist sketching a tune (Kataguruma,
# Freesound 734969-71, CC0) and the University of Iowa's soprano saxophone
# samples (credited in README.md), keeps that note's own moves of pitch and
# loudness and its timbre frame by frame, and sounds them as harmonics with
# the breath between them; a note longer than the one it borrows is filled
# out with steady stretches of long notes near it, and a note that starts
# the phrase or is tongued begins with the recording's own attack. A few
# numbers (a written scoop's shape, how much vibrato a long note asks for,
# how much louder a note is up the range) are measured from vedas's soprano
# saxophone solo (Freesound 171197, CC BY 3.0). README.md says more.
#
#   band Smooth {
#     voice Lead  external SopranoSax  plays melody  vol 60
#   }
#
#   culebra play --sounds kauai/sounds/soprano_sax song.kau
#
# The playing is the engine's (kauai/engine/borrow.cul, which lists the
# voice's parameters); this package is its recordings and its style, both in
# data/: notes.i16 and notes.json, attacks.i16 and attacks.json, breath.json,
# and instrument.json, whose `play` is the style the engine plays them in and
# whose `make` is what kauai/tools/make_data.cul makes them with.

import engine from '../../engine/borrow.cul'

let RATE = engine.RATE

let DATA = Dir.embedded('data')

let CONFIG = JSON.parse(DATA.read('instrument.json'))

let SAX = engine.Instrument.new(DATA, CONFIG.play)

# A phrase's samples, mono, RATE a second: the phrase as Kauai hands it to
# an instrument (each note's `pitch` and `at`, and what `hears` asks for),
# with the voice's parameters as they stand at its first note.
let phrase_samples = |phrase, params| SAX.phrase_samples(phrase, params)

# The instrument, as Audio.Kauai.load's `voices:` takes it: `external SopranoSax`.
let voices = {sopranosax: {
  phrase: |notes, params| Audio.Sound(
    phrase_samples(notes, params),
    rate: RATE,
  ),
  hears: ["len", "level", "marks", "next", "params"],
}}

export {voices, phrase_samples, RATE}
