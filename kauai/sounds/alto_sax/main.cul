# An alto saxophone for Kauai, played a phrase at a time from real notes.
# Each note of a phrase borrows the recorded note nearest it (in pitch,
# length, loudness, how it is entered and left, how much vibrato it has)
# from seven jazz improvisations by DieRechnug (Freesound, CC0 and CC BY 4.0),
# keeps that note's own moves of pitch and loudness and its timbre frame by
# frame, and sounds them as harmonics with the breath between them. README.md
# says more.
#
#   band Smooth {
#     voice Lead  external AltoSax  plays melody  vol 60
#   }
#
#   culebra kauai/tools/play.cul --sounds kauai/sounds/alto_sax song.kau
#
# The playing is the engine's (kauai/engine/borrow.cul, which lists the
# voice's parameters); this package is its recordings and its style, both in
# data/: notes.i16 and notes.json, attacks.i16 and attacks.json, breath.json,
# and instrument.json, whose `play` is the style the engine plays them in and
# whose `make` is what kauai/tools/make_data.cul makes them with.

import engine from '../../engine/borrow.cul'
import live from '../../engine/borrow_live.cul'

let RATE = engine.RATE

# The instrument, made anew: for a worker (an isolate) that plays it too.
fn instrument() {
  let data = Dir.embedded('data')
  engine.Instrument.new(data, JSON.parse(data.read('instrument.json')).play)
}

# The instrument this program plays, made the first time it plays: a run
# that only checks a song or lists the instruments reads no recording.
let made = {}
fn alto() {
  made.alto ??= instrument()
}

# A phrase's samples, mono, RATE a second: the phrase as Kauai hands it to
# an instrument (each note's `pitch` and `at`, and what `hears` asks for),
# with the voice's parameters as they stand at its first note.
let phrase_samples = |phrase, params| alto().phrase_samples(phrase, params)

# The instrument, as Kauai.load's `voices:` takes it: `external AltoSax`.
let voices = {altosax: {
  phrase: |notes, params| Audio.Sound(
    phrase_samples(notes, params),
    rate: RATE,
  ),
  hears: ["len", "level", "marks", "next", "params"],
}}

# As `kauai instruments` lists it, and its player for `kauai live`.
let instruments = [{name: "AltoSax", live: || live.LivePlayer(alto(), instrument), about: "an alto saxophone, from recordings"}]

export {voices, phrase_samples, RATE, instruments, instrument}
