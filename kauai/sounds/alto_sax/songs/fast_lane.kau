about {
  title  Fast Lane
  note   driving minor-key fusion, its riff played by the alto and the guitar an octave apart
}

// G minor, whose pitches the recorded alto has many notes of (the D7's F#
// is left to the band).
band Turbo {
  voice Alto   external AltoSax  plays melody                                         vol 60
  voice Bass   saw            plays roots in G1..F#2                               vol 28  env 0 3 2  gap 1
  voice Gtr    pulse2         plays chords from G3  plays part Unison  duty 1/4    vol 9   env 0 3 4  gap 1
  voice Brass  pulse          plays chords rootless from Bb3           duty 1/2    vol 8   env 1 4 6  gap 1
  voice Pad    triangle       plays chords rootless from G4                        vol 7   env 6 6 12

  drum Kick   noise 110->40    len 4   vol 36  env 0 3 2
  drum Snare  noise 1800       len 4   vol 22  env 0 2 4
  drum Hat    noise 8500       len 1   vol 6
  drum Tom    noise 600->250   len 5   vol 18  env 0 2 4
  drum Crash  noise 6000->3000 len 20  vol 10  env 0 4 20
  drum Hit    noise 5000->2500 len 10  vol 13  env 0 3 10  plays hits
}

groove Turbo {
  Bass   1 1 8 1 1 1 8 >
  Gtr    1 3 4 3 1 3 4 3
  Kick   x.....x.x.......
  Snare  ....x.......x...
  Hat    ..x.......x...xx
  first {
    Kick   ......x.x.......
    Crash  x...............
  }
  last {
    Kick   x.......x.......
    Snare  ....x.....x.xxxx
    Tom    ...........x....
    Hat    ................
  }
}

groove Street {
  Bass   1 . 1 8 . 1 . >
  Gtr    1 . 1 . 3 . 1 .
  Kick   x.......x.x.....
  Snare  ....x.......x...
  Hat    ..x...x.......x.
  last {
    Kick   x.......x.......
    Snare  ....x.....x.xxxx
    Tom    ...........x....
    Hat    ..x...x.........
  }
}

groove Blaze {
  Bass   1 1 8 1 1 1 8 >
  Gtr    1 3 4 3 1 3 4 3
  Brass  2 - - - - - - - 2 - - - - - - -
  Pad    1
  Kick   x.....x.x.......
  Snare  ....x.......x...
  Hat    ..x.......x...xx
  first {
    Kick   ......x.x.......
    Crash  x...............
  }
  last {
    Kick   x.......x.......
    Snare  ....x.....x.xxxx
    Tom    ...........x....
    Hat    ................
  }
}

song FastLane {
  tempo 156
  meter 4/4
  key Gm
  band Turbo
  groove Turbo
  melody in F4..E5
  part Unison in F3..E4
  room 25%

  Kime
  Riff
  mark Verse
  Verse
  mark Chorus
  Chorus
  Riff
  Verse
  Chorus
  mark Solo
  Solo
  Kime
  mark Last
  Chorus
  Outro
}

section Kime {
  Gm7           \f ^g8 g16 bb16 r8 ^c8 r8 ^d8 r16 ^f'8.
    hits:       !x8 x16 x16 r8 !x8 r8 !x8 r16 !x8.
  Gm7           ^g'8 g'16 f'16 r8 ^d8 r8 ^c8 r16 ^bb8.
    hits:       !x8 x16 x16 r8 !x8 r8 !x8 r16 !x8.
  Ebmaj7 F      ^bb8 bb16 c16 r8 ^d8 r8 ^c8 r16 ^a8.
    hits:       !x8 x16 x16 r8 !x8 r8 !x8 r16 !x8.
  Gm7           (d,16 f16 g16 a16 bb16 c16 d16 f'16) !g'4 r4
    hits:       r2 !x4 r4
}

// The riff, the alto and the guitar an octave apart.
section Riff {
  Gm7           \f g8 g16 bb16 r16 c16 d8 f'8 d16 c16 bb8 c8
  Ebmaj7 F      !d8. bb16~ bb8 g8 !c8. a16~ a8 f8
  Gm7           g8 g16 bb16 r16 c16 d8 f'8 d16 f'16 g'8 f'8
  Ebmaj7 F      !g'8. f'16~ f'8 d8 !eb8. d16~ d8 c8
  part Unison {
    g8 g16 bb16 r16 c16 d8 f'8 d16 c16 bb8 c8
    !d8. bb16~ bb8 g8 !c8. a16~ a8 f8
    g8 g16 bb16 r16 c16 d8 f'8 d16 f'16 g'8 f'8
    !g'8. f'16~ f'8 d8 !eb8. d16~ d8 c8
  }
}

section Verse {
  groove Street
  Gm7           \mf r8 d8 d8 d8 f'8 d8 c8 bb8~
  Cm7           bb4 g8 bb8~ bb8 c8 bb8 g8
  F7sus4 F7     f4 g8 bb8~ bb4 a8 f8
  Bbmaj7        d2 r8 c8 d8 f'8
  Ebmaj7        \scoop g'4. f'8 d8 bb8 g8 bb8
  Am7b5 D7      c4 eb8 c8~ c8 a8 c8 eb8
  Gm7           d4 bb8 g8~ g2
  Am7b5 D7sus4  \cresc r2 r8 a8 bb8 c8
}

section Chorus {
  groove Blaze
  Ebmaj7        \f \scoop g'2. f'8 eb8
  F             f'2 d8 c8 a8 c8~
  Dm7           c4 d8 f'8~ f'4 d8 c8
  Gm7           d2. r4
  Cm7           \scoop eb2. d8 c8
  D7sus4 D7     d2 c8 a8 c8 eb8
  Ebmaj7 F      d4 eb8 f'8~ f'4 eb8 f'8
  Gm7           \scoop g'1
}

section Solo {
  groove Blaze
  Gm7           \mf r8 (g16 a16 bb16 c16 d16 f'16) g'8 f'8 d8 c8
  Ebmaj7 F      \scoop d4. bb8 c8 d8 f'8 a8
  Gm7           (bb16 a16 g16 f16) g8 bb8 d8 f'8 g'8 f'8
  Ebmaj7 F      \fall d4 r8 c8 \scoop a4 c8 d8
  Gm7           \cresc f'8 g'8 f'8 d8 c8 d8 f'8 g'8
  Ebmaj7 F      (g'16 f'16 eb16 d16 c16 bb16 a16 g16) a4 c4
  Gm7           \scoop bb2 d8 c8 bb8 a8
  D7sus4 D7     g2 a4 c4
}

section Outro {
  Gm7           g8 g16 bb16 r16 c16 d8 f'8 d16 c16 bb8 c8
  Ebmaj7 F      !d8. bb16~ bb8 g8 !c8. a16~ a8 f8
  Gm7           g8 g16 bb16 r16 c16 d8 f'8 d16 f'16 g'8 f'8
  Ebmaj7 F      ^g'8 g'16 f'16 r8 ^d8 r8 ^c8 r16 ^d8.
    hits:       !x8 x16 x16 r8 !x8 r8 !x8 r16 !x8.
  Gm7           !g'1
    hits:       !x1
  part Unison {
    g8 g16 bb16 r16 c16 d8 f'8 d16 c16 bb8 c8
    !d8. bb16~ bb8 g8 !c8. a16~ a8 f8
    g8 g16 bb16 r16 c16 d8 f'8 d16 f'16 g'8 f'8
    .
    .
  }
}
