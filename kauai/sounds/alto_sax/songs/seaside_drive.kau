about {
  title "Seaside Drive"
}

band Coastline {
  voice Alto  external Alto  plays melody                    vol 60
  voice Twin  pulse2                                         duty 1/4  vol 9   env 2 3 6  gap 1
  voice Bass  saw            plays roots in A1..G#2                    vol 30  env 0 3 3  gap 1
  voice Keys  triangle       plays chords rootless from D4             vol 12  env 1 3 6  gap 2
  voice Pad   pulse          plays chords rootless from A4   duty 1/8  vol 6   env 8 6 12

  Twin harmonizes Alto  under m3

  drum Kick   noise 120->42    len 4   vol 34  env 0 3 2
  drum Snare  noise 1900       len 3   vol 20  env 0 2 3
  drum Hat    noise 8500       len 1   vol 6
  drum Crash  noise 6000->3000 len 20  vol 9   env 0 4 20
}

// One noise channel plays one drum at a time, so the kick, the snare and the
// hats sit on different sixteenths of the bar.
groove Intro {
  Bass   1 - - - 5 - - - 1 - - - 5 - > -
  Keys   1 3 2 3 1 3 2 3 1 3 2 3 1 3 2 3
  Pad    3 - - -
  Kick   x.......x.......
  Hat    ..x...x...x...x.
  first {
    Kick   ........x.......
    Crash  x...............
  }
}

groove Verse {
  Bass   1 . . 1 . . 5 . 1 . 8 . 5 . > .
  Keys   1 3 2 3 1 3 2 3 1 3 2 3 1 3 2 3
  Pad    3 - - -
  Kick   x.....x...x.....
  Snare  ....x.......x...
  Hat    .xxx.x.xxx.x.xxx
}

groove Bridge {
  Bass   1 . 1 . 8 . 1 . 5 . 1 . 8 . > .
  Keys   1 3 2 3 1 3 2 3 1 3 2 3 1 3 2 3
  Pad    3 - - -
  Kick   x.....x...x.....
  Snare  ....x.......x.x.
  Hat    .xxx.x.xxx.x.x.x
  last {
    Snare  ....x.....x.xxxx
    Kick   x.......x.......
    Hat    ................
  }
}

groove Chorus {
  Bass   1 . 1 . 8 . 1 . 5 . 1 . 8 . > .
  Keys   1 3 2 3 1 3 2 3 1 3 2 3 1 3 2 3
  Pad    3 - - -
  Kick   x.....x...x...x.
  Snare  ....x.......x...
  Hat    .xxx.x.xxx.x.x.x
  first {
    Kick   ......x...x.....
    Crash  x...............
  }
}

song SeasideDrive {
  tempo 132
  meter 4/4
  key A
  band Coastline
  groove Chorus
  melody in A4..G#5
  room 30%

  Intro
  Verse
  Verse with harmony
  Bridge
  Chorus with harmony
  Interlude
  Bridge
  Chorus with harmony
  Outro
}

section Intro {
  Amaj7       \p r1
  Dmaj7       r1
  Amaj7       r2 c#8 e8 f#8 g#8
  E7sus4 E7   g#2~ g#8 f#8 e8 d8
}

section Verse {
  Amaj7       \mp r8 c#8 e8 f#8~ f#4 e8 c#8
  F#m7        d8 e8 f#8 g#8~ g#4 f#8 e8
  Bm7         d4 c#8 b8 a4 c#4
  E7sus4 E7   e2 r8 e8 d8 c#8
  Amaj7       r8 c#8 e8 f#8~ f#4 g#8 f#8
  C#m7 F#7    e4 g#4 f#8 e8 c#8 a#8
  Bm7 E7      b4 d4 e8 d8 c#8 b8
  Amaj7 E7    a2~ a8 b8 c#8 d8
}

section Bridge {
  Dmaj7       \mf f#4 f#8 e8 f#4 d4
  C#m7        \cresc e4 e8 d8 e4 c#4
  Bm7         d4 d8 c#8 d4 b4
  E7sus4 E7   e2 g#4 e4
  Dmaj7       r8 d8 f#8 g#8~ g#4 f#8 e8
  C#m7 F#7    e4 g#4 f#8 e8 c#8 a#8
  Bm7         d4 f#4 e4 d4
  E7sus4 E7   e4 g#4 g#2
}

section Chorus {
  Amaj7       \f g#8 g#8 f#8 e8~ e4 f#8 g#8
  F#m7        f#4. e8 f#4 c#4
  Dmaj7       f#8 g#8 f#8 e8 d4 e4
  E7          b2 g#4 e4
  Amaj7       g#8 g#8 f#8 e8~ e4 f#8 e8
  C#m7        g#4. f#8 e4 c#4
  Dmaj7       f#8 e8 d8 e8 f#8 g#8 f#8 e8
  E7sus4 E7   e2 r4 b8 c#8
}

section Interlude {
  Amaj7       \mp r1
  F#m7        r1
  Dmaj7       r1
  E7sus4 E7   r1
}

section Outro {
  Amaj7       \mf e2 g#4 f#4
  Dmaj7       d4 f#4 e2
  Bm7 E7      d8 e8 f#8 e8 d8 c#8 b8 a8
  Amaj7       \fall e1
}
