about {
  title "Coast Road"
}

band Coastline {
  voice Alto  external Alto  plays melody                    vol 60
  voice Twin  pulse2                                         duty 1/4  vol 9   env 2 3 6  gap 1
  voice Bass  saw            plays roots in A1..G#2                    vol 30  env 0 3 3  gap 1
  voice Keys  triangle       plays chords rootless from D4             vol 12  env 1 3 6  gap 2
  voice Pad   pulse          plays chords rootless from A4   duty 1/8  vol 6   env 8 6 12

  Twin harmonizes Alto  under m3

  drum Kick   noise 120->42    len 4   vol 34  env 0 3 2
  drum Snare  noise 1900       len 3   vol 20  env 0 2 3
  drum Hat    noise 8500       len 1   vol 7
  drum Crash  noise 6000->3000 len 20  vol 9   env 0 4 20
}

groove Intro {
  Bass   1 - 5 -
  Keys   1 2 3 4 2 3 4 3
  Pad    4 - - -
  Kick   x.......x.......
  Hat    ..x...x...x...x.
  first {
    Kick   ........x.......
    Crash  x...............
  }
}

groove Drive {
  Bass   1 - - 8 - . 1 - . 5 - 8 - 1 > .
  Keys   1 2 3 4 2 3 4 3
  Pad    4 - - -
  Kick   x..x....x..x....
  Snare  ....x.......x..x
  Hat    ..x...x...x...x.
  first {
    Kick   ...x....x..x....
    Crash  x...............
  }
  last {
    Snare  ....x..x.x..xx.x
  }
}

song CoastRoad {
  tempo 126
  meter 4/4
  key D
  band Coastline
  groove Drive
  melody in D5..C#6
  room 30%

  Intro
  Verse
  Chorus with harmony
  Verse
  Chorus with harmony
  Chorus with harmony in Eb
  Outro in Eb
}

section Intro {
  Gmaj9       \p r1
  A/G         r1
  F#m7        r1
  Bm9         r2 r8 a,8 b,8 d8
}

section Verse {
  Gmaj9       \mp (f#8. e16 d8) b,8~ b,4 r8 a,8
  F#7         (a#,8 c#,8 e8) g8~ g4 e4
  Bm9         d4 c#,8 d8~ d4 f#4
  Am7 D9      (e8 g8 a8) f#8~ f#4 r4
  Gmaj9       r8 (d8 f#8) a8~ a4. b8
  F#7         (a#8 g8 e8) c#,8~ c#,2
  Bm7 Bm7/A   (d8 f#8 b8) a8~ a4 f#4
  Em9 A7sus4  g4 f#8 e8~ e4 d4
}

section Chorus {
  Gmaj9       \mf \scoop a2~ a8 (b8 a8 f#8)
  A/G         e4. f#8~ f#2
  F#m7        r8 (c#,8 e8) a8~ a4 g#8 a8
  Bm9         \fall f#2. r4
  Em9         (g8 f#8 g8) b8~ b4 a8 g8
  F#m7        a4 f#8 e8~ e4 c#,4
  Gmaj7       (d8 e8 f#8) a8~ a4 b4
  A7sus4 A7   (a8 g8 e8) d8~ d4 c#,4
}

section Outro {
  Bbmaj7 C    d4 e4 f#2
  D6/9        (e8 f#8 a8) b8~ b2
  D6/9        a1~
  D6/9        a1
}
