import alto from './main.cul'
import engine from '../../engine/borrow.cul'

# A phrase as Kauai hands it to the instrument: two notes slurred, then one
# held.
let PHRASE = [
  {pitch: 72, at: 0.0, len: 0.3, level: 1.0, level_end: 1.0, marks: [], next: nil, params: {}},
  {pitch: 74, at: 0.3, len: 0.3, level: 1.0, level_end: 1.0, marks: [], next: nil, params: {}},
  {pitch: 76, at: 0.6, len: 0.9, level: 1.0, level_end: 1.0, marks: [], next: nil, params: {}},
]

@test
fn a_phrase_sounds_as_long_as_it_is_written() {
  let s = alto.phrase_samples(PHRASE, {})
  assert_true(s.size() >= 1.5 * alto.RATE)
  assert_true(s.size() <= 2.5 * alto.RATE)
  let peak = s.map(|v| Math.abs(v)).max()
  assert_true(peak > 0.01)
  assert_true(peak < 1.0)
}

@test
fn kauai_plays_a_song_with_it() {
  let song_text = 'band Solo {
  voice Lead  external AltoSax  plays melody  vol 60
}
song Tune {
  tempo 120
  band Solo
  melody in C5..B5
  Verse
}
section Verse {
  C     c4 e g e
  G     d4 g b g
}
'
  let song = Audio.Kauai.load(
    "tune.kau",
    voices: alto.voices,
    dir: Dir.memory({"tune.kau": song_text}),
  )
  mut left = song.prepare()
  while left > 0 {
    left = song.prepare()
  }
  assert_true(song.length() > 3.0)
}

# A pitch held 1 s with a fall: the resonances stay where they are in Hz while
# the pitch slides down, so the spectrum's centroid (Hz) does not follow it.
@test
fn a_fall_slides_the_pitch_down_but_not_the_resonances() {
  let note = [{pitch: 72, at: 0.0, len: 1.0, level: 1.0, level_end: 1.0, marks: ["fall"], next: nil, params: {}}]
  let s = alto.phrase_samples(note, {})
  let centroid = fn (t) {
    let a = Math.round(t * alto.RATE)
    let spec = Audio.spectrum(s.slice(a, a + 2048), 2048, 2048)[0]
    iota(spec.size()).map(|k| k * alto.RATE / 2048.0 * spec[k]).sum() / spec.sum()
  }
  let pitch = fn (t) {
    let a = Math.round(t * alto.RATE)
    let hz = Audio.pitch(s.slice(a - 1024, a + 3072), 100.0, 1400.0, alto.RATE).hz.filter(|h| h != nil).sorted()
    hz[hz.size() / 2]
  }
  # The fall takes the last 0.3 s of the note and is well down by 0.9 s, where
  # the resonances (in Hz) are where they were: the spectrum is not dragged
  # down with the pitch.
  assert_true(pitch(0.9) < 0.85 * pitch(0.3), [pitch(0.9), pitch(0.3)])
  assert_true(centroid(0.9) > 0.62 * centroid(0.3), [centroid(0.9), centroid(0.3)])
}

# A note starts from nothing: the borrowed attack can begin before the sound
# does, so the engine fades the first milliseconds in. These three began at 26
# to 66% of their peak.
@test
fn a_note_starts_from_silence() {
  for (pitch, len) in [(55, 0.195), (78, 0.195), (59, 0.6)] {
    let note = [{pitch: pitch, at: 0.0, len: len, level: 1.0, level_end: 1.0, marks: [], next: nil, params: {}}]
    let s = alto.phrase_samples(note, {})
    let peak = s.map(|v| Math.abs(v)).max()
    assert_true(s.slice(0, 4).map(|v| Math.abs(v)).max() < 0.03 * peak, [pitch, len])
  }
}

# The same note is as loud whether another follows it at once or not. A note
# borrowed from a take could start with a puff of breath 20 dB over its level;
# the engine set the level by the note's middle, so a song's first note was a
# loud "buh" beside the next.
@test
fn the_same_note_is_as_loud_with_or_without_a_next() {
  let voiced = fn (next) {
    let note = [{pitch: 64, at: 0.0, len: 0.195, level: 1.15, level_end: 1.15, marks: [], next: next, params: {}}]
    let s = alto.phrase_samples(note, {})
    s.map(|v| Math.abs(v)).max()
  }
  let alone = voiced(nil)
  let followed = voiced(0.195)
  assert_true(alone < 2.5 * followed && followed < 2.5 * alone, [alone, followed])
}

# A long note is pieced from stretches of several recorded notes, each with a
# slow loudness and timbre of its own; heard together they swell and sag every
# half second (a real long note leans one way, or holds). The slow course of
# the pieces is mostly taken out.
@test
fn a_long_tone_does_not_swell_and_sag() {
  let note = [{pitch: 69, at: 0.0, len: 3.0, level: 0.85, level_end: 0.85, marks: [], next: nil, params: {}}]
  let s = alto.phrase_samples(note, {})
  let level = iota(2, 30).map(fn (q) {
    let win = s.slice(Math.round(q * 0.1 * alto.RATE), Math.round(q * 0.1 * alto.RATE) + 2048)
    10.0 * Math.log(win.map(|v| v * v).sum() / win.size() + 1e-12) / Math.log(10.0)
  })
  # The scatter of the level about its straight-line course, in dB.
  let n = level.size() * 1.0
  let xs = iota(level.size()).map(|i| i * 1.0)
  let mx = xs.sum() / n
  let my = level.sum() / n
  let slope = iota(level.size()).map(|i| (xs[i] - mx) * (level[i] - my)).sum() / xs.map(|x| (x - mx) * (x - mx)).sum()
  let scatter = Math.sqrt(iota(level.size()).map(|i| (level[i] - my - slope * (xs[i] - mx)) ** 2).sum() / n)
  assert_true(scatter < 1.3, scatter)
}

# A tongued note of the alto begins crisply: a soft, rounded start (a "poa", the
# soprano's gift) is wrong for an alto, and the engine borrowed one for an A4
# eighth that a note followed at once. The start of the note it borrows, the
# frames it takes to come within 3 dB of its level and how rounded its attack
# is, must be as the alto's usual.
@test
fn a_tongued_note_begins_crisply() {
  let data = Dir.embedded('data')
  let inst = engine.Instrument.new(data, JSON.parse(data.read('instrument.json')).play)
  for (pitch, len, next) in [(69, 0.45, 0.46), (67, 0.45, 0.46), (72, 0.9, 0.9)] {
    let note = [{pitch: pitch, at: 0.0, len: len, level: 0.55, level_end: 0.55, marks: [], next: next, params: {}}]
    let chosen = inst.borrowed_curves(note, 0.0, 0, 0.0).chosen[0]
    let start = inst.start_softness(chosen)
    assert_true(start.rise <= 2, [pitch, chosen, start])
    assert_true(start.round > -4.0, [pitch, chosen, start])
  }
}

# Two held notes slurred meet with no step. slow_kept takes the pieces' slow
# course out of each note before the joins are eased; taken out after, it
# moved each note's head and tail by its own amount and left a step of up to
# 2 dB at the slur. (A recording's own dip at a join, which join_reads keeps,
# is not a step, and these pairs have none.)
@test
fn slurred_held_notes_meet_with_no_step() {
  let data = Dir.embedded('data')
  let inst = engine.Instrument.new(data, JSON.parse(data.read('instrument.json')).play)
  for (from, to, level) in [(72, 74, 1.0), (69, 71, 0.4), (70, 72, 0.7)] {
    let phrase = [
      {pitch: from, at: 0.0, len: 1.5, level: level, level_end: 1.0, marks: [], next: nil, params: {}},
      {pitch: to, at: 1.5, len: 1.5, level: 1.0, level_end: 1.0, marks: [], next: nil, params: {}},
    ]
    let c = inst.borrowed_curves(phrase, 0.0, 0, 0.0)
    let b = c.notes[1].s
    assert_true(Math.abs(c.db[b] - c.db[b - 1]) < 0.5, [from, to, c.db[b] - c.db[b - 1]])
  }
}
