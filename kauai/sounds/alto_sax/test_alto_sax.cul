import alto from './main.cul'

# A phrase as Kauai hands it to the instrument: two notes slurred, then one
# held.
let PHRASE = [
  {pitch: 72, at: 0.0, len: 0.3, level: 1.0, level_end: 1.0, marks: [], next: nil, params: {}},
  {pitch: 74, at: 0.3, len: 0.3, level: 1.0, level_end: 1.0, marks: [], next: nil, params: {}},
  {pitch: 76, at: 0.6, len: 0.9, level: 1.0, level_end: 1.0, marks: [], next: nil, params: {}},
]

@test
fn a_phrase_sounds_as_long_as_it_is_written() {
  let s = alto.phrase_samples(PHRASE)
  # 1.5 s written, and a 0.3 s tail after the last note.
  assert_true(s.size() >= 1.5 * alto.RATE)
  assert_true(s.size() <= 1.9 * alto.RATE)
  let peak = s.map(|v| Math.abs(v)).max()
  assert_true(peak > 0.01)
  assert_true(peak < 1.0)
}

@test
fn kauai_plays_a_song_with_it() {
  let song_text = 'band Solo {
  voice Lead  external Alto  plays melody  vol 60
}
song Tune {
  tempo 120
  band Solo
  melody in C5..B5
  Verse
}
section Verse {
  C     c4 e g e
  G     d4 g b g
}
'
  let song = Audio.Kauai.load(
    "tune.kau",
    voices: alto.voices,
    dir: Dir.memory({"tune.kau": song_text}),
  )
  mut left = song.prepare()
  while left > 0 {
    left = song.prepare()
  }
  assert_true(song.length() > 3.0)
}

# A pitch held 1 s with a fall: the pitch slides down, and the timbre is drawn
# again as it goes from the pitch it is at, so that the resonances stay where
# they are in Hz while the harmonics slide through them.
@test
fn a_fall_slides_the_pitch_down_but_not_the_resonances() {
  let note = [{pitch: 72, at: 0.0, len: 1.0, level: 1.0, level_end: 1.0, marks: ["fall"], next: nil, params: {}}]
  let s = alto.phrase_samples(note)
  let pitch = fn (t) {
    let a = Math.round(t * alto.RATE)
    let hz = Audio.pitch(s.slice(a - 1024, a + 3072), 100.0, 1400.0, alto.RATE).hz.filter(|h| h != nil).sorted()
    hz[hz.size() / 2]
  }
  assert_true(pitch(0.95) < 0.8 * pitch(0.3), [pitch(0.95), pitch(0.3)])

  let drawn = alto.tone(note, 1.1)
  # Drawn at the note's start and again in the fall, not before it.
  assert_true(drawn.spectrum.size() > 3, drawn.spectrum.size())
  assert_true(drawn.spectrum.filter(|p| p[0] < 0.6).size() == 1)
  # The last drawing is the timbre of the pitch the fall has reached.
  let (at, amps) = drawn.spectrum[-1]
  let f0 = drawn.freq.min_by(|p| Math.abs(p[0] - at))[1]
  assert_true(f0 < 0.8 * alto.freq_of(72), f0)
  let expected = alto.spectrum_at(f0, 1.0)
  assert_true(iota(amps.size()).all(|h| Math.abs(amps[h] - expected[h]) < 1e-9))
}
