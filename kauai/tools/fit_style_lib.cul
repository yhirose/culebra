# An instrument's style (data/instrument.json's `play`) found for it: a
# first style read off its own recordings, then the few numbers the
# recordings cannot say moved until songs it plays sound like the targets
# they are set against (compare_lib.cul's distance). fit_style.cul is the
# program; README.md says more.

import engine from '../engine/borrow.cul'
import compare from './compare_lib.cul'

let RATE = 44100

# A recorded mf A4 sits about this far under the recording's 95th percentile
# (dB): the library level a note at mf asks to borrow (`lib_level_mf`).
let LIB_MF = -11.0

# How much each of compare's numbers counts, against its own limit.
let WEIGHT = {
  spectral_db: 2.0,
  loudness_db: 2.0,
  integrated_lu: 2.0,
  pitch_median_cents: 1.0,
  pitch_p95_cents: 1.0,
  voicing: 1.0,
  centroid_cents: 1.0,
  breath_db: 1.0,
  vibrato_cents: 2.0,
  step_db: 2.0,
  loud_p95_db: 1.0,
  click_db: 1.0,
}

let median = |xs| xs.empty() ? nil : xs.sorted()[xs.size() / 2]

# One number for a distance: the numbers over their limits, weighted, none
# counting for more than 5 limits.
fn cost(d) {
  let total = WEIGHT.keys().map(|k| WEIGHT[k]).sum()
  WEIGHT
    .keys()
    .map(|k| WEIGHT[k] * Math.min(5.0, d[k] / compare.LIMITS[k]))
    .sum() /
    total
}

# A first style read off the instrument `inst` (made with any style) and
# nothing else: where a note's onset lies for each way in (the median of what
# the notes' loudness says), the first note played as an overtone (the top of
# the steady notes, plus one) and the vibrato of long notes, all of the
# recordings themselves. `mf_db` and `lib_level_mf` are a guess: `mf_db` does
# not reach a song (Kauai weighs an instrument by the loudness of its sounds),
# and `fit` leaves both be.
fn derived(inst) {
  let notes = inst.lib.notes
  let onset = fn (kind) {
    let found = []
    for i in 0..notes.size() {
      continue if notes[i].from != kind
      let at = inst.onset_by_loudness(i)
      found.push(at) if at != nil
    }
    median(found) ?? 0.0
  }
  let vib = median(notes.filter(|e| e.frames >= 60).map(|e| e.vib)) ?? 20.0
  {
    mf_db: -24.0,
    db_per_octave: 7.0,
    lib_level_mf: LIB_MF,
    vibrato: {depth: Math.round(vib / 0.24), straight: 0.6},
    onset_from_t0: {rest: onset("rest"), tongue: onset("tongue")},
    overtone_from: inst.steady.empty()
      ? 0
      : inst.steady.map(|i| notes[i].semi).max() + 1,
  }
}

# The first `seconds` of song `path` (or `dir`'s) as `inst` plays it, as the
# voice `name` (its lower-case key in the song's `external Name`). `seen`, an
# Object, gets a key for each pitch asked for.
fn rendered(inst, name, path, seconds, dir = nil, seen = {}) {
  let voices = {}
  voices[name] = {phrase: fn (notes, params) {
    for n in notes {
      seen[n.pitch] = true
    }
    Audio.Sound(inst.phrase_samples(notes, params), rate: RATE)
  }, hears: ["len", "level", "marks", "next", "params"]}
  Audio.Kauai.load(path, voices:, dir:).render(to: seconds)
}

# `style` with the number at `path` (names, from the style down) set to `v`.
fn with_value(style, path, v) {
  let out = {...style}
  out[path[0]] = path.size() == 1
    ? v
    : with_value(style[path[0]], path.slice(1, path.size()), v)
  out
}

fn value_at(style, path) {
  path.reduce(style, |s, k| s[k])
}

# The style tried: what `inst` plays like in `style` on each of `pairs` (each
# {song, target: the target's features, low, high, dir}), as the mean cost
# and the distances.
fn tried(inst, name, style, pairs, seconds, seen) {
  inst.restyle(style)
  let ds = pairs.map(fn (p) {
    let samples = rendered(inst, name, p.song, seconds, p.dir, seen)
    compare.distance(p.target, compare.features(samples, RATE, p.low, p.high))
  })
  {cost: ds.map(|d| cost(d)).sum() / ds.size(), distances: ds}
}

# Make `pairs` ({song, target samples, low, high, dir}) ready: the targets'
# features, over the first `seconds`.
fn prepared(pairs, seconds) {
  pairs.map(fn (p) {
    let cut = p.target.slice(
      0,
      Math.min(p.target.size(), Math.round(seconds * RATE)),
    )
    {...p, target: compare.features(cut, RATE, p.low, p.high)}
  })
}

# Each number of `params` ({path, step, lo, hi}) moved by its step while that
# lowers the cost, the step halved after a round that moved nothing. (Not
# `mf_db`: Kauai weighs an instrument by the loudness of its sounds, so how
# loud a note is asked for, absolutely, does not reach a song.) Answers
# {style, cost, distances, log}: the log each style tried and its cost.
fn fit(inst, name, style0, pairs, seconds, params, rounds = 3) {
  let ready = prepared(pairs, seconds)
  let seen = {}
  mut style = {...engine.DEFAULTS, ...style0}
  mut best = tried(inst, name, style, ready, seconds, seen)
  let log = [{what: "start", cost: best.cost, style: style}]
  mut steps = params.map(|q| q.step)
  # The numbers every trial of which cost what the style did: no song of the
  # pairs hears them.
  let changed = params.map(|_| false)
  for round in 0..rounds {
    mut moved = false
    for q in 0..params.size() {
      let p = params[q]
      # A number no song heard in the first round is not tried again.
      continue if round > 0 && !changed[q]
      let here = value_at(style, p.path)
      for dir in [1.0, -1.0] {
        let v = Math.clamp(here + dir * steps[q], p.lo, p.hi)
        continue if v == here
        let trial = tried(
          inst,
          name,
          with_value(style, p.path, v),
          ready,
          seconds,
          seen,
        )
        changed[q] = true if Math.abs(trial.cost - best.cost) > 1e-9
        if trial.cost < best.cost {
          style = with_value(style, p.path, v)
          best = trial
          moved = true
          log.push({what: p.path.join("."), cost: best.cost, style: style})
          break
        }
      }
    }
    if !moved {
      steps = steps.map(|x| x / 2.0)
    }
  }
  {
    style: style,
    cost: best.cost,
    distances: best.distances,
    log: log,
    pitches: seen.keys().map(|k| to_long(k)).sorted(),
    unseen: iota(params.size())
      .filter(|q| !changed[q])
      .map(|q| params[q].path.join(".")),
  }
}

# What the songs of a fit do not show of an instrument whose steady notes
# reach `top` and whose notes begin at `bottom` (MIDI): pitches the songs
# never ask for in the range (above `top` by up to 3 semitones, where the
# instrument plays overtones or thins out, and below `bottom`), as a list of
# warning lines.
fn blind(pitches, bottom, top) {
  let warn = []
  return ["the songs ask for no note at all"] if pitches.empty()
  if pitches.max() < top + 3 {
    warn.push("the songs ask for nothing above {pitches.max()}, and the recordings' steady notes reach {top}: whatever is decided from {top - 1} up is a guess")
  }
  if pitches.min() > bottom + 1 {
    warn.push("the songs ask for nothing below {pitches.min()}, and the recordings begin at {bottom}")
  }
  warn
}

export {LIB_MF, WEIGHT, cost, derived, rendered, fit, blind}
