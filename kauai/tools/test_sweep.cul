import lib from './sweep_lib.cul'

let RATE = 44100

# A sine at the written pitch, `len` and a tail long; `abrupt` starts it at
# full strength (a click), otherwise it rises over 5 ms; `loud` is its peak.
fn tone(pitch, len, abrupt, loud) {
  let hz = 440.0 * 2.0 ** ((pitch - 69) / 12.0)
  let n = Math.round((len + 0.1) * RATE)
  let rise = Math.round(0.005 * RATE)
  iota(n).map(fn (i) {
    let env = abrupt || i >= rise ? 1.0 : i / rise
    loud * env * Math.sin(2.0 * Math.pi * hz * i / RATE)
  })
}

# A voice that clicks at pitch 60 only (a sine from the first sample), clips at
# 66 only, and is otherwise clean.
let FAKE = {voices: {t: {phrase: fn (notes, params) {
  let n = notes[0]
  Audio.Sound(tone(n.pitch, n.len, n.pitch == 60, n.pitch == 66 ? 2.0 : 0.5), rate: RATE)
}}}}

@test
fn a_sweep_finds_the_pitch_that_clicks_and_the_one_that_clips_and_no_other() {
  let r = lib.sweep(FAKE, "t", 57, 69, step: 3)
  assert_eq(r.count, 5 * 4 * 3 * 2)
  let kinds = r.findings.map(|b| "{b.what} {b.pitch}").to_set()
  assert_eq(kinds, ["start 60", "clip 66"].to_set())
  # Every length, level and next of that pitch shows it.
  assert_eq(r.findings.filter(|b| b.what == "start").size(), 4 * 3 * 2)
}

@test
fn a_clean_voice_finds_nothing_and_a_note_out_of_tune_is_found() {
  let clean = {voices: {t: {phrase: |notes, params| Audio.Sound(tone(notes[0].pitch, notes[0].len, false, 0.5), rate: RATE)}}}
  assert_true(lib.sweep(clean, "t", 60, 66, step: 3).findings.empty())
  # A tone a quarter-tone (50 cents) sharp is out of tune.
  let sharp = {voices: {t: {phrase: |notes, params| Audio.Sound(tone(notes[0].pitch + 0.5, notes[0].len, false, 0.5), rate: RATE)}}}
  let r = lib.sweep(sharp, "t", 60, 60, step: 3)
  assert_true(r.findings.all(|b| b.what == "pitch") && !r.findings.empty(), r.findings.slice(0, 2))
  # A short note's pitch is not judged.
  assert_true(r.findings.all(|b| b.len >= 0.15))
}

@test
fn a_silent_sound_is_found() {
  let mute = {voices: {t: {phrase: |notes, params| Audio.Sound(repeat(4410, 0.0), rate: RATE)}}}
  let r = lib.sweep(mute, "t", 60, 60, step: 3)
  assert_true(!r.findings.empty() && r.findings.all(|b| b.what == "silent"), r.findings.slice(0, 2))
}

# The pitch is searched about the note's own, so a clean tone far below or
# above 100 to 1400 Hz is in tune.
@test
fn a_clean_tone_outside_100_to_1400_hz_is_in_tune() {
  let clean = {voices: {t: {phrase: |notes, params| Audio.Sound(tone(notes[0].pitch, notes[0].len, false, 0.5), rate: RATE)}}}
  assert_eq(lib.sweep(clean, "t", 36, 48, step: 6).findings, [])
  assert_eq(lib.sweep(clean, "t", 88, 96, step: 4).findings, [])
}

# Findings are by kind, whatever their values: a voice 50 cents sharp that
# also clicks at one pitch lists its click before its many pitch findings.
@test
fn findings_are_listed_by_kind_not_by_value() {
  let both = {voices: {t: {phrase: |notes, params| Audio.Sound(tone(notes[0].pitch + 0.5, notes[0].len, notes[0].pitch == 60, 0.5), rate: RATE)}}}
  let kinds = lib.sweep(both, "t", 57, 63, step: 3).findings.map(|b| b.what)
  assert_true(kinds.contains("start") && kinds.contains("pitch"), kinds)
  assert_eq(kinds.index_of("pitch") > kinds.index_of("start"), true)
  assert_eq(kinds.slice(0, kinds.index_of("pitch")).all(|k| k == "start"), true)
}
