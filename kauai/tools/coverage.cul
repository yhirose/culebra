# How well measured recordings cover an instrument's range: the notes per
# semitone, the long notes per octave, and the loud, middle and quiet notes.
# Prints what is short, and exits 1 when anything is, so a script can stop on
# it. coverage_lib.cul says what the needs are.
#
#   culebra kauai/tools/coverage.cul --low 200 --high 1400 work/measured/*.json
#
# `--low` and `--high` are the instrument's range (Hz), as measure.cul takes
# them. The notes of every file count together.
#
# With `--song`, what a song asks of them instead, pitch by pitch: how many
# notes its external voices play at each pitch and how many of those are held
# (0.4 s or more), against how many the recordings hold. A tune's key decides
# this: a melody in A major asked the alto for E5 73 times, 33 of them held,
# where its recordings (Autumn Leaves, in G minor) had 9 and none held.
#
#   culebra kauai/tools/coverage.cul --sounds kauai/sounds/alto_sax \
#     --song song.kau kauai/sounds/alto_sax/data/notes.json

import instrument from './instrument_lib.cul'
import lib from './coverage_lib.cul'

let SPEC = {
  name: 'coverage.cul',
  doc: 'how well measured recordings cover an instrument: notes per semitone, long notes per octave, dynamics',
  args: [
    {
      name: 'low',
      type: 'Float',
      default: nil,
      positional: false,
      doc: 'the lowest pitch of the instrument, Hz',
    },
    {
      name: 'high',
      type: 'Float',
      default: nil,
      positional: false,
      doc: 'the highest pitch of the instrument, Hz',
    },
    {
      name: 'per-semitone',
      type: 'Long',
      default: lib.NEEDS.per_semitone,
      doc: 'notes needed for each semitone',
    },
    {
      name: 'long-per-octave',
      type: 'Long',
      default: lib.NEEDS.long_per_octave,
      doc: 'long notes (1 s or more) needed for each octave',
    },
    {
      name: 'per-dynamic',
      type: 'Long',
      default: lib.NEEDS.per_dynamic,
      doc: 'notes needed in each of the loud, middle and quiet dynamics',
    },
    {
      name: 'song',
      type: 'String',
      default: "",
      positional: false,
      doc: 'a song (.kau) whose external voices are to be covered, pitch by pitch, instead of a range',
    },
    {
      name: 'sounds',
      type: 'String',
      default: "",
      positional: false,
      doc: "with --song, the instrument module the song's external voices play from",
    },
    {
      name: 'external',
      type: 'String',
      default: "",
      positional: false,
      doc: "with --song, the one instrument to cover (its key, `alto` for `external Alto`); all when left out",
    },
    {
      name: 'measured',
      type: 'String',
      positional: true,
      repeated: true,
      doc: "the NAME.json files measure.cul wrote, or a package's data/notes.json",
    },
  ],
}

fn fail(message) {
  IO.eprintln("coverage: {message}")
  Sys.exit(2)
}

let args = Args.parse(Sys.argv, SPEC)
fail("no measures named") if args.measured.empty()
let needs = {
  per_semitone: args["per-semitone"],
  long_per_octave: args["long-per-octave"],
  per_dynamic: args["per-dynamic"],
}
if !args.song.empty() {
  fail("no song {args.song}") if !FS.exists(args.song)
  fail("--song needs --sounds, the module its external voices play from") if args.sounds.empty()
  let module = instrument.module_at(args.sounds)
  fail("no instrument module at {args.sounds}") if module == nil
  let call = JSON.stringify({
    song: FS.abspath(args.song),
    external: args.external.empty() ? nil : args.external,
    measured: args.measured.map(|p| FS.abspath(p)),
    needs: needs,
  })
  let lib_path = FS.join(FS.dirname(FS.abspath(Sys.script)), "coverage_lib.cul")
  let run = try {
    instrument.program(module, lib_path, "run", call)
  } catch e: String {
    fail(e)
  }
  let r = Proc.run(run.cmd)
  FS.remove(run.entry)
  if r.code != 0 {
    IO.eprint(r.stderr)
    fail("{args.song} could not be covered")
  }
  let got = JSON.parse(r.stdout.trim().split("\n")[-1].to_string())
  println(got.text)
  Sys.exit(got.bad ? 1 : 0)
}
fail("--low and --high are needed (the instrument's range, Hz)") if args.low ==
  nil ||
  args.high == nil
fail("--low must be below --high") if args.low >= args.high

let notes = args.measured.flat_map(|path| {
  fail("no measure {path}") if !FS.exists(path)
  JSON.parse(FS.read(path)).notes
})
let lo = Math.floor(12.0 * Math.log(args.low / 440.0) / Math.log(2.0) + 69.0)
let hi = Math.ceil(12.0 * Math.log(args.high / 440.0) / Math.log(2.0) + 69.0)
let c = lib.coverage(notes, lo, hi, needs)

println("{notes.size()} notes over MIDI {lo}..{hi}; long (1 s or more): {notes.filter(|n| n.frames >= lib.LONG).size()}")
println("per semitone: {c.per_semitone.map(|k| "{k}").join(" ")}")
println("long per octave from {lo}: {c.long_per_octave.map(|k| "{k}").join(" ")}")
println("dynamics: loud {c.per_dynamic.loud}, middle {c.per_dynamic.middle}, quiet {c.per_dynamic.quiet}")
if c.shortfalls.empty() {
  println("enough: every semitone, octave and dynamic is covered")
  Sys.exit(0)
}
println("short:")
for line in c.shortfalls {
  println("  {line}")
}
Sys.exit(1)
