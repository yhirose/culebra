import lib from './measure_lib.cul'

let TOOL = FS.join(FS.dirname(FS.abspath(Sys.script)), "measure.cul")
let RATE = 44100
let hz = |semi| 440.0 * 2.0 ** ((semi + 0.1 - 69.0) / 12.0)  # 10 cents sharp
let REED = [0.3, 0.45, 0.25, 0.2, 0.15, 0.1, 0.08, 0.05]

# Frame t of `xs` through a Hann window of 2048 samples about it, as the
# breath is read: its bins' magnitudes.
fn frames_of(xs) {
  let pad = repeat(1024, 0.0)
  let padded = pad + xs + pad
  let at = |c| Audio.spectrum(padded.slice(c, c + 2048), size: 2048, hop: 2048)
  |t| at(Math.round(t * RATE / 100.0))[0]
}

# The power of frame `y` in breath band b against the whole power of frame
# `tone`, in dB: the band's bins are those whose frequency is in it.
fn band_db(y, tone, b) {
  let (lo, hi) = (lib.S.breath_bands[b][0], lib.S.breath_bands[b][1])
  let inside = fn (k) {
    let hz = k * RATE / 2048.0
    hz >= lo && hz < hi
  }
  let band = iota(1025).filter(inside).map(|k| y[k] * y[k]).sum()
  10.0 * Math.log(band / tone.map(|v| v * v).sum()) / Math.log(10.0)
}

# A performance whose notes are known, 4.6 s, every note at a quarter of
# full scale but F5 at a half:
#   A4 from a rest, rising over 30 ms; a slur to C5 (a glide of 30 ms, as a
#     slur's is, its level dipping 10 dB as it moves); the tongue stops C5
#     for 30 ms before D5;
#   in the rest after, a blip of 20 ms;
#   E5 played twice at one pitch, the tongue's stop a 30 ms dip of 10 dB;
#   a scoop of 40 ms from E5 into F5, held with a vibrato of 30 cents;
#   G5 that settles at 55 cents over it after 60 ms, 8 dB softer for its
#     first 270 ms.
let PERFORMANCE = fn () {
  let vibrato = iota(
    1,
    192,
  ).map(|i| (
    2.64 + i * 0.005,
    hz(77) * 2.0 ** (0.3 / 12.0 * Math.sin(2.0 * Math.pi * 5.5 * i * 0.005)),
  ))
  let freq = [
    (0.0, hz(69)),
    (0.585, hz(69)),
    (0.615, hz(72)),
    (1.0, hz(72)),
    (1.0, hz(74)),
    (1.4, hz(74)),
    (1.7, hz(76)),
    (2.64, hz(76)),
    (2.64, hz(77)),
    ...vibrato,
    (3.9, hz(79)),
    (3.96, hz(79)),
    (3.96, hz(79.55)),
  ]
  let on = |a, b, g| [(a, 0.0), (a + 0.005, g), (b - 0.005, g), (b, 0.0)]
  let gain = [
    (0.2, 0.0),
    (0.23, 0.25),
    (0.585, 0.25),
    (0.59, 0.08),
    (0.61, 0.08),
    (0.615, 0.25),
    (1.0, 0.25),
    (1.0, 0.0),
    ...on(1.03, 1.4, 0.25),
    ...on(1.55, 1.57, 0.25),
    (1.7, 0.0),
    (1.705, 0.25),
    (2.035, 0.25),
    (2.04, 0.08),
    (2.07, 0.08),
    (2.075, 0.25),
    (2.395, 0.25),
    (2.4, 0.0),
    ...on(2.6, 3.6, 0.5),
    (3.9, 0.0),
    (3.905, 0.1),
    (4.17, 0.1),
    (4.175, 0.25),
    (4.395, 0.25),
    (4.4, 0.0),
  ]
  Audio.partials(4.6, freq, [(0.0, REED)], gain: [(0.0, 0.0), ...gain])
}

@test
fn a_performance_is_written_down_as_its_notes() {
  let xs = PERFORMANCE()
  let m = lib.measure(xs, RATE, 200, 1400)
  assert_eq(m.hz.size(), 460)
  # The pitch the notes are read from is the median of the five frames about
  # each, within a stretch.
  let raw = Audio.pitch(xs, 200, 1400).hz
  let median = |t| raw.slice(t - 2, t + 3).sorted()[2]
  assert_true(iota(270, 350).all(|t| m.hz[t] == median(t)))
  # The blip is no note.
  assert_eq(
    m.notes.map(|v| [v.semi, v.from, v.to]),
    [
      [69, "rest", "legato"],
      [72, "legato", "tongue"],
      [74, "tongue", "rest"],
      [76, "rest", "tongue"],
      [76, "tongue", "rest"],
      [77, "rest", "rest"],
      [80, "rest", "rest"],
    ],
  )
  # Where each starts: at the change of pitch, at the quietest of the
  # tongue's stop, or at the dip's lowest; the scoop is the note it leads
  # into.
  let starts = [0.2, 0.6, 1.015, 1.7, 2.05, 2.6, 3.9]
  assert_true(iota(7).all(|k| Math.abs(m.notes[k].t0 - starts[k]) <=
    (k == 2 ? 0.01 : 0.02)))
  assert_true(Math.abs(m.tuning - 10.0) < 1.0)
  # A semitone is the one nearest the note's middle.
  assert_true(m.notes.slice(0, 6).all(|v| Math.abs(v.own) < 3.0) &&
    Math.abs(m.notes[6].own + 45.0) < 3.0)
  # Levels are from the loudest frames, F5's; the rest are 6 dB under, G5
  # in its middle.
  assert_true(iota(7).all(|k| Math.abs(m.notes[k].level -
    (k == 5 ? 0.0 : -6.02)) <
    1.0))
  assert_true(iota(7).all(|k| k == 5
    ? Math.abs(m.notes[k].vib - 30.0) < 4.0
    : m.notes[k].vib < 3.0))
  # A note entered after a rest or with the tongue sounds from its onset,
  # where it comes within 10 dB of its steady level (A4's 30 ms rise reaches
  # that 9.5 ms in); a legato one has none, even through a dip.
  let onsets = m.notes.map(|v| v.onset)
  assert_eq(onsets[1], nil)
  assert_true(Math.abs(onsets[0] - 0.2095) <= 0.003)
  assert_true([
    2, 3, 5, 6,
  ].all(|k| Math.abs(onsets[k] - [0.0, 0.0, 1.0316, 1.7, 0.0, 2.6, 3.9][k]) <=
    0.003))
  assert_true(onsets[4] > 2.04 && onsets[4] < 2.08)
  # The harmonics are read along the pitch: A4's and the F5's, through its
  # vibrato, as they were made, within 0.05 dB; with no noise in the tone,
  # what is left of them is 50 dB under them in every band. A frame without
  # a pitch has neither.
  let off = |ts, g| ts
    .map(|t| iota(8)
      .map(|k| Math.abs(20.0 *
        Math.log(m.harmonics[t][k] / (g * REED[k])) /
        Math.log(10.0)))
      .max())
    .max()
  assert_true(off(iota(30, 56), 0.25) < 0.05 && off(iota(280, 341), 0.5) < 0.05)
  assert_true([
    ...iota(30, 56),
    ...iota(280, 341),
  ].all(|t| m.breath[t].max() < -50.0))
  assert_true(iota(460).all(|t| (m.hz[t] == nil) == (m.harmonics[t] == nil) &&
    (m.hz[t] == nil) == (m.breath[t] == nil)))
}

@test
fn the_harmonics_are_read_along_the_pitch_held_across_a_stop() {
  # A stop of the tongue 4 frames long, inside it 2 frames read an octave up
  # (too short to keep): the harmonics are read along the pitch held across
  # it, and within a stretch along each frame's pitch as read.
  let raw = [
    ...iota(10).map(|i| 440.0 + i % 3),
    nil,
    880.0,
    880.0,
    nil,
    ...repeat(10, 441.0),
  ]
  let tidy = lib.tidied(raw, raw.map(|v| v == nil ? -60.0 : -20.0))
  assert_eq(tidy.along.slice(10, 14), repeat(4, 441.0))
  assert_eq(tidy.along.slice(0, 10), raw.slice(0, 10))
}

@test
fn the_breath_is_what_is_left_without_the_harmonics_against_them() {
  # A4 at a quarter of full scale, with band noise from 4 to 8 kHz.
  let reed = [(0.0, REED.map(|a| a * 0.25))]
  let tone = Audio.partials(1.2, [(0.0, 440.0)], reed)
  let noise = {low: 4000, high: 8000, steady: [(0.0, 0.1)]}
  let hiss = Audio.partials(1.2, [(0.0, 440.0)], [(0.0, [0.0])], noise:)
  let m = lib.measure(Audio.mix([tone, hiss]), RATE, 200, 1400)
  # Each band's breath is the noise's power there against the tone's, through
  # the same window, up to 1.5 dB under it: the noise within each of the 40
  # harmonics' windows is read as the harmonic's own.
  let (of_hiss, of_tone) = (frames_of(hiss), frames_of(tone))
  let median = |xs| xs.sorted()[xs.size() / 2]
  let mid = iota(20, 100)
  let spectra = mid.map(|t| (of_hiss(t), of_tone(t)))
  for b in 0..5 {
    let truth = median(spectra.map(|(y, t)| band_db(y, t, b)))
    let read = median(mid.map(|t| m.breath[t][b])) - truth
    assert_true(read <= 0.5 && read > -1.5)
  }
}

@test
fn a_band_holds_the_bins_whose_frequency_is_in_it() {
  # What is left is a sine at the frequency of the bin just under 500 Hz (23
  # of 2048 at 44100, 495 Hz), beside a tone at 2 kHz: the first band holds
  # its neighbour above it (6 dB down), not that bin.
  let f = 23 * RATE / 2048.0
  let rest = iota(8820).map(|i| 0.1 * Math.sin(2.0 * Math.pi * f * i / RATE))
  let tone = iota(8820).map(|i| 0.5 *
    Math.sin(2.0 * Math.pi * 2000.0 * i / RATE))
  let read = lib.breath(Audio.mix([tone, rest]), rest, repeat(20, 2000.0), RATE)
  let (of_rest, of_tone) = (frames_of(rest), frames_of(tone))
  assert_true(iota(
    5,
    15,
  ).all(|t| Math.abs(read[t][0] - band_db(of_rest(t), of_tone(t), 0)) < 0.01))
}

@test
fn the_command_writes_the_frames_and_the_notes_of_each_recording() {
  let dir = FS.join(FS.temp_dir(), "kauai-measure-test-{UUID.v4()}")
  FS.mkdir(dir)
  defer {
    FS.remove(dir, recursive: true)
  }
  let xs = PERFORMANCE()
  FS.write(FS.join(dir, "take 1.wav"), Audio.Sound.new(xs, RATE).data())
  let r = Proc.run(
    [
      Sys.executable,
      "--vm",
      TOOL,
      "--low",
      "200",
      "--high",
      "1400",
      "take 1.wav",
    ],
    cwd: dir,
  )
  assert_eq((r.code, r.stderr), (0, ""))
  assert_eq(
    r.stdout,
    "take 1: 7 notes (after a rest 4, tongued 2, legato 1), tuning +10 cents -> measured/take 1.json\n",
  )
  let json = JSON.parse(FS.read(FS.join(dir, "measured", "take 1.json")))
  assert_eq(
    [
      json.source,
      json.rate,
      json.settings.low,
      json.settings.high,
      json.frames,
    ],
    [
      "take 1.wav",
      RATE,
      200.0,
      1400.0,
      {
        count: 460,
        step: 0.01,
        columns: [
          "hz",
          "db",
          ...iota(1, 41).map(|k| "h{k}"),
          ...iota(1, 6).map(|b| "b{b}"),
        ],
        file: "take 1.f32",
      },
    ],
  )
  assert_eq(json.notes.size(), 7)
  # Each frame's pitch (0 where none), loudness (the mean square of the 10
  # ms about it, in dBFS; -120 for silence), 40 harmonics' amplitudes and
  # breath in 5 bands, as 32-bit floats; all 0 after the loudness where
  # there is no pitch.
  let frames = String.unpack(
    "f32",
    FS.read(FS.join(dir, "measured", "take 1.f32")),
  )
  let width = 2 + 40 + 5
  let row = |t| frames.slice(width * t, width * (t + 1))
  assert_eq(frames.size(), width * 460)
  let wav = Audio.decode(FS.read(FS.join(dir, "take 1.wav"))).channels[0]
  let around = wav.slice(40 * 441 - 220, 40 * 441 + 221)
  let db = 10.0 * Math.log(around.map(|v| v * v).sum() / 441) / Math.log(10.0)
  assert_eq((row(10)[0], row(40)[0] > 400.0, row(10)[1]), (0.0, true, -120.0))
  assert_true(Math.abs(row(40)[1] - db) < 0.001)
  assert_true(row(10).slice(2, width).all(|v| v == 0.0))
  assert_true(iota(8).all(|k| Math.abs(row(40)[2 + k] / (0.25 * REED[k]) -
    1.0) <
    0.01) &&
    row(40).slice(42, width).all(|v| v < -50.0))
  # It names what it could not do.
  let bad = Proc.run(
    [
      Sys.executable,
      "--vm",
      TOOL,
      "--low",
      "200",
      "--high",
      "1400",
      "none.wav",
    ],
    cwd: dir,
  )
  assert_eq((bad.code, bad.stderr), (2, "measure: no recording none.wav\n"))
}
