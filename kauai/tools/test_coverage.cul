import lib from './coverage_lib.cul'

# Notes at one semitone: `n` of them, `long` of them 1 s or more, at `level`.
fn notes_at(semi, n, long, level) {
  iota(n).map(|i| {
    semi: semi,
    frames: i < long ? 120 : 30,
    level: level,
    from: "tongue",
    to: "rest",
  })
}

@test
fn a_semitone_with_too_few_notes_and_an_octave_without_long_ones_are_short() {
  let notes = [
    ...notes_at(60, 6, 0, -20.0),
    ...notes_at(61, 2, 0, -20.0),
    ...notes_at(62, 6, 6, -20.0),
    ...notes_at(63, 6, 6, -20.0),
  ]
  let c = lib.coverage(
    notes,
    60,
    63,
    {per_semitone: 5, long_per_octave: 10, per_dynamic: 1},
  )
  assert_eq(c.per_semitone, [6, 2, 6, 6])
  assert_eq(c.long_per_octave, [12])
  assert_true(c.shortfalls.contains("61: 2 of 5 notes"))
  # Twelve long notes in the octave meet its need of ten.
  assert_true(!c.shortfalls.any(|s| s.contains("octave")))
}

@test
fn a_range_with_no_long_notes_in_an_octave_is_short_there() {
  let notes = [...notes_at(60, 8, 0, -20.0), ...notes_at(72, 8, 8, -20.0)]
  let c = lib.coverage(
    notes,
    60,
    72,
    {per_semitone: 1, long_per_octave: 5, per_dynamic: 1},
  )
  assert_eq(c.long_per_octave, [0, 8])
  assert_true(c.shortfalls.contains("octave from 60: 0 of 5 long notes (1 s or more)"))
}

@test
fn the_dynamics_are_loud_middle_and_quiet_by_the_median() {
  let notes = [
    ...notes_at(60, 4, 0, -10.0),
    ...notes_at(60, 4, 0, -20.0),
    ...notes_at(60, 4, 0, -30.0),
  ]
  assert_eq(lib.dynamic_of(-10.0, -20.0), "loud")
  assert_eq(lib.dynamic_of(-30.0, -20.0), "quiet")
  assert_eq(lib.dynamic_of(-22.0, -20.0), "middle")
  let c = lib.coverage(
    notes,
    60,
    60,
    {per_semitone: 1, long_per_octave: 0, per_dynamic: 5},
  )
  assert_eq(c.per_dynamic, {loud: 4, middle: 4, quiet: 4})
  assert_true(c.shortfalls.any(|s| s.contains("loud: 4 of 5")))
}

@test
fn enough_notes_everywhere_is_no_shortfall() {
  let notes = [...notes_at(60, 5, 2, -20.0), ...notes_at(61, 5, 2, -20.0)]
  let c = lib.coverage(
    notes,
    60,
    61,
    // All at one level: the dynamics are not what this checks.
    {per_semitone: 5, long_per_octave: 4, per_dynamic: 0},
  )
  assert_eq(c.shortfalls, [])
}

# A song asking for E5 (76) held and short, A4 (69) short, and B4 (71) held,
# of recordings with many short E5s and no held one, many A4s, and two B4s.
@test
fn a_song_is_short_where_it_asks_a_pitch_held_or_often_that_is_not_recorded() {
  let notes = [...notes_at(76, 9, 0, -20.0), ...notes_at(69, 20, 3, -20.0), ...notes_at(71, 2, 2, -20.0)]
  let held = |semi| {semi: semi, frames: 60}
  let short = |semi| {semi: semi, frames: 20}
  let asked = [held(76), short(76), short(76), short(69), short(69), held(71)]
  let c = lib.song_coverage(notes, asked, {per_semitone: 5, long_per_octave: 0, per_dynamic: 0})
  assert_eq(c.pitches.map(|p| [p.semi, p.asked, p.asked_held, p.has, p.has_held]), [
    [69, 2, 0, 20, 3],
    [71, 1, 1, 2, 2],
    [76, 3, 1, 9, 0],
  ])
  # B4: two notes recorded; E5: asked held, none held recorded. A4 is enough.
  assert_eq(c.shortfalls, [
    "71: 2 of 5 notes recorded, for 1 asked",
    "76: no note of 0.4 s or more recorded, for 1 asked held",
  ])
}

# What Kauai hands an instrument, as the notes asked: a phrase's notes by
# their length (or, where the instrument does not hear it, until the next or
# the sound's end), a voice's one pitch for its sound's length; a drum none.
@test
fn the_notes_asked_are_read_from_what_kauai_hands_the_instruments() {
  let song = {external_sounds: || [
    {at: 1.0, until: 2.0, external: "alto", args: [[{pitch: 72, at: 0.0, len: 0.5}, {pitch: 74, at: 0.5}], {}]},
    {at: 3.0, until: 3.25, external: "ep", args: [60, {}]},
    {at: 4.0, until: 4.1, external: "kick", args: [{}]},
  ]}
  assert_eq(lib.asked_of(song), [{semi: 72, frames: 50}, {semi: 74, frames: 50}, {semi: 60, frames: 25}])
  assert_eq(lib.asked_of(song, "ep"), [{semi: 60, frames: 25}])
}

