import lib from './fit_style_lib.cul'
import engine from '../engine/borrow.cul'
import compare from './compare_lib.cul'
import synthetic from '../engine/synthetic.cul'

let RATE = synthetic.RATE
let STYLE = synthetic.STYLE

# A tune over the range the synthetic performance plays: A, C and E above.
let SONG = 'band Solo {
  voice Lead  external Sax  plays melody  vol 60
}
song Tune {
  tempo 120
  band Solo
  melody in A4..G#5
  Verse
}
section Verse {
  A     a4 c e a
}
'

let FILES = Dir.memory({"tune.kau": SONG})

# The instrument made from the synthetic performance, once: it is read into
# memory, so its folder can go at once.
let MADE = fn () {
  let dir = FS.join(FS.temp_dir(), "fit-test-{UUID.v4()}")
  FS.mkdir(dir)
  defer {
    FS.remove(dir, recursive: true)
  }
  let made = synthetic.made_into(dir)
  {
    inst: engine.Instrument.new(made.data, STYLE),
    measured: [JSON.parse(FS.read(made.measured))],
  }
}()

# The song of the two fits, as the instrument plays it in STYLE.
let PAIRS = [{
  song: "tune.kau",
  target: lib.rendered(MADE.inst, "sax", "tune.kau", 2.2, FILES),
  low: 200.0,
  high: 1400.0,
  dir: FILES,
}]

@test
fn a_first_style_is_read_off_the_recordings() {
  let made = MADE
  let d = lib.derived(made.inst)
  # The performance plays A4 and C5, both long: the overtones begin a
  # semitone over the top one.
  assert_eq(d.overtone_from, 73)
  # An onset after a rest and after the tongue, a few hundredths of a second
  # after the first frame at most.
  assert_true(d.onset_from_t0.rest >= 0.0 && d.onset_from_t0.rest < 0.1)
  assert_true(d.onset_from_t0.tongue >= 0.0 && d.onset_from_t0.tongue < 0.1)
  assert_true(d.vibrato.depth >= 0.0)
  # The level a note at mf asks to borrow is the library's own.
  assert_eq(d.lib_level_mf, lib.LIB_MF)
}

@test
fn a_number_a_song_shows_is_found_from_a_start_far_off() {
  let made = MADE
  # The target is the song played in STYLE (loudness grows 5 dB an octave up
  # the range); the start has it growing not at all.
  let start = {...STYLE, db_per_octave: 0.0}
  let params = [{path: ["db_per_octave"], step: 4.0, lo: 0.0, hi: 14.0}]
  let r = lib.fit(made.inst, "sax", start, PAIRS, 2.2, params, 1)
  assert_true(
    Math.abs(r.style.db_per_octave - 7.0) <= 3.0,
    r.style.db_per_octave,
  )
  assert_true(r.cost < 0.5 * r.log[0].cost, r.cost)
  # Every style logged is one that was better than the one before it.
  let costs = r.log.map(|e| e.cost)
  assert_true(iota(1, costs.size()).all(|i| costs[i] < costs[i - 1]))
}

@test
fn a_number_at_its_bound_stays_in_it() {
  let made = MADE
  # The right number is out of the range the fit may use.
  let start = {...STYLE, db_per_octave: 0.0}
  let params = [
    {path: ["db_per_octave"], step: 3.0, lo: 0.0, hi: 3.0},
    {path: ["overtone_from"], step: 1.0, lo: 60.0, hi: 100.0},
  ]
  let r = lib.fit(made.inst, "sax", start, PAIRS, 2.2, params, 1)
  assert_true(r.style.db_per_octave <= 3.0)
  # The tune asks for A4 to E5; an overtone from 80 is heard by none of it.
  assert_eq(r.pitches, [69, 72, 76])
  assert_eq(r.unseen, ["overtone_from"])
}

@test
fn the_songs_are_said_to_be_blind_where_they_do_not_reach() {
  # Steady notes up to 81, the library from 55: songs over 62 to 79 leave the
  # top (and the bottom) unseen; songs over 55 to 86 leave nothing.
  assert_eq(lib.blind([62, 70, 79], 55, 81).size(), 2)
  assert_eq(lib.blind([55, 70, 86], 55, 81), [])
  assert_eq(lib.blind([], 55, 81).size(), 1)
}

@test
fn the_cost_counts_what_is_over_its_limit_and_no_more_than_five_limits() {
  let zero = lib.cost({
    spectral_db: 0.0,
    loudness_db: 0.0,
    integrated_lu: 0.0,
    pitch_median_cents: 0.0,
    pitch_p95_cents: 0.0,
    voicing: 0.0,
    centroid_cents: 0.0,
    breath_db: 0.0,
    vibrato_cents: 0.0,
  })
  assert_eq(zero, 0.0)
  let huge = lib.cost({
    spectral_db: 1000.0,
    loudness_db: 1000.0,
    integrated_lu: 1000.0,
    pitch_median_cents: 1000.0,
    pitch_p95_cents: 1000.0,
    voicing: 1000.0,
    centroid_cents: 1000.0,
    breath_db: 1000.0,
    vibrato_cents: 1000.0,
  })
  assert_eq(huge, 5.0)
}

@test
fn the_program_says_what_it_is_missing() {
  let tool = FS.join(FS.dirname(FS.abspath(Sys.script)), "fit_style.cul")
  let none = Proc.run([Sys.executable, "--vm", tool])
  assert_eq(none.code, 2)
  assert_true(none.stderr.contains("--sounds is needed"))
}

@test
fn every_number_compare_limits_has_a_weight_and_the_other_way() {
  assert_eq(lib.WEIGHT.keys().sorted(), compare.LIMITS.keys().sorted())
}
