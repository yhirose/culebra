import kau from './kau.cul'
import corpus from './corpus.cul'

# Every song, written back from its score: the text reads to the same score,
# and plays the same notes.
@test
fn every_song_reads_back_from_its_written_score() {
  for path in corpus.SONGS {
    let score = Kauai.parse_file(path)
    let text = kau.write(score)
    let again = try {
      Kauai.parse(text)
    } catch e {
      println("{path} written:\n{text}")
      throw e
    }
    if again != score {
      println("{path} written:\n{text}")
    }
    assert_eq(again, score)
    let sounds = corpus.silent(score.arrangement)
    let played = corpus.events_of(path, score.arrangement)
    assert_eq(Kauai.new(text, voices: sounds.voices, drums: sounds.drums).events(), played)
  }
}

# A tuplet as many notes as its ratio says is written short, a parameter in
# it not counted as a note.
@test
fn a_tuplet_with_a_parameter_in_it_is_written_short() {
  let text = kau.write(Kauai.parse_file("kauai/convert/notations.kau"))
  assert_true(text.contains(" 3[g8 \\bright=1.1 f eb] "), text)
}
