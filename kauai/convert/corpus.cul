# The songs the converters are tested on: every song in the repository
# (run*.kau are bands that cruise and sprint use) and one that writes every
# notation.
let SONGS = [
  "kauai/convert/notations.kau",
  "examples/kauai/songs/features.kau",
  "examples/kauai/songs/first.kau",
  "examples/kauai/songs/guitar.kau",
  "examples/kauai/songs/jetveux.kau",
  "examples/kauai/songs/jetveux_piano.kau",
  "examples/kauai/songs/sax.kau",
  "examples/kauai/songs/strings.kau",
  "examples/kauai/songs/trio.kau",
  "examples/games/retro-run/assets/ballad.kau",
  "examples/games/retro-run/assets/cruise.kau",
  "examples/games/retro-run/assets/sprint.kau",
  "kauai/sounds/alto_sax/songs/fast_lane.kau",
  "kauai/sounds/alto_sax/songs/harbor_lights.kau",
  "kauai/sounds/alto_sax/songs/ocean_highway.kau",
]

# The instruments a band names with a capital letter (the program's, not the
# mixer's), each answering no sound: enough to read a song and list what it
# plays.
fn silent(arrangement) {
  mut voices = {}
  mut drums = {}
  for line in arrangement.split("\n") {
    let w = line.split_whitespace()
    continue if w.size() < 3 || !["voice", "drum"].contains(w[0]) || !"ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(w[2].slice(0, 1).to_string())
    let key = w[2].lower()
    if w[0] == "drum" {
      drums[key] = |params| nil
    } else {
      voices[key] = |pitch, params| nil
    }
  }
  {voices: voices, drums: drums}
}

# What song `path` plays, its external instruments silent.
fn events_of(path, arrangement) {
  let sounds = silent(arrangement)
  Kauai.load(path, voices: sounds.voices, drums: sounds.drums).events()
}

# The voices of a band, each {voice, plays (the word after each `plays`),
# parts (the parts it names after `part`)}.
fn band_voices(arrangement) {
  arrangement.lines().map(|l| l
    .split_whitespace()
    .map(|w| w.to_string())).filter(|w| w.size() > 1 &&
    w[0] == "voice").map(fn (w) {
    let from = w.index_of("part")
    {
      voice: w[1],
      plays: iota(w.size() - 1).filter(|i| w[i] == "plays").map(|i| w[i + 1]),
      parts: from < 0
        ? []
        : w
          .slice(from + 1, w.size())
          .iter()
          .take_while(|x| x.slice(0, 1).to_string() !=
            x.slice(0, 1).to_string().lower())
          .collect(),
    }
  })
}

export {SONGS, silent, events_of, band_voices}
