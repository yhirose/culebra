import mx from './musicxml.cul'
import reader from './musicxml_read.cul'
import kau from './kau.cul'
import corpus from './corpus.cul'

let SCORES = "kauai/convert/scores"
let silent = {ep: |pitch, params| nil}
let READ_BACK = {}

# A score's MusicXML text read as a Kauai song: its text and what it leaves
# out.
fn song_of(text) {
  let r = reader.read(text)
  {text: kau.write(r.score), dropped: r.dropped, score: r.score}
}

# A score's MusicXML text without the song's Kauai text: the score as
# another program that left it out would have it.
let bare = |text| Regex.replace_all(
  "<miscellaneous-field name=\"kauai-song\">[^<]*</miscellaneous-field>",
  text,
  "",
)

# Song `path`'s score, that written as a MusicXML score (`xml`), and that
# read back from what the score shows alone, made once for the tests that
# read songs back.
fn read_back(path) {
  READ_BACK[path] ??= fn () {
    let score = Audio.Kauai.parse_file(path)
    let xml = mx.write(score)
    {score, xml, back: song_of(bare(xml))}
  }()
  READ_BACK[path]
}

# A song's text as it plays without its rit.s and accel.s, which a score
# shows without the tempo they reach.
let steady = |text| Regex.replace_all("\\\\(rit|accel) [0-9.=]+", text, "")

# The notes voices `by` play, as (pitch, start, length) in milliseconds, in
# order.
let notes_of = |events, by| events
  .filter(|e| by.contains(e.by))
  .map(|e| (e.pitch, Math.round(e.at * 1000), Math.round(e.len * 1000)))
  .sorted_by(|n| (n[1], n[0]))

# The voices of a band that play only the melody and parts, each with the
# lines it plays: `Melody`, else its parts.
fn line_voices(arrangement) {
  corpus
    .band_voices(arrangement)
    .filter(|v| !v.plays.empty() &&
      v.plays.all(|p| p == "melody" || p == "part"))
    .map(|v| {
      voice: v.voice,
      lines: [...(v.plays.contains("melody") ? ["Melody"] : []), ...v.parts],
    })
}

# Every song in the repository, written as a MusicXML score and read back,
# is the song as it was written, and nothing is said to be left out.
@test
fn every_song_reads_back_from_its_score_as_written() {
  for path in corpus.SONGS {
    let w = read_back(path)
    let back = song_of(w.xml)
    assert_eq(back.text, kau.write(w.score), path)
    assert_eq(back.dropped, [], path)
  }
}

# Every song in the repository, read back from what its score shows alone,
# plays its melody and its parts as the song does (but its rit.s and
# accel.s), and leaves out the band's staves: the song's band plays the
# lines the score writes, each a voice of the line's name.
@test
fn every_song_read_back_from_its_score_plays_its_lines() {
  for path in corpus.SONGS {
    let (score, back) = (read_back(path).score, read_back(path).back)
    let heard = Audio.Kauai.new(back.text, voices: silent).events()
    let sounds = corpus.silent(score.arrangement)
    let played = Audio
      .Kauai
      .new(steady(kau.write(score)), voices: sounds.voices, drums: sounds.drums)
      .events()
    for v in line_voices(score.arrangement) {
      assert_eq(
        notes_of(heard, v.lines),
        notes_of(played, [v.voice]),
        "{path}: {v.voice} plays {v.lines}",
      )
    }
    let parts = back
      .score
      .sections
      .flat_map(|s| s.bars)
      .flat_map(|b| b.parts)
      .map(|p| p.name)
      .iter()
      .distinct()
      .collect()
    assert_true(
      parts.all(|p| score.played.voices.all(|v| v != p)),
      "{path}: no band staff read as a part: {parts}",
    )
  }
}

# A song read from what a score shows alone reads back from its own score,
# shown alone, as the same text.
@test
fn a_song_read_from_a_score_is_its_own_scores_song() {
  for path in ["kauai/convert/notations.kau", "examples/games/retro-run/assets/cruise.kau", "examples/kauai/songs/sax.kau"] {
    let once = read_back(path).back.text
    assert_eq(song_of(bare(mx.write(Audio.Kauai.parse(once)))).text, once, path)
  }
}

# The OpenScore Je te veux plays its voice as tests/kauai/jetveux.expect,
# written from the score alone, has it: its repeats, its three endings and
# its two verses' endings taken. At one tempo, the times are sixty-fourths.
@test
fn je_te_veux_plays_its_score() {
  let song = song_of(reader.score_text(FS.read("{SCORES}/jetveux.mxl")))
  let steady = Regex.replace_all(
    "\\\\(tempo|rit|accel)( [0-9.=]+)?",
    song.text,
    "",
  )
  let per_second = song.score.song.tempo.per / 60.0 * 16
  let at_64 = |seconds| Math.round(seconds * per_second)
  let played = Audio
    .Kauai
    .new(steady, voices: silent)
    .events()
    .filter(|e| e.by == "Melody")
    .map(|e| (e.pitch, at_64(e.at), at_64(e.len)))
  let expect = JSON
    .parse(FS.read("tests/kauai/jetveux.expect"))
    .notes
    .map(|n| (
      to_long(n[0]),
      Math.round(to_float(n[1]) * 16),
      Math.round(to_float(n[2]) * 16),
    ))
  assert_eq(played, expect)
  assert_true(
    song.dropped.any(|d| d.starts_with("lyrics: ")),
    "the lyrics are said to be left out",
  )
}

# The test suite's scores read as songs, but those Kauai does not play: each
# with what it is said to leave out, or the error.
@test
fn the_test_suites_scores_read_as_songs() {
  let refused = {
    "02a-Rests-Durations.xml": "a 64th",
    "03a-Rhythm-Durations.xml": "a long",
    "23a-Tuplets.xml": "a tuplet too fine for Kauai (7:3",
    "23d-Tuplets-Nested.xml": "a tuplet too fine for Kauai (9:4",
  }
  let says = {
    "61a-Lyrics.xml": "lyrics",
    "71a-Chordnames.xml": "a chord symbol Kauai spells another way",
    "21f-Chord-ElementInBetween.xml": "a segno or a coda sign",
  }
  for path in FS.glob("{SCORES}/kainhofer/*.xml").sorted() {
    let name = FS.basename(path)
    let outcome = try {
      let song = song_of(FS.read(path))
      Audio.Kauai.new(song.text, voices: silent)
      song.dropped
    } catch e: String {
      e
    }
    if refused.has(name) {
      assert_true(
        outcome is String && outcome.contains(refused[name]),
        "{name}: {outcome}",
      )
    } else {
      assert_true(!(outcome is String), "{name}: {outcome}")
      assert_true(
        outcome.any(|d| d.starts_with(says[name])),
        "{name}: {outcome}",
      ) if says.has(name)
    }
  }
}

# A whole note of each `pitches` in a measure, the measure's other elements
# after the note: a score as MusicXML.
fn whole_notes(measures) {
  partwise(measures.map(|m| ("", note(m[0], "whole", 4) + m[1])))
}

# A score of one part, its measures each (attributes, what it holds), in
# 4/4 with a division to a quarter.
fn partwise(measures) {
  score_of([("Voice", measures)])
}

# A score of `parts`, each (its name, its measures as `partwise` takes them).
fn score_of(parts) {
  let list = parts.enumerate().map(fn ((i, p)) {
    "<score-part id=\"P{i + 1}\"><part-name>{p[0]}</part-name></score-part>"
  }).join("")
  let body = parts.enumerate().map(fn ((i, p)) {
    let measures = p[1].enumerate().map(fn ((k, m)) {
      let head = k == 0
        ? "<attributes><divisions>1</divisions><time><beats>4</beats><beat-type>4</beat-type></time></attributes>"
        : ""
      "<measure number=\"{k + 1}\"{m[0]}>{head}{m[1]}</measure>"
    }).join("")
    "<part id=\"P{i + 1}\">{measures}</part>"
  }).join("")
  "<?xml version=\"1.0\"?><score-partwise version=\"4.0\"><part-list>{list}</part-list>{body}</score-partwise>"
}

# A note of pitch `step` in octave 4, as long as `type` and `duration` say,
# with `more` inside it.
let note = |step, type, duration, more = ""| "<note><pitch><step>{step}</step><octave>4</octave></pitch><duration>{duration}</duration><voice>1</voice><type>{type}</type>{more}</note>"

let barline = |where, what| "<barline location=\"{where}\">{what}</barline>"

# What the melody plays, as (pitch, start in quarters at 120 a minute).
let heard = |text| Audio
  .Kauai
  .new(song_of(text).text, voices: silent)
  .events()
  .filter(|e| e.by == "Melody")
  .map(|e| (e.pitch, e.at * 2))

# A first measure the score marks implicit is a pickup, and one it does not
# is a whole bar, its notes at its start; notes in a tuplet the score draws
# no bracket for are its tuplet still; a slur from a grace note starts on
# the note it leads to; and a second group of endings right after a first
# plays its endings on the times they say.
@test
fn pickups_tuplets_grace_slurs_and_endings_read() {
  let short = |attrs| partwise([
    (attrs, note("C", "quarter", 1)),
    ("", note("D", "whole", 4)),
  ])
  assert_eq(heard(short(" implicit=\"yes\"")), [(60, 0.0), (62, 1.0)])
  assert_eq(heard(short("")), [(60, 0.0), (62, 4.0)])
  let triplet = note(
    "C",
    "eighth",
    1,
    "<time-modification><actual-notes>3</actual-notes><normal-notes>2</normal-notes></time-modification>",
  )
  # Three divisions to a quarter, a triplet eighth's one.
  let bar = song_of(partwise([(
    "",
    "<attributes><divisions>3</divisions></attributes>" +
      triplet +
      triplet +
      triplet +
      note("D", "half", 6) +
      note("E", "quarter", 3),
  )])).score.sections[0].bars[0]
  assert_eq(bar.melody[0].tuplet, {actual: 3, normal: 2})
  let grace = "<note><grace/><pitch><step>B</step><octave>3</octave></pitch><voice>1</voice><type>eighth</type><notations><slur type=\"start\"/></notations></note>"
  let slurred = song_of(partwise([(
    "",
    grace +
      note("C", "half", 2) +
      note("D", "half", 2, "<notations><slur type=\"stop\"/></notations>"),
  )])).score
  assert_eq(
    slurred.sections[0].bars[0].melody.map(|it| it.has("slur")
      ? it.slur
      : it.pitches[0].step),
    ["start", "C", "D", "stop"],
  )
  let groups = partwise([
    (
      "",
      barline("left", "<repeat direction=\"forward\"/>") +
        note("C", "whole", 4),
    ),
    (
      "",
      barline("left", "<ending number=\"1\" type=\"start\"/>") +
        note("D", "whole", 4) +
        barline("right", "<ending number=\"1\" type=\"stop\"/>"),
    ),
    (
      "",
      barline("left", "<ending number=\"2\" type=\"start\"/>") +
        note("E", "whole", 4) +
        barline("right", "<ending number=\"2\" type=\"discontinue\"/>"),
    ),
    (
      "",
      barline("left", "<ending number=\"1\" type=\"start\"/>") +
        note("F", "whole", 4) +
        barline(
          "right",
          "<ending number=\"1\" type=\"stop\"/><repeat direction=\"backward\"/>",
        ),
    ),
    (
      "",
      barline("left", "<ending number=\"2\" type=\"start\"/>") +
        note("G", "whole", 4) +
        barline("right", "<ending number=\"2\" type=\"discontinue\"/>"),
    ),
  ])
  assert_eq(heard(groups).map(|n| n[0]), [60, 62, 65, 60, 64, 67])
}

# A slur from a repeat's body that the first ending closes keeps its start
# when the second ending only rests, or leaves the slur's voice out of its
# last measure or only rests there: that ending ends the slur after its
# rest, or on the voice's last note it writes. When an ending leaves the
# voice out altogether, the body ends the slur before every ending, and
# every note is kept.
@test
fn a_slur_an_ending_closes_keeps_its_start() {
  let slur = |type| "<notations><slur type=\"{type}\"/></notations>"
  let rest = "<note><rest/><duration>4</duration><voice>1</voice><type>whole</type></note>"
  let repeat = barline("left", "<repeat direction=\"forward\"/>")
  let first = barline("left", "<ending number=\"1\" type=\"start\"/>")
  let back = barline(
    "right",
    "<ending number=\"1\" type=\"stop\"/><repeat direction=\"backward\"/>",
  )
  let second = barline("left", "<ending number=\"2\" type=\"start\"/>")
  let done = barline("right", "<ending number=\"2\" type=\"discontinue\"/>")
  let ending_rests = partwise([
    ("", repeat + note("C", "whole", 4, slur("start"))),
    ("", first + note("D", "whole", 4, slur("stop")) + back),
    ("", second + rest + done),
  ])
  assert_eq(heard(ending_rests), [(60, 0.0), (62, 4.0), (60, 8.0)])
  # A whole note or rest in a second voice of the measure.
  let in_lower = |el| "<backup><duration>4</duration></backup>" +
    el.replace("<voice>1</voice>", "<voice>2</voice>")
  let lower = |step, more = ""| in_lower(note(step, "whole", 4, more))
  let voice_left_out = partwise([
    ("", repeat + note("C", "whole", 4) + lower("E", slur("start"))),
    ("", first + note("D", "whole", 4) + lower("F", slur("stop")) + back),
    ("", second + note("G", "whole", 4) + lower("A")),
    ("", note("B", "whole", 4) + done),
  ])
  assert_eq(heard(voice_left_out).map(|n| n[0]), [60, 62, 60, 67, 71])
  # What the second voice plays.
  let lower_heard = |text| notes_of(
    Audio.Kauai.new(song_of(text).text, voices: silent).events(),
    ["Voice2"],
  ).map(|n| n[0])
  let voice_rests = partwise([
    ("", repeat + note("C", "whole", 4) + lower("E", slur("start"))),
    ("", first + note("D", "whole", 4) + lower("F", slur("stop")) + back),
    ("", second + note("G", "whole", 4) + lower("A")),
    ("", note("B", "whole", 4) + in_lower(rest) + done),
  ])
  assert_eq(lower_heard(voice_rests), [64, 65, 64, 69])
  let no_ending_has_it = partwise([
    ("", repeat + note("C", "whole", 4) + lower("E", slur("start"))),
    ("", first + note("D", "whole", 4) + back),
    ("", second + note("G", "whole", 4) + done),
  ])
  assert_eq(lower_heard(no_ending_has_it), [64, 64])
  let second_has_not = partwise([
    ("", repeat + note("C", "whole", 4) + lower("E", slur("start"))),
    ("", first + note("D", "whole", 4) + lower("F", slur("stop")) + back),
    ("", second + note("G", "whole", 4) + done),
  ])
  assert_eq(lower_heard(second_has_not), [64, 65, 64])
}

let sound = |attrs| "<direction><direction-type><words>x</words></direction-type><sound {attrs}/></direction>"

# A pickup plays again into a repeat from the first bar where the score
# writes it at the end of the bar before, in a first ending or in the last
# bar of the repeat (and there the last time too, as written); a repeat the
# score writes no pickup before plays none. A repeat from the start, or a
# D.C., plays the pickup's own measure again, where the bar before rests.
@test
fn a_pickup_plays_again_where_the_score_writes_it() {
  let opening = (" implicit=\"yes\"", note("G", "quarter", 1))
  let again = (
    "",
    barline("left", "<repeat direction=\"forward\"/>") + note("C", "whole", 4),
  )
  let back = barline("right", "<repeat direction=\"backward\"/>")
  let quarter_rest = "<note><rest/><duration>1</duration><voice>1</voice><type>quarter</type></note>"
  let into = note("E", "half", 2) + quarter_rest + note("G", "quarter", 1)
  # The repeat with the pickup in its first ending, the second holding
  # `second`.
  let endings = |second| partwise([
    opening,
    again,
    (
      "",
      barline("left", "<ending number=\"1\" type=\"start\"/>") +
        into +
        barline(
          "right",
          "<ending number=\"1\" type=\"stop\"/><repeat direction=\"backward\"/>",
        ),
    ),
    ("", barline("left", "<ending number=\"2\" type=\"start\"/>") + second),
  ])
  let plain = partwise([opening, again, ("", into + back)])
  assert_eq(
    heard(plain),
    [
      (67, 0.0),
      (60, 1.0),
      (64, 5.0),
      (67, 8.0),
      (60, 9.0),
      (64, 13.0),
      (67, 16.0),
    ],
  )
  let ended = endings(note("C", "whole", 4))
  assert_eq(
    heard(ended),
    [(67, 0.0), (60, 1.0), (64, 5.0), (67, 8.0), (60, 9.0), (60, 13.0)],
  )
  # Two endings the same but for the pickup in the first: one run, twice.
  let same = endings(note("E", "half", 2) +
    "<note><rest/><duration>2</duration><voice>1</voice><type>half</type></note>")
  assert_eq(
    heard(same),
    [(67, 0.0), (60, 1.0), (64, 5.0), (67, 8.0), (60, 9.0), (64, 13.0)],
  )
  let unled = partwise([opening, again, ("", note("E", "whole", 4) + back)])
  assert_eq(
    heard(unled),
    [(67, 0.0), (60, 1.0), (64, 5.0), (60, 9.0), (64, 13.0)],
  )
  # As Kauai writes them: the pickup the section's, the bar before it its
  # rests, the last time as the score writes it.
  let text = |score| song_of(score).text
  assert_true(text(plain).contains("\n  A x2\n}"), text(plain))
  assert_true(
    text(plain).contains("  N.C.          c1\n                e2 r\n    2nd: e2 r4 g\n"),
    text(plain),
  )
  assert_true(
    text(ended).contains("\n  A ending 1\n  A ending 2\n}"),
    text(ended),
  )
  assert_true(
    text(ended).contains("  ending 1 \{\n    N.C.          e2 r\n  }"),
    text(ended),
  )
  assert_true(text(unled).contains("\n  A\n  B\n}"), text(unled))
  assert_true(text(same).contains("\n  A x2\n}"), text(same))

  # Back to the pickup's own measure: the bar before rests where it plays.
  let resting = ("", note("E", "half", 2) + quarter_rest)
  let first = ("", note("C", "whole", 4))
  let from_start = partwise([opening, first, (resting[0], resting[1] + back)])
  assert_eq(
    heard(from_start),
    [(67, 0.0), (60, 1.0), (64, 5.0), (67, 8.0), (60, 9.0), (64, 13.0)],
  )
  assert_true(text(from_start).contains("\n  A x2\n}"), text(from_start))
  let marked = partwise([
    (
      opening[0],
      barline("left", "<repeat direction=\"forward\"/>") + opening[1],
    ),
    first,
    (resting[0], resting[1] + back),
  ])
  assert_eq(heard(marked), heard(from_start), "a repeat sign on the pickup")
  let da_capo = partwise([
    opening,
    ("", note("C", "whole", 4) + sound("fine=\"yes\"")),
    (resting[0], resting[1] + sound("dacapo=\"yes\"")),
  ])
  assert_eq(
    heard(da_capo),
    [(67, 0.0), (60, 1.0), (64, 5.0), (67, 8.0), (60, 9.0)],
  )
  # A D.C. goes back to the very start, past a repeat from the first bar.
  let past = partwise([
    opening,
    again,
    ("", note("E", "whole", 4) + back + sound("fine=\"yes\"")),
    ("", note("D", "half", 2) + quarter_rest + sound("dacapo=\"yes\"")),
  ])
  assert_eq(
    heard(past),
    [
      (67, 0.0),
      (60, 1.0),
      (64, 5.0),
      (60, 9.0),
      (64, 13.0),
      (62, 17.0),
      (67, 20.0),
      (60, 21.0),
      (64, 25.0),
    ],
  )
  # Where the bar before it does not rest there, the pickup's measure is a
  # bar of its own, as long as the pickup.
  let crowded = partwise([opening, first, ("", note("E", "whole", 4) + back)])
  assert_eq(
    heard(crowded),
    [(67, 0.0), (60, 1.0), (64, 5.0), (67, 9.0), (60, 10.0), (64, 14.0)],
  )
  assert_eq(song_of(crowded).dropped, [])
  assert_true(
    text(crowded).contains("\n  A\n  C\n  B\n}") &&
      text(crowded).contains("  meter 1/4\n  N.C.          g4\n"),
    text(crowded),
  )
  let eighth = partwise([
    (
      opening[0],
      "<attributes><divisions>2</divisions></attributes>" +
        note("G", "eighth", 1),
    ),
    ("", note("C", "whole", 8)),
    ("", note("E", "whole", 8) + back),
  ])
  # A pickup longer than the bar before it.
  let long = partwise([
    (
      opening[0],
      note("G", "quarter", 1) +
        note("A", "quarter", 1) +
        note("B", "quarter", 1),
    ),
    ("", note("C", "whole", 4)),
    (
      "",
      "<attributes><time><beats>2</beats><beat-type>4</beat-type></time></attributes>" +
        quarter_rest +
        quarter_rest +
        back,
    ),
  ])
  assert_true(
    text(long).contains("  meter 3/4\n  N.C.          g4 a b\n"),
    text(long),
  )
  # A half note's pickup changing chord, and slurred into the first bar: its
  # bar has both chords and ends the slur.
  let chorded = partwise([
    (
      opening[0],
      "<harmony><root><root-step>C</root-step></root><kind>major</kind></harmony>" +
        note(
          "G",
          "quarter",
          1,
          "<notations><slur type=\"start\"/></notations>",
        ) +
        "<harmony><root><root-step>F</root-step></root><kind>major</kind></harmony>" +
        note("A", "quarter", 1),
    ),
    ("", note("C", "whole", 4, "<notations><slur type=\"stop\"/></notations>")),
    ("", note("E", "whole", 4) + back),
  ])
  assert_true(
    text(chorded).contains("  meter 2/4\n  C F           (g4 a)\n"),
    text(chorded),
  )
  assert_eq(
    song_of(chorded).dropped,
    ["a slur cut where its section ends, its last note no longer joined to the next: measure 1"],
  )
  assert_true(
    text(eighth).contains("  meter 1/8\n  N.C.          g8\n"),
    "in the longest value it is: {text(eighth)}",
  )

  # A slur from the pickup into the first bar, where the pickup is written
  # again and where it is not.
  let slurred = |last| partwise([
    (
      opening[0],
      note("G", "quarter", 1, "<notations><slur type=\"start\"/></notations>"),
    ),
    (
      "",
      barline("left", "<repeat direction=\"forward\"/>") +
        note("C", "whole", 4, "<notations><slur type=\"stop\"/></notations>"),
    ),
    ("", last + back),
  ])
  let led = slurred(note("E", "half", 2) +
    quarter_rest +
    note("G", "quarter", 1, "<notations><slur type=\"start\"/></notations>"))
  assert_eq(heard(led), heard(plain))
  assert_true(
    text(led).contains("  pickup  (g4\n  N.C.          c1)\n                e2 r\n    2nd: e2 r4 (g)\n"),
    text(led),
  )
  assert_eq(heard(slurred(note("E", "whole", 4))), heard(unled))
}

# D.S. goes back to the segno, and after it To Coda goes to the coda; D.C.
# goes back to the start, and after it Fine ends the song.
@test
fn jumps_go_where_the_score_says() {
  let melody = |text| heard(text).map(|n| n[0])
  let al_coda = whole_notes([
    ("C", ""),
    ("D", sound("segno=\"s\"")),
    ("E", sound("tocoda=\"c\"")),
    ("F", sound("dalsegno=\"s\"")),
    ("G", sound("coda=\"c\"")),
  ])
  assert_eq(melody(al_coda), [60, 62, 64, 65, 62, 64, 67])
  let al_fine = whole_notes([
    ("C", ""),
    ("D", sound("fine=\"yes\"")),
    ("E", sound("dacapo=\"yes\"")),
  ])
  assert_eq(melody(al_fine), [60, 62, 64, 60, 62])
}

# A chord symbol as the score writes it (its kind's text), else as its kind
# and degrees spell it; an sf an accent on the note after it; and a hairpin
# a dynamic ends with nothing more.
@test
fn chords_and_dynamics_read_as_kauai_writes_them() {
  let direction = |what| "<direction><direction-type>{what}</direction-type></direction>"
  let measure = [
    "<harmony><root><root-step>C</root-step></root><kind text=\"-7\">minor-seventh</kind></harmony>",
    direction("<wedge type=\"crescendo\"/>"),
    note("C", "half", 2),
    direction("<wedge type=\"stop\"/>"),
    direction("<dynamics><f/></dynamics>"),
    "<harmony><root><root-step>G</root-step></root><kind>dominant</kind><degree><degree-value>9</degree-value><degree-alter>-1</degree-alter><degree-type>add</degree-type></degree></harmony>",
    direction("<dynamics><sf/></dynamics>"),
    note("D", "half", 2),
  ].join("")
  let bar = reader.read(partwise([("", measure)])).score.sections[0].bars[0]
  assert_eq(bar.chords.map(|c| c.symbol), ["C-7", "C-7", "G7(b9)", "G7(b9)"])
  assert_eq(
    bar.melody.map(|it| it.has("direction") ? it.direction : it.marks),
    ["cresc", [], "f", ["accent"]],
  )
}

# A song read from a score gets a band: its single-note lines on the chip
# channels pulse, pulse2 and saw while they last, the lowest single line
# under the melody on the triangle, and the lines with chords and the rest
# on the external piano.
@test
fn the_band_plays_single_lines_on_chips_and_the_rest_on_the_piano() {
  let whole = |step| [("", note(step, "whole", 4))]
  let chord = [(
    "",
    note("C", "whole", 4) +
      note("E", "whole", 4, "<chord/>") +
      note("G", "whole", 4, "<chord/>"),
  )]
  let arrangement = song_of(score_of([
    ("Voice", whole("G")),
    ("Keys", chord),
    ("Alto", whole("F")),
    ("Tenor", whole("D")),
    ("Bass", whole("C")),
    ("Horn", whole("E")),
  ])).score.arrangement
  assert_eq(
    arrangement.split("\n").map(|l| l.to_string()),
    [
      "band Score \{",
      "  voice Melody  pulse  plays melody  vol 20  gap 1",
      "  voice Keys  external Ep  plays part Keys  poly  vol 38",
      "  voice Alto  pulse2  plays part Alto  vol 14  gap 1",
      "  voice Tenor  saw  plays part Tenor  vol 14  gap 1",
      "  voice Bass  triangle  plays part Bass  vol 14  gap 1",
      "  voice Horn  external Ep  plays part Horn  poly  vol 38",
      "}",
    ],
  )
}

# --- a score Kauai wrote, edited -------------------------------------------------

let EDITED = 'band Combo {
  voice Lead  pulse     plays melody            vol 20
  voice Echo  pulse2                            vol 9
  voice Bass  triangle  plays roots in E2..D#3  vol 18
  voice Alt   saw       plays part Alto         vol 10
  Echo echoes Lead  late 1/8  level 70%
  drum Kick   noise 120  len 1  vol 20  env 0 3 2  plays hits
}

groove A {
  Bass  1 - - -  5 - - -  1 - - -  5 - - -
  Kick  x... x... x... x...
}

groove Push {
  Bass  1 - 1 -  5 - 5 -  1 - 1 -  5 - 5 -
}

song Edit {
  tempo 120
  band Combo
  melody in C4..B4

  A x2
  B with echo in D
  mark Out
  A
}

section A {
  pickup  g8 a
  C     \bright=1.2 c4 d e f
  F     f2 \rit 90 a2
    Alto: c4 d e f
  G7    6[c8 d e f g \bright=0.9 a] g2
    hits: !x4 r r2
  C     \tempo c2. r4
    3rd: c1
}

section B {
  groove Push
  Am    a4 g f e
  Dm    d2. r4
}
'

# The score EDITED is written as: a pickup measure 0, then A's three times
# in measures 1-4, 5-8 and 11-14 and B's in 9-10.
let EDITED_SCORE = mx.write(Audio.Kauai.parse(EDITED))
let EDITED_TEXT = kau.write(Audio.Kauai.parse(EDITED))

# `text` with the first `from` in measure `number` of part `part` made `to`.
fn edited(text, part, number, from, to) {
  let (head, rest) = text.split_once("<part id=\"{part}\">")
  let (before, measure) = rest.split_once("<measure number=\"{number}\"")
  assert_true(measure.contains(from), "{part} measure {number} has {from}")
  "{head}<part id=\"{part}\">{before}<measure number=\"{number}\"" +
    measure.replace_first(from, to)
}

# The id of the part named `name` in score text `text`.
let id_of = |text, name| XML
  .parse(text)
  .find_all("part-list/score-part")
  .find(|p| p.text("part-name") == name)
  .attrs
  .id

# The lines of song text `text` that are not lines of EDITED's.
let new_lines = |text| text.lines().filter(|l| !EDITED_TEXT.lines().contains(l))

let BAND_STAVES = "the band's staves, where the band plays otherwise (Kauai plays it from the chords and grooves)"

# A measure the score shows otherwise is the score's, in the time it is in,
# with what a score does not show of the song's bar (a parameter, the tempo
# a rit. reaches); the times the score shows as the song plays them are the
# song's. A bar is written as most times play it.
@test
fn an_edited_measure_is_the_scores_in_its_time() {
  let second = song_of(edited(
    EDITED_SCORE,
    "P1",
    6,
    "<step>F</step>",
    "<step>E</step>",
  ))
  assert_eq(new_lines(second.text), ["    2nd: e2 \\rit 90 a"])
  assert_eq(second.dropped, [])
  let first = song_of(edited(
    EDITED_SCORE,
    "P1",
    1,
    "<step>D</step>",
    "<step>B</step>",
  ))
  assert_eq(
    new_lines(first.text),
    ["    1st: \\bright=1.2 c4 b e f"],
    "the time the score changes, the others as the song plays them",
  )
  let moved = song_of(edited(
    EDITED_SCORE,
    "P1",
    9,
    "<step>B</step>",
    "<step>A</step>",
  ))
  assert_eq(
    new_lines(moved.text),
    ["  Am            g4 g f e"],
    "back in the section's key, where `in D` plays it",
  )
  let part = song_of(edited(
    EDITED_SCORE,
    "P2",
    6,
    "<step>F</step>",
    "<step>G</step>",
  ))
  assert_eq(new_lines(part.text), ["    2nd Alto: c4 d e g"])
  let hit = song_of(edited(
    EDITED_SCORE,
    "P1",
    7,
    "<step>C</step>",
    "<step>D</step>",
  ))
  assert_eq(
    new_lines(hit.text),
    ["    2nd: 6[d8 d e f g \\bright=0.9 a] g2"],
    "the hits the song's bar has, and its parameter in the tuplet",
  )
  let tempo = song_of(EDITED_SCORE.replace_first(
    "<per-minute>120</per-minute>",
    "<per-minute>100</per-minute>",
  ))
  assert_eq(
    new_lines(tempo.text),
    ["  tempo 100"],
    "the tempo the score starts at",
  )
}

# The band's staves show what the band plays; the band plays from the chords
# and the grooves, and where the staves show otherwise, that is said.
@test
fn the_bands_staves_show_what_it_plays() {
  let bass = song_of(edited(
    EDITED_SCORE,
    id_of(EDITED_SCORE, "Bass"),
    1,
    "<step>C</step>",
    "<step>D</step>",
  ))
  assert_eq(bass.text, EDITED_TEXT)
  assert_eq(bass.dropped, ["{BAND_STAVES}: measure 1"])
  let chord = song_of(edited(
    EDITED_SCORE,
    "P1",
    2,
    "<root-step>F</root-step>",
    "<root-step>G</root-step>",
  ))
  assert_eq(new_lines(chord.text), ["    1st: G"])
  assert_eq(chord.dropped, ["{BAND_STAVES}: measure 2"])
}

# The staff a score Kauai wrote marks as its hits, else one named Hits, is
# the bars' hits: an edit of it is the score's, a score with no field of
# Kauai's has its hits too, a break's rest among them, and a part the song
# names Hits stays a part.
@test
fn the_hits_staff_is_the_bars_hits() {
  let id = id_of(EDITED_SCORE, "Hits")
  let plain = song_of(edited(EDITED_SCORE, id, 7, "<accent/>", ""))
  assert_eq(new_lines(plain.text), ["    2nd hits: x4 r r2"])
  assert_eq(plain.dropped, [])
  let unmarked = |text| Regex.replace_all(
    "<miscellaneous-field name=\"kauai-hits\">[^<]*</miscellaneous-field>",
    bare(text),
    "",
  )
  let raw = song_of(unmarked(mx.write(Audio.Kauai.parse(ONE_VOICE +
    'song S {
  tempo 120
  band B
  melody in C4..B4

  A x2
}

section A {
  C   c1
    hits:  x4. !x8~ x2
  C   c1
    2nd hits:  r1
}
'))))
  assert_eq(
    raw.text.split_once("section A \{\n")[1].lines(),
    [
      "  melody in C4..B4",
      "  C             c1",
      "    hits: x4. !x8~ x2",
      "",
      "  ending 1 \{",
      "    C             c1",
      "  }",
      "",
      "  ending 2 \{",
      "    C             c1",
      "      hits: r1",
      "  }",
      "}",
    ],
  )
  assert_eq(raw.dropped, [])
  # A part the song names Hits stays a part, beside the hits.
  let named = Audio.Kauai.parse('band B {
  voice Lead  pulse  plays melody     vol 20
  voice H     saw    plays part Hits  vol 10
}

song S {
  tempo 120
  band B
  melody in C4..B4

  A
}

section A {
  C   c1
    hits: x1
    Hits: e4 f g a
}
')
  let both = mx.write(named)
  assert_eq(song_of(both).text, kau.write(named))
  let lines = song_of(bare(both)).text.lines()
  assert_true(
    lines.contains("    Hits: e4 f g a") && lines.contains("    hits: x1"),
    "{lines}",
  )
}

# A score Kauai writes with a jump back reads as the song's order, its segno,
# coda and words being the jumps it reads, not something left out.
@test
fn a_jump_back_reads_as_the_order_it_plays() {
  let raw = song_of(bare(mx.write(Audio.Kauai.parse(ONE_VOICE +
    'song S {
  tempo 120
  band B
  melody in C4..B4

  A
  B
  C
  B
  D
}

section A {
  C   c1
}

section B {
  F   f1
}

section C {
  G   g1
}

section D {
  C   c1
}
'))))
  assert_true(raw.text.contains("\n  A\n  B\n  C\n  B\n  D\n}"), raw.text)
  assert_eq(raw.dropped, [])
}

# A time that no longer fits its section is a section of its own; a pickup
# is played one way; and a band that does not play the score, a song text
# that does not read, or an order the score changes, is not used.
@test
fn what_no_longer_fits_the_song_is_the_scores() {
  # A's 2nd time a measure shorter, the measures after it counted again, as
  # a score editor does.
  let shorter = song_of(without_measure(EDITED_SCORE, 7, 14))
  assert_true(
    shorter.text.contains("\n  A\n  A2\n  B with echo in D\n"),
    shorter.text,
  )
  assert_eq(
    block(shorter.text, "section A2"),
    [
      "section A2 \{",
      "  melody in C4..B4",
      "  part Alto in C4..B4",
      "  pickup  g8 a",
      "  groove A",
      "  C             c4 d e f",
      "  F             f2 a",
      "    Alto: c4 d e f",
      "  C             \\tempo c2. r4",
      "}",
    ],
    "the score's measures, the groove A plays by its name",
  )
  assert_true(
    block(shorter.text, "section A ")
      .join("\n")
      .ends_with("\\tempo c2. r4\n    2nd: c1\n}"),
    "A's 3rd time is its 2nd now",
  )
  assert_eq(
    shorter.dropped,
    [
      "a rit. or accel. that says no tempo it reaches: measure 6",
      "a time through a section that no longer fits it, a section of its own (its parameters left out): measure 5 (A as A2)",
    ],
  )
  let key = song_of(edited(
    EDITED_SCORE,
    "P1",
    11,
    "<attributes>",
    "<attributes><key><fifths>2</fifths></key>",
  ))
  assert_eq(
    new_lines(key.text).filter(|l| l.starts_with("section")),
    ["section A2 key D \{"],
    "in the key the score shows",
  )
  let coda = song_of(edited(
    EDITED_SCORE,
    "P1",
    11,
    "<rehearsal>A</rehearsal>",
    "<rehearsal>Coda</rehearsal>",
  ))
  assert_true(
    coda.text.contains("  mark Out\n  Coda\n}") &&
      coda.text.contains("section Coda \{"),
    coda.text,
  )
  let pickup = song_of(edited(
    EDITED_SCORE,
    "P1",
    10,
    "<step>A</step>",
    "<step>B</step>",
  ))
  assert_eq(pickup.text, EDITED_TEXT)
  assert_eq(
    pickup.dropped,
    ["a pickup the score plays otherwise from time to time, played as the first time: measure 10"],
  )
  let renamed = song_of(EDITED_SCORE.replace_first(
    "<part-name>Alto</part-name>",
    "<part-name>Flute</part-name>",
  ))
  assert_true(renamed.text.contains("plays part Flute") &&
    !renamed.text.contains("Combo"))
  assert_true(
    renamed.text.contains("    hits: !x4 r r2\n"),
    "the hits stay with a band made for the lines",
  )
  assert_true(
    renamed.dropped.contains("the song's band, which does not play the score (it plays no part Flute): a band made for its lines: the score"),
    "{renamed.dropped}",
  )
  let unread = song_of(EDITED_SCORE.replace_first(
    "song Edit \{",
    "song Edit \{\n  bogus",
  ))
  assert_true(unread.text.contains("band Score"))
  assert_true(
    unread.dropped[0].starts_with("the song's Kauai text, which does not read (line 20: "),
    "{unread.dropped}",
  )
  let reordered = song_of(edited(
    EDITED_SCORE,
    "P1",
    11,
    "<rehearsal>A</rehearsal>",
    "<words>here</words>",
  ))
  assert_true(reordered.text.contains("band Combo"))
  assert_true(
    reordered.dropped.contains("the order the song plays its sections in, which the score changes: the sections as the score has them: the score"),
    "{reordered.dropped}",
  )
  # B's first bar in 5/4, whose groove Push no longer steps through.
  let time = |beats| "><attributes><time><beats>{beats}</beats><beat-type>4</beat-type></time></attributes>"
  let longer = song_of(edited(
    edited(EDITED_SCORE, "P1", 9, ">", time(5)),
    "P1",
    10,
    ">",
    time(4),
  ).replace_first(
    "<alter>1</alter>\n          <octave>4</octave>\n        </pitch>\n        <duration>480</duration>\n        <voice>1</voice>\n        <type>quarter</type>\n      </note>",
    "<alter>1</alter>\n          <octave>4</octave>\n        </pitch>\n        <duration>480</duration>\n        <voice>1</voice>\n        <type>quarter</type>\n      </note><note><rest/><duration>480</duration><voice>1</voice><type>quarter</type></note>",
  ))
  assert_true(longer.text.contains("band Score"), longer.text)
  assert_true(
    longer.dropped.any(|d| d.starts_with("the song's band, which does not play the score (line ")),
    "{longer.dropped}",
  )
}

let ONE_VOICE = 'band B {
  voice V  pulse  plays melody  vol 9
}

'

# Song `song` (its song and sections) written as a score by a band of one
# voice.
let small = |song| mx.write(Audio.Kauai.parse(ONE_VOICE + song))

# Score `text` without measure `number`, the measures after it up to `last`
# counted again, as a score editor does.
fn without_measure(text, number, last) {
  let cut = Regex.replace_all(
    "(?s)<measure number=\"{number}\">.*?</measure>\\s*",
    text,
    "",
  )
  iota(
    number + 1,
    last + 1,
  ).reduce(
    cut,
    |t, n| t.replace("<measure number=\"{n}\"", "<measure number=\"{n - 1}\""),
  )
}

# The lines of song text `text` from the one that starts with `head` to the
# next blank line.
let block = |text, head| text
  .split("\n\n")
  .find(|b| b.starts_with(head))
  .lines()

# A `%` says the bars before it again until the score shows it or them
# otherwise; then the bar is written out.
@test
fn a_repeat_sign_says_the_bars_before_it_again_until_they_differ() {
  let repeated = small('song R {
  tempo 120
  band B
  melody in C4..B4

  A
}

section A {
  C  c4 d e f
  %
  G  g1
}
')
  let bars = |text| block(text, "section A").slice(2, 5)
  let own = song_of(edited(
    repeated,
    "P1",
    2,
    "<step>D</step>",
    "<step>B</step>",
  ))
  assert_eq(
    bars(own.text),
    [
      "  C             c4 d e f",
      "  C             c4 b e f",
      "  G             g1",
    ],
  )
  let source = song_of(edited(
    repeated,
    "P1",
    1,
    "<step>D</step>",
    "<step>B</step>",
  ))
  assert_eq(
    bars(source.text),
    [
      "  C             c4 b e f",
      "  C             c4 d e f",
      "  G             g1",
    ],
  )
  let both = song_of(edited(
    edited(repeated, "P1", 1, "<step>D</step>", "<step>B</step>"),
    "P1",
    2,
    "<step>F</step>",
    "<step>G</step>",
  ))
  assert_eq(
    bars(both.text),
    [
      "  C             c4 b e f",
      "                c4 d e g",
      "  G             g1",
    ],
    "both read otherwise, and otherwise from each other",
  )
  # A `%%` is its two bars together, written out where either of them, or
  # either it repeats, reads otherwise.
  let twice = small('song R {
  tempo 120
  band B
  melody in C4..B4

  A
}

section A {
  C  c4 d e f
  G  g4 a b a
  %%
  F  f1
}
')
  let body = |text| block(text, "section A").slice(2, 7)
  let at = |number, from, to| body(song_of(edited(
    twice,
    "P1",
    number,
    from,
    to,
  )).text)
  assert_eq(
    at(3, "<step>D</step>", "<step>B</step>"),
    [
      "  C             c4 d e f",
      "  G             g4 a b a",
      "  C             c4 b e f",
      "  G             g4 a b a",
      "  F             f1",
    ],
  )
  assert_eq(
    at(4, "<step>A</step>", "<step>C</step>")[2..4],
    ["  C             c4 d e f", "  G             g4 c b a"],
  )
  assert_eq(
    at(2, "<step>B</step>", "<step>C</step>")[1..4],
    [
      "  G             g4 a c a",
      "  C             c4 d e f",
      "  G             g4 a b a",
    ],
  )
}

# A time that no longer fits its section is a section as the score shows
# it: in the key the score shows (the song's key the song's still), one
# for the times it shows the same, without a pickup the measure before it
# no longer leaves room for; and a report that is the score's own is said
# where the measures are counted again.
@test
fn a_time_that_no_longer_fits_is_as_the_score_shows_it() {
  let two_keys = small('song K {
  tempo 120
  band B
  melody in C4..B4

  A
  B in D
}

section A {
  C  c2. r4
}

section B {
  pickup  d4
  C  e1
}
')
  let keyed = song_of(edited(
    two_keys,
    "P1",
    1,
    "<fifths>0</fifths>",
    "<fifths>1</fifths>",
  ))
  assert_eq(block(keyed.text, "song"), ["song K \{", "  tempo 120", "  band B"])
  assert_true(keyed.text.contains("\n  A2\n  B in D\n"), keyed.text)
  assert_eq(block(keyed.text, "section A2")[0], "section A2 key G \{")
  assert_eq(
    block(keyed.text, "section B")[2..4],
    ["  pickup  d4", "  C             e1"],
  )
  let moved = song_of(edited(
    two_keys,
    "P1",
    2,
    "<fifths>2</fifths>",
    "<fifths>4</fifths>",
  ))
  assert_true(moved.text.contains("\n  A\n  B2\n}"), "no `in`: {moved.text}")
  assert_eq(
    block(moved.text, "section B2").slice(0, 4).filter(|l| !l.contains(" in ")),
    ["section B2 key E \{", "  pickup  e4", "  D             f#1"],
    "the notes as the score shows them, where `in D` moved them",
  )
  let folded = song_of(without_measure(
    small('song F {
  tempo 120
  band B
  melody in C4..B4

  A x2
  B
}

section A {
  C  c1
  F  f1
  G  g1
}

section B {
  C  e1
}
'),
    2,
    4,
  ))
  assert_true(folded.text.contains("\n  A2 x2\n  B\n"), folded.text)
  assert_true(!folded.text.contains("A22"), folded.text)
  # The same with a pickup, which the first time's last bar holds.
  let led = song_of(without_measure(
    small('song P {
  tempo 120
  band B
  melody in C4..B4

  A x2
  B
}

section A {
  pickup  g4
  C  c1
  F  f1
  G  g2 r2
}

section B {
  C  e1
}
'),
    2,
    5,
  ))
  assert_true(led.text.contains("\n  A2 x2\n  B\n"), led.text)
  assert_eq(
    block(led.text, "section A2")[2..5],
    ["  pickup  g4", "  C             c1", "  G             g2 r"],
  )
  let picked = small('song P {
  tempo 120
  band B
  melody in C4..B4

  A x2
}

section A {
  pickup  g4
  C  c1
  G  g2 r2
}
')
  # The first time's last rest and the pickup in it, a half note A.
  let over = song_of(Regex.replace_first(
    "(?s)(<measure number=\"2\">.*?)<note>\\s*<rest/>.*?</note>\\s*<note>.*?</note>",
    picked,
    "$1<note><pitch><step>A</step><octave>4</octave></pitch><duration>960</duration><voice>1</voice><type>half</type></note>",
  ))
  Audio.Kauai.parse(over.text)
  assert_true(over.text.contains("\n  A\n  A2\n}"), over.text)
  assert_eq(
    block(over.text, "section A ")[2..],
    ["  pickup  g4", "  C             c1", "  G             g2 a", "}"],
  )
  assert_eq(
    block(over.text, "section A2")[2..],
    ["  C             c1", "  G             g2 r", "}"],
  )
  let ritted = without_measure(
    small('song T {
  tempo 120
  band B
  melody in C4..B4

  A
  B
}

section A {
  C  c1
  C  c1
  F  \rit 90 f1
}

section B {
  C  \tempo e1
  C  e1
}
'),
    2,
    5,
  )
  let (head, rest) = ritted.split_once("<measure number=\"3\">")
  let said = song_of(head +
    "<measure number=\"3\"><direction><direction-type><words>rit.</words></direction-type></direction>" +
    rest)
  assert_true(
    said.dropped.contains("a rit. or accel. that says no tempo it reaches: measure 2, measure 3"),
    "{said.dropped}",
  )
}
