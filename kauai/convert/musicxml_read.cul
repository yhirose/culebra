# A MusicXML score as a Kauai song's score, the data Audio.Kauai.parse
# gives (kauai/convert/kau.cul writes it as Kauai text). Each voice of each
# part is a line: the first part's first voice is the melody, every other
# line a part of the song, and a staff named Hits the bars' hits. The parts
# a score marks as a Kauai band's own (kauai/convert/musicxml.cul writes
# the mark) are left out, as what the band plays. Rehearsal marks, repeat signs, key changes, segnos and codas
# make the sections, and D.S., D.C., To Coda and Fine the order the song
# plays them in; the song is given a band that plays its lines. A score
# Kauai wrote reads as the song it carries (`kauai-song`), with the
# measures the score shows otherwise read from the score.
#
# What a score holds that Kauai does not play is an error; what Kauai leaves
# out or changes a little (lyrics, words, a chord symbol it spells another
# way, a slur cut where a section ends) is said in `dropped`.

import music from './music.cul'
import mx from './musicxml.cul'
import kau from './kau.cul'

let WHOLE = music.WHOLE
let QUARTER = music.QUARTER
let units = music.units
let length_of = music.length_of
let TYPES = {whole: 1, half: 2, quarter: 4, eighth: 8, "16th": 16, "32nd": 32}
let LEVELS = {
  ppp: "pp",
  pp: "pp",
  p: "p",
  mp: "mp",
  mf: "mf",
  f: "f",
  ff: "ff",
  fff: "ff",
}
# Dynamics that accent one note.
let SFORZANDI = ["sf", "sfz", "sffz", "fz", "rf", "rfz"]
# MusicXML's articulations as Kauai names them.
let ARTICULATIONS = music
  .ARTICULATIONS
  .keys()
  .map(|k| (music.ARTICULATIONS[k], k))
  .to_object()
# Notations that change how a note sounds, which Kauai does not play.
let UNPLAYED = ["ornaments", "glissando", "slide", "tremolo"]
# <harmony>'s kinds, as Kauai spells them.
let KINDS = {
  major: "",
  minor: "m",
  augmented: "aug",
  diminished: "dim",
  dominant: "7",
  "major-seventh": "maj7",
  "minor-seventh": "m7",
  "diminished-seventh": "dim7",
  "augmented-seventh": "7#5",
  "half-diminished": "m7b5",
  "major-minor": "mmaj7",
  "major-sixth": "6",
  "minor-sixth": "m6",
  "dominant-ninth": "9",
  "major-ninth": "maj9",
  "minor-ninth": "m9",
  "dominant-11th": "9(11)",
  "minor-11th": "m11",
  "dominant-13th": "13",
  "major-13th": "maj9(13)",
  "minor-13th": "m11(13)",
  "suspended-second": "sus2",
  "suspended-fourth": "sus4",
}
let MAJOR = [
  "Cb",
  "Gb",
  "Db",
  "Ab",
  "Eb",
  "Bb",
  "F",
  "C",
  "G",
  "D",
  "A",
  "E",
  "B",
  "F#",
  "C#",
]
let MINOR = [
  "Ab",
  "Eb",
  "Bb",
  "F",
  "C",
  "G",
  "D",
  "A",
  "E",
  "B",
  "F#",
  "C#",
  "G#",
  "D#",
  "A#",
]
# What is said of a rit. or an accel. without the tempo it reaches.
let NO_TEMPO = "a rit. or accel. that says no tempo it reaches"
# Words for a rit. or an accel.
let TEMPO_CHANGES = ["rit.", "rit", "ritard.", "rall.", "accel."]
let CAPITALS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
let ALNUM = CAPITALS + CAPITALS.lower() + "0123456789"

# --- the file ------------------------------------------------------------------

# Text a score may be saved in UTF-16 (after its byte order mark), as UTF-8.
fn as_utf8(data) {
  let head = data.slice(0, 2).bytes().collect()
  return data if head != [0xfe, 0xff] && head != [0xff, 0xfe]
  Encoding.utf16.decode(data).replace('encoding="UTF-16"', 'encoding="UTF-8"')
}

# A score file's bytes as its MusicXML: the file's own, or the score an .mxl
# archive's container names.
fn score_text(data) {
  return as_utf8(data) if !data.starts_with("PK")
  let zip = Dir.zip(bytes: data)
  let root = zip.is_file("META-INF/container.xml")
    ? XML
      .parse(as_utf8(zip.read("META-INF/container.xml")))
      .find(".//*:rootfile")
    : nil
  let name = root?.attrs?.get("full-path", nil) ??
    zip
      .files()
      .find(|k| !k.starts_with("META-INF") &&
        (k.ends_with(".xml") || k.ends_with(".musicxml")))
  throw "kauai convert: the archive holds no score" if name == nil
  as_utf8(zip.read(name))
}

# --- small things ----------------------------------------------------------------

let elements = |el| el.find_all("*")
let text_at = |el, path| el.text(path)?.trim()
let number_at = |el, path| to_long(text_at(el, path) ?? "0")
# A <pitch> as {step, alter, octave}.
let pitch_at = |el| {
  step: text_at(el, "step"),
  alter: Math.round(to_float(text_at(el, "alter") ?? "0")),
  octave: number_at(el, "octave"),
}
# The text of the score's <miscellaneous-field> named `name`.
let field = |doc, name| doc
  .find("identification/miscellaneous/miscellaneous-field[@name='{name}']")
  ?.text()

# A name Kauai reads as one: capitalized words run together, their letters
# without accents; `fallback` when no letter starts it.
fn name_of(text, fallback) {
  let words = text
    .normalize("NFD")
    .split_whitespace()
    .map(|w| w
      .iter()
      .map(|ch| ch.to_string())
      .filter(|ch| ALNUM.contains(ch))
      .collect()
      .join(""))
    .filter(|w| !w.empty())
  let joined = words
    .map(|w| w.slice(0, 1).upper() + w.slice(1, w.size()))
    .join("")
  joined.empty() || !CAPITALS.contains(joined.slice(0, 1)) ? fallback : joined
}

# A key from <key>: its fifths and mode, as Kauai names it.
fn key_name(k) {
  let fifths = Math.max(-7, Math.min(7, number_at(k, "fifths")))
  text_at(k, "mode") == "minor" ? MINOR[fifths + 7] + "m" : MAJOR[fifths + 7]
}

# The rests that fill `len` units from `at`, each the longest plain value
# that fits and starts on a multiple of its length.
fn rests_for(at, len) {
  let out = []
  mut p = at
  while p < at + len {
    let v = [
      1, 2, 4, 8, 16, 32,
    ].find(|n| WHOLE / n <= at + len - p && p % (WHOLE / n) == 0)
    throw "kauai convert: {at + len - p} units of rest at {p} are not a note value Kauai writes" if v ==
      nil
    out.push({rest: true, value: v, dots: 0, marks: []})
    p += WHOLE / v
  }
  out
}

# --- chords --------------------------------------------------------------------

# A <root> or a <bass> (`tag`) as a note name: "Bb".
fn note_name(el, tag) {
  let a = Math.round(to_float(text_at(el, "{tag}-alter") ?? "0"))
  text_at(el, "{tag}-step") + music.accidental(a)
}

let CHORD_BAND = 'band B {
  voice V  pulse  plays melody  vol 9
}

'

let CHORD_SONG = 'song S {
  tempo 120
  band B
  melody in C4..B4

  A
}

section A {
  C'

# Whether Kauai reads `quality` after a root as a chord symbol, with the
# qualities a song's `voicings` blocks add.
let reads_as_chord = music.remembered(fn (asked) {
  let (voicings, quality) = asked
  try {
    Audio.Kauai.parse(voicings +
      CHORD_BAND +
      CHORD_SONG +
      quality +
      "  c1\n}\n")
    true
  } catch _ {
    false
  }
})

# <harmony> `h` as a chord ({symbol, root, quality, bass}, nil for N.C.), and
# what of it Kauai spells another way, if anything, with the qualities
# `voicings` adds.
fn chord_of(h, voicings) {
  let kind = h.find("kind")
  let k = kind == nil ? "major" : kind.text().trim()
  return (nil, nil) if k == "none" || h.find("root") == nil
  let root = note_name(h.find("root"), "root")
  let bass = h.find("bass") == nil ? nil : note_name(h.find("bass"), "bass")
  let chord = |q| music.chord(root, q, bass)
  let written = kind?.attrs?.get("text", nil)
  if written != nil && reads_as_chord((voicings, written)) {
    return (chord(written), nil)
  }
  let base = KINDS.get(k, nil)
  let tensions = h.find_all("degree").filter(|d| text_at(d, "degree-type") !=
    "subtract").map(fn (d) {
    let a = to_long(text_at(d, "degree-alter") ?? "0")
    (a > 0 ? "#" : a < 0 ? "b" : "") + text_at(d, "degree-value")
  })
  let quality = (base ?? "") +
    (tensions.empty() ? "" : "(" + tensions.join(",") + ")")
  if base != nil &&
      reads_as_chord((voicings, quality)) &&
      h.find("degree[degree-type='subtract']") == nil {
    return (
      chord(quality),
      written == nil || written == quality ? nil : written,
    )
  }
  (chord(base ?? ""), written ?? k)
}

# Every measure's chords, one a beat, from every part's chord symbols (with
# the qualities `voicings` adds); a measure without one keeps the chord
# before it.
fn chords_of(ms, parts, report, voicings) {
  mut sounding = nil
  iota(ms.size()).map(fn (mi) {
    let m = ms[mi]
    let beat = 4 * m.res / m.meter.value
    let named = parts.flat_map(|p| p.measures[mi].harmonies).sorted_by(|h| h.at)
    iota(m.meter.beats).map(fn (k) {
      for h in named.filter(|h| (k * beat..(k + 1) * beat).contains(h.at)) {
        report(
          "a chord symbol off its beat, moved to the beat",
          "measure {m.number}",
        ) if h.at != k * beat
        let (c, spelled) = chord_of(h.harmony, voicings)
        report(
          "a chord symbol Kauai spells another way ({spelled})",
          "measure {m.number}",
        ) if spelled != nil
        sounding = c
      }
      sounding
    })
  })
}

# --- a part's measures -----------------------------------------------------------

# What <sound> `s` says of the form onto `bar`: a segno or a coda the
# measure is (by its name), or a jump it ends with (D.S. to a segno, D.C., to
# a coda, or Fine).
fn jumps(s, bar) {
  return nil if s == nil
  bar.segno = s.attrs.get("segno", bar.segno)
  bar.coda = s.attrs.get("coda", bar.coda)
  bar.dalsegno = s.attrs.get("dalsegno", bar.dalsegno)
  bar.tocoda = s.attrs.get("tocoda", bar.tocoda)
  bar.dacapo = bar.dacapo || s.attrs.get("dacapo", "no") == "yes"
  bar.fine = bar.fine || s.attrs.has("fine")
}

# A part's measures, each {number, implicit, meter, key, len, content, voices
# (each voice's notes and rests in order, a voice by its <voice>),
# directions, harmonies, rehearsal, swing, forward, backward, ending (the
# numbers of the ending it starts), ending_ends, key_change, segno, coda,
# dalsegno, tocoda, dacapo, fine, res}: times from the measure's start in
# ticks, `res` of them to a quarter, which every duration the part writes is
# a whole number of (a tuplet's notes need not be a whole number of Kauai's
# units). On a staff of `hits`, an unpitched note is a hit, read as the B4
# it is written on.
fn read_measures(part, report, hits = false) {
  let res = part
    .find_all("measure/attributes/divisions")
    .map(|d| to_long(d.text().trim()))
    .reduce(QUARTER, |a, b| a / music.gcd(a, b) * b)
  mut divisions = 1
  mut meter = {beats: 4, value: 4}
  mut key = nil
  let out = []
  for m in part.find_all("measure") {
    mut at = 0
    mut end = 0
    let voices = {}
    let order = []
    mut previous = nil
    let graces = {}
    let grace_slurs = {}
    let bar = {
      number: m.attrs.get("number", "?"),
      implicit: m.attrs.get("implicit", "no") == "yes",
      directions: [],
      harmonies: [],
      mut rehearsal: nil,
      mut swing: nil,
      mut forward: false,
      mut backward: nil,
      mut ending: nil,
      mut ending_ends: false,
      mut key_change: nil,
      mut segno: nil,
      mut coda: nil,
      mut dalsegno: nil,
      mut tocoda: nil,
      mut dacapo: false,
      mut fine: false,
    }
    let where = "measure {bar.number}"
    let ticks = |el| number_at(el, "duration") * res / divisions
    # An offset may be a fraction of a division, to place a sign a little.
    let offset_of = |el| el.find("offset") == nil
      ? 0
      : Math.round(to_float(text_at(el, "offset")) * res / divisions)
    for c in elements(m) {
      match c.tag {
        "attributes" => {
          divisions = to_long(text_at(c, "divisions") ?? "{divisions}")
          if c.find("time") != nil {
            meter = {
              beats: number_at(c, "time/beats"),
              value: number_at(c, "time/beat-type"),
            }
          }
          if c.find("key") != nil {
            let named = key_name(c.find("key"))
            bar.key_change = named if named != key
            key = named
          }
        },
        "harmony" => bar.harmonies.push({at: at + offset_of(c), harmony: c}),
        "direction" => {
          let t = at + offset_of(c)
          let staff = text_at(c, "staff") ?? "1"
          jumps(c.find("sound"), bar)
          for dt in c.find_all("direction-type") {
            for d in elements(dt) {
              bar.directions.push({at: t, staff, el: d, sound: c.find("sound")})
            }
          }
          let sw = c.find("sound/swing")
          if sw != nil {
            bar.swing = sw.find("straight") != nil
              ? "straight"
              : {
                unit: TYPES.get(text_at(sw, "swing-type") ?? "eighth", 8),
                first: number_at(sw, "first"),
                second: number_at(sw, "second"),
              }
          }
        },
        "backup" => at -= ticks(c),
        "forward" => {
          at += ticks(c)
          end = Math.max(end, at)
        },
        "barline" => {
          bar.forward = true if c.find("repeat[@direction='forward']") != nil
          let back = c.find("repeat[@direction='backward']")
          bar.backward = to_long(back.attrs.get("times", "2")) if back != nil
          let e = c.find("ending")
          if e != nil {
            if e.attrs.get("type", "") == "start" {
              bar.ending = e
                .attrs
                .get("number", "1")
                .split(",")
                .map(|x| x.trim().to_string())
                .filter(|x| !x.empty())
            } else {
              bar.ending_ends = true
            }
          }
          report(
            "a segno or a coda sign",
            where,
          ) if c.find("segno") != nil || c.find("coda") != nil
          jumps(c.find("sound"), bar)
        },
        "sound" => jumps(c, bar),
        "note" => {
          let voice = text_at(c, "voice") ?? "1"
          continue if c.find("cue") != nil
          let pitch = c.find("pitch")
          let unpitched = c.find("unpitched") != nil
          throw "kauai convert: {where}: an unpitched note (a drum) is not read; a drum part goes in a Kauai band, and hits on a staff named Hits" if unpitched &&
            !hits
          let tie = c.find("tie[@type='start']") != nil
          let p = cond {
            unpitched => {step: "B", alter: 0, octave: 4, tie},
            pitch == nil => nil,
            _ => {...pitch_at(pitch), tie},
          }
          let slurs = |type| c
            .find_all("notations/slur")
            .filter(|s| s.attrs.get("type", "") == type)
            .size()
          if c.find("grace") != nil {
            graces[voice] = [
              ...graces.get(voice, []),
              {step: p.step, alter: p.alter, octave: p.octave},
            ] if p != nil
            # A slur from a grace note starts with the note it leads to.
            grace_slurs[voice] = grace_slurs.get(voice, 0) + slurs("start")
            continue
          }
          for kind in UNPLAYED {
            throw "kauai convert: {where}: Kauai does not play a note's {kind}" if c.find("notations/{kind}") !=
              nil
          }
          report("lyrics", where) if c.find("lyric") != nil
          if c.find("chord") != nil && previous != nil {
            previous.pitches.push(p) if p != nil
            continue
          }
          let len = ticks(c)
          let tm = c.find("time-modification")
          let tuplet_el = |type| c
            .find_all("notations/tuplet")
            .filter(|t| t.attrs.get("type", "") == type)
          let ev = {
            at,
            len,
            rest: p == nil,
            # A rest the length of the measure, which may say no value.
            whole: c.find("rest[@measure='yes']") != nil ||
              p == nil && c.find("type") == nil,
            pitches: p == nil ? [] : [p],
            type: text_at(c, "type"),
            dots: c.find_all("dot").size(),
            ratio: tm == nil
              ? {actual: 1, normal: 1}
              : {
                actual: number_at(tm, "actual-notes"),
                normal: number_at(tm, "normal-notes"),
              },
            starts: tuplet_el("start").map(|t| {
              actual: t.find("tuplet-actual/tuplet-number") == nil
                ? nil
                : number_at(t, "tuplet-actual/tuplet-number"),
              normal: t.find("tuplet-normal/tuplet-number") == nil
                ? nil
                : number_at(t, "tuplet-normal/tuplet-number"),
            }),
            stops: tuplet_el("stop").size(),
            marks: [
              ...c.find_all("notations/articulations/*").map(|a| ARTICULATIONS.get(a.tag, nil)).filter(|x| x != nil),
              ...(c.find("notations/fermata") == nil ? [] : ["fermata"]),
            ],
            slur_starts: slurs("start") + grace_slurs.get(voice, 0),
            slur_stops: slurs("stop"),
            arpeggio: c.find("notations/arpeggiate") != nil,
            graces: p == nil ? [] : graces.get(voice, []),
            staff: text_at(c, "staff") ?? "1",
            shown: c.attrs.get("print-object", "yes") != "no",
          }
          graces[voice] = []
          grace_slurs[voice] = 0
          if !voices.has(voice) {
            voices[voice] = []
            order.push(voice)
          }
          voices[voice].push(ev)
          previous = ev
          at += len
          end = Math.max(end, at)
        },
        _ => nil,
      }
    }
    let r = bar.directions.find(|d| d.el.tag == "rehearsal")
    bar.rehearsal = r?.el?.text()?.trim()
    out.push({
      ...bar,
      meter,
      key,
      len: meter.beats * 4 * res / meter.value,
      content: end,
      voices: order.map(|v| {voice: v, events: voices[v]}),
      res,
    })
  }
  out
}

# --- a line's items --------------------------------------------------------------

# Direction `d` ({at, el, sound}) as the items it writes, through `report`
# for what it leaves out.
fn direction_items(d, where, report) {
  let el = d.el
  match el.tag {
    "dynamics" => elements(el).flat_map(fn (x) {
      return [{direction: LEVELS[x.tag], tempo: nil}] if LEVELS.has(x.tag)
      return [{accent: true}] if SFORZANDI.contains(x.tag)
      throw "kauai convert: {where}: the dynamic {x.tag} is not one Kauai plays"
    }),
    "wedge" => match el.attrs.get("type", "") {
      "crescendo" => [{direction: "cresc", tempo: nil}],
      "diminuendo" => [{direction: "dim", tempo: nil}],
      "stop" => [{direction: "!", tempo: nil}],
      _ => [],
    },
    "metronome" => {
      let unit = TYPES.get(text_at(el, "beat-unit") ?? "", nil)
      let per = try {
        to_float(text_at(el, "per-minute"))
      } catch _ {
        nil
      }
      if unit == nil || per == nil {
        # A mark Kauai does not write plays at its <sound>'s tempo, if any.
        let tempo = d.sound?.attrs?.get("tempo", nil)
        report(
          "a metronome mark that says no tempo Kauai writes",
          where,
        ) if tempo == nil
        return tempo == nil
          ? []
          : [{direction: "tempo", tempo: music.tempo_of(tempo)}]
      }
      [{
        direction: "tempo",
        tempo: {value: unit, dots: el.find_all("beat-unit-dot").size(), per},
      }]
    },
    "words" => {
      let w = el.text().trim().lower()
      cond {
        w.starts_with("swing") || w == "straight" => [],
        w == "a tempo" => [{direction: "tempo", tempo: nil}],
        TEMPO_CHANGES.contains(w) => {
          report(NO_TEMPO, where)
          []
        },
        _ => {
          report("words", where)
          []
        },
      }
    },
    "rehearsal" | "dashes" => [],
    "segno" | "coda" => {
      report("a segno or a coda sign", where)
      []
    },
    "octave-shift" => throw "kauai convert: {where}: an octave shift (8va) is not read yet",
    _ => {
      report(el.tag, where)
      []
    },
  }
}

# A ratio {actual, normal} in lowest terms.
fn reduced(actual, normal) {
  let d = music.gcd(actual, normal)
  {actual: actual / d, normal: normal / d}
}

# A line's notes and rests in a measure `len` ticks long (`events`, in
# order; `res` ticks to a quarter) as Kauai items, its directions (`marks`,
# {at, items}) before the note at or after them, and rests where it plays
# nothing. `state` ({depth, wedge}) carries the line's slurs and hairpins
# from measure to measure: how many slurs it is in, and whether a hairpin is
# going.
fn items_of(events, len, res, marks, state, where, report) {
  # Ticks as Kauai's units, which a rest has to be a whole number of.
  let in_units = fn (ticks) {
    throw "kauai convert: {where}: a rest Kauai does not write" if ticks *
      QUARTER %
      res !=
      0
    ticks * QUARTER / res
  }
  # Each level of tuplets: the ratio its notes play in (`ratio`, all the
  # levels' together), its own (`tuplet`), and whether the score gave it no
  # bracket.
  let stack = [{
    ratio: {actual: 1, normal: 1},
    items: [],
    tuplet: nil,
    implicit: false,
  }]
  let top = || stack[-1]
  let put = |it| top().items.push(it)
  # A tuplet's ratio as Kauai gives one written without it: its notes in
  # the time of as many as it can, as `3[` writes it.
  let close = fn () {
    let level = stack.pop()
    let own = level.tuplet
    let count = level.items.filter(music.lasts).size()
    put({
      tuplet: count * own.normal % own.actual == 0
        ? {actual: count, normal: count * own.normal / own.actual}
        : own,
      items: level.items,
    })
  }
  let open = fn (ratio, tuplet, implicit) {
    stack.push({ratio, items: [], tuplet, implicit})
  }
  let close_implicit = fn () {
    while stack.size() > 1 && top().implicit {
      close()
    }
  }
  mut accent = false
  mut t = 0
  mut k = 0
  let marks_until = fn (at) {
    while k < marks.size() && marks[k].at <= at {
      for it in marks[k].items {
        cond {
          it.has("accent") => accent = true,
          it.direction == "!" => {
            put(it) if state.wedge
            state.wedge = false
          },
          _ => {
            state.wedge = it.direction == "cresc" ||
              it.direction == "dim" ||
              state.wedge && !LEVELS.values().contains(it.direction)
            put(it)
          },
        }
      }
      k += 1
    }
  }
  let rests_to = fn (to) {
    throw "kauai convert: {where}: a gap inside a tuplet" if to > t &&
      stack.size() > 1
    rests_for(in_units(t), in_units(to - t)).for_each(put)
    t = Math.max(t, to)
  }
  for e in events {
    throw "kauai convert: {where}: notes in one voice overlap" if e.at < t
    if e.at > t {
      close_implicit()
      rests_to(e.at)
    }
    marks_until(e.at)
    if e.whole {
      rests_to(e.at + e.len)
      continue
    }
    let value = TYPES.get(e.type ?? "", nil)
    throw "kauai convert: {where}: a {e.type ?? "note with no type"} (Kauai writes whole notes to 32nds)" if value ==
      nil
    let v = {value, dots: e.dots}
    # The ratio the note plays in, from its value and its length: its
    # tuplets' together.
    let ratio = reduced(units(v) * res, e.len * QUARTER)
    # The tuplets it starts, each the ratio its bracket says or what is left
    # of the note's own; one the score gives no bracket for where the ratio
    # changes.
    for s in e.starts {
      let r = top().ratio
      let own = s.actual != nil && s.normal != nil
        ? reduced(s.actual, s.normal)
        : reduced(ratio.actual * r.normal, ratio.normal * r.actual)
      open(reduced(r.actual * own.actual, r.normal * own.normal), own, false)
    }
    if top().ratio != ratio {
      close_implicit()
      let r = top().ratio
      open(
        ratio,
        reduced(ratio.actual * r.normal, ratio.normal * r.actual),
        true,
      )
    }
    throw "kauai convert: {where}: a tuplet too fine for Kauai ({ratio.actual}:{ratio.normal} of a {e.type})" if units(v) *
      ratio.normal %
      ratio.actual !=
      0
    let marks_here = [
      ...e.marks,
      ...(accent && !e.rest && !e.marks.contains("accent") ? ["accent"] : []),
    ]
    accent = false if !e.rest
    for _ in 0..e.slur_starts {
      if state.depth == 0 {
        put({slur: "start"})
      } else {
        report("a slur inside a slur", where)
      }
      state.depth += 1
    }
    put(e.rest
      ? {rest: true, ...v, marks: e.marks}
      : {
        pitches: e.pitches,
        ...v,
        marks: marks_here,
        graces: e.graces,
        arpeggio: e.arpeggio,
      })
    for _ in 0..e.slur_stops {
      continue if state.depth == 0
      state.depth -= 1
      put({slur: "stop"}) if state.depth == 0
    }
    for _ in 0..e.stops {
      close_implicit()
      close() if stack.size() > 1
    }
    t = e.at + e.len
  }
  while stack.size() > 1 {
    close()
  }
  marks_until(len)
  rests_to(len) if t < len && !stack[0].items.empty()
  stack[0].items
}

# Items `items` read from the Hits staff (in measure `where`) as a bar's
# hits: each note a hit. What else the staff has is said and left out.
fn hit_items(items, where, report) {
  items.flat_map(fn (it) {
    cond {
      it.has("items") => [{...it, items: hit_items(it.items, where, report)}],
      it.has("pitches") => [{
        hit: true,
        tie: it.pitches[0].tie,
        value: it.value,
        dots: it.dots,
        marks: it.marks,
      }],
      it.has("rest") => [it],
      _ => {
        report("a direction or a slur on the Hits staff", where)
        []
      },
    }
  })
}

# --- the form --------------------------------------------------------------------

# The measures from `start` as blocks the song plays: each {from, body (the
# measures of its body), endings ([{numbers, measures}]), times}. A block
# ends where a rehearsal mark, a forward repeat, a key change, a segno or a
# coda starts another, after a backward repeat or a jump, and after its last
# ending.
fn blocks_of(ms, start) {
  let out = []
  mut i = start
  let opens = |m| m.rehearsal != nil ||
    m.forward ||
    m.key_change != nil ||
    m.segno != nil ||
    m.coda != nil
  let jumps_from = |m| m.dalsegno != nil ||
    m.tocoda != nil ||
    m.dacapo ||
    m.fine
  while i < ms.size() {
    mut j = i
    mut times = 1
    while j < ms.size() && ms[j].ending == nil && (j == i || !opens(ms[j])) {
      let m = ms[j]
      j += 1
      times = m.backward ?? 1
      break if m.backward != nil || jumps_from(m)
    }
    let body = iota(i, j)
    let endings = []
    if times == 1 && (body.empty() || !jumps_from(ms[j - 1])) {
      while j < ms.size() && ms[j].ending != nil {
        # An ending that says no number is the next one; one whose number
        # this group has had starts the next group.
        let numbers = ms[j].ending.empty()
          ? ["{endings.size() + 1}"]
          : ms[j].ending
        break if endings.any(|had| had.numbers.any(|n| numbers.contains(n)))
        mut e = j
        while e + 1 < ms.size() &&
            !ms[e].ending_ends &&
            ms[e].backward == nil &&
            ms[e + 1].ending == nil &&
            !opens(ms[e + 1]) {
          e += 1
        }
        endings.push({numbers, measures: iota(j, e + 1)})
        j = e + 1
      }
    }
    out.push({from: i, body, endings, times})
    i = j
  }
  out
}

# Each time the music goes through a block, in order, as {block, ending}
# (the index of the ending it takes, nil for none): a block's repeats (but
# once through after a jump), each time to it the ending of that time, and
# the jumps, each taken once (to the coda and Fine only after a D.S. or
# D.C.).
fn visits_of(ms, blocks) {
  let visits = []
  let play = fn (block, times, ending) {
    visits.extend(repeat(times, {block, ending}))
  }
  # The first block whose first measure `found` picks.
  let target = |found| iota(blocks.size()).find(|k| found(ms[blocks[k].from]))
  let arrivals = blocks.map(|_| 0)
  let taken_jumps = []
  mut jumped = false
  mut bi = 0
  mut steps = 0
  while bi != nil && bi < blocks.size() {
    steps += 1
    throw "kauai convert: the score's repeats and jumps go round without end" if steps >
      10000
    let b = blocks[bi]
    arrivals[bi] += 1
    mut last = nil
    if b.endings.empty() {
      play(bi, jumped ? 1 : b.times, nil)
      last = b.body[-1]
    } else {
      let n = arrivals[bi]
      let e = b.endings.find(|x| x.numbers.contains("{n}"))
      if e == nil && b.body.empty() {
        # A group of endings with none for this time is passed over.
        bi += 1
        continue
      }
      let ending = e ?? b.endings[-1]
      play(bi, 1, b.endings.index_of(ending))
      last = ending.measures[-1]
      if ms[last].backward != nil && !jumped {
        # Back to where the repeat starts, while an ending there is for a
        # later time.
        let from = iota(bi + 1)
          .filter(|k| ms[blocks[k].from].forward)
          .reduce(0, Math.max)
        let times = iota(from, bi + 1)
          .flat_map(|k| blocks[k].endings)
          .flat_map(|x| x.numbers)
          .map(|k| to_long(k))
          .reduce(0, Math.max)
        if n < times {
          bi = from
          continue
        }
      } else if e != nil && ms[last].backward == nil {
        # An ending that does not repeat goes on to a later group of endings
        # that has one for this time, before the next repeat starts.
        let ahead = iota(bi + 1, blocks.size())
          .iter()
          .take_while(|k| !ms[blocks[k].from].forward)
          .find(|k| blocks[k].body.empty() &&
            blocks[k].endings.any(|x| x.numbers.contains("{n}")))
        if ahead != nil {
          bi = ahead
          continue
        }
      }
    }
    let m = ms[last]
    break if jumped && m.fine
    if jumped && m.tocoda != nil {
      bi = target(|x| x.coda == m.tocoda) ?? target(|x| x.coda != nil)
    } else if (m.dalsegno != nil || m.dacapo) && !taken_jumps.contains(last) {
      taken_jumps.push(last)
      jumped = true
      bi = m.dacapo
        ? 0
        : target(|x| x.segno == m.dalsegno) ?? target(|x| x.segno != nil)
    } else {
      bi += 1
    }
  }
  visits
}

# --- pickups ---------------------------------------------------------------------

let bar_units = |meter| meter.beats * WHOLE / meter.value

# `items` split where `cut` units of them have sounded: (those before, those
# from there), the end of a slur there with the notes before it; nil where a
# note or a tuplet goes on over it.
fn split_at(items, cut) {
  let (head, tail) = ([], [])
  mut at = 0
  for it in items {
    let len = length_of([it])
    return nil if at < cut && at + len > cut
    let before = at < cut || at == cut && it.get("slur", nil) == "stop"
    (before ? head : tail).push(it)
    at += len
  }
  (head, tail)
}

# A bar's `melody` (in `meter`) that holds a pickup `len` long at its end,
# as {bar, pickup}: the bar as a song writes it before the pickup goes into
# its rests (its rests from where its notes end), and the pickup; nil where
# a note goes on over where the pickup starts.
fn into_pickup(melody, meter, len) {
  let whole = bar_units(meter)
  let halves = split_at(melody, whole - len)
  return nil if halves == nil
  let (head, pickup) = halves
  mut n = head.size()
  while n > 0 &&
      head[n - 1].get("rest", false) == true &&
      head[n - 1].marks.empty() {
    n -= 1
  }
  let notes = head[..n]
  let end = length_of(notes)
  {bar: [...notes, ...rests_for(end, whole - end)], pickup}
}

# A meter `units` long, counted in `meter`'s beats where they fit, else in
# the longest value that does.
fn meter_of(units, meter) {
  mut value = meter.value
  while units % (WHOLE / value) != 0 {
    value *= 2
  }
  {beats: units / (WHOLE / value), value}
}

# Whether a bar's `items` rest from `at` units to the bar's end, as Kauai
# has a bar rest where a pickup plays into it: no note sounds there.
fn rests_from(items, at) {
  return false if at < 0
  mut from = 0
  for it in items {
    let len = length_of([it])
    let pitched = it.has("pitches") ||
      it.has("items") && it.items.any(|x| x.has("pitches") || x.has("items"))
    return false if pitched && from + len > at
    from += len
  }
  true
}

# `items` without the ends of slurs they close last: a pickup as a bar holds
# it at a section's end, which ends the slur the pickup opens.
fn open_ended(items) {
  mut n = items.size()
  while n > 0 && items[n - 1].get("slur", nil) == "stop" {
    n -= 1
  }
  items[..n]
}

# --- the song --------------------------------------------------------------------

let one_line = |s| s.split_whitespace().join(" ")

# Voice `v`'s notes and rests in each of `measures`.
fn events_in(measures, v) {
  measures.map(|m| m.voices.find(|x| x.voice == v)?.events ?? [])
}

fn about_of(doc) {
  let creator = |type| doc
    .find("identification/creator[@type='{type}']")
    ?.text()
  let said = {
    title: text_at(doc, "work/work-title") ?? text_at(doc, "movement-title"),
    composer: creator("composer"),
    lyricist: creator("lyricist") ?? creator("poet"),
    arranger: creator("arranger"),
    year: field(doc, "year"),
    source: text_at(doc, "identification/source"),
    license: text_at(doc, "identification/rights"),
    note: field(doc, "note"),
  }
  said
    .keys()
    .map(|k| (
      k,
      said[k] == nil || one_line(said[k]).empty() ? nil : one_line(said[k]),
    ))
    .to_object()
}

# The band that plays `lines`: single notes on the chip channels while they
# last, the lowest line on the triangle; chords and the rest on the external
# piano.
fn band_of(lines) {
  let lowest = lines.map(|l| l
    .events
    .flat_map(|es| es)
    .flat_map(|e| e.pitches)
    .map(music.sounding)
    .reduce(127, Math.min))
  let poly = lines.map(|l| l
    .events
    .flat_map(|es| es)
    .any(|e| e.pitches.size() > 1))
  let singles = iota(lines.size()).filter(|li| !poly[li])
  let chips = {}
  let lows = singles.filter(|li| li > 0).sorted_by(|li| lowest[li])
  chips[lows[0]] = "triangle" if !lows.empty()
  mut free = ["pulse", "pulse2", "saw"]
  for li in singles {
    continue if chips.has(li) || free.empty()
    chips[li] = free[0]
    free = free.slice(1, free.size())
  }
  let voice_line = fn (li) {
    let l = lines[li]
    let plays_what = li == 0 ? "plays melody" : "plays part {l.name}"
    let source = chips.get(li, nil)
    source == nil
      ? "  voice {l.name}  external Ep  {plays_what}  poly  vol 38"
      : "  voice {l.name}  {source}  {plays_what}  vol {li == 0 ? 20 : 14}  gap 1"
  }
  ["band Score \{", ...iota(lines.size()).map(voice_line), "}"].join("\n")
}

# The ids of the parts `doc` marks as a Kauai band's own.
let band_ids = |doc| (field(doc, "kauai-band") ?? "")
  .split_whitespace()
  .map(|s| s.to_string())

# The <part>s of `doc` a Kauai band plays.
fn band_parts(doc) {
  let ids = band_ids(doc)
  doc.find_all("part").filter(|p| ids.contains(p.attrs.id))
}

# The name of each of `doc`'s parts, by its id.
let staff_names = |doc| doc
  .find_all("part-list/score-part")
  .map(|p| (p.attrs.id, text_at(p, "part-name") ?? p.attrs.id))
  .to_object()

# Writes the last bar of each visit before a time the song's pickup plays
# into it (`into`, by visit: that bar as it plays then) into `sections` (a
# reading's) as most times through it play it, each other time in a line of
# its own. `names` is the section each visit plays, and `alike` whether a
# block's endings are one run of bars.
fn played_into(sections, visits, names, into, alike) {
  # The ending each visit's last bar is in, nil for the section's bars.
  let place = |k| alike[visits[k].block] ? nil : visits[k].ending
  let by_name = iota(visits.size()).group_by(|k| names[k])
  for s in sections {
    let ks = by_name.get(s.name, [])
    # The time visit `k` is of its section's.
    let time = |k| ks.index_of(k) + 1
    for e in ks.filter(|k| into[k] != nil).map(place).iter().distinct() {
      let through = ks.filter(|k| place(k) == e)
      let bars = e == nil ? s.bars : s.endings[e].bars
      let b = bars[-1]
      let contents = through.map(|k| {
        chords: b.chords,
        melody: into[k] ?? b.melody,
        parts: b.parts,
        hits: nil,
      })
      let (base, times) = written_as(contents, through.map(time))
      bars[bars.size() - 1] = {...b, ...base, times}
    }
  }
}

# The song score `doc` shows, read from what it shows alone (the qualities
# `voicings` adds read as chords): {score, reports ({what, where}, in
# order), ms (the first part's measures), bars (each measure's bar, as the
# song's), order (the measures in the order they play, the pickup first),
# pickup, lines}.
fn reading(doc, voicings) {
  let reports = []
  let report = |what, where| reports.push({what, where})
  let band = band_ids(doc)
  let names = staff_names(doc)
  # A staff named Hits holds the bars' hits, after every other part.
  let of_hits = |p| names.get(p.attrs.id, nil) == "Hits"
  let parts = doc
    .find_all("part")
    .filter(|p| !band.contains(p.attrs.id))
    .sorted_by(|p| of_hits(p) ? 1 : 0)
    .map(|p| {
      name: names.get(p.attrs.id, "Part"),
      hits: of_hits(p),
      measures: read_measures(p, report, hits: of_hits(p)),
    })
  throw "kauai convert: the score has no parts" if parts.empty()
  let hits_staves = parts.filter(|p| p.hits).size()
  throw "kauai convert: the score has two staves named Hits" if hits_staves > 1
  let ms = parts[0].measures
  throw "kauai convert: the score has no measures" if ms.empty()
  for p in parts {
    throw "kauai convert: part {p.name} has {p.measures.size()} measures, the first part {ms.size()}" if p.measures.size() !=
      ms.size()
  }

  # The lines: each part's voices that play, in the order they start; the
  # hits' last, its voice the one the score shows (a break is its rests).
  let lines = []
  for pi, p in parts.enumerate() {
    let voices = []
    for m in p.measures {
      for v in m.voices {
        voices.push(v.voice) if !voices.contains(v.voice) &&
          v.events.any(|e| p.hits ? e.shown : !e.rest)
      }
    }
    throw "kauai convert: the Hits staff has more than one voice" if p.hits &&
      voices.size() > 1
    for vi, v in voices.enumerate() {
      let base = pi == 0 && vi == 0
        ? "Melody"
        : name_of(p.name, "Part") + (vi == 0 ? "" : "{vi + 1}")
      mut name = base
      mut n = 2
      while lines.any(|l| l.name == name) {
        name = "{base}{n}"
        n += 1
      }
      lines.push({
        part: pi,
        voice: v,
        name,
        hits: p.hits,
        events: events_in(p.measures, v),
      })
    }
  }
  # A score that only rests still has a melody: its first voice's rests.
  if lines.empty() || lines[0].part != 0 {
    let v = ms.flat_map(|m| m.voices).get(0, nil)?.voice ?? "1"
    lines.insert(
      0,
      {part: 0, voice: v, name: "Melody", events: events_in(ms, v)},
    )
  }
  # Directions go to the first line of their part whose first note is on
  # their staff, else to the part's first line.
  let first_staff = lines.map(|l| l
    .events
    .flat_map(|es| es)
    .find(|e| !e.rest)
    ?.staff)
  let staff_line = fn (pi, staff) {
    let of_part = iota(lines.size()).filter(|li| lines[li].part == pi)
    of_part.find(|li| first_staff[li] == staff) ?? of_part.get(0, nil)
  }

  # The song's tempo: a metronome mark or a tempo at its very start.
  let opening = ms[0].directions.filter(|d| d.at == 0)
  let first_tempo = opening.find(|d| d.el.tag == "metronome")
  let song_tempo = first_tempo != nil
    ? direction_items(first_tempo, "measure {ms[0].number}", report)[0].tempo
    : music.tempo_of(opening.find(|d| d.sound?.attrs?.has("tempo") ??
      false)?.sound?.attrs?.tempo ??
      "120")

  # A first measure the score marks implicit, shorter than its meter, is the
  # song's pickup when only the melody plays in it; else a bar that rests
  # until the measure starts.
  let plays_in = |li, mi| lines[li].events[mi].any(|e| !e.rest)
  let first = ms[0]
  let short = first.implicit &&
    first.content > 0 &&
    first.content < first.len &&
    ms.size() > 1
  let pickup = short && !iota(1, lines.size()).any(|li| plays_in(li, 0))
  let start = pickup ? 1 : 0
  let blocks = blocks_of(ms, start)

  # Each line's items, measure by measure, its directions with them. Kauai
  # joins slurred notes in the order the song plays: each ending goes on
  # from where its section's body leaves its slur, and a slur still open
  # where a section ends ends on its last note there (that note no longer
  # joined to the next), as the next section may follow another.
  let states = lines.map(|_| {mut depth: 0, mut wedge: false})
  # Line `li`'s items in measure `mi`, its directions with them.
  let line_measure = fn (li, mi) {
    let l = lines[li]
    let m = parts[l.part].measures[mi]
    let where = "measure {m.number}"
    let marks = m
      .directions
      .filter(|d| staff_line(l.part, d.staff) == li)
      .filter(|d| !(mi == 0 && d == first_tempo))
      .map(|d| {at: d.at, items: direction_items(d, where, report)})
      .filter(|x| !x.items.empty())
    # A hairpin's stop where a dynamic ends it anyway says nothing more.
    let ends = |x| x.items.any(|it| it.has("direction") &&
      LEVELS.values().contains(it.direction))
    let kept = marks.filter(|x| !(x.items == [{direction: "!", tempo: nil}] &&
      marks.any(|y| y.at == x.at && ends(y))))
    items_of(
      l.events[mi],
      mi == 0 && short ? first.content : m.len,
      m.res,
      kept,
      states[li],
      where,
      report,
    )
  }
  # Whether the bars write line `li`'s items in measure `mi`: the melody's
  # where its voice is in the measure, a part's where it plays.
  let written_in = |li, mi| li == 0
    ? !lines[0].events[mi].empty()
    : plays_in(li, mi)
  # The measures of each block's body (the first's from the pickup), and of
  # its last run: its last ending, else its body.
  let bodies = iota(blocks.size()).map(|k| k == 0 && pickup
    ? [0, ...blocks[0].body]
    : blocks[k].body)
  let last_run = |k| blocks[k].endings.empty()
    ? bodies[k]
    : blocks[k].endings[-1].measures
  # Ends line `li`'s open slur where `run` (a section's body or one ending)
  # ends, in the last measure of it whose bar writes the line: after its last
  # note, else after its last item (Kauai ends a slur on the note before a
  # `)`). A run that writes the line nowhere holds no open slur, as a body
  # ends its slur itself when some ending of it does not write the line.
  let cut = fn (li, items, run, where) {
    let st = states[li]
    return nil if st.depth == 0
    let mi = run.filter(|k| written_in(li, k)).get(-1, nil)
    throw "kauai convert: {where}: a slur in a line no bar of its section writes" if mi ==
      nil
    let at = items[mi]
    let last = iota(at.size())
      .filter(|k| at[k].has("pitches"))
      .get(-1, at.size() - 1)
    at.insert(last + 1, {slur: "stop"})
    report(
      "a slur cut where its section ends, its last note no longer joined to the next",
      where,
    )
    st.depth = 0
  }
  let line_items = iota(lines.size()).map(fn (li) {
    let st = states[li]
    let items = ms.map(|_| [])
    let fill = fn (mi) {
      items[mi] = line_measure(li, mi)
    }
    let cut_before = |mi, run| cut(li, items, run, "measure {ms[mi].number}")
    fill(0) if pickup
    for k, b in blocks.enumerate() {
      cut_before(b.from, last_run(k - 1)) if k > 0
      b.body.for_each(fill)
      # An ending that does not write the line cannot go on with the body's
      # slur, so the body ends it before every ending.
      cut_before(
        b.endings[0].measures[0],
        bodies[k],
      ) if b.endings.any(|e| !e.measures.any(|mi| written_in(li, mi)))
      let left = st.depth
      for n, e in b.endings.enumerate() {
        if n > 0 {
          cut_before(e.measures[0], b.endings[n - 1].measures)
          st.depth = left if !b.body.empty()
        }
        e.measures.for_each(fill)
      }
    }
    items
  })
  # A hairpin the score never ends ends with the song, and a slur it ends in
  # another voice ends there too.
  for li, st in states.enumerate() {
    cut(li, line_items[li], last_run(blocks.size() - 1), "the song's end")
    line_items[li][-1].push({direction: "!", tempo: nil}) if st.wedge
  }
  if short && !pickup {
    let gap = (first.len - first.content) * QUARTER / first.res
    for li in iota(lines.size()) {
      line_items[li][0] = [...rests_for(0, gap), ...line_items[li][0]]
    }
  }

  # The hits, out of the lines: each measure's where the score shows some.
  let hits = lines.get(-1, nil)?.hits == true
    ? iota(ms.size()).map(|mi| lines[-1].events[mi].any(|e| e.shown)
      ? hit_items(line_items[-1][mi], "measure {ms[mi].number}", report)
      : nil)
    : nil
  if hits != nil {
    lines.pop()
    line_items.pop()
  }

  let chords = chords_of(ms, parts, report, voicings)

  # The bars, each as Audio.Kauai.parse gives one.
  mut swing = nil
  let bars = iota(ms.size()).map(fn (mi) {
    let m = ms[mi]
    swing = cond {
      m.swing == "straight" => nil,
      m.swing != nil => m.swing,
      _ => swing,
    }
    {
      meter: m.meter,
      swing,
      groove: {name: nil, bar: 0, named: false},
      chords: chords[mi],
      melody: line_items[0][mi],
      parts: iota(1, lines.size())
        .filter(|li| plays_in(li, mi))
        .map(|li| {name: lines[li].name, notes: line_items[li][mi]}),
      hits: hits?.get(mi, nil),
      repeat: nil,
      times: [],
    }
  })

  # The song's pickup plays before each time through its section, into the
  # rests of the bar before it. A time the score goes back to the pickup's
  # own measure for (a D.C., a repeat from the start) plays it from there,
  # where the bar before rests. A time it goes back to after the pickup for
  # (a D.S., a repeat from the first bar) plays it where the score writes
  # it at the end of the bar before, and that bar is the rests it was
  # before: `into`, for each visit before such a time, the bar as it plays
  # then, and `written`, the bars, each so where every time through it
  # plays so. A later time the pickup does not play before is the section
  # without it.
  let visits = visits_of(ms, blocks)
  let lead = pickup ? line_items[0][0] : nil
  let measures_of = |v| [
    ...blocks[v.block].body,
    ...(v.ending == nil ? [] : blocks[v.block].endings[v.ending].measures),
  ]
  let last_of = |v| measures_of(v)[-1]
  let later = |k| lead != nil &&
    k > 0 &&
    k < visits.size() &&
    visits[k].block == 0
  # Whether the music goes back to the pickup's measure for visit `k`.
  let replays = fn (k) {
    let m = ms[last_of(visits[k - 1])]
    m.dacapo || m.dalsegno == nil && !ms[blocks[0].from].forward
  }
  let into = iota(visits.size()).map(fn (k) {
    return nil if !later(k + 1) || replays(k + 1)
    let b = bars[last_of(visits[k])]
    let split = into_pickup(b.melody, b.meter, length_of(lead))
    split != nil && open_ended(split.pickup) == open_ended(lead)
      ? split.bar
      : nil
  })
  let ending_in = iota(visits.size()).group_by(|k| last_of(visits[k]))
  let written = iota(ms.size()).map(fn (mi) {
    let ks = ending_in.get(mi, [])
    let all_into = !ks.empty() && ks.all(|k| into[k] != nil)
    all_into ? {...bars[mi], melody: into[ks[0]]} : bars[mi]
  })

  # The sections: a block is a section, one that is the same as one before
  # played again by its name.
  let sections = []
  mut letter = 0
  let song_key = ms[start].key ?? "C"
  # A block whose endings are all the same is one run of bars, played again.
  let bars_of = |measures| measures.map(|mi| written[mi])
  let alike = blocks.map(|b| b.endings.size() > 1 &&
    b.endings.all(|e| bars_of(e.measures) == bars_of(b.endings[0].measures)))
  # The name of a section of `content` that a rehearsal mark `named` (nil
  # for none) starts: one before of the same content's, else a new one.
  let name_for = fn (content, named) {
    let same = sections.find(|s| {
      key: s.key,
      pickup: s.pickup,
      bars: s.bars,
      endings: s.endings,
    } ==
      content &&
      (named == nil || s.name.starts_with(name_of(named, "S"))))
    let name = same?.name ?? fn () {
      mut base = named == nil ? nil : name_of(named, "S")
      while base == nil || sections.any(|s| s.name == base) {
        if named == nil {
          base = letter < 26
            ? CAPITALS.slice(letter, letter + 1).to_string()
            : "S{letter + 1}"
          letter += 1
        } else {
          base += "2"
        }
      }
      base
    }()
    sections.push({name, ...content}) if same == nil
    name
  }
  let content_of = |k| {
    key: ms[blocks[k].from].key == song_key ? nil : ms[blocks[k].from].key,
    pickup: k == 0 && lead != nil ? {melody: lead} : nil,
    bars: [
      ...bars_of(blocks[k].body),
      ...(alike[k] ? bars_of(blocks[k].endings[0].measures) : []),
    ],
    endings: alike[k]
      ? []
      : blocks[k].endings.map(|e| {
        number: e.numbers[0],
        as_written: false,
        bars: bars_of(e.measures),
      }),
  }
  let block_names = iota(blocks.size()).map(|k| name_for(
    content_of(k),
    ms[blocks[k].from].rehearsal,
  ))

  # The slurs the pickup opens, which the first bar after it ends.
  let slurs = |s| (lead ?? []).filter(|it| it.get("slur", nil) == s).size()
  let open_slurs = slurs("start") - slurs("stop")
  # The first section without its pickup, nor the ends of the slurs the
  # pickup opens: a later time the pickup does not play before.
  let unled = fn () {
    mut open = open_slurs
    let unslurred = content_of(0).bars.map(|b| {...b, melody: b.melody.filter(fn (it) {
      return true if open == 0 || it.get("slur", nil) != "stop"
      open -= 1
      false
    })})
    {...content_of(0), pickup: nil, bars: unslurred}
  }
  # Visits the score plays the pickup's own measure before where the bar
  # before it does not rest: that measure is a bar of its own, as long as
  # the pickup, played before the section without it.
  let crowded = fn (k) {
    return false if !later(k) || !replays(k)
    let before = bars[last_of(visits[k - 1])]
    !rests_from(before.melody, bar_units(before.meter) - length_of(lead))
  }
  let names = iota(visits.size()).map(fn (k) {
    let played = !later(k) || (replays(k) ? !crowded(k) : into[k - 1] != nil)
    played
      ? block_names[visits[k].block]
      : name_for(unled(), ms[blocks[0].from].rehearsal)
  })
  let lead_bar = fn () {
    let meter = meter_of(length_of(lead), bars[0].meter)
    let beat = |j| j * (WHOLE / meter.value) / (WHOLE / bars[0].meter.value)
    report(
      "a slur cut where its section ends, its last note no longer joined to the next",
      "measure {ms[0].number}",
    ) if open_slurs > 0
    let bar = {
      ...bars[0],
      meter,
      chords: iota(meter.beats).map(|j| bars[0].chords[beat(j)]),
      melody: [...lead, ...repeat(open_slurs, {slur: "stop"})],
    }
    name_for({key: nil, pickup: nil, bars: [bar], endings: []}, nil)
  }
  played_into(sections, visits, names, into, alike)

  # The plays, each run of visits to a block that takes the same ending.
  let visited = []
  for k, v in visits.enumerate() {
    visited.push({section: lead_bar(), ending: nil}) if crowded(k)
    visited.push({
      section: names[k],
      ending: v.ending == nil || alike[v.block]
        ? nil
        : blocks[v.block].endings[v.ending].numbers[0],
    })
  }
  let plays = visited
    .iter()
    .chunk_by(|x| x)
    .map(|run| {...run[0], times: run.size(), with: nil, key: nil})
    .collect()
  let order = [...(pickup ? [0] : []), ...visits.flat_map(measures_of)]
  let about = about_of(doc)
  let score = {
    about,
    song: {
      name: name_of(about.title ?? "", "Song"),
      tempo: song_tempo,
      meter: ms[start].meter,
      key: song_key,
      swing: bars[start].swing,
      band: "Score",
      groove: nil,
      loop: false,
      room: nil,
      plays,
    },
    sections,
    arrangement: band_of(lines),
  }
  {doc, score, reports, ms, bars, order, pickup, lines}
}

# --- the song the score carries ------------------------------------------------------

let back_by = |iv| {semis: -iv.semis, steps: -iv.steps}
# Measure `mi` of reading `x`, as a report names it.
let measure_at = |x, mi| "measure {x.ms[mi].number}"
let capitalized = |w| w.slice(0, 1).to_string() !=
  w.slice(0, 1).to_string().lower()

# What of a song's `items` a score does not show: its parameters, and its
# rit.s and accel.s, whose tempo it has no place for; each with how far into
# the bar it stands.
fn unshown(items) {
  mx
    .events_of(items)
    .filter(|e| e.has("mark") &&
      (e.mark.has("param") ||
        ["rit", "accel"].contains(e.mark.get("direction", nil))))
    .map(|e| (e.at, e.mark))
}

# `items` with `extra` (as `unshown` gives them) back where they stand, each
# before the first note, rest or tuplet at or after it, or in the tuplet it
# falls in.
fn with_unshown(items, extra) {
  let out = []
  mut (k, at) = (0, 0)
  for it in items {
    let len = length_of([it])
    if music.lasts(it) {
      while k < extra.size() && extra[k][0] <= at {
        out.push(extra[k][1])
        k += 1
      }
    }
    let inside = []
    while it.has("items") && k < extra.size() && extra[k][0] < at + len {
      let ratio = it.tuplet
      inside.push((
        (extra[k][0] - at) * ratio.actual / ratio.normal,
        extra[k][1],
      ))
      k += 1
    }
    out.push(inside.empty()
      ? it
      : {...it, items: with_unshown(it.items, inside)})
    at += len
  }
  [...out, ...extra[k..].map(|x| x[1])]
}

# A run of a section's `bars` with each `%` kept where its bars are the ones
# before them again, all they hold and every time, as Audio.Kauai.parse
# keeps one; written out where they are not.
fn repeats_kept(bars) {
  let held = |b| [b.chords, b.melody, b.parts, b.hits, b.times]
  iota(bars.size()).map(fn (i) {
    let r = bars[i].repeat
    return bars[i] if r == nil
    let head = i - r.index
    let again = iota(r.bars).all(|k| bars.get(head + k, nil)?.repeat ==
      {bars: r.bars, index: k} &&
      held(bars[head + k]) == held(bars[head - r.bars + k]))
    again ? bars[i] : {...bars[i], repeat: nil}
  })
}

# A bar as `contents` (each time that plays it, at `times`) play it: written
# as most of them play it, the first of those if more do, and what each
# other time changes of it.
fn written_as(contents, times) {
  let base = contents.max_by(|x| contents.filter(|y| y == x).size())
  let changes = iota(contents.size()).map(|k| change_of(
    base,
    contents[k],
    times[k],
  ))
  (base, changes.filter(|t| t != nil))
}

# What time `time` of a bar written as `base` changes of it to play `v`, as a
# bar's `times` holds it; nil for nothing.
fn change_of(base, v, time) {
  # Chords read from a score are the same as a song's by their symbols.
  let same_chords = v.chords.map(|ch| ch?.symbol) ==
    base.chords.map(|ch| ch?.symbol)
  let tune = !same_chords || v.melody != base.melody
  let notes_in = |list, name| list.find(|p| p.name == name)?.notes ?? []
  let parts = [...base.parts, ...v.parts]
    .map(|p| p.name)
    .iter()
    .distinct()
    .filter(|n| notes_in(base.parts, n) != notes_in(v.parts, n))
    .map(|n| {name: n, notes: notes_in(v.parts, n)})
    .collect()
  let hits = v.hits == base.hits ? nil : v.hits ?? []
  return nil if !tune && parts.empty() && hits == nil
  {
    time,
    chords: !tune ? nil : same_chords ? base.chords : v.chords,
    melody: tune ? v.melody : nil,
    parts,
    hits,
  }
}

# The parts band `name` of `arrangement` (Kauai text) plays.
fn parts_played(arrangement, name) {
  mut inside = false
  let out = []
  for line in arrangement.lines() {
    let w = line.split_whitespace().map(|s| s.to_string())
    continue if w.empty()
    if w[0] == "band" {
      inside = w.get(1, nil) == name
      continue
    }
    let at = w.index_of("part")
    if inside && w[0] == "voice" && at > 0 && w[at - 1] == "plays" {
      out.extend(w[at + 1..].iter().take_while(capitalized).collect())
    }
  }
  out
}

# The song's play lines `lines` for its passes as the score has them: the
# times that fit, each run of them a line as the song has it, and each time
# that no longer fits (`alone`, the section it is now) a line of that
# section's, as many times as it plays in a row.
fn lines_of(lines, passes, alone) {
  let plays = []
  for i, line in lines.enumerate() {
    if line.has("mark") {
      plays.push(line)
      continue
    }
    for p in iota(passes.size()).filter(|p| passes[p].play == i) {
      let section = alone.get(p, line.section)
      let last = plays.get(-1, nil)
      if last != nil && last.section == section && last.get("from", nil) == i {
        plays[plays.size() - 1] = {...last, times: last.times + 1}
      } else if alone.has(p) {
        plays.push({...line, section, times: 1, ending: nil, key: nil, from: i})
      } else {
        plays.push({...line, times: 1, from: i})
      }
    }
  }
  plays.map(|p| p.has("mark")
    ? p
    : {
      section: p.section,
      times: p.times,
      ending: p.ending,
      with: p.with,
      key: p.key,
    })
}

# The song `c` (the Kauai text a score carries, read) as score `r` (a
# reading) shows it, where it shows otherwise than the score `c` writes
# (`r0`, read the same way). Each time the song plays a section is a run of
# measures from a rehearsal mark; a measure that reads as it does in `r0` is
# the song's own bar, with what a score does not hold, and one that reads
# otherwise is the score's, back in its section's key. A time that no
# longer fits its section is a section of its own as the score shows it,
# named by its rehearsal mark where that is another. Gives {score, reports,
# places (each measure of `r0`'s as the measure of `r`'s that stands for
# it), scored (the measures read from the score), restored (the reports the
# song answers)}.
fn brought(c, r, r0) {
  let reports = []
  let report = |what, at| reports.push({what, where: at})
  let passes = mx.passes_of(c)
  # The runs of reading `x`'s measures that start at `firsts`.
  let runs_from = |x, firsts| iota(firsts.size()).map(|k| x.order[firsts[k]..firsts.get(
    k + 1,
    x.order.size(),
  )])
  # Where each pass starts in the score the song writes.
  let starts0 = []
  mut j = r0.pickup ? 1 : 0
  for p in passes {
    starts0.push(j)
    j += p.bars.size()
  }
  throw "kauai convert: the score Kauai writes reads as other measures" if j !=
    r0.order.size()
  let runs0 = runs_from(r0, starts0)
  let starts = iota(r.order.size()).filter(|k| r.ms[r.order[k]].rehearsal !=
    nil)
  let runs = runs_from(r, starts)
  let fits_form = r.pickup == r0.pickup &&
    starts.get(0, r.order.size()) == (r.pickup ? 1 : 0) &&
    runs.size() == passes.size()
  if !fits_form {
    report(
      "the order the song plays its sections in, which the score changes: the sections as the score has them",
      "the score",
    )
    let s = c.song
    let own = {
      name: s.name,
      band: s.band,
      groove: s.groove,
      loop: s.loop,
      room: s.room,
    }
    return {
      score: {
        ...r.score,
        song: {...r.score.song, ...own},
        arrangement: c.arrangement,
      },
      reports,
      places: {},
      scored: r.order.map(|mi| measure_at(r, mi)),
      restored: [],
    }
  }
  let frame = |x, mi| {
    key: x.ms[mi].key,
    meter: x.bars[mi].meter,
    swing: x.bars[mi].swing,
  }
  let marked = |p| r.ms[runs[p][0]].rehearsal
  let where = |p, a| measure_at(r, runs[p][a])
  # The measures read from the score rather than from the song, and the
  # measure of the score's that stands for each of the score the song writes
  # (the last of its time's, where the score's time is shorter).
  let scored = []
  let read_at = |p, a| scored.push(where(p, a))
  let places = {}
  for p in iota(passes.size()) {
    for a in iota(runs0[p].size()) {
      places[measure_at(
        r0,
        runs0[p][a],
      )] = where(p, Math.min(a, runs[p].size() - 1))
    }
  }
  if r.pickup {
    places[measure_at(r0, r0.order[0])] = measure_at(r, r.order[0])
  }

  # Measure `a` of pass `p` in reading `x` (its runs `rs`): its chords,
  # melody, parts and hits, and the pickup into the next pass it holds, cut
  # off (nil where a note goes over where it starts).
  let view = fn (x, rs, p, a) {
    let b = x.bars[rs[p][a]]
    let next = a == rs[p].size() - 1 ? passes.get(p + 1, nil) : nil
    let held = next?.pickup
    let plain = {
      chords: b.chords,
      melody: b.melody,
      parts: b.parts,
      hits: b.hits,
    }
    return {...plain, pickup: nil} if held == nil
    let cut = into_pickup(b.melody, b.meter, length_of(held))
    return {...plain, pickup: nil, broken: true} if cut == nil
    {...plain, melody: cut.bar, pickup: cut.pickup}
  }
  # Pass `p`'s pickup in reading `x`: the song's first measure, or what the
  # measure before it holds.
  let pickup_in = |x, rs, p| p == 0
    ? x.pickup ? x.bars[x.order[0]].melody : nil
    : view(x, rs, p - 1, rs[p - 1].size() - 1).pickup
  let bar_view = |x, rs, p, a| {...view(x, rs, p, a), pickup: nil}
  let changed = |p, a| bar_view(r, runs, p, a) != bar_view(r0, runs0, p, a)
  # A time fits its section where the score marks it so, with as many
  # measures in the same keys, meters and swing, and the pickup into it cut
  # off where the measure before it holds it.
  let fits = iota(passes.size()).map(|p| marked(p) == passes[p].section &&
    runs[p].size() == runs0[p].size() &&
    iota(runs[p].size()).all(|a| frame(r, runs[p][a]) ==
      frame(r0, runs0[p][a])) &&
    !(p > 0 && view(r, runs, p - 1, runs[p - 1].size() - 1).has("broken")))
  # The rit.s and accel.s the song puts back where the score says no tempo.
  let restored = []
  # Measure `a` of pass `p` as the score has it, back in its section's key,
  # with what the score does not show of `played` (the song's bar as it
  # plays that time, nil for none) where it stands.
  let from_score = fn (p, a, back, played) {
    let v = view(r, runs, p, a)
    let own = fn (items, notes) {
      let extra = played == nil ? [] : unshown(items)
      for x in extra.filter(|x| x[1].has("direction")) {
        restored.push({what: NO_TEMPO, where: where(p, a)})
      }
      with_unshown(mx.moved_items(notes, back), extra)
    }
    {
      chords: v.chords.map(|ch| mx.moved_chord(ch, back)),
      melody: own(played?.melody ?? [], v.melody),
      parts: v.parts.map(|q| {
        name: q.name,
        notes: own(
          played?.parts?.find(|x| x.name == q.name)?.notes ?? [],
          q.notes,
        ),
      }),
      hits: v.hits,
    }
  }

  let taken = c.sections.map(|s| s.name)
  let alone = {}  # a pass that no longer fits: the section it is
  let sections = c.sections.flat_map(fn (sec) {
    let ps = iota(passes.size()).filter(|p| passes[p].section == sec.name)
    let kept = ps.filter(|p| fits[p])
    let now = |p| kept.index_of(p) + 1
    let renumbered = kept.size() != ps.size()
    # Bar `b`, the `a`th of each pass in `uses` (the passes that play it).
    let bar_of = fn (b, a, uses) {
      let edits = uses.filter(|p| changed(p, a))
      edits.for_each(|p| read_at(p, a))
      return b if edits.empty() && !renumbered
      let contents = uses.map(fn (p) {
        let played = mx.as_played(b, passes[p].time)
        return played if !edits.contains(p)
        from_score(p, a, back_by(passes[p].moves[a]), played)
      })
      let (base, times) = written_as(contents, uses.map(now))
      {...b, ...base, times}
    }
    # The pickup, the song's unless the score plays it otherwise.
    let pickup_of = fn () {
      return sec.pickup if sec.pickup == nil || kept.empty()
      let edits = kept.filter(|p| pickup_in(r, runs, p) !=
        pickup_in(r0, runs0, p))
      return sec.pickup if edits.empty()
      # Where the score holds pass `p`'s pickup.
      let held = |p| p == 0
        ? measure_at(r, r.order[0])
        : where(p - 1, runs[p - 1].size() - 1)
      edits.for_each(|p| scored.push(held(p)))
      let takes = kept.map(fn (p) {
        return sec.pickup.melody if !edits.contains(p)
        let tail = pickup_in(r, runs, p)
        tail == nil ? nil : mx.moved_items(tail, back_by(passes[p].iv))
      })
      if takes.any(|t| t != takes[0]) {
        report(
          "a pickup the score plays otherwise from time to time, played as the first time",
          held(edits[0]),
        )
      }
      takes[0] == nil ? nil : {melody: takes[0]}
    }
    let own = kept.empty()
      ? []
      : [{
        ...sec,
        pickup: pickup_of(),
        bars: repeats_kept(iota(sec.bars.size()).map(|a| bar_of(
          sec.bars[a],
          a,
          kept,
        ))),
        endings: sec
          .endings
          .filter(|e| kept.any(|p| passes[p].ending == e.number))
          .map(|e| {
            ...e,
            bars: repeats_kept(iota(e.bars.size()).map(|k| bar_of(
              e.bars[k],
              sec.bars.size() + k,
              kept.filter(|p| passes[p].ending == e.number),
            ))),
          }),
      }]
    # Each pass that no longer fits, a section of its own as the score shows
    # it, one for the passes it shows the same.
    let split = []
    for p in ps.filter(|p| !fits[p]) {
      iota(runs[p].size()).for_each(|a| read_at(p, a))
      let shown = r.ms[runs[p][0]].key
      let written = [
        ...sec.bars,
        ...(sec.endings.find(|e| e.number == passes[p].ending)?.bars ?? []),
      ]
      # Its grooves where the section's bars have them, a `groove` line at
      # its start where the section played one by its name.
      mut (since, playing) = (0, c.song.groove)
      let bars = iota(runs[p].size()).map(fn (a) {
        let b = r.bars[runs[p][a]]
        let g = written.get(a, nil)?.groove
        let line = a == 0 && g?.name != nil && g.name != c.song.groove ||
          g?.named == true && g.bar == 0
        since = line || a == 0 ? 0 : since + 1
        playing = g?.name ?? playing
        {
          meter: b.meter,
          swing: b.swing,
          groove: {name: playing, bar: since, named: line},
          ...from_score(p, a, mx.UNMOVED, nil),
          repeat: nil,
          times: [],
        }
      })
      let tail = sec.pickup == nil ? nil : pickup_in(r, runs, p)
      let content = {
        key: shown == c.song.key ? nil : shown,
        pickup: tail == nil ? nil : {melody: tail},
        bars,
        endings: [],
      }
      let same = split.find(|s| s.mark == marked(p) && s.content == content)
      mut name = same?.name ??
        (marked(p) == sec.name
          ? sec.name + "2"
          : name_of(marked(p), sec.name + "2"))
      while same == nil && taken.contains(name) {
        name += "2"
      }
      report(
        "a time through a section that no longer fits it, a section of its own (its parameters left out)",
        "{where(p, 0)} ({sec.name} as {name})",
      )
      alone[p] = name
      if same == nil {
        taken.push(name)
        split.push({name, mark: marked(p), content})
      }
    }
    [...own, ...split.map(|s| ({name: s.name, ...s.content}))]
  })

  # The tempo, meter and swing the song starts with, the song's unless the
  # score starts otherwise. Its key stays the song's: the sections without
  # one and their `in`s are in it, and a time the score shows in another
  # key no longer fits.
  let started = fn (k) {
    r.score.song[k] == r0.score.song[k] ? c.song[k] : r.score.song[k]
  }
  let score = {
    about: r.score.about == r0.score.about ? c.about : r.score.about,
    song: {
      ...c.song,
      tempo: started("tempo"),
      meter: started("meter"),
      swing: started("swing"),
      plays: lines_of(c.song.plays, passes, alone),
    },
    sections,
    arrangement: c.arrangement,
  }
  {score, reports, places, scored, restored}
}

# Score `score` with a band made for `lines` in place of its own, which
# plays no groove, echo or harmony (the hits stay, as a score shows them).
fn without_band(score, lines) {
  let plain = |b| {...b, groove: {name: nil, bar: 0, named: false}}
  {
    ...score,
    song: {
      ...score.song,
      band: "Score",
      groove: nil,
      plays: score.song.plays.map(|p| p.has("mark") ? p : {...p, with: nil}),
    },
    sections: score.sections.map(|s| {
      ...s,
      bars: s.bars.map(plain),
      endings: s.endings.map(|e| {...e, bars: e.bars.map(plain)}),
    }),
    arrangement: band_of(lines),
  }
}

# Each band staff of `doc` (by its name): in each measure, the notes it
# sounds, as (start, length, sound, whether a tie holds it on), times in
# quarters.
fn band_staves(doc) {
  let names = staff_names(doc)
  let staff = fn (part) {
    mut divisions = 1
    part.find_all("measure").map(fn (m) {
      let out = []
      mut (at, struck) = (0, 0)
      for c in elements(m) {
        match c.tag {
          "attributes" => divisions = to_long(text_at(c, "divisions") ??
            "{divisions}"),
          "backup" => at -= number_at(c, "duration"),
          "forward" => at += number_at(c, "duration"),
          "note" => {
            continue if c.find("grace") != nil
            let len = number_at(c, "duration")
            if c.find("chord") == nil {
              struck = at
              at += len
            }
            let p = c.find("pitch")
            let sound = cond {
              p != nil => "{music.sounding(pitch_at(p))}",
              c.find("unpitched") !=
                nil => text_at(c, "unpitched/display-step") +
                text_at(c, "unpitched/display-octave"),
              _ => nil,
            }
            out.push((
              struck * 1.0 / divisions,
              len * 1.0 / divisions,
              sound,
              c.find("tie[@type='start']") != nil,
            )) if sound != nil
          },
          _ => nil,
        }
      }
      out.sorted_by(|n| (n[0], n[2]))
    })
  }
  band_parts(doc)
    .map(|p| (names.get(p.attrs.id, p.attrs.id), staff(p)))
    .to_object()
}

# Kauai text `text` read as a song's score, and why it does not read (nil
# where it does).
fn parsed(text) {
  try {
    (Audio.Kauai.parse(text), nil)
  } catch e: KauaiError {
    (nil, e.message)
  }
}

# Score `score` (`c`'s song as reading `r` shows it) with `c`'s band where
# that band plays every part and the song reads, else a band made for the
# score's lines: {score, reports}. The band's staves show what the band
# plays; where the score's show otherwise (a chord changed under them, or a
# note of theirs), that is said.
fn banded(score, c, r, r0, voicings) {
  let reports = []
  let report = |what, where| reports.push({what, where})
  # A part the song did not have, which no voice plays.
  let played = parts_played(score.arrangement, score.song.band)
  let had = mx.part_names(c)
  let missing = mx
    .part_names(score)
    .filter(|n| !played.contains(n) && !had.contains(n))
  let read_song = |s| parsed(kau.write(s))
  let same = kau.write(score) == kau.write(c)
  let (song, unread) = same ? (c, nil) : read_song(score)
  let problem = missing.empty()
    ? unread
    : "it plays no part {missing.join(", ")}"
  if problem != nil {
    # The band is what does not fit where the song reads without it.
    let plain = without_band(score, r.lines)
    let blamed = !missing.empty() || read_song(plain)[1] == nil
    report(
      blamed
        ? "the song's band, which does not play the score ({problem}): a band made for its lines"
        : "the song as the score has it, which does not read ({problem})",
      "the score",
    )
    return {score: blamed ? plain : score, reports}
  }
  let r1 = same ? r0 : reading(XML.parse(mx.write(song)), voicings)
  # Staves written as the score Kauai writes for the song has them show what
  # it plays.
  return {score, reports} if band_parts(r.doc) == band_parts(r1.doc)
  let (shown, plays) = (band_staves(r.doc), band_staves(r1.doc))
  let staves = [...shown.keys(), ...plays.keys()].iter().distinct().collect()
  let notes_at = |st, name, mi| st.has(name) ? st[name][mi] : []
  for j in iota(Math.min(r.order.size(), r1.order.size())) {
    let (mi, mi1) = (r.order[j], r1.order[j])
    if staves.any(|n| notes_at(shown, n, mi) != notes_at(plays, n, mi1)) {
      report(
        "the band's staves, where the band plays otherwise (Kauai plays it from the chords and grooves)",
        measure_at(r, mi),
      )
    }
  }
  {score, reports}
}

# `reports` but those `expected` has too (each as often as it has it).
fn unexplained(reports, expected) {
  let key = |x| "{x.what}\n{x.where}"
  let left = {}
  for x in expected {
    left[key(x)] = left.get(key(x), 0) + 1
  }
  reports.filter(fn (x) {
    return true if left.get(key(x), 0) == 0
    left[key(x)] -= 1
    false
  })
}

# Reports ({what, where}) as Kauai says them: each once, with the first three
# places it is in.
fn dropped_of(reports) {
  let by_what = reports.group_by(|r| r.what)
  by_what.keys().map(fn (what) {
    let at = by_what[what].map(|r| r.where).iter().distinct().collect()
    "{what}: {at.slice(0, 3).join(", ")}" +
      (at.size() > 3 ? " and {at.size() - 3} more" : "")
  })
}

# The score MusicXML `text` holds, as {score, dropped}: the song's score, as
# Audio.Kauai.parse gives one, and what Kauai leaves out of it or changes a
# little, each said once with the measures it is in.
fn read(text) {
  let doc = XML.parse(text)
  throw "kauai convert: only a partwise score (<score-partwise>) is read, not <{doc.tag}>" if doc.tag !=
    "score-partwise"
  let carried = field(doc, "kauai-song")
  let (c, unread) = carried == nil ? (nil, nil) : parsed(carried)
  if c == nil {
    let r = reading(doc, "")
    let said = unread == nil
      ? []
      : [{
        what: "the song's Kauai text, which does not read ({unread})",
        where: "the score",
      }]
    return {score: r.score, dropped: dropped_of([...said, ...r.reports])}
  }
  let voicings = c
    .arrangement
    .split("\n\n")
    .filter(|b| b.starts_with("voicings"))
    .map(|b| "{b}\n\n")
    .join("")
  let r = reading(doc, voicings)
  # The score the song writes, read the same way (the score itself where it
  # is that score).
  let written = mx.write(c)
  let r0 = written == text ? r : reading(XML.parse(written), voicings)
  let back = brought(c, r, r0)
  let fitted = banded(back.score, c, r, r0, voicings)
  # What the score the song writes says too, of a measure that is the song's
  # own, the song has.
  let expected = r0
    .reports
    .map(|x| {...x, where: back.places.get(x.where, x.where)})
    .filter(|x| !back.scored.contains(x.where))
  {
    score: fitted.score,
    dropped: dropped_of([
      ...unexplained(r.reports, [...expected, ...back.restored]),
      ...back.reports,
      ...fitted.reports,
    ]),
  }
}

export {read, score_text}
