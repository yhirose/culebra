import mx from './musicxml.cul'
import kau from './kau.cul'
import corpus from './corpus.cul'

let STEP = {C: 0, D: 2, E: 4, F: 5, G: 7, A: 9, B: 11}
let SCHEMA = "kauai/convert/musicxml-4.0"
let WRITTEN = {}

# Song `path`'s score, its MusicXML and that read back, made once for the
# tests that read every song.
fn written(path) {
  WRITTEN[path] ??= fn () {
    let score = Audio.Kauai.parse_file(path)
    let text = mx.write(score)
    {score, text, doc: XML.parse(text)}
  }()
  WRITTEN[path]
}

# The names of a score's parts, in order.
let part_names = |doc| doc
  .find_all("part-list/score-part")
  .map(|p| p.text("part-name"))

# --- playing a score -------------------------------------------------------------

# The order a score's measures play in, by index, as its first part's
# `measures` say: its repeats and endings taken, and its jumps, once back to
# the start or the segno, then through each repeat once and its last
# ending, to the coda or Fine. Every part plays in that order.
fn played_order(measures) {
  let out = []
  let sound = |m, k| m.find("direction/sound[@{k}]") != nil
  let find = |k| iota(measures.size()).find(|j| sound(measures[j], k))
  mut i = 0
  mut start = 0
  mut pass = 1
  mut jumped = false
  while i < measures.size() {
    let m = measures[i]
    if m.find("barline[@location='left']/repeat[@direction='forward']") != nil &&
        i != start {
      start = i
      pass = 1
    }
    let ending = m.find("barline[@location='left']/ending[@type='start']")
    if ending != nil {
      mut close = i
      while measures[close].find("barline[@location='right']/ending") == nil {
        close += 1
      }
      let closing = measures[close].find("barline[@location='right']/ending")
      let last = closing.attrs.type == "discontinue"
      let numbers = ending.attrs.number.split(",").map(|s| to_long(s.trim()))
      if jumped ? !last : !numbers.contains(pass) {
        i = close + 1
        continue
      }
    }
    out.push(i)
    let back = m.find("barline[@location='right']/repeat[@direction='backward']")
    if back != nil && !jumped && pass < to_long(back.attrs.get("times", "2")) {
      pass += 1
      i = start
      continue
    }
    break if jumped && sound(m, "fine")
    if jumped && sound(m, "tocoda") {
      i = find("coda")
      continue
    }
    if !jumped && (sound(m, "dacapo") || sound(m, "dalsegno")) {
      jumped = true
      i = sound(m, "dacapo") ? 0 : find("segno")
      continue
    }
    i += 1
  }
  out
}

# Note `n`'s MIDI pitch, nil for a rest.
fn midi_of(n) {
  let p = n.find("pitch")
  return nil if p == nil
  12 * (to_long(p.text("octave")) + 1) +
    STEP[p.text("step")] +
    to_long(p.text("alter") ?? "0")
}

# What a part strikes, its measures in `order`, as [onset in divisions,
# what `sound_of` hears in the note (nil for none), its MIDI pitch unless
# said]: its grace notes a sixty-fourth (30) apart before their note, as
# Kauai plays them.
fn struck(part, order, sound_of = midi_of) {
  let out = []
  mut graces = []
  mut t = 0
  mut at = 0
  let measures = part.find_all("measure")
  for m in order.map(|i| measures[i]) {
    for n in m.find_all("note") {
      let pitch = sound_of(n)
      if n.find("grace") != nil {
        graces = [...graces, pitch]
        continue
      }
      if n.find("chord") == nil {
        out.extend(iota(graces.size()).map(|k| [t + 30 * k, graces[k]]))
        at = t + 30 * graces.size()
        graces = []
        t += to_long(n.text("duration"))
      }
      out.push([
        at,
        pitch,
      ]) if pitch != nil && n.find("tie[@type='stop']") == nil
    }
  }
  out
}

# The parts of a band's voices in a score, each with the parts it plays
# on: `Melody` for the melody, the song's parts it plays, and its own last,
# after every part the song writes, for the grooves, echoes and harmonies
# it plays (`played`). A part is its index among the score's.
fn voice_parts(arrangement, played, names) {
  let band_at = names.size() -
    played.voices.size() -
    (played.drums.empty() ? 0 : 1)
  corpus.band_voices(arrangement).map(fn (v) {
    let own = played.voices.index_of(v.voice)
    {
      voice: v.voice,
      parts: [
        ...(v.plays.contains("melody") ? [0] : []),
        ...v.parts.map(|p| names.slice(0, band_at).index_of(p)).filter(|i| i >= 0),
        ...(own < 0 ? [] : [band_at + own]),
      ],
    }
  })
}

# Every song's score plays the notes the song does, in the same order: each
# voice strikes the pitches the parts it plays on do, and each drum is hit
# where the drum part hits it, with the repeats and endings taken. (Kauai's
# times are seconds, with swing and articulations in them, so the order is
# what is compared.)
@test
fn every_score_plays_the_notes_of_its_song() {
  for path in corpus.SONGS {
    let (score, doc) = (written(path).score, written(path).doc)
    let names = part_names(doc)
    let parts = doc.find_all("part")
    let order = played_order(parts[0].find_all("measure"))
    let events = corpus.events_of(path, score.arrangement)
    let voices = voice_parts(score.arrangement, score.played, names)
    assert_true(
      voices.any(|v| v.parts.contains(0)),
      "{path} has a melody voice",
    )
    for v in voices {
      let played = events
        .filter(|e| e.by == v.voice)
        .sorted_by(|e| (e.at, e.pitch))
        .map(|e| e.pitch)
      let written = v
        .parts
        .flat_map(|i| struck(parts[i], order))
        .sorted_by(|x| (x[0], x[1]))
        .map(|x| x[1])
      assert_eq(
        written,
        played,
        "{path}: {v.voice} plays {v.parts.map(|i| names[i])}",
      )
    }
    continue if score.played.drums.empty()
    let named = doc
      .find_all("part-list/score-part")[-1]
      .find_all("score-instrument")
      .map(|s| (s.attrs.id, s.text("instrument-name")))
      .to_object()
    let heard = events
      .filter(|e| score.played.drums.contains(e.by))
      .sorted_by(|e| (e.at, e.by))
      .map(|e| e.by)
    let drum = |n| n.find("rest") != nil
      ? nil
      : named[n.find("instrument").attrs.id]
    let drummed = struck(parts[-1], order, drum)
      .sorted_by(|x| (x[0], x[1]))
      .map(|x| x[1])
    assert_eq(drummed, heard, "{path}: the drums")
  }
}

# Every measure of every score lasts as long as its time signature says,
# but the pickup a song opens with; and every score is MusicXML 4.0 as its
# schema defines it, checked with xmllint where there is one.
@test
fn every_score_is_valid_musicxml_4() {
  for path in corpus.SONGS {
    for part in written(path).doc.find_all("part") {
      mut meter = [4, 4]
      for m in part.find_all("measure") {
        let time = m.find("attributes/time")
        meter = [
          to_long(time.text("beats")),
          to_long(time.text("beat-type")),
        ] if time != nil
        continue if m.attrs.get("implicit", nil) == "yes"
        let filled = m
          .find_all("note")
          .filter(|n| n.find("chord") == nil && n.find("grace") == nil)
          .map(|n| to_long(n.text("duration")))
          .sum()
        assert_eq(
          filled,
          meter[0] * 1920 / meter[1],
          "{path}: {part.attrs.id} measure {m.attrs.number}",
        )
      }
    }
  }
  let found = try {
    Proc.run(["xmllint", "--version"]).ok
  } catch _ {
    false
  }
  return println("no xmllint, so the scores are not checked against the schema") if !found
  let dir = FS.mkdtemp("kauai_musicxml_")
  defer {
    FS.remove(dir, recursive: true)
  }
  let files = corpus.SONGS.map(fn (path) {
    let file = FS.join(dir, "{FS.stem(path)}.musicxml")
    FS.write(file, written(path).text)
    file
  })
  let r = Proc.run(
    [
      "xmllint",
      "--nonet",
      "--noout",
      "--schema",
      "{SCHEMA}/musicxml.xsd",
      ...files,
    ],
    env: {XML_CATALOG_FILES: "{SCHEMA}/catalog.xml"},
  )
  assert_true(r.ok, r.stderr)

  # An .mxl holds the score, which its container names first.
  let score = written(corpus.SONGS[0]).text
  let zip = Dir.zip(bytes: mx.mxl(score))
  let container = FS.join(dir, "container.xml")
  FS.write(container, zip.read("META-INF/container.xml"))
  let named = XML
    .parse(zip.read("META-INF/container.xml"))
    .find("rootfiles/rootfile")
  assert_eq(zip.read(named.attrs["full-path"]), score)
  let c = Proc.run([
    "xmllint",
    "--nonet",
    "--noout",
    "--schema",
    "{SCHEMA}/container.xsd",
    container,
  ])
  assert_true(c.ok, c.stderr)
}

# --- what a score writes ---------------------------------------------------------

let BAND = 'band B {
  voice Lead  pulse  plays melody  poly  vol 20
}

'

# Song text (its song and sections, after `band`, by default one voice) as
# the score's document.
fn scored(text, band = BAND) {
  XML.parse(mx.write(Audio.Kauai.parse(band + text)))
}

let notes = |m| m.find_all("note")

@test
fn notes_show_their_accidentals_ties_and_tuplets() {
  let doc = scored('song S {
  tempo 120
  key F
  band B
  melody in C4..B4

  A
}

section A {
  F    bb4 b b f#~
  C    f#2 3[e8 d c] .~<c e g>4
  G    (\fall !g4 a) @r2
}
')
  let (
    one,
    two,
    three,
  ) = (
    doc.find("part/measure[1]"),
    doc.find("part/measure[2]"),
    doc.find("part/measure[3]"),
  )
  assert_eq(one.find("attributes/clef").children.map(|c| c.text()), ["G", "2"])
  assert_eq(one.find("attributes/time").children.map(|c| c.text()), ["4", "4"])
  let shown = |n| n.text("accidental")
  assert_eq(notes(one).map(shown), [nil, "natural", nil, "sharp"])
  assert_eq(notes(one)[3].find("tie").attrs, {type: "start"})
  assert_eq(notes(one)[3].find("notations/tied").attrs, {type: "start"})
  let held = notes(two)[0]
  assert_eq(held.find("tie").attrs, {type: "stop"})
  assert_eq(held.find("notations/tied").attrs, {type: "stop"})
  assert_eq(shown(held), nil, "a note a tie holds shows no accidental")
  let triplet = notes(two).slice(1, 4)
  assert_eq(triplet.map(|n| n.text("duration")), ["160", "160", "160"])
  assert_eq(
    triplet.map(|n| [
      n.text("time-modification/actual-notes"),
      n.text("time-modification/normal-notes"),
    ]),
    [["3", "2"], ["3", "2"], ["3", "2"]],
  )
  assert_eq(triplet[0].find("notations/tuplet").attrs.type, "start")
  assert_eq(triplet[2].find("notations/tuplet").attrs.type, "stop")
  let chord = notes(two).slice(4, 7)
  assert_eq(chord.map(|n| n.find("chord") != nil), [false, true, true])
  assert_eq(
    chord.map(|n| n.find("notations/arpeggiate") != nil),
    [true, true, true],
  )
  assert_eq(
    chord.map(|n| n.find("notations/articulations/staccato") != nil),
    [true, false, false],
  )
  let (g, a, rest) = (notes(three)[0], notes(three)[1], notes(three)[2])
  assert_eq(
    g.find("notations/articulations").children.map(|c| c.tag),
    ["accent", "falloff"],
  )
  assert_eq(g.find("notations/slur").attrs, {type: "start", number: "1"})
  assert_eq(a.find("notations/slur").attrs, {type: "stop", number: "1"})
  assert_true(rest.find("notations/fermata") != nil, "a fermata over a rest")
}

@test
fn chords_are_harmony_with_their_kind_and_degrees() {
  let doc = scored('song S {
  tempo 120
  band B
  melody in C4..B4

  A
}

section A {
  F Gm7         c2 d
  C7(b9)/E      c1
  Bb6/9 / N.C. /  c1
}
')
  let h = doc.find_all("part/measure/harmony")
  let said = |x| [
    x.text("root/root-step"),
    x.text("root/root-alter"),
    x.text("kind"),
    x.find("kind").attrs.text,
    x.text("bass/bass-step"),
  ]
  assert_eq(
    h.map(said),
    [
      ["F", nil, "major", "", nil],
      ["G", nil, "minor-seventh", "m7", nil],
      ["C", nil, "dominant", "7(b9)", "E"],
      ["B", "-1", "major-sixth", "6/9", nil],
      ["C", nil, "none", "N.C.", nil],
    ],
  )
  let degrees = |x| x
    .find_all("degree")
    .map(|d| [
      d.text("degree-value"),
      d.text("degree-alter"),
      d.text("degree-type"),
    ])
  assert_eq(degrees(h[2]), [["9", "-1", "add"]])
  assert_eq(degrees(h[3]), [["9", "0", "add"]])
  assert_eq(
    h[4].text("offset"),
    "960",
    "N.C. comes in halfway through the whole note",
  )
  assert_eq(
    doc
      .find("part/measure[1]")
      .children
      .filter(|c| c.tag == "harmony" || c.tag == "note")
      .map(|c| c.tag),
    ["harmony", "note", "harmony", "note"],
  )
}

@test
fn the_form_folds_where_every_time_is_the_same() {
  let doc = scored('song S {
  tempo 120
  band B
  melody in C4..B4

  A x3
  B ending 1
  B ending 2
  C x2
}

section A {
  C    c1
}

section B {
  F    f1
  ending 1 {
    G  g1
  }
  ending 2 {
    C  c1
  }
}

section C {
  N.C. e1
  2nd: d1
}
')
  let ms = doc.find_all("part/measure")
  assert_eq(ms.size(), 6, "A once, B with its two endings, C twice")
  let at = |m, path| m.find(path)?.attrs
  assert_eq(
    at(ms[0], "barline[@location='left']/repeat"),
    {direction: "forward"},
  )
  assert_eq(
    at(ms[0], "barline[@location='right']/repeat"),
    {direction: "backward", times: "3"},
  )
  assert_eq(
    at(ms[1], "barline[@location='left']/repeat"),
    {direction: "forward"},
  )
  assert_eq(
    at(ms[2], "barline[@location='left']/ending"),
    {number: "1", type: "start"},
  )
  assert_eq(
    at(ms[2], "barline[@location='right']/ending"),
    {number: "1", type: "stop"},
  )
  assert_eq(
    at(ms[2], "barline[@location='right']/repeat"),
    {direction: "backward"},
  )
  assert_eq(
    at(ms[3], "barline[@location='left']/ending"),
    {number: "2", type: "start"},
  )
  assert_eq(
    at(ms[3], "barline[@location='right']/ending"),
    {number: "2", type: "discontinue"},
  )
  assert_eq(
    ms.map(|m| m.text("direction/direction-type/rehearsal")),
    ["A", "B", nil, nil, "C", "C"],
  )
  assert_eq(
    ms.slice(4, 6).map(|m| m.find("barline/repeat")),
    [nil, nil],
    "C changes the second time, so it is written out",
  )
  let chord = |m| m.find("harmony") == nil
    ? nil
    : m.text("harmony/root/root-step") + " " + m.text("harmony/kind")
  assert_eq(
    ms.map(chord),
    ["C major", "F major", "G major", "C major", "C none", "C none"],
    "each pass and ending names its chord, N.C. too",
  )
  assert_eq(ms[0].text("barline[@location='left']/bar-style"), "heavy-light")
}

@test
fn endings_start_where_the_times_start_to_differ() {
  let doc = scored('song S {
  tempo 120
  band B
  melody in C4..B4

  A x2
  B ending 1
  B ending 2
  C x2
  D ending 1
  D ending 2
  E x3
}

section A {
  C    c1
  C    d1
  C    e1
  C    f1
    2nd: g1
}

section B {
  F    f1
  F    g1
    2nd: a1
  ending 1 {
    G  g1
  }
  ending 2 {
    C  c1
  }
}

section C {
  C    c1
  C    d1
    2nd: f1
  C    e1
  C    g1
}

section D {
  ending 1 {
    C  c1
  }
  ending 2 {
    F  f1
  }
}

section E {
  C    c1
  C    d1
    3rd: e1
}
')
  let ms = doc.find_all("part/measure")
  let marks = |m| m
    .find_all("barline/*")
    .filter(|e| e.tag == "repeat" || e.tag == "ending")
    .map(|e| "{e.tag} {e.attrs.get("direction", nil) ?? e.attrs.type}")
  assert_eq(
    ms.slice(0, 5).map(marks),
    [
      ["repeat forward"],
      [],
      [],
      ["ending start", "ending stop", "repeat backward"],
      ["ending start", "ending discontinue"],
    ],
    "A's last bar differs the second time, so it is in endings",
  )
  assert_eq(
    ms.slice(0, 5).map(|m| m.find("harmony") != nil),
    [true, false, false, true, true],
    "an ending names its chord where it starts",
  )
  assert_eq(
    ms.slice(5, 10).map(marks),
    [
      ["repeat forward"],
      ["ending start"],
      ["ending stop", "repeat backward"],
      ["ending start"],
      ["ending discontinue"],
    ],
    "B's endings start a bar before the section's own, where the times differ",
  )
  assert_true(ms[6].find("harmony") != nil)
  assert_eq(
    ms.slice(10, 20).flat_map(marks),
    [],
    "C differs in its second bar, more than half of it, and D has no body: both written out",
  )
  let ending = |m| m.find("barline[@location='left']/ending")?.attrs?.number
  assert_eq(
    ms
      .slice(20, ms.size())
      .map(|m| [ending(m), m.find("barline/repeat")?.attrs]),
    [
      [nil, {direction: "forward"}],
      ["1, 2", {direction: "backward", times: "3"}],
      ["3", nil],
    ],
    "E's first two times end the same, its third differently",
  )
  assert_eq(ms.size(), 23)
}

let JUMPS_TO = 'section A {
  C    c2. r4
}

section B {
  F    f1
  G    g1
}

section C {
  Am   a2. r4
}

section D {
  C    c2 e
}

section P {
  pickup  g4
  C    c1
}

section S {
  C    \tempo 90 c1
}
'

let JUMP_KINDS = ["segno", "coda", "dacapo", "dalsegno", "tocoda", "fine"]

# The order a score's first part shows: each measure's number and the
# signs and jumps (the words of them) it has, a segno or a coda first.
fn jumps_shown(doc) {
  doc.find_all("part")[0].find_all("measure").map(fn (m) {
    let shown = m.find_all("direction").flat_map(fn (d) {
      let s = d.find("sound")
      return [] if s == nil
      let sign = d.find("direction-type/segno") ?? d.find("direction-type/coda")
      let k = JUMP_KINDS.find(|x| s.attrs.has(x))
      return [] if k == nil
      ["{sign?.tag ?? d.text("direction-type/words")}={k}:{s.attrs[k]}"]
    })
    [m.attrs.number, ...shown]
  })
}

# A song whose last times play again, as they are, times it played before
# is written with a jump back: a D.C. from its start or a D.S. from a segno,
# to its end (al Fine) or to a coda after the times played again. A jump
# goes back where nothing would play twice: not to the pickup a song opens
# with, and not in a song that loops.
@test
fn a_song_played_again_jumps_back() {
  let song = |plays| scored("song S \{\n  tempo 120\n  band B\n  melody in C4..B4\n{plays}\n}\n\n" +
    JUMPS_TO)
  assert_eq(
    jumps_shown(song("\n  A\n  B\n  A")),
    [["1", "Fine=fine:yes"], ["2"], ["3", "D.C. al Fine=dacapo:yes"]],
  )
  assert_eq(
    jumps_shown(song("\n  A\n  B\n  C\n  B\n  D")),
    [
      ["1"],
      ["2", "segno=segno:segno"],
      ["3", "To Coda=tocoda:coda"],
      ["4", "D.S. al Coda=dalsegno:segno"],
      ["5", "coda=coda:coda"],
    ],
  )
  assert_eq(
    jumps_shown(song("\n  A\n  B\n  A\n  B")),
    [["1"], ["2"], ["3", "D.C.=dacapo:yes"]],
    "back to the start and on to the end",
  )
  assert_eq(
    jumps_shown(song("\n  A\n  B\n  A\n  B\n  C")),
    [
      ["1"],
      ["2", "segno=segno:segno"],
      ["3", "To Coda=tocoda:coda"],
      ["4", "D.S. al Coda=dalsegno:segno"],
      ["5", "coda=coda:coda"],
    ],
    "a coda after the bar it is jumped to from, not that bar's own",
  )
  assert_eq(
    jumps_shown(song("\n  A\n  P\n  C\n  P")),
    [
      ["1"],
      ["2", "segno=segno:segno", "Fine=fine:yes"],
      ["3", "D.S. al Fine=dalsegno:segno"],
    ],
    "the bar before the segno holds the pickup, as the one before the D.S. does",
  )
  assert_eq(
    jumps_shown(song("\n  P\n  C\n  P")).size(),
    4,
    "no D.C. to the pickup a song opens with",
  )
  assert_eq(
    jumps_shown(song("\n  A\n  S\n  A")).size(),
    3,
    "nor back to a tempo the music is not in",
  )
  assert_eq(
    jumps_shown(song("  loop\n\n  A\n  B\n  A")).size(),
    4,
    "no jump in a song that loops",
  )
}

@test
fn a_pickup_opens_the_song_or_goes_into_the_bar_before_it() {
  let doc = scored('song S {
  tempo 120
  key F
  band B
  melody in C4..B4

  A
  A in D
}

section A {
  pickup  c8 d
  F    e2. r4
  C    c2. r4
}
')
  let ms = doc.find_all("part/measure")
  assert_eq(ms[0].attrs, {number: "0", implicit: "yes"})
  let named = |n| n.text("rest") != nil
    ? "r"
    : n.text("pitch/step") +
      ["bb", "b", "", "#", "##"][to_long(n.text("pitch/alter") ?? "0") + 2] +
      n.text("pitch/octave")
  assert_eq(notes(ms[0]).map(named), ["C4", "D4"])
  assert_eq(
    notes(ms[2]).map(named),
    ["C4", "A3", "B3"],
    "the second time's pickup, moved down to D, in place of the rest",
  )
  assert_eq(ms[3].text("attributes/key/fifths"), "2")
  assert_eq(notes(ms[3]).map(named), ["C#4", "r"])
  assert_eq(
    ms[3].text("note/accidental"),
    nil,
    "D's key signature has the sharp",
  )
  assert_eq(ms[3].text("harmony/root/root-step"), "D")
  # A pickup of a dotted thirty-second leaves a sixty-fourth's rest before it.
  let short = scored('song S {
  tempo 120
  band B
  melody in C4..B4

  A x2
}

section A {
  pickup  b32.
  C    c2. r4
}
')
  let two = short.find_all("part/measure")[1]
  assert_eq(
    notes(two).map(|n| n.text("type")),
    ["half", "eighth", "16th", "64th", "32nd"],
  )
}

# An ending played `as written` keeps the key it is written in, where `in`
# moves its section's body.
@test
fn an_ending_as_written_keeps_its_key() {
  let ms = scored('song S {
  tempo 120
  band B
  melody in C4..B4

  A ending 1 in D
}

section A {
  C    c1
  ending 1 as written {
    G    g1
  }
}
').find_all("part/measure")
  assert_eq(ms.map(|m| m.text("attributes/key/fifths")), ["2", "0"])
  assert_eq(notes(ms[1]).map(|n| n.text("pitch/step")), ["G"])
}

@test
fn directions_say_how_it_plays() {
  let doc = scored('song S {
  tempo 4.=60
  meter 6/8
  swing 8
  band B
  melody in C4..B4

  A
}

section A {
  C   \p c4. \cresc d4.
  C   e4. \f f4.
  C   \rit 50 g4. a4.
  C   \tempo \dim b4. \pp a4.
}
')
  let ms = doc.find_all("part/measure")
  let one = ms[0]
  assert_eq(one.text("direction/direction-type/metronome/beat-unit"), "quarter")
  assert_true(one.find("direction/direction-type/metronome/beat-unit-dot") !=
    nil)
  assert_eq(
    one.find("direction/sound[@tempo]").attrs,
    {tempo: "90"},
    "60 dotted quarters are 90 quarters",
  )
  assert_eq(
    one.find("direction/sound/swing").children.map(|c| [c.tag, c.text()]),
    [["first", "2"], ["second", "1"], ["swing-type", "eighth"]],
  )
  assert_eq(one.find("direction/sound[@dynamics]").attrs, {dynamics: "55"})
  assert_eq(
    one.find("direction/direction-type/wedge").attrs,
    {type: "crescendo"},
  )
  let two = ms[1].find_all("direction")
  assert_eq(
    two.map(|d| d.find("direction-type").children[0].tag),
    ["wedge", "dynamics"],
    "the hairpin ends at the f",
  )
  assert_eq(
    ms[2].find("direction").find_all("direction-type").map(|t| t.children[0]),
    [
      {tag: "words", ns: nil, attrs: {}, children: ["rit."]},
      {tag: "dashes", ns: nil, attrs: {type: "start"}, children: []},
    ],
  )
  let four = ms[3].find_all("direction")
  assert_eq(four[0].find("direction-type/dashes").attrs, {type: "stop"})
  assert_eq(four[1].text("direction-type/words"), "a tempo")
  assert_eq(four[1].find("sound").attrs, {tempo: "90"})
  assert_eq(
    four
      .slice(2, 5)
      .map(|d| d.find("direction-type").children[0])
      .map(|t| [t.tag, t.attrs.get("type", nil)]),
    [["wedge", "diminuendo"], ["wedge", "stop"], ["dynamics", nil]],
  )
}

@test
fn a_repeat_sign_and_the_songs_about() {
  let doc = scored('about {
  title     The Tune
  composer  Someone
  year      1902
}

song S {
  tempo 120
  band B
  melody in C3..B3

  A
}

section A {
  C    c4 d e f
  %
  meter 3/4
  G    g2.
}
')
  let ms = doc.find_all("part/measure")
  assert_eq(
    ms[1].find("attributes/measure-style/measure-repeat").attrs,
    {type: "start"},
  )
  assert_eq(ms[1].text("attributes/measure-style/measure-repeat"), "1")
  assert_eq(
    ms[2].find("attributes/measure-style/measure-repeat").attrs,
    {type: "stop"},
  )
  assert_eq(notes(ms[1]).size(), 4, "a repeated measure still holds its notes")
  assert_eq(
    ms.map(|m| m.find("attributes/time")?.children?.map(|c| c.text())),
    [["4", "4"], nil, ["3", "4"]],
  )
  assert_eq(
    ms[0].find("attributes/clef").children.map(|c| c.text()),
    ["F", "4"],
    "a melody below middle C",
  )
  assert_eq(doc.text("work/work-title"), "The Tune")
  assert_eq(doc.find("identification/creator").attrs, {type: "composer"})
  assert_eq(doc.text("identification/creator"), "Someone")
  assert_eq(
    doc.text("identification/miscellaneous/miscellaneous-field[@name='year']"),
    "1902",
  )
}

# --- the band ----------------------------------------------------------------------

let COMBO = 'band Combo {
  voice Lead  pulse        plays melody                vol 20
  voice Echo  pulse2                                   vol 9
  voice Bass  triangle     plays roots in E2..D#3      vol 18
  voice Keys  external Ep  plays chords from C4  poly  vol 7
  Echo echoes Lead  late 1/8  level 70%
  drum Kick     noise 120   len 1  vol 20  env 0 3 2
  drum Hat      noise 3000  len 1  vol 5   env 0 0 1
  drum Cowbell  noise 2000  len 1  vol 5   env 0 0 1  plays hits
}

'

let combo = |text| scored(text, COMBO)

# The measures of the part named `name`.
fn part_measures(doc, name) {
  doc.find_all("part")[part_names(doc).index_of(name)].find_all("measure")
}

let SIGNS = {"1": "#", "-1": "b"}

# Note `n` as its pitch ("F#4") or "r", a "~" after a tie's start.
fn pitch_text(n) {
  return "r" if n.find("rest") != nil
  let sign = SIGNS.get(n.text("pitch/alter") ?? "0", "")
  let tie = n.find("tie[@type='start']") == nil ? "" : "~"
  "{n.text("pitch/step")}{sign}{n.text("pitch/octave")}{tie}"
}

# A measure's notes as [pitch or "r", type].
let heard = |m| notes(m).map(|n| [pitch_text(n), n.text("type")])

@test
fn the_band_plays_on_staves_of_its_own() {
  let doc = combo('song Band {
  tempo 120
  band Combo
  groove Pocket
  melody in C4..B4

  A
  A with echo
}

groove Pocket {
  Bass  1 1 - 1  . . 1 -  8 - - -  > - - - | 1 - - -  - - - - | - - - -  . . . .
  Keys  x x x  x x x  x x x  x x x | . . . . | x - - -
}

section A {
  C7   d4 e f# g
  E    a1
  Ab   r1
}
')
  assert_eq(
    part_names(doc),
    ["Melody", "Echo", "Bass", "Keys"],
    "a voice's staff where it plays, and no drums where none is hit",
  )
  let clef = |name| part_measures(doc, name)[0].text("attributes/clef/sign")
  assert_eq(["Echo", "Bass", "Keys"].map(clef), ["G", "F", "G"])
  let bass = part_measures(doc, "Bass")
  assert_eq(
    heard(bass[0]),
    [
      ["C3", "16th"],
      ["C3", "eighth"],
      ["C3", "16th"],
      ["r", "eighth"],
      ["C3", "eighth"],
      ["C4", "quarter"],
      ["D#2", "quarter"],
    ],
    "an eighth a 16th into the beat, and an approach spelled the way it goes, D sharp up to E",
  )
  assert_eq(heard(bass[1]), [["E2~", "whole"]], "a note held over the bar line")
  assert_eq(heard(bass[2]), [["E2", "half"], ["r", "half"]])
  let keys = part_measures(doc, "Keys")
  assert_eq(notes(keys[0]).size(), 48)
  assert_eq(
    heard(keys[0]).slice(0, 4),
    [["C4", "eighth"], ["E4", "eighth"], ["G4", "eighth"], ["Bb4", "eighth"]],
  )
  assert_eq(
    heard(keys[2]),
    [["Ab4", "whole"], ["C5", "whole"], ["Eb5", "whole"], ["Ab5", "whole"]],
    "a chord's tones spelled from its root, A flat where the key would have G sharp",
  )
  assert_true(
    notes(keys[0]).all(|n| n.text("time-modification/actual-notes") == "3" &&
      n.text("time-modification/normal-notes") == "2"),
    "twelve steps in a bar are triplets",
  )
  assert_eq(keys[0].find_all("note/notations/tuplet[@type='start']").size(), 4)
  assert_true(keys[1].find("note/rest[@measure='yes']") != nil)
  let echo = part_measures(doc, "Echo")
  assert_eq(
    echo.size(),
    6,
    "the passes differ in the echo, so both are written",
  )
  assert_true(echo[0].find("note/rest[@measure='yes']") != nil)
  assert_eq(
    heard(echo[3]).map(|n| n[0]),
    ["r", "D4~", "D4", "E4~", "E4", "F#4~", "F#4", "G4~"],
    "an eighth late, cut where each beat starts",
  )
  assert_eq(heard(echo[4])[0], ["G4", "eighth"])
}

let DYN = 'band Dyn {
  voice Lead  pulse     plays melody            vol 20
  voice Alto  pulse2    plays part Fill         vol 9
  voice Bass  triangle  plays roots in E2..D#3  vol 18
  voice Echo  saw                               vol 8
  Echo echoes Lead  late 1/8  level 70%
  drum Kick   noise 120  len 1  vol 20  env 0 3 2
}

'

let LOUD = 'song Loud {
  tempo 120
  band Dyn
  groove Pocket
  melody in C4..B4
  loop

  A
  A with echo
}

groove Pocket {
  Bass  1 - - -  - - - -  1 - - -  - - - -
  Kick  x... x... x... x...
}

section A {
  C    \p c4 \cresc d4 e2
  F    \f f4 g \dim a b \!
  C    \dim c4 \mp d e2
    Fill: \pp c4 d e f
}
'

# A measure's notes and the dynamics and hairpins between them, in order,
# each with how far from where it stands it is drawn.
let said = |m| m.children.filter(|c| c.tag == "note" ||
  c.find("direction-type/dynamics") != nil ||
  c.find("direction-type/wedge") != nil).map(fn (c) {
  return "note" if c.tag == "note"
  let t = c.find("direction-type").children[0]
  let offset = c.text("offset")
  (t.tag == "dynamics" ? t.children[0].tag : t.attrs.type) +
    (offset == nil ? "" : "@{offset}")
})

@test
fn the_band_plays_the_bar_lines_dynamics() {
  let doc = scored(LOUD, DYN)
  let bars = |name| part_measures(doc, name).slice(0, 3).map(said)
  assert_eq(
    bars("Bass"),
    [
      ["p", "note", "crescendo@-480", "note"],
      ["stop", "f", "note", "diminuendo", "note", "stop"],
      ["diminuendo", "note", "stop@-480", "mp@-480", "note"],
    ],
    "each before the first note it reaches, drawn back to where it is; the last after the notes",
  )
  assert_eq(
    bars("Drums"),
    [
      ["p", "note", "crescendo", "note", "note", "note"],
      ["stop", "f", "note", "note", "diminuendo", "note", "note", "stop"],
      ["diminuendo", "note", "stop", "mp", "note", "note", "note"],
    ],
  )
  assert_eq(
    bars("Echo")[0],
    ["p", "crescendo@480", "note"],
    "before a measure's rest, drawn on to where they are",
  )
  assert_eq(
    bars("Fill")[2],
    ["pp", "note", "note", "note", "note"],
    "a part's staff has its own dynamics, not the bar line's",
  )
}

@test
fn with_and_loop_are_said_in_small_words() {
  let doc = scored(LOUD, DYN)
  let words = |m| m
    .find_all("direction/direction-type/words")
    .map(|w| [w.text(), w.attrs])
  let small = {"font-size": "9", "font-style": "italic"}
  let melody = part_measures(doc, "Melody")
  assert_eq(
    melody.map(words),
    [[], [], [], [["with echo", small]], [], [["loop", small]]],
  )
  let last = melody[-1].children
  assert_eq(
    [last[-3].tag, last[-2].text("direction-type/words"), last[-1].tag],
    ["note", "loop", "barline"],
    "the song starts again after its last note",
  )
  assert_true(
    part_names(doc)[1..].all(|name| part_measures(
      doc,
      name,
    ).all(|m| words(m).empty())),
    "only the melody's staff says them",
  )
}

@test
fn every_score_holds_its_song_as_kauai_text() {
  for path in corpus.SONGS {
    let w = written(path)
    assert_eq(
      w.doc.text("identification/miscellaneous/miscellaneous-field[@name='kauai-song']"),
      kau.write(w.score),
      path,
    )
  }
}

@test
fn the_band_is_spelled_by_its_key_and_chords_and_counted_in_beats() {
  let spelled = combo('song Spell {
  tempo 120
  key D
  band Combo
  groove Walk
  melody in C4..B4

  A
}

groove Walk {
  Bass  1 - - -  - - < -
  Keys  . . . x
}

section A {
  C / / Ab  d1
  F         d1
  Bb/Ab     d1
}
')
  assert_eq(
    heard(part_measures(spelled, "Keys")[0]),
    [
      ["r", "half"],
      ["r", "quarter"],
      ["Ab4", "quarter"],
      ["C5", "quarter"],
      ["Eb5", "quarter"],
      ["Ab5", "quarter"],
    ],
    "spelled from the chord of its beat",
  )
  let bass = part_measures(spelled, "Bass")
  assert_eq(
    heard(bass[0]),
    [["C3", "half"], ["F#2", "quarter"]],
    "the key's F sharp, though it goes down to F",
  )
  assert_eq(
    heard(bass[2]),
    [["Ab2", "half"], ["Ab2", "quarter"]],
    "a chord's bass as the chord writes it, A flat where the key would have G sharp",
  )
  let echoes = combo('song Echoes {
  tempo 120
  key A
  band Combo
  melody in C4..B4

  A with echo
  B with echo
}

section A {
  A   d#4 a c# e
}

section B key C {
  C   g#4 c e g
}
')
  let echo = part_measures(echoes, "Echo")
  assert_eq(
    heard(echo[0]).map(|n| n[0]),
    ["r", "D#4~", "D#4", "A4~", "A4", "C#4~", "C#4", "E4~"],
    "D sharp nearer A major than E flat",
  )
  assert_eq(
    heard(echo[1]).map(|n| n[0]),
    ["E4", "G#4~", "G#4", "C4~", "C4", "E4~", "E4", "G4"],
    "G sharp before A flat, as near C major; nothing tied past the end",
  )
  let lilt = combo('song Lilt {
  tempo 120
  meter 6/8
  band Combo
  groove Lilt
  melody in C4..B4

  A
}

groove Lilt {
  Bass  . . 1 - . .
}

section A {
  C   c2.
}
')
  assert_eq(
    heard(part_measures(lilt, "Bass")[0]),
    [["r", "quarter"], ["C3~", "eighth"], ["C3", "eighth"], ["r", "quarter"]],
    "6/8 counted in dotted quarters",
  )
}

@test
fn the_drums_play_on_a_drum_set() {
  let doc = combo('song Beat {
  tempo 120
  band Combo
  groove Beat
  melody in C4..B4

  A
}

groove Beat {
  Kick     x... .... x... ....
  Hat      ..x. ..x. .... ....
  Cowbell  .... .... .... x...
  Bass     - - - -  - - - -
}

section A {
  C   c1
  C   c1
    hits:  x4. !x8~ x2
  C   c1
}
')
  let part = doc.find_all("part-list/score-part")[-1]
  assert_eq(part.text("part-name"), "Drums")
  assert_eq(
    part
      .find_all("score-instrument")
      .map(|s| [s.attrs.id, s.text("instrument-name")]),
    [["P5-I1", "Kick"], ["P5-I2", "Hat"], ["P5-I3", "Cowbell"]],
  )
  assert_eq(
    part
      .find_all("midi-instrument")
      .map(|s| [s.attrs.id, s.text("midi-unpitched")]),
    [["P5-I1", "37"], ["P5-I2", "43"]],
    "General MIDI's keys, none for a drum the kit does not name",
  )
  let ms = part_measures(doc, "Drums")
  let drummed = |m| notes(m).map(|n| [
    n.find("rest") != nil
      ? "r"
      : "{n.text("unpitched/display-step")}{n.text("unpitched/display-octave")}",
    n.text("notehead"),
    n.text("type"),
    n.find("instrument")?.attrs?.id,
  ])
  assert_eq(ms[0].text("attributes/clef/sign"), "percussion")
  assert_eq(
    drummed(ms[0]),
    [
      ["F4", nil, "eighth", "P5-I1"],
      ["G5", "x", "eighth", "P5-I2"],
      ["r", nil, "eighth", nil],
      ["G5", "x", "eighth", "P5-I2"],
      ["F4", nil, "quarter", "P5-I1"],
      ["D5", nil, "quarter", "P5-I3"],
    ],
    "a hit lasts until the next one or the beat",
  )
  assert_eq(
    drummed(ms[1]),
    [
      ["D5", nil, "quarter", "P5-I3"],
      ["r", nil, "eighth", nil],
      ["D5", nil, "eighth", "P5-I3"],
      ["r", nil, "half", nil],
    ],
    "the drum that plays the hits, alone",
  )
  let accented = |m| notes(m).map(|n| n.find("notations/articulations/accent") !=
    nil)
  assert_eq(accented(ms[1]), [false, false, true, false])
  let bass = part_measures(doc, "Bass")
  assert_eq(
    heard(bass[1]),
    [["C3", "quarter"], ["C3~", "eighth"], ["C3~", "half"]],
    "the bass plays the hits too, the last held on by the groove's next bar",
  )
  assert_eq(
    accented(bass[1]),
    [false, true, false],
    "an accent on a note's first value",
  )
  assert_eq(heard(bass[2]), [["C3", "whole"]])
  assert_eq(accented(bass[2]), [false], "and not where a tie holds it on")
}

# A song's hits are slashes on a one-line staff of their own, after its
# parts: as each time plays them, a break's rest seen and a bar with none
# an unseen one.
@test
fn hits_are_slashes_on_a_staff_of_their_own() {
  let doc = scored('song S {
  tempo 120
  band B
  melody in C4..B4

  A x2
}

section A {
  C   c1
    hits:  x4. !x8~ x2
  C   c1
    2nd hits:  r1
  C   c1
}
')
  assert_eq(part_names(doc), ["Melody", "Hits"])
  let ms = part_measures(doc, "Hits")
  assert_eq(ms[0].text("attributes/clef/sign"), "percussion")
  assert_eq(ms[0].text("attributes/staff-details/staff-lines"), "1")
  let slashed = |m| notes(m).map(|n| [
    n.find("rest") != nil
      ? "r"
      : "{n.text("unpitched/display-step")}{n.text("unpitched/display-octave")}",
    n.text("notehead"),
    n.text("type"),
    n.find_all("tie").map(|t| t.attrs.type),
    n.find("notations/articulations/accent") != nil,
    n.find("rest")?.attrs?.get("measure", nil),
    n.attrs.get("print-object", nil),
  ])
  assert_eq(
    slashed(ms[0]),
    [
      ["B4", "slash", "quarter", [], false, nil, nil],
      ["B4", "slash", "eighth", ["start"], true, nil, nil],
      ["B4", "slash", "half", ["stop"], false, nil, nil],
    ],
  )
  assert_eq(
    slashed(ms[1]),
    [["r", nil, nil, [], false, "yes", "no"]],
    "a bar with no hits",
  )
  assert_eq(ms.size(), 6, "the times written out, as the 2nd plays a break")
  assert_eq(
    slashed(ms[4]),
    [["r", nil, "whole", [], false, nil, nil]],
    "a break",
  )
}

@test
fn a_band_folds_and_repeats_a_bar_where_it_plays_the_same() {
  let doc = combo('song Form {
  tempo 120
  band Combo
  groove One
  melody in C4..B4

  A x2
  B
}

groove One {
  Bass  1 . . .  . . 1 -
}

groove Two {
  Bass  1 - - -  - - - - | 5 - - -  - - - -
}

section A {
  C   c1
}

section B {
  groove Two
  F   f1
  %
}
')
  assert_eq(
    part_names(doc),
    ["Melody", "Bass"],
    "a staff for a voice that plays",
  )
  let (
    melody,
    bass,
  ) = (part_measures(doc, "Melody"), part_measures(doc, "Bass"))
  assert_eq(melody.size(), 3, "A's two times are one in repeat signs")
  assert_eq(
    heard(bass[0]),
    [
      ["C3", "eighth"],
      ["r", "eighth"],
      ["r", "quarter"],
      ["r", "quarter"],
      ["C3", "quarter"],
    ],
    "a rest starts where its own value falls, no half on the second beat",
  )
  assert_true(bass[0].find("barline/repeat[@direction='forward']") != nil)
  assert_true(bass[0].find("barline/repeat[@direction='backward']") != nil)
  assert_eq(melody[2].text("attributes/measure-style/measure-repeat"), "1")
  assert_eq(
    bass[2].find("attributes/measure-style"),
    nil,
    "the bass plays the groove's next bar",
  )
  assert_eq(heard(bass[2]), [["C3", "whole"]])
}
