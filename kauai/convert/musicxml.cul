# A Kauai song's score, as Kauai.parse gives it, as a MusicXML 4.0
# partwise score. The melody is the first part, each part the song writes
# out another, its hits on a staff of their own, then each voice of the
# band's that plays its grooves, echoes and harmonies, and a drum set for
# its drums; the chords are <harmony> over the melody. The song is written
# in the order it plays, a section each time the song plays it, folded into
# repeat signs and endings where every time through is the same, and into a
# D.C. or D.S. where its last times play earlier ones again. The song's
# Kauai text goes with it, for what a score does not hold (its band, its
# sections and the order it plays them in), which
# kauai/convert/musicxml_read.cul reads back.

import music from './music.cul'
import kau from './kau.cul'

let WHOLE = music.WHOLE
let PC = music.PC
let units = music.units
let number_text = music.number_text
let gcd = music.gcd
let tempo_text = music.tempo_text
let sounding = music.sounding
let LETTERS = ["C", "D", "E", "F", "G", "A", "B"]
let FIFTHS = {F: -1, C: 0, G: 1, D: 2, A: 3, E: 4, B: 5}
# A dynamic's level as <sound dynamics> gives it, a percent of forte.
let LEVELS = {pp: 40, p: 55, mp: 70, mf: 85, f: 100, ff: 115}
let WEDGES = {cresc: "crescendo", dim: "diminuendo"}
# A dynamic, a hairpin, or the `\!` that ends one.
let dynamic = |d| LEVELS.has(d) || WEDGES.has(d) || d == "!"
let TEMPOS = ["tempo", "rit", "accel"]
let PLAIN = {actual: 1, normal: 1}  # the time a note not in a tuplet plays in
let UNMOVED = {semis: 0, steps: 0}  # the interval a section played as written moves by
let HITS = "Hits"                   # the name of the hits' staff
let HIT = {step: "B", octave: 4}    # where a hit stands on that one-line staff
let DOCTYPE = '<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">'

# --- XML -----------------------------------------------------------------------

fn node(tag, children, attrs = {}) {
  {tag, attrs, children}
}

let leaf = |tag, value| node(tag, ["{value}"])

fn type_name(value) {
  match value {
    1 => "whole",
    2 => "half",
    4 => "quarter",
    8 => "eighth",
    16 => "16th",
    32 => "32nd",
    64 => "64th",
    _ => "128th",
  }
}

# --- spelling ------------------------------------------------------------------

let natural = |step, octave| 12 * (octave + 1) + PC[step]
let floor_div = |a, b| (a - Math.wrap(a, b)) / b
# The semitones from `b` to `a` the nearer way, -6 to 5.
let semis_from = |a, b| Math.wrap(a - b + 6, 12) - 6

# A key or a chord root ("Eb", "F#m", "Bb") as its letter, its alteration
# and whether it is minor.
fn spelled(name) {
  let minor = name.ends_with("m")
  let acc = name.slice(1, name.size() - (minor ? 1 : 0)).to_string()
  {
    step: name.slice(0, 1).to_string(),
    alter: acc.count("#") - acc.count("b"),
    minor,
  }
}

fn fifths_of(key) {
  let k = spelled(key)
  FIFTHS[k.step] + 7 * k.alter - (k.minor ? 3 : 0)
}

# The alteration key signature `key` gives each letter.
let key_alters = music.remembered(fn (key) {
  let n = fifths_of(key)
  let order = n >= 0
    ? ["F", "C", "G", "D", "A", "E", "B"]
    : ["B", "E", "A", "D", "G", "C", "F"]
  LETTERS
    .map(|s| (
      s,
      iota(Math.abs(n)).filter(|i| order[i % 7] == s).size() * Math.sign(n),
    ))
    .to_object()
})

# What `in` moves a section by, from key `from` to key `to`: the semitones,
# the smaller way and up to a tritone up as the song plays it, and the
# letters that spell them.
fn interval_of(from, to) {
  let (f, t) = (spelled(from), spelled(to))
  let up = Math.wrap(PC[t.step] + t.alter - PC[f.step] - f.alter, 12)
  let semis = up > 6 ? up - 12 : up
  let steps = Math.wrap(LETTERS.index_of(t.step) - LETTERS.index_of(f.step), 7)
  {semis, steps: [steps, steps - 7].min_by(|s| Math.abs(s * 12 - semis * 7))}
}

# Pitch `p` ({step, alter, octave}) moved by interval `iv`, spelled.
fn moved(p, iv) {
  let at = LETTERS.index_of(p.step) + iv.steps
  let step = LETTERS[Math.wrap(at, 7)]
  let octave = p.octave + floor_div(at, 7)
  {
    ...p,
    step,
    octave,
    alter: p.alter +
      iv.semis -
      natural(step, octave) +
      natural(p.step, p.octave),
  }
}

fn moved_name(name, iv) {
  let p = moved({...spelled(name), octave: 4}, iv)
  p.step + music.accidental(p.alter)
}

fn moved_items(items, iv) {
  items.map(|it| cond {
    it.has("items") => {...it, items: moved_items(it.items, iv)},
    it.has("pitches") => {
      ...it,
      pitches: it.pitches.map(|p| moved(p, iv)),
      graces: it.graces.map(|g| moved(g, iv)),
    },
    _ => it,
  })
}

fn moved_chord(c, iv) {
  return nil if c == nil
  let root = moved_name(c.root, iv)
  let bass = c.bass == nil ? nil : moved_name(c.bass, iv)
  {...c, ...music.chord(root, c.quality, bass)}
}

# --- chords ----------------------------------------------------------------------

# MusicXML's chord kinds, as their degrees and each one's semitones over the
# root. A dominant or major 13th leaves out the 11th, as charts mean it.
let KINDS = [
  {kind: "major", tones: [[3, 4], [5, 7]]},
  {kind: "minor", tones: [[3, 3], [5, 7]]},
  {kind: "augmented", tones: [[3, 4], [5, 8]]},
  {kind: "diminished", tones: [[3, 3], [5, 6]]},
  {kind: "suspended-second", tones: [[2, 2], [5, 7]]},
  {kind: "suspended-fourth", tones: [[4, 5], [5, 7]]},
  {kind: "dominant", tones: [[3, 4], [5, 7], [7, 10]]},
  {kind: "major-seventh", tones: [[3, 4], [5, 7], [7, 11]]},
  {kind: "minor-seventh", tones: [[3, 3], [5, 7], [7, 10]]},
  {kind: "diminished-seventh", tones: [[3, 3], [5, 6], [7, 9]]},
  {kind: "augmented-seventh", tones: [[3, 4], [5, 8], [7, 10]]},
  {kind: "half-diminished", tones: [[3, 3], [5, 6], [7, 10]]},
  {kind: "major-minor", tones: [[3, 3], [5, 7], [7, 11]]},
  {kind: "major-sixth", tones: [[3, 4], [5, 7], [6, 9]]},
  {kind: "minor-sixth", tones: [[3, 3], [5, 7], [6, 9]]},
  {kind: "dominant-ninth", tones: [[3, 4], [5, 7], [7, 10], [9, 14]]},
  {kind: "major-ninth", tones: [[3, 4], [5, 7], [7, 11], [9, 14]]},
  {kind: "minor-ninth", tones: [[3, 3], [5, 7], [7, 10], [9, 14]]},
  {kind: "dominant-11th", tones: [[3, 4], [5, 7], [7, 10], [9, 14], [11, 17]]},
  {kind: "major-11th", tones: [[3, 4], [5, 7], [7, 11], [9, 14], [11, 17]]},
  {kind: "minor-11th", tones: [[3, 3], [5, 7], [7, 10], [9, 14], [11, 17]]},
  {kind: "dominant-13th", tones: [[3, 4], [5, 7], [7, 10], [9, 14], [13, 21]]},
  {kind: "major-13th", tones: [[3, 4], [5, 7], [7, 11], [9, 14], [13, 21]]},
  {
    kind: "minor-13th",
    tones: [[3, 3], [5, 7], [7, 10], [9, 14], [11, 17], [13, 21]],
  },
  {kind: "power", tones: [[5, 7]]},
]

# A degree's semitones in a dominant seventh chord, which MusicXML alters an
# added degree from.
fn dominant(degree) {
  match degree {
    2 => 2,
    3 => 4,
    4 => 5,
    5 => 7,
    6 => 9,
    7 => 10,
    9 => 14,
    11 => 17,
    _ => 21,
  }
}

# A chord's `intervals` (semitones over its root) as [degree, semitones]: in
# the octave a third, fourth, fifth, sixth or seventh, and above it a ninth,
# eleventh or thirteenth. The root and its octaves are left out.
fn degrees_of(intervals) {
  let has = |i| intervals.contains(i)
  intervals.filter(|i| i % 12 != 0).map(fn (i) {
    let degree = match i {
      1 => 9,
      2 => 2,
      3 => has(4) ? 9 : 3,
      4 => 3,
      5 => 4,
      6 => has(7) ? 11 : 5,
      7 => 5,
      8 => has(7) ? 13 : 5,
      9 => has(3) && has(6) && !has(10) && !has(11) ? 7 : 6,
      10 | 11 => 7,
      _ => match i % 12 {
        1 | 2 | 3 => 9,
        4 => 3,
        5 | 6 => 11,
        7 => 5,
        8 | 9 => 13,
        _ => 7,
      },
    }
    [degree, i]
  })
}

# Chord `intervals` as MusicXML's kind and the degrees that add to it, alter
# it or take from it: the kind that needs the fewest, the first of those.
let kind_of = music.remembered(fn (intervals) {
  let tones = degrees_of(intervals)
  KINDS.map(fn (k) {
    let used = []
    let edits = []
    for t in k.tones {
      let at = iota(tones.size()).find(|i| !used.contains(i) &&
        tones[i][0] == t[0])
      if at == nil {
        edits.push({value: t[0], alter: 0, type: "subtract"})
      } else {
        used.push(at)
        let by = semis_from(tones[at][1], t[1])
        edits.push({value: t[0], alter: by, type: "alter"}) if by != 0
      }
    }
    for i in iota(tones.size()).filter(|i| !used.contains(i)) {
      edits.push({
        value: tones[i][0],
        alter: semis_from(tones[i][1], dominant(tones[i][0])),
        type: "add",
      })
    }
    {kind: k.kind, degrees: edits.sorted_by(|e| e.value)}
  }).min_by(|k| k.degrees.size())
})

fn alter_els(tag, alter) {
  alter == 0 ? [] : [leaf(tag, alter)]
}

# A chord's root or bass ("Bb") as element `tag`.
fn pitch_name_el(tag, name) {
  let n = spelled(name)
  node(tag, [leaf("{tag}-step", n.step), ...alter_els("{tag}-alter", n.alter)])
}

# Chord `c` (nil for N.C.) as <harmony>, `offset` after the note it is
# written before. Its kind's text is the quality as written, which says all
# its degrees do, so they are not printed.
fn harmony_el(c, offset) {
  let at = offset == 0 ? [] : [leaf("offset", offset)]
  if c == nil {
    return node(
      "harmony",
      [
        node("root", [node("root-step", ["C"], {text: ""})]),
        node("kind", ["none"], {text: "N.C."}),
        ...at,
      ],
    )
  }
  let k = kind_of(c.intervals)
  node(
    "harmony",
    [
      pitch_name_el("root", c.root),
      node("kind", [k.kind], {text: c.quality}),
      ...(c.bass == nil ? [] : [pitch_name_el("bass", c.bass)]),
      ...k.degrees.map(|d| (
      node("degree", [leaf("degree-value", d.value), leaf("degree-alter", d.alter), leaf("degree-type", d.type)], {"print-object": "no"})
    )),
      ...at,
    ],
  )
}

# --- the song as it plays ------------------------------------------------------

# Bar `b` (a song's) as the song plays it the `time`th time: its chords,
# melody, parts and hits.
fn as_played(b, time) {
  let t = b.times.find(|later| later.time == time)
  let changed = t?.parts ?? []
  {
    chords: t?.chords ?? b.chords,
    melody: t?.melody ?? b.melody,
    parts: [
      ...b.parts.map(|p| changed.find(|q| q.name == p.name) ?? p),
      ...changed.filter(|q| !b.parts.any(|p| p.name == q.name)),
    ].filter(|p| !p.notes.empty()),
    hits: t?.hits == nil ? b.hits : t.hits.empty() ? nil : t.hits,
  }
}

# Bar `b` as the song plays it the `time`th time, moved by `iv` (nil: as
# written) and in key `key`.
fn played_bar(b, time, iv, key) {
  let v = as_played(b, time)
  let move = |items| moved_items(items, iv)
  {
    meter: b.meter,
    swing: b.swing,
    key,
    repeat: b.repeat,
    chords: v.chords.map(|c| moved_chord(c, iv)),
    melody: move(v.melody),
    parts: v.parts.map(|p| {name: p.name, notes: move(p.notes)}),
    hits: v.hits,
  }
}

# Each time the song plays a section, in order: the section's name, its bars
# as they play that time (its ending's after its body's), how many of them
# are its body's, its pickup, and the derived part it plays `with`; and
# where it comes from: the index of its line in the song's plays, which time
# of the section's it is, its ending, and the interval `in` moves its pickup
# by (`iv`) and each of its bars (`moves`).
fn passes_of(score) {
  let song = score.song
  let sections = score.sections.map(|s| (s.name, s)).to_object()
  let played = {}
  iota(song.plays.size()).filter(|i| !song.plays[i].has("mark")).flat_map(fn (i) {
    let p = song.plays[i]
    let sec = sections[p.section]
    let written = sec.key ?? song.key
    let iv = interval_of(written, p.key ?? written)
    let key = p.key ?? written
    let ending = p.ending == nil
      ? nil
      : sec.endings.find(|e| e.number == p.ending)
    # An ending played as written is not moved.
    let as_written = ending?.as_written == true
    let ending_iv = as_written ? UNMOVED : iv
    let ending_bars = ending?.bars ?? []
    iota(p.times).map(fn (_) {
      played[p.section] = played.get(p.section, 0) + 1
      let time = played[p.section]
      let closing = ending_bars.map(|b| played_bar(
        b,
        time,
        ending_iv,
        as_written ? written : key,
      ))
      {
        section: sec.name,
        bars: [...sec.bars.map(|b| played_bar(b, time, iv, key)), ...closing],
        body: sec.bars.size(),
        pickup: sec.pickup == nil ? nil : moved_items(sec.pickup.melody, iv),
        with: p.with,
        play: i,
        time,
        ending: p.ending,
        iv,
        moves: [
          ...repeat(sec.bars.size(), iv),
          ...repeat(closing.size(), ending_iv),
        ],
      }
    })
  })
}

# The names of the parts the song writes out, in the order they first come.
fn part_names(score) {
  let bars = score.sections.flat_map(|s| [
    ...s.bars,
    ...s.endings.flat_map(|e| e.bars),
  ])
  bars
    .flat_map(|b| [...b.parts, ...b.times.flat_map(|t| t.parts)])
    .iter()
    .map(|p| p.name)
    .distinct()
    .collect()
}

# --- events --------------------------------------------------------------------

# A note or a rest at `at` units into its measure, `len` long as it sounds,
# in tuplets that make `ratio` of it; the tuplets it starts and stops, and
# what the part's notes around it join it to.
fn note_event(at, len, item, ratio) {
  {at, len, item, ratio, starts: [], stops: [], mut tied_from: [], slurs: []}
}

# A direction, a parameter or a slur's end, the hairpin or dashes it ends,
# and how far from where it stands it is drawn (a band's dynamic, which stands
# before the note it reaches).
fn mark_event(at, mark, offset = 0) {
  {at, mark, closes: [], offset}
}

fn put_events(items, st, ratio, depth) {
  for it in items {
    cond {
      it.has("items") => {
        let first = st.out.size()
        put_events(
          it.items,
          st,
          {
            actual: ratio.actual * it.tuplet.actual,
            normal: ratio.normal * it.tuplet.normal,
          },
          depth + 1,
        )
        let notes = st.out.slice(first, st.out.size()).filter(|e| e.has("len"))
        let bracket = {
          number: depth,
          actual: it.tuplet.actual,
          normal: it.tuplet.normal,
        }
        notes[0].starts.push(bracket)
        notes[-1].stops.push(bracket)
      },
      it.has("pitches") ||
        it.has("rest") ||
        it.has("drums") ||
        it.has("hit") => {
        let len = units(it) * ratio.normal / ratio.actual
        st.out.push(note_event(st.at, len, it, ratio))
        st.at += len
      },
      _ => st.out.push(mark_event(st.at, it)),
    }
  }
}

# A line of Kauai's notes (items) as events from the start of its bar.
fn events_of(items) {
  let st = {mut at: 0, out: []}
  put_events(items, st, PLAIN, 1)
  st.out
}

let length_of = |events| events.filter(|e| e.has("len")).map(|e| e.len).sum()

# The note values a span is written in, longest first: each plain, and
# dotted down to the sixty-fourth.
let VALUES = [
  1, 2, 4, 8, 16, 32, 64, 128,
].flat_map(|v| v == 128
  ? [{value: v, dots: 0}]
  : [{value: v, dots: 1}, {value: v, dots: 0}])

# Each value with its length and where a note of it may start: on a
# multiple of half its length (the eighth of 16th, eighth, 16th), a dotted
# one on a multiple of its dot's.
let SIZED = VALUES.map(|v| {
  v,
  len: units(v),
  grid: Math.max(WHOLE / 128, v.dots == 0 ? units(v) / 2 : units(v) / 3),
})

let rest_item = |v| {rest: true, ...v, marks: []}

# The values that fill `from` to `to` units, each the longest that fits and
# starts where it may: a rest, which is plain, on a multiple of its length.
fn values_between(from, to, rest) {
  let out = []
  mut at = from
  while at < to {
    let fit = SIZED.find(|s| s.len <= to - at &&
      (rest ? s.v.dots == 0 && at % s.len == 0 : at % s.grid == 0))
    throw "kauai convert: {to - at} units at {at} are not a note value" if fit ==
      nil
    out.push(fit.v)
    at += fit.len
  }
  out
}

# Rests from `from` to `to` units into a bar.
fn rests_between(from, to) {
  mut at = from
  values_between(from, to, true).map(fn (v) {
    let e = note_event(at, units(v), rest_item(v), PLAIN)
    at += units(v)
    e
  })
}

# Line `events` of a measure `len` long with pickup `notes` in place of the
# rests it ends with, which Kauai has the bar before a pickup keep.
fn with_pickup(events, len, notes, section) {
  let cut = len - length_of(notes)
  let past = events.filter(|e| e.has("len") && e.at + e.len > cut)
  if past.any(|e| !e.item.has("rest") || e.ratio != PLAIN) {
    throw "kauai convert: {section}'s pickup goes over rests in a tuplet, which a score cannot hold apart"
  }
  let kept = events.filter(|e| !e.has("len") || e.at + e.len <= cut)
  [
    ...kept,
    ...rests_between(length_of(kept), cut),
    ...notes.map(|e| ({...e, at: e.at + cut})),
  ]
}

# The song's measures in the order it plays them, each with the events of
# its lines (the melody's, then each part's, nil where the part is not
# written, then the hits' where the song has `hits`): a measure for the
# pickup the song opens with, then each pass's bars. A later pickup goes
# into the rests at the end of the measure before it.
fn measures_of(passes, names, hits) {
  let hits_line = |b| hits ? [b?.hits == nil ? nil : events_of(b.hits)] : []
  let out = []
  for i, pass in passes.enumerate() {
    if pass.pickup != nil {
      let notes = events_of(pass.pickup)
      if out.empty() {
        let b = pass.bars[0]
        out.push({
          pass: i,
          at: -1,
          len: length_of(notes),
          key: b.key,
          meter: b.meter,
          swing: b.swing,
          bar: nil,
          lines: [notes, ...names.map(|_| nil), ...hits_line(nil)],
          mut merged: false,
        })
      } else {
        let before = out[-1]
        before.lines[0] = with_pickup(
          before.lines[0],
          before.len,
          notes,
          pass.section,
        )
        before.merged = true
      }
    }
    for at, b in pass.bars.enumerate() {
      out.push({
        pass: i,
        at,
        len: b.meter.beats * WHOLE / b.meter.value,
        key: b.key,
        meter: b.meter,
        swing: b.swing,
        bar: b,
        lines: [
          events_of(b.melody),
          ...names.map(|n| b.parts.find(|p| p.name == n)?.notes).map(|notes| notes == nil ? nil : events_of(notes)),
          ...hits_line(b),
        ],
        mut merged: false,
      })
    }
  }
  out
}

let same_pitch = |p, q| sounding(p) == sounding(q)

# Joins the events of line `line` along the song, in the order it plays:
# each note to the notes its ties come from and to its slurs, and a direction
# to the hairpin or the dashes of a rit. it ends. One still open at the end
# ends there.
fn join_line(measures, line) {
  mut tied = []
  mut slur_next = false
  mut last = nil
  mut wedge = false
  mut dashes = false
  mut tail = nil  # the last measure the line is in
  for m in measures {
    let events = m.lines[line]
    if events == nil {
      tied = []
      continue
    }
    tail = m
    for e in events {
      cond {
        e.has("mark") && e.mark.has("slur") => {
          if e.mark.slur == "start" {
            slur_next = true
          } else {
            last.slurs.push("stop")
          }
        },
        e.has("mark") && e.mark.has("direction") => {
          let d = e.mark.direction
          if dynamic(d) {
            e.closes.push("wedge") if wedge
            wedge = WEDGES.has(d)
          }
          if TEMPOS.contains(d) {
            e.closes.push("dashes") if dashes
            dashes = d != "tempo"
          }
        },
        e.has("mark") => nil,
        e.item.has("pitches") => {
          e.tied_from = e.item.pitches.filter(|p| tied.any(|q| same_pitch(
            p,
            q,
          )))
          tied = e.item.pitches.filter(|p| p.tie)
          if slur_next {
            e.slurs.push("start")
            slur_next = false
          }
          last = e
        },
        e.item.has("hit") => {
          e.tied_from = tied
          tied = e.item.tie ? [e.item] : []
        },
        _ => nil,
      }
    }
  }
  let open = [...(wedge ? ["wedge"] : []), ...(dashes ? ["dashes"] : [])]
  if !open.empty() {
    let end = mark_event(tail.len, {})
    end.closes.extend(open)
    tail.lines[line].push(end)
  }
}

# The tempo direction in force where each measure starts, nil for the song's
# tempo.
fn tempos_at(measures) {
  let out = []
  mut now = nil
  for m in measures {
    out.push(now)
    let marks = m
      .lines
      .filter(|l| l != nil)
      .flat_map(|l| l.filter(|e| e.has("mark") &&
        e.mark.has("direction") &&
        TEMPOS.contains(e.mark.direction)))
    now = marks.empty() ? now : marks.max_by(|e| e.at).mark
  }
  out
}

# --- the band ------------------------------------------------------------------

# Where a drum set's drums stand on a percussion staff, their noteheads and
# their General MIDI keys, by the names Kauai's songs give them.
let KIT = {
  Kick: {step: "F", octave: 4, head: "normal", key: 36},
  Floor: {step: "A", octave: 4, head: "normal", key: 43},
  Snare: {step: "C", octave: 5, head: "normal", key: 38},
  Rim: {step: "C", octave: 5, head: "x", key: 37},
  Tom: {step: "E", octave: 5, head: "normal", key: 48},
  Ride: {step: "F", octave: 5, head: "x", key: 51},
  Hat: {step: "G", octave: 5, head: "x", key: 42},
  Open: {step: "G", octave: 5, head: "circle-x", key: 46},
  OpenHat: {step: "G", octave: 5, head: "circle-x", key: 46},
  Pedal: {step: "D", octave: 4, head: "x", key: 44},
  Crash: {step: "A", octave: 5, head: "x", key: 49},
}
# The places left for drums the kit does not name, in turn.
let SPARE = [
  {step: "D", octave: 5},
  {step: "B", octave: 4},
  {step: "G", octave: 4},
  {step: "E", octave: 4},
  {step: "B", octave: 5},
  {step: "C", octave: 6},
]

# The band's drums as a drum set, each {name, id, step, octave, head, key}:
# `id` its instrument's in part `part`, and `key` nil for a drum the kit
# does not name, which takes the next place left.
fn kit_of(drums, part) {
  mut spare = 0
  iota(drums.size()).map(fn (k) {
    let name = drums[k]
    let id = "{part}-I{k + 1}"
    if KIT.has(name) {
      return {name, id, ...KIT[name]}
    }
    let place = SPARE[spare % SPARE.size()]
    let head = ["normal", "triangle", "diamond"][spare / SPARE.size() % 3]
    spare += 1
    {name, id, ...place, head, key: nil}
  })
}

# The beat a measure in `meter` is counted in: a dotted one in 3/8, 6/8,
# 9/8 and 12/8, else the meter's own.
let beat_of = |meter| meter.value >= 8 && meter.beats % 3 == 0
  ? 3 * WHOLE / meter.value
  : WHOLE / meter.value

# MIDI pitch `p` spelled ({step, alter, octave}): as the tone of chord `c` it
# is (the chord's bass, else its degree over the root); else as key `key`'s
# letter; else, going a semitone `toward` the next note (1 up, -1 down, 0
# neither), sharp up and flat down, as an approach is; else as the letter
# nearest the key along the line of fifths, a sharp before a flat.
fn pitch_of(p, c, key, toward) {
  let pc = Math.wrap(p, 12)
  let pc_of = fn (name) {
    let n = spelled(name)
    Math.wrap(PC[n.step] + n.alter, 12)
  }
  let tone = fn () {
    return nil if c == nil
    return spelled(c.bass).step if c.bass != nil && pc_of(c.bass) == pc
    let root = spelled(c.root)
    let up = Math.wrap(pc - pc_of(c.root), 12)
    let degree = up == 0
      ? [1, 0]
      : degrees_of(c.intervals).find(|x| x[1] % 12 == up)
    degree == nil
      ? nil
      : LETTERS[Math.wrap(LETTERS.index_of(root.step) + degree[0] - 1, 7)]
  }
  let alter_of = |s| semis_from(pc, PC[s])
  let by_key = fn () {
    let near = LETTERS.filter(|s| Math.abs(alter_of(s)) <= 1)
    let alters = key_alters(key)
    let center = fifths_of(key) + 2
    near.find(|s| alter_of(s) == alters[s]) ??
      near.find(|s| toward != 0 && alter_of(s) == toward) ??
      near.min_by(|s| 2 * Math.abs(FIFTHS[s] + 7 * alter_of(s) - center) +
        (alter_of(s) > 0 ? 0 : 1))
  }
  let step = tone() ?? by_key()
  let alter = alter_of(step)
  {step, alter, octave: floor_div(p - alter - PC[step], 12) - 1}
}

# A measure's line of spans, each {from, to, sound, marks, tie} in units from
# its start (`tie` whether the last goes on into the next measure), as items
# that `item(sound, value, tie, marks)` makes, rests between them. A span is
# cut where a beat starts unless it starts on one, and a beat whose notes are
# not on a 128th's grid is a tuplet: its n cells written as m of a plain
# value, the most that fit in n.
fn notated(spans, meter, len, item) {
  return [] if spans.empty()
  let gap = |from, to| {from, to, sound: nil, marks: [], tie: false}
  let all = []
  mut at = 0
  for s in spans {
    all.push(gap(at, s.from)) if s.from > at
    all.push(s)
    at = s.to
  }
  all.push(gap(at, len)) if at < len
  let beat = beat_of(meter)
  let beats = iota((len + beat - 1) /
    beat).map(|k| (k * beat, Math.min(k * beat + beat, len)))
  let edges = all.map(|s| s.from)
  let tuplets = beats.map(fn (b) {
    let inside = edges.filter(|p| p > b[0] && p < b[1]).map(|p| p - b[0])
    return nil if inside.all(|p| p % (WHOLE / 128) == 0)
    let span = b[1] - b[0]
    let n = span / inside.reduce(span, gcd)
    let written = SIZED
      .filter(|s| s.v.dots == 0 && span % s.len == 0 && span / s.len <= n)
      .map(|s| s.len)
      .min()
    let d = gcd(n, span / written)
    {actual: n / d, normal: span / written / d, cell: span / n, written}
  })
  # The pieces in order, each a value of a span, in the tuplet of beat `beat`
  # or none.
  let pieces = []
  for s in all {
    mut p = s.from
    while p < s.to {
      let bi = p / beat
      let t = tuplets[bi]
      let (b0, b1) = beats[bi]
      let end = if t != nil {
        Math.min(s.to, b1)
      } else {
        let next = iota(bi + 1, beats.size()).find(|j| tuplets[j] != nil)
        let stop = next == nil ? len : beats[next][0]
        Math.min(s.to, p == b0 ? stop : b1, stop)
      }
      # Units as the tuplet writes them, from its beat's start.
      let as_written = |q| t == nil ? q : (q - b0) / t.cell * t.written
      let vs = values_between(as_written(p), as_written(end), s.sound == nil)
      for k, v in vs.enumerate() {
        let last = end == s.to && k == vs.size() - 1
        pieces.push({
          beat: t == nil ? nil : bi,
          item: s.sound == nil
            ? rest_item(v)
            : item(
              s.sound,
              v,
              !last || s.tie,
              p == s.from && k == 0 ? s.marks : [],
            ),
        })
      }
      p = end
    }
  }
  let out = []
  for k, piece in pieces.enumerate() {
    if piece.beat == nil {
      out.push(piece.item)
    } else if k > 0 && pieces[k - 1].beat == piece.beat {
      out[-1].items.push(piece.item)
    } else {
      let t = tuplets[piece.beat]
      out.push({
        tuplet: {actual: t.actual, normal: t.normal},
        items: [piece.item],
      })
    }
  }
  out
}

let pitched = |sound, v, tie, marks| {
  pitches: sound.map(|p| {...p, tie}),
  ...v,
  marks,
  graces: [],
  arpeggio: false,
}
let unpitched = |sound, v, tie, marks| {drums: sound, ...v, marks}

# A band line's `events` in a measure with the dynamics and hairpins of the
# measure's `melody` events, which a bar line writes for the whole band: each
# before the first note it reaches, the first to start at or after it, and
# drawn at its own time.
fn with_dynamics(events, melody) {
  let said = melody.filter(|e| dynamic(e.mark?.direction))
  let out = []
  mut k = 0
  for e in events {
    while k < said.size() && said[k].at <= e.at {
      out.push(mark_event(said[k].at, said[k].mark, said[k].at - e.at))
      k += 1
    }
    out.push(e)
  }
  # Those left stand at the end: after the last note, or before the
  # measure's rest an empty line gets.
  let end = length_of(events)
  [...out, ...said[k..].map(|d| mark_event(d.at, d.mark, d.at - end))]
}

# The chord measure `m` plays `at` units in, nil for none.
fn chord_in(m, at) {
  return nil if m.bar == nil
  let chords = m.bar.chords
  chords[Math.min(at / (WHOLE / m.meter.value), chords.size() - 1)]
}

# The band's lines along the measures, which are the bars it plays in order:
# each voice's, then its drums' on a drum set `kit` when it has any; each
# line its items in every measure. A voice is one line, so a note lasts until
# the next one starts; a drum's hit until the next hit or beat.
fn band_lines(played, measures, kit) {
  let bars = played.bars
  if bars.map(|b| b.len) != measures.map(|m| m.len) {
    throw "kauai convert: the band plays other bars than the score's"
  }
  let starts = []
  mut end = 0
  for m in measures {
    starts.push(end)
    end += m.len
  }
  let voice_line = fn (v) {
    let notes = iota(bars.size()).flat_map(|k| bars[k].voices[v].notes.map(|n| {
      ...n,
      at: starts[k] + n.at,
      m: measures[k],
      offset: n.at,
    }))
    let sounds = iota(notes.size()).map(fn (i) {
      let n = notes[i]
      let next = notes.get(i + 1, nil)
      let step = next != nil &&
        n.pitches.size() == 1 &&
        next.pitches.size() == 1
        ? next.pitches[0] - n.pitches[0]
        : 0
      let toward = Math.abs(step) == 1 ? step : 0
      {
        at: n.at,
        to: Math.min(n.at + n.len, next?.at ?? end),
        marks: n.marks,
        sound: n
          .pitches
          .sorted()
          .map(|p| pitch_of(p, chord_in(n.m, n.offset), n.m.key, toward)),
      }
    }).filter(|s| s.to > s.at)
    # The first sound that does not end before the measure.
    mut past = 0
    iota(measures.size()).map(fn (k) {
      let (from, to) = (starts[k], starts[k] + measures[k].len)
      while past < sounds.size() && sounds[past].to <= from {
        past += 1
      }
      let spans = []
      mut j = past
      while j < sounds.size() && sounds[j].at < to {
        let s = sounds[j]
        spans.push({
          from: Math.max(s.at, from) - from,
          to: Math.min(s.to, to) - from,
          sound: s.sound,
          marks: s.at >= from ? s.marks : [],
          tie: s.to > to,
        })
        j += 1
      }
      notated(spans, measures[k].meter, measures[k].len, pitched)
    })
  }
  let drum_line = fn () {
    let placed = kit.map(|d| (d.name, d)).to_object()
    iota(measures.size()).map(fn (k) {
      let m = measures[k]
      let beat = beat_of(m.meter)
      let onsets = []
      for h in bars[k].drums {
        if onsets.empty() || onsets[-1].at != h.at {
          onsets.push({at: h.at, sound: [], marks: []})
        }
        onsets[-1].sound.push(placed[h.name])
        onsets[-1].marks.extend(h.marks.filter(|mk| !onsets[-1].marks.contains(mk)))
      }
      let spans = iota(onsets.size()).map(fn (q) {
        let o = onsets[q]
        let next = onsets.get(q + 1, nil)?.at ?? m.len
        {
          from: o.at,
          to: Math.min(next, (o.at / beat + 1) * beat, m.len),
          sound: o.sound,
          marks: o.marks,
          tie: false,
        }
      })
      notated(spans, m.meter, m.len, unpitched)
    })
  }
  [
    ...iota(played.voices.size()).map(voice_line),
    ...(kit.empty() ? [] : [drum_line()]),
  ]
}

# --- notes ---------------------------------------------------------------------

let pitch_el = |p| node(
  "pitch",
  [
    leaf("step", p.step),
    ...alter_els("alter", p.alter),
    leaf("octave", p.octave),
  ],
)
let unpitched_el = |p| node(
  "unpitched",
  [leaf("display-step", p.step), leaf("display-octave", p.octave)],
)
let dot_els = |it| repeat(it.dots, node("dot", []))
let notations = |els| els.empty() ? [] : [node("notations", els)]

fn accidental_name(alter) {
  match alter {
    -3 => "triple-flat",
    -2 => "flat-flat",
    -1 => "flat",
    0 => "natural",
    1 => "sharp",
    2 => "double-sharp",
    _ => "triple-sharp",
  }
}

# The accidental pitch `p` shows after the key's and those before it in the
# measure (`acc`); a note a tie holds on shows none.
fn accidental_els(p, acc, held) {
  return [] if held
  let at = "{p.step}{p.octave}"
  return [] if acc.shown.get(at, acc.key[p.step]) == p.alter
  acc.shown[at] = p.alter
  [leaf("accidental", accidental_name(p.alter))]
}

fn time_els(e) {
  return [] if e.ratio == PLAIN
  [node(
    "time-modification",
    [
      leaf("actual-notes", e.ratio.actual),
      leaf("normal-notes", e.ratio.normal),
    ],
  )]
}

fn tuplet_els(e) {
  let starts = e
    .starts
    .sorted_by(|b| b.number)
    .map(|b| node(
      "tuplet",
      [
        node("tuplet-actual", [leaf("tuplet-number", b.actual)]),
        node("tuplet-normal", [leaf("tuplet-number", b.normal)]),
      ],
      {type: "start", number: b.number, bracket: "yes"},
    ))
  [
    ...starts,
    ...e.stops.sorted_by(|b| -b.number).map(|b| node("tuplet", [], {type: "stop", number: b.number})),
  ]
}

fn mark_els(marks) {
  let arts = marks
    .filter(|m| music.ARTICULATIONS.has(m))
    .map(|m| node(music.ARTICULATIONS[m], []))
  [
    ...(arts.empty() ? [] : [node("articulations", arts)]),
    ...(marks.contains("fermata") ? [node("fermata", [])] : []),
  ]
}

# Note, rest or drum event `e` as <note>s: its grace notes, then a <note>
# for each of its pitches or drums, the second and later a <chord/>.
fn note_els(e, acc) {
  let it = e.item
  if it.has("rest") {
    return [node(
      "note",
      [
        node("rest", []),
        leaf("duration", e.len),
        leaf("voice", 1),
        leaf("type", type_name(it.value)),
        ...dot_els(it),
        ...time_els(e),
        ...notations([...tuplet_els(e), ...mark_els(it.marks)]),
      ],
    )]
  }
  if it.has("hit") {
    # A slash on the line of the hits' staff.
    let ties = [
      ...(e.tied_from.empty() ? [] : ["stop"]),
      ...(it.tie ? ["start"] : []),
    ]
    return [node(
      "note",
      [
        unpitched_el(HIT),
        leaf("duration", e.len),
        ...ties.map(|t| node("tie", [], {type: t})),
        leaf("voice", 1),
        leaf("type", type_name(it.value)),
        ...dot_els(it),
        ...time_els(e),
        leaf("notehead", "slash"),
        ...notations([
          ...ties.map(|t| node("tied", [], {type: t})),
          ...tuplet_els(e),
          ...mark_els(it.marks),
        ]),
      ],
    )]
  }
  if it.has("drums") {
    return iota(it.drums.size()).map(fn (k) {
      let d = it.drums[k]
      node(
        "note",
        [
          ...(k > 0 ? [node("chord", [])] : []),
          unpitched_el(d),
          leaf("duration", e.len),
          node("instrument", [], {id: d.id}),
          leaf("voice", 1),
          leaf("type", type_name(it.value)),
          ...dot_els(it),
          ...time_els(e),
          ...(d.head == "normal" ? [] : [leaf("notehead", d.head)]),
          ...notations(k > 0 ? [] : [...tuplet_els(e), ...mark_els(it.marks)]),
        ],
      )
    })
  }
  let one = it.graces.size() == 1
  let graces = it.graces.map(|g| node(
    "note",
    [
      node("grace", [], one ? {slash: "yes"} : {}),
      pitch_el(g),
      leaf("voice", 1),
      leaf("type", one ? "eighth" : "16th"),
      ...accidental_els(g, acc, false),
    ],
  ))
  let chord = iota(it.pitches.size()).map(fn (k) {
    let p = it.pitches[k]
    let held = e.tied_from.any(|q| same_pitch(p, q))
    let ties = [...(held ? ["stop"] : []), ...(p.tie ? ["start"] : [])]
    node(
      "note",
      [
        ...(k > 0 ? [node("chord", [])] : []),
        pitch_el(p),
        leaf("duration", e.len),
        ...ties.map(|t| node("tie", [], {type: t})),
        leaf("voice", 1),
        leaf("type", type_name(it.value)),
        ...dot_els(it),
        ...accidental_els(p, acc, held),
        ...time_els(e),
        ...notations([
        ...ties.map(|t| node("tied", [], {type: t})),
        ...(k > 0 ? [] : [...e.slurs.map(|s| node("slur", [], {type: s, number: 1})), ...tuplet_els(e), ...mark_els(it.marks)]),
        ...(it.arpeggio ? [node("arpeggiate", [])] : []),
      ]),
      ],
    )
  })
  [...graces, ...chord]
}

# --- directions ----------------------------------------------------------------

# A <direction>, drawn `offset` units from where it stands.
fn direction(types, placement, sound = nil, offset = 0) {
  node(
    "direction",
    [
      ...types.map(|t| node("direction-type", [t])),
      ...(offset == 0 ? [] : [leaf("offset", offset)]),
      ...(sound == nil ? [] : [sound]),
    ],
    {placement},
  )
}

# A word of Kauai's own (`with echo`, `loop`) in small italics.
let remark_el = |text| direction(
  [node("words", [text], {"font-size": "9", "font-style": "italic"})],
  "above",
)

let quarters = |t| t.per * units(t) / (WHOLE / 4)
let tempo_sound = |t| node("sound", [], {tempo: number_text(quarters(t))})

fn metronome_el(t) {
  let beat = [
    leaf("beat-unit", type_name(t.value)),
    ...repeat(t.dots, node("beat-unit-dot", [])),
  ]
  direction(
    [node("metronome", [...beat, leaf("per-minute", number_text(t.per))])],
    "above",
    tempo_sound(t),
  )
}

fn swing_el(sw) {
  if sw == nil {
    return direction(
      [leaf("words", "Straight")],
      "above",
      node("sound", [node("swing", [node("straight", [])])]),
    )
  }
  let ratio = sw.first == 2 && sw.second == 1 ? "" : " {sw.first}:{sw.second}"
  let swing = node(
    "swing",
    [
      leaf("first", sw.first),
      leaf("second", sw.second),
      leaf("swing-type", type_name(sw.unit)),
    ],
  )
  direction(
    [leaf("words", "Swing{sw.unit == 16 ? " 16ths" : ""}{ratio}")],
    "above",
    node("sound", [swing]),
  )
}

# Mark event `e` as <direction>s: the hairpin or dashes it ends, then what it
# says. A parameter and a slur's end write nothing here, and `\!` nothing
# more than the hairpin it ends.
fn direction_els(e, song) {
  let closes = e.closes.map(|c| direction(
    [node(c, [], {type: "stop"})],
    "below",
    offset: e.offset,
  ))
  let d = e.mark.direction
  let says = match d {
    "tempo" if e.mark.tempo != nil => [metronome_el(e.mark.tempo)],
    "tempo" => [direction(
      [leaf("words", "a tempo")],
      "above",
      tempo_sound(song.tempo),
    )],
    # MusicXML has no element for the tempo a rit. or accel. reaches, which
    # the song's Kauai text keeps.
    "rit" | "accel" => [direction(
      [leaf("words", "{d}."), node("dashes", [], {type: "start"})],
      "above",
    )],
    _ if WEDGES.has(d) => [direction(
      [node("wedge", [], {type: WEDGES[d]})],
      "below",
      offset: e.offset,
    )],
    _ if LEVELS.has(d) => [direction(
      [node("dynamics", [node(d, [])])],
      "below",
      node("sound", [], {dynamics: LEVELS[d]}),
      offset: e.offset,
    )],
    _ => [],
  }
  [...closes, ...says]
}

# --- measures ------------------------------------------------------------------

# The chords measure `mi` shows, at the beats they start on: where they
# change, and every one at the start of a pass or an ending (the section's
# own, or one the score draws, `opens`).
fn harmonies(measures, mi, passes, opens) {
  let m = measures[mi]
  return [] if m.bar == nil
  let chords = m.bar.chords
  let starts = opens || m.at == 0 || m.at == passes[m.pass].body
  let before = starts ? nil : measures[mi - 1].bar.chords[-1]
  iota(chords.size())
    .filter(|k| k == 0 && starts ||
      chords[k] != (k == 0 ? before : chords[k - 1]))
    .map(|k| {at: k * WHOLE / m.meter.value, chord: chords[k]})
}

# What line `line` holds in measure `mi`: on the melody the section's name
# where a pass starts (and the derived part it plays with) and the chords,
# then the notes and directions. A measure the line is not in rests (a
# `quiet` line's unseen: a bar with no hits, unlike a break's rest).
fn content_of(measures, mi, line, passes, song, opens = false, quiet = false) {
  let m = measures[mi]
  let events = m.lines[line] ?? []
  let chords = line == 0 ? harmonies(measures, mi, passes, opens) : []
  let acc = {key: key_alters(m.key), shown: {}}
  let out = []
  if line == 0 && m.at == 0 {
    let pass = passes[m.pass]
    out.push(direction([leaf("rehearsal", pass.section)], "above"))
    out.push(remark_el("with {pass.with}")) if pass.with != nil
  }
  mut h = 0
  for e in events {
    if e.has("mark") {
      out.extend(direction_els(e, song))
      continue
    }
    while h < chords.size() && chords[h].at < e.at + e.len {
      out.push(harmony_el(chords[h].chord, chords[h].at - e.at))
      h += 1
    }
    out.extend(note_els(e, acc))
  }
  if !events.any(|e| e.has("len")) {
    out.extend(chords.map(|c| harmony_el(c.chord, c.at)))
    out.push(node(
      "note",
      [
        node("rest", [], {measure: "yes"}),
        leaf("duration", m.len),
        leaf("voice", 1),
      ],
      quiet && m.lines[line] == nil ? {"print-object": "no"} : {},
    ))
  }
  out
}

# How many bars the `%` sign over line `line` of measure `mi` repeats, 0 for
# none: a `%` is drawn when each bar of its sign plays as the bar it
# repeats, so not when a pickup has gone into one or a later time changes
# one; and on a line of the band's (from `band_from` on) when the band plays
# it as it played there too.
fn repeats(measures, mi, line, band_from) {
  let r = measures[mi].bar?.repeat
  return 0 if r == nil
  let first = mi - r.index
  let same = |a, b| a.chords == b.chords &&
    a.melody == b.melody &&
    a.parts == b.parts &&
    a.hits == b.hits
  let drawn = iota(r.bars).all(fn (k) {
    let (
      copy,
      source,
    ) = (measures.get(first + k, nil), measures[first + k - r.bars])
    copy?.bar?.repeat == {bars: r.bars, index: k} &&
      copy.pass == source.pass &&
      !copy.merged &&
      !source.merged &&
      same(copy.bar, source.bar) &&
      (line < band_from || copy.lines[line] == source.lines[line])
  })
  drawn ? r.bars : 0
}

# --- the form ------------------------------------------------------------------

# How passes `i` to `j` of the same section fold, each pass its measures in
# `spans`: nil when they do not, or {cut, groups}. The first `cut` bars,
# which every pass plays the same, are in repeat signs, and the rest are
# endings, written for the passes in each of `groups` ([] when every pass is
# the same and a repeat sign is enough). The endings start where the passes
# start to differ, at the latest where the section's own do, and at most
# half of the section's body goes into them. They fold when they start at
# the same tempo, and the endings that differ are the passes' last.
fn fold_of(passes, spans, rendered, tempos, i, j) {
  let ps = iota(i, j + 1)
  # Whether every pass gives what `f` asks of it as pass `i` does.
  let agree = |f| ps.all(|q| f(q) == f(i))
  return nil if !agree(|q| passes[q].section)
  let body = passes[i].body
  let cut = range(body).take_while(|k| agree(|q| rendered[spans[q][k]])).count()
  return nil if body == 0 || 2 * cut < body || !agree(|q| tempos[spans[q][0]])
  let tail = |q| spans[q][cut..].map(|mi| rendered[mi])
  return {cut, groups: []} if cut == body && agree(tail)
  let groups = []
  for q in ps {
    if !groups.empty() && tail(q) == tail(groups[-1][0]) {
      groups[-1].push(q)
    } else {
      groups.push([q])
    }
  }
  return nil if groups[-1].size() != 1 || ps.any(|q| tail(q).empty())
  {cut, groups}
}

# Passes `from` to `to` (not that one) in the runs that fold, each {i,
# last, fold}: passes `i` to `last`, and how they fold (nil for one alone).
fn blocks_of(passes, spans, rendered, tempos, from, to) {
  let out = []
  mut i = from
  while i < to {
    let last = iota(i + 1, to)
      .filter(|j| fold_of(passes, spans, rendered, tempos, i, j) != nil)
      .reduce(i, Math.max)
    let fold = last == i
      ? nil
      : fold_of(passes, spans, rendered, tempos, i, last)
    out.push({i, last, fold})
    i = last + 1
  }
  out
}

# The D.C. or D.S. that leaves out the most measures, nil for none: the
# passes from `t` on played again from block `from` of those before them
# (`blocks`), `count` blocks through as each was played last; then to the
# end (al Fine) or to the passes after, a coda (`coda`, their blocks). A
# block played again is its last time's measures, as after a jump a repeat
# is played once and the last ending taken. The music goes back to where
# it came from: the same section, at the same tempo. A D.C. is not to a
# song that opens with a pickup, which the bar before it holds too.
fn jump_of(passes, spans, rendered, tempos) {
  let drawn = |q| spans[q].map(|mi| rendered[mi])
  let saved = |t, count| iota(t, t + count).map(|q| spans[q].size()).sum()
  mut best = nil
  for t in iota(1, passes.size()) {
    continue if spans[t].empty()
    let blocks = blocks_of(passes, spans, rendered, tempos, 0, t)
    for from in iota(blocks.size()) {
      let first = blocks[from]
      continue if from == 0 && passes[0].pickup != nil
      continue if spans[first.i].empty() ||
        tempos[spans[first.i][0]] != tempos[spans[t][0]]
      # How many blocks from `from` the passes from `t` play again.
      let most = Math.min(blocks.size() - from, passes.size() - t)
      let count = iota(most).iter().take_while(fn (k) {
        let q = blocks[from + k].last
        !spans[t + k].empty() &&
          passes[t + k].section == passes[q].section &&
          drawn(t + k) == drawn(q)
      }).count()
      continue if count == 0
      let rest = t + count
      let ends = rest == passes.size()
      # A coda needs a block left to jump over.
      continue if !ends && from + count == blocks.size()
      continue if best != nil && saved(t, count) <= saved(best.t, best.count)
      best = {
        t,
        blocks,
        from,
        count,
        coda: ends
          ? nil
          : blocks_of(passes, spans, rendered, tempos, rest, passes.size()),
      }
    }
  }
  best
}

# The measures as the score writes them, in order: each with the barlines
# around it, the measures the music comes into it from (-1 at the start),
# which say what the measure has to restate, and the jump it starts or ends
# with: a segno or the coda it is, or a D.C. or D.S., To Coda or Fine. A
# song that loops is written without a jump.
fn layout(passes, measures, rendered, tempos, loops) {
  # Each pass's measures.
  let spans = iota(passes.size()).map(|q| iota(measures.size())
    .filter(|mi| measures[mi].pass == q)
    .filter(|mi| measures[mi].at >= 0))
  let out = []
  mut prev = -1
  let put = fn (mi, enter) {
    let o = {
      mi,
      enter,
      mut forward: false,
      mut ending: nil,
      mut closing: nil,
      mut backward: 0,
      mut style: nil,
      mut sign: nil,
      mut jump: nil,
    }
    out.push(o)
    prev = mi
    o
  }
  # Writes `blocks`, giving the out index each starts at.
  let write_blocks = fn (blocks) {
    blocks.map(fn (bl) {
      let at = out.size()
      let {i, last, fold} = bl
      let k = last - i + 1
      if fold == nil {
        for mi in spans[i] {
          put(mi, [prev])
        }
        out[-1].style = "light-light" if !spans[i].empty()
      } else {
        # The body in repeat signs (the whole pass when every time is the
        # same), which the music comes back into from where each time but
        # the last ends; then each ending, written for the times it plays.
        let groups = fold.groups
        let body = groups.empty() ? spans[i] : spans[i][..fold.cut]
        let tail = |g| spans[g[0]][fold.cut..]
        let ends = groups.empty()
          ? [body[-1]]
          : groups.slice(0, groups.size() - 1).map(|g| tail(g)[-1])
        let first = put(body[0], [prev, ...ends])
        first.forward = true
        for mi in body.slice(1, body.size()) {
          put(mi, [prev])
        }
        out[-1].backward = k if groups.empty()
        let body_end = body[-1]
        for n, g in groups.enumerate() {
          let t = tail(g)
          let number = g.map(|q| "{q - i + 1}").join(", ")
          let start = put(t[0], [body_end])
          start.ending = number
          for mi in t.slice(1, t.size()) {
            put(mi, [prev])
          }
          let last_bar = out[-1]
          if n < groups.size() - 1 {
            last_bar.closing = {number, type: "stop"}
            last_bar.backward = k
          } else {
            last_bar.closing = {number, type: "discontinue"}
            last_bar.style = "light-light"
          }
        }
      }
      at
    })
  }
  put(0, [-1]) if measures[0].at < 0
  let jump = loops ? nil : jump_of(passes, spans, rendered, tempos)
  if jump == nil {
    write_blocks(blocks_of(passes, spans, rendered, tempos, 0, passes.size()))
    return out
  }
  let starts = write_blocks(jump.blocks)
  let back = out[-1]
  let target = out[starts[jump.from]]
  target.enter.push(back.mi)
  let capo = jump.from == 0
  target.sign = capo ? nil : "segno"
  let through = jump.from + jump.count
  # Where the music leaves the blocks played again: the last measure of
  # the last one.
  let to_end = through == jump.blocks.size()
  let leave = to_end ? back : out[starts[through] - 1]
  let al = cond {
    jump.coda != nil => " al Coda",
    to_end => "",
    _ => " al Fine",
  }
  back.jump = capo
    ? {text: "D.C." + al, sound: {dacapo: "yes"}}
    : {text: "D.S." + al, sound: {dalsegno: "segno"}}
  if jump.coda != nil {
    leave.jump = {text: "To Coda", sound: {tocoda: "coda"}}
    prev = leave.mi
    out[write_blocks(jump.coda)[0]].sign = "coda"
  } else if !to_end {
    leave.jump = {text: "Fine", sound: {fine: "yes"}}
  }
  out
}

# --- the score -----------------------------------------------------------------

# The segno or the coda a measure starts with, by its name.
let sign_el = |name| direction(
  [node(name, [])],
  "above",
  node("sound", [], name == "segno" ? {segno: name} : {coda: name}),
)

# The jump a measure ends with ({text, sound}), as its words say it and
# <sound> makes it: a D.C., to the segno or the coda, or Fine.
let jump_el = |jump| direction(
  [leaf("words", jump.text)],
  "above",
  node("sound", [], jump.sound),
)

fn barline_els(location, style, ending, repeat) {
  let inside = [
    style == nil ? nil : leaf("bar-style", style),
    ending,
    repeat,
  ].filter(|x| x != nil)
  inside.empty() ? [] : [node("barline", inside, {location})]
}

# The key, not shown on a staff of unpitched notes (`unpitched`).
let key_el = |key, unpitched| node(
  "key",
  [
    leaf("fifths", fifths_of(key)),
    leaf("mode", spelled(key).minor ? "minor" : "major"),
  ],
  unpitched ? {"print-object": "no"} : {},
)
let time_el = |meter| node(
  "time",
  [leaf("beats", meter.beats), leaf("beat-type", meter.value)],
)

# The clef for line `line`: the bass clef if its notes are below middle C on
# average, else the treble.
fn clef_el(measures, line) {
  let pitches = measures.flat_map(|m| (m.lines[line] ?? [])
    .filter(|e| e.has("len") && e.item.has("pitches"))
    .flat_map(|e| e.item.pitches))
  let low = !pitches.empty() &&
    pitches.map(sounding).sum() < 60 * pitches.size()
  node(
    "clef",
    low
      ? [leaf("sign", "F"), leaf("line", 4)]
      : [leaf("sign", "G"), leaf("line", 2)],
  )
}

# The `%` signs along line `line`: for each measure, where one starts or
# stops.
fn repeat_signs(order, rendered, line) {
  let out = []
  mut on = 0
  for o in order {
    let r = rendered[o.mi].repeats[line]
    let stop = on > 0 && r != on
      ? [node("measure-repeat", [], {type: "stop"})]
      : []
    let start = r > 0 && r != on
      ? [node("measure-repeat", ["{r}"], {type: "start"})]
      : []
    out.push([...stop, ...start].map(|s| node("measure-style", [s])))
    on = r
  }
  out
}

# The song's about, the parts its band plays (`band`, their ids), which a
# reader leaves out as Kauai's own, the part its hits are on (`hits`, its
# id, "" for none), so that a part the song names Hits stays a part, and the
# song as Kauai text (fields, as MuseScore keeps a score's fields when it
# saves it again).
fn about_els(score, band, hits) {
  let {about, song} = score
  let creators = ["composer", "lyricist", "arranger"]
    .filter(|k| about[k] != nil)
    .map(|k| node("creator", ["{about[k]}"], {type: k}))
  let field = |name, text| node("miscellaneous-field", ["{text}"], {name})
  let fields = [
    ...["year", "note"].filter(|k| about[k] != nil).map(|k| field(k, about[k])),
    ...(band.empty() ? [] : [field("kauai-band", band.join(" "))]),
    field("kauai-hits", hits),
    field("kauai-song", kau.write(score)),
  ]
  [
    node("work", [leaf("work-title", about.title ?? song.name)]),
    node(
      "identification",
      [
        ...creators,
        ...(about.license == nil ? [] : [leaf("rights", about.license)]),
        node("encoding", [leaf("software", "Kauai")]),
        ...(about.source == nil ? [] : [leaf("source", about.source)]),
        node("miscellaneous", fields),
      ],
    ),
  ]
}

# The song `score` (Kauai.parse's) as MusicXML text: a part for the
# melody, each part the song writes out, each voice of the band's that plays
# its grooves, echoes and harmonies, and its drums.
fn write(score) {
  let song = score.song
  let band = score.played
  let names = part_names(score)
  let passes = passes_of(score)
  let hits = passes.any(|p| p.bars.any(|b| b.hits != nil))
  let measures = measures_of(passes, names, hits)
  let hits_line = hits ? names.size() + 1 : -1
  let band_from = names.size() + 1 + (hits ? 1 : 0)
  let staves = [
    "Melody",
    ...names,
    ...(hits ? [HITS] : []),
    ...band.voices,
    ...(band.drums.empty() ? [] : ["Drums"]),
  ]
  let part_id = |line| "P{line + 1}"
  let drum_line = band.drums.empty() ? -1 : staves.size() - 1
  let kit = kit_of(band.drums, part_id(drum_line))
  for items in band_lines(band, measures, kit) {
    for k, m in measures.enumerate() {
      m.lines.push(with_dynamics(events_of(items[k]), m.lines[0]))
    }
  }
  let lines = iota(staves.size())
  for line in lines {
    join_line(measures, line)
  }
  let rendered = iota(measures.size()).map(fn (mi) {
    let m = measures[mi]
    {
      key: m.key,
      meter: m.meter,
      swing: m.swing,
      repeats: lines.map(|line| repeats(measures, mi, line, band_from)),
      lines: lines.map(|line| content_of(
        measures,
        mi,
        line,
        passes,
        song,
        quiet: line == hits_line,
      )),
    }
  })
  let order = layout(passes, measures, rendered, tempos_at(measures), song.loop)
  # An ending names its chords where it starts, which only the layout knows.
  for o in order.filter(|o| o.ending != nil) {
    rendered[o.mi].lines[0] = content_of(measures, o.mi, 0, passes, song, true)
  }
  let signs = lines.map(|line| repeat_signs(order, rendered, line))
  let unpitched = |line| line == drum_line || line == hits_line
  let clefs = lines.map(|line| unpitched(line)
    ? node("clef", [leaf("sign", "percussion")])
    : clef_el(measures, line))
  let first_number = measures[0].at < 0 ? 0 : 1

  let measure_el = fn (n, line) {
    let o = order[n]
    let m = measures[o.mi]
    let from = o.enter.map(|k| k < 0 ? nil : measures[k])
    let restate = |f| from.any(|s| s == nil || f(s) != f(m))
    let first = n == 0
    let attrs = [
      ...(first ? [leaf("divisions", WHOLE / 4)] : []),
      ...(restate(|s| s.key)
        ? [key_el(m.key, unpitched(line))]
        : []),
      ...(restate(|s| s.meter) ? [time_el(m.meter)] : []),
      ...(first ? [clefs[line]] : []),
      ...(first && line == hits_line
        ? [node("staff-details", [leaf("staff-lines", 1)])]
        : []),
      ...signs[line][n],
    ]
    let heads = line > 0
      ? []
      : [
        ...(first ? [metronome_el(song.tempo)] : []),
        ...(from.any(|s| s?.swing != m.swing) ? [swing_el(m.swing)] : []),
      ]
    let last = n == order.size() - 1
    let next_opens = !last && order[n + 1].forward
    let style = cond {
      o.backward > 0 || last => "light-heavy",
      next_opens => nil,
      _ => o.style,
    }
    let left = barline_els(
      "left",
      o.forward ? "heavy-light" : nil,
      o.ending == nil
        ? nil
        : node("ending", ["{o.ending}."], {number: o.ending, type: "start"}),
      o.forward ? node("repeat", [], {direction: "forward"}) : nil,
    )
    let backward = o.backward > 2
      ? {direction: "backward", times: o.backward}
      : {direction: "backward"}
    let right = barline_els(
      "right",
      style,
      o.closing == nil
        ? nil
        : node("ending", [], {number: o.closing.number, type: o.closing.type}),
      o.backward > 0 ? node("repeat", [], backward) : nil,
    )
    let number = m.at < 0
      ? {number: "0", implicit: "yes"}
      : {number: "{n + first_number}"}
    node(
      "measure",
      [
        ...left,
        ...(attrs.empty() ? [] : [node("attributes", attrs)]),
        ...heads,
        ...(line == 0 && o.sign != nil ? [sign_el(o.sign)] : []),
        ...rendered[o.mi].lines[line],
        ...(last && line == 0 && song.loop ? [remark_el("loop")] : []),
        ...(line == 0 && o.jump != nil ? [jump_el(o.jump)] : []),
        ...right,
      ],
      number,
    )
  }

  # The drums' instruments, and the General MIDI keys of those the kit names
  # (MusicXML counts the keys from 1).
  let instruments = [
    ...kit.map(|d| node("score-instrument", [leaf("instrument-name", d.name)], {id: d.id})),
    ...kit.filter(|d| d.key != nil).map(|d| node(
      "midi-instrument",
      [leaf("midi-channel", 10), leaf("midi-unpitched", d.key + 1)],
      {id: d.id},
    )),
  ]
  let part_list = node(
    "part-list",
    lines.map(|line| node(
      "score-part",
      [
        leaf("part-name", staves[line]),
        ...(line == drum_line ? instruments : []),
      ],
      {id: part_id(line)},
    )),
  )
  let parts = lines.map(|line| node(
    "part",
    iota(order.size()).map(|n| measure_el(n, line)),
    {id: part_id(line)},
  ))
  let doc = node(
    "score-partwise",
    [
      ...about_els(
        score,
        iota(band_from, staves.size()).map(part_id),
        hits ? part_id(hits_line) : "",
      ),
      part_list,
      ...parts,
    ],
    {version: "4.0"},
  )
  XML
    .stringify(doc, indent: 2, declaration: true)
    .replace_first("\n", "\n{DOCTYPE}\n")
}

# Score MusicXML `text` as a compressed .mxl: a zip of the score and the
# container that names it (with no `mimetype`, which MusicXML 4.0 asks for
# but does not need, as Compress.zip puts its files in name order).
fn mxl(text) {
  let rootfile = node(
    "rootfile",
    [],
    {
      "full-path": "score.musicxml",
      "media-type": "application/vnd.recordare.musicxml+xml",
    },
  )
  let container = node("container", [node("rootfiles", [rootfile])])
  Compress.zip({
    "META-INF/container.xml": XML.stringify(
      container,
      indent: 2,
      declaration: true,
    ),
    "score.musicxml": text,
  })
}

export {write, mxl, passes_of, as_played, part_names, events_of, moved_items, moved_chord, UNMOVED, HIT, HITS}
