about {
  title  Top
  note   a short tune over the top of a soprano saxophone's range, where its notes are played as overtones of the fingering an octave down: to tune on the numbers that decide where that begins
}

band Solo {
  voice Lead  external Sax  plays melody  vol 40
}

song Top {
  tempo 90
  key C
  band Solo
  melody in D5..C#6

  mark Top
  Climb
  Held
  Fall
}

section Climb {
  C   f4 g a a#
  C   c4 d' c a#
  C   g4 a# c d'
  C   c4 a# a g
}

section Held {
  C   a#1
  C   c1
  C   d'2 c
  C   a#1
}

section Fall {
  C   d'4 c a# a
  C   g4 f e d
  C   g4 a# c a#
  C   a1
}
