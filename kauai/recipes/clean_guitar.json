{
  "recipe": 1,
  "knobs": {
    "bright": {"default": 0.5, "min": 0, "max": 1},
    "pluck": {"default": 0, "min": 0, "max": 0.5},
    "chorus": {"default": 0, "min": 0, "max": 1},
    "release": {"default": 1.5, "min": 0.1, "max": 4}
  },
  "parts": {
    "pick": {"part": "noise", "seed": 5},
    "picka": {"part": "gain", "input": "pick", "gain": {"on": [[0, 0], [0.0003, 1], [0.002, 0, -4]]}},
    "pickt": {"part": "filter", "kind": "low", "input": "picka", "cutoff": "min(4000 * (0.5 + bright) * (0.6 + 0.4 * level), 16000)"},
    "pickseen": {"part": "delay", "input": "pickt", "time": "pluck / f"},
    "pickback": {"part": "gain", "input": "pickseen", "gain": "0 - clamp(pluck / 0.001, 0, 1)"},
    "pickc": {"part": "mix", "inputs": ["pickt", "pickback"]},
    "string": {"part": "pluck", "input": "pickc", "ring": "12 * (261.63 / f) ^ 0.5"},
    "string2": {"part": "pluck", "input": "pickc", "freq": "f * 1.0007", "ring": "9 * (261.63 / f) ^ 0.5"},
    "string2l": {"part": "gain", "input": "string2", "gain": 0.4},
    "strings": {"part": "mix", "inputs": ["string", "string2l"]},
    "neckseen": {"part": "delay", "input": "strings", "time": "0.25 / f"},
    "neckback": {"part": "gain", "input": "neckseen", "gain": -1},
    "neck": {"part": "mix", "inputs": ["strings", "neckback"]},
    "middleseen": {"part": "delay", "input": "strings", "time": "0.15 / f"},
    "middleback": {"part": "gain", "input": "middleseen", "gain": -1},
    "middle": {"part": "mix", "inputs": ["strings", "middleback"]},
    "pickups": {"part": "mix", "inputs": ["neck", "middle"], "gain": 0.5},
    "preamp": {"part": "drive", "input": "pickups", "gain": 1.5},
    "tone": {"part": "filter", "kind": "low", "input": "preamp", "cutoff": "min(3000 + 2500 * bright + 2 * f, 12000)"},
    "bump": {"part": "filter", "kind": "band", "q": 1, "input": "tone", "cutoff": 120},
    "bumpl": {"part": "gain", "input": "bump", "gain": 0.3},
    "presence": {"part": "filter", "kind": "band", "q": 1, "input": "tone", "cutoff": 2500},
    "presencel": {"part": "gain", "input": "presence", "gain": 0.3},
    "speaker": {"part": "mix", "inputs": ["tone", "bumpl", "presencel"]},
    "cone": {"part": "filter", "kind": "low", "input": "speaker", "cutoff": 6000},
    "body": {"part": "filter", "kind": "high", "input": "cone", "cutoff": 80},
    "sweep1": {"part": "wave", "freq": 0.7},
    "sweep1l": {"part": "gain", "input": "sweep1", "gain": 0.003},
    "copy1": {"part": "delay", "input": "body", "time": 0.012, "modulators": {"time": ["sweep1l"]}},
    "copy1l": {"part": "gain", "input": "copy1", "gain": "0.7 * chorus"},
    "sweep2": {"part": "wave", "freq": 1.1, "phase": 1.5},
    "sweep2l": {"part": "gain", "input": "sweep2", "gain": 0.004},
    "copy2": {"part": "delay", "input": "body", "time": 0.021, "modulators": {"time": ["sweep2l"]}},
    "copy2l": {"part": "gain", "input": "copy2", "gain": "0.5 * chorus"},
    "ensemble": {"part": "mix", "inputs": ["body", "copy1l", "copy2l"], "gain": "0.8 / sqrt(1 + 0.74 * chorus)"},
    "amp": {"part": "gain", "input": "ensemble", "gain": {"on": [[0, 1]], "off": [["release", 0, -3]]}}
  },
  "out": "amp"
}
