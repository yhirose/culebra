{
  "recipe": 1,
  "knobs": {
    "bright": {"default": 0.5, "min": 0, "max": 1},
    "pluck": {"default": 0, "min": 0, "max": 0.5},
    "drive": {"default": 1, "min": 0, "max": 2},
    "vibrato": {"default": 1, "min": 0, "max": 1},
    "choke": {"default": 1, "min": 0, "max": 1},
    "chorus": {"default": 0.5, "min": 0, "max": 1},
    "echo": {"default": 0.6, "min": 0, "max": 1},
    "mute": {"default": 0, "min": 0, "max": 1}
  },
  "parts": {
    "pick": {"part": "noise", "seed": 7},
    "picka": {"part": "gain", "input": "pick",
              "gain": {"on": [[0, 0], [0.0005, 1], [0.004, 0, -4]]}},
    "pickt": {"part": "filter", "kind": "low", "input": "picka",
              "cutoff": "4000 * (0.5 + bright) * (0.6 + 0.4 * level)"},
    "steady": {"part": "wave", "freq": 0, "phase": 1.5707963267948966},
    "vib": {"part": "wave", "freq": 5.5, "phase": -1.5707963267948966},
    "vibshape": {"part": "mix", "inputs": ["vib", "steady"]},
    "vibl": {"part": "gain", "input": "vibshape",
             "gain": {"on": [[0, 0], [0.35, 0], [1, "f * 0.0058 * vibrato"]]}},
    "push": {"part": "gain", "input": "steady",
             "gain": {"on": [[0, "-0.0561 * f * choke * min(1, max(0, (dur - 0.4) * 5))"], [0.15, 0, -2]]}},
    "pickseen": {"part": "delay", "input": "pickt", "time": "pluck / f"},
    "pickback": {"part": "gain", "input": "pickseen", "gain": "0 - clamp(pluck / 0.001, 0, 1)"},
    "pickc": {"part": "mix", "inputs": ["pickt", "pickback"]},
    "string": {"part": "pluck", "input": "pickc", "ring": "(30 * (261.63 / f) ^ 0.5) ^ (1 - mute) * 0.03 ^ mute",
               "modulators": ["vibl", "push"]},
    "tight": {"part": "filter", "kind": "high", "input": "string", "cutoff": 150},
    "hump": {"part": "filter", "kind": "band", "q": 0.7, "input": "string", "cutoff": 1000},
    "pre": {"part": "mix", "inputs": ["tight", "hump"]},
    "stage1": {"part": "drive", "input": "pre", "gain": "(1 + 7 * drive) * (0.5 + 0.5 * level)"},
    "couple": {"part": "filter", "kind": "high", "input": "stage1", "cutoff": 300},
    "smooth": {"part": "filter", "kind": "low", "input": "couple", "cutoff": 6000},
    "stage2": {"part": "drive", "input": "smooth", "gain": "1 + 79 * drive"},
    "clean": {"part": "filter", "kind": "high", "input": "stage2", "cutoff": 90},
    "presence": {"part": "filter", "kind": "band", "q": 1, "input": "clean", "cutoff": 3000},
    "presencel": {"part": "gain", "input": "presence", "gain": 0.3},
    "hill": {"part": "filter", "kind": "band", "q": 0.7, "input": "clean", "cutoff": 1000},
    "hilll": {"part": "gain", "input": "hill", "gain": 1.2},
    "voiced": {"part": "mix", "inputs": ["clean", "presencel", "hilll"]},
    "cab1": {"part": "filter", "kind": "low", "input": "voiced", "cutoff": 5500},
    "cab2": {"part": "filter", "kind": "low", "input": "cab1", "cutoff": 5500},
    "amp": {"part": "gain", "input": "cab2", "gain": {"on": [[0, 1]], "off": [[0.15, 0, -3]]}},
    "echo": {"part": "delay", "input": "amp", "time": 0.3},
    "echol": {"part": "gain", "input": "echo",
              "gain": {"on": [[0, "0.4 * echo"]], "off": [[0.45, "0.4 * echo"], [0.5, 0]]}},
    "sweep": {"part": "wave", "freq": 0.7},
    "sweepl": {"part": "gain", "input": "sweep", "gain": 0.003},
    "copy": {"part": "delay", "input": "amp", "time": 0.012, "modulators": ["sweepl"]},
    "copyl": {"part": "gain", "input": "copy", "gain": "chorus"},
    "ensemble": {"part": "mix", "inputs": ["amp", "copyl", "echol"],
                 "gain": "0.2 / sqrt(1 + 0.16 * echo + chorus)"}
  },
  "out": "ensemble"
}
