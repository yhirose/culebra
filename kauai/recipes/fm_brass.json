{
  "recipe": 1,
  "knobs": {"bright": {"default": 0.5, "min": 0, "max": 1}},
  "parts": {
    "m1": {"part": "wave", "freq": "f * (1 - mix(0.0035, 0.002, bright))", "feedback": "mix(0.5, 0.8, bright)"},
    "i1": {"part": "gain", "input": "m1", "gain": {
      "on": [[0, "mix(0.5, 0.6, bright)"], ["mix(0.06, 0.05, bright)", "mix(1, 1.5, bright)"],
             ["mix(0.18, 0.15, bright)", "mix(3, 4.5, bright)"], ["mix(0.45, 0.4, bright)", "mix(2.2, 3.2, bright)"]],
      "off": [[0.12, "mix(0.6, 0.8, bright)"]]}},
    "c1": {"part": "wave", "freq": "f * (1 - mix(0.0035, 0.002, bright))", "modulators": {"phase": ["i1"]}},

    "m2": {"part": "wave", "freq": "f * (1 + mix(0.0035, 0.002, bright))", "feedback": "mix(0.5, 0.8, bright)"},
    "i2": {"part": "gain", "input": "m2", "gain": {
      "on": [[0, "mix(0.5, 0.6, bright)"], ["mix(0.06, 0.05, bright)", "mix(1, 1.5, bright)"],
             ["mix(0.18, 0.15, bright)", "mix(3, 4.5, bright)"], ["mix(0.45, 0.4, bright)", "mix(2.2, 3.2, bright)"]],
      "off": [[0.12, "mix(0.6, 0.8, bright)"]]}},
    "c2": {"part": "wave", "freq": "f * (1 + mix(0.0035, 0.002, bright))", "modulators": {"phase": ["i2"]}},

    "m3": {"part": "wave", "freq": "2 * f"},
    "i3": {"part": "gain", "input": "m3", "gain": {
      "on": [[0, 0.3], [0.15, 2], [0.4, 1.4]],
      "off": [[0.12, 0.3]]}},
    "c3": {"part": "wave", "modulators": {"phase": ["i3"]}},
    "l3": {"part": "gain", "input": "c3", "gain": "0.5 * bright"},

    "pairs": {"part": "mix", "inputs": ["c1", "c2", "l3"], "gain": "0.45 * exp(-0.495 * bright)"},
    "amp": {"part": "gain", "input": "pairs", "gain": {
      "on": [[0, 0], ["mix(0.07, 0.05, bright)", 1], ["mix(0.2, 0.18, bright)", "mix(0.85, 0.9, bright)"]],
      "off": [[0.12, 0]]}}
  },
  "out": "amp"
}
