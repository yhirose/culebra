# The instruments Kauai comes with that are recipes: each .json file here
# is one, played by the engine's interpreter (kauai/engine/recipe.cul), and
# each in drums/ is a drum. A file's name is the instrument's, without its
# underscores: mellow_fm_brass.json is `MellowFmBrass`, and
# drums/open_hat.json is `OpenHat`.
#
#   band Pads {
#     voice Lead  FmBrass(bright=0.3) plays melody
#     drum Kick   Kick              vol 30
#   }
#
# folder() reads a folder of one's own the same way, for --sounds.

import engine from '../engine/recipe.cul'

# The recipes in `folder` of `dir` ("" for its own, "drums/" for the drums):
# {names, find, recipe}, `names` their files' names without `.json`,
# `find(name)` one as JSON reads it (`fallback(name)` where `dir` has none),
# and `recipe(name)` one whole (its base, found the same way, under it) and
# checked.
fn shelf(dir, folder, fallback) {
  let path = |name| "{folder}{name}.json"
  let find = |name| dir.is_file(path(name))
    ? JSON.parse(dir.read(path(name)))
    : fallback(name)
  {
    names: dir.glob(path("*")).map(|p| FS.stem(p)),
    find,
    recipe: |name| engine.Recipe.new(engine.resolved(name, find), name:),
  }
}

# A name as a song gives it after `external`, and as Kauai.load's
# keys are: mellow_fm_brass is MellowFmBrass, and mellowfmbrass.
let title = |name| name.split("_").map(|w| w.capitalize()).join("")
let key = |name| name.replace("_", "")

# What `kauai instruments` says of recipe `r`: `what` it is, and its knobs.
fn about(what, r) {
  let knobs = r
    .knobs
    .keys()
    .map(|k| "{k} {r.knobs[k].default} ({r.knobs[k].min} to {r.knobs[k].max})")
  knobs.empty() ? what : "{what}; {knobs.join(", ")}"
}

# No recipes: where a recipe's base is looked for last.
let NONE = {find: |name| nil, drum_find: |name| nil}

# The recipes of `dir` (a Dir), with `under`'s finds for the bases `dir` has
# not: {voices, drums} as Kauai.load's `voices:` and `drums:` take them, the
# shelves (`names`, `find`, `recipe`, and the drums' `drum_names`,
# `drum_find`, `drum`), and `instruments` as `kauai instruments` lists them,
# with each one's player for `kauai live` (nil for a drum, which live does
# not play).
fn recipes_in(dir, under = NONE) {
  let {names, find, recipe} = shelf(dir, "", under.find)
  let {
    names: drum_names,
    find: drum_find,
    recipe: drum,
  } = shelf(dir, "drums/", under.drum_find)
  let made = names.map(|n| (n, recipe(n))).to_object()
  let made_drums = drum_names.map(|n| (n, drum(n))).to_object()
  {
    voices: names.map(|n| (key(n), made[n].voice())).to_object(),
    drums: drum_names.map(|n| (key(n), made_drums[n].drum())).to_object(),
    names,
    find,
    recipe,
    drum_names,
    drum_find,
    drum,
    instruments: [
      ...names.map(|n| {name: title(n), live: || engine.LivePlayer(recipe(n)), about: about("a recipe", made[n])}),
      ...drum_names.map(|n| {name: title(n), live: nil, about: about("a drum", made_drums[n])}),
    ],
  }
}

let {
  voices,
  drums,
  names,
  drum_names,
  recipe,
  drum,
  find,
  drum_find,
  instruments,
} = recipes_in(Dir.embedded('.'))

# The recipes of a folder of one's own (`dir`, as Dir.embedded('.') reads
# the folder of the file that calls it), named as these are; a base it has
# not is one of these. Kauai.load takes its {voices, drums}.
fn folder(dir) {
  recipes_in(dir, under: {find, drum_find})
}

export {voices, drums, names, drum_names, recipe, drum, find, instruments, folder}
