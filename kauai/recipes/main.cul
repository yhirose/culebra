# The instruments Kauai comes with that are recipes: each .json file here
# is one, played by the engine's interpreter (kauai/engine/recipe.cul). A
# file's name is the instrument's, without its underscores: mellow_fm_brass.json
# is `external MellowFmBrass`.
#
#   band Pads {
#     voice Lead  external FmBrass  plays melody  bright=0.3
#   }

import engine from '../engine/recipe.cul'

let DIR = Dir.embedded('.')

# The recipes' names: their files' names without `.json`.
let names = DIR
  .files()
  .filter(|p| p.ends_with(".json"))
  .map(|p| to_string(p.slice(0, p.size() - 5)))
  .sorted()

# The recipe `name` as JSON reads it, nil for none.
fn find(name) {
  let file = "{name}.json"
  DIR.is_file(file) ? JSON.parse(DIR.read(file)) : nil
}

# The recipe `name` whole (its base under it) and checked.
fn recipe(name) {
  engine.Recipe.new(engine.resolved(name, find), name: name)
}

# The instruments, as Audio.Kauai.load's `voices:` takes them.
let voices = names.map(|n| (n.replace("_", ""), recipe(n).voice())).to_object()

# Each recipe as `kauai instruments` lists it: the name a song writes
# (mellow_fm_brass is MellowFmBrass), its knobs, and its player for
# `kauai live`.
let instruments = names.map(fn (n) {
  let knobs = recipe(n).knobs
  let about = knobs.keys().map(|k| "{k} {knobs[k].fallback} ({knobs[k].min} to {knobs[k].max})")
  {
    name: n.split("_").map(|w| w.capitalize()).join(""),
    live: || engine.LivePlayer(recipe(n)),
    about: about.empty() ? "a recipe" : "a recipe; {about.join(", ")}",
  }
})

export {voices, names, recipe, find, instruments}
