{
  "recipe": 1,
  "knobs": {"tune": {"default": 147, "min": 60, "max": 400}},
  "parts": {
    "head": {"part": "wave", "freq": {
      "on": [[0, "tune * 1.3"]],
      "off": [[0.07, "tune", -4]]}},
    "heada": {"part": "gain", "input": "head", "gain": {
      "on": [[0, 0], [0.001, 0.9]],
      "off": [["0.2 + 45 / tune", 0, -5]]}},
    "mode": {"part": "wave", "freq": {
      "on": [[0, "tune * 1.59 * 1.15"]],
      "off": [[0.05, "tune * 1.59", -4]]}},
    "modea": {"part": "gain", "input": "mode", "gain": {
      "on": [[0, 0], [0.001, 0.3]],
      "off": [[0.15, 0, -6]]}},
    "stick": {"part": "noise", "seed": 8},
    "stickb": {"part": "filter", "kind": "band", "q": 1.0, "input": "stick", "cutoff": "min(tune * 12, 6000)"},
    "sticka": {"part": "gain", "input": "stickb", "gain": {
      "on": [[0, 0], [0.0005, 0.4]],
      "off": [[0.02, 0, -5]]}},
    "all": {"part": "mix", "inputs": ["heada", "modea", "sticka"], "gain": 0.4}
  },
  "out": "all"
}
