import r from './recipe.cul'

let RATE = 8000

let made = |doc| r.Recipe.new(doc, name: "t", rate: RATE)

# A recipe of one sine through a gain, the gain's value `gain`.
let sine = |gain| made({
  recipe: 1,
  knobs: {bright: {"default": 0.5, min: 0, max: 1}},
  parts: {w: {part: "wave"}, g: {part: "gain", input: "w", gain: gain}},
  out: "g",
})

# What `f` throws, nil for nothing.
fn thrown(f) {
  try {
    f()
    nil
  } catch e {
    e
  }
}

fn says(doc, text) {
  let e = thrown(|| made(doc))
  assert_true(e is String && e.contains(text), e)
}

# A sine's sample `i` at `pitch` as a recipe's output is heard: 2 pi f t,
# through the high-pass at 20 Hz that every recipe's output passes.
let raw_sine = |pitch, i| Math.sin(2.0 *
  Math.pi *
  440.0 *
  2.0 ** ((pitch - 69) / 12.0) *
  i /
  RATE)
let sine_at = |pitch, i| Audio.filter(
  iota(i + 1).map(|j| raw_sine(pitch, j)),
  "high",
  20.0,
  rate: RATE,
)[i]

@test
fn an_offset_is_cut_from_what_a_recipe_plays() {
  # A square at 0 Hz is a steady 1: an offset alone, gone within 0.2 s.
  let steady = made({
    recipe: 1,
    parts: {w: {part: "wave", kind: "square", freq: 0}},
    out: "w",
  })
  let s = steady.note(69, 0.5)
  assert_true(s[0] > 0.9, s[0])
  assert_true(iota(1600, 4000).all(|i| Math.abs(s[i]) < 0.01), s[1600])
}

@test
fn a_note_is_its_graph_rendered_for_its_length_at_its_level() {
  let s = sine(0.5).note(69, 0.1, level: 0.8)
  assert_eq(s.size(), 800)
  for i in [1, 17, 401, 799] {
    assert_true(Math.abs(s[i] - 0.4 * sine_at(69, i)) < 1e-9, i)
  }
}

@test
fn an_expression_reads_the_note_and_the_knobs() {
  let s = sine("bright * (pitch - 60) / 18").note(
    66,
    0.05,
    params: {bright: 0.6},
  )
  assert_true(Math.abs(s[123] - 0.2 * sine_at(66, 123)) < 1e-9, s[123])
}

@test
fn an_envelope_is_held_while_the_note_is_and_released_from_where_it_was_cut() {
  let v = sine({on: [[0, 0], [0.5, 1]], off: [[0.25, 0]]})
  # Cut half way up, at 0.5; off falls from there to nothing in 0.25 s.
  let s = v.note(69, 0.25)
  assert_eq(s.size(), 4000)
  let peak = |lo, hi| iota(lo, hi).map(|i| Math.abs(s[i])).max()
  assert_true(Math.abs(peak(1980, 2020) - 0.5) < 0.01, peak(1980, 2020))
  assert_true(Math.abs(peak(2980, 3020) - 0.25) < 0.01, peak(2980, 3020))
  assert_true(peak(3960, 4000) < 0.01, peak(3960, 4000))
}

@test
fn a_curve_below_zero_falls_as_an_exponential() {
  # From 1 to e^-3 over a second with a curve of -3 is e^(-3t) itself.
  let c = r.course(
    r.value({on: [[0, 1], [1, "exp(-3)", -3]]}, ["dur"], "v"),
    {},
    1.0,
    "v",
  )
  for (t, v) in c {
    assert_true(Math.abs(v - Math.exp(-3.0 * t)) < 1e-12, (t, v))
  }
  # Drawn in straight pieces 10 ms long.
  assert_eq(c.size(), 101)
}

@test
fn a_knob_left_out_is_its_default_and_one_out_of_range_is_refused() {
  let s = sine("bright").note(69, 0.05)
  assert_true(Math.abs(s[123] - 0.5 * sine_at(69, 123)) < 1e-9, s[123])
  let e = thrown(|| sine("bright").note(69, 0.05, params: {bright: 1.5}))
  assert_true(e.contains("bright is from 0.0 to 1.0, not 1.5"), e)
  let e2 = thrown(|| sine("bright").note(69, 0.05, params: {brigt: 0.5}))
  assert_true(e2.contains("no knob `brigt`"), e2)
}

@test
fn a_phrase_is_its_notes_mixed_at_their_times() {
  let s = sine(0.5).phrase(
    [{pitch: 69, at: 0.0, len: 0.1}, {pitch: 72, at: 0.2, len: 0.1}],
    {},
  )
  let xs = Audio.decode(s.data()).channels[0]
  assert_eq(xs.size(), 2400)
}

@test
fn a_chord_is_its_notes_mixed_headroom_down_under_full_scale() {
  # Three sines at 1.2, together up to 3.6.
  let notes = [69, 73, 76].map(|p| {pitch: p, at: 0.0, len: 0.1, level: 1.2})
  let v = sine(1.0)
  let xs = Audio.decode(v.phrase(notes, {}).data()).channels[0]
  let each = notes.map(|n| v.note(n.pitch, n.len, n.level))
  let want = iota(xs.size()).map(|i| r.HEADROOM * each.map(|s| s[i]).sum())
  # As close as the 16 bits a Sound keeps, and with room under full scale,
  # where a clipped sample would sit.
  assert_true(iota(xs.size()).all(|i| Math.abs(xs[i] - want[i]) < 1e-4))
  assert_true(xs.all(|x| Math.abs(x) < 0.95))
}

@test
fn a_gain_takes_modulators_as_the_graph_does() {
  # A tremolo: a 5 Hz wave at 0.3 added to a gain of 0.6.
  let trem = made({
    recipe: 1,
    parts: {
      w: {part: "wave"},
      lfo: {part: "wave", freq: 5},
      depth: {part: "gain", input: "lfo", gain: 0.3},
      g: {part: "gain", input: "w", gain: 0.6, modulators: ["depth"]},
    },
    out: "g",
  })
  let by_hand = Audio.Graph.new(rate: RATE)
  let depth = by_hand.gain(by_hand.wave(freq: 5.0), 0.3)
  let g = by_hand.gain(by_hand.wave(freq: 440.0), 0.6, modulators: [depth])
  by_hand.output(by_hand.filter("high", by_hand.gain(g, 1.0), cutoff: 20.0))
  assert_eq(trem.note(69, 0.3), by_hand.render(0.3))
}

@test
fn a_pluck_takes_modulators_as_the_graph_does() {
  # A vibrato: a 5 Hz wave at 4 Hz added to the string's freq.
  let bent = made({
    recipe: 1,
    parts: {
      kick: {part: "noise", seed: 3},
      lfo: {part: "wave", freq: 5},
      depth: {part: "gain", input: "lfo", gain: 4},
      s: {part: "pluck", input: "kick", modulators: ["depth"]},
    },
    out: "s",
  })
  let by_hand = Audio.Graph.new(rate: RATE)
  let depth = by_hand.gain(by_hand.wave(freq: 5.0), 4.0)
  let s = by_hand.pluck(by_hand.noise(seed: 3), freq: 440.0, modulators: [depth])
  by_hand.output(by_hand.filter("high", by_hand.gain(s, 1.0), cutoff: 20.0))
  assert_eq(bent.note(69, 0.3), by_hand.render(0.3))
}

@test
fn a_drive_is_the_graph_drive_at_its_gain() {
  # Driven at 3 times the level, then (as every note) played at the level.
  let bent = made({
    recipe: 1,
    parts: {w: {part: "wave"}, d: {part: "drive", input: "w", gain: "3 * level"}},
    out: "d",
  })
  let by_hand = Audio.Graph.new(rate: RATE)
  let d = by_hand.drive(by_hand.wave(freq: 440.0), 1.5)
  by_hand.output(by_hand.filter("high", by_hand.gain(d, 0.5), cutoff: 20.0))
  assert_eq(bent.note(69, 0.1, 0.5), by_hand.render(0.1))
}

# A drum whose values' `on` last 0.02 s (the freq), 0.08 s (a gain) and
# 0.05 s (the gain it plays, then its `off` of 0.1 s).
let struck = made({
  recipe: 1,
  knobs: {tune: {"default": 500, min: 100, max: 1000}},
  parts: {
    w: {part: "wave", freq: {on: [[0, "tune"], [0.02, "tune / 2"]]}},
    swell: {part: "gain", input: "w", gain: {on: [[0, 0.5], [0.08, 1]]}},
    g: {part: "gain", input: "swell", gain: {on: [[0, 0], [0.01, 1], [0.05, 0.5]], off: [[0.1, 0]]}},
  },
  out: "g",
})

@test
fn a_hit_is_held_while_its_on_lasts_or_until_the_next_if_sooner() {
  # Held for the longest `on` of all its values, struck at middle C.
  assert_eq(struck.hit(0.8), struck.note(60, 0.08, 0.8))
  # Cut where the next hit comes, when that is sooner.
  assert_eq(struck.hit(0.8, 0.03), struck.note(60, 0.03, 0.8))
  assert_eq(struck.hit(0.8, 0.2), struck.note(60, 0.08, 0.8))
  # Its knobs at the params given.
  assert_eq(struck.hit(params: {tune: 300}), struck.note(60, 0.08, 1.0, {tune: 300}))
  # As Kauai takes a drum: a Sound of the hit, hearing its level and the
  # next hit (0.03 s, then the `off`'s 0.1 s).
  let d = struck.drum()
  assert_eq(d.hears, ["level", "next"])
  assert_eq(Audio.decode(d.hit({level: 0.8, next: 0.03}, {}).data()).channels[0].size(), 1040)
}

@test
fn a_recipe_is_checked_whole_before_it_plays() {
  let wave = {part: "wave"}
  let doc = |parts, out| {recipe: 1, parts: parts, out: out}
  says({recipe: 2, parts: {w: wave}, out: "w"}, "recipe t: `recipe` is 1")
  says({...doc({w: wave}, "w"), sound: 1}, "not `sound`")
  says(doc({w: {part: "wav"}}, "w"), "recipe t.parts.w.part: no part `wav`")
  says(
    doc({w: {part: "wave", frq: 3}}, "w"),
    "recipe t.parts.w: a wave has kind, part, modulators, freq, feedback, phase, not `frq`",
  )
  says(doc({w: wave}, "v"), "recipe t.parts: out: no part `v`")
  says(
    doc({w: wave, g: {part: "gain", input: "x"}}, "g"),
    "recipe t.parts.g: no part `x`",
  )
  says(doc({w: wave, v: wave}, "w"), "recipe t.parts: `v` does not reach out")
  says(
    doc(
      {
        a: {part: "wave", modulators: ["b"]},
        b: {part: "wave", modulators: ["a"]},
      },
      "a",
    ),
    "recipe t.parts: `a` takes itself in",
  )
  says(
    doc({w: {part: "wave", freq: "f * 2 +"}}, "w"),
    "recipe t.parts.w.freq: cannot read `f * 2 +`: column",
  )
  says(
    doc({w: {part: "wave", freq: "g * 2"}}, "w"),
    "recipe t.parts.w.freq: `g * 2`: no name `g`; it may name pitch, f, dur, level",
  )
  says(doc({w: {part: "wave", freq: "cube(f)"}}, "w"), "no function `cube`")
  says(doc({w: {part: "wave", freq: "min(f)"}}, "w"), "`min` takes 2, given 1")
  says(
    doc({w: {part: "wave", freq: {on: [[0, 1]], of: []}}}, "w"),
    "an envelope has on, off, not `of`",
  )
  says(
    doc({w: {part: "wave", freq: {on: [[0]]}}}, "w"),
    "recipe t.parts.w.freq.on[0]: a point is",
  )
  says(
    {
      recipe: 1,
      knobs: {Bright: {"default": 0, min: 0, max: 1}},
      parts: {w: wave},
      out: "w",
    },
    "a word in lower case",
  )
  says(
    {
      recipe: 1,
      knobs: {f: {"default": 0, min: 0, max: 1}},
      parts: {w: wave},
      out: "w",
    },
    "`f` names the note",
  )
}

@test
fn a_patch_goes_over_its_target_as_json_merge_patch_says() {
  # RFC 7386's own examples (its appendix A), a few of them.
  let m = |a, b| r.merged(JSON.parse(a), JSON.parse(b))
  assert_eq(m(`{"a":"b"}`, `{"a":"c"}`), {a: "c"})
  assert_eq(m(`{"a":"b"}`, `{"a":null}`), {})
  assert_eq(m(`{"a":"b","b":"c"}`, `{"a":null}`), {b: "c"})
  assert_eq(m(`{"a":["b"]}`, `{"a":"c"}`), {a: "c"})
  assert_eq(m(`{"a":{"b":"c"}}`, `{"a":{"b":"d","c":null}}`), {a: {b: "d"}})
  assert_eq(m(`{"a":[{"b":"c"}]}`, `{"a":[1]}`), {a: [1]})
  assert_eq(m(`{"e":null}`, `{"a":1}`), {e: nil, a: 1})
  assert_eq(m(`[1,2]`, `{"a":"b","c":null}`), {a: "b"})
}

@test
fn a_recipe_with_a_base_is_its_base_with_the_rest_over_it() {
  let book = {
    tone: {
      recipe: 1,
      knobs: {bright: {"default": 0.5, min: 0, max: 1}},
      parts: {w: {part: "wave"}, g: {part: "gain", input: "w", gain: "bright"}},
      out: "g",
    },
    dark: {base: "tone", knobs: {bright: {"default": 0.1}}},
    darker: {base: "dark", parts: {g: {gain: "bright / 2"}}},
    loop: {base: "round"},
    round: {base: "loop"},
  }
  let find = |name| book.get(name, nil)
  let darker = r.resolved("darker", find)
  assert_eq(darker.knobs.bright, {"default": 0.1, min: 0, max: 1})
  assert_eq(darker.parts.g, {part: "gain", input: "w", gain: "bright / 2"})
  assert_false(darker.has("base"))
  let s = r.Recipe.new(darker, name: "darker", rate: RATE).note(69, 0.05)
  assert_true(Math.abs(s[123] - 0.05 * sine_at(69, 123)) < 1e-9, s[123])
  let e = thrown(|| r.resolved("loop", find))
  assert_true(
    e.contains("recipe loop: its base is itself, through loop, round"),
    e,
  )
  let e2 = thrown(|| r.resolved("dim", find))
  assert_true(e2.contains("recipe dim: no recipe of that name"), e2)
}

@test
fn what_only_the_note_can_say_is_refused_when_it_plays() {
  # Times that go back, read for this note.
  let back = sine({on: [[0, 0], ["dur", 1], [0.05, 0.5]]})
  let e = thrown(|| back.note(69, 0.1))
  assert_true(e.contains("recipe t.parts.g.gain.on[2]: its time is before"), e)
  # A value the graph refuses, with where it is in the recipe.
  let high = made({
    recipe: 1,
    parts: {w: {part: "wave", freq: "f * 8"}},
    out: "w",
  })
  let e2 = thrown(|| high.note(81, 0.1))
  assert_true(
    e2 is String && e2.starts_with("recipe t.parts.w: Audio.Graph:"),
    e2,
  )
}

# A recipe at the device's rate, which a held note plays at.
let live = r.Recipe.new({
  recipe: 1,
  parts: {
    w: {part: "wave", freq: {on: [[0, "f * 0.98"], [0.05, "f", -3]]}},
    g: {part: "gain", input: "w", gain: {on: [[0, 0], [0.02, "level"]], off: [[0.05, 0]]}},
  },
  out: "g",
}, name: "t")

@test
fn a_note_made_ahead_and_begun_sounds_as_the_same_note_written() {
  # Begun at a pitch and a level, it is the note of that pitch and level for
  # as long as it is held, at its volume where the note written is at its
  # level.
  for (pitch, level, volume) in [(48, 0.5, 0.5), (72, 1.5, 0.5)] {
    let held = live.prepare().begin(pitch, level, volume)
    let heard = held.graph.render(0.1)
    held.graph.stop()
    # The note written goes on into its `off`.
    let written = live.note(pitch, 0.1, level)
    assert_eq(heard.size(), 4410)
    assert_true(iota(heard.size()).all(|i| Math.abs(heard[i] - written[i] * volume / level) < 1e-12))
  }
  # Louder than full scale (2.25 at its peak), it is held under it.
  let loud = live.prepare().begin(72, 1.5, 1.5)
  let peak = loud.graph.render(0.1).map(|x| Math.abs(x)).max()
  loud.graph.stop()
  assert_true(peak > 0.8 && peak <= 0.9, peak)
}

@test
fn a_knob_turned_while_a_note_is_held_moves_what_reads_it() {
  # A 1 kHz sine through a gain of the knob, and a second gain that does not
  # read it: the sine's peak arrives at the knob's new value.
  let knobbed = r.Recipe.new({
    recipe: 1,
    knobs: {bright: {"default": 0.5, min: 0, max: 1}},
    parts: {
      w: {part: "wave", freq: 1000},
      g: {part: "gain", input: "w", gain: "bright"},
      h: {part: "gain", input: "g", gain: 0.8},
    },
    out: "h",
  }, name: "t")
  let peak = |xs| xs.map(|v| Math.abs(v)).max()
  let end = fn (turn) {
    let held = knobbed.prepare({bright: 0.25}).begin(60)
    held.knob("bright", 0.75) if turn
    let heard = held.graph.render(0.5)
    held.graph.stop()
    peak(heard[-441..])
  }
  assert_close(end(false), 0.25 * 0.8, 0.002)
  assert_close(end(true), 0.75 * 0.8, 0.002)
  # A knob the recipe has not, or out of its range, is refused as anywhere.
  let other = knobbed.prepare().begin(60)
  assert_eq(thrown(|| other.knob("dark", 0.5)), "recipe t: no knob `dark`; it has bright")
  assert_eq(thrown(|| other.knob("bright", 2)), "recipe t: bright is from 0.0 to 1.0, not 2")
  other.graph.stop()
}

@test
fn a_held_note_begins_once() {
  let held = live.prepare().begin(60)
  let e = thrown(|| held.begin(62))
  held.graph.stop()
  assert_eq(e, "a held note begins once; prepare() another")
}

@test
fn live_the_breath_is_the_attack_and_the_brightness_of_a_recipe_with_one() {
  # A 1 kHz sine through a gain of the knob, out through a gain with an
  # attack: legato, and the breath turns the knob.
  let doc = |out_gain| {
    recipe: 1,
    knobs: {bright: {"default": 0.5, min: 0, max: 1}},
    parts: {
      w: {part: "wave", freq: 1000},
      g: {part: "gain", input: "w", gain: "bright"},
      h: {part: "gain", input: "g", gain: out_gain},
    },
    out: "h",
  }
  let peak = |xs| xs.map(|v| Math.abs(v)).max()
  let blown = r.LivePlayer(r.Recipe.new(doc({on: [[0, 0], [0.02, 0.8]]}), name: "t"))
  assert_true(blown.legato)
  let held = blown.prepare().begin(60)
  blown.breath(held, 1.0)
  assert_close(peak(held.graph.render(0.5)[-441..]), 0.8, 0.002)
  held.graph.stop()
  # Without one, it strikes every note and the breath leaves the knob.
  let struck = r.LivePlayer(r.Recipe.new(doc(0.8), name: "t"))
  assert_false(struck.legato)
  let other = struck.prepare().begin(60)
  struck.breath(other, 1.0)
  assert_close(peak(other.graph.render(0.5)[-441..]), 0.5 * 0.8, 0.002)
  other.graph.stop()
  # An attack that fades away by itself, as a plucked bass's, is struck too.
  assert_false(r.LivePlayer(r.Recipe.new(doc({on: [[0, 0], [0.01, 0.8], [2, 0.01]]}), name: "t")).legato)
}
