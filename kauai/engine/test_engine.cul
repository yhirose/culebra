import engine from './borrow.cul'
import synthetic from './synthetic.cul'

let RATE = synthetic.RATE
let STYLE = synthetic.STYLE

let PHRASE = [{
  pitch: 72,
  at: 0.0,
  len: 0.8,
  level: 1.0,
  level_end: 1.0,
  marks: [],
  next: nil,
  params: {},
}]

let rms = |xs| Math.sqrt(xs.map(|v| v * v).sum() / xs.size())

@test
fn an_instrument_made_from_one_performance_plays_a_phrase_in_tune() {
  let dir = FS.join(FS.temp_dir(), "engine-test-{UUID.v4()}")
  defer {
    FS.remove(dir, recursive: true) if FS.exists(dir)
  }
  FS.mkdir(dir)
  let data = synthetic.made_into(dir).data
  let one = engine.Instrument.new(data, STYLE)
  let s = one.phrase_samples(PHRASE, {})
  assert_true(s.size() >= 0.8 * RATE)
  assert_true(s.size() <= 0.9 * RATE)
  let hz = Audio.pitch(s, 200.0, 1400.0, RATE).hz.filter(|h| h != nil).sorted()
  let middle = hz[hz.size() / 2]
  assert_true(
    Math.abs(1200.0 * Math.log(middle / 523.25) / Math.log(2.0)) < 40.0,
    middle,
  )

  # Two instruments in one process keep to their own style: the second,
  # louder by 10 dB, leaves the first sounding as it did.
  let louder = engine.Instrument.new(
    data,
    {...STYLE, mf_db: STYLE.mf_db + 10.0},
  )
  let t = louder.phrase_samples(PHRASE, {})
  assert_true(Math.abs(20.0 * Math.log(rms(t) / rms(s)) / Math.log(10.0) -
    10.0) <
    1.0)
  # Each phrase has its own noise, numbered per instrument: another
  # instrument's first phrase is the first one's, whatever was voiced between.
  let again = engine.Instrument.new(data, STYLE)
  assert_eq(again.phrase_samples(PHRASE, {}), s)

  # A style put on an instrument that has played is the style's sound again
  # from the first phrase, as a new instrument's.
  one.restyle({...STYLE, mf_db: STYLE.mf_db + 10.0})
  assert_true(rms(one.phrase_samples(PHRASE, {})) > 2.0 * rms(s))
  one.restyle(STYLE)
  assert_eq(one.phrase_samples(PHRASE, {}), s)

  # A style says what it must and may leave out what has a default.
  let lacking = try {
    one.restyle({db_per_octave: 5.0})
    nil
  } catch e {
    e
  }
  assert_eq(lacking, "style lacks `mf_db`")
}

@test
fn a_note_longer_than_every_recording_plays_with_no_steady_one() {
  let dir = FS.join(FS.temp_dir(), "engine-test-{UUID.v4()}")
  defer {
    FS.remove(dir, recursive: true) if FS.exists(dir)
  }
  FS.mkdir(dir)
  let one = engine.Instrument.new(synthetic.made_into(dir).data, STYLE)
  # Recordings of single notes that each swell or fade inside are none of
  # them steady; the note is filled out from the one it borrows.
  one.steady = []
  let long = [{...PHRASE[0], len: 3.0}]
  let s = one.phrase_samples(long, {})
  assert_true(s.size() >= 3.0 * RATE)
  let hz = Audio.pitch(s, 200.0, 1400.0, RATE).hz.filter(|h| h != nil).sorted()
  let middle = hz[hz.size() / 2]
  assert_true(
    Math.abs(1200.0 * Math.log(middle / 523.25) / Math.log(2.0)) < 40.0,
    middle,
  )
}

@test
fn a_bend_keeps_the_instruments_resonances_where_they_were_in_hz() {
  # A tone whose strongest harmonic is the 10th (index 9). Sounded an octave
  # lower, its resonance stays at the same frequency, which is now the 20th
  # harmonic; an octave higher, the 5th.
  let logs = iota(40).map(|h| -Math.abs(h - 9.0))
  let peak = |xs| iota(xs.size()).max_by(|h| xs[h])
  assert_eq(peak(engine.reshaped(logs, 1.0)), 9)
  assert_eq(peak(engine.reshaped(logs, 0.5)), 19)
  assert_eq(peak(engine.reshaped(logs, 2.0)), 4)
  # Between two harmonics it is the line between them, and below the first
  # harmonic it is the first's.
  let two = engine.reshaped([0.0, -4.0, -8.0], 0.75)
  assert_eq(two, [0.0, -2.0, -5.0])
}

@test
fn a_style_without_a_number_it_needs_is_said_so() {
  let said = try {
    engine.Instrument.new(Dir.memory({}), {})
    nil
  } catch e {
    e
  }
  assert_true(said != nil)
  assert_true(engine.DEFAULTS.keys().contains("scoop"))
}
