import bend from './bend.cul'

# The fall the listener chose: the pitch gathers speed, and the loudness is
# loudest at the start, falls at once and thins out softly to nothing. (The
# measured shape of a jazz alto's falls, a hard push on landing and a collapse
# to breath, was heard as a blunt "buh" and given up.)

@test
fn the_pitch_gathers_speed() {
  let semis = |u| bend.fall_course(u).semis
  assert_eq(semis(0.0), 0.0)
  assert_eq(semis(1.0), -9.0)
  # Slow at first: a quarter of the way down at half way.
  assert_true(semis(0.5) > -2.5 && semis(0.5) < -2.0, semis(0.5))
}

@test
fn the_loudness_is_greatest_at_the_start_and_thins_out_softly() {
  let gain = |u| bend.fall_course(u).gain
  assert_eq(gain(0.0), 1.0)
  # No push: it never gets louder than the note it leaves.
  assert_true(iota(101).all(|q| gain(0.01 * q) <= 1.0))
  # It begins to fall at once: half way, well under half.
  assert_true(gain(0.5) < 0.5, gain(0.5))
  assert_true(iota(100).all(|q| gain(0.01 * q) >= gain(0.01 * (q + 1))))
  # No step at the end.
  assert_eq(gain(1.0), 0.0)
  assert_true(gain(0.99) < 0.02, gain(0.99))
}

@test
fn past_its_end_the_fall_is_over() {
  assert_eq(bend.fall_course(1.4).gain, 0.0)
  assert_eq(bend.fall_course(1.4).semis, bend.fall_course(1.0).semis)
  assert_eq(bend.fall_course(-0.2).semis, 0.0)
}
