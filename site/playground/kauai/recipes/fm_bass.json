{
  "recipe": 1,
  "knobs": {"bright": {"default": 0.5, "min": 0, "max": 1}},
  "parts": {
    "m1": {"part": "wave", "feedback": "0.8 * (0.5 + bright)"},
    "i1": {"part": "gain", "input": "m1",
           "gain": {"on": [[0, "(0.5 + bright) * level"], [0.25, "(0.5 + bright) * level", -4],
                           [4, "0.6 * (0.5 + bright) * level", -2]]}},
    "c1": {"part": "wave", "modulators": ["i1"]},
    "amp": {"part": "gain", "input": "c1",
            "gain": {"on": [[0, 0], [0.004, 0.5], [3.5, 0.05, -2.3], [7, 0.005, -2.3]],
                     "off": [[0.25, 0, -4]]}}
  },
  "out": "amp"
}
