{
  "recipe": 1,
  "knobs": {
    "bright": {"default": 1, "min": 0, "max": 2},
    "sparkle": {"default": 0.5, "min": 0, "max": 1},
    "chorus": {"default": 1, "min": 0, "max": 1}
  },
  "parts": {
    "m1": {"part": "wave"},
    "i1": {"part": "gain", "input": "m1",
           "gain": {"on": [[0, "bright * 1.65"], [3, "bright * (1.4 * exp(-18) + 0.25)", -18]]}},
    "c1": {"part": "wave", "modulators": ["i1"]},
    "a1": {"part": "gain", "input": "c1",
           "gain": {"on": [[0, 0], [0.0018, "0.25 * exp(-(0.8 - 0.2 * sparkle) * 1.1 * sqrt(f / 261.63) * 0.0018)"],
                           [3, "0.25 * exp(-(0.8 - 0.2 * sparkle) * 1.1 * sqrt(f / 261.63) * 3)", "-(0.8 - 0.2 * sparkle) * 1.1 * sqrt(f / 261.63) * (3 - 0.0018)"]],
                    "off": [[0.036, 0]]}},
    "m2": {"part": "wave", "freq": "f * 1.0025"},
    "i2": {"part": "gain", "input": "m2",
           "gain": {"on": [[0, "bright * 1.65"], [3, "bright * (1.4 * exp(-18) + 0.25)", -18]]}},
    "c2": {"part": "wave", "freq": "f * 1.0025", "modulators": ["i2"]},
    "a2": {"part": "gain", "input": "c2",
           "gain": {"on": [[0, 0], [0.0018, "0.25 * exp(-(0.8 - 0.2 * sparkle) * 1.1 * sqrt(f / 261.63) * 0.0018)"],
                           [3, "0.25 * exp(-(0.8 - 0.2 * sparkle) * 1.1 * sqrt(f / 261.63) * 3)", "-(0.8 - 0.2 * sparkle) * 1.1 * sqrt(f / 261.63) * (3 - 0.0018)"]],
                    "off": [[0.036, 0]]}},
    "m3": {"part": "wave", "freq": "min(8 * f, 18000)"},
    "i3": {"part": "gain", "input": "m3",
           "gain": {"on": [[0, "bright * 0.9 * level"], ["1 + sparkle", 0, -5]]}},
    "c3": {"part": "wave", "modulators": ["i3"]},
    "a3": {"part": "gain", "input": "c3",
           "gain": {"on": [[0, 0], [0.0018, "0.25 * sparkle"], ["1 + sparkle", 0, -5]], "off": [[0.036, 0]]}},
    "both": {"part": "mix", "inputs": ["a1", "a2", "a3"]},
    "sweep": {"part": "wave", "freq": 0.6},
    "sweepl": {"part": "gain", "input": "sweep", "gain": 0.002},
    "copy": {"part": "delay", "input": "both", "time": 0.012, "modulators": ["sweepl"]},
    "copyl": {"part": "gain", "input": "copy", "gain": "0.6 * chorus"},
    "ensemble": {"part": "mix", "inputs": ["both", "copyl"], "gain": "1 / sqrt(1 + 0.36 * chorus)"}
  },
  "out": "ensemble"
}
