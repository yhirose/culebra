# A plucked string: a short burst of noise ringing in a delay as
# long as one period. Three strings struck one after another make
# an A minor chord.
let {*} = Synth

let string = fn (note, at) {
  let strike = noise() * perc(0.001, 0.01)
  strike.pluck(note.hz(), ring: 2.0).delay(at)
}

[string(57.0, 0.0), string(60.0, 0.15), string(64.0, 0.3)].mix() * 0.5
