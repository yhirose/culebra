# Synth Studio: a sound written as an expression. Play (or
# Cmd/Ctrl+Enter) plays the last expression; with part of the code
# selected, just that part. Select `bell` on the last line and play
# it to hear the bell alone.
let {*} = Synth

# A pad: two saws a little apart, through a low-pass that breathes.
let sweep = 700.0 + 0.4.sine() * 400.0
let pad = [110.0, 110.6].saw().mix().lowpass(sweep, q: 2.0) * 0.2

# A bell: one sine moving another's phase (FM), dying out first.
let index = perc(0.001, 1.2, peak: 3.0)
let ring = perc(0.002, 2.5, peak: 0.3)
let bell = 440.0.sine(phase: 616.0.sine() * index) * ring

# A string, plucked at A.
let string = noise() * perc(0.001, 0.01) |> pluck(57.0.hz(), ring: 1.5)

((pad + bell + string) * 0.6).reverb(mix: 0.3)
