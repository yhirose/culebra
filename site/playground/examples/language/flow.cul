fn classify(n) {
  if n < 0 {
    "negative"
  } else if n == 0 {
    "zero"
  } else {
    "positive"
  }
}

for n in [-2, 0, 5] { println("classify({n}) = {classify(n)}") }

for i, (fname, lname) in [["John", "Smith"], ["Hello", "World"]].enumerate() {
  println("{i}: fname={fname}, lname={lname}")
}

# `cond`: a subjectless multi-way conditional — the first truthy `test`
# wins, `_` is the always-match default
fn grade(n) {
  cond {
    n >= 90 => "A",
    n >= 80 => "B",
    n >= 70 => "C",
    _ => "F",
  }
}

for n in [95, 82, 40] { println("grade({n}) = {grade(n)}") }

# `while` with an init clause: the counter is scoped to the loop
while mut i = 0; i < 3 {
  println("while i = {i}")
  i += 1
}

for i in 0..10 by 3 { println("forward: step i = {i}") }

for i in 3..=0 by -1 { println("reverse: step i = {i}") }

fn find_first_even(xs) {
  for x in xs {
    if x % 2 == 0 { return "found {x}" }
  } nobreak { return "no even number" }
}

println(find_first_even([1, 3, 4, 5]))
println(find_first_even([1, 3, 5]))

for x in 1..=5 {
  if x == 3 { continue }
  if x == 5 { break }
  println("loop x = {x}")
}
