fn classify(n) {
  if n < 0 {
    "negative"
  } else if n == 0 {
    "zero"
  } else {
    "positive"
  }
}

for n in [-2, 0, 5] {
  println("classify({n}) = {classify(n)}")
}

# `while` with an init clause: the counter is scoped to the loop
while mut i = 0; i < 3 {
  println("while i = {i}")
  i += 1
}

for i in 0..10 by 3 {
  println("step i = {i}")
}

fn find_first_even(xs) {
  for x in xs {
    if x % 2 == 0 {
      return "found {x}"
    }
  } nobreak {
    return "no even number"
  }
}

println(find_first_even([1, 3, 4, 5]))
println(find_first_even([1, 3, 5]))

for x in 1..=5 {
  if x == 3 {
    continue
  }
  if x == 5 {
    break
  }
  println("loop x = {x}")
}
