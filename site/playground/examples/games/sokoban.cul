fn button_rect(i) {
  (PANEL_X + i % 2 * 168, 252 + i / 2 * 32, 152, 28)
}

class Game {
  # Session state, alive across levels.
  interactive = IO.stdin_is_terminal()
  quit = false
  was_down = false
  frame = 0
  total = 0
  cleared = 0
  entry = ''
  mode = Mode.Play
  # Per-level state, owned by load() below.
  level: Long
  w: Long
  h: Long
  ox: Long
  oy: Long
  x: Long
  y: Long
  tiles: Array
  goals: Set
  crates: Set
  history: Array
  at: Long
  moves: Long
  pushes: Long
  cursor: Long
  hold_frames: Long
  target: Tuple?

  new(level) {
    self.load(level)
  }

  # `#` wall, `.` goal, `$` crate, `@` player, `*` crate on a goal, `+` player
  # on a goal. Rows need not be padded to the same length.
  load(n) {
    return if n < 0 || n >= LEVELS.size()
    self.level = n
    let rows = LEVELS[n].board.lines()
    self.h = rows.size()
    self.w = rows.max_by(|r| r.size()).size()
    self.ox = (BOARD_W - self.w * TILE) / 2
    self.oy = (BOARD_H - self.h * TILE) / 2
    self.tiles = iota(self.h).map(|_| repeat(self.w, Tile.Floor))
    self.goals = [].to_set()
    self.crates = [].to_set()
    for y, row in rows.enumerate() {
      for x, ch in row.iter().enumerate() {
        self.tiles[y][x] = Tile.Wall if ch == '#'
        self.goals.add((x, y)) if ch == '.' || ch == '*' || ch == '+'
        self.crates.add((x, y)) if ch == '$' || ch == '*'
        self.place(x, y) if ch == '@' || ch == '+'
      }
    }
    self.seal()
    self.history = []
    self.at = 0
    self.moves = 0
    self.pushes = 0
    self.cursor = 0
    self.hold_frames = 0
    self.target = nil
  }

  place(x, y) {
    self.x = x
    self.y = y
  }

  # Every floor square the border can reach lies beyond the outer wall, so the
  # fill starts from all four edges at once — a ragged level's outside is not
  # one connected run along them.
  seal() {
    mut stack = []
    for x in 0..self.w {
      stack.push((x, 0))
      stack.push((x, self.h - 1))
    }
    for y in 0..self.h {
      stack.push((0, y))
      stack.push((self.w - 1, y))
    }
    while !stack.empty() {
      let (x, y) = stack.pop()
      continue if !self.inside(x, y) || self.tiles[y][x] != Tile.Floor
      self.tiles[y][x] = Tile.Outside
      stack.push((x - 1, y))
      stack.push((x + 1, y))
      stack.push((x, y - 1))
      stack.push((x, y + 1))
    }
  }

  inside(x, y) {
    x >= 0 && x < self.w && y >= 0 && y < self.h
  }

  free(x, y) {
    self.inside(x, y) &&
      self.tiles[y][x] == Tile.Floor &&
      !self.crates.contains((x, y))
  }

  get saved() {
    self.crates.intersect(self.goals).size()
  }

  get solved() {
    self.crates.superset(self.goals)
  }

  unpack(step) {
    match step {
      Push(dx, dy) => (dx, dy, true),
      Walk(dx, dy) => (dx, dy, false),
    }
  }

  # Walk one square, or push the crate standing there when the square behind it
  # is free. Reports whether anything moved; a click-walk stops when it did not.
  walk(dx, dy) {
    let (nx, ny) = (self.x + dx, self.y + dy)
    let pushing = self.crates.contains((nx, ny))
    if pushing {
      return false if !self.free(nx + dx, ny + dy)
      self.crates.remove((nx, ny))
      self.crates.add((nx + dx, ny + dy))
    } else {
      return false if !self.free(nx, ny)
    }
    self.place(nx, ny)
    self.history = self.history.slice(0, self.at)
    self.history.push(pushing ? Step.Push(dx, dy) : Step.Walk(dx, dy))
    self.at += 1
    self.moves += 1
    self.total += 1
    self.pushes += 1 if pushing
    true
  }

  undo() {
    return if self.at == 0
    self.at -= 1
    self.replay(-1)
  }

  redo() {
    return if self.at >= self.history.size()
    self.replay(1)
    self.at += 1
  }

  # Undo and redo are this one step at opposite signs. Adding the crate back
  # after the player has landed is what lets both share it: the crate always
  # ends one square further along than wherever the player stopped.
  replay(sign) {
    let (dx, dy, pushing) = self.unpack(self.history[self.at])
    self.crates.remove((self.x + dx, self.y + dy)) if pushing
    self.place(self.x + sign * dx, self.y + sign * dy)
    if pushing {
      self.crates.add((self.x + dx, self.y + dy))
      self.pushes += sign
    }
    self.moves += sign
  }

  stop() {
    self.quit = true
  }

  ask_level() {
    self.mode = Mode.AskLevel
    self.entry = ''
  }

  # The prompt the original opens for `l`: digits accumulate, enter commits, and
  # an empty entry cancels, exactly as its `readln` loop does.
  type_level(key) {
    match key {
      'enter' => {
        self.load(to_long(self.entry) - 1) unless self.entry.empty()
        self.mode = Mode.Play
      },
      'backspace' if !self.entry.empty() => {
        self.entry = self.entry.slice(0, self.entry.size() - 1).to_string()
      },
      k if k.is_digit() && self.entry.size() < 2 => {
        self.entry += k
      },
      _ => nil,
    }
  }

  # Seed7's playLevel body, minus the loop that waited for a key. The panel
  # buttons route through here too.
  on_key(key) {
    return self.type_level(key) if self.mode == Mode.AskLevel
    match key {
      'up' => self.walk(0, -1),
      'down' => self.walk(0, 1),
      'left' => self.walk(-1, 0),
      'right' => self.walk(1, 0),
      'u' => self.undo(),
      'r' => self.redo(),
      'p' => self.load(self.level - 1),
      'n' => self.load(self.level + 1),
      's' => self.load(self.level),
      'l' => self.ask_level(),
      'q' => self.stop(),
      _ => nil,
    }
  }

  on_mouse() {
    let m = Canvas.mouse()
    let down = m.buttons & 1 != 0
    let pressed = down && !self.was_down
    self.was_down = down
    return if !pressed

    for i, b in BUTTONS.enumerate() {
      let (bx, by, bw, bh) = button_rect(i)
      return self.on_key(b.key) if Canvas.point_in_rect(
        m.x,
        m.y,
        bx,
        by,
        bw,
        bh,
      )
    }
    if Canvas.point_in_rect(m.x, m.y, self.ox, self.oy, self.w * TILE, self.h * TILE) {
      self.target = ((m.x - self.ox) / TILE, (m.y - self.oy) / TILE)
    }
  }

  # One step per frame toward the last click, the bigger gap first, until the
  # player arrives or a wall stops it. Seed7 runs the same walk inside a
  # `repeat` with a 100 ms wait between steps; here a frame is that wait.
  follow_click() {
    return if self.target == nil
    let (tx, ty) = self.target
    let (dx, dy) = (tx - self.x, ty - self.y)
    if dx == 0 && dy == 0 {
      self.target = nil
      return
    }
    let moved = Math.abs(dx) > Math.abs(dy)
      ? self.walk(Math.sign(dx), 0)
      : self.walk(0, Math.sign(dy))
    self.target = nil unless moved
  }

  # No terminal (a piped run, CI) means nobody is going to press a key, so the
  # recorded solutions play themselves and the run ends after the last level.
  # `cleared` is the check that they really are solutions.
  play_demo() {
    let script = LEVELS[self.level].demo
    if self.cursor >= script.size() {
      self.hold_frames += 1
      return if self.hold_frames < 20
      self.cleared += 1 if self.solved
      return self.stop() if self.level + 1 >= LEVELS.size()
      return self.load(self.level + 1)
    }
    return if self.frame % 3 != 0
    let (dx, dy) = STEPS[script.slice(self.cursor, self.cursor + 1)]
    self.cursor += 1
    self.walk(dx, dy)
  }

  tick() {
    self.frame += 1
    if self.interactive {
      for key in Canvas.key_queue() {
        self.on_key(key)
      }
      if self.mode == Mode.Play {
        self.on_mouse()
        self.follow_click()
      }
    } else {
      self.play_demo()
    }
    self.draw()
    !self.quit
  }

  draw() {
    Canvas.clear(BG)
    for (x, y) in grid(0..self.w, 0..self.h) {
      let (px, py) = (self.ox + x * TILE, self.oy + y * TILE)
      match self.tiles[y][x] {
        t: Wall => blit(WALL_TILE, px, py),
        t: Floor => self.draw_square(x, y, px, py),
        t: Outside => nil,
      }
    }
    self.draw_panel()
    self.draw_banner()
  }

  draw_square(x, y, px, py) {
    let on_goal = self.goals.contains((x, y))
    blit(FLOOR_TILE, px, py)
    blit(GOAL_TILE, px, py) if on_goal
    let crate = on_goal ? DONE_TILE : CRATE_TILE
    blit(crate, px, py) if self.crates.contains((x, y))
    blit(PLAYER_TILE, px, py) if x == self.x && y == self.y
  }

  draw_panel() {
    Canvas.text('SOKOBAN', PANEL_X, 12, TEXT, FONT + 1)
    let stats = [
      "Level    {self.level + 1} / {LEVELS.size()}",
      "Crates   {self.saved} / {self.goals.size()}",
      "Moves    {self.moves}",
      "Pushes   {self.pushes}",
    ]
    for i, line in stats.enumerate() {
      Canvas.text(line, PANEL_X, 52 + i * LINE, TEXT, FONT)
    }
    Canvas.text(
      "Microban #{LEVELS[self.level].origin}",
      PANEL_X,
      140,
      DIM,
      FONT,
    )
    for i, line in HELP.enumerate() {
      Canvas.text(line, PANEL_X, 172 + i * LINE, DIM, FONT)
    }
    # Each button carries the key it stands for, which is the whole of the
    # keyboard help the panel would otherwise have to spell out.
    for i, b in BUTTONS.enumerate() {
      let (bx, by, bw, bh) = button_rect(i)
      Canvas.rect(bx, by, bw, bh, BTN)
      Canvas.rect(bx, by, bw, bh, BTN_EDGE, fill: false)
      Canvas.text(b.label, bx + 8, by + 6, TEXT, FONT)
      Canvas.text(b.key, bx + bw - 8 * FONT - 8, by + 6, DIM, FONT)
    }
    Canvas.text('Microban levels by David W. Skinner', 16, H - 22, DIM, FONT)
  }

  draw_banner() {
    let text = cond {
      self.mode == Mode.AskLevel => "level 1-{LEVELS.size()}: {self.entry}_",
      self.solved => "solved in {self.moves} moves",
      _ => '',
    }
    return if text.empty()
    let tw = Canvas.text_width(text, FONT)
    let (bx, by) = ((BOARD_W - tw) / 2 - 10, BOARD_H - 52)
    let (bw, bh) = (tw + 20, 8 * FONT + 12)
    Canvas.rect(bx, by, bw, bh, BG)
    Canvas.rect(bx, by, bw, bh, BANNER, fill: false)
    Canvas.text(text, bx + 10, by + 6, BANNER, FONT)
  }
}

start = !Sys.argv.empty() ? to_long(Sys.argv[0]) - 1 : 0
game = Game(Math.clamp(start, 0, LEVELS.size() - 1))
Canvas.title('Sokoban')
Canvas.run(W, H, game.tick, 8000)
println("solved {game.cleared} / {LEVELS.size()} in {game.total} moves") unless game.interactive
