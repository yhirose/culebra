HELP = ['arrows  walk / push', 'click   walk there', 'l       pick a level']

BUTTONS = [
  {label: 'undo', key: 'u'},
  {label: 'redo', key: 'r'},
  {label: 'prev', key: 'p'},
  {label: 'next', key: 'n'},
  {label: 'restart', key: 's'},
  {label: 'quit', key: 'q'},
]

STEPS = {u: (0, -1), d: (0, 1), l: (-1, 0), r: (1, 0)}

# A square is either part of the maze or beyond its outer wall. `Outside` is
# what the flood fill in `seal` finds, and it is drawn as background instead of
# floor. Levels may be ragged, so the distinction is not merely cosmetic.
enum Tile {
  Wall,
  Floor,
  Outside,
}

# One replayable step. Both variants carry the direction rather than the square
# it led to, which makes undo and redo the same arithmetic with opposite signs.
enum Step {
  Walk(Long, Long),
  Push(Long, Long),
}

enum Mode {
  Play,
  AskLevel,
}

# The same art read through a different palette is what makes the crate on a
# goal. `.` is index 0 wherever it appears and stays transparent, so the goal
# marker shows through under the player.
fn sprite(art, keys, colors) {
  let pixels = art.lines().join('').iter().map(|ch| keys.index_of(ch)).collect()
  Canvas.Sprite.new(pixels, ART, ART, colors)
}

# Nearest-neighbour, so the 16x16 drawing stays square-edged at ZOOM rather
# than being smoothed into it.
fn blit(tile, px, py) {
  tile.draw_scaled(px, py, TILE, TILE)
}

