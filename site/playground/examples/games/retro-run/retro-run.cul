# retro-run — a port of Jake Gordon's javascript-racer (MIT), v4.final.
#
# The pseudo-3D road, the projection, the road geometry, the AI and every
# constant come from the original; what changed is the art (generated, see
# assets/README.md), the day cycle (five scenes over one lap), the race around
# it (a count-in, two laps, a results screen — the original runs forever), and
# the shape of the hot loops. The interpreter charges a C++ stack unwind for
# `return`,
# `break` and `continue`, so the loops that run per car or per segment carry a
# `done` flag instead, and the drawing calls go straight to the `_Canvas.*`
# primitives rather than through the preamble wrappers.
#
# Controls: arrows or WASD, space to race again from the results screen. Run
# with --jit for the smoothest frame time.
# An optional first argument overrides the draw distance, e.g.
#   culebra --jit retro-run.cul 150
# Shortening it trims the far road/background/sprites and, since v4's own AI
# window is sized off the same constant, cars that far ahead stop steering
# around each other — the same coupling the original has. The fog table is a
# fraction of the window rather than an absolute distance (also v4's formula),
# so it very slightly shifts on segments that stay in view either way.

# --- configuration ---------------------------------------------------------
let W = 640
let H = 480
let FPS = 60
let STEP = 1.0 / FPS
# Arguments: `[--assets <dir>] [--cars <n>] [draw-distance]`. The directory is
# where the art is read from, so a copy of upstream's own can be played with
# where it lies; the number is how many segments are drawn ahead of the camera
# (v4's own tweak UI allows 100..500). Both defaults are v4's.
#
# The two knobs exist for a host that needs a smaller game instead of a
# JIT: the frame cost is dominated by how many segments the loops walk, and
# the catch-up below by how much one car step costs. The Playground (no JIT
# in a browser) has run both at these same defaults since the VM became the
# executor everywhere (Phase 4 B6c) — see playground/examples.json.
let ARGS_SPEC = {
  name: 'retro-run.cul',
  args: [
    {name: 'assets', type: 'String', default: nil, doc: 'asset directory'},
    {name: 'cars', type: 'Long', default: 200, doc: 'number of cars'},
    {
      name: 'distance',
      type: 'Long',
      positional: true,
      default: 300,
      doc: 'segments drawn ahead of the camera',
    },
  ],
}
let args = Args.parse(Sys.argv, ARGS_SPEC)
let DRAW_DISTANCE = args.distance
let LANES = 3
let SEGMENT_LENGTH = 200
let RUMBLE_LENGTH = 3  # segments per light/dark stripe
let ROAD_WIDTH = 2000  # half-width, so the road spans -RW..+RW
let CAMERA_HEIGHT = 1000
let FIELD_OF_VIEW = 100  # degrees
let FOG_DENSITY = 5
let CENTRIFUGAL = 0.3
let TOTAL_CARS = args.cars
let LOOKAHEAD = 20  # segments an AI car looks ahead to steer
# The original skips the AI for a car more than drawDistance segments *ahead*,
# a signed test that leaves every car behind the player scanning: update then
# climbs from 13 to 50 ms over one lap and resets. Both ends of a circular
# window keeps it flat.
let AI_LOOKBEHIND = 100
let SKY_SPEED = 0.001
let HILL_SPEED = 0.002
let TREE_SPEED = 0.003

let CAMERA_DEPTH = 1.0 / Math.tan((FIELD_OF_VIEW / 2.0) * Math.pi / 180.0)
let PLAYER_Z = CAMERA_HEIGHT * CAMERA_DEPTH
let MAX_SPEED = SEGMENT_LENGTH / STEP  # one segment per frame, at most
let ACCEL = MAX_SPEED / 5.0
let BREAKING = -MAX_SPEED
let DECEL = -MAX_SPEED / 5.0
let OFF_ROAD_DECEL = -MAX_SPEED / 2.0
let OFF_ROAD_LIMIT = MAX_SPEED / 4.0
let RESOLUTION = H / 480.0  # v4's resolution-independence factor

let W2 = W / 2.0
let H2 = H / 2.0
let NO_CLIP = 1e9
let SW_K = ROAD_WIDTH * W2  # projected road half-width per unit scale

# --- sprite atlas ----------------------------------------------------------
# Rectangles are verbatim from the upstream common.js: SPRITES.w is what
# collision measures and what sets the world scale, so they are a contract with
# the art, not a property of it (assets/README.md).
let SPRITE_SCALE = 0.3 / 80.0  # 0.3 / PLAYER_STRAIGHT.w

class Art {
  new(x, y, w, h) {
    self.x = x
    self.y = y
    self.w = w
    self.h = h
    self.sw = w * SPRITE_SCALE  # world width, pre-scaled
    self.sh = h * SPRITE_SCALE
  }
}

let PALM_TREE = Art(5, 5, 215, 540)
let BILLBOARD08 = Art(230, 5, 385, 265)
let TREE1 = Art(625, 5, 360, 360)
let DEAD_TREE1 = Art(5, 555, 135, 332)
let BILLBOARD09 = Art(150, 555, 328, 282)
let BOULDER3 = Art(230, 280, 320, 220)
let COLUMN = Art(995, 5, 200, 315)
let BILLBOARD01 = Art(625, 375, 300, 170)
let BILLBOARD06 = Art(488, 555, 298, 190)
let BILLBOARD05 = Art(5, 897, 298, 190)
let BILLBOARD07 = Art(313, 897, 298, 190)
let BOULDER2 = Art(621, 897, 298, 140)
let TREE2 = Art(1205, 5, 282, 295)
let BILLBOARD04 = Art(1205, 310, 268, 170)
let DEAD_TREE2 = Art(1205, 490, 150, 260)
let BOULDER1 = Art(1205, 760, 168, 248)
let BUSH1 = Art(5, 1097, 240, 155)
let CACTUS = Art(929, 897, 235, 118)
let BUSH2 = Art(255, 1097, 232, 152)
let BILLBOARD03 = Art(5, 1262, 230, 220)
let BILLBOARD02 = Art(245, 1262, 215, 220)
let STUMP = Art(995, 330, 195, 140)
let SEMI = Art(1365, 490, 122, 144)
let TRUCK = Art(1365, 644, 100, 78)
let CAR03 = Art(1383, 760, 88, 55)
let CAR02 = Art(1383, 825, 80, 59)
let CAR04 = Art(1383, 894, 80, 57)
let CAR01 = Art(1205, 1018, 80, 56)
let PLAYER_UPHILL_LEFT = Art(1383, 961, 80, 45)
let PLAYER_UPHILL_STRAIGHT = Art(1295, 1018, 80, 45)
let PLAYER_UPHILL_RIGHT = Art(1385, 1018, 80, 45)
let PLAYER_LEFT = Art(995, 480, 80, 41)
let PLAYER_STRAIGHT = Art(1085, 480, 80, 41)
let PLAYER_RIGHT = Art(995, 531, 80, 41)

let BILLBOARDS = [
  BILLBOARD01,
  BILLBOARD02,
  BILLBOARD03,
  BILLBOARD04,
  BILLBOARD05,
  BILLBOARD06,
  BILLBOARD07,
  BILLBOARD08,
  BILLBOARD09,
]
let PLANTS = [
  TREE1,
  TREE2,
  DEAD_TREE1,
  DEAD_TREE2,
  PALM_TREE,
  BUSH1,
  BUSH2,
  CACTUS,
  STUMP,
  BOULDER1,
  BOULDER2,
  BOULDER3,
]
let CARS = [CAR01, CAR02, CAR03, CAR04, SEMI, TRUCK]

let PLAYER_W = PLAYER_STRAIGHT.sw

# The three background layers, each 1280x480 inside the sheet.
let BG_HILLS = Art(5, 5, 1280, 480)
let BG_SKY = Art(5, 495, 1280, 480)
let BG_TREES = Art(5, 985, 1280, 480)

# --- assets ----------------------------------------------------------------
# `--assets <dir>` points at art held elsewhere — upstream's own, say; without
# it the generated stand-ins in assets/ are used, through a handle that reads
# them wherever this is running: the directory next to the source natively and
# in the Playground, and the copy `culebra build` bakes into the binary — which
# is why the executable needs no files beside it.
let ART_DIR = args.assets
let ART = ART_DIR != nil
  ? {
    exists: |n| FS.exists(ART_DIR + "/" + n),
    read: |n| FS.read(ART_DIR + "/" + n),
  }
  : Embed.dir("assets")
let SCENES = ["asayake", "hiru", "yuugata", "yuugure", "twilight"]
let SCENE_COUNT = SCENES.size()

# A missing file is what a mistyped `--assets` looks like, so say which one.
let art = fn (name) {
  if !ART.exists(name) {
    println("retro-run: {ART_DIR ?? "the built-in art"} has no {name}")
    Sys.exit(2)
  }
  ART.read(name)
}

let sheet = Canvas.Sprite.from_png(art("sprites.png"))
let SHEET = sheet._id

# Upstream ships one background; the generated set has one per scene. Loading
# the same file four times would cost 7.5 MB apiece, so a repeat is aliased —
# get_or_put only calls the loader on a name it has not seen. The handles
# themselves are what keep the pixels alive (a sprite frees them with its last
# reference), so they are held for the whole run and the ids taken from them.
let background_sprites = fn () {
  mut loaded = {}
  SCENES.map(|scene| {
    let scened = "background_" + scene + ".png"
    let name = ART.exists(scened) ? scened : "background.png"
    loaded.get_or_put(name, || Canvas.Sprite.from_png(art(name)))
  })
}()
let backgrounds = background_sprites.map(|s| s._id)

# --- colours ---------------------------------------------------------------
# One palette per scene, in the order SCENES lists them, as flat r,g,b triples:
# grass dark, grass light, road dark, road light, rumble dark, rumble light,
# fog, sky. These are the values tools/gen_assets.cul bakes the matching
# background with, so the road meets the horizon in the colour the picture
# ends in.
let SCENE_COLORS = [
  # asayake
  [100, 140, 68, 116, 156, 76, 104, 96, 120, 114, 106, 130,
   188, 100, 92, 240, 224, 208, 248, 204, 148, 72, 64, 160],
  # hiru
  [40, 144, 48, 56, 168, 56, 96, 96, 108, 106, 106, 118,
   192, 88, 80, 232, 228, 220, 212, 236, 252, 40, 104, 232],
  # yuugata
  [96, 136, 52, 112, 152, 60, 100, 94, 106, 110, 104, 116,
   188, 92, 80, 240, 224, 200, 248, 220, 160, 168, 120, 184],
  # yuugure
  [128, 120, 48, 144, 136, 56, 104, 88, 104, 114, 98, 114,
   184, 92, 76, 240, 216, 184, 248, 196, 108, 200, 72, 48],
  # twilight
  [48, 88, 80, 56, 100, 88, 64, 56, 88, 74, 66, 98,
   136, 72, 92, 200, 172, 192, 180, 124, 176, 24, 24, 88],
]
# How much of a scene's stretch of road holds still before the cross-fade into
# the next one starts.
let SCENE_HOLD = 3.0 / 7.0
# A lane dash gets its dimmer rim round a bright core only on a band whose
# road is this many pixels half-wide or more; nearer the horizon the dash is
# a pixel or two across and the rim would not show. The curb's face and the
# edge lines go on every band, thinning out with the road.
let DETAIL_W = 60.0
let LANE_R = 252
let LANE_G = 248
let LANE_B = 242
let OPAQUE = 255 * 16777216

# Segment kinds: 0/1, alternating every RUMBLE_LENGTH.
let KIND_DARK = 0
let KIND_LIGHT = 1

# Road markings, painted over a segment's road surface and nothing else. v4
# gives the start and finish their own colour *kinds*, which replace the road,
# the grass and the rumble alike — so the goal arrives as a white or black band
# spanning the whole frame rather than a line across the track. Here they are
# markings on the tarmac: the scenery beside them keeps the stripe colours it
# would have had, and the start and finish get a checkered flag instead of
# flat white and black.
let MARK_NONE = 0
let MARK_START = 1
let MARK_FINISH = 2
# Squares across the road on a finish segment: 20 across the 4000-wide road
# are as wide as a segment is deep, so the check is square on the ground.
let CHECKER_COLS = 20

# --- Util (common.js) ------------------------------------------------------
let limit = fn (v, lo, hi) {
  cond {
    v < lo => lo,
    v > hi => hi,
    _ => v,
  }
}
let ease_in = fn (a, b, percent) {
  a + (b - a) * percent * percent
}
let ease_in_out = fn (a, b, percent) {
  a + (b - a) * (-Math.cos(percent * Math.pi) / 2.0 + 0.5)
}
let percent_remaining = fn (n, total) {
  (n % total) / total
}
let exponential_fog = fn (distance, density) {
  1.0 / Math.exp(distance * distance * density)
}

let increase = fn (start, increment, max) {
  mut result = start + increment
  while result >= max {
    result -= max
  }
  while result < 0 {
    result += max
  }
  result
}

# `percent` is how much of each width counts as a hit: 0.8 for the player
# against a car, 1.2 for the AI steering around one.
let overlap = fn (x1, w1, x2, w2, percent) {
  let half = percent / 2.0
  !(x1 + w1 * half < x2 - w2 * half || x1 - w1 * half > x2 + w2 * half)
}

# --- world -----------------------------------------------------------------
# p1/p2 are flat fields rather than nested objects: the projection loop writes
# ten of them per segment per frame.
class Segment {
  new(index, y1, y2, curve) {
    self.index = index
    self.p1_wy = y1
    self.p1_wz = index * SEGMENT_LENGTH * 1.0
    self.p2_wy = y2
    self.p2_wz = (index + 1) * SEGMENT_LENGTH * 1.0
    self.curve = curve
    self.p1_sx = 0.0
    self.p1_sy = 0.0
    self.p1_sw = 0.0
    self.p1_scale = 0.0
    self.p2_sx = 0.0
    self.p2_sy = 0.0
    self.p2_sw = 0.0
    self.p2_scale = 0.0
    self.clip = 0.0
    self.vis = false  # projected this frame (i.e. in front of us)
    self.kind = (index / RUMBLE_LENGTH) % 2 == 0 ? KIND_LIGHT : KIND_DARK
    self.mark = MARK_NONE
    self.sprites = []
    self.cars = []
  }
}

class Prop {
  new(art, offset) {
    self.art = art
    self.offset = offset
  }
}

# A car's position is (segment index, distance into that segment) rather than a
# track-absolute z: at most one segment passes per frame, so advancing it is an
# add and a carry, and the two find_segment calls the original does per car per
# frame disappear.
class Car {
  new(art, offset, seg, zin, speed) {
    self.art = art
    self.offset = offset
    self.seg = seg
    self.zin = zin
    self.speed = speed
    self.percent = 0.0
    self.w = art.sw  # the AI compares widths every lookahead step
    self.z = seg * SEGMENT_LENGTH * 1.0 + zin
  }
}

mut segments = []
mut cars = []
mut track_length = 0.0

let last_y = fn () {
  segments.empty() ? 0.0 : segments[segments.size() - 1].p2_wy
}

let add_segment = fn (curve, y) {
  segments.push(Segment(segments.size(), last_y(), y, curve))
}

let add_road = fn (enter, hold, leave, curve, y) {
  let start_y = last_y()
  let end_y = start_y + y * SEGMENT_LENGTH * 1.0
  let total = (enter + hold + leave) * 1.0
  for n in 0..enter {
    add_segment(
      ease_in(0.0, curve, n / (enter * 1.0)),
      ease_in_out(start_y, end_y, n / total),
    )
  }
  for n in 0..hold {
    add_segment(curve, ease_in_out(start_y, end_y, (enter + n) / total))
  }
  for n in 0..leave {
    add_segment(
      ease_in_out(curve, 0.0, n / (leave * 1.0)),
      ease_in_out(start_y, end_y, (enter + hold + n) / total),
    )
  }
}

let L_SHORT = 25
let L_MEDIUM = 50
let L_LONG = 100
let H_LOW = 20.0
let H_MEDIUM = 40.0
let H_HIGH = 60.0
let C_EASY = 2.0
let C_MEDIUM = 4.0

let add_straight = fn (num) {
  add_road(num, num, num, 0.0, 0.0)
}
let add_hill = fn (num, height) {
  add_road(num, num, num, 0.0, height)
}
let add_curve = fn (num, curve, height) {
  add_road(num, num, num, curve, height)
}

let add_low_rolling_hills = fn (num, height) {
  add_road(num, num, num, 0.0, height / 2.0)
  add_road(num, num, num, 0.0, -height)
  add_road(num, num, num, C_EASY, height)
  add_road(num, num, num, 0.0, 0.0)
  add_road(num, num, num, -C_EASY, height / 2.0)
  add_road(num, num, num, 0.0, 0.0)
}

let add_s_curves = fn () {
  add_road(L_MEDIUM, L_MEDIUM, L_MEDIUM, -C_EASY, 0.0)
  add_road(L_MEDIUM, L_MEDIUM, L_MEDIUM, C_MEDIUM, H_MEDIUM)
  add_road(L_MEDIUM, L_MEDIUM, L_MEDIUM, C_EASY, -H_LOW)
  add_road(L_MEDIUM, L_MEDIUM, L_MEDIUM, -C_EASY, H_MEDIUM)
  add_road(L_MEDIUM, L_MEDIUM, L_MEDIUM, -C_MEDIUM, -H_MEDIUM)
}

let add_bumps = fn () {
  add_road(10, 10, 10, 0.0, 5.0)
  add_road(10, 10, 10, 0.0, -2.0)
  add_road(10, 10, 10, 0.0, -5.0)
  add_road(10, 10, 10, 0.0, 8.0)
  add_road(10, 10, 10, 0.0, 5.0)
  add_road(10, 10, 10, 0.0, -7.0)
  add_road(10, 10, 10, 0.0, 5.0)
  add_road(10, 10, 10, 0.0, -2.0)
}

let add_downhill_to_end = fn (num) {
  add_road(num, num, num, -C_EASY, -last_y() / SEGMENT_LENGTH)
}

let find_segment = fn (z) {
  segments[Math.floor(z / SEGMENT_LENGTH) % segments.size()]
}

let add_prop = fn (n, art, offset) {
  segments[n].sprites.push(Prop(art, offset))
}

let reset_props = fn () {
  add_prop(20, BILLBOARD07, -1.0)
  add_prop(40, BILLBOARD06, -1.0)
  add_prop(60, BILLBOARD08, -1.0)
  add_prop(80, BILLBOARD09, -1.0)
  add_prop(100, BILLBOARD01, -1.0)
  add_prop(120, BILLBOARD02, -1.0)
  add_prop(140, BILLBOARD03, -1.0)
  add_prop(160, BILLBOARD04, -1.0)
  add_prop(180, BILLBOARD05, -1.0)

  add_prop(240, BILLBOARD07, -1.2)
  add_prop(240, BILLBOARD06, 1.2)
  add_prop(segments.size() - 25, BILLBOARD07, -1.2)
  add_prop(segments.size() - 25, BILLBOARD06, 1.2)

  # Two rows of palms, the near one just past the rumble (w/6 outside the road)
  # so no trunk stands on the tarmac or the kerb.
  mut n = 10
  while n < 200 {
    add_prop(n, PALM_TREE, 1.2 + Random.uniform(0.0, 0.5))
    add_prop(n, PALM_TREE, 1.7 + Random.uniform(0.0, 2.0))
    n += 4 + n / 100
  }

  for n in 250..1000 by 5 {
    add_prop(n, COLUMN, 1.1)
    add_prop(n + Random.int(0, 6), TREE1, -1.0 - Random.uniform(0.0, 2.0))
    add_prop(n + Random.int(0, 6), TREE2, -1.0 - Random.uniform(0.0, 2.0))
  }

  for n in 200..segments.size() by 3 {
    let side = Random.int(0, 2) == 0 ? 1.0 : -1.0
    add_prop(
      n,
      PLANTS[Random.int(0, PLANTS.size())],
      side * (2.0 + Random.uniform(0.0, 5.0)),
    )
  }

  for n in 1000..segments.size() - 50 by 100 {
    let side = Random.int(0, 2) == 0 ? 1.0 : -1.0
    add_prop(
      n + Random.int(0, 51),
      BILLBOARDS[Random.int(0, BILLBOARDS.size())],
      -side,
    )
    for _ in 0..20 {
      add_prop(
        n + Random.int(0, 51),
        PLANTS[Random.int(0, PLANTS.size())],
        side * (1.5 + Random.uniform(0.0, 1.0)),
      )
    }
  }
}

# The stretch at the line the traffic is kept off. The camera starts at
# segment 0 with the car PLAYER_Z ahead of it, so a car scattered into the
# first few segments is drawn between the two — on top of the player.
let START_CLEAR = 30

let reset_cars = fn () {
  cars = []
  for _ in 0..TOTAL_CARS {
    let side = Random.int(0, 2) == 0 ? -0.8 : 0.8
    let art = CARS[Random.int(0, CARS.size())]
    # The semi is slower, so it needs a narrower spread to stay behind traffic.
    let spread = art == SEMI ? 4.0 : 2.0
    let seg = Random.int(START_CLEAR, segments.size())
    let car = Car(
      art,
      Random.uniform(0.0, 1.0) * side,
      seg,
      0.0,
      MAX_SPEED / 4.0 + Random.uniform(0.0, MAX_SPEED / spread),
    )
    segments[seg].cars.push(car)
    cars.push(car)
  }
}

let reset_road = fn () {
  segments = []
  add_straight(L_SHORT)
  add_low_rolling_hills(L_SHORT, H_LOW)
  add_s_curves()
  add_curve(L_MEDIUM, C_MEDIUM, H_LOW)
  add_bumps()
  add_low_rolling_hills(L_SHORT, H_LOW)
  add_curve(L_LONG * 2, C_MEDIUM, H_MEDIUM)
  add_straight(L_MEDIUM)
  add_hill(L_MEDIUM, H_HIGH)
  add_s_curves()
  add_curve(L_LONG, -C_MEDIUM, 0.0)
  add_hill(L_LONG, H_HIGH)
  add_curve(L_LONG, C_MEDIUM, -H_LOW)
  add_bumps()
  add_hill(L_LONG, -H_MEDIUM)
  add_straight(L_MEDIUM)
  add_s_curves()
  add_downhill_to_end(200)

  reset_props()
  reset_cars()

  segments[find_segment(PLAYER_Z).index + 2].mark = MARK_START
  segments[find_segment(PLAYER_Z).index + 3].mark = MARK_START
  for n in 0..RUMBLE_LENGTH {
    segments[segments.size() - 1 - n].mark = MARK_FINISH
  }
  track_length = segments.size() * SEGMENT_LENGTH * 1.0
}

# --- game state ------------------------------------------------------------
mut position = 0.0
mut speed = 0.0
mut player_x = 0.0
mut sky_offset = 0.0
mut hill_offset = 0.0
mut tree_offset = 0.0
mut key_left = false
mut key_right = false
mut key_faster = false
mut key_slower = false
# How hard the car is steered, -1 (full left) to 1, and which way its picture
# turns: the keys give full lock or none, the autopilot anything between.
mut steer = 0.0
mut lean = 0.0
mut current_lap_time = 0.0
mut last_lap_time = 0.0
mut fast_lap_time = 180.0  # v4's starting target, session-lived

# Seconds to the drop, counting down from COUNT_IN; it keeps falling past zero
# so GO! can hold for a beat, and the physics wait for it to reach zero.
let COUNT_IN = 3.0
let GO_HOLD = 0.9
let GO_BEEP = 20  # frames the GO beep lasts
mut count_in = COUNT_IN
mut counted = 4  # the last number that has had its beep

# The race is two laps — the original runs forever, but a lap is a couple of
# minutes, so a flag has to fall somewhere.
let TOTAL_LAPS = 2
mut lap = 1
mut total_time = 0.0
mut finished = false

# --- BGM ---------------------------------------------------------------
# A music.ogg / music.mp3 next to the art (upstream's own soundtrack, say)
# loops under the run instead of the chiptune; the generated assets ship no
# music, so the riff below is the default. It sits under the engine and the
# chiptune's own level, loud enough to carry on laptop speakers.
let MUSIC_FILE = ["music.ogg", "music.mp3"].find(|n| ART.exists(n))
let MUSIC_VOL = 60
# Whichever it is starts a second after the GO beep has sounded, not during
# the count-in.
let MUSIC_DELAY = GO_BEEP + FPS  # frames from the green light to the music
mut music_on = false
mut music_wait = MUSIC_DELAY

# The chiptune fallback: a tune per lap, sequenced from `update()` so the
# rhythm is exact regardless of display framerate. `tone()` is fire-and-forget
# (the APU keeps playing the note on its own), so the sequencer only asks
# "does a note start on this sixteenth". Every channel is monophonic, so each
# has one part: the lead on the pulse, a second pulse that echoes or
# harmonises it, the bass on the sawtooth, the chords broken up on the
# triangle, the drums on the noise.
let BAR = 16  # sixteenths per bar
let ECHO = 3  # sixteenths the echo trails the lead by

# Pitches are MIDI numbers, converted once at load.
let hz = fn (n) {
  Math.round(440 * Math.exp((n - 69) / 12.0 * Math.log(2.0)))
}
let HZ = iota(128).map(hz)

let PITCH_CLASS = {C: 0, D: 2, E: 4, F: 5, G: 7, A: 9, B: 11}

# The letter and accidental at the head of `s` ("F#m7", "Bb5") as a pitch
# class, and the rest of the string.
let split_root = fn (s) {
  let letter = s.slice(0, 1).to_string()
  if !PITCH_CLASS.has(letter) {
    throw {kind: "ValueError", message: "not a note: {s}"}
  }
  let accidental = s.size() > 1 ? s.slice(1, 2).to_string() : ""
  let shift = cond {
    accidental == "#" => 1,
    accidental == "b" => -1,
    _ => 0,
  }
  let head = shift == 0 ? 1 : 2
  (
    Math.wrap(PITCH_CLASS[letter] + shift, 12),
    s.slice(head, s.size()).to_string(),
  )
}

# A lead token: a note name starts a note ("A5" is 81), `-` holds the one
# before it (-1), `.` rests (0).
let note_number = fn (tok) {
  return -1 if tok == "-"
  return 0 if tok == "."
  let (pc, octave) = split_root(tok)
  (to_long(octave) + 1) * 12 + pc
}

# The intervals of a chord quality, always four, so an arpeggio has four
# tones to walk.
let chord_shape = fn (quality) {
  match quality {
    "" => [0, 4, 7, 12],
    "m" => [0, 3, 7, 12],
    "6" => [0, 4, 7, 9],
    "m6" => [0, 3, 7, 9],
    "7" => [0, 4, 7, 10],
    "maj7" => [0, 4, 7, 11],
    "m7" => [0, 3, 7, 10],
    "m7b5" => [0, 3, 6, 10],
    "sus4" => [0, 5, 7, 12],
    "7sus4" => [0, 5, 7, 10],
    "add9" => [0, 4, 7, 14],
    "9" => [0, 4, 7, 10, 14],
    "maj9" => [0, 4, 7, 11, 14],
    "m9" => [0, 3, 7, 10, 14],
    _ => nil,
  }
}

# A chord symbol ("F#m/A") as (bass, tones): the bass in E2..D#3, so a line
# that walks down the roots walks down, and the tones from middle C up.
let chord = fn (name) {
  let (symbol, over) = name.split_once("/") ?? (name, nil)
  let (pc, quality) = split_root(symbol.to_string())
  let shape = chord_shape(quality)
  if shape == nil {
    throw {kind: "ValueError", message: "unknown chord: {name}"}
  }
  mut bass_pc = pc
  if over != nil {
    let (over_pc, _) = split_root(over.to_string())
    bass_pc = over_pc
  }
  (40 + Math.wrap(bass_pc - 4, 12), shape.map(|i| 60 + pc + i))
}

# The whitespace-separated tokens of a pattern, which must number `n`.
let tokens = fn (text, n) {
  let out = text.split_whitespace().map(|tok| tok.to_string())
  if out.size() != n {
    throw {
      kind: "ValueError",
      message: "want {n} tokens, got {out.size()}: {text}",
    }
  }
  out
}

# A note table becomes (pitch, length in sixteenths) at each onset.
let onsets = fn (table) {
  mut out = repeat(table.size(), nil)
  for i, n in table.enumerate() {
    continue if n <= 0
    mut len = 1
    while i + len < table.size() && table[i + len] == -1 {
      len += 1
    }
    out[i] = (n, len)
  }
  out
}

# The highest of `tones`, in any octave, at least a minor third under `m`.
let below = fn (tones, m) {
  tones.map(|tone| m - 3 - Math.wrap(m - 3 - tone, 12)).max()
}

# A tune from its score, expanded to what starts on each sixteenth.
#
# `chords` has a bar per entry: one chord symbol, or two split at the half
# bar. `lead` has a bar per entry of sixteen tokens (a note name starts a
# note, `-` holds it, `.` rests). `form` names the groove each bar plays, and
# a groove is the bass as intervals over the root per sixteenth (`.` rests,
# `>` steps up a semitone into the next bar's root; each note lasts until the
# next unless `bass_len` says otherwise), the arpeggio as chord tones by
# index per eighth, the drums as a letter of `kit` per sixteenth, and what
# the second pulse plays: `echo` (the lead, ECHO sixteenths late and softer)
# or `harmony` (the chord tone under each lead note).
let tune = fn (score) {
  let bars = score.chords.size()
  let steps = bars * BAR
  if score.lead.size() != bars || score.form.size() != bars {
    throw {
      kind: "ValueError",
      message: "{bars} bars of chords, {score.lead.size()} of lead, {score.form.size()} of form",
    }
  }
  let changes = score.chords.map(fn (text) {
    text.split_whitespace().map(|name| chord(name.to_string()))
  })
  let lead = onsets(score.lead.flat_map(fn (text) {
    tokens(text, BAR).map(note_number)
  }))
  mut grooves = {}
  for name, g in score.grooves {
    let hits = g.drums.iter().map(|ch| ch.to_string()).collect()
    if hits.size() != BAR || hits.any(|ch| ch != "." && !score.kit.has(ch)) {
      throw {kind: "ValueError", message: "bad drums in {name}: {g.drums}"}
    }
    grooves[name] = {
      bass: tokens(g.bass, BAR),
      bass_len: g.get("bass_len", nil),
      arp: tokens(g.arp, BAR / 2),
      drums: hits,
      second: g.get("second", nil),
    }
  }
  if !score.form.all(|name| grooves.has(name)) {
    throw {kind: "ValueError", message: "form names a groove the score lacks"}
  }

  let arp_shift = score.get("arp_shift", 0)
  mut bass = repeat(steps, nil)
  mut arp = repeat(steps, nil)
  mut drums = repeat(steps, nil)
  mut second = repeat(steps, nil)
  for step in 0..steps {
    let bar = step / BAR
    let slot = step % BAR
    let g = grooves[score.form[bar]]
    let here = changes[bar]
    let (root, tones) = here[here.size() == 2 && slot >= BAR / 2 ? 1 : 0]

    let bass_hit = g.bass[slot]
    if bass_hit != "." {
      let (next_root, _) = changes[(bar + 1) % bars][0]
      mut run = 1
      while slot + run < BAR && g.bass[slot + run] == "." {
        run += 1
      }
      bass[step] = (
        bass_hit == ">" ? next_root - 1 : root + to_long(bass_hit),
        g.bass_len ?? run,
      )
    }
    let pick = g.arp[slot / 2]
    arp[step] = tones[to_long(pick)] + arp_shift if slot % 2 == 0 && pick != "."
    drums[step] = g.drums[slot] if g.drums[slot] != "."

    let echoed = lead[Math.wrap(step - ECHO, steps)]
    if g.second == "echo" && echoed != nil {
      let (echo_pitch, echo_len) = echoed
      second[step] = (echo_pitch, echo_len, 0.7)
    } else if g.second == "harmony" && lead[step] != nil {
      let (sung, sung_len) = lead[step]
      second[step] = (below(tones, sung), sung_len, 1.0)
    }
  }
  {
    tick: score.tick,
    length: score.tick * steps,
    voices: score.voices,
    kit: score.kit,
    lead: lead,
    second: second,
    bass: bass,
    arp: arp,
    drums: drums,
  }
}

# An instrument: the channel, its sustain level and envelope in frames.
let voice = fn (wave, vol, attack, decay, release, duty = Canvas.DUTY_HALF) {
  {
    wave: wave,
    vol: vol,
    attack: attack,
    decay: decay,
    release: release,
    duty: duty,
  }
}

let sound = fn (v, pitch, frames, gain) {
  Canvas.tone(
    HZ[pitch],
    frames,
    vol: Math.round(v.vol * gain),
    wave: v.wave,
    attack: v.attack,
    decay: v.decay,
    release: v.release,
    duty: v.duty,
  )
}

# One hit of a kit's drum on the noise channel.
let drum = fn (d, gain) {
  Canvas.tone(
    d.freq,
    d.dur,
    vol: Math.round(d.vol * gain),
    wave: Canvas.NOISE,
    end_freq: d.end_freq ?? d.freq,
    decay: d.decay ?? 0,
    release: d.release ?? 0,
  )
}

# Start whatever begins on sixteenth `step` of tune `t`, at `gain`.
let play_step = fn (t, step, gain) {
  let v = t.voices
  let lead = t.lead[step]
  if lead != nil {
    let (lead_pitch, lead_len) = lead
    sound(v.lead, lead_pitch, lead_len * t.tick - 2, gain)
  }
  let second = t.second[step]
  if second != nil {
    let (second_pitch, second_len, level) = second
    sound(v.second, second_pitch, second_len * t.tick - 2, gain * level)
  }
  let bass = t.bass[step]
  if bass != nil {
    let (bass_pitch, bass_len) = bass
    sound(v.bass, bass_pitch, bass_len * t.tick - 3, gain)
  }
  let key = t.arp[step]
  sound(v.arp, key, t.tick * 2 - 4, gain) if key != nil
  let hit = t.drums[step]
  drum(t.kit[hit], gain) if hit != nil
}

# The race's band: a nasal lead, a thin second pulse under it, a sawtooth
# bass, soft triangle arpeggios. The kit: kick, snare, closed and open hat,
# crash, high and low tom.
let RUN_VOICES = {
  lead: voice(Canvas.PULSE, 15, 1, 2, 4, Canvas.DUTY_QUARTER),
  second: voice(Canvas.PULSE2, 9, 1, 2, 6, Canvas.DUTY_EIGHTH),
  bass: voice(Canvas.SAWTOOTH, 18, 0, 3, 3),
  arp: voice(Canvas.TRIANGLE, 7, 1, 4, 6),
}
let RUN_KIT = {
  k: {freq: 120, dur: 1, vol: 20, decay: 3, release: 2},
  s: {freq: 800, dur: 3, vol: 13, decay: 2, release: 2},
  h: {freq: 3000, dur: 1, vol: 5, release: 1},
  o: {freq: 3000, dur: 3, vol: 6, release: 3},
  c: {freq: 5000, dur: 4, vol: 11, release: 30},
  t: {freq: 900, end_freq: 500, dur: 3, vol: 12, release: 4},
  T: {freq: 500, end_freq: 250, dur: 3, vol: 13, release: 5},
}

# Lap one cruises, ~129 bpm in C: four bars over IV-V-iii-vi on a straight
# beat, a figure that springs off two sixteenths and is answered higher, then
# a long note and a turnaround; a
# verse whose phrases answer each other, sixteenth pickups against held notes,
# over a city-pop turn (a borrowed Fm6 for a moment of shade); a pre-chorus
# that climbs over falling chords; and a hook over the royal road that states
# its figure, answers it and builds to a high G, played twice: echoed, then in
# harmony with a second ending that reaches the high G again before falling
# back to the top of the tune.
let CRUISE_HOOK = [
  "C6 - - A5  - - C6 -  E6 - - -  D6 - C6 -",
  "D6 - - -  - - B5 -  - - G5 -  A5 - B5 -",
  "B5 - - G5  - - B5 -  D6 - - -  E6 - D6 -",
  "C6 - - -  - - - -  . . E6 -  D6 - C6 -",
  "A5 - - F5  - - A5 -  C6 - - -  E6 - F6 -",
  "G6 - - -  F6 - D6 -  B5 - - -  D6 - F6 -",
  "E6 - - -  - - - -  D6 - B5 -  G5 - A5 -",
  "- - - -  . . Bb5 -  A5 - G5 -  E5 - G5 -",
]
let CRUISE = tune({
  tick: 7,
  voices: RUN_VOICES,
  kit: RUN_KIT,
  chords: [
    "Fmaj7",
    "G6",
    "Em7",
    "Am7",
    "Cmaj7",
    "Bm7b5 E7",
    "Am7",
    "Gm7 C7",
    "Fmaj7",
    "Fm6",
    "Em7 A7",
    "Dm7 G7",
    "Fmaj7",
    "Em7",
    "Dm7",
    "G7sus4 G7",
    "Fmaj7",
    "G7",
    "Em7",
    "Am7",
    "Dm7",
    "G7",
    "Cmaj7",
    "Gm7 C7",
    "Fmaj7",
    "G7",
    "Em7",
    "Am7",
    "Dm7",
    "G7",
    "Cmaj7",
    "Gm7 C7",
  ],
  lead: [
    ". . A5 C6  E6 - - D6  - - C6 -  A5 - - -",
    ". . B5 D6  G6 - - E6  - - D6 -  B5 - D6 -",
    "E6 - - -  - - - -  D6 - B5 -  G5 - A5 -",
    "B5 - - C6  - - - -  E6 - D6 -  C6 - B5 -",
    ". . . .  . . E5 G5  B5 - - A5  - - G5 -",
    "- - - -  F5 - E5 -  D5 - - -  G#5 - B5 -",
    "C6 - - -  - - B5 -  A5 - - -  E5 - G5 -",
    "- - F5 -  Bb5 - - A5  - - G5 -  E5 - - -",
    "F5 - - -  . . A5 C6  E6 - - D6  - - C6 -",
    "- - - -  . . Ab5 -  G5 - F5 -  D5 - F5 -",
    "E5 - - -  G5 - B5 -  C#6 - - E6  - - D6 -",
    "- - - -  C6 - A5 -  B5 - - -  G5 - F5 -",
    "E5 - F5 -  A5 - C6 -  - - E6 -  C6 - A5 -",
    "B5 - - -  G5 - B5 -  - - D6 -  B5 - G5 -",
    "A5 - C6 -  D6 - F6 -  - - E6 -  D6 - C6 -",
    "D6 - - -  - - C6 -  B5 - - -  . G5 A5 B5",
    ...CRUISE_HOOK,
    ...CRUISE_HOOK.slice(0, 6),
    "E6 - - -  - - - -  G6 - E6 -  D6 - C6 -",
    "- - - -  . . D6 -  C6 - Bb5 -  G5 - E5 -",
  ],
  grooves: {
    intro: {
      bass: "0 . . 0  12 . 0 .  0 . . 0  12 . > .",
      bass_len: 2,
      arp: "0 1 2 3 2 3 1 2",
      drums: "k.h.s.h.k.hks.h.",
      second: "harmony",
    },
    intro_turn: {
      bass: "0 . . 0  12 . 0 .  0 . . 0  12 . > .",
      bass_len: 2,
      arp: "0 1 2 3 2 3 1 2",
      drums: "k.h.s.h.k.hsstTT",
      second: "harmony",
    },
    verse: {
      bass: "0 . . 0  12 . 0 .  . 12 . 0  7 . > .",
      bass_len: 2,
      arp: "0 1 2 3 2 3 1 2",
      drums: "k.h.s.hkk.h.s.o.",
    },
    climb: {
      bass: "0 . 0 .  0 . 0 .  0 . 0 .  0 . > .",
      bass_len: 2,
      arp: "0 1 2 3 0 1 2 3",
      drums: "k.hhs.hhk.hhs.hh",
      second: "echo",
    },
    fill: {
      bass: "0 . 0 .  0 . 0 .  0 . 0 .  0 . > .",
      bass_len: 2,
      arp: "0 1 2 3 0 1 2 3",
      drums: "k.s.s.ssttttTTTT",
      second: "echo",
    },
    hook_in: {
      bass: "0 . 12 .  0 12 . 0  . 12 0 .  7 . > .",
      bass_len: 2,
      arp: "3 2 1 0 1 2 3 2",
      drums: "c.h.s.hkk.h.s.ho",
      second: "echo",
    },
    hook: {
      bass: "0 . 12 .  0 12 . 0  . 12 0 .  7 . > .",
      bass_len: 2,
      arp: "3 2 1 0 1 2 3 2",
      drums: "k.h.s.hkk.h.s.ho",
      second: "echo",
    },
    hook_turn: {
      bass: "0 . 12 .  0 12 . 0  . 12 0 .  7 . > .",
      bass_len: 2,
      arp: "3 2 1 0 1 2 3 2",
      drums: "k.h.s.hkk.hsssTT",
      second: "echo",
    },
    twin_in: {
      bass: "0 . 12 .  0 12 . 0  . 12 0 .  7 . > .",
      bass_len: 2,
      arp: "3 2 1 0 1 2 3 2",
      drums: "c.h.s.hkk.h.s.ho",
      second: "harmony",
    },
    twin: {
      bass: "0 . 12 .  0 12 . 0  . 12 0 .  7 . > .",
      bass_len: 2,
      arp: "3 2 1 0 1 2 3 2",
      drums: "k.h.s.hkk.h.s.ho",
      second: "harmony",
    },
    twin_turn: {
      bass: "0 . 12 .  0 12 . 0  . 12 0 .  7 . > .",
      bass_len: 2,
      arp: "3 2 1 0 1 2 3 2",
      drums: "k.h.s.hkk.hsssTT",
      second: "harmony",
    },
  },
  form: [
    ...repeat(3, "intro"),
    "intro_turn",
    ...repeat(8, "verse"),
    ...repeat(3, "climb"),
    "fill",
    "hook_in",
    ...repeat(6, "hook"),
    "hook_turn",
    "twin_in",
    ...repeat(6, "twin"),
    "twin_turn",
  ],
})

# Lap two sprints for the flag, 150 bpm in D, after the Japanese fusion bands
# of the 80s: a twin-lead riff of 3-3-2 hits that climbs out of each one,
# over Dmaj7, C/D and Bbmaj7; a verse phrased
# like a saxophone, leaning on ninths, a Lydian sharp four and a flat seven
# over ii-iii-IV-V and a bVII9; a pre-chorus climbing sus chords a step at a
# time; and a chorus that holds major sevenths while the chords slide down a
# semitone (IV-iii-bIII), echoed in D, then in harmony a step up in E before
# bVI-bVII drops it back into the riff. Sixteenth hats and a bass bouncing on
# the octave keep it running.
let SPRINT = tune({
  tick: 6,
  voices: RUN_VOICES,
  kit: RUN_KIT,
  chords: [
    "Dmaj7",
    "C/D",
    "Bbmaj7",
