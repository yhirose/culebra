    "G/A",
    "A/B",
    "Bb/C",
    "C/D D7",
    "Gmaj7",
    "F#m7",
    "Fmaj7",
    "Em7 A7",
    "Bm7",
    "E9",
    "Gmaj7/A",
    "Cmaj7 D/E",
    "Amaj7",
    "G#m7",
