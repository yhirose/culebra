      bass_len: 1,
      arp: "3 2 1 0 3 2 1 0",
      drums: "chhhshhkkhhhshoh",
      second: "echo",
    },
    chorus: {
      bass: "0 . 12 0  . 12 0 .  0 12 . 0  12 . > 12",
      bass_len: 1,
      arp: "3 2 1 0 3 2 1 0",
      drums: "khohshokkhohshoh",
      second: "echo",
    },
    chorus_turn: {
      bass: "0 . 12 0  . 12 0 .  0 12 . 0  12 . > 12",
      bass_len: 1,
      arp: "3 2 1 0 3 2 1 0",
      drums: "khohshokkhssttTT",
      second: "echo",
    },
    twin_in: {
      bass: "0 . 12 0  . 12 0 .  0 12 . 0  12 . > 12",
      bass_len: 1,
      arp: "3 2 1 0 3 2 1 0",
      drums: "chhhshhkkhhhshoh",
      second: "harmony",
    },
    twin: {
      bass: "0 . 12 0  . 12 0 .  0 12 . 0  12 . > 12",
      bass_len: 1,
      arp: "3 2 1 0 3 2 1 0",
      drums: "khohshokkhohshoh",
      second: "harmony",
    },
    twin_turn: {
      bass: "0 . 12 0  . 12 0 .  0 12 . 0  12 . > 12",
      bass_len: 1,
      arp: "3 2 1 0 3 2 1 0",
      drums: "khohshokkhssttTT",
      second: "harmony",
    },
  },
  form: [
    ...repeat(4, "riff"),
    ...repeat(8, "verse"),
    ...repeat(3, "lift"),
    "fill",
    "chorus_in",
    ...repeat(6, "chorus"),
    "chorus_turn",
    "twin_in",
    ...repeat(6, "twin"),
    "twin_turn",
  ],
})

let LAP_TUNES = [CRUISE, SPRINT]
mut playing = CRUISE
mut bgm_frame = 0

# The tune for lap `n`, from its first bar.
let start_tune = fn (n) {
  playing = LAP_TUNES[(n - 1) % LAP_TUNES.size()]
  bgm_frame = 0
}

# The tune's level, 1.0 while the race runs; the ending turns it down.
mut bgm_gain = 1.0

# Crossing into a new lap fades the last lap's tune out before the next one
# starts from its first bar.
let LAP_FADE = 2 * FPS  # frames the last lap's tune takes to go
mut lap_fade = 0

let tick_bgm = fn () {
  if lap_fade > 0 {
    lap_fade -= 1
    bgm_gain = lap_fade / to_float(LAP_FADE)
    if lap_fade == 0 {
      start_tune(lap)
      bgm_gain = 1.0
    }
  }
  play_step(
    playing,
    bgm_frame / playing.tick,
    bgm_gain,
  ) if bgm_frame % playing.tick == 0
  bgm_frame = (bgm_frame + 1) % playing.length
}

# --- ending ----------------------------------------------------------------
# After the flag the run's music fades out while the car coasts to a stop, the
# electric piano is built while a few seconds pass in silence, and a slow theme
# plays once, the car driving itself off when its opening bars are done; when
# it is over the sea takes over and stays.
let FADE_OUT = 2.5     # seconds the run's music takes to go
let ENDING_REST = 3.0  # seconds of silence before the theme, at the least

# The theme's electric piano is sampled rather than an APU channel: a chord
# needs several notes at once, and a struck tine needs more than a pulse.
# Each pitch the theme uses is synthesised once into a WAV and kept as a
# `Sound`, which is a voice of its own, so a chord is several of them.
let EP_RATE = 22050

# `v` as `n` little-endian bytes.
let le_bytes = fn (v, n) {
  iota(n).map(|i| v >> 8 * i & 255)
}

# 16-bit mono samples as a WAV file's bytes.
let pcm_wav = fn (samples) {
  let n = samples.size()
  mut out = [
    ...le_bytes(0x46464952, 4),  # RIFF
    ...le_bytes(36 + n * 2, 4),
    ...le_bytes(0x45564157, 4),  # WAVE
    ...le_bytes(0x20746d66, 4),  # fmt
    ...le_bytes(16, 4),
    ...le_bytes(1, 2),  # PCM
    ...le_bytes(1, 2),  # mono
    ...le_bytes(EP_RATE, 4),
    ...le_bytes(EP_RATE * 2, 4),
    ...le_bytes(2, 2),
    ...le_bytes(16, 2),
    ...le_bytes(0x61746164, 4),  # data
    ...le_bytes(n * 2, 4),
  ]
  for s in samples {
    let v = s & 0xFFFF
    out.push(v & 255)
    out.push(v >> 8)
  }
  String.from_bytes(out)
}

# Three seconds of one electric-piano note. Two FM pairs a hair apart give
# the slow chorus of a real instrument; the modulation index starts high and
# falls away after the hammer (the bark, scaled by `bark`) to a warm sine;
# a bell partial rings for an instant above notes low enough to keep it
# under the Nyquist limit; higher keys die away sooner.
let ep_samples = fn (pitch, bark) {
  let freq = 440.0 * Math.exp((pitch - 69) / 12.0 * Math.log(2.0))
  let n = EP_RATE * 3
  let w = 2.0 * Math.pi * freq / EP_RATE
  let w2 = w * 1.0025
  let decay = 1.1 * Math.sqrt(freq / 261.63)
  let ping = freq * 15 < EP_RATE / 2 ? 0.08 : 0.0
  mut out = repeat(n, 0)
  for i in 0..n {
    let t = i.to_float() / EP_RATE
    let index = bark * (1.4 * Math.exp(-t * 6.0) + 0.25)
    let tines = Math.sin(w * i + index * Math.sin(w * i)) +
      Math.sin(w2 * i + index * Math.sin(w2 * i))
    let bell = Math.sin(w * 15.0 * i) * Math.exp(-t * 35.0) * ping
    let env = Math.exp(-t * decay) *
      Math.min(1.0, i / 40.0) *
      Math.min(1.0, (n - i) / 800.0)
    out[i] = ((tines * 0.5 + bell) * env * 7000).to_long()
  }
  out
}

# A chord as the piano plays it: rootless (the bass has the root), close,
# from the E below middle C upward.
let voicing = fn (name) {
  let (symbol, _) = name.split_once("/") ?? (name, nil)
  let (pc, quality) = split_root(symbol.to_string())
  mut out = []
  mut lowest = 52
  for i in chord_shape(quality).filter(|i| i % 12 != 0) {
    mut p = 48 + Math.wrap(pc + i, 12)
    while p < lowest {
      p += 12
    }
    out.push(p)
    lowest = p + 1
  }
  out
}

# The theme from its score, expanded per sixteenth like a lap's tune. The
# melody is the piano's top line; a groove's `comp` strikes the voiced chord
# (`x`), one of its notes by index (a digit), or nothing (`.`); `bass` and
# `drums` read as in `tune`. `voices` lists every (key, pitch, bark) the
# theme needs sampled: the melody's notes brighter than the chords'.
let ballad = fn (score) {
  let bars = score.chords.size()
  let steps = bars * BAR
  if score.melody.size() != bars || score.form.size() != bars {
    throw {
      kind: "ValueError",
      message: "{bars} bars of chords, {score.melody.size()} of melody, {score.form.size()} of form",
    }
  }
  let changes = score.chords.map(fn (text) {
    text.split_whitespace().map(fn (symbol) {
      let (low, _) = chord(symbol.to_string())
      (low, voicing(symbol.to_string()))
    })
  })
  let melody = onsets(score.melody.flat_map(fn (bar_text) {
    tokens(bar_text, BAR).map(note_number)
  }))
  mut grooves = {}
  for groove_name, g in score.grooves {
    let hits = g.drums.iter().map(|ch| ch.to_string()).collect()
    if hits.size() != BAR || hits.any(|ch| ch != "." && !score.kit.has(ch)) {
      throw {
        kind: "ValueError",
        message: "bad drums in {groove_name}: {g.drums}",
      }
    }
    grooves[groove_name] = {
      comp: tokens(g.comp, BAR),
      bass: tokens(g.bass, BAR),
      drums: hits,
    }
  }

  mut comp = repeat(steps, nil)
  mut bass = repeat(steps, nil)
  mut drums = repeat(steps, nil)
  mut wanted = {}
  for step in 0..steps {
    let bar = step / BAR
    let slot = step % BAR
    let g = grooves[score.form[bar]]
    let here = changes[bar]
    let (root, notes) = here[here.size() == 2 && slot >= BAR / 2 ? 1 : 0]

    let strike = g.comp[slot]
    if strike != "." {
      let struck = strike == "x"
        ? notes
        : [notes[Math.min(to_long(strike), notes.size() - 1)]]
      comp[step] = struck
      for p in struck {
        wanted["c{p}"] = {pitch: p, bark: 0.8}
      }
    }
    let bass_hit = g.bass[slot]
    if bass_hit != "." {
      let (next_root, _) = changes[(bar + 1) % bars][0]
      mut run = 1
      while slot + run < BAR && g.bass[slot + run] == "." {
        run += 1
      }
      bass[step] = (
        bass_hit == ">" ? next_root - 1 : root + to_long(bass_hit),
        run,
      )
    }
    drums[step] = g.drums[slot] if g.drums[slot] != "."
    let sung = melody[step]
    if sung != nil {
      let (sung_pitch, _) = sung
      wanted["m{sung_pitch}"] = {pitch: sung_pitch, bark: 1.3}
    }
  }
  {
    tick: score.tick,
    length: score.tick * steps,
    kit: score.kit,
    melody: melody,
    comp: comp,
    bass: bass,
    drums: drums,
    voices: wanted
      .keys()
      .sorted()
      .map(|key| (key, wanted[key].pitch, wanted[key].bark)),
  }
}

# The theme: a slow ballad at 69 bpm in Eb, after the late-night coast-road
# ballads of the 16-bit arcades. Four bars of the piano alone drifting down
# IV-iii-ii-V through a C7 that leans into the ii: a high Bb, the note the
# verse will open on, sighing down by step to the C7's third, resolving up
# to the ii where the opening figure answers on its extensions, the last
# bar's suspension resolving with the chord; a verse whose phrases sing a long note and sigh
# down from it,
# turning through G7 to the relative minor and a borrowed Abm6; a second
# half that climbs to its high Eb and settles through ii-V; and two bars
# ringing out on Ebmaj9. A round triangle bass walks under it, brushes on
# two and four from the verse, a ride joins at the peak.
let BALLAD = ballad({
  tick: 13,
  kit: {
    b: {freq: 4000, dur: 2, vol: 4, release: 5},
    r: {freq: 6000, dur: 1, vol: 3, release: 10},
  },
  chords: [
    "Abmaj9",
    "Gm7 C7",
    "Fm9",
    "Bb7sus4 Bb7",
    "Ebmaj9",
    "Gm7 Cm9",
    "Abmaj9",
    "Fm9 Bb7sus4",
    "Ebmaj9",
    "Dm7b5 G7",
    "Cm9",
    "Abm6 Db9",
    "Abmaj9",
    "Bb/Ab",
    "Gm7",
    "Cm9",
    "Fm9",
    "Bb7sus4 Bb7",
    "Abmaj9",
    "Ebmaj9",
  ],
  melody: [
    ". . . .  . . Bb5 G5  Bb5 - - -  - - - -",
    "- - - -  G5 - F5 -  E5 - - -  - - - -",
    "F5 - - -  - - Bb5 G5  Eb5 - - -  - - - -",
    "- - - -  . . Eb5 F5  D5 - - -  F5 - G5 -",
    "Bb5 - - -  - - - -  - - G5 -  - - F5 -",
    "G5 - - -  - - - -  Eb5 - - -  D5 - Eb5 -",
    "C6 - - -  - - - -  Bb5 - - -  G5 - - -",
    "Ab5 - - -  - - G5 -  F5 - - -  Eb5 - - -",
    "D5 - - -  - - Eb5 -  F5 - - -  G5 - Bb5 -",
    "C6 - - -  - - Ab5 -  B5 - - -  - - G5 -",
    "G5 - - -  - - - -  - - Eb5 -  D5 - C5 -",
    "Eb5 - - -  - - - -  F5 - - -  Eb5 - - -",
    "Eb6 - - -  - - C6 -  - - - -  Bb5 - - -",
    "D6 - - -  - - - -  C6 - - -  Bb5 - - -",
    "Bb5 - - -  - - D6 -  - - - -  C6 - Bb5 -",
    "G5 - - -  - - - -  - - Bb5 -  G5 - Eb5 -",
    "F5 - - -  - - - -  Ab5 - - -  G5 - - -",
    "Eb5 - - -  - - F5 -  D5 - - -  - - . .",
    "Eb5 - - -  - - - -  G5 - - -  Bb5 - - -",
    "G5 - - -  - - - -  - - - -  - - - -",
  ],
  grooves: {
    alone: {
      comp: "x . . .  . . . .  . . 3 .  . . . .",
      bass: "0 . . .  . . . .  . . . .  7 . . .",
      drums: "....r.......r...",
    },
    alone_two: {
      comp: "x . . .  . . . .  x . . .  . . . .",
      bass: "0 . . .  . . . .  0 . . .  . . > .",
      drums: "....r.......r...",
    },
    verse: {
      comp: "x . . .  . . . .  . . x .  . . 3 .",
      bass: "0 . . .  . . . .  . . 7 .  . . > .",
      drums: "....b.......b...",
    },
    peak: {
      comp: "x . . 3  . . 2 .  x . . 3  . . 2 .",
      bass: "0 . . .  . . 7 .  0 . . .  12 . > .",
      drums: "....b...r...b.r.",
    },
    settle: {
      comp: "x . . .  . . 3 .  . . 2 .  . . 1 .",
      bass: "0 . . .  . . . .  . . . .  . . . .",
      drums: "................",
    },
    ring: {
      comp: "x . . .  . . . .  . . . .  . . . .",
      bass: "0 . . .  . . . .  . . . .  . . . .",
      drums: "................",
    },
  },
  form: [
    "alone",
    "alone_two",
    "alone",
    "alone_two",
    ...repeat(8, "verse"),
    ...repeat(6, "peak"),
    "settle",
    "ring",
  ],
})

# Loudness against the APU: a `Sound` plays at `vol`% of its own level, a
# tone at a fifth of that.
let EP_MELODY_VOL = 46
let EP_COMP_VOL = 26
let BALLAD_BASS = voice(Canvas.TRIANGLE, 34, 3, 0, 14)

mut ep_voices = {}
let ep_ready = fn () {
  ep_voices.size() == BALLAD.voices.size()
}

# Sample the next note the theme still lacks. One a frame, so the frozen
# finish stays responsive while the piano is built.
let build_ep_voice = fn () {
  let missing = BALLAD.voices.find(|v| !ep_voices.has(v[0]))
  if missing != nil {
    let (key, pitch, bark) = missing
    ep_voices[key] = Canvas.Sound.new(pcm_wav(ep_samples(pitch, bark)))
  }
}

let play_ballad_step = fn (b, step) {
  let sung = b.melody[step]
  if sung != nil {
    let (sung_pitch, _) = sung
    ep_voices["m{sung_pitch}"].play(EP_MELODY_VOL)
  }
  for p in b.comp[step] ?? [] {
    ep_voices["c{p}"].play(EP_COMP_VOL)
  }
  let low = b.bass[step]
  if low != nil {
    let (low_pitch, low_len) = low
    sound(BALLAD_BASS, low_pitch, low_len * b.tick - 3, 1.0)
  }
  let hit = b.drums[step]
  drum(b.kit[hit], 1.0) if hit != nil
}
mut end_frame = 0

# The sea: one wave at a time on the noise channel, a hiss that swells, breaks
# and draws back over four or five seconds, then a pause of its own choosing.
mut wave_wait = 0
let tick_waves = fn () {
  if wave_wait == 0 {
    let swell = Random.int(30, 60)
    Canvas.tone(
      Random.int(200, 400),
      swell * 2,
      vol: Random.int(3, 6),
      wave: Canvas.NOISE,
      end_freq: Random.int(800, 1600),
      attack: swell,
      decay: swell,
      release: swell * 4,
      peak: Random.int(7, 11),
    )
    wave_wait = swell * 8 + Random.int(30, 150)
  }
  wave_wait -= 1
}

mut ending_t = 0.0
let tick_ending = fn (dt) {
  ending_t += dt
  if ending_t < FADE_OUT {
    let gain = 1.0 - ending_t / FADE_OUT
    if MUSIC_FILE == nil {
      bgm_gain = gain
      tick_bgm()
    } else {
      Canvas.music_volume(Math.round(MUSIC_VOL * gain))
    }
  } else if ending_t < FADE_OUT + ENDING_REST || !ep_ready() {
    Canvas.music_stop() if MUSIC_FILE != nil && Canvas.music_playing()
    build_ep_voice()
  } else if end_frame < BALLAD.length {
    play_ballad_step(
      BALLAD,
      end_frame / BALLAD.tick,
    ) if end_frame % BALLAD.tick == 0
    end_frame += 1
  } else {
    tick_waves()
  }
}

# --- race control ----------------------------------------------------------
# The world is frozen while the count-in runs, so only the clock, the beeps and
# the music advance: three beeps a second apart and a higher one on the drop.
let tick_count_in = fn (dt) {
  count_in -= dt
  let n = Math.ceil(count_in)
  if n < counted {
    counted = n
    Canvas.tone(
      n > 0 ? 660 : 990,
      n > 0 ? 8 : GO_BEEP,
      vol: 25,
      wave: Canvas.PULSE,
      decay: 2,
      release: 4,
    )
  }
}

# After the flag the car drives itself. It holds the nearest lane and coasts
# to a stop while the race music fades, stands there through the theme's
# opening bars, then cruises off at an easy pace, moving over for anything
# slower ahead.
let THEME_INTRO = 4 * BAR * BALLAD.tick  # frames of the theme spent standing
let CRUISE_SPEED = MAX_SPEED * 0.45
let LANE_CENTRES = iota(LANES).map(|i| (2.0 * i + 1.0) / LANES - 1.0)
mut auto_lane = 0.0

# Whether a car slower than the cruise is in `lane` within `reach` segments
# of segment `from`.
let lane_blocked = fn (lane, from, reach) {
  let n = segments.size()
  for i in 0..reach {
    for car in segments[(from + i) % n].cars {
      return true if car.speed < CRUISE_SPEED &&
        Math.abs(car.offset - lane) < 0.5
    }
  }
  false
}

# The keys the car presses for itself this step.
let autopilot = fn () {
  let segment = find_segment(position + PLAYER_Z)
  let here = segment.index
  let rolling = end_frame >= THEME_INTRO
  if !rolling {
    auto_lane = LANE_CENTRES.min_by(|lane| Math.abs(lane - player_x))
  } else if lane_blocked(auto_lane, here, 12) {
    let free = LANE_CENTRES
      .filter(|lane| !lane_blocked(lane, here, 12))
      .sorted_by(|lane| Math.abs(lane - player_x))
    auto_lane = free[0] if !free.empty()
  }
  # Steer against the bend's pull, and back toward the lane in proportion to
  # how far off it the car is, so the wheel moves smoothly. The picture turns
  # only once the steering is clearly one way and straightens only once it is
  # clearly not, so it does not flicker between the two through a bend.
  let pull = speed / MAX_SPEED * segment.curve * CENTRIFUGAL
  steer = Math.clamp(pull + 3.0 * (auto_lane - player_x), -1.0, 1.0)
  lean = cond {
    steer > 0.35 => 1.0,
    steer < -0.35 => -1.0,
    Math.abs(steer) < 0.2 => 0.0,
    _ => lean,
  }
  key_faster = rolling &&
    speed < CRUISE_SPEED &&
    !lane_blocked(auto_lane, here, 3)
  key_slower = false
}

# Back to the line for another two laps. The traffic is scattered again (a
# segment holds its own cars, so those lists are emptied first) and the best
# lap is deliberately kept: it is the session's target, not the race's.
let restart_race = fn () {
  for segment in segments {
    segment.cars = []
  }
  reset_cars()
  position = 0.0
  speed = 0.0
  player_x = 0.0
  sky_offset = 0.0
  hill_offset = 0.0
  tree_offset = 0.0
  current_lap_time = 0.0
  last_lap_time = 0.0
  total_time = 0.0
  lap = 1
  finished = false
  count_in = COUNT_IN
  counted = 4
  ending_t = 0.0
  end_frame = 0
  wave_wait = 0
  bgm_gain = 1.0
  lap_fade = 0
  start_tune(1)
  music_on = false
  music_wait = MUSIC_DELAY
}

# --- update ----------------------------------------------------------------
# How far a car steers this frame to get around whatever is in front of it.
let steer_car = fn (car, car_index, player_index, n, player_half) {
  let ahead = (car_index - player_index + n) % n
  mut result = 0.0
  if ahead <= DRAW_DISTANCE || ahead >= n - AI_LOOKBEHIND {
    let car_w = car.w
    let offset = car.offset
    let car_speed = car.speed
    for i in 1..LOOKAHEAD {
      mut si = car_index + i
      si -= n if si >= n
      let segment = segments[si]

      if si == player_index && car_speed > speed {
        let lim = player_half + car_w * 0.6
        let d = player_x - offset
        if d >= -lim && d <= lim {
          let dir = cond {
            player_x > 0.5 => -1.0,
            player_x < -0.5 => 1.0,
            offset > player_x => 1.0,
            _ => -1.0,
          }
          # The closer the car and the bigger the speed gap, the harder it pulls.
          result = dir * (1.0 / i) * (car_speed - speed) / MAX_SPEED
          break
        }
      }

      let other = segment.cars.find(|o| {
        let reach = (car_w + o.w) * 0.6
        let gap = offset - o.offset
        car_speed > o.speed && gap >= -reach && gap <= reach
      })
      if other != nil {
        let dir = cond {
          other.offset > 0.5 => -1.0,
          other.offset < -0.5 => 1.0,
          offset > other.offset => 1.0,
          _ => -1.0,
        }
        result = dir * (1.0 / i) * (car_speed - other.speed) / MAX_SPEED
        break
      }
    } nobreak {
      # Nothing ahead, but somehow off the road: steer back on.
      if offset < -0.9 {
        result = 0.1
      } else if offset > 0.9 {
        result = -0.1
      }
    }
  }
  result
}

# Order inside a segment is not observable — every car in it is drawn in the
# same z band — so the hand-off is a swap-pop rather than a splice.
let remove_car = fn (list, car) {
  let i = list.index_of(car)
  if i >= 0 {
    list[i] = list[list.size() - 1]
    list.pop()
  }
}

let update_cars = fn (dt, player_index) {
  let n = segments.size()
  let seg_len = SEGMENT_LENGTH * 1.0
  let player_half = PLAYER_W * 0.6
  for car in cars {
    let old_index = car.seg
    car.offset += steer_car(car, old_index, player_index, n, player_half)
    mut zin = car.zin + dt * car.speed
    if zin >= seg_len {
      zin -= seg_len
      mut ni = old_index + 1
      ni = 0 if ni >= n
      car.seg = ni
      remove_car(segments[old_index].cars, car)
      segments[ni].cars.push(car)
    }
    car.zin = zin
    car.percent = zin / seg_len
    car.z = car.seg * seg_len + zin
  }
}

let update = fn (dt) {
  let player_segment = find_segment(position + PLAYER_Z)
  let speed_percent = speed / MAX_SPEED
  let dx = dt * 2.0 * speed_percent  # left to right in one second, flat out
  let start_position = position

  update_cars(dt, player_segment.index)

  position = increase(position, dt * speed, track_length)

  player_x += dx * steer
  player_x -= dx * speed_percent * player_segment.curve * CENTRIFUGAL

  if key_faster {
    speed += ACCEL * dt
  } else if key_slower {
    speed += BREAKING * dt
  } else {
    speed += DECEL * dt
  }

  if player_x < -1.0 || player_x > 1.0 {
    speed += OFF_ROAD_DECEL * dt if speed > OFF_ROAD_LIMIT

    for prop in player_segment.sprites {
      let pw = prop.art.sw
      # A prop is anchored at its inner edge, so its centre is half a width out.
      let side = prop.offset > 0.0 ? 1.0 : -1.0
      if overlap(player_x, PLAYER_W, prop.offset + pw / 2.0 * side, pw, 1.0) {
        speed = MAX_SPEED / 5.0
        # Stop in front of it, at the near edge of its segment.
        position = increase(player_segment.p1_wz, -PLAYER_Z, track_length)
        break
      }
    }
  }

  for car in player_segment.cars {
    if speed > car.speed &&
        overlap(player_x, PLAYER_W, car.offset, car.w, 0.8) {
      speed = car.speed * (car.speed / speed)
      position = increase(car.z, -PLAYER_Z, track_length)
      break
    }
  }

  player_x = limit(player_x, -3.0, 3.0)
  speed = limit(speed, 0.0, MAX_SPEED)

  let scroll = player_segment.curve *
    (position - start_position) /
    SEGMENT_LENGTH
  sky_offset = increase(sky_offset, SKY_SPEED * scroll, 1.0)
  hill_offset = increase(hill_offset, HILL_SPEED * scroll, 1.0)
  tree_offset = increase(tree_offset, TREE_SPEED * scroll, 1.0)

  # The lap turns over where the player crosses the line, not where `position`
  # wraps — the camera is PLAYER_Z behind the car. After the flag the clock
  # and the laps stand still however far the car cruises.
  if !finished && position > PLAYER_Z {
    if current_lap_time > 0.0 && start_position < PLAYER_Z {
      last_lap_time = current_lap_time
      current_lap_time = 0.0
      total_time += last_lap_time
      if last_lap_time < fast_lap_time {
        fast_lap_time = last_lap_time
      }
      if lap == TOTAL_LAPS {
        finished = true
      } else {
        lap += 1
        lap_fade = LAP_FADE
      }
    } else {
      current_lap_time += dt
    }
  }

  # The music waits a second past the GO beep, so the beep is never cut
  # short by the tune's downbeat (which strikes every channel).
  if !music_on {
    music_wait -= 1
    if music_wait <= 0 {
      music_on = true
      Canvas.music(art(MUSIC_FILE), vol: MUSIC_VOL) if MUSIC_FILE != nil
    }
  }
  tick_bgm() if MUSIC_FILE == nil && music_on && !finished
}

# --- render ----------------------------------------------------------------
# The fog factor only depends on how far down the draw window a segment is, so
# it is tabulated once, as 0..256 for the integer colour lerp.
let fog_i = iota(DRAW_DISTANCE).map(|n| Math.round(exponential_fog(
  n / (DRAW_DISTANCE * 1.0),
  FOG_DENSITY,
) *
  256.0))

# Per-frame road colours: the current scene lerped toward the next one, then
# each segment lerped toward the fog colour. Both are integer arithmetic —
# floats would need a Math.round per channel to reach the Long the primitive
# takes, and that is 3 us a call.
# By segment kind: grass, rumble, road, lane, then the rumble's outer face
# (turned from the light).
mut pal = [[], []]
# Road marking colours for this frame: light r,g,b then dark r,g,b. White and
# black would be the obvious choice and they punch a hole in a pastel scene,
# so the pair is built out of the palette instead — the light half is mostly
# the warm cream the lane dashes use with a fifth of the road's own colour
# mixed back in, the dark half is that colour at half strength. Every scene of
# the day cycle then gets a marking in its own family, and it moves with the
# crossfade.
mut mark_rgb = [0, 0, 0, 0, 0, 0]
mut fog_r = 0
mut fog_g = 0
mut fog_b = 0
mut sky_color = 0

let build_palette = fn (scene, blend) {
  let a = SCENE_COLORS[scene]
  let b = SCENE_COLORS[(scene + 1) % SCENE_COUNT]
  let f = blend
  let g = 256 - blend
  let c = fn (i) {
    (a[i] * g + b[i] * f) / 256
  }
  pal[KIND_DARK] = [
    c(0),
    c(1),
    c(2),
    c(12),
    c(13),
    c(14),
    c(6),
    c(7),
    c(8),
    LANE_R,
    LANE_G,
    LANE_B,
    c(12) * 7 / 8,
    c(13) * 7 / 8,
    c(14) * 7 / 8,
  ]
  pal[KIND_LIGHT] = [
    c(3),
    c(4),
    c(5),
    c(15),
    c(16),
    c(17),
    c(9),
    c(10),
    c(11),
    LANE_R,
    LANE_G,
    LANE_B,
    c(15) * 7 / 8,
    c(16) * 7 / 8,
    c(17) * 7 / 8,
  ]
  mark_rgb = [
    (LANE_R * 4 + c(9)) / 5,
    (LANE_G * 4 + c(10)) / 5,
    (LANE_B * 4 + c(11)) / 5,
    c(6) / 2,
    c(7) / 2,
    c(8) / 2,
  ]
  fog_r = c(18)
  fog_g = c(19)
  fog_b = c(20)
  # Backstop clear colour behind the parallax stack (the strip the layers
  # uncover when climbing is filled from the sky art itself in draw_layer).
  sky_color = c(21) + c(22) * 256 + c(23) * 65536 + OPAQUE
}

# One parallax layer, drawn twice because the source window wraps at the middle
# of the sheet (each layer is two screens wide). The second draw starts exactly
# where the first ended, so the seam neither doubles nor drops a column.
let draw_layer = fn (id, layer, rotation, offset, alpha) {
  let image_w = layer.w / 2
  let source_x = layer.x + Math.floor(layer.w * rotation)
  let source_w = Math.min(image_w, layer.x + layer.w - source_x)
  let dest_w = Math.floor(W * (source_w * 1.0 / image_w))
  _Canvas.blit_scaled(
    id,
    0,
    offset,
    dest_w,
    H,
    source_x,
    layer.y,
    source_w,
    layer.h,
    0,
    alpha,
  )
  if source_w < image_w {
    _Canvas.blit_scaled(
      id,
      dest_w,
      offset,
      W - dest_w,
      H,
      layer.x,
      layer.y,
      image_w - source_w,
      layer.h,
      0,
      alpha,
    )
  }
  # Climbing slides the layer down and uncovers a strip above it. Fill it by
  # stretching the layer's own top row, so any art matches itself — the
  # palette sky colour only matches the generated backgrounds, and foreign
  # art (--assets) showed it as a solid wrong-coloured band. A transparent
  # top row (hills, trees) draws nothing, so only the sky actually pays.
  if offset >= 1.0 {
    _Canvas.blit_scaled(
      id,
      0,
      0,
      dest_w,
      offset,
      source_x,
      layer.y,
      source_w,
      1,
      0,
      alpha,
    )
    if source_w < image_w {
      _Canvas.blit_scaled(
        id,
        dest_w,
        0,
        W - dest_w,
        offset,
        layer.x,
        layer.y,
        image_w - source_w,
        1,
        0,
        alpha,
      )
    }
  }
}

let draw_background = fn (id, player_y, alpha) {
  draw_layer(id, BG_SKY, sky_offset, RESOLUTION * SKY_SPEED * player_y, alpha)
  draw_layer(
    id,
    BG_HILLS,
    hill_offset,
    RESOLUTION * HILL_SPEED * player_y,
    alpha,
  )
  draw_layer(
    id,
    BG_TREES,
    tree_offset,
    RESOLUTION * TREE_SPEED * player_y,
    alpha,
  )
}

# v4 draws a translucent fog rectangle over each band; lerping the four colours
# toward the fog colour is the same picture (the bands tile exactly, so nothing
# is covered twice) without an alpha pass.
# The screen row at depth `d` into a projected segment (0 at its near edge, 1
# at its far one). Depth is linear in 1/scale, not in rows, so the two edges'
# rows are weighted by it.
let mark_row = fn (segment, d) {
  let a = (1.0 - d) / segment.p1_scale
  let b = d / segment.p2_scale
  H2 - (a * (H2 - segment.p1_sy) + b * (H2 - segment.p2_sy)) / (a + b)
}

# A colour at `rgb[i..i+3]` faded toward this frame's fog: `f` parts of it to
# `g` of fog, out of 256.
let fogged = fn (rgb, i, f, g) {
  (rgb[i] * f + fog_r * g) / 256 +
    ((rgb[i + 1] * f + fog_g * g) / 256) * 256 +
    ((rgb[i + 2] * f + fog_b * g) / 256) * 65536 +
    OPAQUE
}

let draw_road = fn (base_index, base_percent, player_y) {
  let n_segments = segments.size()
  let camera_y = player_y + CAMERA_HEIGHT
  let px_road = player_x * ROAD_WIDTH
  let cz_here = position
  let cz_looped = position - track_length

  # The road is painted in whole screen rows, from the bottom of the frame
  # upward, so the band boundary is carried as a row number rather than as the
  # projected y. That makes the bands tile exactly (the grass rectangle and the
  # trapezoids share one edge), and it drops a segment whose band would land
  # inside a row it has already painted — which is most of the far half of the
  # window, and what the original gets for free by rounding its coordinates.
  # `edge` is an integer, so `sy2 < edge` is `floor(sy2) < edge`: the test costs
  # a float compare and only a drawn band pays for a conversion.
  mut edge = H
  mut x = 0.0
  mut dx = -(segments[base_index].curve * base_percent)
  mut si = base_index
  for n in 0..DRAW_DISTANCE {
    let segment = segments[si]
    let looped = si < base_index
    segment.clip = edge
    let camera_z = looped ? cz_looped : cz_here

    # Cull before dividing: with the camera exactly on a segment boundary the
    # depth is zero, where JS yields Infinity and culebra raises.
    let cz1 = segment.p1_wz - camera_z
    mut sy1 = 0.0
    mut sy2 = 0.0
    mut visible = false
    segment.vis = cz1 > CAMERA_DEPTH
    if segment.vis {
      let scale1 = CAMERA_DEPTH / cz1
      sy1 = H2 - scale1 * (segment.p1_wy - camera_y) * H2
      segment.p1_scale = scale1
      segment.p1_sx = W2 + scale1 * (x - px_road) * W2
      segment.p1_sy = sy1
      segment.p1_sw = scale1 * SW_K

      let scale2 = CAMERA_DEPTH / (segment.p2_wz - camera_z)
      sy2 = H2 - scale2 * (segment.p2_wy - camera_y) * H2
      segment.p2_scale = scale2
      segment.p2_sx = W2 + scale2 * (x + dx - px_road) * W2
      segment.p2_sy = sy2
      segment.p2_sw = scale2 * SW_K
      visible = sy2 < sy1 && sy2 < edge
    }

    x += dx
    dx += segment.curve
    si += 1
    si = 0 if si >= n_segments

    if visible {
      let p = pal[segment.kind]
      let f = fog_i[n]
      let g = 256 - f
      let c_grass = (p[0] * f + fog_r * g) / 256 +
        ((p[1] * f + fog_g * g) / 256) * 256 +
        ((p[2] * f + fog_b * g) / 256) * 65536 +
        OPAQUE
      let c_rumble = (p[3] * f + fog_r * g) / 256 +
        ((p[4] * f + fog_g * g) / 256) * 256 +
        ((p[5] * f + fog_b * g) / 256) * 65536 +
        OPAQUE
      let c_road = (p[6] * f + fog_r * g) / 256 +
        ((p[7] * f + fog_g * g) / 256) * 256 +
        ((p[8] * f + fog_b * g) / 256) * 65536 +
        OPAQUE

      # The band runs from `top` (this segment's far edge, snapped up to a row)
      # down to `edge`, the first row nothing has painted yet.
      let top = Math.floor(sy2)
      let x2 = segment.p2_sx
      let w2 = segment.p2_sw
      # The nearest segment straddles the bottom of the frame: its near edge
      # projects a dozen rows below it (p1 is behind the camera's near plane).
      # Painting that vertex AT the bottom row would widen the band and tilt
      # both its edges, which shows up as the road and the lane dashes
      # visibly kinking in the last few rows. A segment is drawn as a straight
      # edge from p1 to p2, so the geometry at the bottom row is that line
      # interpolated to it. Only this one band needs it — every later band
      # starts where the previous one stopped, on a shared vertex.
      mut x1 = segment.p1_sx
      mut w1 = segment.p1_sw
      if edge == H && sy1 > edge {
        let t = (edge - sy1) / (sy2 - sy1)
        x1 += (x2 - x1) * t
        w1 += (w2 - w1) * t
      }
      let r1 = w1 / 6.0
      let r2 = w2 / 6.0
      let detail = w1 > DETAIL_W
      _Canvas.rect(0, top, W, edge - top, c_grass, 1)
      _Canvas.polygon(
        [x1 - w1 - r1, edge, x1 - w1, edge, x2 - w2, top, x2 - w2 - r2, top],
        c_rumble,
        1,
      )
      _Canvas.polygon(
        [x1 + w1 + r1, edge, x1 + w1, edge, x2 + w2, top, x2 + w2 + r2, top],
        c_rumble,
        1,
      )
      # A curb's outer part is its face, turned away from the light.
      let c_face = fogged(p, 12, f, g)
      _Canvas.polygon(
        [
          x1 - w1 - r1,
          edge,
          x1 - w1 - r1 * 0.55,
          edge,
          x2 - w2 - r2 * 0.55,
          top,
          x2 - w2 - r2,
          top,
        ],
        c_face,
        1,
      )
      _Canvas.polygon(
        [
          x1 + w1 + r1,
          edge,
          x1 + w1 + r1 * 0.55,
          edge,
          x2 + w2 + r2 * 0.55,
          top,
          x2 + w2 + r2,
          top,
        ],
        c_face,
        1,
      )
      _Canvas.polygon(
        [x1 - w1, edge, x1 + w1, edge, x2 + w2, top, x2 - w2, top],
        c_road,
        1,
      )
      # A solid line marks each edge of the road inside the curb, on every
      # band like the curb itself: stopping it short of the horizon leaves its
      # end hanging in view.
      let c_edge = fogged(mark_rgb, 0, f, g)
      let e1 = w1 * 0.03
      let e2 = w2 * 0.03
      _Canvas.polygon(
        [
          x1 - w1 + e1,
          edge,
          x1 - w1 + e1 * 2,
          edge,
          x2 - w2 + e2 * 2,
          top,
          x2 - w2 + e2,
          top,
        ],
        c_edge,
        1,
      )
      _Canvas.polygon(
        [
          x1 + w1 - e1,
          edge,
          x1 + w1 - e1 * 2,
          edge,
          x2 + w2 - e2 * 2,
          top,
          x2 + w2 - e2,
          top,
        ],
        c_edge,
        1,
      )
      if segment.kind == KIND_LIGHT {
        let c_lane = (p[9] * f + fog_r * g) / 256 +
          ((p[10] * f + fog_g * g) / 256) * 256 +
          ((p[11] * f + fog_b * g) / 256) * 65536 +
          OPAQUE
        let lw1 = w1 * 2.0 / LANES
        let lw2 = w2 * 2.0 / LANES
        let l1 = w1 / 64.0  # half a lane marker, which is w/max(32, 8*lanes)
        let l2 = w2 / 64.0
        # Up close a dash is thick paint: a slightly dimmer rim round a
        # bright core.
        let c_rim = detail
          ? (p[9] * 7 / 8 * f + fog_r * g) / 256 +
            ((p[10] * 7 / 8 * f + fog_g * g) / 256) * 256 +
            ((p[11] * 7 / 8 * f + fog_b * g) / 256) * 65536 +
            OPAQUE
          : c_lane
        mut lx1 = x1 - w1 + lw1
        mut lx2 = x2 - w2 + lw2
        for _ in 1..LANES {
          _Canvas.polygon(
            [lx1 - l1, edge, lx1 + l1, edge, lx2 + l2, top, lx2 - l2, top],
            c_rim,
            1,
          )
          if detail {
            let k1 = l1 * 0.55
            let k2 = l2 * 0.55
            _Canvas.polygon(
              [lx1 - k1, edge, lx1 + k1, edge, lx2 + k2, top, lx2 - k2, top],
              c_lane,
              1,
            )
          }
          lx1 += lw1
          lx2 += lw2
        }
      }

      # Road markings go on last, over everything else on the tarmac and never
      # wider than the road. A marking is laid out in the segment's own terms:
      # depth along it (0 at the near edge) and `u` across the road (-1..1). A
      # depth becomes a row through `mark_row`, clamped to the rows this band
      # owns, and a row a point on the band's edges, which run straight from
      # the row `x1`/`w1` belong to up to `sy2` — so a band a fraction of a
      # segment deep lands where the ground puts it. The flag lays its dark
      # squares down as one trapezoid and overlays the light ones, so a column
      # that rounds a hair short shows dark rather than grass. Its phase flips
      # with the segment index, making the stripe's segments the rows of the
      # check, and a white band closes it at either end.
      if segment.mark != MARK_NONE {
        let band_bottom = edge * 1.0
        let band_top = top * 1.0
        let near_row = edge == H && sy1 > edge ? band_bottom : sy1
        let far_row = sy2
        let (near_x, near_w) = (x1, w1)
        let paint = fn (d0, d1, u0, u1, color) {
          let ya = Math.min(band_bottom, mark_row(segment, d0))
          let yb = Math.max(band_top, mark_row(segment, d1))
          if yb < ya {
            let span = Math.max(0.001, near_row - far_row)
            let ka = (near_row - ya) / span
            let kb = (near_row - yb) / span
            let xa = near_x + (x2 - near_x) * ka
            let wa = near_w + (w2 - near_w) * ka
            let xb = near_x + (x2 - near_x) * kb
            let wb = near_w + (w2 - near_w) * kb
            _Canvas.polygon(
              [
                xa + u0 * wa,
                ya,
                xa + u1 * wa,
                ya,
                xb + u1 * wb,
                yb,
                xb + u0 * wb,
                yb,
              ],
              color,
              1,
            )
          }
        }
        let c_light = fogged(mark_rgb, 0, f, g)
        let c_dark = fogged(mark_rgb, 3, f, g)
        paint(0.0, 1.0, -1.0, 1.0, c_dark)
        let cw = 2.0 / CHECKER_COLS
        for col in segment.index % 2..CHECKER_COLS by 2 {
          paint(0.0, 1.0, -1.0 + cw * col, -1.0 + cw * (col + 1), c_light)
        }
        let before = segments[(segment.index + n_segments - 1) % n_segments]
        let after = segments[(segment.index + 1) % n_segments]
        paint(0.0, 0.1, -1.0, 1.0, c_light) if before.mark != segment.mark
        paint(0.9, 1.0, -1.0, 1.0, c_light) if after.mark != segment.mark
      }
      edge = top
    }
  }
}

# Render.sprite: the destination size is the sprite's world size projected, and
# a segment that a nearer hill already covered crops it (source and destination
# shrink together).
let draw_art = fn (art, scale, dest_x, dest_y, offset_x, clip) {
  let k = scale * SW_K
  let dw = art.sw * k
  let dh = art.sh * k
  let dx = dest_x + dw * offset_x
  let dy = dest_y - dh
  if dy < clip {
    let over = dy + dh - clip
    if over > 0.0 {
      let keep = 1.0 - over / dh
      _Canvas.blit_scaled(
        SHEET,
        dx,
        dy,
        dw,
        dh - over,
        art.x,
        art.y,
        art.w,
        art.h * keep,
        0,
        255,
      )
    } else {
      _Canvas.blit_scaled(
        SHEET,
        dx,
        dy,
        dw,
        dh,
        art.x,
        art.y,
        art.w,
        art.h,
        0,
        255,
      )
    }
  }
}

let draw_player = fn (speed_percent, dest_y, steer, updown) {
  let bounce = 1.5 *
    Random.uniform(0.0, 1.0) *
    speed_percent *
    RESOLUTION *
    (Random.int(0, 2) == 0 ? -1.0 : 1.0)
  let art = cond {
    steer < 0.0 => updown > 0.0 ? PLAYER_UPHILL_LEFT : PLAYER_LEFT,
    steer > 0.0 => updown > 0.0 ? PLAYER_UPHILL_RIGHT : PLAYER_RIGHT,
    _ => updown > 0.0 ? PLAYER_UPHILL_STRAIGHT : PLAYER_STRAIGHT,
  }
  # No hill clips the player's own car; the framebuffer edge is the only limit.
  draw_art(art, CAMERA_DEPTH / PLAYER_Z, W2, dest_y + bounce, -0.5, NO_CLIP)
}

# --- HUD -------------------------------------------------------------------
# The original puts these in the page around the canvas; here they go on a
# strip across the top, in the built-in 8x8 font: cream on a deep beige, the
# same beige the results panel is washed in.
let HUD_BG = 138 + 106 * 256 + 72 * 65536 + OPAQUE
let HUD_FG = 255 + 248 * 256 + 232 * 65536 + OPAQUE

let format_time = fn (t) {
  let minutes = Math.floor(t / 60.0)
  let seconds = Math.floor(t - minutes * 60.0)
  let tenths = Math.floor(10.0 * (t - Math.floor(t)))
  minutes > 0 ? "{minutes}:{seconds:02}.{tenths}" : "{seconds}.{tenths}"
}

let draw_hud = fn () {
  _Canvas.rect(0, 0, W, 14, HUD_BG, 1)
  Canvas.text("{5 * Math.round(speed / 500.0)} MPH", 8, 3, HUD_FG)
  Canvas.text("LAP {lap}/{TOTAL_LAPS}", 88, 3, HUD_FG)
  Canvas.text("TIME {format_time(current_lap_time)}", 152, 3, HUD_FG)
  Canvas.text("LAST {format_time(last_lap_time)}", 320, 3, HUD_FG)
  Canvas.text("BEST {format_time(fast_lap_time)}", 480, 3, HUD_FG)
}

let BANNER_SHADOW = Canvas.rgba(70, 48, 30)
let PANEL_BG = Canvas.rgba(124, 94, 62, 184)

# One line of banner text, centred, with a one-block dark brown drop shadow so
# it reads against either the sky or the tarmac.
let draw_banner = fn (s, y, scale) {
  let x = (W - Canvas.text_width(s, scale)) / 2
  Canvas.text(s, x + scale, y + scale, BANNER_SHADOW, scale)
  Canvas.text(s, x, y, HUD_FG, scale)
}

# How far a row of a rounded panel is inset — 0 down the straight sides, and
# the corner circle's own offset across the r rows at each end.
let corner_inset = fn (dy, h, r) {
  let dv = cond {
    dy < r => r - dy,
    dy >= h - r => dy - (h - r) + 1,
    _ => 0,
  }
  r - Math.floor(Math.sqrt((r * r - dv * dv) * 1.0))
}

# A rounded panel, translucent enough to leave the road showing through. The
# fill is laid down one row at a time because a translucent colour darkens
# what it covers every time it is drawn, and rows cannot overlap; the edge is
# opaque, so its runs are free to.
let draw_panel = fn (x, y, w, h, r) {
  for dy in 0..h {
    let inset = corner_inset(dy, h, r)
    _Canvas.rect(x + inset, y + dy, w - 2 * inset, 1, PANEL_BG, 1)
  }
  _Canvas.rect(x + r, y, w - 2 * r, 1, HUD_FG, 1)
  _Canvas.rect(x + r, y + h - 1, w - 2 * r, 1, HUD_FG, 1)
  _Canvas.rect(x, y + r, 1, h - 2 * r, HUD_FG, 1)
  _Canvas.rect(x + w - 1, y + r, 1, h - 2 * r, HUD_FG, 1)
  # The arc, a row at a time, each run reaching back to the row above so the
  # steps between them are closed rather than left as gaps.
  mut prev = r
  for dy in 0..r {
    let inset = corner_inset(dy, h, r)
    let run = prev - inset + 1
    _Canvas.rect(x + inset, y + dy, run, 1, HUD_FG, 1)
    _Canvas.rect(x + w - prev - 1, y + dy, run, 1, HUD_FG, 1)
    _Canvas.rect(x + inset, y + h - 1 - dy, run, 1, HUD_FG, 1)
    _Canvas.rect(x + w - prev - 1, y + h - 1 - dy, run, 1, HUD_FG, 1)
    prev = inset
  }
}

# The count-in: the number, then GO!, over the frozen road.
let draw_count_in = fn () {
  let n = Math.ceil(count_in)
  draw_banner(n > 0 ? "{n}" : "GO!", (H - 8 * 6) / 2, 6)
}

# The results, on a panel so every one of these lines reads at a glance over
# the road, standing or cruising.
let draw_finish = fn () {
  draw_panel(120, 150, 400, 160, 12)
  draw_banner("FINISH", 170, 5)
  draw_banner("TOTAL {format_time(total_time)}", 228, 2)
  draw_banner("BEST {format_time(fast_lap_time)}", 252, 2)
  draw_banner("PRESS SPACE TO RACE AGAIN", 285, 1)
}

let render = fn () {
  let n_segments = segments.size()
  let base_segment = find_segment(position)
  let base_index = base_segment.index
  let base_percent = percent_remaining(position, SEGMENT_LENGTH * 1.0)
  let player_segment = find_segment(position + PLAYER_Z)
  let player_index = player_segment.index
  let player_percent = percent_remaining(
    position + PLAYER_Z,
    SEGMENT_LENGTH * 1.0,
  )
  let player_y = player_segment.p1_wy +
    (player_segment.p2_wy - player_segment.p1_wy) * player_percent

  # The day cycle runs on distance, not on the clock, so it reads the same
  # however fast the car is driven. Each scene owns an equal stretch of the
  # track — the five together are exactly one lap — held for the first part of
  # its stretch and cross-faded into the next over the rest.
  let cycle = position * SCENE_COUNT / track_length
  let scene = to_long(cycle)
  let local = cycle - scene
  let blend = local < SCENE_HOLD
    ? 0
    : Math.round((local - SCENE_HOLD) / (1.0 - SCENE_HOLD) * 256.0)
  build_palette(scene, blend)

  _Canvas.clear(sky_color)
  draw_background(backgrounds[scene], player_y, 255)
  if blend > 0 {
    draw_background(
      backgrounds[(scene + 1) % SCENE_COUNT],
      player_y,
      blend * 255 / 256,
    )
  }
  draw_road(base_index, base_percent, player_y)

  # Back to front over the same window, so nearer sprites overlap farther ones.
  mut mi = base_index + DRAW_DISTANCE - 1
  while mi >= n_segments {
    mi -= n_segments
  }
  for _ in 1..DRAW_DISTANCE {
    let segment = segments[mi]
    if segment.vis {
      let s1x = segment.p1_sx
      let s1y = segment.p1_sy
      let s1s = segment.p1_scale
      let clip = segment.clip

      for car in segment.cars {
        let pc = car.percent
        let scale = s1s + (segment.p2_scale - s1s) * pc
        draw_art(
          car.art,
          scale,
          s1x + (segment.p2_sx - s1x) * pc + scale * car.offset * SW_K,
          s1y + (segment.p2_sy - s1y) * pc,
          -0.5,
          clip,
        )
      }

      # A prop hangs off the near edge of the road, so the one on the left is
      # anchored by its right edge and the one on the right by its left.
      for prop in segment.sprites {
        draw_art(
          prop.art,
          s1s,
          s1x + s1s * prop.offset * SW_K,
          s1y,
          prop.offset < 0.0 ? -1.0 : 0.0,
          clip,
        )
      }
    }

    if mi == player_index {
      # The camera sits exactly CAMERA_HEIGHT above the car and PLAYER_Z behind
      # it, so the car's own projection is the constant H — v4 interpolates its
      # camera-space height to arrive at the same number, then four pixels up
      # so the bottom of the car clears the edge of the framebuffer.
      draw_player(
        speed / MAX_SPEED,
        H - 4.0,
        lean,
        player_segment.p2_wy - player_segment.p1_wy,
      )
    }
    mi -= 1
    mi = n_segments - 1 if mi < 0
  }

  draw_hud()
  draw_count_in() if count_in > -GO_HOLD
  draw_finish() if finished
}

# --- main ------------------------------------------------------------------
Random.seed(1)
reset_road()

mut last = Time.monotonic()
mut gdt = 0.0

let frame = fn () {
  # Esc is an ordinary key, not a built-in quit -- ask for one explicitly.
  Canvas.quit() if Canvas.key('escape')

  let now = Time.monotonic()
  # Bound the catch-up, not just the clock: a second of arrears is 60 physics
  # steps in one frame, which on a host that was already behind makes the next
  # frame later still and never recovers. Falling behind has to cost slow
  # motion, not a spiral. Native never reaches the bound (it runs one or two
  # steps a frame), so this only changes what happens once a host cannot keep up.
  let dt = Math.min(4.0 * STEP, now - last)
  last = now

  restart_race() if finished && Canvas.key('space')

  let held = _Canvas.buttons()
  key_left = held & Canvas.LEFT != 0
  key_right = held & Canvas.RIGHT != 0
  steer = key_left ? -1.0 : key_right ? 1.0 : 0.0
  lean = steer
  key_faster = held & Canvas.UP != 0
  key_slower = held & Canvas.DOWN != 0

  gdt += dt
  while gdt > STEP {
    gdt -= STEP
    # Exactly one of these runs, and each keeps the sound going: the world is
    # frozen before the drop, and after the flag the car drives itself.
    if count_in > 0.0 {
      tick_count_in(STEP)
    } else if finished {
      tick_ending(STEP)
      autopilot()
      update(STEP)
    } else {
      count_in -= STEP if count_in > -GO_HOLD
      update(STEP)
    }
  }
  render()
  true
}

Canvas.title("Retro Run")
Canvas.run(W, H, frame, 100000)
