# Cycled one per lap, in this order.
let SCENES = [
  ("asayake", ASAYAKE),
  ("hiru", HIRU),
  ("yuugata", YUUGATA),
  ("yuugure", YUUGURE),
  ("twilight", TWILIGHT),
]

# Key 0 is transparent; the rest index this list. Drawing code names keys,
# never colours, which is what keeps the scenes geometry-identical.
let KEYS = [""]
  .iter()
  .chain(COMMON.keys().to_set().union(HIRU.keys().to_set()).to_array().sorted())
  .collect()
let KEY_ID = KEYS.enumerate().map(|(i, name)| (name, i)).to_object()

# A scene's palette as the packed-RGBA array `Canvas.Sprite` indexes with the
# key buffer. Slot 0 stays 0 — fully transparent, the shape mask.
fn palette_colors(scene) {
  let pal = {...COMMON, ...scene}
  KEYS.map(|name| name == ""
    ? 0
    : Canvas.rgba(pal[name][0], pal[name][1], pal[name][2]))
}

# --- deterministic noise -----------------------------------------------------
# A hash, not an RNG: the same input always gives the same value, so nothing in
# the output depends on evaluation order or on how many shapes came before.
fn noise(*args) {
  mut h = 2166136261
  for a in args {
    h = (h ^ a.to_long() & 0xFFFFFFFF) * 16777619 & 0xFFFFFFFF
  }
  # FNV barely stirs its last input (noise(s, i, 1) and noise(s, i, 2) came
  # out within 0.4% of each other), so finish with an avalanche.
  h = (h ^ h >> 16) * 0x85EBCA6B & 0xFFFFFFFF
  h = (h ^ h >> 13) * 0xC2B2AE35 & 0xFFFFFFFF
  h = h ^ h >> 16
  h.to_float() / 4294967295.0
}

# The hash on a lattice `cell` cells apart, blended smoothly between its
# points: blotches with soft edges rather than the lattice's squares.
fn smooth_noise(seed, x, y, cell) {
  let gx = x / cell.to_float()
  let gy = y / cell.to_float()
  let ix = Math.floor(gx)
  let iy = Math.floor(gy)
  let fx = gx - ix
  let fy = gy - iy
  let sx = fx * fx * (3 - 2 * fx)
  let sy = fy * fy * (3 - 2 * fy)
  let top = noise(seed, ix, iy) * (1 - sx) + noise(seed, ix + 1, iy) * sx
  let bottom = noise(seed, ix, iy + 1) * (1 - sx) +
    noise(seed, ix + 1, iy + 1) * sx
  top * (1 - sy) + bottom * sy
}

# 4x4 ordered-dither thresholds, so a blend between two keys reads as a
# regular texture rather than as noise.
let BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5]
let MARK = Canvas.rgba(255, 255, 255)

# --- canvas ------------------------------------------------------------------
# A grid of palette keys. Everything is drawn here, in cells, and expanded to
# pixels at the end — that is where the pixel-art grid comes from. A wrapping
# grid folds x modulo its width, so a scrolling layer's shapes meet themselves.
class Cells {
  new(w, h, wrap = false) {
    self.w = w
    self.h = h
    self.wrap = wrap
    self.k = repeat(w * h, 0)
    self.scratch = nil
  }

  id(key) {
    type_of(key) == "String" ? KEY_ID[key] : key
  }

  get(x, y) {
    mut xi = x.to_long()
    let yi = y.to_long()
    xi = Math.wrap(xi, self.w) if self.wrap
    xi >= 0 && xi < self.w && yi >= 0 && yi < self.h
      ? self.k[yi * self.w + xi]
      : 0
  }

  set(x, y, key) {
    mut xi = x.to_long()
    let yi = y.to_long()
    xi = Math.wrap(xi, self.w) if self.wrap
    if xi >= 0 && xi < self.w && yi >= 0 && yi < self.h {
      self.k[yi * self.w + xi] = self.id(key)
    }
  }

  # Ordered dither between two keys: `t` is how much of `key_b`, 0..1.
  mix(x, y, key_a, key_b, t) {
    let xi = x.to_long()
    let yi = y.to_long()
    let th = (BAYER[Math.wrap(yi, 4) * 4 + Math.wrap(xi, 4)] + 0.5) / 16.0
    self.set(xi, yi, t > th ? key_b : key_a)
  }

  rect(x, y, w, h, key) {
    let xs = x.to_long()..(x + w).to_long()
    let ys = y.to_long()..(y + h).to_long()
    for (xx, yy) in grid(xs, ys) {
      self.set(xx, yy, key)
    }
  }

  # Checkerboard between two keys.
  dither(x, y, w, h, key_a, key_b, size = 1) {
    let xs = x.to_long()..(x + w).to_long()
    let ys = y.to_long()..(y + h).to_long()
    for (xx, yy) in grid(xs, ys) {
      self.set(xx, yy, (xx / size + yy / size) % 2 == 0 ? key_a : key_b)
    }
  }

  # Vertical ramp through `stops`, each `[position 0..1, key]` ascending,
  # dithered between neighbouring stops.
  vgrad(x, y, w, h, stops) {
    for yy in y.to_long()..(y + h).to_long() {
      let t = (yy - y).to_float() / h
      mut i = 0
      while i < stops.size() - 2 && stops[i + 1][0] <= t {
        i += 1
      }
      let [p0, a] = stops[i]
      let [p1, b] = stops[i + 1]
      let f = Math.clamp((t - p0) / Math.max(0.0001, p1 - p0), 0.0, 1.0)
      for xx in x.to_long()..(x + w).to_long() {
        self.mix(xx, yy, a, b, f)
      }
    }
  }

  ellipse(cx, cy, rx, ry, key) {
    return nil if rx <= 0 || ry <= 0
    for yy in (cy - ry).to_long()..=(cy + ry).to_long() {
      # `.to_float()`: callers pass Longs as often as Floats, and `/` on two
      # Longs truncates — which would flatten the ellipse into a rectangle.
      let dy = (yy - cy).to_float() / ry
      continue if Math.abs(dy) > 1
      let half = rx * Math.sqrt(1 - dy * dy)
      for xx in (cx - half).to_long()..=(cx + half).to_long() {
        self.set(xx, yy, key)
      }
    }
  }

  circle(cx, cy, r, key) {
    self.ellipse(cx, cy, r, r, key)
  }

  # Shapes the Canvas rasterises for us — polygons, lines, text — are drawn
  # into a scratch sprite and copied back as keys. `draw` runs with the
  # scratch as the draw target; (x0, y0)-(x1, y1) bounds what it touched.
  raster(x0, y0, x1, y1, key, draw) {
    self.scratch ??= Canvas.Sprite.blank(self.w, self.h)
    let xs = Math.max(0, x0.to_long())..Math.min(self.w, x1.to_long() + 1)
    let ys = Math.max(0, y0.to_long())..Math.min(self.h, y1.to_long() + 1)
    Canvas.draw_to(self.scratch, fn () {
      Canvas.clear(0)
      draw()
      for (x, y) in grid(xs, ys) {
        self.set(x, y, key) if Canvas.get_pixel(x, y) != 0
      }
    })
  }

  # Filled polygon from a flat [x0, y0, x1, y1, ...] list. On a wrapping grid a
  # shape that crosses an edge is drawn again one width over.
  poly(points, key) {
    let xs = points
      .enumerate()
      .filter(|(i, _)| i % 2 == 0)
      .map(|(_, v)| v)
      .collect()
    let ys = points
      .enumerate()
      .filter(|(i, _)| i % 2 == 1)
      .map(|(_, v)| v)
      .collect()
    let shifts = self.wrap ? [0, -self.w, self.w] : [0]
    for dx in shifts {
      let x0 = xs.min() + dx
      let x1 = xs.max() + dx
      continue if x1 < 0 || x0 >= self.w
      let pts = points
        .enumerate()
        .map(|(i, v)| i % 2 == 0 ? v + dx : v)
        .collect()
      self.raster(x0, ys.min(), x1, ys.max(), key, || Canvas.polygon(pts, MARK))
    }
  }

  # A line `thick` cells wide: a quad along the segment (thin ones go
  # straight to the Canvas).
  line(x1, y1, x2, y2, key, thick = 1) {
    if thick <= 1 {
      let shifts = self.wrap ? [0, -self.w, self.w] : [0]
      for dx in shifts {
        let lo = Math.min(x1, x2) + dx
        let hi = Math.max(x1, x2) + dx
        continue if hi < 0 || lo >= self.w
        self.raster(
          lo,
          Math.min(y1, y2),
          hi,
          Math.max(y1, y2),
          key,
          || Canvas.line(x1 + dx, y1, x2 + dx, y2, MARK),
        )
      }
      return nil
    }
    let dx = (x2 - x1).to_float()
    let dy = (y2 - y1).to_float()
    let len = Math.max(0.001, Math.sqrt(dx * dx + dy * dy))
    let px = -dy / len * thick / 2.0
    let py = dx / len * thick / 2.0
    self.poly(
      [x1 + px, y1 + py, x2 + px, y2 + py, x2 - px, y2 - py, x1 - px, y1 - py],
      key,
    )
  }

  # The built-in 8x8 font, one cell per font pixel (times `scale`).
  text(s, x, y, key, scale = 1) {
    let w = Canvas.text_width(s, scale)
    self.raster(
      x,
      y,
      x + w,
      y + 8 * scale,
      key,
      || Canvas.text(s, x, y, MARK, scale),
    )
  }

  # One-cell border around everything drawn so far. Runs on a copy so the
  # border doesn't grow into itself.
  outline(key = "INK") {
    let src = self.k.slice(0, self.k.size())
    let kid = KEY_ID[key]
    for (x, y) in grid(0..self.w, 0..self.h) {
      continue if src[y * self.w + x] != 0
      mut touching = false
      for (dx, dy) in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
        let nx = x + dx
        let ny = y + dy
        if nx >= 0 && nx < self.w && ny >= 0 && ny < self.h {
          let v = src[ny * self.w + nx]
          if v != 0 && v != kid {
            touching = true
            break
          }
        }
      }
      self.k[y * self.w + x] = kid if touching
    }
  }

  # Shift every row above `pivot` sideways by `k` cells per row of height —
  # a car leaning into a turn.
  shear(pivot, k) {
    let src = self.k.slice(0, self.k.size())
    for (x, y) in grid(0..self.w, 0..self.h) {
      let d = y < pivot ? Math.round((pivot - y) * k) : 0
      let sx = x - d
      self.k[y * self.w + x] = sx >= 0 && sx < self.w ? src[y * self.w + sx] : 0
    }
  }

  # Replace every cell holding `from` (or in `froms`) that the predicate
  # accepts — the way facets and textures get their tone after the fact.
  recolor(froms, f) {
    let ids = froms.map(|k| self.id(k)).to_set()
    for (x, y) in grid(0..self.w, 0..self.h) {
      let v = self.k[y * self.w + x]
      continue if !ids.contains(v)
      let nk = f(x, y, v)
      self.k[y * self.w + x] = self.id(nk) if nk != nil
    }
  }
}

# A full-resolution buffer of palette keys — the atlas under construction.
class KeyImage {
  new(w, h) {
    self.w = w
    self.h = h
    self.k = repeat(w * h, 0)
  }

  # Expand `cells` by `scale` and drop it at (x, y), cropped to w x h.
  blit_cells(cells, x, y, w, h, scale) {
    for py in 0..h {
      let cy = py / scale
      break if cy >= cells.h
      let row = cy * cells.w
      let base = (y + py) * self.w + x
      for px in 0..w {
        let cx = px / scale
        break if cx >= cells.w
        let v = cells.k[row + cx]
        self.k[base + px] = v if v != 0
      }
    }
  }
}

# --- background --------------------------------------------------------------
# Three 1280x480 layers at the atlas rectangles common.js names. Each scrolls
# horizontally at its own rate and wraps. The road's vanishing point is
# HORIZON, so everything worth looking at sits above it; below it the layers
# are filled solid, which only shows when the road dips.
let BG_CELL = 2          # one drawn cell = 2x2 pixels
let LW = 1280 / BG_CELL  # 640 cells across
let LH = 480 / BG_CELL   # 240 cells down
let HORIZON = LH / 2

# Smooth periodic noise over the layer width: values on a lattice `spacing`
# cells apart (which must divide LW), interpolated between.
fn pnoise(x, spacing, seed) {
  if LW % spacing != 0 {
    throw {
      kind: "ValueError",
      message: "spacing {spacing} does not divide the layer width",
    }
  }
  let n = LW / spacing
  let fx = x.to_float() / spacing
  let i = Math.floor(fx)
  let f = fx - i
  let s = f * f * (3 - 2 * f)
  let a = noise(Math.wrap(i, n), seed)
  let b = noise(Math.wrap(i + 1, n), seed)
  a + (b - a) * s
}

# Noise folded into a ridge: 0 in the valleys, sharp 1s at the peaks.
fn ridge(v) {
  1 - Math.abs(2 * v - 1)
}

let SUN_X = LW * 0.72
let SUN_Y = 62
let SUN_R = 12

fn draw_sky(c) {
  c.vgrad(
    0,
    0,
    LW,
    HORIZON,
    [
      [0.0, "SKY0"],
      [0.22, "SKY1"],
      [0.42, "SKY2"],
      [0.60, "SKY3"],
      [0.76, "SKY4"],
      [0.90, "SKY5"],
      [1.0, "HAZE"],
    ],
  )
  c.rect(0, HORIZON, LW, LH - HORIZON, "HAZE")

  # Cumulus: a band of big ones low over the mountains, smaller ones higher
  # up, and a few wisps near the top.
  for i in 0..4 {
    let cx = i * LW / 4.0 + noise(i, 21) * 60
    let cy = 62 + noise(i, 22) * 14
    let w = 60 + noise(i, 23) * 40
    cloud(c, cx, cy, w, w * (0.30 + noise(i, 24) * 0.1), i)
  }
  for i in 0..7 {
    let cx = (i + 0.5) * LW / 7.0 + noise(i, 31) * 50
    let cy = 22 + noise(i, 32) * 26
    let w = 22 + noise(i, 33) * 22
    cloud(c, cx, cy, w, w * 0.32, 10 + i)
  }
  for i in 0..6 {
    let cx = (i + 0.3) * LW / 6.0 + noise(i, 41) * 60
    let cy = 6 + noise(i, 42) * 14
    let w = 8 + noise(i, 43) * 10
    cloud(c, cx, cy, w, w * 0.3, 20 + i)
  }

  # The sun, in front of the clouds the way a flat sky sprite has it: a disc
  # in a dithered glow that fades into whatever is there.
  for (
    x,
    y,
  ) in grid((SUN_X - SUN_R * 2.2).to_long()..(SUN_X + SUN_R * 2.2).to_long(), SUN_Y - SUN_R * 2..SUN_Y + SUN_R * 2 + 1) {
    let d = Math.sqrt((x - SUN_X) * (x - SUN_X) +
      (y - SUN_Y) * (y - SUN_Y).to_float())
    continue if d > SUN_R * 2.2
    c.mix(
      x,
      y,
      c.get(x, y),
      "SUN_GLOW",
      1 - (d - SUN_R) / (SUN_R * 1.2),
    ) if d > SUN_R
  }
  c.circle(SUN_X, SUN_Y, SUN_R, "SUN")
}

# A cumulus: lumps along the top over a flat base, lit from above so each
# column shades from white at its own top down to a dark underside.
fn cloud(c, cx, cy, w, h, seed) {
  let base = (cy + h * 0.5).to_long()
  let n = 3 + (w / 16).to_long()
  let lumps = iota(n).map(fn (i) {
    let lx = cx - w / 2 + (i + 0.5) * w / n
    let edge = i == 0 || i == n - 1 ? 0.7 : 1.0
    let r = h * (0.5 + 0.4 * noise(seed, i, 1)) * edge
    let ly = base - r * (0.5 + 0.35 * noise(seed, i, 2))
    [lx, ly, r]
  })
  let x0 = (cx - w / 2 - h).to_long()
  let x1 = (cx + w / 2 + h).to_long()
  mut top = repeat(x1 - x0 + 1, base)
  for [lx, ly, r] in lumps {
    for xx in (lx - r).to_long()..=(lx + r).to_long() {
      continue if xx < x0 || xx > x1
      let dx = (xx - lx).to_float() / r
      continue if Math.abs(dx) > 1
      let ty = ly - r * Math.sqrt(1 - dx * dx)
      top[xx - x0] = Math.min(top[xx - x0], ty.to_long())
    }
  }
  for xx in x0..=x1 {
    let t0 = top[xx - x0]
    continue if t0 >= base
    let hh = (base - t0).to_float()
    for yy in t0..base {
      let t = (yy - t0) / hh
      match t {
        ..0.45 => c.set(xx, yy, "CLOUD_L"),
        ..0.7 => c.mix(xx, yy, "CLOUD_L", "CLOUD_M", (t - 0.45) / 0.25),
        ..0.88 => c.set(xx, yy, "CLOUD_M"),
        _ => c.mix(xx, yy, "CLOUD_M", "CLOUD_D", (t - 0.88) / 0.12 + 0.3),
      }
    }
  }
}

# Two mountain ridges over a strip of sea and sand. Faces that look toward
# the sun (it sits to the right) take the lit tone, the others the shade.
let SEA_TOP = HORIZON - 20
let SAND_TOP = HORIZON - 4

fn draw_hills(c) {
  # Each ridge is a smooth profile (which decides the shading) plus fine
  # detail (which only roughens the outline).
  let far_base = fn (x) {
    HORIZON - 46 - 24 * pnoise(x, 160, 1)
  }
  let far = fn (x) {
    far_base(x) - 8 * pnoise(x, 40, 2)
  }
  let near_base = fn (x) {
    HORIZON -
      24 -
      44 * ridge(pnoise(x, 80, 3)) * (0.5 + 0.5 * pnoise(x, 320, 5))
  }
  let near = fn (x) {
    near_base(x) - 6 * pnoise(x, 16, 4)
  }
  for x in 0..LW {
    for (
      f,
      base,
      lit,
      dark,
    ) in [(far, far_base, "MTN_FAR_L", "MTN_FAR_D"), (near, near_base, "MTN_L", "MTN_D")] {
      let top = f(x)
      # y grows downward, so a positive slope is a face turned to the right,
      # toward the sun. Three tones only: lit, shade, and a dithered mix for
      # the near-level ground between.
      let slope = base(x + 4) - base(x - 4)
      let t = cond {
        slope > 1.2 => 1.0,
        slope < -1.2 => 0.0,
        _ => 0.5,
      }
      for y in top.to_long()..SEA_TOP {
        c.mix(x, y, dark, lit, t)
      }
    }
    # Snow on the tall peaks of the near ridge, thinning downward.
    let top = near(x)
    let cap = HORIZON - 50
    if top < cap {
      for y in top.to_long()..cap {
        c.mix(x, y, c.get(x, y), "MTN_SNOW", 1.1 - (y - top) / (cap - top))
      }
    }
  }
  # The sea: dark water under short light streaks that gather toward the
  # shore, sparkles where the sun sits, a foam line, then sand.
  c.rect(0, SEA_TOP, LW, SAND_TOP - SEA_TOP, "SEA_D")
  for (x, y) in grid(0..LW, SEA_TOP..SAND_TOP) {
    let near_shore = (y - SEA_TOP).to_float() / (SAND_TOP - SEA_TOP)
    let streak = pnoise(x, 4, 40 + y) * (0.4 + 0.6 * pnoise(x, 32, 60 + y))
    let sparkle = Math.abs(x - SUN_X) < 30 && noise(x, y, 8) < 0.25
    c.set(x, y, "SEA_L") if streak > 0.66 - near_shore * 0.2 || sparkle
    c.set(x, y, "FOAM") if sparkle && noise(x, y, 9) < 0.5
    c.set(x, y, "FOAM") if y == SAND_TOP - 1 && pnoise(x, 4, 70) > 0.4
  }
  c.rect(0, SAND_TOP, LW, LH - SAND_TOP, "SAND")
  c.dither(0, SAND_TOP, LW, 1, "SAND", "FOAM")
}

# A palm: a bending ringed trunk under a crown of arching fronds. `hgt` sets
# the size; everything else is proportional, so the tree line, the big
# roadside sprite and a billboard's icon are the same routine. `reach` is a
# frond's length against the height, `lean` how far over the crown sits (a
# little either way, by the seed, unless given), and `squash` narrows the
# crown's spread for a sprite with no room for all of it.
#
# `bark` (dark, mid, light) shades the trunk as a cylinder of overlapping leaf
# scars; without it the rings are flat bands, which is all the distant tree
# line has room for.
fn palm(
  c,
  bx,
  by,
  hgt,
  seed,
  tones,
  bark_tones = nil,
  lean = nil,
  reach = 0.26,
  squash = 1.0,
) {
  let (trunk_d, trunk_l, leaf_d, leaf_m, leaf_l, nut) = tones
  let tilt = lean ?? (noise(seed, 1) - 0.5) * 0.5
  let tw = Math.max(1.0, hgt * 0.04)
  let th = hgt * 0.72
  let band = Math.max(2, (hgt * 0.03).to_long())
  for i in 0..=th.to_long() {
    let t = i / th
    let x = bx + tilt * hgt * t * t
    let half = tw * (1 - 0.4 * t)
    if bark_tones == nil {
      let light = (i / band) % 2 == 0
      c.rect(x - half, by - i, half * 2 + 1, 1, light ? trunk_l : trunk_d)
      c.rect(x - half, by - i, Math.max(1.0, half * 0.7), 1, trunk_d) if light
      continue
    }
    for xx in (x - half).to_long()..=(x + half).to_long() {
      let u = Math.clamp((xx + 0.5 - x) / half, -1.0, 1.0)
      # Each scar's upper face catches the light and throws the band below it
      # into shadow; a ring above eye level shows its near side higher.
      let ring = (i - (1 - u * u) * band * 0.3) / band
      let p = ring - Math.floor(ring)
      let lift = cond {
        p < 0.22 => 0.3,
        p > 0.8 => -0.35,
        _ => 0.0,
      }
      bark(c, xx, by - i, u, i, half, bark_tones, seed, false, lift)
    }
  }
  let cx = bx + tilt * hgt
  let cy = by - th
  let len = hgt * reach
  # Dead fronds hang brown against the trunk, under the live crown.
  for i in 0..3 {
    let az = Math.pi * (0.25 + 0.25 * i) + (noise(seed, i, 6) - 0.5) * 0.5
    frond(
      c,
      cx,
      cy,
      az,
      -1.1,
      len * 0.7,
      0.2,
      (trunk_d, trunk_d, trunk_l),
      seed * 31 + i,
      squash,
    )
  }
  # Three tiers staggered round the crown: young fronds standing up, the
  # spreading ones, and old ones sagging beneath.
  let tiers = [(3, 0.95, 0.6), (6, 0.55, 1.0), (6, 0.1, 0.95)]
  mut fronds = []
  for tier in 0..tiers.size() {
    let (count, rise, size) = tiers[tier]
    for i in 0..count {
      let k = tier * 10 + i
      fronds.push({
        az: 2 * Math.pi * (i + 0.5 * tier + 0.35 * noise(seed, k, 2)) / count,
        rise: rise + (noise(seed, k, 3) - 0.5) * 0.3,
        len: len * size * (0.85 + 0.3 * noise(seed, k, 4)),
        sag: 0.35 + 0.2 * tier + 0.25 * noise(seed, k, 5),
        seed: seed * 31 + 7 + k,
      })
    }
  }
  # The far side first, in shade; the nuts hang over it, then the near side.
  mut nuts = false
  for f in fronds.sorted_by(|g| Math.sin(g.az)) {
    let depth = Math.sin(f.az)
    if depth >= 0 && !nuts {
      crown_nuts(c, cx, cy, hgt, leaf_d, nut, trunk_l)
      nuts = true
    }
    let shades = cond {
      depth < -0.35 => (leaf_d, leaf_d, leaf_m),
      depth < 0.35 && f.rise < 0.7 => (leaf_m, leaf_d, leaf_m),
      _ => (leaf_l, leaf_m, leaf_l),
    }
    frond(c, cx, cy, f.az, f.rise, f.len, f.sag, shades, f.seed, squash)
  }
}

# The boss the fronds leave from, and a cluster of nuts hanging under it.
fn crown_nuts(c, cx, cy, hgt, boss, nut, shine) {
  c.circle(cx, cy, Math.max(1.5, hgt * 0.03), boss)
  let r = Math.max(1.0, hgt * 0.016)
  for i in 0..4 {
    let nx = cx + (i - 1.5) * r * 1.5
    let ny = cy + r * (1.2 + 0.6 * (i % 2))
    c.circle(nx, ny, r, nut)
    c.set(nx - r * 0.4, ny - r * 0.4, shine) if r >= 2
  }
}

# One frond: a midrib leaving the crown heading `az` round it (0 is to the
# right, a quarter turn is toward the viewer) at `rise` above level, arching
# down by `sag` under its own weight. Leaflets hang off both sides, drooping,
# longest a third of the way out and ragged where a few have gone; on a big
# frond every other one is left out, so each reads on its own. `shades` is
# the midrib, the leaflets under it, and those over it that catch the light;
# `squash` narrows the frond's sideways reach.
fn frond(c, cx, cy, az, rise, len, sag, shades, seed, squash = 1.0) {
  let (rib, under, over) = shades
  let hx = Math.cos(az) * Math.cos(rise) * squash
  let vy = -Math.sin(rise)
  let steps = Math.max(8, (len * 1.2).to_long())
  let at = |p| (cx + hx * len * p, cy + (vy * p + sag * p * p) * len)
  # The side under the midrib first, so the lit one lies over it.
  for upper in [false, true] {
    for j in 0..=steps {
      let u = j.to_float() / steps
      continue if u < 0.06 || noise(seed, j, upper ? 1 : 0, 2) < 0.08
      continue if len > 30 && j % 2 == 1
      let dy = vy + 2 * sag * u
      let d = Math.max(0.001, Math.sqrt(hx * hx + dy * dy))
      let tx = hx / d
      let ty = dy / d
      let s = (tx >= 0) == upper ? -1 : 1
      let px = -ty * s
      let py = tx * s
      let size = len *
        0.18 *
        Math.sin(Math.pi * Math.exp(0.7 * Math.log(u))) *
        (0.75 + 0.35 * noise(seed, j, s, 1))
      continue if size < 1
      let (fx, fy) = at(u)
      let mx = fx + (px * 0.75 + tx * 0.35) * size * 0.55
      let my = fy + (py * 0.75 + ty * 0.35 + 0.2) * size * 0.55
      let ex = mx + (px * 0.45 + tx * 0.3) * size * 0.5
      let ey = my + (py * 0.45 + ty * 0.3 + 0.55) * size * 0.5
      plot_line(c, fx, fy, mx, my, upper ? over : under)
      plot_line(c, mx, my, ex, ey, upper ? over : under)
    }
  }
  for j in 0..=steps {
    let (fx, fy) = at(j.to_float() / steps)
    c.set(fx, fy, rib)
  }
}

# A one-cell line stepped cell by cell, for strokes too many and too small to
# go through the Canvas rasteriser.
fn plot_line(c, x0, y0, x1, y1, key) {
  let n = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0)).to_long() + 1
  for i in 0..=n {
    let t = i.to_float() / n
    c.set(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t, key)
  }
}

# The tree line: palms along the shore with scrub between them, on a strip
# of grass. Gaps are deliberate — the sea and the ridges show through them.
fn draw_trees(c) {
  c.rect(0, HORIZON - 3, LW, LH - HORIZON + 3, "GROUND")
  c.dither(0, HORIZON - 3, LW, 1, "GROUND", "SAND")
  for i in 0..14 {
    let x = i * LW / 14.0 + noise(i, 51) * 30
    let y = HORIZON - 3
    for j in 0..3 {
      let w = 4 + noise(i, j, 52) * 6
      let h = 3 + noise(i, j, 53) * 4
      let ox = x + (j - 1) * w * 1.2
      c.ellipse(ox, y, w, h, "TREE_D")
      c.ellipse(ox - w * 0.2, y - h * 0.3, w * 0.5, h * 0.5, "TREE_M")
      c.set(ox - w * 0.4, y - h * 0.7, "TREE_L")
    }
  }
  for i in 0..10 {
    let x = i * LW / 10.0 + noise(i, 61) * 40
    let hgt = 56 + noise(i, 62) * 34
    palm(
      c,
      x,
      HORIZON - 2,
      hgt,
      100 + i,
      ("TRUNK_D", "TRUNK_L", "TREE_D", "TREE_M", "TREE_L", "TRUNK_D"),
    )
  }
}

# A scrolling layer meets its own left edge. Column 0 and column LW-1 are
# neighbours once it wraps, so a shape that changes abruptly across that join
# is a seam. Allow a little change — real detail differs column to column —
# but not more than two neighbouring interior columns do.
fn check_wraps(name, cells) {
  let diff = fn (a, b) {
    iota(cells.h).filter(|y| cells.get(a, y) != cells.get(b, y)).size()
  }
  let seam = diff(LW - 1, 0)
  let interior = iota(1, LW - 2).map(|x| diff(x, x + 1)).max()
  if seam > interior {
    throw {
      kind: "ValueError",
      message: "{name} does not wrap: {seam} cells change across the " +
        "seam, at most {interior} change between interior columns",
    }
  }
}

# Draw all three layers once, into keys. Returns the atlas.
fn build_background() {
  mut img = KeyImage(atlas.BG_W, atlas.BG_H)
  for (
    name,
    draw,
  ) in [("SKY", draw_sky), ("HILLS", draw_hills), ("TREES", draw_trees)] {
    mut cells = Cells(LW, LH, true)
    draw(cells)
    check_wraps(name, cells)
    let [x, y, w, h] = atlas.BACKGROUND[name]
    img.blit_cells(cells, x, y, w, h, BG_CELL)
  }
  img
}

# --- sprites -----------------------------------------------------------------
# The atlas rectangles are the contract (see atlas.cul); this file only draws
# inside them.

# Pixels per drawn cell. Vehicles are already at pixel-art size and draw one
# cell per pixel; the roadside scenery is drawn at half resolution so it
# reads at the same chunkiness once the game scales it.
fn cell_scale(w, h) {
  Math.max(w, h) <= 150 ? 1 : 2
}

# A checkerboard of shadow under a sprite, drawn last so the outline pass
# does not border every dot.
fn ground_shadow(c, cx, cy, rx, ry) {
  for yy in (cy - ry).to_long()..=(cy + ry).to_long() {
    let dy = (yy - cy).to_float() / ry
    continue if Math.abs(dy) > 1
    let half = rx * Math.sqrt(1 - dy * dy)
    for xx in (cx - half).to_long()..=(cx + half).to_long() {
      c.set(xx, yy, "SHADOW") if (xx + yy) % 2 == 0 && c.get(xx, yy) == 0
    }
  }
}

# One cell of a round stem lit from the upper left. `u` runs across the stem
# (-1 at the left edge, 1 at the right), `v` along it in cells, `half` is the
# half-width in cells. The cross-section gives a Lambert term, the shadow edge
# gets a little bounce light back, `lift` brightens or darkens on top (a
# palm's rings), and bark adds furrows: two-cell columns broken into staggered
# runs, so they read as bark rather than stripes.
fn bark(c, x, y, u, v, half, tones, seed, fissures = true, lift = 0.0) {
  let (d, m, l) = tones
  mut light = -0.6 * u + 0.8 * Math.sqrt(Math.max(0.0, 1 - u * u)) + lift
  light += 0.18 if u > 0.75
  if fissures {
    let col = ((u + 1) * half / 2.0).to_long()
    let run = ((v + noise(seed, col, 23) * 9) / 9).to_long()
    light -= 0.32 if noise(seed, col, run, 22) < 0.35
  }
  cond {
    light > 0.9 => c.set(x, y, l),
    light > 0.7 => c.mix(x, y, m, l, (light - 0.7) / 0.2),
    light > 0.45 => c.set(x, y, m),
    light > 0.2 => c.mix(x, y, d, m, (light - 0.2) / 0.25),
    _ => c.set(x, y, d),
  }
}

# A tapering stem from (x0, y0) to (x1, y1), shaded as a cylinder. The far
# end is rounded, so a limb that carries on at an angle joins without a notch.
fn trunk(c, x0, y0, x1, y1, w0, w1, tones, fissures = true) {
  let len = Math.max(
    0.001,
    Math.sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0)),
  )
  let tx = (x1 - x0) / len
  let ty = (y1 - y0) / len
  # The normal that points right on screen, so -u is always the lit side.
  let flip = ty > 0 || ty == 0 && tx < 0
  let nx = flip ? ty : -ty
  let ny = flip ? -tx : tx
  let r = Math.max(w0, w1) / 2.0 + 1
  let seed = noise(x0, y0, x1, y1) * 100000
  for yy in (Math.min(y0, y1) - r).to_long()..=(Math.max(y0, y1) + r).to_long() {
    for xx in (Math.min(x0, x1) - r).to_long()..=(Math.max(x0, x1) + r).to_long() {
      let px = xx + 0.5 - x0
      let py = yy + 0.5 - y0
      let along = px * tx + py * ty
      continue if along < 0
      let half = Math.max(
        0.6,
        (w0 + (w1 - w0) * Math.min(1.0, along / len)) / 2.0,
      )
      let d = px * nx + py * ny
      let past = Math.max(0.0, along - len)
      continue if d * d + past * past > half * half
      bark(c, xx, yy, d / half, along, half, tones, seed, fissures)
    }
  }
}

# Fine foliage: a scatter of small leaf strokes over an ellipse, dense in the
# middle and thinning to a ragged edge, lit from the upper left; `hang` lets
# the lower ones droop below it. No outline goes over these — bordering every
# leaf would fill the gaps in — so the wood is outlined before the leaves go on.
fn foliage(c, cx, cy, rx, ry, n, seed, tones, hang = 0.0, stroke = 2.5) {
  for i in 0..n {
    let a = noise(seed, i, 1) * 2 * Math.pi
    let d = Math.sqrt(noise(seed, i, 2))
    let px = cx + Math.cos(a) * d * rx
    let py = cy + Math.sin(a) * d * ry + hang * ry * noise(seed, i, 5)
    let lit = (cy - py) / ry * 0.6 -
      (px - cx) / rx * 0.4 +
      (noise(seed, i, 3) - 0.5) * 0.9
    let tone = tones[cond {
      lit > 0.35 => 2,
      lit > -0.3 => 1,
      _ => 0,
    }]
    let len = (noise(seed, i, 4) * stroke).to_long()
    let dir = noise(seed, i, 6) < 0.5 ? 1 : -1
    for k in 0..=len {
      c.set(px + k * dir, py + k, tone)
    }
  }
}

let WOOD = ("WOOD0", "WOOD1", "WOOD2")
let BARK = ("WHITE0", "WHITE1", "WHITE2")

# A birch: a slim white trunk marked with dark lenticels, leaders that bend
# outward, and light hanging foliage that lets the branches show through.
fn draw_birch(c, w, h, seed) {
  let bx = w * 0.5
  let by = h * 0.98
  let fork = h * 0.5
  let fx = bx + w * 0.02
  trunk(c, bx, by, fx, fork, w * 0.085, w * 0.05, BARK)
  let tips = [
    [bx - w * 0.3, h * 0.14],
    [bx - w * 0.06, h * 0.03],
    [bx + w * 0.16, h * 0.06],
    [bx + w * 0.34, h * 0.18],
  ]
  for (i, [tx, ty]) in tips.enumerate() {
    let mx = fx + (tx - fx) * 0.45 + (noise(seed, i) - 0.5) * w * 0.08
    let my = fork - (fork - ty) * 0.5
    trunk(c, fx, fork + 2, mx, my, w * 0.045, w * 0.03, BARK)
    trunk(c, mx, my, tx, ty, w * 0.03, w * 0.012, BARK)
    c.line(mx, my, mx + (tx - bx) * 0.5, my - h * 0.1, "WHITE0", 1)
    c.line(tx, ty, tx + (tx - bx) * 0.3, ty + h * 0.08, "WHITE0", 1)
  }
  c.outline()
  for j in 0..12 {
    let y = fork + (by - fork) * (0.08 + 0.85 * noise(seed, j, 9))
    let t = (by - y) / (by - fork)
    let half = w * 0.0425 * (1 - 0.4 * t)
    let x = bx + w * 0.02 * t - half + 1
    c.rect(
      x + half * noise(seed, j, 11),
      y,
      half * (0.5 + noise(seed, j, 10) * 0.7),
      1,
      "INK",
    )
  }
  let tones = ["LEAF1", "LEAF2", "LEAF3"]
  for (i, [tx, ty]) in tips.enumerate() {
    foliage(
      c,
      tx,
      ty + h * 0.07,
      w * 0.19,
      h * 0.14,
      900,
      seed * 11 + i,
      tones,
      0.9,
      3.0,
    )
    foliage(
      c,
      (tx + fx) / 2,
      (ty + fork) / 2,
      w * 0.14,
      h * 0.11,
      500,
      seed * 13 + i,
      tones,
      0.9,
      3.0,
    )
  }
  ground_shadow(c, bx, by, w * 0.36, h * 0.03)
}

# A cherry: a dark trunk fanning into branches, each tip in a cloud of
# blossom fine enough for the wood to show between.
fn draw_cherry(c, w, h, seed) {
  let bx = w * 0.5
  let by = h * 0.98
  let fork = h * 0.56
  let fx = bx - w * 0.03
  trunk(c, bx, by, fx, fork, w * 0.11, w * 0.06, WOOD)
  let tips = [
    [bx - w * 0.42, h * 0.3],
    [bx - w * 0.22, h * 0.1],
    [bx + w * 0.04, h * 0.05],
    [bx + w * 0.26, h * 0.1],
    [bx + w * 0.44, h * 0.28],
  ]
  for (i, [tx, ty]) in tips.enumerate() {
    let mx = fx + (tx - fx) * 0.5 + (noise(seed, i) - 0.5) * w * 0.06
    let my = fork - (fork - ty) * 0.55
    trunk(c, fx, fork + 2, mx, my, w * 0.05, w * 0.03, WOOD)
    trunk(c, mx, my, tx, ty, w * 0.03, w * 0.012, WOOD)
    c.line(mx, my, mx + (tx - bx) * 0.3, my - h * 0.12, "WOOD0", 1)
  }
  c.outline()
  let tones = ["BLOSSOM_D", "BLOSSOM_L", "P_WHITE"]
  for (i, [tx, ty]) in tips.enumerate() {
    foliage(
      c,
      tx,
      ty + h * 0.03,
      w * 0.18,
      h * 0.14,
      650,
      seed * 11 + i,
      tones,
      0.5,
      1.4,
    )
    foliage(
      c,
      (tx + fx) / 2,
      (ty + fork) / 2,
      w * 0.13,
      h * 0.1,
      320,
      seed * 13 + i,
      tones,
      0.5,
      1.4,
    )
  }
  ground_shadow(c, bx, by, w * 0.36, h * 0.03)
}

# A bare tree: limbs that fork, thin, and bend toward the light.
fn draw_dead_tree(c, w, h, seed) {
  fn branch(x, y, angle, len, thick, depth, s) {
    let x1 = x + Math.cos(angle) * len
    let y1 = y + Math.sin(angle) * len
    if thick >= 2.5 {
      trunk(c, x, y, x1, y1, thick, thick * 0.6, WOOD)
    } else {
      c.line(x, y, x1, y1, "WOOD0", thick)
    }
    return nil if depth == 0
    let n = depth >= 3 ? 3 : 2
    for i in 0..n {
      let spread = 0.35 + 0.45 * noise(seed, s, i, 1)
      let da = (i.to_float() / (n - 1) - 0.5) * 2 * spread +
        (noise(seed, s, i, 2) - 0.5) * 0.4
      branch(
        x1,
        y1,
        angle + da,
        len * (0.62 + 0.18 * noise(seed, s, i, 3)),
        thick * 0.6,
        depth - 1,
        s * 3 + i,
      )
    }
  }
  branch(
    w * 0.5,
    h * 0.99,
    -Math.pi / 2 + (noise(seed, 5) - 0.5) * 0.2,
    h * 0.3,
    w * 0.13,
    4,
    1,
  )
  c.outline()
  ground_shadow(c, w * 0.5, h * 0.98, w * 0.3, h * 0.02)
}

# The roadside palm leans its crown to the middle of the sprite, so no frond
# is cut off at either edge.
fn draw_palm_sprite(c, w, h, seed) {
  let foot = w * 0.36
  palm(
    c,
    foot,
    h * 0.97,
    h * 0.96,
    seed,
    ("WOOD0", "WOOD2", "LEAF1", "LEAF2", "LEAF3", "WOOD1"),
    WOOD,
    w * 0.14 / (h * 0.96),
    0.24,
    0.85,
  )
  # A tuft of grass at the foot.
  for i in 0..7 {
    let gx = foot + (i - 3) * w * 0.05
    c.line(
      gx,
      h * 0.98,
      gx + (i - 3) * w * 0.03,
      h * 0.92 - noise(seed, i) * h * 0.03,
      "LEAF1",
      1,
    )
  }
  c.outline()
  ground_shadow(c, foot, h * 0.98, w * 0.3, h * 0.012)
}

# A shrub: stems fanning up from the foot under a mound of fine leaves.
fn draw_bush(c, w, h, seed, flowers = false) {
  for i in 0..5 {
    c.line(
      w * 0.5 + (i - 2) * w * 0.03,
      h * 0.95,
      w * (0.2 + 0.6 * i / 4.0),
      h * (0.3 + 0.2 * noise(seed, i)),
      "WOOD0",
      1,
    )
  }
  c.outline()
  foliage(
    c,
    w * 0.5,
    h * 0.56,
    w * 0.46,
    h * 0.36,
    2600,
    seed,
    ["LEAF1", "LEAF2", "LEAF3"],
    0.2,
    3.0,
  )
  if flowers {
    for i in 0..60 {
      let fx = w * (0.08 + 0.84 * noise(seed, i, 7))
      let fy = h * (0.2 + 0.6 * noise(seed, i, 8))
      continue if c.get(fx, fy) == 0
      c.set(fx, fy, noise(seed, i, 9) < 0.6 ? "FLOWER" : "P_WHITE")
      c.set(fx + 1, fy, "BLOSSOM_L")
    }
  }
  ground_shadow(c, w * 0.5, h * 0.94, w * 0.44, h * 0.05)
}

# A prickly pear: pads growing off each other, each a thick disc turned a
# little outward and lit from the upper left, darker round its rim where it
# stands over the pad behind. The areoles sit on a staggered lattice, each a
# dark pit with a pale tuft and some with a spine; fruit crowd the top edges,
# and one flower has opened.
fn draw_cactus(c, w, h, seed) {
  let ramp = ["CACT0", "CACT_D", "CACT_L", "CACT3"]
  let pads = [
    [0.50, 0.78, 0.17, 0.20],
    [0.32, 0.60, 0.15, 0.19],
    [0.68, 0.58, 0.15, 0.18],
    [0.16, 0.36, 0.13, 0.17],
    [0.46, 0.40, 0.13, 0.17],
    [0.84, 0.36, 0.12, 0.16],
    [0.30, 0.18, 0.11, 0.14],
    [0.66, 0.20, 0.11, 0.14],
  ]
  c.rect(w * 0.47, h * 0.84, w * 0.06, h * 0.12, "WOOD1")  # the woody stem
  c.rect(w * 0.47, h * 0.84, 1, h * 0.12, "WOOD0")
  for [px, py, rx, ry] in pads.sorted_by(|p| -p[1]) {
    let ox = w * px
    let oy = h * py
    let ax = w * rx
    let ay = h * ry
    let tilt = (px - 0.5) * 0.9
    let ca = Math.cos(tilt)
    let sa = Math.sin(tilt)
    let id = (px * 100 + py * 10).to_long()
    let span = Math.max(ax, ay)
    let xs = (ox - span).to_long()..=(ox + span).to_long()
    let ys = (oy - span).to_long()..=(oy + span).to_long()
    for (x, y) in grid(xs, ys) {
      let dx = x + 0.5 - ox
      let dy = y + 0.5 - oy
      let nx = (dx * ca + dy * sa) / ax
      let ny = (dy * ca - dx * sa) / ay
      let r2 = nx * nx + ny * ny
      continue if r2 > 1
      # The pad's face turned back to the screen, for the light.
      let sx = nx * ca - ny * sa
      let sy = nx * sa + ny * ca
      mut light = 0.58 - 0.26 * sx - 0.34 * sy + 0.14 * (1 - r2)
      light -= 0.32 if r2 > 0.82
      light += 0.14 * (smooth_noise(seed + id, x, y, 4) - 0.5)
      ramp_tone(c, x, y, light, ramp)
    }
    for (i, j) in grid(-3..=3, -3..=3) {
      let lx = (i + Math.wrap(j, 2) * 0.5) * ax * 0.34
      let ly = j * ay * 0.3
      let q = (lx / ax) * (lx / ax) + (ly / ay) * (ly / ay)
      continue if q > 0.6
      let pit_x = ox + lx * ca - ly * sa
      let pit_y = oy + lx * sa + ly * ca
      c.set(pit_x, pit_y, "CACT0")
      c.set(pit_x - 1, pit_y - 1, "CREAM1")
      continue if noise(seed, id, i, j) < 0.45
      let d = Math.max(0.001, Math.sqrt(lx * lx + ly * ly))
      let ux = q < 0.02 ? 0.0 : (lx * ca - ly * sa) / d
      let uy = q < 0.02 ? -1.0 : (lx * sa + ly * ca) / d
      plot_line(
        c,
        pit_x + ux,
        pit_y + uy,
        pit_x + ux * 2,
        pit_y + uy * 2,
        "CREAM2",
      )
    }
  }
  # Fruit along the top of the upper pads; on one of them, a flower.
  for [px, py, rx, ry] in pads.filter(|p| p[1] < 0.45) {
    let tilt = (px - 0.5) * 0.9
    let count = py < 0.3 ? 3 : 2
    for k in 0..count {
      let a = -Math.pi / 2 + (k - (count - 1) / 2.0) * 0.62
      let lx = w * rx * Math.cos(a)
      let ly = h * ry * Math.sin(a)
      let fx = w * px + lx * Math.cos(tilt) - ly * Math.sin(tilt)
      let fy = h * py + lx * Math.sin(tilt) + ly * Math.cos(tilt) - 1.5
      if px < 0.2 && k == 0 {
        pear_flower(c, fx, fy - 1)
      } else {
        pear_fruit(c, fx, fy)
      }
    }
  }
  c.outline()
  ground_shadow(c, w * 0.5, h * 0.96, w * 0.42, h * 0.05)
}

# A prickly pear's fruit: an egg lit from the upper left, a pit at its top.
fn pear_fruit(c, fx, fy) {
  let xs = (fx - 3).to_long()..=(fx + 3).to_long()
  let ys = (fy - 4).to_long()..=(fy + 4).to_long()
  for (x, y) in grid(xs, ys) {
    let nx = (x + 0.5 - fx) / 2.4
    let ny = (y + 0.5 - fy) / 3.4
    let r2 = nx * nx + ny * ny
    continue if r2 > 1
    let light = 0.62 - 0.3 * nx - 0.3 * ny + 0.2 * (1 - r2)
    ramp_tone(c, x, y, light, ["RED0", "PINK0", "PINK1", "PINK2"])
  }
  c.set(fx, fy - 3, "RED0")
  c.set(fx - 1, fy + 1, "CREAM1")
}

# An opened flower: petals round a darker heart.
fn pear_flower(c, fx, fy) {
  c.circle(fx, fy, 3.2, "YELLOW0")
  c.circle(fx - 0.4, fy - 0.4, 2.6, "YELLOW1")
  c.circle(fx - 0.8, fy - 0.8, 1.2, "YELLOW2")
  c.set(fx, fy, "ORANGE1")
}

# A stump: bark on the flank, rings on the cut, roots at the foot.
fn draw_stump(c, w, h, seed) {
  let top = h * 0.34
  let bottom = h * 0.9
  let ry = h * 0.14
  for y in top.to_long()..bottom.to_long() {
    let half = w * (0.28 + 0.04 * (y - top) / (bottom - top))
    for x in (w * 0.5 - half).to_long()..=(w * 0.5 + half).to_long() {
      let u = Math.clamp((x + 0.5 - w * 0.5) / half, -1.0, 1.0)
      bark(c, x, y, u, y, half, WOOD, seed)
    }
  }
  for (dx, side) in [(-1, 0.18), (1, 0.82)] {
    c.poly(
      [
        w * side,
        bottom - h * 0.1,
        w * side,
        bottom,
        w * (side + dx * 0.14),
        bottom,
        w * (side + dx * 0.04),
        bottom - h * 0.08,
      ],
      "WOOD0",
    )
  }
  c.ellipse(w * 0.5, top, w * 0.28, ry, "WOOD2")
  for i in [0.78, 0.56, 0.34, 0.14] {
    c.ellipse(w * 0.5, top, w * 0.28 * i, ry * i, i == 0.14 ? "WOOD1" : "WOOD2")
    c.ellipse(
      w * 0.5,
      top,
      w * 0.28 * (i - 0.05),
      ry * (i - 0.05),
      "WOOD1",
    ) if i > 0.14
    c.ellipse(
      w * 0.5,
      top,
      w * 0.28 * (i - 0.1),
      ry * (i - 0.1),
      "WOOD2",
    ) if i > 0.14
  }
  c.outline()
  ground_shadow(c, w * 0.5, bottom + 1, w * 0.36, h * 0.05)
}

# A boulder: an irregular silhouette split into facets (nearest of a few
# seed points). Each facet is a plane, lit by which way it faces and shading
# across itself, darker toward the ground. Soft blotches of weathering and a
# fine grain run over all of them; a crack opens where a facet drops away into
# a darker one, the edge catches the light where one rises over its
# neighbours, and a few fractures run down the face.
fn draw_boulder(c, w, h, seed) {
  let n = 18
  let cx = w * 0.5
  let cy = h * 0.5
  let ground = h * 0.9  # the row the rock sits on
  mut pts = []
  for i in 0..n {
    let a = i.to_float() / n * 2 * Math.pi
    let r = 0.7 + 0.3 * noise(seed, i, 1) * (0.5 + 0.5 * noise(seed, i / 3, 7))
    pts.push(cx + Math.cos(a) * w * 0.48 * r)
    pts.push(Math.min(ground, cy + Math.sin(a) * h * 0.46 * r))
  }
  c.poly(pts, "ROCK1")
  # Each facet: its seed point, its light there, and how that light changes
  # per cell across and down it.
  let seeds = iota(16 + (w / 10).to_long()).map(fn (i) {
    let qx = w * (0.05 + 0.9 * noise(seed, i, 2))
    let qy = h * (0.1 + 0.8 * noise(seed, i, 3))
    let lit = 0.5 +
      (cy - qy) / h * 1.1 -
      (qx - cx) / w * 0.7 +
      (noise(seed, i, 4) - 0.5) * 0.45
    let gx = ((noise(seed, i, 5) - 0.5) * 2.0 - 0.5) / w
    let gy = ((noise(seed, i, 6) - 0.5) * 2.0 - 0.7) / h
    [qx, qy, lit, gx, gy]
  })
  let facet = fn (px, py) {
    seeds
      .enumerate()
      .min_by(|(_, s)| (s[0] - px) * (s[0] - px) + (s[1] - py) * (s[1] - py))[0]
  }
  let ramp = ["ROCK0", "ROCK1", "ROCK2", "ROCK3"]
  let solid = grid(0..w, 0..h).filter(|(sx, sy)| c.get(sx, sy) != 0).collect()
  for (x, y) in solid {
    let here = seeds[facet(x, y)]
    let drop = Math.min(seeds[facet(x + 1, y)][2], seeds[facet(x, y + 1)][2]) -
      here[2]
    if drop < -0.15 {
      c.set(x, y, "ROCK0")
      continue
    }
    let ridge = Math.min(seeds[facet(x - 1, y)][2], seeds[facet(x, y - 1)][2]) -
      here[2]
    mut light = here[2] + (x - here[0]) * here[3] + (y - here[1]) * here[4]
    light -= Math.max(0.0, (y - cy) / (ground - cy)) * 0.3
    light += 0.18 * (smooth_noise(seed, x, y, 7) - 0.5)
    light += 0.1 * (smooth_noise(seed + 1, x, y, 2.5) - 0.5)
    light += 0.2 if ridge < -0.15 || c.get(x, y - 1) == 0
    let grain = noise(seed, x, y, 5)
    light += 0.25 if grain < 0.04
    light -= 0.3 if grain > 0.955
    ramp_tone(c, x, y, light, ramp)
  }
  for crack in 0..2 + w / 70 {
    mut fx = w * (0.3 + 0.4 * noise(seed, crack, 11))
    mut fy = h * (0.25 + 0.25 * noise(seed, crack, 12))
    for k in 0..(h * (0.12 + 0.18 * noise(seed, crack, 13))).to_long() {
      break if c.get(fx, fy + 1) == 0
      c.set(fx, fy, "ROCK0")
      c.set(fx + 1, fy, "ROCK2") if noise(seed, crack, k, 14) < 0.5
      fx += (noise(seed, crack, k, 15) - 0.45) * 1.8
      fy += 1
    }
  }
  c.outline()
  ground_shadow(c, cx, ground, w * 0.46, h * 0.045)
}

# A ruined watchtower: rows of stone with the shading of a cylinder, slit
# windows, battlements.
fn draw_column(c, w, h, seed) {
  let x0 = w * 0.16
  let x1 = w * 0.84
  let top = h * 0.12
  c.poly([x0 + w * 0.03, top, x1 - w * 0.03, top, x1, h, x0, h], "STONE1")
  let row_h = Math.max(3, (h * 0.045).to_long())
  let brick_w = Math.max(6, (w * 0.14).to_long())
  c.recolor(["STONE1"], fn (x, y, _) {
    let row = (y - top.to_long()) / row_h
    let shift = row % 2 == 0 ? 0 : brick_w / 2
    let bx = (x + shift) / brick_w
    let mortar = (y - top.to_long()) % row_h == 0 || (x + shift) % brick_w == 0
    return "STONE0" if mortar
    # Cylinder shading: dark at both edges, brightest left of centre.
    let u = (x - x0) / (x1 - x0)
    let shade = cond {
      u < 0.12 || u > 0.88 => "STONE0",
      u < 0.25 || u > 0.72 => (bx + row + x + y) % 2 == 0 ? "STONE0" : "STONE1",
      u > 0.3 && u < 0.5 => (bx + row) % 3 == 0 ? "STONE2" : "STONE1",
      _ => "STONE1",
    }
    noise(seed, bx, row) < 0.15 && shade == "STONE1" ? "STONE2" : shade
  })
  for i in 0..5 {
    let mx = x0 + w * 0.02 + i * (x1 - x0 - w * 0.04) / 5
    c.rect(mx, h * 0.03, (x1 - x0) / 5 * 0.62, top - h * 0.03 + 1, "STONE1")
    c.rect(mx, h * 0.03, 2, top - h * 0.03 + 1, "STONE0")
  }
  for y in [0.36, 0.62] {
    c.rect(w * 0.47, h * y, w * 0.06, h * 0.09, "INK")
    c.rect(w * 0.47, h * y, w * 0.06, 1, "STONE2")
  }
  c.outline()
  ground_shadow(c, w * 0.5, h * 0.99, w * 0.42, h * 0.02)
}

# --- billboards --------------------------------------------------------------
# A poster is a function of the panel's inner rectangle. Text goes through
# the built-in font at the largest scale that fits; an icon takes one end.
fn fit_scale(lines, w, h) {
  mut s = 4
  while s > 1 &&
      lines.any(|(
        t,
        _,
      )| Canvas.text_width(t, s) > w || lines.size() * 10 * s > h) {
    s -= 1
  }
  s
}

# Lines of text stacked and centred in (x, y, w, h). A capital inks the top
# seven of the font's eight rows and the shadow falls a scaled cell under it,
# so the block is centred on what shows rather than on the line spacing.
fn caption(c, x, y, w, h, lines, shadow = nil) {
  let s = fit_scale(lines, w, h)
  let ink = (lines.size() - 1) * 10 * s + 7 * s + (shadow != nil ? s : 0)
  mut ty = Math.round(y + (h - ink) / 2.0)
  for (t, key) in lines {
    let tx = x + (w - Canvas.text_width(t, s)) / 2.0
    c.text(t, tx + s, ty + s, shadow, s) if shadow != nil
    c.text(t, tx, ty, key, s)
    ty += 10 * s
  }
}

# Icon at one end of the panel, text in the rest; tall panels stack them.
fn poster(c, x, y, w, h, bg, lines, icon, shadow = nil) {
  c.rect(x, y, w, h, bg)
  if h > w * 0.7 {
    icon(c, x + w * 0.25, y + h * 0.06, w * 0.5, h * 0.42)
    caption(c, x + w * 0.04, y + h * 0.5, w * 0.92, h * 0.46, lines, shadow)
  } else {
    icon(c, x + w * 0.04, y + h * 0.12, w * 0.28, h * 0.76)
    caption(c, x + w * 0.34, y + h * 0.05, w * 0.62, h * 0.9, lines, shadow)
  }
}

let ICONS = {
  snake: fn (c, x, y, w, h) {
    for i in 0..(w * 0.9).to_long() {
      let t = i / (w * 0.9)
      let sx = x + w * 0.05 + i
      let sy = y + h * 0.5 + Math.sin(t * 2 * Math.pi * 1.5) * h * 0.3
      c.rect(sx, sy - h * 0.09, 1, h * 0.18, "P_GREEN")
    }
    c.circle(x + w * 0.9, y + h * 0.5, h * 0.14, "P_GREEN")
    c.set(x + w * 0.92, y + h * 0.46, "INK")
    c.rect(x + w * 0.96, y + h * 0.5, w * 0.08, 1, "P_RED")
  },
  sun: fn (c, x, y, w, h) {
    let cx = x + w * 0.5
    let cy = y + h * 0.66
    for i in 0..7 {
      let a = Math.pi + i / 6.0 * Math.pi
      c.line(
        cx + Math.cos(a) * w * 0.34,
        cy + Math.sin(a) * h * 0.34,
        cx + Math.cos(a) * w * 0.5,
        cy + Math.sin(a) * h * 0.5,
        "P_ORANGE",
        2,
      )
    }
    c.circle(cx, cy, Math.min(w, h) * 0.28, "P_YELLOW")
    c.rect(x, cy, w, h * 0.34, "P_NAVY")
    c.rect(x, cy, w, 1, "P_ORANGE")
  },
  burger: fn (c, x, y, w, h) {
    let cx = x + w * 0.5
    c.ellipse(cx, y + h * 0.32, w * 0.42, h * 0.24, "P_ORANGE")
    c.rect(cx - w * 0.42, y + h * 0.32, w * 0.84, h * 0.12, "P_ORANGE")
    c.rect(cx - w * 0.46, y + h * 0.44, w * 0.92, h * 0.1, "P_GREEN")
    c.rect(cx - w * 0.42, y + h * 0.54, w * 0.84, h * 0.14, "P_BROWN")
    c.rect(cx - w * 0.44, y + h * 0.68, w * 0.88, h * 0.08, "P_YELLOW")
    c.rect(cx - w * 0.4, y + h * 0.76, w * 0.8, h * 0.14, "P_ORANGE")
    for i in 0..4 {
      c.set(cx - w * 0.25 + i * w * 0.16, y + h * 0.22 + (i % 2) * 2, "P_WHITE")
    }
  },
  pump: fn (c, x, y, w, h) {
    c.rect(x + w * 0.2, y + h * 0.1, w * 0.5, h * 0.85, "P_RED")
    c.rect(x + w * 0.28, y + h * 0.18, w * 0.34, h * 0.22, "P_WHITE")
    c.rect(x + w * 0.1, y + h * 0.92, w * 0.7, h * 0.08, "INK")
    c.rect(x + w * 0.72, y + h * 0.3, w * 0.08, h * 0.45, "INK")
    c.rect(x + w * 0.72, y + h * 0.3, w * 0.22, h * 0.08, "INK")
    c.rect(x + w * 0.86, y + h * 0.3, w * 0.08, h * 0.25, "INK")
  },
  wave: fn (c, x, y, w, h) {
    for (oy, key) in [(0.0, "P_WHITE"), (0.3, "P_NAVY")] {
      for i in 0..(w * 0.96).to_long() {
        let t = i / (w * 0.96)
        let sy = y +
          h * (0.55 + oy) -
          Math.abs(Math.sin(t * Math.pi * 1.5)) * h * 0.4
        c.rect(x + i, sy, 1, h * 0.12, key)
      }
    }
    c.circle(x + w * 0.2, y + h * 0.18, h * 0.08, "P_WHITE")
  },
  palm: fn (c, x, y, w, h) {
    palm(
      c,
      x + w * 0.5,
      y + h * 0.98,
      h * 0.95,
      7,
      ("P_BROWN", "P_YELLOW", "LEAF1", "P_GREEN", "LEAF3", "P_BROWN"),
      nil,
      0.0,
      0.42,
    )
  },
  bottle: fn (c, x, y, w, h) {
    let cx = x + w * 0.5
    c.rect(cx - w * 0.12, y, w * 0.24, h * 0.12, "P_WHITE")
    c.poly(
      [
        cx - w * 0.12,
        y + h * 0.12,
        cx + w * 0.12,
        y + h * 0.12,
        cx + w * 0.28,
        y + h * 0.35,
        cx + w * 0.28,
        y + h,
        cx - w * 0.28,
        y + h,
        cx - w * 0.28,
        y + h * 0.35,
      ],
      "P_WHITE",
    )
    c.rect(cx - w * 0.28, y + h * 0.5, w * 0.56, h * 0.22, "P_RED")
    c.rect(cx - w * 0.2, y + h * 0.56, w * 0.4, h * 0.1, "P_WHITE")
    c.rect(cx - w * 0.14, y, w * 0.28, h * 0.04, "P_YELLOW")
  },
  radio: fn (c, x, y, w, h) {
    c.rect(x + w * 0.05, y + h * 0.35, w * 0.9, h * 0.6, "P_CYAN")
    c.circle(x + w * 0.3, y + h * 0.65, Math.min(w, h) * 0.18, "P_NAVY")
    c.circle(x + w * 0.3, y + h * 0.65, Math.min(w, h) * 0.1, "P_WHITE")
    for i in 0..4 {
      c.rect(
        x + w * 0.56 + i * w * 0.09,
        y + h * 0.5 + (i % 2) * h * 0.1,
        w * 0.06,
        h * 0.35 - (i % 2) * h * 0.1,
        "P_PINK",
      )
    }
    c.line(x + w * 0.85, y + h * 0.35, x + w * 0.95, y, "P_WHITE", 2)
  },
  pizza: fn (c, x, y, w, h) {
    let cx = x + w * 0.5
    c.poly(
      [
        cx - w * 0.44,
        y + h * 0.1,
        cx + w * 0.44,
        y + h * 0.1,
        cx,
        y + h * 0.98,
      ],
      "P_YELLOW",
    )
    c.poly(
      [
        cx - w * 0.44,
        y + h * 0.1,
        cx + w * 0.44,
        y + h * 0.1,
        cx + w * 0.38,
        y + h * 0.24,
        cx - w * 0.38,
        y + h * 0.24,
      ],
      "P_ORANGE",
    )
    for (
      px,
      py,
    ) in [(0.36, 0.32), (0.6, 0.36), (0.5, 0.58), (0.4, 0.5), (0.52, 0.76)] {
      c.circle(x + w * px, y + h * py, Math.min(w, h) * 0.07, "P_RED")
    }
  },
}

let POSTERS = [
  {
    bg: "P_WHITE",
    lines: [("CULEBRA", "P_RED"), ("RETRO RUN", "P_NAVY")],
    icon: "snake",
  },
  {
    bg: "P_NAVY",
    lines: [("SUNSET", "P_YELLOW"), ("MOTEL", "P_YELLOW")],
    icon: "sun",
  },
  {
    bg: "P_YELLOW",
    lines: [("COAST", "P_RED"), ("DINER", "P_RED")],
    icon: "burger",
  },
  {bg: "P_WHITE", lines: [("GAS", "P_BLUE"), ("24H", "P_RED")], icon: "pump"},
  {
    bg: "P_CYAN",
    lines: [("SURF", "P_WHITE"), ("SHOP", "P_WHITE")],
    icon: "wave",
    shadow: "P_NAVY",
  },
  {
    bg: "P_ORANGE",
    lines: [("PALM", "P_WHITE"), ("BEACH", "P_WHITE")],
    icon: "palm",
    shadow: "P_RED",
  },
  {
    bg: "P_RED",
    lines: [("COLA", "P_WHITE"), ("ICE COLD", "P_YELLOW")],
    icon: "bottle",
  },
  {
    bg: "P_NAVY",
    lines: [("RADIO", "P_CYAN"), ("88.8 FM", "P_PINK")],
    icon: "radio",
  },
  {
    bg: "P_WHITE",
    lines: [("PIZZA", "P_GREEN"), ("HOT!", "P_RED")],
    icon: "pizza",
  },
