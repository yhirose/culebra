# The shaded and lit tones of each poster ground, for lighting the panel.
let PANEL_TONES = {
  P_WHITE: ("WHITE1", "WHITE2"),
  P_NAVY: ("INK", "BLUE0"),
  P_YELLOW: ("YELLOW0", "YELLOW2"),
  P_RED: ("RED0", "RED2"),
  P_CYAN: ("GLASS1", "GLASS2"),
  P_ORANGE: ("ORANGE0", "ORANGE2"),
}
let STEEL = ("TYRE0", "POST", "WHITE0")

# A thin line that only fills empty cells, so it passes behind what is there.
fn line_behind(c, x0, y0, x1, y1, key) {
  let n = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0)).to_long() + 1
  for i in 0..=n {
    let x = x0 + (x1 - x0) * i / n
    let y = y0 + (y1 - y0) * i / n
    c.set(x, y, key) if c.get(x, y) == 0
  }
}

# A sign panel in a bevelled metal frame on two steel posts with concrete
# footings and a catwalk, two hooded lamps over the top. The poster is lit
# after it is drawn: the frame's lip shades its top edge, the lamps throw
# pools of light below them, a gloss streak crosses it, and it dims toward
# the bottom. Only cells still showing the poster's ground are relit, so the
# lettering and the icon stay crisp.
fn draw_billboard(c, w, h, seed, design) {
  let post_w = Math.max(3, (w * 0.05).to_long())
  let panel_x = w * 0.03
  let panel_w = w * 0.94
  let panel_y = h * 0.06
  let panel_h = h * 0.6
  let foot = h * 0.94
  let post_xs = [w * 0.2, w * 0.8 - post_w]
  for px in post_xs {
    let half = post_w / 2.0
    for y in (panel_y + panel_h - 2).to_long()..foot.to_long() {
      for x in px.to_long()..(px + post_w).to_long() {
        bark(c, x, y, (x + 0.5 - px - half) / half, y, half, STEEL, seed, false)
      }
    }
    # A concrete footing: lit top, shaded right face.
    let fx = px - post_w * 0.6
    let fw = post_w * 2.2
    c.rect(fx, foot, fw, h - foot, "ROCK2")
    c.rect(fx, foot, fw, 1, "ROCK3")
    c.rect(fx + fw * 0.7, foot + 1, fw * 0.3, h - foot, "ROCK1")
  }

  # The frame: brushed metal, light along the top and left, dark along the
  # bottom and right, with rivets round the border.
  c.vgrad(
    panel_x,
    panel_y,
    panel_w,
    panel_h,
    [[0.0, "WHITE1"], [0.25, "FRAME"], [0.85, "FRAME"], [1.0, "WHITE0"]],
  )
  c.rect(panel_x, panel_y, panel_w, 1, "WHITE2")
  c.rect(panel_x, panel_y, 1, panel_h, "WHITE2")
  c.rect(panel_x + panel_w - 1, panel_y, 1, panel_h, "WHITE0")
  c.rect(panel_x, panel_y + panel_h - 2, panel_w, 2, "POST")
  # The catwalk under the panel.
  let walk_y = panel_y + panel_h
  c.rect(w * 0.1, walk_y, w * 0.8, 1, "WHITE0")
  c.rect(w * 0.1, walk_y + 1, w * 0.8, 1, "POST")

  let inset = Math.max(3.0, w * 0.03)
  let x0 = panel_x + inset
  let y0 = panel_y + inset
  let pw = panel_w - inset * 2
  let ph = panel_h - inset * 2 - 2
  let rivet_y = [panel_y + inset / 2, panel_y + panel_h - 2 - inset / 2]
  mut rx = panel_x + inset / 2
  while rx < panel_x + panel_w - 1 {
    for ry in rivet_y {
      c.set(rx, ry, "WHITE0")
      c.set(rx - 1, ry - 1, "WHITE2")
    }
    rx += Math.max(6.0, panel_w / 12)
  }
  poster(
    c,
    x0,
    y0,
    pw,
    ph,
    design.bg,
    design.lines,
    ICONS[design.icon],
    design.get("shadow", nil),
  )

  let lamp_xs = [w * 0.3, w * 0.7]
  let bg = KEY_ID[design.bg]
  let (shade, lit) = PANEL_TONES[design.bg]
  let xs = x0.to_long()..(x0 + pw).to_long()
  let ys = y0.to_long()..(y0 + ph).to_long()
  for (x, y) in grid(xs, ys) {
    continue if c.get(x, y) != bg
    let fy = (y - y0) / ph
    let fx = (x - x0) / pw
    mut light = 0.0
    for lx in lamp_xs {
      let dx = (x - lx) / (pw * 0.2)
      let dy = fy / 0.7
      light += Math.max(0.0, 1 - dx * dx - dy * dy) * 0.45
    }
    let streak = fx - (1 - fy) * 0.25
    light += 0.55 if Math.abs(streak - 0.55) < 0.035 ||
      Math.abs(streak - 0.63) < 0.012
    light -= Math.max(0.0, fy - 0.7) * 1.2
    light = -1.0 if y - y0 < 1
    light = Math.min(light, -0.5) if y - y0 < 2 || x - x0 < 1
    # Three steps — none, a checker, solid — read as halftone; a finer ramp
    # breaks up into stray dots at this size.
    let step = cond {
      Math.abs(light) > 0.75 => 1.0,
      Math.abs(light) > 0.25 => 0.5,
      _ => 0.0,
    }
    c.mix(x, y, design.bg, light > 0 ? lit : shade, step)
  }
  # The recess: shadow inside the top and left of the frame, a lit lip along
  # the bottom and right.
  c.rect(x0 - 1, y0 - 1, pw + 2, 1, "WHITE0")
  c.rect(x0 - 1, y0 - 1, 1, ph + 2, "WHITE0")
  c.rect(x0 - 1, y0 + ph, pw + 2, 1, "WHITE2")
  c.rect(x0 + pw, y0 - 1, 1, ph + 2, "WHITE2")

  # Lamps: a stem up from behind the frame and a hood with its lens lit.
  let hood_w = Math.max(5.0, w * 0.1)
  let hood_h = Math.max(3.0, panel_y - 1)
  for lx in lamp_xs {
    c.rect(lx - 1, hood_h - 1, 2, panel_y - hood_h + 2, "POST")
    c.poly(
      [
        lx - hood_w * 0.3,
        0,
        lx + hood_w * 0.3,
        0,
        lx + hood_w * 0.5,
        hood_h - 1,
        lx - hood_w * 0.5,
        hood_h - 1,
      ],
      "POST",
    )
    c.rect(lx - hood_w * 0.3, 0, hood_w * 0.3, 1, "WHITE0")
    c.rect(lx - hood_w * 0.5 + 1, hood_h - 1, hood_w - 2, 1, "LAMP_W")
  }
  c.outline()

  # Cross-bracing between the posts, behind them, and the sign's shadow.
  let (a, b) = (post_xs[0] + post_w + 1, post_xs[1] - 2)
  let top = walk_y + 3
  let mid = (top + foot) / 2
  line_behind(c, a, top, b, mid, "POST")
  line_behind(c, b, top, a, mid, "POST")
  line_behind(c, a, mid, b, foot - 1, "POST")
  line_behind(c, b, mid, a, foot - 1, "POST")
  ground_shadow(c, w * 0.5, h - 1, w * 0.42, Math.max(1.5, h * 0.02))
}

# --- vehicles ----------------------------------------------------------------
# Rear view, one cell per pixel. `style` picks the silhouette family and the
# paint; `steer` leans the cabin into a turn; `hill` is how many extra rows
# of the rear face show when the car is climbing.

# The wheels: a pair of tyres with tread, wider apart than the body's waist
# so their outer halves show.
fn wheels(c, w, floor, tyre_w, tyre_h, inset) {
  for tx in [inset, w - inset - tyre_w] {
    c.rect(tx, floor - tyre_h, tyre_w, tyre_h, "TYRE0")
    for (
      x,
      y,
    ) in [(tx, floor - tyre_h), (tx + tyre_w - 1, floor - tyre_h), (tx, floor - 1), (tx + tyre_w - 1, floor - 1)] {
      c.set(x, y, 0)
    }
    c.rect(tx + 2, floor - tyre_h + 1, tyre_w - 4, 1, "TYRE1")
    for y in floor - tyre_h + 3..floor - 1 by 2 {
      c.set(tx, y, "TYRE1")
      c.set(tx + tyre_w - 1, y, "TYRE1")
    }
  }
}

# Half-width of a body at row `y`, from control points `[[y, half], ...]`
# (ascending y), smoothed between them so the flanks curve rather than step.
fn profile(points, y) {
  return points[0][1] if y <= points[0][0]
  let last = points[points.size() - 1]
  return last[1] if y >= last[0]
  mut i = 0
  while points[i + 1][0] < y {
    i += 1
  }
  let [y0, h0] = points[i]
  let [y1, h1] = points[i + 1]
  let t = (y - y0).to_float() / (y1 - y0)
  h0 + (h1 - h0) * t * t * (3 - 2 * t)
}

# Fill a profile's rows as glossy paint under a light from above. A row's
# brightness comes from how the surface faces: where the profile spreads
# going down the surface faces up and catches the light (the shoulder), where
# it tucks in it falls into shadow (the sill), and across each row the flank
# turns away toward the dark tone. The first `top_light` rows lift toward the
# light tone regardless (a deck or roof seen flat on). The brightest points
# of the shoulder turn toward `shine`, and a reflection streak slides down and
# out across the lower body, the way sky reads on a curved panel.
fn shell(c, cx, points, tones, top_light, shine = "SHINE") {
  let (d, m, l) = tones
  let y0 = points[0][0].to_long()
  let y1 = points[points.size() - 1][0].to_long()
  let mid = (y0 + y1) / 2
  for y in y0..=y1 {
    let half = profile(points, y)
    let spread = profile(points, y + 1) - profile(points, y - 1)
    let facing = Math.clamp(spread * 0.15, -0.3, 0.5)
    let flat = y < y0 + top_light
      ? (1.0 - (y - y0).to_float() / top_light) * 0.5
      : 0.0
    # The lower body sits in its own shadow, deeper toward the sill.
    let under = y > mid
      ? (y - mid).to_float() / Math.max(1, y1 - mid) * 0.35
      : 0.0
    let streak = half * 0.45 + (y - mid) * 0.5
    for x in (cx - half).to_long()..=(cx + half).to_long() {
      let u = Math.abs(x - cx) / Math.max(1.0, half)
      mut light = 0.5 + facing + flat - under - u * u * u * 0.8
      light += 0.45 if y > mid && Math.abs(Math.abs(x - cx) - streak) < 1.5
      cond {
        light > 1.05 => c.mix(x, y, l, shine, (light - 1.05) / 0.3),
        light > 0.72 => c.mix(x, y, m, l, (light - 0.72) / 0.33),
        light < 0.4 => c.mix(x, y, d, m, (light - 0.1) / 0.3),
        _ => c.set(x, y, m),
      }
    }
  }
}

# Glass inside a cabin profile, `inset` cells in from the pillars: dark tint
# with a lighter band low down and two highlight strokes upper left.
fn glass(c, cx, points, inset) {
  let y0 = points[0][0].to_long() + inset
  let y1 = points[points.size() - 1][0].to_long() - inset
  for y in y0..=y1 {
    let half = profile(points, y) - inset - 1
    continue if half < 1
    let t = (y - y0).to_float() / Math.max(1, y1 - y0)
    for x in (cx - half).to_long()..=(cx + half).to_long() {
      c.set(x, y, t > 0.7 ? "GLASS1" : "GLASS0")
    }
  }
  let hw = profile(points, y0 + 2)
  c.line(cx - hw * 0.55, y1 - 1, cx - hw * 0.2, y0 + 1, "GLASS2", 1)
  c.line(cx - hw * 0.75, y1 - 1, cx - hw * 0.45, y0 + 2, "GLASS2", 1)
}

fn plate(c, cx, y, pw) {
  c.rect(cx - pw / 2.0, y, pw, 4, "PLATE")
  for x in (cx - pw / 2.0 + 2).to_long()..(cx + pw / 2.0 - 2).to_long() by 2 {
    c.set(x, y + 2, "INK")
  }
}

# A pair of tail lamps that follow the body's curve: each row starts at the
# flank, so a lamp wraps round the corner the way the profile does. The
# lower part is the red lens, the top the lit strip, the inner end amber.
fn wrap_lamps(c, cx, body, y, lamp_h, lw) {
  for i in 0..lamp_h {
    let half = profile(body, y + i) - 2
    for (x0, dir) in [(cx - half, 1), (cx + half - lw, 1)] {
      c.rect(x0, y + i, lw, 1, i < 2 ? "LAMP_RL" : "LAMP_R")
      let amber = x0 < cx ? x0 + lw - 2 : x0
      c.rect(amber, y + i, 2, 1, "LAMP_A") if i >= 1
    }
  }
}

# Two riders in an open cabin: seats, shoulders, heads with hair. `crew` is
# the (hair, shirt) of the left rider and of the right.
fn riders(
  c,
  cx,
  top,
  spacing,
  seat = "TYRE1",
  crew = [("HAIR_BROWN", "SHIRT_A"), ("HAIR_BLOND", "SHIRT_B")],
) {
  for (i, look) in crew.enumerate() {
    let (hair, shirt) = look
    let x = cx + (i == 0 ? -spacing : spacing)
    c.rect(x - 6, top + 7, 12, 6, seat)      # seat back
    c.rect(x - 5, top + 5, 10, 4, shirt)     # shoulders
    c.circle(x, top + 3, 3.4, "SKIN")        # head
    c.ellipse(x, top + 1.5, 3.6, 2.2, hair)  # hair
    c.rect(x - 4, top + 1, 8, 1, hair)
    c.set(x + (hair == "HAIR_BLOND" ? 3 : -3), top + 4, hair)
  }
}

# A glass-coated paint over a body profile. The colour's own light depends on
# how the surface faces: up toward the sky on the deck, turning away at the
# flanks, in its own shadow low down. The clear coat mirrors the scene
# sharply: sky down to a crisp bright line where the horizon lies across the
# panel, bending down toward the hips, the dark road below it, and a glint on
# each hip where it turns to the light. `ramp` runs dark to light, and only a
# narrow middle between two of its tones is dithered, so the coat reads as
# smooth bands rather than a mesh.
fn glass_coat(c, cx, body, top_rows, ramp) {
  let y0 = body[0][0].to_long()
  let y1 = body[body.size() - 1][0].to_long()
  let horizon = y0 + top_rows + 2
  for y in y0..=y1 {
    let half = profile(body, y)
    let spread = profile(body, y + 1) - profile(body, y - 1)
    let flat = y < y0 + top_rows ? 1.0 - (y - y0).to_float() / top_rows : 0.0
    let up = Math.clamp(spread * 0.25 + flat * 0.8, -0.6, 1.0)
    for x in (cx - half).to_long()..=(cx + half).to_long() {
      let u = (x + 0.5 - cx) / Math.max(1.0, half)
      let side = Math.abs(u)
      let edge = horizon + side * side * 5
      mut light = 0.42 + 0.3 * up - 0.45 * side * side * side
      light += cond {
        y < edge - 1 => 0.3 - 0.05 * (edge - y),
        y < edge + 1 => 0.5,
        _ => -0.08 - 0.15 * (y - edge) / Math.max(1.0, y1 - edge),
      }
      let near = y >= edge - 4 && y < edge + 1
      light += 0.5 if near && Math.abs(u + 0.55) < 0.07
      light += 0.35 if near && Math.abs(u - 0.62) < 0.05
      let t = Math.clamp(light, 0.0, 0.999) * (ramp.size() - 1)
      let i = t.to_long()
      let f = t - i
      cond {
        f < 0.35 => c.set(x, y, ramp[i]),
        f > 0.65 => c.set(x, y, ramp[i + 1]),
        _ => c.mix(x, y, ramp[i], ramp[i + 1], 0.5),
      }
    }
  }
}

# A round tail lamp in a dark bezel: a red lens, a lit ring inside it, a pale
# centre, and a clear bar running out from it toward the flank (`out` is -1
# for the left lamp, 1 for the right).
fn round_lamp(c, lx, ly, r, out) {
  let reach = (r * 2.4).to_long()
  for i in 0..reach {
    let bx = lx + out * (r + i)
    c.set(bx, ly - 1, "CHROME")
    c.set(bx, ly, i < reach - 2 ? "WHITE1" : "WHITE0")
  }
  c.circle(lx, ly, r + 0.7, "SOUL0")
  let span = (r + 1).to_long()
  for (dx, dy) in grid(-span..=span, -span..=span) {
    let d = Math.sqrt((dx * dx + dy * dy).to_float())
    continue if d > r
    c.set(
      lx + dx,
      ly + dy,
      Math.abs(d - r * 0.62) < 0.55 ? "LAMP_RL" : "LAMP_R",
    )
  }
  c.rect(lx - 1, ly - 1, 2, 2, "WHITE0")
  c.set(lx - 1, ly - 1, "WHITE1")
  c.set(lx - r * 0.5, ly - r * 0.6, "LAMP_W")
}

# The player's car, after today's small Japanese roadster: open, with two
# roll hoops behind the seats and the riders' heads above them, a short deck
# over wide rounded hips, round tail lamps each with a clear bar running out
# toward the flank, a plate low in a recess, a black diffuser with twin pipes
# and an aerial. The paint is a deep red under a glass coat that mirrors the
# sky. `hill` pitches the car nose-up for the uphill variant, as the camera
# behind it then sees it: the deck, a top surface, grows by twice `hill`, and
# the tail face below it gives up part of that between the lamps and the
# plate.
fn draw_sports_car(c, w, h, steer, hill) {
  let cx = w / 2.0
  let floor = h - 1
  let top = 2
  let deck = 14
  let lid = 3 + 2 * hill
  let lamp_y = deck + lid + 3 - hill / 2
  let plate_y = floor - 10 + hill / 4
  wheels(c, w, floor, 12, 14, 2)
  # The hips swell out quickly from the deck and ease into their full width,
  # so a long deck (climbing) still reads as a full body rather than a waist;
  # they round off at the sill, and stop a cell short of the sprite's edge so
  # the outline runs down the sides too. The deck's far edge sets the width of
  # everything standing on it.
  let body = [
    [deck, w * 0.37],
    [deck + lid * 0.5, w * 0.45],
    [deck + lid, w * 0.475],
    [lamp_y + 4, w * 0.485],
    [floor - 8, w * 0.485],
    [floor - 4, w * 0.46],
    [floor - 2, w * 0.4],
  ]
  let rim = profile(body, deck)
  # The windscreen, bright glass in a black frame that rounds over its top
  # corners and meets the deck at its width; the riders in front of it; the
  # two hoops nearest of all, apart, with the mesh board low between them.
  let screen = [
    [top + 2, w * 0.2],
    [top + 4, w * 0.27],
    [top + 8, w * 0.32],
    [deck - 2, rim - 1],
  ]
  for y in top + 2..deck - 1 {
    let half = profile(screen, y)
    for x in (cx - half).to_long()..=(cx + half).to_long() {
      if y == top + 2 ||
          x == (cx - half).to_long() ||
          x == (cx + half).to_long() {
        c.set(x, y, "TYRE0")
      } else {
        c.mix(x, y, "GLASS1", "GLASS2", y < top + 5 ? 0.5 : 0.0)
      }
    }
  }
  c.line(cx - w * 0.22, deck - 3, cx - w * 0.12, top + 3, "GLASS2")
  riders(c, cx, top, 8)
  c.dither(cx - 2, top + 11, 5, deck - top - 11, "TYRE0", "TYRE1")  # the mesh board
  for s in [-1, 1] {
    let hx = cx + s * 8
    c.ellipse(hx, top + 9, 5, 4, "TYRE0")
    c.rect(hx - 5, top + 9, 11, deck - top - 9, "TYRE0")
    c.rect(hx - 3, top + 6, 7, 1, "TYRE1")
    c.ellipse(cx + s * w * 0.42, top + 9, 3, 2, "SOUL2")  # mirrors
    c.rect(cx + s * w * 0.42 - 2, top + 10, 5, 1, "SOUL0")
  }
  c.rect(cx - rim, deck - 2, rim * 2 + 1, 2, "TYRE0")  # the folded top's cover
  c.rect(cx - rim + 2, deck - 2, rim * 2 - 3, 1, "TYRE1")

  glass_coat(c, cx, body, lid, ["SOUL0", "SOUL1", "SOUL2", "SOUL3", "SOUL4"])
  c.rect(cx - w * 0.12, deck, w * 0.24, 1, "LAMP_R")  # the high brake lamp
  # The lid's trailing edge, the badge, the lamps.
  c.rect(cx - w * 0.2, lamp_y - 4, w * 0.4 + 1, 1, "SOUL1")
  c.rect(cx - 2, lamp_y - 2, 5, 2, "CHROME")
  c.set(cx, lamp_y - 1, "SOUL1")
  let lamp_r = 3.4 - hill * 0.1
  for s in [-1, 1] {
    round_lamp(c, cx + s * w * 0.3, lamp_y, lamp_r, s)
  }

  # The plate in its recess, reflectors low at the corners, the diffuser and
  # the pipes.
  c.rect(cx - 9, plate_y - 1, 18, 6, "SOUL0")
  plate(c, cx, plate_y, 14)
  for s in [-1, 1] {
    let rx = cx + s * w * 0.37
    c.rect(rx - 2, floor - 8, 4, 2, "TYRE0")
    c.rect(rx - 1, floor - 8, 2, 1, "LAMP_R")
  }
  let low = floor - 4
  for y in low..floor - 1 {
    let half = profile(body, y) - 2
    c.rect(cx - half, y, half * 2 + 1, 1, y == low ? "TYRE1" : "TYRE0")
  }
  for ex in [cx + 6, cx + 11] {
    c.ellipse(ex, floor - 3, 2.2, 1.6, "CHROME")
    c.set(ex, floor - 3, "TYRE0")
  }
  c.outline()
  # The aerial goes on after the outline, which would thicken a single line.
  c.line(cx + w * 0.38, deck + 1, cx + w * 0.42, 0, "TYRE1")
  c.shear(deck, -steer * 0.2) if steer != 0
  ground_shadow(c, w / 2, floor, w * 0.48, 1)
}

# Traffic. Each vehicle is its tail drawn square-on plus a strip of its right
# flank, the way a car a lane over shows a little of its side: `side_face`
# sweeps the tail's right edge back toward the horizon one tone darker.

# What a colour turns into on a face turned away from the light.
mut DARKER = {
  SHINE: "WHITE2",
  CHROME: "WHITE1",
  PLATE: "WHITE1",
  LAMP_W: "LAMP_RL",
  LAMP_RL: "LAMP_R",
  LAMP_R: "RED0",
  LAMP_A: "ORANGE0",
  GLASS2: "GLASS1",
  GLASS1: "GLASS0",
  TYRE1: "TYRE0",
  GOLD2: "YELLOW1",
  FRAME: "WHITE0",
}
for ramp in [["RED0", "RED1", "RED2"], ["BLUE0", "BLUE1", "BLUE2"], ["YELLOW0", "YELLOW1", "YELLOW2"], ["GREEN0", "GREEN1", "GREEN2"], ["WHITE0", "WHITE1", "WHITE2"], ["ORANGE0", "ORANGE1", "ORANGE2"], ["AQUA0", "AQUA1", "AQUA2"], ["PINK0", "PINK1", "PINK2"], ["CREAM0", "CREAM1", "CREAM2"]] {
  for i in 1..ramp.size() {
    DARKER[ramp[i]] = ramp[i - 1]
  }
}

# A light level 0..1 as a tone of `ramp` (dark to light): solid tones with a
# checker between each pair, so shading steps in bands rather than speckle.
fn ramp_tone(c, x, y, light, ramp) {
  let band = (Math.clamp(light, 0.0, 0.999) * (ramp.size() * 2 - 1)).to_long()
  if band % 2 == 0 {
    c.set(x, y, ramp[band / 2])
  } else {
    c.mix(x, y, ramp[band / 2], ramp[band / 2 + 1], 0.5)
  }
}

# Sweep column `edge` rightward `depth` cells as a receding flank: column i
# repeats the edge a tone darker with its rows pulled toward row `hy` (by
# `shrink` at the far end), and every `rib`th column is darker again.
fn side_face(c, edge, depth, hy, shrink, rib = 0) {
  for i in 1..=depth {
    let f = 1.0 - shrink * i / depth
    for y in 0..c.h {
      let v = c.get(edge, hy + (y - hy) / f)
      continue if v == 0
      mut key = KEYS[v]
      key = DARKER[key] if DARKER.has(key)
      key = DARKER[key] if rib > 0 && i % rib == 0 && DARKER.has(key)
      c.set(edge + i, y, key)
    }
  }
}

# A tyre seen from behind: the tread faces the camera, so it is a dark block
# with clipped corners crossed by staggered rows of lugs.
fn tyre(c, x, y, tw, th, lug) {
  c.rect(x, y, tw, th, "TYRE0")
  for ty in y + 1..y + th - 1 by 3 {
    let shift = (ty - y) / 3 % 2 == 0 ? 0 : lug / 2 + 1
    for tx in x + 1 - shift..x + tw - 1 by lug + 1 {
      let a = Math.max(x + 1, tx)
      let b = Math.min(x + tw - 1, tx + lug)
      c.rect(a, ty, b - a, 2, "TYRE1") if b > a
    }
  }
  for (
    px,
    py,
  ) in [(x, y), (x + tw - 1, y), (x, y + th - 1), (x + tw - 1, y + th - 1)] {
    c.set(px, py, 0)
  }
}

# A chrome bar `bh` rows deep: bright along the top, the dark of the road
# reflected across the middle, a lighter lower lip.
fn chrome_bar(c, x, y, bw, bh) {
  let rows = ["WHITE2", "CHROME", "WHITE1", "TYRE1", "WHITE0", "WHITE1"]
  for i in 0..bh {
    c.rect(x, y + i, bw, 1, rows[i * rows.size() / bh])
  }
}

# Swap one paint for another, tone for tone, inside a box: a stripe laid over
# shading that is already there.
fn repaint(c, x0, y0, x1, y1, from, to) {
  let (fd, fm, fl) = from
  let (td, tm, tl) = to
  let swap = [(fd, td), (fm, tm), (fl, tl)]
  for (x, y) in grid(x0.to_long()..=x1.to_long(), y0.to_long()..=y1.to_long()) {
    let name = KEYS[c.get(x, y)]
    for (a, b) in swap {
      c.set(x, y, b) if name == a
    }
  }
}

# An ellipsoid swelling lit from the upper left, a wing standing proud of the
# body over a wheel, cut off flat below row `cut`.
fn bulge(c, cx, cy, rx, ry, ramp, cut) {
  let xs = (cx - rx).to_long()..=(cx + rx).to_long()
  for (x, y) in grid(xs, (cy - ry).to_long()..=cut) {
    let nx = (x - cx).to_float() / rx
    let ny = (y - cy).to_float() / ry
    let r2 = nx * nx + ny * ny
    continue if r2 > 1
    let facing = -0.4 * nx - 0.5 * ny + 0.75 * Math.sqrt(1 - r2)
    ramp_tone(c, x, y, 0.12 + 0.8 * Math.max(0.0, facing), ramp)
  }
}

# Text from the 8x8 font stretched `sy` times taller, the condensed lettering
# painted on a truck, with a `shade` shadow one cell to the right of each
# stroke. A `chip` fraction of the paint has flaked off.
fn stamp_text(c, s, x, y, sy, key, shade, chip, seed) {
  let tw = Canvas.text_width(s, 1)
  mut glyphs = Cells(tw, 8)
  glyphs.text(s, 0, 0, key)
  for (gx, gy) in grid(0..tw, 0..8) {
    continue if glyphs.get(gx, gy) == 0
    for dy in 0..sy {
      let py = y + gy * sy + dy
      c.set(x + gx, py, key) if noise(seed, x + gx, py, 9) >= chip
      c.set(x + gx + 1, py, shade) if glyphs.get(gx + 1, gy) == 0
    }
  }
}

# How much grime darkens a door cell `y` rows below the first ridge: streaks
# two cells wide start under some ridges (one every `period` rows) and fade
# out over a length of their own.
fn grime(seed, x, y, period) {
  let col = x / 2
  mut dark = 0.0
  for back in 0..3 {
    let ridge = y / period - back
    continue if ridge < 0 || noise(seed, col, ridge, 5) > 0.1
    let len = 6 + noise(seed, col, ridge, 6) * 18
    let dy = y - ridge * period
    dark = Math.max(dark, 0.4 * (1 - dy / len)) if dy < len
  }
  dark
}

# Hot-rod flames licking up from row `base` across [x0, x1]: tongues of
# varied height leaning right, yellow at the root through orange to red
# tips, with a dark pinstripe round them.
fn flames(c, x0, x1, base, reach, seed) {
  let period = 9.0
  mut lit = repeat(c.w * c.h, false)
  for (x, y) in grid(x0..=x1, base - reach..=base) {
    let rise = (base - y).to_float()
    let q = (x - x0 - rise * 0.6) / period
    let k = q < 0 ? q.to_long() - 1 : q.to_long()
    let u = Math.abs(2 * (q - k) - 1)
    let tall = reach * (0.45 + 0.55 * noise(seed, k, 11)) * Math.sqrt(1 - u)
    continue if rise > tall
    let t = rise / reach
    c.set(x, y, cond {
      t < 0.3 => "P_YELLOW",
      t < 0.6 && rise < tall - 2 => "ORANGE1",
      _ => "RED1",
    })
    lit[y * c.w + x] = true
  }
  for (x, y) in grid(x0..=x1, base - reach - 1..=base) {
    continue if lit[y * c.w + x]
    for (nx, ny) in [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)] {
      if nx >= x0 && nx <= x1 && ny <= base && lit[ny * c.w + nx] {
        c.set(x, y, "RED0")
        break
      }
    }
  }
}

# The semi, as its trailer: a white steel box. Pressed ridges cross the
# doors, the paint is bright above and grimy below, dirt runs down from
# the ridges, the name is painted on in tall letters that have chipped, and
# the lock rods run over all of it. Beneath: twin tyres, lamps, a striped
# underride bar.
fn draw_trailer(c, w, h, seed) {
  let floor = h - 2
  let depth = 12
  let x0 = 1
  let x1 = w - depth - 2
  let cx = (x0 + x1 + 1) / 2
  let top = 4
  let bottom = floor - 34
  let paint = ["WHITE0", "FRAME", "WHITE1", "WHITE2"]
  for tx in [x0 + 1, x0 + 15, x1 - 26, x1 - 12] {
    tyre(c, tx, bottom + 4, 13, floor - bottom - 3, 4)
  }
  c.rect(x0 + 28, floor - 18, x1 - x0 - 54, 3, "TYRE0")  # axle
  c.rect(x0 + 28, floor - 18, x1 - x0 - 54, 1, "TYRE1")

  for (x, y) in grid(x0..=x1, top..bottom) {
    let t = (y - top).to_float() / (bottom - top)
    mut light = 0.92 - 0.38 * t
    if x < x0 + 4 || x > x1 - 4 || y < top + 5 {
      light -= 0.12
      light += 0.22 if x == x0 + 1 || y == top + 1
    } else {
      let r = Math.wrap(y - top - 5, 8)
      light += 0.22 if r == 0
      light -= 0.2 if r == 1
      light -= 0.6 * grime(seed, x, y - top - 5, 8)
    }
    light -= 0.22 if noise(seed, x, y, 3) < 0.025
    ramp_tone(c, x, y, light, paint)
  }
  c.rect(cx - 1, top + 5, 1, bottom - top - 5, "WHITE0")  # the doors' seam
  c.rect(cx, top + 5, 1, bottom - top - 5, "WHITE2")
  stamp_text(c, "CULEBRA", cx - 29, top + 20, 2, "RED1", "RED0", 0.12, seed)
  stamp_text(c, "EXPRESS", cx - 29, top + 42, 1, "BLUE1", "BLUE0", 0.2, seed)

  for k in 0..4 {
    let hinge = top + 12 + k * 26
    c.rect(x0 + 3, hinge, 3, 4, "TYRE1")
    c.rect(x1 - 5, hinge, 3, 4, "TYRE1")
  }
  # Lock rods with their keepers top and bottom and a lever each.
  let lever = top + (bottom - top) * 0.62
  for rx in [x0 + 14, cx - 12, cx + 11, x1 - 14] {
    c.rect(rx, top + 3, 1, bottom - top - 1, "WHITE1")
    c.rect(rx + 1, top + 3, 1, bottom - top - 1, "WHITE0")
    for ky in [top + 3, bottom - 3] {
      c.rect(rx - 1, ky, 4, 3, "TYRE1")
      c.set(rx, ky + 1, "WHITE0")
    }
    c.rect(rx, lever, 7, 2, "WHITE1")
    c.rect(rx, lever + 2, 7, 1, "WHITE0")
    c.rect(rx + 5, lever - 1, 2, 4, "TYRE1")
  }
  for i in -1..=1 {
    c.rect(cx - 1 + i * 6, top + 1, 3, 2, "LAMP_A")  # clearance lamps
    c.set(cx - 1 + i * 6, top + 1, "LAMP_W")
  }
  for kx in [x0, x1 - 4] {
    c.rect(kx, top - 1, 5, 4, "TYRE1")  # corner castings
    c.rect(kx + 1, top, 3, 1, "TYRE0")
  }

  # The rear sill with its lamps and plate, the underride bar hung below.
  for y in bottom..bottom + 7 {
    c.rect(x0, y, x1 - x0 + 1, 1, cond {
      y == bottom => "WHITE0",
      y < bottom + 3 => "TYRE1",
      _ => "TYRE0",
    })
  }
  for lx in [x0 + 5, x0 + 12, x1 - 12, x1 - 5] {
    c.circle(lx, bottom + 4, 2.6, "LAMP_R")
    c.rect(lx - 1, bottom + 3, 2, 1, "LAMP_RL")
  }
  c.rect(x0 + 18, bottom + 3, 4, 2, "LAMP_A")
  c.rect(x1 - 21, bottom + 3, 4, 2, "LAMP_A")
  plate(c, cx, bottom + 2, 16)
  let bar = bottom + 15
  for sx in [x0 + 30, x1 - 32] {
    c.rect(sx, bottom + 7, 3, bar - bottom - 7, "TYRE0")
    c.rect(sx, bottom + 7, 1, bar - bottom - 7, "TYRE1")
  }
  for x in x0 + 6..x1 - 5 {
    let tape = (x + bar) / 5 % 2 == 0 ? "LAMP_R" : "WHITE2"
    c.rect(x, bar, 1, 2, tape)
    c.set(x, bar + 2, "TYRE1")
    c.set(x, bar + 3, "TYRE0")
  }

  side_face(c, x1, depth, top + (bottom - top) * 0.35, 0.16, 4)
  c.outline()
  ground_shadow(c, (x0 + x1 + depth) / 2, floor + 1, w * 0.49, 1)
}

# The truck: a lifted pickup. A black roll bar with lamp pods over the bed,
# the driver through the sliding rear window, flames up the tailgate, tall
# stacked lamps at the corners, a chrome step bumper, and big lugged tyres
# with the axle and shocks between them.
fn draw_pickup(c, w, h, seed) {
  let floor = h - 1
  let depth = 8
  let x0 = 1
  let x1 = w - depth - 2
  let cx = (x0 + x1) / 2.0
  let hw = (x1 - x0) / 2.0
  let paint = ("GREEN0", "GREEN1", "GREEN2")
  let (d, m, l) = paint
  let roof = 8
  let rail = 28
  let gate = 34
  let bumper = 57
  let tw = 17
  for tx in [x0 + 1, x1 - tw + 1] {
    tyre(c, tx, bumper + 2, tw, floor - bumper - 2, 5)
  }
  c.rect(x0 + tw, floor - 11, x1 - x0 - 2 * tw, 3, "TYRE0")  # axle
  c.rect(x0 + tw, floor - 11, x1 - x0 - 2 * tw, 1, "TYRE1")
  c.ellipse(cx, floor - 10, 7, 5, "TYRE1")  # differential
  c.ellipse(cx - 2, floor - 12, 3, 1.5, "WHITE0")
  for s in [-1, 1] {
    c.line(
      cx + s * (hw - tw - 2),
      bumper + 3,
      cx + s * (hw - tw - 6),
      floor - 9,
      "P_YELLOW",
      2,
    )  # shocks
  }
  c.rect(cx + 8, bumper + 8, 5, 3, "CHROME")  # exhaust
  c.rect(cx + 9, bumper + 9, 3, 1, "TYRE0")

  let cab = [[roof, hw * 0.6], [roof + 3, hw * 0.7], [rail, hw * 0.76]]
  shell(c, cx, cab, paint, 3, l)
  glass(c, cx, cab, 4)
  # The driver sits on the right, seen through the tint.
  let dx = cx + hw * 0.3
  c.rect(dx - 5, rail - 7, 11, 3, "SHIRT_A")
  c.circle(dx, rail - 10, 3.2, "SKIN")
  c.ellipse(dx, rail - 12, 3.6, 1.8, "RED1")  # cap
  c.rect(dx - 4, rail - 12, 8, 1, "RED0")
  for s in [-1, 1] {
    c.rect(cx + s * hw * 0.18, roof + 4, 1, rail - roof - 8, "TYRE0")  # sliding pane
    let mx = cx + s * hw * 0.93
    c.line(cx + s * hw * 0.74, rail - 6, mx, rail - 9, "TYRE0", 1)  # mirrors
    c.rect(mx - 2, rail - 17, 5, 9, "TYRE1")
    c.rect(mx - 2, rail - 17, 1, 9, "WHITE0")
  }

  let body = [
    [rail, hw * 0.94],
    [rail + 2, hw],
    [bumper - 3, hw],
    [bumper, hw * 0.97],
  ]
  shell(c, cx, body, paint, 2, l)
  let bed = hw * 0.86
  for (
    x,
    y,
  ) in grid((cx - bed).to_long()..=(cx + bed).to_long(), rail + 2..gate - 1) {
    c.set(x, y, Math.wrap(x, 4) == 0 || y == rail + 2 ? "TYRE0" : "TYRE1")
  }
  c.rect(cx - bed, gate - 1, bed * 2 + 1, 1, l)  # the tailgate's top edge
  let gx = hw * 0.74
  c.rect(cx - gx, gate, 1, bumper - gate - 1, d)
  c.rect(cx + gx, gate, 1, bumper - gate - 1, d)
  c.rect(cx - gx, bumper - 2, gx * 2 + 1, 1, d)
  flames(
    c,
    (cx - gx + 2).to_long(),
    (cx + gx - 2).to_long(),
    bumper - 4,
    15,
    seed,
  )
  c.rect(cx - 6, gate + 2, 12, 3, "CHROME")  # handle
  c.rect(cx - 5, gate + 3, 10, 1, "TYRE0")
  for lx in [x0 + 3, x1 - 7] {
    c.rect(lx - 1, gate, 7, 19, "CHROME")
    c.rect(lx, gate + 1, 5, 17, "LAMP_R")
    c.rect(lx, gate + 1, 5, 3, "LAMP_RL")
    c.rect(lx, gate + 10, 5, 3, "LAMP_W")
    c.rect(lx, gate + 14, 5, 4, "LAMP_A")
  }
  plate(c, cx, bumper - 7, 16)
  chrome_bar(c, x0 + 1, bumper, x1 - x0 - 1, 7)
  c.rect(cx - 9, bumper + 2, 18, 3, "TYRE0")  # the step
  for x in (cx - 8).to_long()..(cx + 8).to_long() by 2 {
    c.set(x, bumper + 3, "TYRE1")
  }

  let bx = hw * 0.66
  for s in [-1, 1] {
    c.rect(cx + s * bx - 1, roof + 4, 3, rail - roof - 3, "TYRE0")
    c.rect(cx + s * bx - 1, roof + 4, 1, rail - roof - 3, "TYRE1")
  }
  c.rect(cx - bx - 1, roof + 3, bx * 2 + 3, 3, "TYRE0")
  c.rect(cx - bx - 1, roof + 3, bx * 2 + 3, 1, "TYRE1")
  for i in 0..4 {
    let px = cx + (i - 1.5) * bx * 0.62
    c.circle(px, roof, 3.4, "TYRE0")  # lamp pods, seen from behind
    c.circle(px - 0.6, roof - 0.6, 2.2, "TYRE1")
    c.set(px - 2, roof - 2, "CHROME")
  }

  side_face(c, x1, depth, -70, 0.03)
  c.outline()
  ground_shadow(c, (x0 + x1 + depth) / 2.0, floor, w * 0.48, 1)
}

# A slick seen from behind: a black block with rounded shoulders, the rubber
# catching a soft light along the top and down one side.
fn slick(c, x, y, tw, th) {
  for (px, py) in grid(x..x + tw, y..y + th) {
    let u = (px + 0.5 - x) / tw * 2 - 1
    let v = (py + 0.5 - y) / th
    continue if Math.abs(u) > 0.7 && (v < 0.08 || v > 0.94)
    let lit = v < 0.06 || u > -0.55 && u < -0.3 && v < 0.9
    c.set(px, py, lit ? "TYRE1" : "TYRE0")
  }
}

# Text from the 8x8 font condensed to six columns a letter: the second column
# of each glyph's left stem and of its right one are left out, so the bold
# strokes thin to one cell and the word narrows by a quarter. Centred on `cx`.
fn condensed_text(c, s, cx, y, key) {
  let tw = Canvas.text_width(s, 1)
  mut glyphs = Cells(tw, 8)
  glyphs.text(s, 0, 0, key)
  let cols = iota(tw - 1).filter(|x| x % 8 != 1 && x % 8 != 6)
  let x0 = Math.round(cx - cols.size() / 2.0)
  for i, gx in cols.enumerate() {
    for gy in 0..8 {
      let v = glyphs.get(gx, gy)
      c.set(x0 + i, y + gy, v) if v != 0
    }
  }
}

# A turbo-era Formula One car from behind, in blue, yellow and white: wide
# slick rear tyres at the corners, the smaller right front one showing past
# its shoulder the way a car a lane over shows its flank, a tall rear wing on
# black endplates with the name in red, the yellow airbox rising over it,
# blue sidepods over white, wishbones reaching out to the wheels, a rain
# light on the gearbox and a black diffuser.
fn draw_f1(c, w, h, seed) {
  let tw = 20        # a rear tyre's width
  let right = w - 7  # the right rear tyre's outer edge; the front one is past it
  let cx = right / 2.0
  let inner = cx - tw  # from the centre line to a rear tyre's inner edge
  let blue = ("BLUE0", "BLUE1", "BLUE2")
  let yellow = ("YELLOW0", "YELLOW1", "YELLOW2")
  slick(c, right - 7, 19, 9, 20)

  let cover = [[1, 2.5], [8, 4], [16, 8], [26, 14]]
  shell(c, cx, cover, yellow, 2, "WHITE2")
  repaint(c, cx - 20, 18, cx + 20, 26, yellow, blue)
  for s in [-1, 1] {
    c.line(cx + s * 6, 21, cx + s * 11, 19, "TYRE0")  # mirrors
    c.rect(cx + s * 13 - 2, 18, 4, 3, "WHITE1")
  }
  let pods = [[26, inner - 2], [30, inner + 1], [38, inner], [43, inner - 5]]
  shell(c, cx, pods, blue, 2)
  repaint(
    c,
    cx - inner - 2,
    34,
    cx + inner + 2,
    44,
    blue,
    ("WHITE0", "WHITE1", "WHITE2"),
  )
  c.rect(cx - 5, 26, 10, 16, "TYRE1")  # the gearbox
  c.rect(cx - 5, 26, 1, 16, "TYRE0")
  c.rect(cx + 4, 26, 1, 16, "TYRE0")
  c.rect(cx - 3, 31, 6, 5, "TYRE0")  # the rain light
  c.rect(cx - 2, 32, 4, 3, "LAMP_R")
  c.rect(cx - 2, 32, 4, 1, "LAMP_RL")
  for s in [-1, 1] {
    c.line(cx + s * 5, 30, cx + s * (inner + 1), 28, "TYRE0")  # wishbones
    c.line(cx + s * 5, 39, cx + s * (inner + 1), 37, "TYRE0")
  }
  c.rect(cx - inner, 43, inner * 2, 8, "TYRE0")  # the diffuser
  c.rect(cx - inner, 43, inner * 2, 1, "TYRE1")
  for x in (cx - inner + 3).to_long()..(cx + inner - 2).to_long() by 5 {
    c.rect(x, 45, 1, 6, "TYRE1")
  }
  slick(c, 0, 21, tw, 34)
  slick(c, right - tw, 21, tw, 34)

  # The wing, a little wider than the gap between the rear tyres: endplates,
  # the main plane with the name, the flap below it with smaller lettering.
  let half = inner + 6
  let x0 = cx - half
  let x1 = cx + half
  for ex in [x0 - 2, x1] {
    c.rect(ex, 5, 2, 24, "TYRE0")
    c.rect(ex, 5, 1, 24, "TYRE1")
  }
  c.rect(x0, 7, half * 2, 12, "WHITE2")
  c.rect(x0, 7, half * 2, 1, "WHITE1")
  c.rect(x0, 17, half * 2, 2, "WHITE1")
  condensed_text(c, "RETRO", cx, 9, "RED1")
  c.rect(x0, 22, half * 2, 4, "WHITE2")
  c.rect(x0, 25, half * 2, 1, "WHITE1")
  for x in (x0 + 3).to_long()..(x1 - 3).to_long() {
    c.set(x, 23, "RED1") if noise(seed, x, 1) < 0.6 && x % 7 != 0
    c.set(x, 24, "RED0") if noise(seed, x, 2) < 0.4 && x % 7 != 0
  }
  c.outline()
  ground_shadow(c, cx + 3, h - 1, w * 0.49, 1)
}

# A beetle in sky blue: a dome with a small rear window over a narrow body, wings
# swelling out over the wheels with the lamps on top, louvres in the engine
# lid, a blade bumper with overriders, twin tailpipes.
fn draw_beetle(c, w, h, seed) {
  let floor = h - 1
  let depth = 5
  let x0 = 1
  let x1 = w - depth - 2
  let cx = (x0 + x1) / 2.0
  let hw = (x1 - x0) / 2.0
  let paint = ("AQUA0", "AQUA1", "AQUA2")
  let (d, m, l) = paint
  let roof = 4
  let deck = 27
  tyre(c, x0 + 3, floor - 11, 10, 12, 2)
  tyre(c, x1 - 12, floor - 11, 10, 12, 2)
  let cabin = [
    [roof, hw * 0.14],
    [roof + 3, hw * 0.44],
    [roof + 8, hw * 0.6],
    [deck, hw * 0.66],
  ]
  shell(c, cx, cabin, paint, 3, l)
  glass(c, cx, cabin, 5)
  let body = [
    [deck, hw * 0.64],
    [deck + 5, hw * 0.74],
    [floor - 12, hw * 0.76],
    [floor - 7, hw * 0.7],
    [floor - 4, hw * 0.62],
  ]
  shell(c, cx, body, paint, 3, l)
  for s in [-1, 1] {
    bulge(
      c,
      cx + s * hw * 0.76,
      floor - 16,
      hw * 0.26,
      13,
      ["AQUA0", "AQUA1", "AQUA2"],
      floor - 8,
    )
    let lx = cx + s * hw * 0.8
    c.ellipse(lx, floor - 22, 2.5, 4, "LAMP_R")
    c.ellipse(lx - 0.5, floor - 23, 1.2, 2, "LAMP_RL")
  }
  for y in deck + 5..deck + 13 by 2 {
    c.rect(cx - 7, y, 14, 1, d)  # engine-lid louvres
    c.rect(cx - 7, y + 1, 14, 1, l)
  }
  c.rect(cx - 5, floor - 20, 10, 3, "CHROME")  # plate lamp
  plate(c, cx, floor - 16, 12)
  c.rect(cx - hw * 0.6, floor - 8, hw * 1.2, 3, "TYRE0")
  chrome_bar(c, cx - hw, floor - 11, hw * 2, 3)
  for s in [-1, 1] {
    c.rect(cx + s * 13 - 1, floor - 14, 3, 7, "CHROME")  # overriders
    c.rect(cx + s * 13 + 1, floor - 14, 1, 7, "WHITE0")
    c.rect(cx + s * 7 - 1, floor - 7, 3, 3, "CHROME")  # tailpipes
    c.set(cx + s * 7, floor - 5, "TYRE0")
  }
  let my = roof + (deck - roof) * 0.72
  c.ellipse(cx - profile(cabin, my) - 3, my, 2.5, 1.5, "CHROME")
  c.ellipse(cx + profile(cabin, my) + 3, my, 2.5, 1.5, "CHROME")
  side_face(c, x1, depth, -60, 0.02)
  c.outline()
  ground_shadow(c, (x0 + x1 + depth) / 2.0, floor, w * 0.46, 1)
}

# An open cruiser in pink: a chrome-framed windshield with two riders under
# it, the folded top in its cream boot, a long lit deck between tall fins
# with bullet lamps, and a heavy chrome bumper with the exhaust through it. It
# sits low: everything over the deck starts `top` rows down the sprite, so the
# tail face is no taller than the lamps and the bumper need.
fn draw_convertible(c, w, h, seed) {
  let floor = h - 1
  let depth = 5
  let x0 = 1
  let x1 = w - depth - 2
  let cx = (x0 + x1) / 2.0
  let hw = (x1 - x0) / 2.0
  let paint = ("PINK0", "PINK1", "PINK2")
  let (d, m, l) = paint
  let top = 8
  let deck = top + 16
  tyre(c, x0 + 2, floor - 10, 12, 11, 3)
  tyre(c, x1 - 13, floor - 10, 12, 11, 3)
  c.poly(
    [
      cx - hw * 0.5,
      top,
      cx + hw * 0.5,
      top,
      cx + hw * 0.62,
      top + 10,
      cx - hw * 0.62,
      top + 10,
    ],
    "CHROME",
  )
  c.poly(
    [
      cx - hw * 0.45,
      top + 2,
      cx + hw * 0.45,
      top + 2,
      cx + hw * 0.56,
      top + 10,
      cx - hw * 0.56,
      top + 10,
    ],
    "GLASS1",
  )
  c.rect(cx - hw * 0.56, top + 8, hw * 1.12, 2, "GLASS0")
  c.line(cx - hw * 0.3, top + 8, cx - hw * 0.18, top + 2, "GLASS2", 1)
  c.rect(cx - hw * 0.8, top + 9, hw * 1.6, 6, "RED0")  # the cockpit
  riders(
    c,
    cx,
    top + 1,
    10,
    "WHITE1",
    [("INK", "P_CYAN"), ("HAIR_BLOND", "SHIRT_B")],
  )
  for s in [-1, 1] {
    c.ellipse(cx + s * hw * 0.68, top + 7, 2.5, 1.5, "CHROME")  # mirrors
  }

  let body = [
    [deck - 4, hw * 0.84],
    [deck, hw * 0.95],
    [deck + 4, hw],
    [floor - 8, hw],
    [floor - 5, hw * 0.96],
    [floor - 4, hw * 0.88],
  ]
  shell(c, cx, body, paint, 8, l)
  for i in 0..4 {
    c.rect(cx -
      hw * 0.6 +
      (i == 0 ? 1 : 0), deck - 5 + i, hw * 1.2 - (i == 0 ? 2 : 0), 1, cond {
      i == 0 => "CREAM2",
      i == 3 => "CREAM0",
      _ => "CREAM1",
    })  # the boot over the folded top
  }
  for s in [-1, 1] {
    c.poly(
      [
        cx + s * hw,
        deck + 8,
        cx + s * hw * 0.97,
        deck - 7,
        cx + s * hw * 0.86,
        deck - 5,
        cx + s * hw * 0.66,
        deck + 3,
      ],
      m,
    )  # fins
    c.line(cx + s * hw * 0.97, deck - 7, cx + s * hw * 0.66, deck + 3, l, 1)
    c.line(cx + s * hw, deck + 8, cx + s * hw * 0.97, deck - 7, d, 1)
    for ly in [deck - 1, deck + 5] {
      c.ellipse(cx + s * hw * 0.92, ly, 2, 3.5, "LAMP_R")
      c.rect(cx + s * hw * 0.92 - 1, ly - 2, 1, 3, "LAMP_RL")
    }
  }
  c.line(cx - 5, deck + 6, cx, deck + 10, "CHROME")  # badge
  c.line(cx, deck + 10, cx + 5, deck + 6, "CHROME")
  for lx in [cx - hw * 0.9, cx + hw * 0.9 - 22] {
    c.rect(lx, floor - 19, 22, 3, "LAMP_R")
    c.rect(lx, floor - 19, 22, 1, "LAMP_RL")
  }
  plate(c, cx, floor - 17, 16)
  chrome_bar(c, cx - hw * 1.02, floor - 13, hw * 2.04, 6)
  c.ellipse(cx - hw * 0.55, floor - 10, 3.5, 1.5, "TYRE0")  # exhaust ports
  c.ellipse(cx + hw * 0.55, floor - 10, 3.5, 1.5, "TYRE0")
  c.rect(cx - hw * 0.7, floor - 5, hw * 1.4, 2, "TYRE0")
  side_face(c, x1, depth, -60, 0.02)
  c.outline()
  ground_shadow(c, (x0 + x1 + depth) / 2.0, floor, w * 0.47, 1)
}

# A rear-engined coupé in yellow: a small rounded cabin, hips flared wide over
# the wheels, a black whale-tail spoiler with a rubber lip and a grille, a red
# reflector band between the lamps, a black valance and a single pipe.
fn draw_whaletail(c, w, h, seed) {
  let floor = h - 1
  let depth = 5
  let x0 = 1
  let x1 = w - depth - 2
  let cx = (x0 + x1) / 2.0
  let hw = (x1 - x0) / 2.0
  let paint = ("YELLOW0", "YELLOW1", "GOLD2")
  let (d, m, l) = paint
  let roof = 5
  let deck = 21
  tyre(c, x0, floor - 12, 14, 13, 3)
  tyre(c, x1 - 13, floor - 12, 14, 13, 3)
  let cabin = [
    [roof, hw * 0.38],
    [roof + 3, hw * 0.52],
    [roof + 8, hw * 0.6],
    [deck, hw * 0.66],
  ]
  shell(c, cx, cabin, paint, 3, l)
  glass(c, cx, cabin, 3)
  let body = [
    [deck, hw * 0.68],
    [deck + 5, hw * 0.85],
    [deck + 12, hw],
    [floor - 7, hw],
    [floor - 5, hw * 0.94],
    [floor - 4, hw * 0.86],
  ]
  shell(c, cx, body, paint, 8, l)
  c.poly(
    [
      cx - hw * 0.78,
      deck + 2,
      cx + hw * 0.78,
      deck + 2,
      cx + hw * 0.62,
      deck + 11,
      cx - hw * 0.62,
      deck + 11,
    ],
    "TYRE0",
  )
  c.rect(cx - hw * 0.8, deck + 1, hw * 1.6, 2, "TYRE1")  # rubber lip
  for x in (cx - hw * 0.78).to_long()..(cx + hw * 0.78).to_long() {
    c.mix(x, deck + 1, "TYRE1", "WHITE0", 0.5)
  }
  for y in deck + 5..deck + 11 by 2 {
    c.rect(cx - hw * 0.4, y, hw * 0.8, 1, "TYRE1")  # grille
  }

  let ly = deck + 14
  c.rect(cx - hw * 0.92, ly, hw * 1.84, 5, "RED0")
  c.rect(cx - hw * 0.92, ly, hw * 1.84, 1, "LAMP_R")
  for lx in [cx - hw * 0.92, cx + hw * 0.92 - 12] {
    c.rect(lx, ly, 12, 5, "LAMP_R")
    c.rect(lx, ly, 12, 2, "LAMP_RL")
    c.rect(lx < cx ? lx + 10 : lx, ly + 2, 2, 3, "LAMP_A")
  }
  c.rect(cx - hw * 0.5, ly + 1, hw, 3, "TYRE0")
  for i in 0..7 {
    c.set(cx - 9 + i * 3, ly + 2, "CHROME")  # the name in chrome
  }
  c.rect(cx - 9, ly + 7, 18, 6, d)  # plate recess
  plate(c, cx, ly + 8, 14)
  c.rect(cx - hw * 0.98, floor - 8, hw * 1.96, 1, "TYRE0")  # rubber strip
  for s in [-1, 1] {
    c.rect(cx + s * 16 - 1, floor - 10, 3, 5, "TYRE0")  # overriders
  }
  for y in floor - 5..floor - 1 {
    c.rect(cx - hw * 0.8, y, hw * 1.6, 1, y < floor - 3 ? "TYRE1" : "TYRE0")
  }
  c.rect(cx - 22, floor - 4, 6, 3, "CHROME")
  c.rect(cx - 21, floor - 3, 4, 1, "TYRE0")
  let my = roof + (deck - roof) * 0.72
  c.ellipse(cx - profile(cabin, my) - 3, my, 3, 1.6, m)
  c.ellipse(cx + profile(cabin, my) + 3, my, 3, 1.6, m)
  side_face(c, x1, depth, -60, 0.02)
  c.outline()
  ground_shadow(c, (x0 + x1 + depth) / 2.0, floor, w * 0.47, 1)
}

# Which routine draws what. One table, so adding a sprite is one line.
mut DRAW = {
  CAR01: |c, w, h| draw_f1(c, w, h, 1),
  CAR02: |c, w, h| draw_beetle(c, w, h, 2),
  CAR03: |c, w, h| draw_convertible(c, w, h, 3),
  CAR04: |c, w, h| draw_whaletail(c, w, h, 4),
  TRUCK: |c, w, h| draw_pickup(c, w, h, 5),
  SEMI: |c, w, h| draw_trailer(c, w, h, 6),
  PLAYER_STRAIGHT: |c, w, h| draw_sports_car(c, w, h, 0, 0),
  PLAYER_LEFT: |c, w, h| draw_sports_car(c, w, h, -1, 0),
  PLAYER_RIGHT: |c, w, h| draw_sports_car(c, w, h, 1, 0),
  PLAYER_UPHILL_STRAIGHT: |c, w, h| draw_sports_car(c, w, h, 0, 4),
  PLAYER_UPHILL_LEFT: |c, w, h| draw_sports_car(c, w, h, -1, 4),
  PLAYER_UPHILL_RIGHT: |c, w, h| draw_sports_car(c, w, h, 1, 4),
  TREE1: |c, w, h| draw_birch(c, w, h, 20),
  TREE2: |c, w, h| draw_cherry(c, w, h, 21),
  DEAD_TREE1: |c, w, h| draw_dead_tree(c, w, h, 22),
  DEAD_TREE2: |c, w, h| draw_dead_tree(c, w, h, 23),
  PALM_TREE: |c, w, h| draw_palm_sprite(c, w, h, 24),
  BUSH1: |c, w, h| draw_bush(c, w, h, 25),
  BUSH2: |c, w, h| draw_bush(c, w, h, 26, true),
  CACTUS: |c, w, h| draw_cactus(c, w, h, 27),
  STUMP: |c, w, h| draw_stump(c, w, h, 28),
  BOULDER1: |c, w, h| draw_boulder(c, w, h, 29),
  BOULDER2: |c, w, h| draw_boulder(c, w, h, 30),
  BOULDER3: |c, w, h| draw_boulder(c, w, h, 31),
  COLUMN: |c, w, h| draw_column(c, w, h, 32),
}
for i in 1..10 {
  DRAW["BILLBOARD{i:02}"] = |c, w, h| draw_billboard(
    c,
    w,
    h,
    40 + i,
    POSTERS[i - 1],
  )
}

# One sheet. Sprites are not recoloured per scene (only the backgrounds are),
# so the sheet is baked with the day palette.
fn build_sprites() {
  mut img = KeyImage(atlas.SPRITE_W, atlas.SPRITE_H)
  let missing = atlas.SPRITES.keys().filter(|n| !DRAW.has(n))
  if !missing.empty() {
    throw {
      kind: "ValueError",
      message: "no draw routine for {missing.sorted()}",
    }
  }
  for name, r in atlas.SPRITES {
    let [x, y, w, h] = r
    let s = cell_scale(w, h)
    let cw = (w + s - 1) / s  # ceil, then crop back to w x h
    let ch = (h + s - 1) / s
    mut cells = Cells(cw, ch)
    DRAW[name](cells, cw, ch)
    img.blit_cells(cells, x, y, w, h, s)
  }
  img
}

# --- main --------------------------------------------------------------------
let outdir = !Sys.argv.empty()
  ? Sys.argv[0]
  : FS.join(FS.dirname(FS.dirname(Sys.script)), "assets")
let what = Sys.argv.get(1, "all")
FS.mkdir(outdir)
Canvas.init(1, 1)
mut written = []

if what != "sprites" {
  let bg = build_background()
  for (name, scene) in SCENES {
    let path = FS.join(outdir, "background_{name}.png")
    let png = Canvas.Sprite(bg.k, bg.w, bg.h, palette_colors(scene)).to_png()
    FS.write(path, png)
    written.push((path, png.size()))
  }
}

if what != "backgrounds" {
  let sp = build_sprites()
  let sprite_path = FS.join(outdir, "sprites.png")
  let sprite_png = Canvas
    .Sprite(sp.k, sp.w, sp.h, palette_colors(HIRU))
    .to_png()
  FS.write(sprite_path, sprite_png)
  written.push((sprite_path, sprite_png.size()))
}

for (path, n) in written {
  println("{FS.basename(path):<28} {n:>8} bytes")
}

# The road-side colours retro-run.cul lerps between, in its SCENE_COLORS
# order: grass dark/light, road dark/light, rumble dark/light, fog, sky.
println()
println("SCENE_COLORS for retro-run.cul:")
for (name, scene) in SCENES {
  let pal = {...COMMON, ...scene}
  let row = [
    "GRASS_D",
    "GRASS_L",
    "ROAD_D",
    "ROAD_L",
    "RUMBLE_D",
    "RUMBLE_L",
    "FOG",
    "SKY0",
  ].flat_map(|k| pal[k])
  println("  # {name}")
  println("  [{row.slice(0, 12).join(", ")},")
  println("   {row.slice(12, 24).join(", ")}],")
}
