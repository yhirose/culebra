# auto mode picks the device per op: small kernels stay on the CPU (GPU
# dispatch has a fixed per-call overhead), big ones go to the GPU. Both are
# measured here.
fn bench(label, n) {
  let a = Tensor.randn([n, n])
  let b = Tensor.randn([n, n])
  Tensor.eval(a)
  Tensor.eval(b)
  let warm = a.dot(b)
  Tensor.eval(warm)  # compile shaders / first dispatch
  let t0 = Time.monotonic()
  for _ in 0..5 {
    Tensor.eval(a.dot(b))
  }
  println("{label} {n}x{n}: {(Time.monotonic() - t0) * 200.0} ms/iter")
}

println("GPU available: {Tensor.gpu_available()}\n")
for n in [64, 512] {
  Tensor.use_cpu()
  bench("cpu ", n)
  Tensor.use_gpu()
  bench("gpu ", n)
  Tensor.use_auto()
  bench("auto", n)
  println("")
}
